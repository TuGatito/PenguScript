-- std/ambitus.pengu — módulo `ambitus`: entorno del proceso.
--
-- S5. El módulo expone el entorno (variables, argumentos, directorios del
-- sistema y plataforma) sin depender de `via` (los módulos de `std` no pueden
-- importarse entre sí). Las rutas son `Str`.
--
-- Nota de seguridad: `set_var`/`remove_var` mutan el entorno del proceso y no
-- son seguras si otros hilos leen variables a la vez; el lenguaje todavía no
-- tiene hilos, así que aquí es seguro.
scroll ambitus
    unveil rune VarError
        unveil message: String

    unveil ritual VarError for Show
        show = (@) -> String
            @.message.to_string()

    foreign "pengu"
        ambitus_var = (key: Str) -> Result[String, VarError]
        ambitus_var_os = (key: Str) -> Option[String]
        ambitus_set_var = (key: Str, value: Str) -> Unit
        ambitus_remove_var = (key: Str) -> Unit
        ambitus_vars = () -> Vec[String]
        ambitus_args = () -> Vec[String]
        ambitus_args_os = () -> Vec[String]
        ambitus_current_dir = () -> Result[String, VarError]
        ambitus_set_current_dir = (path: Str) -> Result[Unit, VarError]
        ambitus_temp_dir = () -> String
        ambitus_home_dir = () -> Option[String]
        ambitus_current_exe = () -> Result[String, VarError]
        ambitus_join_paths = (parts: Vec[String]) -> Result[String, VarError]
        ambitus_split_paths = (paths: Str) -> Vec[String]
        ambitus_os = () -> String
        ambitus_arch = () -> String
        ambitus_family = () -> String
        ambitus_exe_suffix = () -> String
        ambitus_dll_prefix = () -> String
        ambitus_dll_suffix = () -> String

    -- Variables -------------------------------------------------------------

    unveil var_os = (key: &Str) -> Option[String]
        ambitus_var_os(key)

    unveil var = (key: &Str) -> Result[String, VarError]
        ambitus_var(key)

    unveil set_var = (key: &Str, value: &Str) -> Unit
        ambitus_set_var(key, value)

    unveil remove_var = (key: &Str) -> Unit
        ambitus_remove_var(key)

    unveil vars = () -> Vec[String]
        ambitus_vars()

    -- Argumentos ------------------------------------------------------------

    unveil args = () -> Vec[String]
        ambitus_args()

    unveil args_os = () -> Vec[String]
        ambitus_args_os()

    -- Directorios -----------------------------------------------------------

    unveil current_dir = () -> Result[String, VarError]
        ambitus_current_dir()

    unveil set_current_dir = (path: &Str) -> Result[Unit, VarError]
        ambitus_set_current_dir(path)

    unveil temp_dir = () -> String
        ambitus_temp_dir()

    unveil home_dir = () -> Option[String]
        ambitus_home_dir()

    unveil current_exe = () -> Result[String, VarError]
        ambitus_current_exe()

    -- `PATH` ----------------------------------------------------------------

    unveil join_paths = (parts: Vec[String]) -> Result[String, VarError]
        ambitus_join_paths(parts)

    unveil split_paths = (paths: &Str) -> Vec[String]
        ambitus_split_paths(paths)

    -- Plataforma ------------------------------------------------------------

    unveil os = () -> String
        ambitus_os()

    unveil arch = () -> String
        ambitus_arch()

    unveil family = () -> String
        ambitus_family()

    unveil exe_suffix = () -> String
        ambitus_exe_suffix()

    unveil dll_prefix = () -> String
        ambitus_dll_prefix()

    unveil dll_suffix = () -> String
        ambitus_dll_suffix()
