declare hash_string with str as ref to char, seed as size_t into size_t

declare stralloc with a as ref to stbds_string_arena, str as ref to char into ref to char

declare strreset with a as ref to stbds_string_arena into void

## have to #define STBDS_UNIT_TESTS to call this
declare unit_tests into void

