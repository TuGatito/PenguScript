-- std/rete.pengu — red TCP.
--
-- S10. Sin hilos ni async todavía, la API es bloqueante; los sockets viven en
-- registros globales del runtime y se identifican por un `handle` (igual que
-- `via::File`). TLS/HTTP llegan cuando exista una capa de transporte genérica.
scroll rete
    unveil rune ReteError
        unveil message: String

    unveil rune PeerAddr
        unveil host: String
        unveil port: Int

    unveil rune TcpListener
        unveil handle: U64

    unveil rune TcpStream
        unveil handle: U64

    unveil ritual ReteError for Show
        show = (@) -> String
            format("ReteError(#{@.message})")

    unveil ritual PeerAddr for Show
        show = (@) -> String
            format("#{@.host}:#{@.port}")

    unveil ritual TcpListener for Show
        show = (@) -> String
            format("TcpListener(#{@.handle})")

    unveil ritual TcpStream for Show
        show = (@) -> String
            format("TcpStream(#{@.handle})")

    foreign "pengu"
        rete_bind = (host: Str, port: Int) -> Result[TcpListener, ReteError]
        rete_listener_addr = (listener: &TcpListener) -> Result[PeerAddr, ReteError]
        rete_accept = (listener: TcpListener) -> Result[(TcpStream, PeerAddr), ReteError]
        rete_listener_close = (listener: TcpListener) -> Unit

        rete_connect = (host: Str, port: Int) -> Result[TcpStream, ReteError]
        rete_peer_addr = (stream: &TcpStream) -> Result[PeerAddr, ReteError]
        rete_read = (stream: &mut TcpStream, count: Usize) -> Result[Vec[U8], ReteError]
        rete_read_to_string = (stream: &mut TcpStream) -> Result[String, ReteError]
        rete_write = (stream: &mut TcpStream, data: Vec[U8]) -> Result[Usize, ReteError]
        rete_write_str = (stream: &mut TcpStream, text: Str) -> Result[Usize, ReteError]
        rete_flush = (stream: &mut TcpStream) -> Result[Unit, ReteError]
        rete_set_read_timeout = (stream: &mut TcpStream, millis: Int) -> Result[Unit, ReteError]
        rete_shutdown = (stream: TcpStream) -> Unit

    unveil ritual TcpListener
        listen = (host: &Str, port: Int) -> Result[TcpListener, ReteError]
            rete_bind(host, port)

        local_addr = (@) -> Result[PeerAddr, ReteError]
            rete_listener_addr(@)

        accept = (@own) -> Result[(TcpStream, PeerAddr), ReteError]
            rete_accept(@)

        close = (@own) -> Unit
            rete_listener_close(@)

    unveil ritual TcpStream
        connect = (host: &Str, port: Int) -> Result[TcpStream, ReteError]
            rete_connect(host, port)

        peer_addr = (@) -> Result[PeerAddr, ReteError]
            rete_peer_addr(@)

        read = (@mut, count: Usize) -> Result[Vec[U8], ReteError]
            rete_read(@, count)

        read_to_string = (@mut) -> Result[String, ReteError]
            rete_read_to_string(@)

        write = (@mut, data: Vec[U8]) -> Result[Usize, ReteError]
            rete_write(@, data)

        write_str = (@mut, text: &Str) -> Result[Usize, ReteError]
            rete_write_str(@, text)

        flush = (@mut) -> Result[Unit, ReteError]
            rete_flush(@)

        set_read_timeout = (@mut, millis: Int) -> Result[Unit, ReteError]
            rete_set_read_timeout(@, millis)

        shutdown = (@own) -> Unit
            rete_shutdown(@)
