# std/parchment.pengu - The Parchment (XML / HTML DOM Processing)
# Parses XML and HTML text into a Document, then queries, mutates and
# serializes element trees through Node values (backed by libxml2).
#
# Memory model:
#   * A Document returned by parse_xml / parse_html OWNS the whole parsed
#     libxml2 tree plus the wrapper strings of its root node. Release it with
#     free_document (or doc.free) when done; freeing it invalidates every node
#     previously obtained from it.
#   * find / find_all hand back NEW Node wrappers that own fresh tag/text
#     strings but alias elements owned by the source document. Release each
#     wrapper with free_node (or node.free) once done - never free the
#     underlying document element by itself.
#   * create_element / create_text build standalone wrappers that own a fresh
#     xml node; append_child moves a child's xml node into the parent's tree.
#   * to_string / attr / text return `maybe string`: a present value owns a
#     freshly allocated string the caller may banish after use; none means the
#     data does not exist or could not be produced.
#
# Documented TODOs (require runtime changes):
#   * Parent traversal (parent_of) requires exposing xmlNodePtr->parent in the
#     runtime bridge.
#   * Sibling traversal (next_sibling, prev_sibling) requires exposing
#     xmlNodePtr->next and xmlNodePtr->prev in the runtime bridge.
#   * Attribute iteration (attrs_as_map) requires iterating xmlNodePtr->properties
#     and copying into a PenguMap.
#   * Full XPath evaluation (xpath_eval) requires an xmlXPathContext bridge.

import std.spark
import std.oracle
import std.scrolls

# ----------------------------------------------------------------------------
# Version and Constants
# ----------------------------------------------------------------------------

## Module version identifier for std.parchment (0.15.0 expansion).
const PARCHMENT_VERSION as string is "2.0.0"

# ----------------------------------------------------------------------------
# Type Definitions
# ----------------------------------------------------------------------------

# One XML/HTML element in a tree. `tag` is the element name and `text` a
# snapshot of its text content; `_ptr` is the opaque libxml2 node handle that
# the wrapper or its owning document manages (never read from PenguScript).
rune Node:
    tag as string
    text as string
    # Opaque libxml2 node handle: owned by the document for parsed trees, by
    # the wrapper for standalone nodes. Never touch this field directly.
    _ptr as opaque

# A parsed XML/HTML document. `root` is the top-level element and `version` /
# `encoding` mirror the XML declaration ("HTML" / "UTF-8" for HTML input). A
# Document owns the tree behind `root`: release it with free_document (or
# doc.free) once done - do not free its nodes individually.
rune Document:
    root as Node
    version as string
    encoding as string

# ----------------------------------------------------------------------------
# External C Declarations
# ----------------------------------------------------------------------------

# Parses XML text into a new Document (none when the input is empty or not
# well-formed). The Document owns the parsed tree.
declare pengu_c_parchment_parse_xml with data as string into maybe Document
# Parses HTML text into a new Document (none when empty or rootless). The
# Document owns the parsed tree.
declare pengu_c_parchment_parse_html with data as string into maybe Document
# Serializes the subtree at `node` into markup (pretty when `pretty`). A
# present result is an owned fresh string the caller must release.
declare pengu_c_parchment_to_string with node as ref to Node , pretty as bool into maybe string
# Finds the first direct child element of `node` named `query`. A present
# result is a new wrapper owning fresh tag/text strings.
declare pengu_c_parchment_find with node as ref to Node , query as string into maybe Node
# Finds every direct child element of `node` named `query`. Each list entry is
# a new wrapper owning fresh tag/text strings.
declare pengu_c_parchment_find_all with node as ref to Node , query as string into list of Node
# Reads attribute `name` of `node`. A present result is an owned fresh string.
declare pengu_c_parchment_attr with node as ref to Node , name as string into maybe string
# Sets attribute `name` of `node` to `value` (adds it when missing).
declare pengu_c_parchment_set_attr with node as ref to Node , name as string , value as string into void
# Reads the text content of `node`. A present result is an owned fresh string.
declare pengu_c_parchment_text with node as ref to Node into maybe string
# Replaces the text content of `node` with `text`.
declare pengu_c_parchment_set_text with node as ref to Node , text as string into void
# Creates a standalone element wrapper named `tag` owning a fresh xml node.
declare pengu_c_parchment_create_element with tag as string into ref to Node
# Creates a standalone text wrapper (tag "text") owning a fresh xml node.
declare pengu_c_parchment_create_text with text as string into ref to Node
# Appends `child` under `parent` in the xml tree.
declare pengu_c_parchment_append_child with parent as ref to Node , child as ref to Node into void
# Releases the owned tag/text strings of a wrapper node (never the document's
# xml nodes).
declare pengu_c_parchment_node_free with node as ref to Node into void
# Releases a parsed document: frees its wrapper strings and the whole libxml2
# tree, invalidating every node obtained from it.
declare pengu_c_parchment_document_free with doc as ref to Document into void
# XML-escapes `text` (currently an identity passthrough; owned result).
declare pengu_c_parchment_escape_text with text as string into string
# XML-unescapes `text` (currently an identity passthrough; owned result).
declare pengu_c_parchment_unescape_text with text as string into string

# ----------------------------------------------------------------------------
# Functional API
# ----------------------------------------------------------------------------

# Parses `data` as XML into a new Document. Returns none when `data` is empty
# or not well-formed. The Document owns the parsed tree: release it with
# free_document (or doc.free) once done.
weave parse_xml with data as string into maybe Document:
    return calling pengu_c_parchment_parse_xml with data

# Parses `data` as HTML (lenient, error-tolerating mode) into a new Document.
# Returns none when `data` is empty or has no root element. The Document owns
# the parsed tree: release it with free_document (or doc.free) once done.
weave parse_html with data as string into maybe Document:
    return calling pengu_c_parchment_parse_html with data

# Serializes the element subtree at `node` back to markup. A present result is
# an owned fresh string (banish after use); none means nothing could be
# serialized. `pretty` indents the output.
weave to_string with node as ref to Node , pretty as bool is false into maybe string:
    return calling pengu_c_parchment_to_string with node , pretty

# Serializes the root element of `doc` back to markup (see to_string). A
# present result is an owned fresh string (banish after use).
weave doc_to_string with doc as ref to Document , pretty as bool is false into maybe string:
    return calling pengu_c_parchment_to_string with sigil of doc->root , pretty

# Returns the first DIRECT child element of `node` whose tag equals `query`.
# The returned Node wrapper is new: it owns fresh tag/text strings, so release
# it with free_node (or node.free) once done. The underlying element stays
# owned by its document.
weave find with node as ref to Node , query as string into maybe Node:
    return calling pengu_c_parchment_find with node , query

# Returns every direct child element of `node` whose tag equals `query`, as a
# list of Node (empty when there are no matches). Each entry is a new wrapper
# owning fresh tag/text strings: free each entry (free_node / node.free)
# before banishing the list.
weave find_all with node as ref to Node , query as string into list of Node:
    return calling pengu_c_parchment_find_all with node , query

# Reads the attribute `name` of `node`. A present result is an owned fresh
# string (banish after use); none means the attribute is not set.
weave attr with node as ref to Node , name as string into maybe string:
    return calling pengu_c_parchment_attr with node , name

# Sets attribute `name` of `node` to `value`, adding it when missing. Void.
weave set_attr with node as ref to Node , name as string , value as string into void:
    calling pengu_c_parchment_set_attr with node , name , value

# Reads the text content of `node` (concatenated descendant text for parsed
# elements). A present result is an owned fresh string (banish after use);
# none means no text content is available.
weave text with node as ref to Node into maybe string:
    return calling pengu_c_parchment_text with node

# Replaces the text content of `node` with `text`, updating both the wrapper
# and the live xml node. Void.
weave set_text with node as ref to Node , text as string into void:
    calling pengu_c_parchment_set_text with node , text

# Creates a standalone element wrapper (not yet attached to any document)
# named `tag`. The wrapper owns its xml node: attach it with append_child, or
# release it with free_node (or node.free) when abandoned.
weave create_element with tag as string into ref to Node:
    return calling pengu_c_parchment_create_element with tag

# Creates a standalone text wrapper whose content is `text` (tag is "text").
# The wrapper owns its xml node: attach it with append_child, or release it
# with free_node (or node.free) when done.
weave create_text with text as string into ref to Node:
    return calling pengu_c_parchment_create_text with text

# Appends `child` under `parent` in the xml tree (both must be live wrappers).
# Void. After the append, the parent's document owns the child's xml node.
weave append_child with parent as ref to Node , child as ref to Node into void:
    calling pengu_c_parchment_append_child with parent , child

# Releases the owned tag/text strings of a Node wrapper returned by find /
# find_all / create_element / create_text. Does not free xml nodes owned by a
# document - those are released when the document itself is freed.
weave free_node with node as ref to Node into void:
    calling pengu_c_parchment_node_free with node

# Releases a Document returned by parse_xml / parse_html: frees the wrapper
# strings AND the whole libxml2 tree. Any node previously obtained from the
# document becomes invalid, so free their wrappers first if still needed.
weave free_document with doc as ref to Document into void:
    calling pengu_c_parchment_document_free with doc

# XML-escapes `text` for safe inclusion in element text content. Currently the
# runtime bridge is an identity passthrough: `text` is returned unchanged as
# an owned string.
weave escape_text with text as string into string:
    return calling pengu_c_parchment_escape_text with text

# XML-unescapes `text`. Currently the runtime bridge is an identity
# passthrough: `text` is returned unchanged as an owned string.
weave unescape_text with text as string into string:
    return calling pengu_c_parchment_unescape_text with text

# True when `data` parses as well-formed XML (i.e. parse_xml succeeds).
weave is_valid_xml with data as string into bool:
    var doc as maybe Document is calling pengu_c_parchment_parse_xml with data
    if doc.is_present:
        var d as Document is doc.value
        calling free_document with sigil of d
        return true
    return false

# True when `data` parses as HTML with a root element (i.e. parse_html
# succeeds).
weave is_valid_html with data as string into bool:
    var doc as maybe Document is calling pengu_c_parchment_parse_html with data
    if doc.is_present:
        var d as Document is doc.value
        calling free_document with sigil of d
        return true
    return false

# ----------------------------------------------------------------------------
# HTML & DOM Traversal Helpers (0.15.0 Expansion)
# ----------------------------------------------------------------------------

## Returns true if `tag` is a void HTML element that cannot have children (e.g. "br", "img", "hr").
weave is_void_element with tag as string into bool:
    var t as string is calling tag.lower
    return t == "br" or t == "hr" or t == "img" or t == "input" or t == "link" or t == "meta" or t == "area" or t == "base" or t == "col" or t == "embed" or t == "param" or t == "source" or t == "track" or t == "wbr"

## Normalizes an HTML/XML tag name by trimming whitespace and converting to lowercase.
weave normalize_tag with tag as string into string:
    var s as string is calling tag.trim
    return calling s.lower

## Validates whether `tag` is a valid XML/HTML tag name.
weave is_valid_tag_name with tag as string into bool:
    if tag.len == 0:
        return false
    var first as int is ord (tag at 0)
    var is_alpha_ch as bool is (first >= 65 and first <= 90) or (first >= 97 and first <= 122) or first == 95
    if not is_alpha_ch:
        return false
    var i as int is 1
    while i < tag.len:
        var code as int is ord (tag at i)
        var ok as bool is (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or (code >= 48 and code <= 57) or code == 45 or code == 95 or code == 58
        if not ok:
            return false
        set i is i + 1
    return true

## Checks whether `node` has the CSS class `cls` in its "class" attribute.
weave has_class with node as ref to Node , cls as string into bool:
    var c_opt as maybe string is calling attr with node , "class"
    if c_opt.is_present:
        var c_str as string is c_opt.value
        var classes as list of string is calling c_str.split with " "
        for c in classes:
            if c == cls:
                return true
    return false

## Finds direct child elements of `node` tagged `tag` that have CSS class `cls`.
weave find_all_by_class with node as ref to Node , cls as string , tag as string is "div" into list of Node:
    var candidates as list of Node is calling find_all with node , tag
    var matches as list of Node is list of Node
    for c in candidates:
        if calling has_class with sigil of c , cls:
            calling matches.push with c
        else:
            calling free_node with sigil of c
    return matches

## Finds the first direct child element of `node` tagged `tag` that has CSS class `cls`.
weave find_by_class with node as ref to Node , cls as string , tag as string is "div" into maybe Node:
    var candidates as list of Node is calling find_all with node , tag
    var i as int is 0
    while i < candidates.len:
        var c as Node is candidates at i
        if calling has_class with sigil of c , cls:
            # Free the remaining candidates
            var j as int is 0
            while j < candidates.len:
                if j != i:
                    var other as Node is candidates at j
                    calling free_node with sigil of other
                set j is j + 1
            return some c
        set i is i + 1
    for c in candidates:
        calling free_node with sigil of c
    return maybe none

## Finds a child element under `node` with the given `id` attribute.
weave find_by_id with node as ref to Node , id as string , tag as string is "div" into maybe Node:
    # Check if target node itself matches
    var self_id as maybe string is calling attr with node , "id"
    if self_id.is_present and self_id.value == id:
        return some with tag is node->tag , text is node->text , _ptr is node->_ptr
    var candidates as list of Node is calling find_all with node , tag
    var i as int is 0
    while i < candidates.len:
        var c as Node is candidates at i
        var cid as maybe string is calling attr with sigil of c , "id"
        if cid.is_present and cid.value == id:
            var j as int is 0
            while j < candidates.len:
                if j != i:
                    var other as Node is candidates at j
                    calling free_node with sigil of other
                set j is j + 1
            return some c
        set i is i + 1
    for c in candidates:
        calling free_node with sigil of c
    return maybe none

## Extracts the full concatenated text content of `node` and all its descendants.
weave extract_all_text with node as ref to Node into string:
    var t as maybe string is calling text with node
    if t.is_present:
        return t.value
    return ""

## Strips all HTML/XML tags from markup `html` and decodes common HTML entities into plain text.
weave strip_html_tags with html as string into string:
    var out as string is ""
    var in_tag as bool is false
    var i as int is 0
    while i < html.len:
        var ch as string is html at i
        if ch == "<":
            set in_tag is true
        else if ch == ">":
            set in_tag is false
        else if not in_tag:
            set out is "{out}{ch}"
        set i is i + 1
    var s as string is out
    set s is calling s.replace with "&amp;" , "&"
    set s is calling s.replace with "&lt;" , "<"
    set s is calling s.replace with "&gt;" , ">"
    set s is calling s.replace with "&quot;" , "\""
    set s is calling s.replace with "&apos;" , "'"
    set s is calling s.replace with "&#39;" , "'"
    set s is calling s.replace with "&nbsp;" , " "
    return s

# ----------------------------------------------------------------------------
# Object Methods (enchanting Node)
# ----------------------------------------------------------------------------

# Node methods: mirror the module-level functional API with `self` as the
# target node. The memory notes of the functional API apply to their results
# (find / find_all / attr / text / to_string return owning values that you
# release with `banish`).
enchanting Node:
    # Finds the first direct child element of `self` named `query`; release
    # the returned wrapper with free when done (see find).
    weave find with query as string into maybe Node:
        return calling pengu_c_parchment_find with self , query

    # Returns every direct child element of `self` named `query` (see
    # find_all); free each entry before banishing the list.
    weave find_all with query as string into list of Node:
        return calling pengu_c_parchment_find_all with self , query

    ## Returns true if `self` has the CSS class `cls`.
    weave has_class with cls as string into bool:
        return calling has_class with self , cls

    ## Finds child elements with tag `tag` having CSS class `cls`.
    weave find_all_by_class with cls as string , tag as string is "div" into list of Node:
        return calling find_all_by_class with self , cls , tag

    ## Finds the first child element with tag `tag` having CSS class `cls`.
    weave find_by_class with cls as string , tag as string is "div" into maybe Node:
        return calling find_by_class with self , cls , tag

    ## Finds a child element with the given `id` attribute.
    weave find_by_id with id as string , tag as string is "div" into maybe Node:
        return calling find_by_id with self , id , tag

    ## Returns the full concatenated text content of `self` and its descendants.
    weave extract_text into string:
        return calling extract_all_text with self

    # Reads attribute `name` of `self`; a present result is an owned fresh
    # string (see attr).
    weave attr with name as string into maybe string:
        return calling pengu_c_parchment_attr with self , name

    # Sets attribute `name` of `self` to `value`, adding it when missing.
    weave set_attr with name as string , value as string into void:
        calling pengu_c_parchment_set_attr with self , name , value

    # Reads the text content of `self`; a present result is an owned fresh
    # string (see text).
    weave text into maybe string:
        return calling pengu_c_parchment_text with self

    # Replaces the text content of `self` with `text`.
    weave set_text with text as string into void:
        calling pengu_c_parchment_set_text with self , text

    # Appends `child` under `self` in the xml tree; after the append the
    # parent's document owns the child's xml node.
    weave append_child with child as ref to Node into void:
        calling pengu_c_parchment_append_child with self , child

    # Serializes the subtree at `self` to markup; a present result is an owned
    # fresh string (see to_string).
    weave to_string with pretty as bool is false into maybe string:
        return calling pengu_c_parchment_to_string with self , pretty

    # Releases the owned tag/text strings of this wrapper (see free_node).
    weave free into void:
        calling pengu_c_parchment_node_free with self

# Document methods. A parsed document owns its whole tree: freeing it releases
# the libxml2 document and invalidates any node previously obtained from it.
enchanting Document:
    # Releases the whole document tree (see free_document).
    weave free into void:
        calling pengu_c_parchment_document_free with self
