## let r as ResultString is calling ward.check_eq_string with name, "Alice", "bad name"
## ```
weave check_eq_string with a as string , b as string , msg as string into ResultString:
    if a == b:
        return calling oracle.result_ok_string with "ok"
    return calling oracle.result_err_string with msg

