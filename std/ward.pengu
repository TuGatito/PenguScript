# ----------------------------------------------------------------------------
# Native Result Checks (oracle-compatible)
# ----------------------------------------------------------------------------
# These seven checks return the native `result of string to string` built with
# the `ok_of` / `err_of` intrinsics, so they compose with `std.oracle`
# (`is_ok`, `is_err`, `unwrap_err`, `map_err`, ...). They are the canonical
# replacements named by the `## @deprecated` markers of the legacy block above.

## Returns ok("ok") when `cond` is true, otherwise err(`msg`). Never panics.
##
## ## Parámetros
## - `cond`: the condition to check.
## - `msg`: the error payload used when `cond` is false. Borrowed.
##
## ## Retorno
## A native `result of string to string`, owned by the caller: `ok("ok")` when
## `cond` holds, `err(msg)` otherwise.
##
## ## Memoria
## The returned `result` owns its payload; release it with `banish`. The
## parameters are borrowed.
##
## ## Ejemplo
## ```pengu
## let r as result of string to string is calling ward.check_native with x > 0, "x must be positive"
## ```
weave check_native with cond as bool , msg as string into result of string to string:
    if cond:
        return calling ok_of with "ok"
    return calling err_of with msg

## Returns ok("ok") when `a` equals `b`, otherwise err(`msg`). Never panics.
##
## ## Parámetros
## - `a`: the actual value.
## - `b`: the expected value.
## - `msg`: the error payload used when the values differ. Borrowed.
##
## ## Retorno
## A native `result of string to string`, owned by the caller: `ok("ok")` when
## `a == b`, `err(msg)` otherwise.
##
## ## Memoria
## The returned `result` owns its payload; release it with `banish`. The
## parameters are borrowed.
##
## ## Ejemplo
## ```pengu
## let r as result of string to string is calling ward.check_eq_int_native with 2 + 2, 4, "bad sum"
## ```
weave check_eq_int_native with a as int , b as int , msg as string into result of string to string:
    if a == b:
        return calling ok_of with "ok"
    return calling err_of with msg

## Returns ok("ok") when `a` equals `b` (exact string comparison), otherwise err(`msg`).
##
## ## Parámetros
## - `a`: the actual string. Borrowed.
## - `b`: the expected string. Borrowed.
## - `msg`: the error payload used when the strings differ. Borrowed.
##
## ## Retorno
## A native `result of string to string`, owned by the caller: `ok("ok")` when
## `a == b`, `err(msg)` otherwise.
##
## ## Memoria
## The returned `result` owns its payload; release it with `banish`. The
## parameters are borrowed.
##
## ## Ejemplo
## ```pengu
## let r as result of string to string is calling ward.check_eq_string_native with name, "Alice", "bad name"
## ```
weave check_eq_string_native with a as string , b as string , msg as string into result of string to string:
    if a == b:
        return calling ok_of with "ok"
    return calling err_of with msg

## Returns ok("ok") when boolean `a` equals `b`, otherwise err(`msg`).
##
## ## Parámetros
## - `a`: the actual boolean.
## - `b`: the expected boolean.
## - `msg`: the error payload used when the booleans differ. Borrowed.
##
## ## Retorno
## A native `result of string to string`, owned by the caller: `ok("ok")` when
## `a == b`, `err(msg)` otherwise.
##
## ## Memoria
## The returned `result` owns its payload; release it with `banish`. The
## parameters are borrowed.
##
## ## Ejemplo
## ```pengu
## let r as result of string to string is calling ward.check_eq_bool_native with flag, true, "flag must be true"
## ```
weave check_eq_bool_native with a as bool , b as bool , msg as string into result of string to string:
    if a == b:
        return calling ok_of with "ok"
    return calling err_of with msg

## Returns ok("ok") when float difference is within `epsilon`, otherwise err(`msg`).
##
## ## Parámetros
## - `a`: the actual value.
## - `b`: the expected value.
## - `msg`: the error payload used when the values differ. Borrowed.
## - `epsilon`: the inclusive tolerance. Defaults to `0.000001`.
##
## ## Retorno
## A native `result of string to string`, owned by the caller: `ok("ok")` when
## `|a - b| <= epsilon`, `err(msg)` otherwise.
##
## ## Memoria
## The returned `result` owns its payload; release it with `banish`. The
## parameters are borrowed.
##
## ## Ejemplo
## ```pengu
## let r as result of string to string is calling ward.check_eq_float_native with 1.0, 1.0, "not equal"
## ```
weave check_eq_float_native with a as float , b as float , msg as string , epsilon as float is 0.000001 into result of string to string:
    let diff as float is if (a - b) < 0.0 then (b - a) else (a - b)
    if diff <= epsilon:
        return calling ok_of with "ok"
    return calling err_of with msg

## Returns ok("ok") when native maybe container `m` holds a value, otherwise err(`msg`).
##
## ## Parámetros
## - `m`: the optional to inspect. Borrowed, not consumed.
## - `msg`: the error payload used when the optional is empty. Borrowed.
## - `T`: the payload type of the optional.
##
## ## Retorno
## A native `result of string to string`, owned by the caller: `ok("ok")` when
## `m` is present, `err(msg)` otherwise.
##
## ## Memoria
## The returned `result` owns its payload; release it with `banish`. The optional
## is borrowed and never banished.
##
## ## Ejemplo
## ```pengu
## let r as result of string to string is calling ward.check_present_native with user_opt, "missing user"
## ```
weave check_present_native shard T with m as maybe T , msg as string into result of string to string:
    if m is present:
        return calling ok_of with "ok"
    return calling err_of with msg

## Returns ok("ok") when native result `r` is ok, otherwise err(`msg`).
##
## ## Parámetros
## - `r`: the result to inspect. Borrowed, not consumed.
## - `msg`: the error payload used when the result is err. Borrowed.
## - `T`: the success payload type.
## - `E`: the error payload type.
##
## ## Retorno
## A native `result of string to string`, owned by the caller: `ok("ok")` when
## `r.is_ok` is true, `err(msg)` otherwise.
##
## ## Memoria
## The returned `result` owns its payload; release it with `banish`. The inspected
## result is borrowed and never banished.
##
## ## Ejemplo
## ```pengu
## let r as result of string to string is calling ward.check_ok_native with parsed, "parse failed"
## ```
weave check_ok_native shard T and E with r as result of T to E , msg as string into result of string to string:
    if r.is_ok:
        return calling ok_of with "ok"
    return calling err_of with msg

# ----------------------------------------------------------------------------
# Tests
# ----------------------------------------------------------------------------
# These tests never panic: they exercise the happy paths of `assert_*` /
# `expect_*` and the full classification of the non-panicking `check_*` families.
# The panic paths themselves are verified by `tests/stdlib/test_ward.py`.

test "assert_true accepts a true condition":
    calling assert_true with true
test "assert_false accepts a false condition":
    calling assert_false with false
test "assert and assert_msg accept true conditions":
    calling assert with true
    calling assert_msg with true, "never shown"
test "assert_eq_int and assert_ne_int accept matching values":
    calling assert_eq_int with 2 + 2, 4
    calling assert_ne_int with 3, 4
test "assert_eq_bool and assert_ne_bool accept matching values":
    calling assert_eq_bool with true, true
    calling assert_ne_bool with true, false
test "assert_eq_string and assert_ne_string accept matching values":
    calling assert_eq_string with "ping", "ping"
    calling assert_ne_string with "ping", "pong"
test "assert_eq_float accepts values within epsilon":
    calling assert_eq_float with 1.0000001, 1.0, 0.001
test "assert_ne_float accepts values outside epsilon":
    calling assert_ne_float with 2.0, 1.0, 0.001
test "assert_almost_eq accepts values within epsilon":
    calling assert_almost_eq with 3.14159, 3.1416, 0.001
test "assert_gt_int and assert_ge_int accept increasing values":
    calling assert_gt_int with 5, 3
    calling assert_ge_int with 4, 4
test "assert_lt_int and assert_le_int accept decreasing values":
    calling assert_lt_int with 3, 5
    calling assert_le_int with 4, 4
test "assert_gt_float and assert_ge_float accept increasing values":
    calling assert_gt_float with 2.5, 1.5
    calling assert_ge_float with 1.5, 1.5
test "assert_lt_float and assert_le_float accept decreasing values":
    calling assert_lt_float with 1.5, 2.5
    calling assert_le_float with 1.5, 1.5
test "assert_in_range_int accepts inclusive bounds":
    calling assert_in_range_int with 1, 1, 12
    calling assert_in_range_int with 12, 1, 12
test "assert_in_range_float accepts inclusive bounds":
    calling assert_in_range_float with 0.0, 0.0, 1.0
    calling assert_in_range_float with 1.0, 0.0, 1.0
test "assert_string_contains accepts a substring":
    calling assert_string_contains with "hello world", "world"
test "assert_string_starts_with and assert_string_ends_with accept affixes":
    calling assert_string_starts_with with "https://example.org", "https://"
    calling assert_string_ends_with with "main.pengu", ".pengu"
test "assert_string_empty and assert_string_not_empty accept matching lengths":
    calling assert_string_empty with ""
    calling assert_string_not_empty with "text"
test "assert_eq_int_list accepts identical lists":
    let xs as list of int is [1, 2, 3]
    defer banish xs
    let ys as list of int is [1, 2, 3]
    defer banish ys
    calling assert_eq_int_list with xs, ys
test "assert_eq_string_list accepts identical lists":
    let xs as list of string is ["alpha", "beta"]
    defer banish xs
    let ys as list of string is ["alpha", "beta"]
    defer banish ys
    calling assert_eq_string_list with xs, ys
test "assert_list_len_int and assert_list_not_empty_int accept non-empty lists":
    let xs as list of int is [7, 8]
    defer banish xs
    calling assert_list_len_int with xs, 2
    calling assert_list_not_empty_int with xs
test "assert_list_empty_int accepts an empty list":
    let xs as list of int is list of int
    defer banish xs
    calling assert_list_empty_int with xs
test "assert_map_has_key and assert_map_not_has_key classify keys":
    var config as map of string to string is map of string to string
    defer banish config
    calling config.put with "host", "localhost"
    calling assert_map_has_key with config, "host"
    calling assert_map_not_has_key with config, "secret"
test "assert_maybe_present and assert_maybe_none accept the matching shape":
    let present as maybe int is some 7
    calling assert_maybe_present with present
    let missing as maybe int is maybe none
    calling assert_maybe_none with missing
test "assert_result_ok and assert_result_err accept the matching status":
    let good as result of int to string is calling ok_of with 1
    calling assert_result_ok with good
    let bad as result of int to string is calling err_of with "boom"
    calling assert_result_err with bad
test "assert_result_ok_int and assert_result_err_int accept the matching status":
    let good as result of int to string is calling ok_of with 5
    calling assert_result_ok_int with good
    let bad as result of int to string is calling err_of with "boom"
    calling assert_result_err_int with bad
test "legacy assert_present_int and assert_none_int accept matching optionals":
    let present as MaybeInt is calling oracle.maybe_some_int with 5
    calling assert_present_int with present
    let missing as MaybeInt is calling oracle.maybe_none_int
    calling assert_none_int with missing
test "legacy assert_ok_int and assert_err_int accept matching results":
    let good as ResultInt is calling oracle.result_ok_int with 3
    calling assert_ok_int with good
    let bad as ResultInt is calling oracle.result_err_int with "boom"
    calling assert_err_int with bad
test "legacy assert_present_string and assert_ok_string accept matching containers":
    let present as MaybeString is calling oracle.maybe_some_string with "hi"
    calling assert_present_string with present
    let good as ResultString is calling oracle.result_ok_string with "hi"
    calling assert_ok_string with good
test "expect helpers accept satisfied conditions":
    calling expect with true, "never shown"
    calling expect_eq_int with 4, 4, "never shown"
    calling expect_eq_string with "same", "same", "never shown"
    calling expect_ne_int with 1, 2, "never shown"
    calling expect_ne_string with "left", "right", "never shown"
    calling expect_ne_bool with true, false, "never shown"
test "expect float and order helpers accept satisfied conditions":
    calling expect_eq_float with 1.0, 1.0, "never shown"
    calling expect_gt_int with 2, 1, "never shown"
    calling expect_ge_int with 2, 2, "never shown"
    calling expect_lt_int with 1, 2, "never shown"
    calling expect_le_int with 2, 2, "never shown"
test "expect container helpers accept satisfied conditions":
    let present_i as MaybeInt is calling oracle.maybe_some_int with 1
    calling expect_present_int with present_i, "never shown"
    let present_s as MaybeString is calling oracle.maybe_some_string with "x"
    calling expect_present_string with present_s, "never shown"
    let ok_r as ResultInt is calling oracle.result_ok_int with 1
    calling expect_ok_int with ok_r, "never shown"
    let ok_s as ResultString is calling oracle.result_ok_string with "x"
    calling expect_ok_string with ok_s, "never shown"
test "check_native returns ok for a true condition":
    let r as result of string to string is calling check_native with true, "boom"
    calling assert_true with r.is_ok
test "check_native returns err carrying the message":
    let r as result of string to string is calling check_native with false, "boom"
    calling assert_true with r.is_ok == false
    calling assert_eq_string with r.error, "boom"
test "check_eq_int_native classifies equality":
    let same as result of string to string is calling check_eq_int_native with 2 + 2, 4, "bad sum"
    calling assert_true with same.is_ok
    let diff as result of string to string is calling check_eq_int_native with 3, 4, "bad sum"
    calling assert_true with diff.is_ok == false
    calling assert_eq_string with diff.error, "bad sum"
test "check_eq_string_native classifies equality":
    let same as result of string to string is calling check_eq_string_native with "ping", "ping", "bad string"
    calling assert_true with same.is_ok
    let diff as result of string to string is calling check_eq_string_native with "ping", "pong", "bad string"
    calling assert_true with diff.is_ok == false
    calling assert_eq_string with diff.error, "bad string"
test "check_eq_bool_native classifies equality":
    let same as result of string to string is calling check_eq_bool_native with true, true, "bad bool"
    calling assert_true with same.is_ok
    let diff as result of string to string is calling check_eq_bool_native with true, false, "bad bool"
    calling assert_true with diff.is_ok == false
    calling assert_eq_string with diff.error, "bad bool"
test "check_eq_float_native honours epsilon":
    let near as result of string to string is calling check_eq_float_native with 1.0000001, 1.0, "far apart"
    calling assert_true with near.is_ok
    let far as result of string to string is calling check_eq_float_native with 2.0, 1.0, "far apart", 0.001
    calling assert_true with far.is_ok == false
    calling assert_eq_string with far.error, "far apart"
test "check_present_native classifies a maybe":
    let present as maybe int is some 7
    let found as result of string to string is calling check_present_native with present, "missing"
    calling assert_true with found.is_ok
    let missing as maybe int is maybe none
    let lost as result of string to string is calling check_present_native with missing, "missing"
    calling assert_true with lost.is_ok == false
    calling assert_eq_string with lost.error, "missing"
test "check_ok_native classifies a result":
    let good as result of int to string is calling ok_of with 1
    let accepted as result of string to string is calling check_ok_native with good, "rejected"
    calling assert_true with accepted.is_ok
    let bad as result of int to string is calling err_of with "boom"
    let rejected as result of string to string is calling check_ok_native with bad, "rejected"
    calling assert_true with rejected.is_ok == false
    calling assert_eq_string with rejected.error, "rejected"
test "legacy check helpers still return ResultString":
    let ok_r as ResultString is calling check with true, "nope"
    calling assert_true with ok_r.is_ok
    let err_r as ResultString is calling check_eq_int with 1, 2, "mismatch"
    calling assert_false with err_r.is_ok
    calling assert_eq_string with err_r.error_msg, "mismatch"
test "WARD_VERSION is 2.1.0":
    calling assert_eq_string with WARD_VERSION, "2.1.0"
