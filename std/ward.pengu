# ----------------------------------------------------------------------------
# Container Assertions (Lists and Maps)
# ----------------------------------------------------------------------------

## Panics unless integer lists `a` and `b` have identical length and elements.
##
## ## Parámetros
## - `a`: the actual list. Borrowed.
## - `b`: the expected list. Borrowed.
##
## ## Retorno
## Nothing; the helper returns `void`. It aborts the program via `spark.panic` on
## a length mismatch or at the first index where the elements differ.
##
## ## Efectos
## The message is `assertion failed: list length mismatch: expected <nb>, got <na>`
## or `assertion failed: element mismatch at index <i>: expected <vb>, got <va>`.
##
## ## Memoria
## Both lists are borrowed and never freed; no element is copied out.
##
## ## Ejemplo
## ```pengu
## calling ward.assert_eq_int_list with xs, ys
## ```
weave assert_eq_int_list with a as list of int , b as list of int into void:
    let na as int is a.len
    let nb as int is b.len
    if na != nb:
        calling spark.panic with "assertion failed: list length mismatch: expected {(nb to string)}, got {(na to string)}"
    var i as int is 0
    while i < na:
        let va as int is a at i
        let vb as int is b at i
        if va != vb:
            calling spark.panic with "assertion failed: element mismatch at index {(i to string)}: expected {(vb to string)}, got {(va to string)}"
        set i is i + 1

## Panics unless string lists `a` and `b` have identical length and elements.
##
## ## Parámetros
## - `a`: the actual list. Borrowed.
## - `b`: the expected list. Borrowed.
##
## ## Retorno
## Nothing; the helper returns `void`. It aborts the program via `spark.panic` on
## a length mismatch or at the first index where the strings differ.
##
## ## Efectos
## The message is `assertion failed: list length mismatch: expected <nb>, got <na>`
## or `assertion failed: element mismatch at index <i>: expected "<vb>", got "<va>"`,
## with the element previews quoted and truncated to 80 bytes.
##
## ## Memoria
## Both lists and their strings are borrowed and never freed; the element previews
## are owned temporaries handed to `spark.panic`, which never returns.
##
## ## Ejemplo
## ```pengu
## calling ward.assert_eq_string_list with words, expected_words
## ```
weave assert_eq_string_list with a as list of string , b as list of string into void:
    let na as int is a.len
    let nb as int is b.len
    if na != nb:
        calling spark.panic with "assertion failed: list length mismatch: expected {(nb to string)}, got {(na to string)}"
    var i as int is 0
    while i < na:
        let va as string is a at i
        let vb as string is b at i
        if va != vb:
            calling spark.panic with "assertion failed: element mismatch at index {(i to string)}: expected {(calling _w_fmt_string with vb)}, got {(calling _w_fmt_string with va)}"
        set i is i + 1

