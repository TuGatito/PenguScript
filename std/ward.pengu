    if a > b:
        calling spark.panic with "assertion failed: expected {(a to string)} <= {(b to string)}"

## Panics when integer `v` is outside inclusive range `[lo, hi]`.
##
## ## Parámetros
## - `v`: the value to test.
## - `lo`: the inclusive lower bound.
## - `hi`: the inclusive upper bound.
##
## ## Retorno
## Nothing; the helper returns `void`. It aborts the program via `spark.panic`
## when `v < lo` or `v > hi`.
##
## ## Efectos
## The message is `assertion failed: value <v> not in range [<lo>, <hi>]`.
##
## ## Ejemplo
## ```pengu
## calling ward.assert_in_range_int with month, 1, 12
## ```
weave assert_in_range_int with v as int , lo as int , hi as int into void:
    if v < lo or v > hi:
        calling spark.panic with "assertion failed: value {(v to string)} not in range [{(lo to string)}, {(hi to string)}]"

## Panics when float `v` is outside inclusive range `[lo, hi]`.
##
## ## Parámetros
## - `v`: the value to test.
## - `lo`: the inclusive lower bound.
## - `hi`: the inclusive upper bound.
##
## ## Retorno
## Nothing; the helper returns `void`. It aborts the program via `spark.panic`
## when `v < lo` or `v > hi`.
##
## ## Efectos
## The message is `assertion failed: value <v> not in range [<lo>, <hi>]`.
##
## ## Ejemplo
## ```pengu
## calling ward.assert_in_range_float with prob, 0.0, 1.0
## ```
weave assert_in_range_float with v as float , lo as float , hi as float into void:
    if v < lo or v > hi:
        calling spark.panic with "assertion failed: value {(v to string)} not in range [{(lo to string)}, {(hi to string)}]"

# ----------------------------------------------------------------------------
# String Assertions
# ----------------------------------------------------------------------------

## Panics unless `haystack` contains substring `needle`.
##
## ## Parámetros
## - `haystack`: the string to search in. Borrowed.
## - `needle`: the substring that must appear. Borrowed.
##
## ## Retorno
## Nothing; the helper returns `void`. It aborts the program via `spark.panic`
## when `haystack` does not contain `needle`.
##
## ## Efectos
## The message is `assertion failed: expected <haystack> to contain <needle>`,
## with both strings quoted and truncated to 80 bytes.
##
## ## Memoria
## Both strings are borrowed and never freed. The scan builds one owned temporary
## slice per candidate offset (the language has no allocation-free substring
## view), and the previews are owned temporaries handed to `spark.panic`, which
## never returns.
##
## ## Ejemplo
## ```pengu
## calling ward.assert_string_contains with log_line, "ERROR"
## ```
weave assert_string_contains with haystack as string , needle as string into void:
    var found as bool is needle.len == 0
    var i as int is 0
    while found == false and i + needle.len <= haystack.len:
        if (haystack at i to (i + needle.len)) == needle:
            set found is true
        set i is i + 1
    if found == false:
        calling spark.panic with "assertion failed: expected {(calling _w_fmt_string with haystack)} to contain {(calling _w_fmt_string with needle)}"

## Panics unless string `s` starts with prefix `prefix`.
##
## ## Parámetros
## - `s`: the string to test. Borrowed.
## - `prefix`: the required prefix. Borrowed.
##
## ## Retorno
## Nothing; the helper returns `void`. It aborts the program via `spark.panic`
## when `s` does not start with `prefix`.
##
## ## Efectos
## The message is `assertion failed: expected <s> to start with <prefix>`, with
## both strings quoted and truncated to 80 bytes.
##
## ## Memoria
## Both strings are borrowed and never freed. The comparison builds one owned
## temporary slice of `s`, and the previews are owned temporaries handed to
## `spark.panic`, which never returns.
##
## ## Ejemplo
## ```pengu
## calling ward.assert_string_starts_with with url, "https://"
## ```
weave assert_string_starts_with with s as string , prefix as string into void:
    var matches as bool is false
    if s.len >= prefix.len:
        set matches is (s at 0 to prefix.len) == prefix
    if matches == false:
        calling spark.panic with "assertion failed: expected {(calling _w_fmt_string with s)} to start with {(calling _w_fmt_string with prefix)}"

## Panics unless string `s` ends with suffix `suffix`.
##
## ## Parámetros
## - `s`: the string to test. Borrowed.
## - `suffix`: the required suffix. Borrowed.
##
## ## Retorno
## Nothing; the helper returns `void`. It aborts the program via `spark.panic`
## when `s` does not end with `suffix`.
##
## ## Efectos
## The message is `assertion failed: expected <s> to end with <suffix>`, with both
## strings quoted and truncated to 80 bytes.
##
## ## Memoria
## Both strings are borrowed and never freed. The comparison builds one owned
## temporary slice of `s`, and the previews are owned temporaries handed to
## `spark.panic`, which never returns.
##
## ## Ejemplo
## ```pengu
## calling ward.assert_string_ends_with with path, ".pengu"
## ```
weave assert_string_ends_with with s as string , suffix as string into void:
    var matches as bool is false
    if s.len >= suffix.len:
        set matches is (s at (s.len - suffix.len) to s.len) == suffix
    if matches == false:
        calling spark.panic with "assertion failed: expected {(calling _w_fmt_string with s)} to end with {(calling _w_fmt_string with suffix)}"

## Panics unless string `s` is empty (length 0).
##
## ## Parámetros
## - `s`: the string that must be empty. Borrowed.
##
## ## Retorno
## Nothing; the helper returns `void`. It aborts the program via `spark.panic`
## when `s.len > 0`.
##
## ## Efectos
## The message is `assertion failed: expected empty string, got "<s>"`, with `s`
## quoted and truncated to 80 bytes.
##
## ## Memoria
## The string is borrowed and never freed; the preview is an owned temporary
## handed to `spark.panic`, which never returns.
##
## ## Ejemplo
## ```pengu
## calling ward.assert_string_empty with err_msg
## ```
weave assert_string_empty with s as string into void:
    if s.len > 0:
        calling spark.panic with "assertion failed: expected empty string, got {(calling _w_fmt_string with s)}"

