-- std/versio.pengu — SemVer 2.0.0.
--
-- `Version` guarda los tres números y, opcionalmente, pre-release y build
-- (cadena vacía = ausente). La precedencia sigue la especificación: los números
-- mandan, una versión con pre-release es menor que la misma sin ella, y los
-- identificadores de pre-release se comparan campo a campo.
scroll versio
    unveil rune SemverError
        unveil message: String

    unveil rune Version
        unveil major: Int
        unveil minor: Int
        unveil patch: Int
        unveil pre: String
        unveil build: String

    unveil ritual SemverError for Show
        show = (@) -> String
            format("SemverError(#{@.message})")

    unveil ritual Version for Show
        show = (@) -> String
            @.to_string()

    foreign "pengu"
        versio_parse = (text: Str) -> Result[Version, SemverError]
        versio_compare = (left: &Version, right: &Version) -> Int
        versio_satisfies = (version: &Version, requirement: Str) -> Result[Bool, SemverError]

    unveil ritual Version
        parse = (text: &Str) -> Result[Version, SemverError]
            versio_parse(text)

        major_value = (@) -> Int
            @.major

        minor_value = (@) -> Int
            @.minor

        patch_value = (@) -> Int
            @.patch

        prerelease = (@) -> String
            @.pre.clone()

        build_metadata = (@) -> String
            @.build.clone()

        is_prerelease = (@) -> Bool
            @.pre.len() > 0

        is_stable = (@) -> Bool
            @.pre.len() == 0

        compare = (@, other: &Version) -> Ordering
            bind result = versio_compare(@, other)
            if result < 0 then
                Less
            elseif result > 0 then
                Greater
            else
                Equal

        lt = (@, other: &Version) -> Bool
            versio_compare(@, other) < 0

        le = (@, other: &Version) -> Bool
            versio_compare(@, other) <= 0

        gt = (@, other: &Version) -> Bool
            versio_compare(@, other) > 0

        ge = (@, other: &Version) -> Bool
            versio_compare(@, other) >= 0

        eq_version = (@, other: &Version) -> Bool
            versio_compare(@, other) == 0

        satisfies = (@, requirement: &Str) -> Result[Bool, SemverError]
            versio_satisfies(@, requirement)

        with_pre = (@, pre: &Str) -> Version
            Version(major: @.major, minor: @.minor, patch: @.patch, pre: String.from(pre), build: @.build.clone())

        with_build = (@, build: &Str) -> Version
            Version(major: @.major, minor: @.minor, patch: @.patch, pre: @.pre.clone(), build: String.from(build))

        without_pre = (@) -> Version
            Version(major: @.major, minor: @.minor, patch: @.patch, pre: String.new(), build: @.build.clone())

        increment_major = (@) -> Version
            Version(major: @.major + 1, minor: 0, patch: 0, pre: String.new(), build: String.new())

        increment_minor = (@) -> Version
            Version(major: @.major, minor: @.minor + 1, patch: 0, pre: String.new(), build: String.new())

        increment_patch = (@) -> Version
            Version(major: @.major, minor: @.minor, patch: @.patch + 1, pre: String.new(), build: String.new())

        to_string = (@) -> String
            bind base = format("#{@.major}.#{@.minor}.#{@.patch}")
            if @.pre.len() > 0 then
                if @.build.len() > 0 then
                    format("#{base}-#{@.pre}+#{@.build}")
                else
                    format("#{base}-#{@.pre}")
            elseif @.build.len() > 0 then
                format("#{base}+#{@.build}")
            else
                base

    unveil version = (major: Int, minor: Int, patch: Int) -> Version
        Version(major: major, minor: minor, patch: patch, pre: String.new(), build: String.new())

    unveil parse = (text: &Str) -> Result[Version, SemverError]
        versio_parse(text)
