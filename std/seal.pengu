# ----------------------------------------------------------------------------
# Internal Binary Helpers
# ----------------------------------------------------------------------------

## Converts a hex string to raw bytes, rejecting malformed input.
##
## ## Parámetros
## - `hex`: the hex text, case-insensitive. Borrowed.
##
## ## Retorno
## `some bytes` (owned; release with `banish`) or `none` for an odd length or a
## non-hex digit. Empty input is `some ""`.
##
## ## Nota
## 2.0.0 returned a plain `string` and silently accepted anything: an odd length
## dropped the last nibble and an invalid digit became zero. Use
## `_hex_to_bytes_lenient` for the old behaviour.
weave _hex_to_bytes with hex as string into maybe string:
    var hl as int is hex length
    if hl == 0:
        return some ""
    if (hl % 2) != 0:
        return maybe none
    var parts as list of string is list of string with capacity hl / 2
    var i as int is 0
    while i < hl:
        var v1 as int is calling _hex_digit with (hex at i)
        var v2 as int is calling _hex_digit with (hex at (i + 1))
        if v1 < 0 or v2 < 0:
            return maybe none
        calling parts.push with (chr ((v1 << 4) | v2))
        set i is i + 2
    return some (calling _concat_parts with parts)

## Converts a hex string to raw bytes, tolerating malformed input (legacy).
##
## ## Parámetros
## - `hex`: the hex text. Borrowed.
##
## ## Retorno
## An owned byte string; release it with `banish`. An odd trailing nibble is
## dropped and an invalid digit counts as zero, exactly like 2.0.0.
##
## ## @deprecated Use `_hex_to_bytes` instead.
weave _hex_to_bytes_lenient with hex as string into string:
    var hl as int is hex length
    if hl == 0:
        return ""
    var parts as list of string is list of string
    var i as int is 0
    while (i + 1) < hl:
        var v1 as int is calling _hex_digit with (hex at i)
        var v2 as int is calling _hex_digit with (hex at (i + 1))
        if v1 < 0:
            set v1 is 0
        if v2 < 0:
            set v2 is 0
        calling parts.push with (chr ((v1 << 4) | v2))
        set i is i + 2
    return calling _concat_parts with parts

## Public alias of `_hex_to_bytes`.
##
## ## Parámetros
## - `hex`: the hex text. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none` for malformed input.
weave hex_to_bytes with hex as string into maybe string:
    return calling _hex_to_bytes with hex

## Value of one hexadecimal digit, or `-1`.
##
## ## Parámetros
## - `c`: exactly one character. Borrowed.
##
## ## Retorno
## `0..15`, or `-1` when `c` is not a single hex digit.
weave _hex_digit with c as string into int:
    if (c length) != 1:
        return -1
    var code as int is ord c
    if code >= 48 and code <= 57:
        return code - 48
    if code >= 97 and code <= 102:
        return code - 87
    if code >= 65 and code <= 70:
        return code - 55
    return -1

# ----------------------------------------------------------------------------
# OS randomness (`antiquus`)
# ----------------------------------------------------------------------------

## Returns `n` cryptographically secure random bytes.
##
## ## Motivo
## The module must not depend on `std.lot`: its generator is the C `rand()` PRNG,
## which chunk 6 documents as *not* cryptographically secure. This block reads
## the operating system's CSPRNG instead (`/dev/urandom` on POSIX, `rand_s` on
## Windows) so `random_bytes` really is secret-grade.
##
## ## Memoria
## Allocates one owned `n`-byte string; release it with `banish`.
##
## ## Precondiciones
## Fails closed: an unreadable entropy source returns `""` rather than weak
## bytes. `n <= 0` yields `""`.
antiquus _random_bytes with n as int into string:
    r"""
if (n <= 0) return pengu_string_from_cstr("");
char *buf = (char *)malloc((size_t)n);
if (!buf) return pengu_string_from_cstr("");
int filled = 0;
#if defined(_WIN32)
/* rand_s is the CRT's CSPRNG; it needs no extra library beyond ucrt. */
extern int __cdecl rand_s(unsigned int *buffer);
unsigned int v = 0;
while (filled < n) {
if (rand_s(&v) != 0) { free(buf); return pengu_string_from_cstr(""); }
for (int k = 0; k < 4 && filled < n; k++) { buf[filled++] = (char)((v >> (8 * k)) & 255); }
}
#else
FILE *f = fopen("/dev/urandom", "rb");
if (!f) { free(buf); return pengu_string_from_cstr(""); }
filled = (int)fread(buf, 1, (size_t)n, f);
fclose(f);
if (filled != n) { free(buf); return pengu_string_from_cstr(""); }
#endif
PenguString s;
s.data = buf;
s.len = n;
s.is_owned = 1;
return s;
"""

## Returns `n` cryptographically secure random bytes as lowercase hex.
##
## ## Parámetros
## - `n`: the number of random bytes.
##
## ## Retorno
## An owned string of `2n` hex characters; release it with `banish`.
weave random_token_hex with n as int into string:
    return calling _to_hex with (calling _random_bytes with n)

## Returns `n` cryptographically secure random bytes.
##
## ## Parámetros
## - `n`: the byte count.
##
## ## Retorno
## An owned binary string (release with `banish`), or `""` when the OS entropy
## source is unavailable.
##
## ## Ejemplo
## ```pengu
## var nonce as string is calling seal.random_bytes with 16
## ```
weave random_bytes with n as int into string:
    return calling _random_bytes with n

# ----------------------------------------------------------------------------
# Public API — HMAC (RFC 2104)
# ----------------------------------------------------------------------------

## Computes the raw HMAC of `message` under `alg` with `key`.
##
## ## Parámetros
## - `alg`: an `ALG_*` id.
## - `key`: the secret key; any length. Borrowed.
## - `message`: the bytes to authenticate. Borrowed.
##
## ## Retorno
## An owned binary digest (release with `banish`), or `""` for an unknown
## algorithm. A key longer than the block size is hashed first, as RFC 2104
## requires; the pads are real bytes, so keys and messages may contain NULs.
weave _hmac_raw with alg as int , key as string , message as string into string:
    var block as int is calling _block_len with alg
    if block == 0:
        return ""
    var k as string is key
    if (k length) > block:
        set k is calling _hash_raw with alg , k
    var kparts as list of string is list of string with capacity 2
    calling kparts.push with k
    var pad_len as int is block - (k length)
    if pad_len > 0:
        calling kparts.push with (calling _zero_string with pad_len)
    var kb as string is calling _concat_parts with kparts
    var ipad as list of string is list of string with capacity block
    var opad as list of string is list of string with capacity block
    var j as int is 0
    while j < block:
        var b as int is 0
        if j < (kb length):
            set b is ord (kb at j)
        calling ipad.push with (chr (b ^ 54))
        calling opad.push with (chr (b ^ 92))
        set j is j + 1
    var inner_parts as list of string is list of string with capacity 2
    calling inner_parts.push with (calling _concat_parts with ipad)
    calling inner_parts.push with message
    var inner as string is calling _hash_raw with alg , (calling _concat_parts with inner_parts)
    var outer_parts as list of string is list of string with capacity 2
    calling outer_parts.push with (calling _concat_parts with opad)
    calling outer_parts.push with inner
    return calling _hash_raw with alg , (calling _concat_parts with outer_parts)

## Computes the lowercase hex HMAC of `message` under `alg`.
##
## ## Parámetros
## - `alg`: an `ALG_*` id.
## - `key`: the secret key. Borrowed.
## - `message`: the bytes to authenticate. Borrowed.
##
## ## Retorno
## An owned hex string; release it with `banish`.
weave _hmac_hex with alg as int , key as string , message as string into string:
    return calling _to_hex with (calling _hmac_raw with alg , key , message)

## Computes the HMAC-SHA256 of `message` with `key` as 64 hex characters.
##
