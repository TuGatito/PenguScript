# ----------------------------------------------------------------------------
# Public API — Key derivation
# ----------------------------------------------------------------------------

## Derives a key with PBKDF2-HMAC-SHA256 (RFC 8018).
##
## ## Parámetros
## - `password`: the secret. Borrowed.
## - `salt`: the per-key salt; at least 16 random bytes are recommended. Borrowed.
## - `iterations`: the iteration count; must be at least `1`.
## - `key_len`: the derived key length in bytes.
##
## ## Retorno
## The derived key as lowercase hex (owned; release with `banish`), or `""` for
## invalid parameters. Python parity: `hashlib.pbkdf2_hmac("sha256", …).hex()`.
##
## ## Ejemplo
## ```pengu
## calling seal.pbkdf2_hmac_sha256 with "pw", "salt", 1000, 32
## ```
weave pbkdf2_hmac_sha256 with password as string , salt as string , iterations as int , key_len as int into string:
    return calling _to_hex with (calling _pbkdf2_raw with ALG_SHA256 , password , salt , iterations , key_len)

## Derives a key with PBKDF2-HMAC-SHA512 (RFC 8018).
##
## ## Parámetros
## - `password`: the secret. Borrowed.
## - `salt`: the per-key salt. Borrowed.
## - `iterations`: the iteration count; must be at least `1`.
## - `key_len`: the derived key length in bytes.
##
## ## Retorno
## The derived key as lowercase hex (owned), or `""` for invalid parameters.
weave pbkdf2_hmac_sha512 with password as string , salt as string , iterations as int , key_len as int into string:
    return calling _to_hex with (calling _pbkdf2_raw with ALG_SHA512 , password , salt , iterations , key_len)

## PBKDF2 with raw binary output (private).
##
## ## Parámetros
## - `alg`: an `ALG_*` id.
## - `password`, `salt`: as in `pbkdf2_hmac_sha256`. Borrowed.
## - `iterations`: PBKDF2 iteration count.
## - `key_len`: derived key length in bytes.
##
## ## Retorno
## An owned binary key (release with `banish`), or `""` for invalid parameters.
weave _pbkdf2_raw with alg as int , password as string , salt as string , iterations as int , key_len as int into string:
    if iterations < 1 or key_len <= 0:
        return ""
    var hlen as int is calling _digest_len with alg
    if hlen == 0:
        return ""
    var blocks as int is (key_len + hlen - 1) / hlen
    var out_parts as list of string is list of string with capacity blocks
    var i as int is 1
    while i <= blocks:
        var first_parts as list of string is list of string with capacity 2
        calling first_parts.push with salt
        calling first_parts.push with (calling _int_be32 with i)
        var u as string is calling _hmac_raw with alg , password , (calling _concat_parts with first_parts)
        var t as string is u
        var it as int is 1
        while it < iterations:
            set u is calling _hmac_raw with alg , password , u
            set t is calling _xor_bytes with t , u
            set it is it + 1
        calling out_parts.push with t
        set i is i + 1
    var full as string is calling _concat_parts with out_parts
    if (full length) < key_len:
        return full
    return full at 0 to key_len

## Derives a key with HKDF-SHA256 (RFC 5869).
##
## ## Parámetros
## - `ikm`: the input keying material. Borrowed.
## - `salt`: the optional salt; `""` means a zero-filled salt of digest length.
##   Borrowed.
## - `info`: the optional context string. Borrowed.
## - `key_len`: the output length in bytes.
##
## ## Retorno
## The derived key as lowercase hex (owned), or `""` for invalid parameters.
##
## ## Ejemplo
## ```pengu
## calling seal.hkdf_sha256 with "ikm", "salt", "info", 32
## ```
weave hkdf_sha256 with ikm as string , salt as string , info as string , key_len as int into string:
    return calling _to_hex with (calling _hkdf_raw with ALG_SHA256 , ikm , salt , info , key_len)

## HKDF with raw binary output (private).
##
## ## Parámetros
## - `alg`: an `ALG_*` id.
## - `ikm`, `salt`, `info`: as in `hkdf_sha256`. Borrowed.
## - `key_len`: output length in bytes.
##
## ## Retorno
## An owned binary key (release with `banish`), or `""` for invalid parameters.
weave _hkdf_raw with alg as int , ikm as string , salt as string , info as string , key_len as int into string:
    var hlen as int is calling _digest_len with alg
    if hlen == 0 or key_len <= 0:
        return ""
    var effective_salt as string is salt
    if (effective_salt length) == 0:
        set effective_salt is calling _zero_string with hlen
    var prk as string is calling _hmac_raw with alg , effective_salt , ikm
    var blocks as int is (key_len + hlen - 1) / hlen
    var parts as list of string is list of string with capacity blocks
    var t as string is ""
    var i as int is 1
    while i <= blocks:
        var block_parts as list of string is list of string with capacity 3
        calling block_parts.push with t
        calling block_parts.push with info
        calling block_parts.push with (chr i)
        set t is calling _hmac_raw with alg , prk , (calling _concat_parts with block_parts)
        calling parts.push with t
        set i is i + 1
    var full as string is calling _concat_parts with parts
    if (full length) < key_len:
        return full
    return full at 0 to key_len

## Salsa20/8 S-box over a 64-byte block, as scrypt defines it (private).
##
## ## Parámetros
## - `block`: exactly 64 bytes. Borrowed.
##
## ## Retorno
## An owned 64-byte block; release it with `banish`.
weave _salsa_block with block as string into string:
    return calling _salsa20_8 with block

## scrypt's BlockMix over a `128*r`-byte block (private).
##
## ## Parámetros
## - `block`: the `128*r`-byte block. Borrowed.
## - `r`: the scrypt block factor.
##
## ## Retorno
## An owned `128*r`-byte block; release it with `banish`.
weave _scrypt_block_mix with block as string , r as int into string:
    var chunks as list of string is list of string with capacity (2 * r)
    var i as int is 0
    while i < (2 * r):
        calling chunks.push with (block at (i * 64) to ((i + 1) * 64))
        set i is i + 1
    var x as string is chunks at ((2 * r) - 1)
    var y as list of string is list of string with capacity (2 * r)
    var k as int is 0
    while k < (2 * r):
        set x is calling _salsa20_8 with (calling _xor_bytes with x , (chunks at k))
        calling y.push with x
        set k is k + 1
    var out_parts as list of string is list of string with capacity (2 * r)
    var j as int is 0
    while j < r:
        calling out_parts.push with (y at (2 * j))
        set j is j + 1
    set j is 0
    while j < r:
        calling out_parts.push with (y at ((2 * j) + 1))
        set j is j + 1
    return calling _concat_parts with out_parts

## Reads scrypt's Integerify value from the last 64-byte chunk (private).
##
## ## Parámetros
## - `block`: the `128*r`-byte block. Borrowed.
## - `r`: the scrypt block factor.
##
## ## Retorno
## The low 31 bits of the little-endian integer, which is enough for `mod N`
## with `N <= 2^20`.
weave _integerify with block as string , r as int into int:
    var off as int is ((2 * r) - 1) * 64
    var b0 as int is ord (block at off)
    var b1 as int is ord (block at (off + 1))
    var b2 as int is ord (block at (off + 2))
    var b3 as int is ord (block at (off + 3))
    return (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & 1073741823

## scrypt's ROMix over one `128*r`-byte block (private).
##
## ## Parámetros
## - `block`: the block. Borrowed.
## - `n`: the CPU/memory cost (a power of two).
## - `r`: the block factor.
##
## ## Retorno
## An owned mixed block; release it with `banish`.
weave _scrypt_romix with block as string , n as int , r as int into string:
    var x as string is block
    var v as list of string is list of string with capacity n
    var i as int is 0
    while i < n:
        calling v.push with x
        set x is calling _scrypt_block_mix with x , r
        set i is i + 1
    set i is 0
    while i < n:
        var j as int is (calling _integerify with x , r) % n
        set x is calling _scrypt_block_mix with (calling _xor_bytes with x , (v at j)) , r
        set i is i + 1
    return x

## Derives a key with scrypt (RFC 7914).
##
## ## Parámetros
## - `password`: the secret. Borrowed.
## - `salt`: the per-key salt. Borrowed.
## - `n`: CPU/memory cost, a power of two (`2..2^20`).
## - `r`: block size factor (`1..64`).
## - `p`: parallelisation factor (`1..64`).
## - `key_len`: derived key length in bytes.
##
## ## Retorno
## The derived key as lowercase hex (owned), or `""` for out-of-range parameters
## or when the working set would exceed 1 MiB (a deliberate cap: raise it in a
## future chunk with a `maxmem` parameter).
##
## ## Ejemplo
## ```pengu
## calling seal.scrypt with "pw", "salt", 16, 1, 1, 32
## ```
weave scrypt with password as string , salt as string , n as int , r as int , p as int , key_len as int into string:
    if n < 2 or r < 1 or p < 1 or key_len <= 0:
        return ""
    if (n & (n - 1)) != 0:
        return ""
    if n > 1048576 or r > 64 or p > 64:
        return ""
    if ((128 * r) * p) > 1048576:
        return ""
    var block as string is calling _pbkdf2_raw with ALG_SHA256 , password , salt , 1 , (p * 128) * r
    if (block length) != ((p * 128) * r):
        return ""
    var mixed_parts as list of string is list of string with capacity p
    var i as int is 0
    while i < p:
        var one as string is block at (i * 128 * r) to ((i + 1) * 128 * r)
        calling mixed_parts.push with (calling _scrypt_romix with one , n , r)
        set i is i + 1
    var mixed as string is calling _concat_parts with mixed_parts
    return calling _to_hex with (calling _pbkdf2_raw with ALG_SHA256 , password , mixed , 1 , key_len)

# ----------------------------------------------------------------------------
# Constant-Time Comparison & Verification
# ----------------------------------------------------------------------------

## Performs a constant-time equality check between `a` and `b`.
##
## ## Parámetros
## - `a`, `b`: the strings to compare. Borrowed.
##
## ## Retorno
## `true` when they are byte-equal. The comparison touches every byte of the
## shorter string and never short-circuits on content, so it cannot leak a prefix
## through timing. Use it for MACs and digests, never `==`.
weave const_time_eq with a as string , b as string into bool:
    if (a length) != (b length):
        return false
    var diff as int is 0
    var i as int is 0
    while i < (a length):
        var b1 as int is ord (a at i)
        var b2 as int is ord (b at i)
        set diff is diff | (b1 ^ b2)
        set i is i + 1
    return diff == 0

## Case-insensitive constant-time comparison of two hex digests.
##
## ## Parámetros
## - `a`, `b`: the hex strings. Borrowed.
##
## ## Retorno
## `true` when the strings are equal ignoring ASCII case. 2.0.0's `verify_hash`
## compared case-sensitively, so an uppercase digest never verified.
##
## ## Ejemplo
## ```pengu
## calling seal.digest_compare with "ABCD", "abcd"    # true
## ```
weave digest_compare with a as string , b as string into bool:
    if (a length) != (b length):
        return false
    var lower_a as string is calling a.lower
    var lower_b as string is calling b.lower
    return calling const_time_eq with lower_a , lower_b

## Verifies in constant time that the HMAC-SHA256 of `message` with `key` equals
## `expected_hex`.
##
## ## Parámetros
## - `key`: the secret key. Borrowed.
## - `message`: the authenticated bytes. Borrowed.
## - `expected_hex`: the digest to compare against, any case. Borrowed.
##
## ## Retorno
## `true` when they match.
weave verify_hmac_sha256 with key as string , message as string , expected_hex as string into bool:
    return calling digest_compare with (calling hmac_sha256 with key , message) , expected_hex

## Verifies in constant time that the SHA-256 digest of `data` equals
## `expected_hex` (case-insensitive).
##
## ## Parámetros
## - `data`: the bytes. Borrowed.
## - `expected_hex`: the digest, any case. Borrowed.
##
## ## Retorno
## `true` when they match.
weave verify_sha256 with data as string , expected_hex as string into bool:
    return calling digest_compare with (calling sha256 with data) , expected_hex

## Verifies in constant time that the SHA-512 digest of `data` equals
## `expected_hex` (case-insensitive).
##
## ## Parámetros
## - `data`: the bytes. Borrowed.
## - `expected_hex`: the digest, any case. Borrowed.
##
## ## Retorno
## `true` when they match.
weave verify_sha512 with data as string , expected_hex as string into bool:
    return calling digest_compare with (calling sha512 with data) , expected_hex

## Verifies in constant time that the SHA-1 digest of `data` equals
## `expected_hex` (case-insensitive).
##
## ## Parámetros
## - `data`: the bytes. Borrowed.
## - `expected_hex`: the digest, any case. Borrowed.
##
## ## Retorno
## `true` when they match.
weave verify_sha1 with data as string , expected_hex as string into bool:
    return calling digest_compare with (calling sha1 with data) , expected_hex

## Verifies in constant time that the MD5 digest of `data` equals `expected_hex`
## (case-insensitive).
##
## ## Parámetros
## - `data`: the bytes. Borrowed.
## - `expected_hex`: the digest, any case. Borrowed.
##
## ## Retorno
## `true` when they match.
weave verify_md5 with data as string , expected_hex as string into bool:
    return calling digest_compare with (calling md5 with data) , expected_hex

## Computes the digest of `data` under the named algorithm and compares it.
##
## ## Parámetros
## - `data`: the bytes. Borrowed.
## - `hash_type`: the algorithm name (`md5`, `sha1`, `sha224`, `sha256`,
##   `sha384`, `sha512`, `sha3-256`, `blake2b`, …), case-insensitive. Borrowed.
## - `expected`: the digest to compare against, any case. Borrowed.
##
## ## Retorno
## `true` only when the algorithm is known *and* the digests match. 2.0.0
## returned `true` for an unknown algorithm when `expected` was `""`
## (`const_time_eq("", "")`), and every comparison was case-sensitive.
##
## ## Ejemplo
## ```pengu
## calling seal.verify_hash with "hello", "sha256", digest
## ```
weave verify_hash with data as string , hash_type as string , expected as string into bool:
    var alg as int is calling _alg_from_string with hash_type
    if alg < 0:
        return false
    if (expected length) != (calling _digest_len with alg) * 2:
        return false
    return calling digest_compare with (calling _hash_hex with alg , data) , expected

## Computes the digest of the file at `path` and compares it.
##
## ## Parámetros
## - `path`: the file to read. Borrowed.
## - `hash_type`: the algorithm name, case-insensitive. Borrowed.
## - `expected`: the digest, any case. Borrowed.
##
## ## Retorno
## `true` only when the algorithm is known, the file is readable and the digests
## match.
weave verify_hash_file with path as string , hash_type as string , expected as string into bool:
    var alg as int is calling _alg_from_string with hash_type
    if alg < 0:
        return false
    var computed as maybe string is calling _engine_file_hex with alg , path
    if c as string is computed:
        if (expected length) != ((c length)):
            return false
        return calling digest_compare with c , expected
    return false

## Returns the supported hash algorithm names.
##
## ## Retorno
## An owned list of names in ascending strength order; release it with `banish`.
weave hash_algos into list of string:
    var algos as list of string is list of string
    calling algos.push with "md5"
    calling algos.push with "sha1"
    calling algos.push with "sha224"
    calling algos.push with "sha256"
    calling algos.push with "sha384"
    calling algos.push with "sha512"
    calling algos.push with "sha3-224"
    calling algos.push with "sha3-256"
    calling algos.push with "sha3-384"
    calling algos.push with "sha3-512"
    calling algos.push with "blake2b"
    calling algos.push with "blake2s"
    return algos

## True when `alg` is a supported hash algorithm name (case-insensitive).
##
## ## Parámetros
## - `alg`: the name. Borrowed.
##
## ## Retorno
## `true` when the name maps to an `ALG_*` id.
weave is_valid_hash_alg with alg as string into bool:
    return (calling _alg_from_string with alg) >= 0

## Returns the hex length of the digests produced by algorithm `alg`.
##
## ## Parámetros
## - `alg`: the name, case-insensitive. Borrowed.
##
## ## Retorno
## The number of hex characters, or `0` for an unknown name.
##
## ## Ejemplo
## ```pengu
## calling seal.hash_length with "SHA256"    # 64
## ```
weave hash_length with alg as string into int:
    var id as int is calling _alg_from_string with alg
    if id < 0:
        return 0
    return (calling _digest_len with id) * 2

## Computes the lowercase hex digest of `data` under the named algorithm.
##
## ## Parámetros
## - `data`: the bytes. Borrowed.
## - `hash_type`: the algorithm name, case-insensitive. Borrowed.
##
## ## Retorno
## An owned hex digest (release with `banish`), or `""` for an unknown name.
##
## ## Ejemplo
## ```pengu
## calling seal.hash_stream with "hello", "sha3-256"
## ```
weave hash_stream with data as string , hash_type as string into string:
    var alg as int is calling _alg_from_string with hash_type
    if alg < 0:
        return ""
    return calling _hash_hex with alg , data

# ----------------------------------------------------------------------------
# Public API — Gzip Compression
# ----------------------------------------------------------------------------

## gzip-compresses `data` (RFC 1952) at zlib's default level.
##
## ## Parámetros
## - `data`: the bytes to compress. Borrowed.
##
## ## Retorno
## `some stream` (owned; release with `banish`) or `none` when compression fails.
weave gzip with data as string into maybe string:
    return calling pengu_c_seal_gzip with data

## gzip-compresses `data` at an explicit deflate level.
##
## ## Parámetros
## - `data`: the bytes to compress. Borrowed.
## - `level`: `1` (fastest) to `9` (smallest); `0` stores, anything outside
##   `-1..9` means "default".
##
## ## Retorno
## `some stream` (owned) or `none` when compression fails.
##
## ## Ejemplo
## ```pengu
## calling seal.gzip_level with "hello hello hello", 9
## ```
weave gzip_level with data as string , level as int into maybe string:
    return calling _gzip_level with data , level

## Decompresses a gzip or zlib stream.
##
## ## Parámetros
## - `data`: the compressed stream. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none` when the input is not a valid stream.
weave unzip with data as string into maybe string:
    return calling pengu_c_seal_unzip with data

## gzip-compresses the file at `path` into `output_path`.
##
## ## Parámetros
## - `path`: the input file. Borrowed.
## - `output_path`: the destination file. Borrowed.
##
## ## Retorno
## `true` when the read, compression and write all succeeded.
weave gzip_file with path as string , output_path as string into bool:
    var content as maybe string is calling archivum.read_file with path
    if c as string is content:
        var comp as maybe string is calling pengu_c_seal_gzip with c
        if gz as string is comp:
            return calling archivum.write_file with output_path , gz
    return false

## Decompresses the gzip file at `path` into `output_path`.
##
## ## Parámetros
## - `path`: the compressed file. Borrowed.
## - `output_path`: the destination file. Borrowed.
##
## ## Retorno
## `true` when the read, decompression and write all succeeded.
weave unzip_file with path as string , output_path as string into bool:
    var content as maybe string is calling archivum.read_file with path
    if c as string is content:
        var decomp as maybe string is calling pengu_c_seal_unzip with c
        if raw as string is decomp:
            return calling archivum.write_file with output_path , raw
    return false

## Reads `path` and returns its gzip-compressed bytes in memory.
##
## ## Parámetros
## - `path`: the input file. Borrowed.
##
## ## Retorno
## `some stream` (owned) or `none`.
weave gzip_file_to_bytes with path as string into maybe string:
    var content as maybe string is calling archivum.read_file with path
    if c as string is content:
        return calling gzip with c
    return maybe none

## Reads the gzip file at `path` and returns its decompressed bytes in memory.
##
## ## Parámetros
## - `path`: the compressed file. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none`.
weave unzip_file_to_bytes with path as string into maybe string:
    var content as maybe string is calling archivum.read_file with path
    if c as string is content:
        return calling unzip with c
    return maybe none

# ----------------------------------------------------------------------------
# Public API — Raw Zlib Deflate / Inflate
# ----------------------------------------------------------------------------

## Compresses `data` with raw zlib deflate (RFC 1950) at the default level.
##
## ## Parámetros
## - `data`: the bytes to compress. Borrowed.
##
## ## Retorno
## `some stream` (owned) or `none`.
weave zlib_compress with data as string into maybe string:
    return calling pengu_c_seal_zlib_compress with data

## Compresses `data` with raw zlib deflate at an explicit level.
##
## ## Parámetros
## - `data`: the bytes to compress. Borrowed.
## - `level`: `1`..`9`, `0` to store, anything else for the default.
##
## ## Retorno
## `some stream` (owned) or `none`.
weave zlib_compress_level with data as string , level as int into maybe string:
    return calling _zlib_compress_level with data , level

## Decompresses a raw zlib stream.
##
## ## Parámetros
## - `data`: the zlib stream. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none`.
weave zlib_decompress with data as string into maybe string:
    return calling pengu_c_seal_zlib_decompress with data

## Decompresses a gzip *or* zlib stream, trying the wrapper first.
##
## ## Parámetros
## - `data`: the compressed stream. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none`. The runtime's inflater already auto-detects
## both wrappers; the fallback keeps a caller honest if that ever changes.
##
## ## Ejemplo
## ```pengu
## calling seal.zlib_decompress_auto with maybe_gzip_or_zlib
## ```
weave zlib_decompress_auto with data as string into maybe string:
    var inflated as maybe string is calling unzip with data
    if raw as string is inflated:
        return some raw
    return calling zlib_decompress with data

## Reads `path` and compresses its contents with raw zlib deflate.
##
## ## Parámetros
## - `path`: the input file. Borrowed.
##
## ## Retorno
## `some stream` (owned) or `none`.
weave zlib_compress_file with path as string into maybe string:
    var content as maybe string is calling archivum.read_file with path
    if c as string is content:
        return calling zlib_compress with c
    return maybe none

## Reads the zlib file at `path` and returns its decompressed bytes in memory.
##
## ## Parámetros
## - `path`: the compressed file. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none`.
weave zlib_decompress_file with path as string into maybe string:
    var content as maybe string is calling archivum.read_file with path
    if c as string is content:
        return calling zlib_decompress with c
    return maybe none

# ----------------------------------------------------------------------------
# Result / Error Handling Wrappers
# ----------------------------------------------------------------------------

## gzip variant that reports failure as a `ResultString` (from `std.oracle`).
##
## ## Parámetros
## - `data`: the bytes to compress. Borrowed.
##
## ## Retorno
## `ok(stream)` or `err("Gzip compression failed")`.
##
## ## @deprecated Use `try_gzip_native` instead.
weave try_gzip with data as string into ResultString:
    var comp as maybe string is calling pengu_c_seal_gzip with data
    if gz as string is comp:
        return calling oracle.result_ok_string with gz
    return calling oracle.result_err_string with "Gzip compression failed"

## unzip variant that reports failure as a `ResultString` (from `std.oracle`).
##
## ## Parámetros
## - `data`: the compressed stream. Borrowed.
##
## ## Retorno
## `ok(bytes)` or `err("Gzip decompression failed")`.
##
## ## @deprecated Use `try_unzip_native` instead.
weave try_unzip with data as string into ResultString:
    var decomp as maybe string is calling pengu_c_seal_unzip with data
    if raw as string is decomp:
        return calling oracle.result_ok_string with raw
    return calling oracle.result_err_string with "Gzip decompression failed"

## gzip variant that reports failure as a native `result of string to string`.
##
## ## Parámetros
## - `data`: the bytes to compress. Borrowed.
##
## ## Retorno
## `ok(stream)` or `err(message)`.
##
## ## Ejemplo
## ```pengu
## var r as result of string to string is calling seal.try_gzip_native with payload
## ```
weave try_gzip_native with data as string into result of string to string:
    var comp as maybe string is calling pengu_c_seal_gzip with data
    if gz as string is comp:
        return calling ok_of with gz
    return calling err_of with "Gzip compression failed"

## unzip variant that reports failure as a native `result of string to string`.
##
## ## Parámetros
## - `data`: the compressed stream. Borrowed.
##
## ## Retorno
## `ok(bytes)` or `err(message)`.
weave try_unzip_native with data as string into result of string to string:
    var decomp as maybe string is calling pengu_c_seal_unzip with data
    if raw as string is decomp:
        return calling ok_of with raw
    return calling err_of with "Gzip decompression failed"

# ----------------------------------------------------------------------------
# Streaming digests
# ----------------------------------------------------------------------------

## A streaming digest state.
##
## ## Campos
## - `_state`: the opaque engine buffer (`HASH_STATE_BYTES` bytes).
## - `_alg`: the `ALG_*` id the state was created for.
##
## ## Nota
## The state is a value: assign it to a `var` and call `update` / `finalize` on
## that variable. Copying the rune copies the buffer reference, so keep exactly
## one live owner.
rune HashState:
    _state as string
    _alg as int

## Creates a streaming state for `alg` (private).
##
## ## Parámetros
## - `alg`: an `ALG_*` id.
##
## ## Retorno
## A fresh `HashState`; the caller owns it.
weave _hash_state_new with alg as int into HashState:
    var state as string is calling _blob_new with HASH_STATE_BYTES
    var out as string is ""
    calling _hash_op with OP_INIT , alg , (sigil of state) , "" , (sigil of out)
    return with _state is state , _alg is alg

enchanting HashState:
    ## Creates a streaming MD5 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_md5 into HashState:
        return calling _hash_state_new with ALG_MD5

    ## Creates a streaming SHA-1 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_sha1 into HashState:
        return calling _hash_state_new with ALG_SHA1

    ## Creates a streaming SHA-224 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_sha224 into HashState:
        return calling _hash_state_new with ALG_SHA224

    ## Creates a streaming SHA-256 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## var h as seal.HashState is calling seal.HashState.new_sha256
    ## ```
    weave ritual new_sha256 into HashState:
        return calling _hash_state_new with ALG_SHA256

    ## Creates a streaming SHA-384 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_sha384 into HashState:
        return calling _hash_state_new with ALG_SHA384

    ## Creates a streaming SHA-512 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_sha512 into HashState:
        return calling _hash_state_new with ALG_SHA512

    ## Creates a streaming SHA3-224 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_sha3_224 into HashState:
        return calling _hash_state_new with ALG_SHA3_224

    ## Creates a streaming SHA3-256 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_sha3_256 into HashState:
        return calling _hash_state_new with ALG_SHA3_256

    ## Creates a streaming SHA3-384 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_sha3_384 into HashState:
        return calling _hash_state_new with ALG_SHA3_384

    ## Creates a streaming SHA3-512 state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_sha3_512 into HashState:
        return calling _hash_state_new with ALG_SHA3_512

    ## Creates a streaming BLAKE2b state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_blake2b into HashState:
        return calling _hash_state_new with ALG_BLAKE2B

    ## Creates a streaming BLAKE2s state.
    ##
    ## ## Retorno
    ## A fresh `HashState`.
    weave ritual new_blake2s into HashState:
        return calling _hash_state_new with ALG_BLAKE2S

    ## Absorbs `data` into the state.
    ##
    ## ## Parámetros
    ## - `data`: the next chunk. Borrowed.
    ##
    ## ## Retorno
    ## Nothing.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling h.update with "hel"
    ## calling h.update with "lo"
    ## ```
    weave update with data as string into void:
        var out as string is ""
        calling _hash_op with OP_UPDATE , self->_alg , (sigil of self->_state) , data , (sigil of out)

    ## Closes the state and returns its lowercase hex digest.
    ##
    ## ## Retorno
    ## An owned hex string; release it with `banish`. The state must not be
    ## updated again.
    weave finalize into string:
        var out as string is ""
        calling _hash_op with OP_FINAL_HEX , self->_alg , (sigil of self->_state) , "" , (sigil of out)
        return out

    ## Closes the state and returns its raw digest bytes.
    ##
    ## ## Retorno
    ## An owned binary digest; release it with `banish`.
    weave finalize_raw into string:
        var out as string is ""
        calling _hash_op with OP_FINAL_RAW , self->_alg , (sigil of self->_state) , "" , (sigil of out)
        return out

    ## Returns the algorithm name this state digests with.
    ##
    ## ## Retorno
    ## An owned name such as `"sha3-256"`; release it with `banish`.
    weave algorithm into string:
        return calling _alg_name with self->_alg

## Absorbs `data` into `h` (module-level spelling).
##
## ## Parámetros
## - `h`: the state. Mutated.
## - `data`: the next chunk. Borrowed.
##
## ## Retorno
## Nothing.
weave hash_update with h as ref to HashState , data as string into void:
    var out as string is ""
    calling _hash_op with OP_UPDATE , h->_alg , (sigil of h->_state) , data , (sigil of out)

## Closes `h` and returns its hex digest (module-level spelling).
##
## ## Parámetros
## - `h`: the state. Mutated.
##
## ## Retorno
## An owned hex string; release it with `banish`.
weave hash_finalize with h as ref to HashState into string:
    var out as string is ""
    calling _hash_op with OP_FINAL_HEX , h->_alg , (sigil of h->_state) , "" , (sigil of out)
    return out

## Closes `h` and returns its raw digest (module-level spelling).
##
## ## Parámetros
## - `h`: the state. Mutated.
##
## ## Retorno
## An owned binary digest; release it with `banish`.
weave hash_finalize_raw with h as ref to HashState into string:
    var out as string is ""
    calling _hash_op with OP_FINAL_RAW , h->_alg , (sigil of h->_state) , "" , (sigil of out)
    return out

# ----------------------------------------------------------------------------
# Streaming MACs
# ----------------------------------------------------------------------------

## A streaming HMAC state.
##
## ## Campos
## - `_key`: the secret key.
## - `_alg`: the `ALG_*` id of the underlying digest.
## - `_parts`: the absorbed chunks, joined and hashed once at `finalize`.
##
## ## Nota
## The chunks are buffered rather than folded incrementally because the keyed
## inner hash is already a single pass; this keeps the API identical to
## `HashState` while staying linear.
rune HmacState:
    _key as string
    _alg as int
    _parts as list of string

## Creates a streaming MAC state (private).
##
## ## Parámetros
## - `alg`: an `ALG_*` id.
## - `key`: the secret key. Borrowed (copied into the state).
##
## ## Retorno
## A fresh `HmacState`.
weave _hmac_state_new with alg as int , key as string into HmacState:
    return with _key is key , _alg is alg , _parts is list of string

enchanting HmacState:
    ## Creates a streaming HMAC-SHA256 state.
    ##
    ## ## Parámetros
    ## - `key`: the secret key. Borrowed.
    ##
    ## ## Retorno
    ## A fresh `HmacState`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## var m as seal.HmacState is calling seal.HmacState.new_sha256 with "key"
    ## ```
    weave ritual new_sha256 with key as string into HmacState:
        return calling _hmac_state_new with ALG_SHA256 , key

    ## Creates a streaming HMAC-SHA1 state.
    ##
    ## ## Parámetros
    ## - `key`: the secret key. Borrowed.
    ##
    ## ## Retorno
    ## A fresh `HmacState`.
    weave ritual new_sha1 with key as string into HmacState:
        return calling _hmac_state_new with ALG_SHA1 , key

    ## Creates a streaming HMAC-MD5 state.
    ##
    ## ## Parámetros
    ## - `key`: the secret key. Borrowed.
    ##
    ## ## Retorno
    ## A fresh `HmacState`.
    weave ritual new_md5 with key as string into HmacState:
        return calling _hmac_state_new with ALG_MD5 , key

    ## Creates a streaming HMAC-SHA384 state.
    ##
    ## ## Parámetros
    ## - `key`: the secret key. Borrowed.
    ##
    ## ## Retorno
    ## A fresh `HmacState`.
    weave ritual new_sha384 with key as string into HmacState:
        return calling _hmac_state_new with ALG_SHA384 , key

    ## Creates a streaming HMAC-SHA512 state.
    ##
    ## ## Parámetros
    ## - `key`: the secret key. Borrowed.
    ##
    ## ## Retorno
    ## A fresh `HmacState`.
    weave ritual new_sha512 with key as string into HmacState:
        return calling _hmac_state_new with ALG_SHA512 , key

    ## Creates a streaming HMAC-SHA3-256 state.
    ##
    ## ## Parámetros
    ## - `key`: the secret key. Borrowed.
    ##
    ## ## Retorno
    ## A fresh `HmacState`.
    weave ritual new_sha3_256 with key as string into HmacState:
        return calling _hmac_state_new with ALG_SHA3_256 , key

    ## Creates a streaming HMAC-SHA3-512 state.
    ##
    ## ## Parámetros
    ## - `key`: the secret key. Borrowed.
    ##
    ## ## Retorno
    ## A fresh `HmacState`.
    weave ritual new_sha3_512 with key as string into HmacState:
        return calling _hmac_state_new with ALG_SHA3_512 , key

    ## Absorbs `data` into the MAC.
    ##
    ## ## Parámetros
    ## - `data`: the next chunk. Borrowed.
    ##
    ## ## Retorno
    ## Nothing.
    weave update with data as string into void:
        calling self->_parts.push with data

    ## Closes the MAC and returns its lowercase hex digest.
    ##
    ## ## Retorno
    ## An owned hex string; release it with `banish`.
    weave finalize into string:
        var message as string is calling _concat_parts with self->_parts
        return calling _hmac_hex with self->_alg , self->_key , message

    ## Returns the algorithm name of the underlying digest.
    ##
    ## ## Retorno
    ## An owned name; release it with `banish`.
    weave algorithm into string:
        return calling _alg_name with self->_alg

# ----------------------------------------------------------------------------
# Object Methods (enchanting string)
# ----------------------------------------------------------------------------

enchanting string:
    ## Returns the MD5 hex digest of `self`.
    ##
    ## ## Retorno
    ## An owned 32-character hex string; release it with `banish`.
    weave to_md5 into string:
        return calling md5 with (essence of self)

    ## Returns the SHA-1 hex digest of `self`.
    ##
    ## ## Retorno
    ## An owned 40-character hex string; release it with `banish`.
    weave to_sha1 into string:
        return calling sha1 with (essence of self)

    ## Returns the SHA-224 hex digest of `self`.
    ##
    ## ## Retorno
    ## An owned 56-character hex string; release it with `banish`.
    weave to_sha224 into string:
        return calling sha224 with (essence of self)

    ## Returns the SHA-256 hex digest of `self`.
    ##
    ## ## Retorno
    ## An owned 64-character hex string; release it with `banish`.
    weave to_sha256 into string:
        return calling sha256 with (essence of self)

    ## Returns the SHA-384 hex digest of `self`.
    ##
    ## ## Retorno
    ## An owned 96-character hex string; release it with `banish`.
    weave to_sha384 into string:
        return calling sha384 with (essence of self)

    ## Returns the SHA-512 hex digest of `self`.
    ##
    ## ## Retorno
    ## An owned 128-character hex string; release it with `banish`.
    weave to_sha512 into string:
        return calling sha512 with (essence of self)

    ## Returns the SHA3-256 hex digest of `self`.
    ##
    ## ## Retorno
    ## An owned 64-character hex string; release it with `banish`.
    weave to_sha3_256 into string:
        return calling sha3_256 with (essence of self)

    ## Returns the BLAKE2b hex digest of `self`.
    ##
    ## ## Retorno
    ## An owned 128-character hex string; release it with `banish`.
    weave to_blake2b into string:
        return calling blake2b with (essence of self)

    ## Returns the CRC-32 of `self`.
    ##
    ## ## Retorno
    ## The unsigned 32-bit checksum.
    weave to_crc32 into u32:
        return calling crc32 with (essence of self)

    ## Compresses `self` into a gzip stream.
    ##
    ## ## Retorno
    ## `some stream` (owned) or `none`.
    weave to_gzip into maybe string:
        return calling gzip with (essence of self)

    ## Decompresses `self` as a gzip stream.
    ##
    ## ## Retorno
    ## `some bytes` (owned) or `none`.
    weave from_gzip into maybe string:
        return calling unzip with (essence of self)

    ## Compresses `self` with raw zlib deflate.
    ##
    ## ## Retorno
    ## `some stream` (owned) or `none`.
    weave to_zlib into maybe string:
        return calling zlib_compress with (essence of self)

    ## Decompresses `self` as a raw zlib stream.
    ##
    ## ## Retorno
    ## `some bytes` (owned) or `none`.
    weave from_zlib into maybe string:
        return calling zlib_decompress with (essence of self)

# ----------------------------------------------------------------------------
# Tests
#
# Private harness: `std.ward` imports this module, so importing it back would be
# a cycle (E0004). The assertions use `std.spark` directly.
# ----------------------------------------------------------------------------

## Aborts unless `cond` holds.
weave _expect_true with cond as bool , label as string into void:
    if not cond:
        calling spark.println with "FAIL {label}"
        calling spark.panic with "seal: test failed"

## Aborts unless the two ints are equal.
weave _expect_eq_int with got as int , want as int , label as string into void:
    if got != want:
        calling spark.println with "FAIL {label}: got {got}, want {want}"
        calling spark.panic with "seal: test failed"

## Aborts unless the two strings are byte-equal.
weave _expect_eq_string with got as string , want as string , label as string into void:
    if (calling scrolls.compare with got , want) != 0:
        calling spark.println with "FAIL {label}: got \"{got}\", want \"{want}\""
        calling spark.panic with "seal: test failed"

## Aborts unless the maybe string is present and equals `want`.
weave _expect_some_string with got as maybe string , want as string , label as string into void:
    if v as string is got:
        calling _expect_eq_string with v , want , label
    else:
        calling spark.println with "FAIL {label}: expected some \"{want}\", got none"
        calling spark.panic with "seal: test failed"

test "SEAL_VERSION is the frozen 2.1.0 contract":
    calling _expect_eq_string with SEAL_VERSION , "2.1.0" , "version literal"

test "MD5, SHA-1 and the SHA-2 family match the published digests":
    calling _expect_eq_string with (calling md5 with "hello") , "5d41402abc4b2a76b9719d911017c592" , "md5"
    calling _expect_eq_string with (calling sha1 with "hello") , "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d" , "sha1"
    calling _expect_eq_string with (calling sha224 with "hello") , "ea09ae9cc6768c50fcee903ed054556e5bfc8347907f12598aa24193" , "sha224"
    calling _expect_eq_string with (calling sha256 with "hello") , "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" , "sha256"
    calling _expect_eq_string with (calling sha384 with "hello") , "59e1748777448c69de6b800d7a33bbfb9ff1b463e44354c3553bcdb9c666fa90125a3c79f90397bdf5f6a13de828684f" , "sha384"
    calling _expect_eq_string with (calling sha512 with "hello") , "9b71d224bd62f3785d96d46ad3ea3d73319bfbc2890caadae2dff72519673ca72323c3d99ba5c11d7c7acc6e14b8c5da0c4663475c2e5c3adef46f73bcdec043" , "sha512"

test "SHA-3 matches the published digests":
    calling _expect_eq_string with (calling sha3_256 with "hello") , "3338be694f50c5f338814986cdf0686453a888b84f424d792af4b9202398f392" , "sha3-256"
    calling _expect_eq_string with (calling sha3_512 with "hello") , "75d527c368f2efe848ecf6b073a36767800805e9eef2b1857d5f984f036eb6df891d75f72d9b154518c1cd58835286d1da9a38deba3de98b5a53e5ed78a84976" , "sha3-512"
    calling _expect_eq_string with (calling sha3_224 with "") , "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7" , "sha3-224 empty"
    calling _expect_eq_string with (calling sha3_384 with "") , "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004" , "sha3-384 empty"

test "BLAKE2 matches the published digests, including custom digest sizes":
    calling _expect_eq_string with (calling blake2b with "hello") , "e4cfa39a3d37be31c59609e807970799caa68a19bfaa15135f165085e01d41a65ba1e1b146aeb6bd0092b49eac214c103ccfa3a365954bbbe52f74a2b3620c94" , "blake2b"
    calling _expect_eq_string with (calling blake2b with "hello" , 32) , "324dcf027dd4a30a932c441f365a25e86b173defa4b8e58948253471b81b72cf" , "blake2b-32"
    calling _expect_eq_string with (calling blake2s with "hello") , "19213bacc58dee6dbde3ceb9a47cbb330b3d86f8cca8997eb00be456f140ca25" , "blake2s"
    calling _expect_eq_string with (calling blake2b with "hello" , 0) , "" , "size 0 is rejected"
    calling _expect_eq_string with (calling blake2s with "hello" , 33) , "" , "size too large"

test "HMAC matches Python's hmac for every supported digest":
    calling _expect_eq_string with (calling hmac_sha256 with "key" , "msg") , "2d93cbc1be167bcb1637a4a23cbff01a7878f0c50ee833954ea5221bb1b8c628" , "hmac-sha256"
    calling _expect_eq_string with (calling hmac_sha1 with "key" , "msg") , "102900b72b7bf1031eec76b4804b66052376896b" , "hmac-sha1"
    calling _expect_eq_string with (calling hmac_md5 with "key" , "msg") , "18e3548c59ad40dd03907b7aeee71d67" , "hmac-md5"
    calling _expect_eq_string with (calling hmac_sha384 with "key" , "msg") , "3bba95ff38376a129225ec5430dd3aff6ac7b7acdb829a4af35f33f8c6ddbbf9d85fb31f8b20316db93aedd08a816cfa" , "hmac-sha384"
    calling _expect_eq_string with (calling hmac_sha512 with "key" , "msg") , "1e4b55b925ccc28ed90d9d18fc2393fcbe164c0d84e67e173cc5aa486b7afc106633c66bdc309076f5f8d9fdbbb62456f894f2c23377fbcc12f4ab2940eb6d70" , "hmac-sha512"
    calling _expect_eq_string with (calling hmac_sha3_256 with "key" , "msg") , "56b616feab81d996beb8cf47719b253cfe6d1da9be562c63520fef130a6d935e" , "hmac-sha3-256"

test "BUG-S4: an over-long HMAC key is hashed first, whatever the block size":
    var longkey as list of string is list of string with capacity 100
    var i as int is 0
    while i < 100:
        calling longkey.push with "k"
        set i is i + 1
    var key as string is calling _concat_parts with longkey
    calling _expect_eq_string with (calling hmac_sha256 with key , "msg") , "bd56a1782c2830e8abc6ed866a57a1230661e650b84c62f7ee3accc5fa5af491" , "100-byte key"

test "BUG-S2: HMAC is binary-safe for keys and messages containing NULs":
    var zc as int is 0
    var nulkey as string is "a{(chr zc)}b"
    var nulmsg as string is "a{(chr zc)}b"
    calling _expect_eq_int with (nulkey length) , 3 , "key keeps its NUL"
    calling _expect_eq_string with (calling sha256 with nulkey) , "59b271ae1bbcb1d31d41929817f4b16fb439eb4f31520b5ad1d5ce98920a7138" , "sha256 of a NUL-containing string"
    calling _expect_eq_string with (calling hmac_sha256 with nulkey , "msg") , "d056a5d043fa6f38932b1af43d07a5609dc8da00065fb7b48facf1055acaef97" , "NUL key"
    calling _expect_eq_string with (calling hmac_sha256 with "key" , nulmsg) , "29c5f0eea2d0a51b661193b3a56191192b2861f543ea0499a7f9725f7e7062fc" , "NUL message"

test "PBKDF2 matches Python's hashlib for both digests":
    calling _expect_eq_string with (calling pbkdf2_hmac_sha256 with "password" , "salt" , 1000 , 32) , "632c2812e46d4604102ba7618e9d6d7d2f8128f6266b4a03264d2a0460b7dcb3" , "pbkdf2-sha256"
    calling _expect_eq_string with (calling pbkdf2_hmac_sha512 with "password" , "salt" , 100 , 32) , "fef7276b107040a0a713bcbec9fd3e191cc6153249e245a3e1a22087dbe61606" , "pbkdf2-sha512"
    calling _expect_eq_string with (calling pbkdf2_hmac_sha256 with "password" , "salt" , 0 , 32) , "" , "zero iterations"

test "HKDF matches RFC 5869":
    calling _expect_eq_string with (calling hkdf_sha256 with "ikm" , "salt" , "info" , 42) , "fe8f9615d2374c0d17f77d1aeaf408c2e75fe0466073d0def23c733e2f862dfd6814c9254418fa112fe8" , "hkdf"
    var empty_salt as string is calling hkdf_sha256 with "ikm" , "" , "info" , 32
    calling _expect_eq_int with (empty_salt length) , 64 , "empty salt is allowed"

test "scrypt matches Python's hashlib":
    calling _expect_eq_string with (calling scrypt with "password" , "salt" , 16 , 1 , 1 , 32) , "45133c3dfba48c82235df51a5349924110eee893752f0d4168d2e2aee5722d82" , "n=16 r=1 p=1"
    calling _expect_eq_string with (calling scrypt with "password" , "salt" , 16 , 2 , 1 , 16) , "3542784e3a6729fcad3e831acde06593" , "n=16 r=2 p=1"
    calling _expect_eq_string with (calling scrypt with "password" , "salt" , 3 , 1 , 1 , 32) , "" , "n must be a power of two"

test "CRC-32 matches zlib and composes incrementally":
    calling _expect_eq_int with (((calling crc32 with "hello") to int)) , 907060870 , "crc32"
    var part as u32 is calling crc32_update with 0 , "hel"
    var total as u32 is calling crc32_update with part , "lo"
    calling _expect_eq_int with (total to int) , 907060870 , "incremental crc32"
    calling _expect_eq_int with (((calling crc32 with "") to int)) , 0 , "empty"

test "gzip and zlib round-trip with every level":
    var level as int is 1
    while level <= 9:
        var packed as maybe string is calling gzip_level with "hello hello hello" , level
        if gz as string is packed:
            var back as maybe string is calling unzip with gz
            calling _expect_some_string with back , "hello hello hello" , "gzip round-trip"
        else:
            calling spark.panic with "seal: gzip_level failed"
        set level is level + 1
    var zpacked as maybe string is calling zlib_compress_level with "hello hello hello" , 9
    if z as string is zpacked:
        calling _expect_some_string with (calling zlib_decompress with z) , "hello hello hello" , "zlib round-trip"
        calling _expect_some_string with (calling zlib_decompress_auto with z) , "hello hello hello" , "auto zlib"
        var gz2 as maybe string is calling gzip_level with "hello hello hello" , 9
        if g2 as string is gz2:
            calling _expect_some_string with (calling zlib_decompress_auto with g2) , "hello hello hello" , "auto gzip"
    else:
        calling spark.panic with "seal: zlib_compress_level failed"

test "BUG-S13: the legacy and native result wrappers agree":
    var legacy as ResultString is calling try_gzip with "payload"
    calling _expect_true with legacy.is_ok , "legacy ok"
    var native as result of string to string is calling try_gzip_native with "payload"
    calling _expect_true with native.is_ok , "native ok"
    var bad as result of string to string is calling try_unzip_native with "not a stream"
    calling _expect_true with (not bad.is_ok) , "native err"

test "const_time_eq and digest_compare behave as documented":
    calling _expect_true with (calling const_time_eq with "abc" , "abc") , "equal"
    calling _expect_true with (not (calling const_time_eq with "abc" , "abd")) , "different"
    calling _expect_true with (not (calling const_time_eq with "abc" , "ab")) , "lengths differ"
    calling _expect_true with (calling digest_compare with "ABCD" , "abcd") , "case-insensitive"
    calling _expect_true with (not (calling digest_compare with "ABCD" , "abce")) , "value differs"

test "BUG-S19: verify_hash rejects unknown algorithms and empty digests":
    calling _expect_true with (not (calling verify_hash with "hello" , "nope" , "")) , "unknown algorithm"
    calling _expect_true with (not (calling verify_hash with "hello" , "sha256" , "")) , "empty digest"
    calling _expect_true with (calling verify_hash with "hello" , "sha256" , (calling sha256 with "hello")) , "correct digest"
    calling _expect_true with (not (calling verify_hash with "hello" , "sha256" , (calling sha256 with "world"))) , "wrong digest"

test "BUG-S11: verify_hash is case-insensitive":
    var digest as string is calling sha256 with "hello"
    var upper as string is calling digest.upper
    calling _expect_true with (calling verify_hash with "hello" , "sha256" , upper) , "uppercase digest"
    calling _expect_true with (calling verify_hash with "hello" , "SHA256" , upper) , "uppercase algorithm name"

test "hash_algos, is_valid_hash_alg and hash_length agree":
    var algos as list of string is calling hash_algos
    calling _expect_eq_int with algos.len , 12 , "twelve algorithms"
    calling _expect_true with (calling is_valid_hash_alg with "SHA3-256") , "sha3-256 is valid"
    calling _expect_true with (not (calling is_valid_hash_alg with "crc32")) , "crc32 is not a hash"
    calling _expect_eq_int with (calling hash_length with "sha512") , 128 , "sha512 length"
    calling _expect_eq_int with (calling hash_length with "nope") , 0 , "unknown length"

test "hash_stream dispatches by name":
    calling _expect_eq_string with (calling hash_stream with "hello" , "sha3-256") , (calling sha3_256 with "hello") , "sha3-256"
    calling _expect_eq_string with (calling hash_stream with "hello" , "blake2b") , (calling blake2b with "hello") , "blake2b"
    calling _expect_eq_string with (calling hash_stream with "hello" , "nope") , "" , "unknown name"

test "HashState streaming equals the one-shot digest":
    var h as HashState is calling HashState.new_sha256
    calling h.update with "hel"
    calling h.update with "lo"
    calling _expect_eq_string with (calling h.finalize) , (calling sha256 with "hello") , "sha256 stream"
    var h3 as HashState is calling HashState.new_sha3_256
    calling _expect_eq_string with (calling h3.algorithm) , "sha3-256" , "algorithm name"
    calling h3.update with "hello"
    calling _expect_eq_string with (calling h3.finalize) , (calling sha3_256 with "hello") , "sha3-256 stream"
    var hb as HashState is calling HashState.new_blake2b
    calling hb.update with "hello"
    calling _expect_eq_string with (calling hb.finalize) , (calling blake2b with "hello") , "blake2b stream"
    var h5 as HashState is calling HashState.new_sha512
    calling h5.update with "hello"
    calling _expect_eq_string with (calling h5.finalize) , (calling sha512 with "hello") , "sha512 stream"
    var h4 as HashState is calling HashState.new_sha384
    calling h4.update with "hello"
    calling _expect_eq_string with (calling h4.finalize) , (calling sha384 with "hello") , "sha384 stream"

test "HashState raw output and the module-level spellings work":
    var h as HashState is calling HashState.new_sha256
    calling hash_update with (sigil of h) , "hello"
    var raw as string is calling hash_finalize_raw with (sigil of h)
    calling _expect_eq_int with (raw length) , 32 , "raw digest length"
    calling _expect_eq_string with (calling _to_hex with raw) , (calling sha256 with "hello") , "raw hex"
    var h2 as HashState is calling HashState.new_blake2s
    calling hash_update with (sigil of h2) , "hello"
    calling _expect_eq_string with (calling hash_finalize with (sigil of h2)) , (calling blake2s with "hello") , "blake2s stream"

test "HmacState streaming equals the one-shot MAC":
    var m as HmacState is calling HmacState.new_sha256 with "key"
    calling m.update with "ms"
    calling m.update with "g"
    calling _expect_eq_string with (calling m.finalize) , (calling hmac_sha256 with "key" , "msg") , "hmac stream"
    calling _expect_eq_string with (calling m.algorithm) , "sha256" , "algorithm"
    var m2 as HmacState is calling HmacState.new_sha512 with "key"
    calling m2.update with "msg"
    calling _expect_eq_string with (calling m2.finalize) , (calling hmac_sha512 with "key" , "msg") , "hmac-sha512 stream"

test "BUG-S3: _hex_to_bytes rejects malformed hex and the lenient spelling survives":
    var ok as maybe string is calling _hex_to_bytes with "6869"
    calling _expect_some_string with ok , "hi" , "valid hex"
    calling _expect_true with (not (calling _hex_to_bytes with "abc").is_present) , "odd length"
    calling _expect_true with (not (calling _hex_to_bytes with "zz").is_present) , "invalid digits"
    var b171 as int is 171
    calling _expect_eq_string with (calling _hex_to_bytes_lenient with "abc") , "{(chr b171)}" , "lenient odd length"
    calling _expect_some_string with (calling hex_to_bytes with "6869") , "hi" , "public alias"

test "random_bytes returns the requested length and fresh values":
    var a as string is calling random_bytes with 32
    var b as string is calling random_bytes with 32
    calling _expect_eq_int with (a length) , 32 , "length"
    calling _expect_true with (not (calling const_time_eq with a , b)) , "two draws differ"
    var token as string is calling random_token_hex with 8
    calling _expect_eq_int with (token length) , 16 , "token length"

test "string enchantments delegate to the module functions":
    var hello as string is "hello"
    calling _expect_eq_string with (calling hello.to_md5) , (calling md5 with "hello") , "to_md5"
    calling _expect_eq_string with (calling hello.to_sha256) , (calling sha256 with "hello") , "to_sha256"
    calling _expect_eq_string with (calling hello.to_sha3_256) , (calling sha3_256 with "hello") , "to_sha3_256"
    calling _expect_eq_string with (calling hello.to_blake2b) , (calling blake2b with "hello") , "to_blake2b"
    calling _expect_eq_int with (((calling hello.to_crc32) to int)) , 907060870 , "to_crc32"
    var gz as maybe string is calling hello.to_gzip
    if g as string is gz:
        calling _expect_some_string with (calling g.from_gzip) , "hello" , "gzip enchantment"
    else:
        calling spark.panic with "seal: to_gzip failed"
