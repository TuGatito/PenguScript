-- std.fluxus — entrada/salida estándar.
--
-- Nota de implementación (S4): `print`, `println`, `eprint`, `eprintln` y
-- `format` ya son primitivas del lenguaje; este módulo aporta la lectura de
-- entrada, el vaciado de buffers y los pactos de lectura/escritura.
--
-- Diferido a S5 (necesita `via` para los `File` y genéricos de `rune`):
-- `Stdin`/`Stdout`/`Stderr` como tipos opacos, `BufReader[T]`/`BufWriter[T]`
-- y las implementaciones de `Reader`/`Writer` para ficheros.

scroll fluxus
    unveil rune IoError
        unveil message: String

    unveil pact Reader
        read = (@mut, count: Usize) -> Result[Vec[U8], IoError]
        read_to_string = (@mut) -> Result[String, IoError]
        read_line = (@mut) -> Result[String, IoError]

    unveil pact Writer
        write = (@mut, data: &[U8]) -> Result[Usize, IoError]
        write_str = (@mut, text: &Str) -> Result[Unit, IoError]
        flush = (@mut) -> Result[Unit, IoError]

    foreign "pengu"
        read_line = () -> Result[String, IoError]
        read_stdin_to_string = () -> Result[String, IoError]
        write_stdout = (text: &Str) -> Result[Unit, IoError]
        write_stderr = (text: &Str) -> Result[Unit, IoError]
        flush_stdout = () -> Result[Unit, IoError]
        flush_stderr = () -> Result[Unit, IoError]
