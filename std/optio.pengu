-- std/optio.pengu — métodos de `Option[T]` y `Result[T, E]`.
--
-- S5. Los dos tipos integrados existían pero no tenían métodos declarados: sin
-- declaración, el checker no los conoce. Aquí se declaran los que el backend
-- puede pasar directamente al método homónimo de Rust (clase T3). Los métodos
-- que Rust no tiene con el mismo nombre (`map`, `and_then`, `ok_or`, `unwrap`,
-- `expect`, …) necesitan `impl` sobre un tipo externo (trait de extensión) y
-- llegarán con S7, junto a `Iter[T]`: ver N34 en scratch/LIMITATIONS_AUDIT.md.
scroll optio
    unveil ritual[T] Option[T]
        is_some = (@) -> Bool
            panic("passthrough")

        is_none = (@) -> Bool
            panic("passthrough")

        unwrap_or = (@, fallback: T) -> T
            panic("passthrough")

        unwrap_or_default = (@) -> T
            panic("passthrough")

        take = (@mut) -> Option[T]
            panic("passthrough")

        replace = (@mut, value: T) -> Option[T]
            panic("passthrough")

    unveil ritual[T, E] Result[T, E]
        is_ok = (@) -> Bool
            panic("passthrough")

        is_err = (@) -> Bool
            panic("passthrough")

        unwrap_or = (@, fallback: T) -> T
            panic("passthrough")

        unwrap_or_default = (@) -> T
            panic("passthrough")
