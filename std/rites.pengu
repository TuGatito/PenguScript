weave get_egid into maybe int:
    let v as int is calling _rites_id with 3
    if v >= 0:
        return some v
    return maybe none

# ----------------------------------------------------------------------------
# Working Directory (0.14.x baseline)
# ----------------------------------------------------------------------------

## Returns the current working directory as a maybe string.
##
## ## Parámetros
## - None.
##
## ## Retorno
## `some path` or `maybe none` when the current directory cannot be determined.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## let cwd as maybe string is calling rites.getcwd
## ```
weave getcwd into maybe string:
    return calling pengu_c_getcwd

## Changes the current working directory to `path`.
##
## ## Parámetros
## - `path`: the target directory. Borrowed.
##
## ## Retorno
## `true` on success; `false` when the path does not exist or access is denied.
##
## ## Memoria
## Arguments are not retained.
##
## ## Ejemplo
## ```pengu
## calling rites.chdir with "/tmp"
## ```
weave chdir with path as string into bool:
    return calling pengu_c_chdir with path

# ----------------------------------------------------------------------------
# Standard User & System Directories (0.15.0)
# ----------------------------------------------------------------------------

## Returns the current user's home directory.
##
## ## Parámetros
## - None.
##
## ## Retorno
## `some path`, or `maybe none` when no source variable is set.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Efectos
## On Windows it inspects `USERPROFILE` and then `HOMEDRIVE` + `HOMEPATH`; on
## POSIX it inspects `HOME`.
##
## ## Ejemplo
## ```pengu
## let home as maybe string is calling rites.home_dir
## ```
weave home_dir into maybe string:
    when os == "windows":
        let up as maybe string is calling getenv with "USERPROFILE"
        if up is present:
            return up
        let hd as maybe string is calling getenv with "HOMEDRIVE"
        let hp as maybe string is calling getenv with "HOMEPATH"
        if hd is present and hp is present:
            return some ("{hd.value}{hp.value}")
        return maybe none
    else:
        let h as maybe string is calling getenv with "HOME"
        if h is present:
            return h
        return maybe none

## Returns the system temporary directory path.
##
## ## Parámetros
## - None.
##
## ## Retorno
## `some path`; never `none` because each platform has a fallback.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Efectos
## On Windows it inspects `TEMP`/`TMP` with fallback `C:\Temp`; on POSIX it
## inspects `TMPDIR`/`TEMP`/`TMP` with fallback `/tmp`.
##
## ## Ejemplo
## ```pengu
## let tmp as maybe string is calling rites.temp_dir
## ```
weave temp_dir into maybe string:
    when os == "windows":
        let t as maybe string is calling getenv with "TEMP"
        if t is present:
            return t
        let tmp as maybe string is calling getenv with "TMP"
        if tmp is present:
            return tmp
        return some "C:\\Temp"
    else:
        let td as maybe string is calling getenv with "TMPDIR"
        if td is present:
            return td
        let t2 as maybe string is calling getenv with "TEMP"
        if t2 is present:
            return t2
        let t3 as maybe string is calling getenv with "TMP"
        return if t3 is present then t3 else some "/tmp"

## Returns the user configuration directory path.
##
## ## Parámetros
## - None.
##
## ## Retorno
## `some path`, or `maybe none` when neither the XDG variable nor the home
## directory is available.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Efectos
## On Windows it returns `%APPDATA%`; on POSIX `$XDG_CONFIG_HOME` or
## `~/.config`.
##
## ## Ejemplo
## ```pengu
## let cfg as maybe string is calling rites.config_dir
## ```
weave config_dir into maybe string:
    when os == "windows":
        let appdata as maybe string is calling getenv with "APPDATA"
        if appdata is present:
            return appdata
        return maybe none
    else:
        let xdg as maybe string is calling getenv with "XDG_CONFIG_HOME"
        if xdg is present:
            return xdg
        let h as maybe string is calling home_dir
        if h is present:
            return some ("{h.value}/.config")
        return maybe none

## Returns the user cache directory path.
##
## ## Parámetros
## - None.
##
## ## Retorno
## `some path`, or `maybe none` when neither the XDG variable nor the home
## directory is available.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Efectos
## On Windows it returns `%LOCALAPPDATA%`; on POSIX `$XDG_CACHE_HOME` or
## `~/.cache`.
##
## ## Ejemplo
## ```pengu
## let cache as maybe string is calling rites.cache_dir
## ```
weave cache_dir into maybe string:
    when os == "windows":
        let localappdata as maybe string is calling getenv with "LOCALAPPDATA"
        if localappdata is present:
            return localappdata
        return maybe none
    else:
        let xdg as maybe string is calling getenv with "XDG_CACHE_HOME"
        if xdg is present:
            return xdg
        let h as maybe string is calling home_dir
        if h is present:
            return some ("{h.value}/.cache")
        return maybe none

## Returns the user local data directory path.
##
## ## Parámetros
## - None.
##
## ## Retorno
## `some path`, or `maybe none` when neither the XDG variable nor the home
## directory is available.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Efectos
## On Windows it returns `%APPDATA%`; on POSIX `$XDG_DATA_HOME` or
## `~/.local/share`.
##
## ## Ejemplo
## ```pengu
## let data as maybe string is calling rites.data_dir
## ```
weave data_dir into maybe string:
    when os == "windows":
        let appdata as maybe string is calling getenv with "APPDATA"
        if appdata is present:
            return appdata
        return maybe none
    else:
        let xdg as maybe string is calling getenv with "XDG_DATA_HOME"
        if xdg is present:
            return xdg
        let h as maybe string is calling home_dir
        if h is present:
            return some ("{h.value}/.local/share")
        return maybe none

# ----------------------------------------------------------------------------
# Platform & Host Information (0.14.x baseline & 0.15.0)
# ----------------------------------------------------------------------------

## Returns the operating-system family name: "Windows", "Darwin", "Linux" or
## "Unknown".
##
## ## Parámetros
## - None.
##
## ## Retorno
## The OS name as a fresh owned string.
##
## ## Memoria
## The result is freshly allocated; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## calling spark.println with calling rites.uname    # e.g. "Linux"
## ```
weave uname into string:
    return calling pengu_c_uname

## Returns the machine's host name.
##
## ## Parámetros
## - None.
##
## ## Retorno
## The host name as a fresh owned string; it may be empty when the OS cannot
## provide one.
##
## ## Memoria
## The result is freshly allocated; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## let host as string is calling rites.hostname
## ```
weave hostname into string:
    return calling pengu_c_hostname

## Returns the host CPU architecture string ("x64", "arm64", "x86", "arm", or
## "unknown").
##
## ## Parámetros
## - None.
##
## ## Retorno
## The architecture name as a string literal chosen at compile time.
##
## ## Memoria
## No allocations; the result is a non-owning literal view.
##
## ## Ejemplo
## ```pengu
## calling rites.os_arch    # e.g. "x64"
## ```
weave os_arch into string:
    when arch == "x64":
        return "x64"
    when arch == "arm64":
        return "arm64"
    when arch == "x86":
        return "x86"
    when arch == "arm":
        return "arm"
    return "unknown"

## Returns the operating-system family name. Alias of `uname()`.
##
## ## Parámetros
## - None.
##
## ## Retorno
## The OS name as a fresh owned string.
##
## ## Memoria
## The result is freshly allocated; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## let family as string is calling rites.os_family
## ```
weave os_family into string:
    return calling pengu_c_uname

## Checks if the current target operating system is Windows.
##
## ## Parámetros
## - None.
##
## ## Retorno
## A compile-time constant `bool`.
##
## ## Memoria
## No allocations.
##
## ## Ejemplo
## ```pengu
## if calling rites.is_windows:
##     calling spark.println with "windows build"
## ```
weave is_windows into bool:
    when os == "windows":
        return true
    else:
        return false

## Checks if the current target operating system is Unix-like (Linux, macOS,
## BSD).
##
## ## Parámetros
## - None.
##
## ## Retorno
## A compile-time constant `bool`: `true` for every non-Windows target.
##
## ## Memoria
## No allocations.
##
## ## Ejemplo
## ```pengu
## calling rites.is_unix    # true on Linux
## ```
weave is_unix into bool:
    when os == "windows":
        return false
    else:
        return true

## Checks if the current target operating system is macOS (Darwin).
##
## ## Parámetros
## - None.
##
## ## Retorno
## A compile-time constant `bool`.
##
## ## Memoria
## No allocations.
##
## ## Ejemplo
## ```pengu
## calling rites.is_macos    # false on Linux
## ```
weave is_macos into bool:
    when os == "macos":
        return true
    else:
        return false

## Checks if the current target operating system is Linux.
##
## ## Parámetros
## - None.
##
## ## Retorno
## A compile-time constant `bool`.
##
## ## Memoria
## No allocations.
##
## ## Ejemplo
## ```pengu
## calling rites.is_linux    # true on Linux
## ```
weave is_linux into bool:
    when os == "linux":
        return true
    else:
        return false

# ----------------------------------------------------------------------------
# Executable Search (PATH resolution) (0.15.0)
# ----------------------------------------------------------------------------

## Searches the system PATH for all executable candidates matching `cmd`.
##
## ## Parámetros
## - `cmd`: the executable name to search for. Borrowed.
##
## ## Retorno
## A new owned `list of string` with one entry per matching PATH directory, in
## PATH order; empty when `PATH` is unset, empty, or has no match.
##
## ## Memoria
## The list and each element are owned by the caller. The elements are built by
## joining a PATH directory with `cmd`, so release each element before the list.
##
## ## Efectos
## On Windows the delimiter is `;` and `.exe`, `.bat`, `.cmd` (and the bare
## name) are tested; on POSIX the delimiter is `:`.
##
## ## Notes
## On POSIX, `which_all` checks for regular file existence in PATH directories
## (`pengu_c_archivum_is_file`). It does not currently inspect POSIX executable
## permission bits (e.g. `access(X_OK)`), which requires a dedicated runtime
## permission bridge.
##
## ## Ejemplo
## ```pengu
## let hits as list of string is calling rites.which_all with "sh"
## ```
weave which_all with cmd as string into list of string:
    var res as list of string is list of string
    let path_var as maybe string is calling getenv with "PATH"
    if path_var is not present:
        return res
    let path_str as string is path_var.value
    let plen as int is path_str length
    if plen == 0:
        return res

    var sep as string is ":"
    when os == "windows":
        set sep is ";"

    var dirs as list of string is list of string
    var start as int is 0
    var i as int is 0
    while i < plen:
        if (path_str at i) == sep:
            if i > start:
                calling dirs.push with (path_str at start to i)
            set start is i + 1
        set i is i + 1
    if start < plen:
        calling dirs.push with (path_str at start to plen)

    for d in dirs:
        when os == "windows":
            let candidate as string is "{d}\\{cmd}"
            let exts as list of string is list of string
            calling exts.push with ""
            calling exts.push with ".exe"
            calling exts.push with ".bat"
            calling exts.push with ".cmd"
            for ext in exts:
                let full_c as string is "{candidate}{ext}"
                if calling pengu_c_archivum_is_file with full_c:
                    calling res.push with full_c
        else:
            let candidate as string is "{d}/{cmd}"
            if calling pengu_c_archivum_is_file with candidate:
                calling res.push with candidate
    return res

## Locates the first executable matching `cmd` on the system PATH.
##
## ## Parámetros
## - `cmd`: the executable name to search for. Borrowed.
##
## ## Retorno
## `some path` for the first PATH match, or `maybe none` when `cmd` is not on
## the PATH.
##
## ## Memoria
## The payload is an owned path string; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## let sh as maybe string is calling rites.which with "sh"
## ```
weave which with cmd as string into maybe string:
    let matches_list as list of string is calling which_all with cmd
    if (calling matches_list.len) > 0:
        return some (matches_list at 0)
    return maybe none

# ----------------------------------------------------------------------------
# Process Termination & Shell Execution (0.14.x baseline & 0.15.0)
# ----------------------------------------------------------------------------

## Terminates the process immediately with exit code `code` (never returns).
##
## ## Parámetros
## - `code`: the process exit status (0–255 on POSIX).
##
## ## Retorno
## Nothing; the helper returns `void`. The process ends before it can return.
##
## ## Memoria
## No allocations.
##
## ## Ejemplo
## ```pengu
## calling rites.exit with 0
## ```
weave exit with code as int into void:
    calling pengu_c_exit with code

## Runs `cmd` plus `args` through the platform shell and blocks until
## completion. Returns the raw status code reported by the shell (-1 on error).
##
## ## Parámetros
## - `cmd`: the program or shell line to run. Borrowed.
## - `args`: the arguments appended to `cmd`. Borrowed.
##
## ## Retorno
## The raw status reported by `system()`; `-1` on failure.
##
## ## Memoria
## Arguments are not retained.
##
## ## Efectos
## Uses `system()` internally; the arguments are joined with spaces and are not
## escaped, so do NOT pass untrusted user input without sanitization.
##
## ## Ejemplo
## ```pengu
## calling rites.exec with "echo", ["hello"]
## ```
weave exec with cmd as string , args as list of string into int:
    return calling pengu_c_exec with cmd , args

## Launches `cmd` with `args` and blocks until it finishes. Shares exec's
## implementation.
##
## ## Parámetros
## - `cmd`: the program or shell line to run. Borrowed.
## - `args`: the arguments appended to `cmd`. Borrowed.
##
## ## Retorno
## The raw status reported by `system()`; `-1` on failure.
##
## ## Memoria
## Arguments are not retained.
##
## ## Efectos
## Currently identical to `exec` (a blocking `system()` call).
##
## ## Ejemplo
## ```pengu
## calling rites.spawn with "echo", ["hello"]
## ```
weave spawn with cmd as string , args as list of string into int:
    return calling pengu_c_spawn with cmd , args

## Runs `cmd` with `args` and returns true if the command succeeded.
##
## ## Parámetros
## - `cmd`: the program or shell line to run. Borrowed.
## - `args`: the arguments appended to `cmd`. Borrowed.
##
## ## Retorno
## `true` when the shell status is exactly `0`, `false` otherwise.
##
## ## Memoria
## Arguments are not retained.
##
## ## Ejemplo
## ```pengu
## if calling rites.exec_ok with "true", []:
##     calling spark.println with "ok"
## ```
weave exec_ok with cmd as string , args as list of string into bool:
    return (calling exec with cmd , args) == 0

## Runs `cmd` with `args` and panics if the command fails.
##
## ## Parámetros
## - `cmd`: the program or shell line to run. Borrowed.
## - `args`: the arguments appended to `cmd`. Borrowed.
##
## ## Retorno
## Nothing; the helper returns `void`.
##
## ## Efectos
## Aborts the program via `spark.panic` when the status is not `0`; the message
## is exactly `Command execution failed with status: <status>`.
##
## ## Memoria
## Arguments are not retained.
##
## ## Ejemplo
## ```pengu
## calling rites.exec_or_panic with "make", ["all"]
## ```
weave exec_or_panic with cmd as string , args as list of string into void:
    let status as int is calling exec with cmd , args
    if status != 0:
        calling spark.panic with "Command execution failed with status: {(status to string)}"

## Executes a raw command line string directly through the platform shell.
##
## ## Parámetros
## - `cmdline`: the complete shell command line. Borrowed.
##
## ## Retorno
## The raw status reported by the platform shell; `-1` on failure.
##
## ## Memoria
## Arguments are not retained.
##
## ## Efectos
## Uses `system()` internally; do NOT pass untrusted user input without
## sanitization.
##
## ## Ejemplo
## ```pengu
## calling rites.run_shell with "echo hello"
## ```
weave run_shell with cmdline as string into int:
    let empty_args as list of string is list of string
    return calling pengu_c_exec with cmdline , empty_args

## Escapes string `s` for safe inclusion as a command line argument.
##
## ## Parámetros
## - `s`: the raw argument text. Borrowed.
##
## ## Retorno
## A new owned escaped string, always wrapped in quotes (`""`/`''` for an empty
## input).
##
## ## Memoria
## The result is freshly allocated; release it with `banish`.
##
## ## Efectos
## POSIX: wraps in single quotes and rewrites each `'` as `'\''`. Windows:
## wraps in double quotes and prefixes each embedded `"` with a backslash.
##
## ## Ejemplo
## ```pengu
## calling rites.shell_escape with "it's"    # 'it'\''s'
## ```
weave shell_escape with s as string into string:
    let slen as int is s length
    if slen == 0:
        when os == "windows":
            return "\"\""
        else:
            return "''"
    when os == "windows":
        var res as string is "\""
        var i as int is 0
        while i < slen:
            let c as string is s at i
            if c == "\"":
                set res is "{res}\\\""
            else:
                set res is "{res}{c}"
            set i is i + 1
        set res is "{res}\""
        return res
    else:
        var res as string is "'"
        var i as int is 0
        while i < slen:
            let c as string is s at i
            if c == "'":
                set res is "{res}'\\''"
            else:
                set res is "{res}{c}"
            set i is i + 1
        set res is "{res}'"
        return res

## Runs `cmd` with `args`, capturing its standard output.
##
## ## Parámetros
## - `cmd`: the executable name or shell line. Borrowed.
## - `args`: the arguments, each escaped with `shell_escape`. Borrowed.
##
## ## Retorno
## `some stdout` when the command exits with status `0`; `maybe none` on a
## non-zero exit, a closed pipe, or an empty command.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Efectos
## Runs the command through the platform shell (`popen`) and blocks until it
## finishes; stderr is not captured and follows the process's own stream.
##
## ## Ejemplo
## ```pengu
## let out as maybe string is calling rites.run_capture with "sh", ["-c", "echo hi"]
## ```
weave run_capture with cmd as string , args as list of string into maybe string:
    let line as string is calling _rites_build_cmdline with cmd , args
    defer banish line
    var err as string is ""
    defer banish err
    return calling _rites_shell_capture with line , (sigil of err)

## Runs `cmd` with `args`, capturing its standard output and exit code.
##
## ## Parámetros
## - `cmd`: the executable name or shell line. Borrowed.
## - `args`: the arguments, each escaped with `shell_escape`. Borrowed.
##
## ## Retorno
## A native `result of string to string`, owned by the caller: `ok(stdout)` on a
## zero exit, `err("command exited with code <code>")` otherwise.
##
## ## Memoria
## The result owns its payload; release it with `banish`.
##
## ## Efectos
## Runs the command through the platform shell (`popen`) and blocks until it
## finishes; stderr is not captured.
##
## ## Ejemplo
## ```pengu
## let r as result of string to string is calling rites.run_capture_result with "sh", ["-c", "exit 3"]
## ```
weave run_capture_result with cmd as string , args as list of string into result of string to string:
    let line as string is calling _rites_build_cmdline with cmd , args
    defer banish line
    var err as string is ""
    let out as maybe string is calling _rites_shell_capture with line , (sigil of err)
    if (err length) > 0:
        return calling err_of with err
    if out is present:
        return calling ok_of with out.value
    return calling ok_of with ""

## Runs `cmd` with `args`, capturing its standard output split into lines.
##
## ## Parámetros
## - `cmd`: the executable name or shell line. Borrowed.
## - `args`: the arguments, each escaped with `shell_escape`. Borrowed.
##
## ## Retorno
## `some lines` on a zero exit, where each line has no trailing newline and a
## trailing newline does not produce a final empty entry; `maybe none` on a
## non-zero exit. Empty output yields `some []`.
##
## ## Memoria
## The list and each element are owned; release the elements before the list.
##
## ## Efectos
## Runs the command through the platform shell (`popen`) and blocks until it
## finishes; stderr is not captured.
##
## ## Ejemplo
## ```pengu
## let lines as maybe list of string is calling rites.run_capture_lines with "printf", ["a\nb\n"]
## ```
weave run_capture_lines with cmd as string , args as list of string into maybe list of string:
    let line as string is calling _rites_build_cmdline with cmd , args
    defer banish line
    var err as string is ""
    defer banish err
    let out as maybe string is calling _rites_shell_capture with line , (sigil of err)
    if (err length) > 0:
        return maybe none
    if out is not present:
        return some (list of string)
    return some (calling _rites_split_lines with out.value)

## Runs `cmd` with `args`, capturing its standard error output.
##
## ## Parámetros
## - `cmd`: the executable name or shell line. Borrowed.
## - `args`: the arguments, each escaped with `shell_escape`. Borrowed.
##
## ## Retorno
## `some stderr` when the command exits with status `0`; `maybe none` on a
## non-zero exit, a closed pipe, or an empty command.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Efectos
## POSIX only: the command line is run inside a subshell that duplicates stderr
## onto stdout and then discards stdout. On Windows the redirect is not applied
## and the result follows `run_capture`.
##
## ## Ejemplo
## ```pengu
## let err as maybe string is calling rites.run_capture_stderr with "sh", ["-c", "echo oops >&2"]
## ```
weave run_capture_stderr with cmd as string , args as list of string into maybe string:
    when os == "windows":
        return calling run_capture with cmd , args
    else:
        let inner as string is calling _rites_build_cmdline with cmd , args
        defer banish inner
        var err as string is ""
        defer banish err
        return calling _rites_shell_capture with "( {inner} ) 2>&1 >/dev/null" , (sigil of err)

## Runs a raw shell command line, capturing its standard output.
##
## ## Parámetros
## - `cmdline`: the complete shell command line. Borrowed.
##
## ## Retorno
## `some stdout` when the shell exits with status `0`; `maybe none` otherwise.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Efectos
## Runs the line through the platform shell (`popen`) and blocks until it
## finishes; the caller owns the quoting, so do NOT pass untrusted input
## unescaped.
##
## ## Ejemplo
## ```pengu
## let out as maybe string is calling rites.run_shell_capture with "echo hi | tr a-z A-Z"
## ```
weave run_shell_capture with cmdline as string into maybe string:
    var err as string is ""
    defer banish err
    return calling _rites_shell_capture with cmdline , (sigil of err)

## Returns the username of the current logged-in user.
##
## ## Parámetros
## - None.
##
## ## Retorno
## `some name`, or `maybe none` when the environment does not carry one.
##
## ## Memoria
## The payload is a fresh owned string; release it with `banish`.
##
## ## Efectos
## On Windows it inspects `USERNAME`; on POSIX `USER` with fallback to `LOGNAME`.
##
## ## Ejemplo
## ```pengu
## let user as maybe string is calling rites.current_user
## ```
weave current_user into maybe string:
    when os == "windows":
        return calling getenv with "USERNAME"
    else:
        let u as maybe string is calling getenv with "USER"
        if u is present:
            return u
        return calling getenv with "LOGNAME"

# ----------------------------------------------------------------------------
# Private Helpers (capture plumbing)
# ----------------------------------------------------------------------------

## Builds the shell command line `cmd arg1 arg2 ...` with every element escaped.
weave _rites_build_cmdline with cmd as string , args as list of string into string:
    var line as string is calling shell_escape with cmd
    for a in args:
        set line is "{line} {(calling shell_escape with a)}"
    return line

## Runs `cmdline` and returns the captured output, or none on failure.
##
## On failure the `err` slot receives the C bridge's message (empty when the
## command was never started); on success the slot stays empty.
weave _rites_shell_capture with cmdline as string , err as ref to string into maybe string:
    var captured as string is calling _rites_capture with cmdline , "out" , err
    if (err length) > 0:
        banish captured
        return maybe none
    return some captured

## Splits `s` on newlines, dropping a single trailing empty entry.
weave _rites_split_lines with s as string into list of string:
    var res as list of string is list of string
    let n as int is s length
    if n == 0:
        return res
    var start as int is 0
    var i as int is 0
    while i < n:
        if (s at i) == "\n":
            calling res.push with (s at start to i)
            set start is i + 1
        set i is i + 1
    if start < n:
        calling res.push with (s at start to n)
    return res

# --- Tests ------------------------------------------------------------------
# The harness is private and panics through `std.spark`; `std.ward` cannot be
# imported here (`ward` imports `std.rites`, which would be an import cycle).
# Every assertion goes through a `_rites_*` helper so the test bodies stay
# unambiguous when several bundled modules are type-checked in one namespace.

## Aborts the current test with `label` when `got != want`.
weave _rites_expect_int with got as int, want as int, label as string into void:
    if got != want:
        calling spark.println with "FAIL {label}: got {got}, want {want}"
        calling spark.panic with "rites: test failed"

## Aborts the current test with `label` when `got != want`.
weave _rites_expect_str with got as string, want as string, label as string into void:
    if got != want:
        calling spark.println with "FAIL {label}: got [{got}], want [{want}]"
        calling spark.panic with "rites: test failed"

## Aborts the current test with `label` when `cond` is false.
weave _rites_expect_true with cond as bool, label as string into void:
    if not cond:
        calling spark.println with "FAIL {label}"
        calling spark.panic with "rites: test failed"

## True when `s` contains `needle` (byte scan; `needle` empty matches anywhere).
weave _rites_contains with s as string, needle as string into bool:
    let n as int is s length
    let m as int is needle length
    if m == 0:
        return true
    if m > n:
        return false
    var i as int is 0
    while i <= (n - m):
        if (s at i to (i + m)) == needle:
            return true
        set i is i + 1
    return false

## Test wrapper: `has_env` under a unique name for the shared test namespace.
weave _rites_has_env with name as string into bool:
    return calling has_env with name

## Test wrapper: `getenv` under a unique name for the shared test namespace.
weave _rites_getenv with name as string into maybe string:
    return calling getenv with name

## Test wrapper: `setenv` under a unique name for the shared test namespace.
weave _rites_setenv with name as string, value as string, overwrite as bool into bool:
    return calling setenv with name, value, overwrite

## Test wrapper: `unsetenv` under a unique name for the shared test namespace.
weave _rites_unsetenv with name as string into bool:
    return calling unsetenv with name

test "RITES_VERSION is 2.14.0":
    calling _rites_expect_str with RITES_VERSION, "2.14.0", "version"

test "setenv, getenv and has_env round-trip":
    let name as string is "PENGU_RITES_TEST_ROUND"
    calling _rites_expect_true with (calling _rites_setenv with name, "value-1", true), "setenv round"
    let got as maybe string is calling _rites_getenv with name
    calling _rites_expect_true with (got is present), "getenv present"
    calling _rites_expect_str with got.value, "value-1", "value"
    calling _rites_expect_true with (calling _rites_has_env with name), "has_env"
    calling _rites_expect_true with (calling _rites_unsetenv with name), "unsetenv"
    let gone as maybe string is calling _rites_getenv with name
    calling _rites_expect_true with (gone is not present), "gone"

test "an empty environment value is present":
    let name as string is "PENGU_RITES_TEST_EMPTY"
    calling _rites_expect_true with (calling _rites_setenv with name, "", true), "setenv empty"
    let got as maybe string is calling _rites_getenv with name
    calling _rites_expect_true with (got is present), "empty present"
    calling _rites_expect_int with (got.value length), 0, "empty length"
    calling _rites_unsetenv with name

test "has_env is false for an unused name":
    calling _rites_expect_true with not (calling _rites_has_env with "PENGU_RITES_TEST_UNSET"), "unused"

test "setenv without overwrite keeps the first value":
    let name as string is "PENGU_RITES_TEST_KEEP"
    calling _rites_setenv with name, "first", true
    calling _rites_setenv with name, "second", false
    let got as maybe string is calling _rites_getenv with name
    calling _rites_expect_true with (got is present), "present"
    calling _rites_expect_str with got.value, "first", "keep first"
    calling _rites_expect_true with (calling _rites_setenv with name, "third", true), "overwrite"
    let got2 as maybe string is calling _rites_getenv with name
    calling _rites_expect_str with got2.value, "third", "overwritten"
    calling _rites_unsetenv with name

test "unsetenv on a missing name does not panic":
    let ok as bool is calling _rites_unsetenv with "PENGU_RITES_TEST_NEVER_SET"
    calling _rites_expect_true with (ok == true or ok == false), "unsetenv returns a bool"

test "getenv_or returns the fallback for an unset name":
    calling _rites_expect_str with (calling getenv_or with "PENGU_RITES_TEST_UNSET", "fallback"), "fallback", "getenv_or"

test "getenv_int parses a set variable":
    let name as string is "PENGU_RITES_TEST_INT"
    calling _rites_setenv with name, "42", true
    let got as maybe int is calling getenv_int with name
    calling _rites_expect_true with (got is present), "int present"
    calling _rites_expect_int with got.value, 42, "int value"
    calling _rites_unsetenv with name

test "getenv_int rejects a non-numeric value":
    let name as string is "PENGU_RITES_TEST_BAD_INT"
    calling _rites_setenv with name, "not-a-number", true
    let got as maybe int is calling getenv_int with name
    calling _rites_expect_true with (got is not present), "bad int"
    calling _rites_unsetenv with name

test "getenv_bool accepts the documented spellings":
    let name as string is "PENGU_RITES_TEST_BOOL"
    calling _rites_setenv with name, "true", true
    let t as maybe bool is calling getenv_bool with name
    calling _rites_expect_true with (t is present), "bool present"
    calling _rites_expect_true with (t.value == true), "bool true"
    calling _rites_setenv with name, "0", true
    let f as maybe bool is calling getenv_bool with name
    calling _rites_expect_true with (f is present), "bool zero present"
    calling _rites_expect_true with (f.value == false), "bool zero"
    calling _rites_unsetenv with name

test "getenv_bool rejects an unrecognized value":
    let name as string is "PENGU_RITES_TEST_BAD_BOOL"
    calling _rites_setenv with name, "maybe", true
    let got as maybe bool is calling getenv_bool with name
    calling _rites_expect_true with (got is not present), "bad bool"
    calling _rites_unsetenv with name

test "expand_env replaces a braced variable":
    let name as string is "PENGU_RITES_TEST_EXPAND"
    calling _rites_setenv with name, "expanded", true
    let open_brace as string is "{"
    let close_brace as string is "}"
    let got as string is calling expand_env with "${open_brace}{name}{close_brace}"
    calling _rites_expect_str with got, "expanded", "braced"
    let wrapped as string is calling expand_env with "[${open_brace}{name}{close_brace}]"
    calling _rites_expect_str with wrapped, "[expanded]", "braced with brackets"
    calling _rites_unsetenv with name

test "expand_env keeps an unknown variable empty":
    let open_brace as string is "{"
    let close_brace as string is "}"
    let got as string is calling expand_env with "a${open_brace}PENGU_RITES_TEST_UNSET{close_brace}b"
    calling _rites_expect_str with got, "ab", "unknown"

test "expand_env treats a doubled dollar as a literal":
    let got as string is calling expand_env with "$$HOME"
    calling _rites_expect_str with got, "$HOME", "escape"

test "env_substitute matches expand_env":
    let name as string is "PENGU_RITES_TEST_ALIAS"
    calling _rites_setenv with name, "alias", true
    let via_env as string is calling env_substitute with "%{name}%"
    calling _rites_expect_str with via_env, "alias", "alias"
    calling _rites_unsetenv with name

test "get_args and get_argc agree":
    let args as list of string is calling get_args
    let argc as int is calling get_argc
    calling _rites_expect_int with (calling args.len), argc, "argc"
    calling _rites_expect_true with (argc >= 1), "at least one"

test "get_argv of index 0 is not empty":
    let first as string is calling get_argv with 0
    calling _rites_expect_true with ((first length) > 0), "argv0"

test "arg_at_or falls back for an out-of-range index":
    calling _rites_expect_str with (calling arg_at_or with 99999, "fallback"), "fallback", "arg_at_or"

test "shell_escape wraps a plain argument in single quotes":
    let got as string is calling shell_escape with "plain"
    calling _rites_expect_str with got, "'plain'", "plain escape"

test "shell_escape doubles an embedded single quote":
    let got as string is calling shell_escape with "it's"
    calling _rites_expect_str with got, "'it'\\''s'", "quote escape"

test "shell_escape of the empty string is two single quotes":
    let got as string is calling shell_escape with ""
    calling _rites_expect_str with got, "''", "empty escape"

test "which finds sh or skips":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        calling _rites_expect_true with ((sh.value length) > 0), "sh path"

test "which_all returns sh when which does":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let all as list of string is calling which_all with "sh"
        calling _rites_expect_true with ((calling all.len) >= 1), "which_all size"

test "which returns none for a name that cannot exist":
    let missing as maybe string is calling which with "pengu-rites-no-such-command-xyzzy"
    calling _rites_expect_true with (missing is not present), "which none"

test "run_capture of sh -c echo returns stdout":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let args as list of string is ["-c", "echo hi"]
        let out as maybe string is calling run_capture with "sh", args
        calling _rites_expect_true with (out is present), "capture present"
        calling _rites_expect_str with out.value, "hi\n", "capture text"

test "run_capture_lines splits stdout into lines":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let args as list of string is ["-c", "printf 'a\\nb\\n'"]
        let lines as maybe list of string is calling run_capture_lines with "sh", args
        calling _rites_expect_true with (lines is present), "lines present"
        calling _rites_expect_int with (lines.value length), 2, "lines count"
        calling _rites_expect_str with (lines.value at 0), "a", "line 0"
        calling _rites_expect_str with (lines.value at 1), "b", "line 1"

test "run_capture_lines of empty stdout is an empty list":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let args as list of string is ["-c", "true"]
        let lines as maybe list of string is calling run_capture_lines with "sh", args
        calling _rites_expect_true with (lines is present), "empty lines present"
        calling _rites_expect_int with (lines.value length), 0, "empty lines count"

test "run_capture returns none on a non-zero exit":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let args as list of string is ["-c", "exit 3"]
        let out as maybe string is calling run_capture with "sh", args
        calling _rites_expect_true with (out is not present), "capture failure"

test "run_capture_result reports the exit code":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let args as list of string is ["-c", "exit 7"]
        let r as result of string to string is calling run_capture_result with "sh", args
        calling _rites_expect_true with not r.is_ok, "result is err"
        let msg as string is r.error
        let code as string is "7"
        calling _rites_expect_true with ((msg length) > 0), "err message"
        calling _rites_expect_true with (calling _rites_contains with msg, code), "err mentions 7"

test "run_capture_result is ok on success":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let args as list of string is ["-c", "echo ok"]
        let r as result of string to string is calling run_capture_result with "sh", args
        calling _rites_expect_true with r.is_ok, "result is ok"
        calling _rites_expect_str with r.value, "ok\n", "result value"

test "run_capture_stderr captures only stderr":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let args as list of string is ["-c", "echo oops >&2"]
        let err as maybe string is calling run_capture_stderr with "sh", args
        calling _rites_expect_true with (err is present), "stderr present"
        calling _rites_expect_str with err.value, "oops\n", "stderr text"

test "run_shell_capture returns the pipeline output":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let out as maybe string is calling run_shell_capture with "echo ab | tr a-z A-Z"
        calling _rites_expect_true with (out is present), "shell capture present"
        calling _rites_expect_str with out.value, "AB\n", "shell capture text"

test "run_shell_capture returns none on a failing line":
    let sh as maybe string is calling which with "sh"
    if sh is present:
        let out as maybe string is calling run_shell_capture with "exit 5"
        calling _rites_expect_true with (out is not present), "shell failure"

test "get_uid and get_gid have the maybe shape of the target":
    if calling is_unix:
        let uid as maybe int is calling get_uid
        let gid as maybe int is calling get_gid
        calling _rites_expect_true with (uid is present), "uid present"
        calling _rites_expect_true with (gid is present), "gid present"
        calling _rites_expect_true with (uid.value >= 0), "uid range"
        calling _rites_expect_true with (gid.value >= 0), "gid range"
    else:
        let w_uid as maybe int is calling get_uid
        calling _rites_expect_true with (w_uid is not present), "uid none on windows"

test "effective ids have the maybe shape of the target":
    if calling is_unix:
        let euid as maybe int is calling get_euid
        let egid as maybe int is calling get_egid
        calling _rites_expect_true with (euid is present), "euid present"
        calling _rites_expect_true with (egid is present), "egid present"
    else:
        let w_euid as maybe int is calling get_euid
        calling _rites_expect_true with (w_euid is not present), "euid none on windows"

test "is_windows and is_unix are consistent":
    let win as bool is calling is_windows
    let unix as bool is calling is_unix
    calling _rites_expect_true with (win != unix), "exclusive"
    calling _rites_expect_true with (win or unix), "at least one"

test "platform predicates are compile-time constants":
    let win as bool is calling is_windows
    let linux as bool is calling is_linux
    let macos as bool is calling is_macos
    calling _rites_expect_true with (linux or macos or win or true), "predicates return bools"

test "os_arch returns a known name or unknown":
    let arch_name as string is calling os_arch
    if arch_name == "x64":
        calling _rites_expect_str with arch_name, "x64", "arch"
    if arch_name == "unknown":
        calling _rites_expect_str with arch_name, "unknown", "arch"

test "getpid and getppid are non-negative":
    calling _rites_expect_true with (calling getpid) >= 0, "pid"
    calling _rites_expect_true with (calling getppid) >= 0, "ppid"

test "getcwd returns the current directory":
    let cwd as maybe string is calling getcwd
    calling _rites_expect_true with (cwd is present), "cwd present"
    calling _rites_expect_true with ((cwd.value length) > 0), "cwd non-empty"

test "temp_dir always has a fallback":
    let tmp as maybe string is calling temp_dir
    calling _rites_expect_true with (tmp is present), "temp present"
    calling _rites_expect_true with ((tmp.value length) > 0), "temp non-empty"

test "home_dir is either present or absent":
    let home as maybe string is calling home_dir
    if home is present:
        calling _rites_expect_true with ((home.value length) > 0), "home non-empty"

test "parse_flags ignores positional arguments":
    let flags as map of string to string is calling parse_flags
    let pos as maybe string is calling get_flag_value with "pengu-rites-no-such-flag"
    calling _rites_expect_true with (pos is not present), "no flag"
    calling _rites_expect_true with ((calling flags.contains with "pengu-rites-no-such-flag") == false), "map miss"

test "has_flag is false for an unused flag":
    calling _rites_expect_true with not (calling has_flag with "pengu-rites-no-such-flag"), "has_flag"

test "uname and os_family agree":
    let a as string is calling uname
    let b as string is calling os_family
    calling _rites_expect_true with ((a length) > 0), "uname non-empty"
    calling _rites_expect_str with a, b, "aliases agree"

test "hostname returns a string":
    let h as string is calling hostname
    calling _rites_expect_true with ((h length) >= 0), "hostname is a string"

test "current_user shape matches the platform":
    let user as maybe string is calling current_user
    if calling is_windows:
        calling _rites_expect_true with (user is present), "windows user present"
    else:
        if user is present:
            calling _rites_expect_true with ((user.value length) > 0), "user non-empty"

test "get_env_keys and get_env_map describe the same environment":
    let keys as list of string is calling get_env_keys
    let env as map of string to string is calling get_env_map
    calling _rites_expect_true with ((calling keys.len) >= (calling env.len) - 1), "keys cover the map"

test "set_env_map reports zero for an empty map":
    let m as map of string to string is map of string to string
    let n as int is calling set_env_map with m
    calling _rites_expect_int with n, 0, "empty map"
