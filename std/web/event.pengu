## std.web.event — typed accessors for DOM events.
##
## `Event` is the same handle as `js.JsValue`; the alias exists so signatures
## read as events and so `dom.on` can pass the callback payload through without
## an adapter. Accessors copy the fields you ask for and leave the handle
## borrowed: do not release it, and call `js.retain` before storing it.
##
## Use `dom.wrap` on `event.target` when you need an `Element`.

import std.web.js as js

const EVENT_VERSION as string is "1.0.0"

alias Event as js.JsValue

when wasm:

    ## The event type, e.g. `"click"` or `"keydown"`.
    weave kind with e as Event into result of string to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with e, "type"
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        return calling js.to_string with v.value

    ## `event.target`, borrowed.
    weave target with e as Event into result of js.JsValue to js.JsError:
        return calling js.get with e, "target"

    ## `event.currentTarget`, borrowed.
    weave current_target with e as Event into result of js.JsValue to js.JsError:
        return calling js.get with e, "currentTarget"

    ## `KeyboardEvent.key`, e.g. `"Enter"` or `"a"`.
    weave key with e as Event into result of maybe string to js.JsError:
        return calling _string_prop with e, "key"

    ## `KeyboardEvent.code`, e.g. `"KeyA"`.
    weave code with e as Event into result of maybe string to js.JsError:
        return calling _string_prop with e, "code"

    ## `MouseEvent.button` (0 primary, 1 auxiliary, 2 secondary).
    weave button with e as Event into result of int to js.JsError:
        return calling _int_prop with e, "button"

    ## `MouseEvent.clientX`.
    weave client_x with e as Event into result of int to js.JsError:
        return calling _int_prop with e, "clientX"

    ## `MouseEvent.clientY`.
    weave client_y with e as Event into result of int to js.JsError:
        return calling _int_prop with e, "clientY"

    ## `MouseEvent.pageX`.
    weave page_x with e as Event into result of int to js.JsError:
        return calling _int_prop with e, "pageX"

    ## `MouseEvent.pageY`.
    weave page_y with e as Event into result of int to js.JsError:
        return calling _int_prop with e, "pageY"

    ## `WheelEvent.deltaY`, useful for scroll direction.
    weave delta_y with e as Event into result of f64 to js.JsError:
        return calling _f64_prop with e, "deltaY"

    ## `InputEvent.data`, e.g. the character just typed.
    weave data with e as Event into result of maybe string to js.JsError:
        return calling _string_prop with e, "data"

    ## `ClipboardEvent.clipboardData.getData("text")`.
    weave clipboard_text with e as Event into result of maybe string to js.JsError:
        var c as result of js.JsValue to js.JsError is calling js.get with e, "clipboardData"
        if not c.is_ok:
            return calling err_of with c.error
        defer calling js.release with c.value
        if calling js.is_null with c.value or calling js.is_undefined with c.value:
            return calling ok_of with (maybe none)
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var t as result of js.JsValue to js.JsError is calling js.string with "text"
        if not t.is_ok:
            return calling err_of with t.error
        calling args.push with t.value
        var v as result of js.JsValue to js.JsError is calling js.call_method with c.value, "getData", args
        calling js.release with t.value
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        if calling js.is_null with v.value:
            return calling ok_of with (maybe none)
        var s as result of string to js.JsError is calling js.from_string with v.value
        if not s.is_ok:
            return calling err_of with s.error
        return calling ok_of with (some s.value)

    ## `Alt`/`Ctrl`/`Meta`/`Shift` modifier state.
    weave is_alt with e as Event into bool:
        return calling _bool_prop with e, "altKey"
    weave is_ctrl with e as Event into bool:
        return calling _bool_prop with e, "ctrlKey"
    weave is_meta with e as Event into bool:
        return calling _bool_prop with e, "metaKey"
    weave is_shift with e as Event into bool:
        return calling _bool_prop with e, "shiftKey"

    ## `true` when the event was generated by the user agent.
    weave is_trusted with e as Event into bool:
        return calling _bool_prop with e, "isTrusted"

    ## Cancels the browser default for this event.
    weave prevent_default with e as Event into result of bool to js.JsError:
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var r as result of js.JsValue to js.JsError is calling js.call_method with e, "preventDefault", args
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Stops propagation to ancestors.
    weave stop_propagation with e as Event into result of bool to js.JsError:
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var r as result of js.JsValue to js.JsError is calling js.call_method with e, "stopPropagation", args
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Stops other listeners on the same element.
    weave stop_immediate with e as Event into result of bool to js.JsError:
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var r as result of js.JsValue to js.JsError is calling js.call_method with e, "stopImmediatePropagation", args
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Reads a string property, returning `none` when it is absent or null.
    weave _string_prop with e as Event, name as string into result of maybe string to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with e, name
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        if calling js.is_null with v.value or calling js.is_undefined with v.value:
            return calling ok_of with (maybe none)
        var s as result of string to js.JsError is calling js.from_string with v.value
        if not s.is_ok:
            return calling err_of with s.error
        return calling ok_of with (some s.value)

    ## Reads an integer property, defaulting to 0 when absent.
    weave _int_prop with e as Event, name as string into result of int to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with e, name
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        if calling js.is_null with v.value or calling js.is_undefined with v.value:
            return calling ok_of with 0
        var n as result of f64 to js.JsError is calling js.to_f64 with v.value
        if not n.is_ok:
            return calling err_of with n.error
        return calling ok_of with (n.value to int)

    ## Reads a floating-point property, defaulting to 0.0 when absent.
    weave _f64_prop with e as Event, name as string into result of f64 to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with e, name
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        if calling js.is_null with v.value or calling js.is_undefined with v.value:
            return calling ok_of with 0.0
        return calling js.to_f64 with v.value

    ## Reads a boolean property, defaulting to false when absent.
    weave _bool_prop with e as Event, name as string into bool:
        var v as result of js.JsValue to js.JsError is calling js.get with e, name
        if not v.is_ok:
            return false
        defer calling js.release with v.value
        return calling js.is_truthy with v.value

when not wasm:

    weave kind with e as Event into result of string to js.JsError:
        return calling err_of with (calling js.last_error)
    weave target with e as Event into result of js.JsValue to js.JsError:
        return calling err_of with (calling js.last_error)
    weave current_target with e as Event into result of js.JsValue to js.JsError:
        return calling err_of with (calling js.last_error)
    weave key with e as Event into result of maybe string to js.JsError:
        return calling err_of with (calling js.last_error)
    weave code with e as Event into result of maybe string to js.JsError:
        return calling err_of with (calling js.last_error)
    weave button with e as Event into result of int to js.JsError:
        return calling err_of with (calling js.last_error)
    weave client_x with e as Event into result of int to js.JsError:
        return calling err_of with (calling js.last_error)
    weave client_y with e as Event into result of int to js.JsError:
        return calling err_of with (calling js.last_error)
    weave page_x with e as Event into result of int to js.JsError:
        return calling err_of with (calling js.last_error)
    weave page_y with e as Event into result of int to js.JsError:
        return calling err_of with (calling js.last_error)
    weave delta_y with e as Event into result of f64 to js.JsError:
        return calling err_of with (calling js.last_error)
    weave data with e as Event into result of maybe string to js.JsError:
        return calling err_of with (calling js.last_error)
    weave clipboard_text with e as Event into result of maybe string to js.JsError:
        return calling err_of with (calling js.last_error)
    weave is_alt with e as Event into bool:
        return false
    weave is_ctrl with e as Event into bool:
        return false
    weave is_meta with e as Event into bool:
        return false
    weave is_shift with e as Event into bool:
        return false
    weave is_trusted with e as Event into bool:
        return false
    weave prevent_default with e as Event into result of bool to js.JsError:
        return calling err_of with (calling js.last_error)
    weave stop_propagation with e as Event into result of bool to js.JsError:
        return calling err_of with (calling js.last_error)
    weave stop_immediate with e as Event into result of bool to js.JsError:
        return calling err_of with (calling js.last_error)
