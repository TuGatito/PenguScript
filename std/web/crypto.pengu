## std.web.crypto — CSPRNG, UUID v4, SHA-256 and HMAC-SHA-256.
##
## WebAssembly-only. Randomness comes from `crypto.getRandomValues` (never
## `Math.random`). Digests use `crypto.subtle` and therefore complete
## asynchronously; pass a one-shot callback pair and read the hex string with
## `text_from`.
##
## ```pengu
## weave on_hash with value as js.JsValue into void:
##     var hex as result of string to js.JsError is calling crypto.text_from with value
##     if hex.is_ok:
##         calling std.web.console_log with hex.value
##         banish hex.value
##
## calling crypto.sha256_hex with "abc", on_hash, on_error
## ```
##
## `subtle` requires a secure context (HTTPS or `localhost`).

import std.builder as builder
import std.web.js as js

alias Value as js.JsValue

const CRYPTO_VERSION as string is "1.1.0"

## Owned byte buffer returned by `random_bytes`.
alias Bytes as vector of u8

when wasm:

    ## `count` cryptographically secure random bytes.
    weave random_bytes with count as int into result of Bytes to js.JsError:
        if count <= 0:
            return calling err_of with (calling _range_error with "random_bytes needs a positive count")
        var h as result of js.JsValue to js.JsError is calling js.random_bytes with count
        if not h.is_ok:
            return calling err_of with h.error
        defer calling js.release with h.value
        var n as result of int to js.JsError is calling js.length with h.value
        if not n.is_ok:
            return calling err_of with n.error
        var out as vector of u8 is vector of u8
        var i as int is 0
        while i < n.value:
            var v as result of js.JsValue to js.JsError is calling js.get_index with h.value, i
            if not v.is_ok:
                banish out
                return calling err_of with v.error
            var raw as result of f64 to js.JsError is calling js.to_f64 with v.value
            calling js.release with v.value
            if not raw.is_ok:
                banish out
                return calling err_of with raw.error
            var c as u8 is (raw.value to int) to u8
            calling out.push with c
            set i is i + 1
        return calling ok_of with out

    ## Uniform integer in `[min, max)`.
    weave random_int with min as int, max as int into result of int to js.JsError:
        if min < 0 or min >= max:
            return calling err_of with (calling _range_error with "random_int needs 0 <= min < max")
        return calling js.random_int with min, max

    ## RFC 4122 version 4 UUID.
    weave uuid_v4 into result of string to js.JsError:
        var h as result of js.JsValue to js.JsError is calling js.random_bytes with 16
        if not h.is_ok:
            return calling err_of with h.error
        defer calling js.release with h.value
        var n as result of int to js.JsError is calling js.length with h.value
        if not n.is_ok:
            return calling err_of with n.error
        var raw as vector of u8 is vector of u8
        var j as int is 0
        while j < n.value:
            var v as result of js.JsValue to js.JsError is calling js.get_index with h.value, j
            if not v.is_ok:
                banish raw
                return calling err_of with v.error
            var f as result of f64 to js.JsError is calling js.to_f64 with v.value
            calling js.release with v.value
            if not f.is_ok:
                banish raw
                return calling err_of with f.error
            var c as u8 is (f.value to int) to u8
            calling raw.push with c
            set j is j + 1
        if raw.len < 16:
            banish raw
            return calling err_of with (calling _range_error with "random source returned too few bytes")
        var b6 as u8 is (raw at 6)
        var b8 as u8 is (raw at 8)
        set raw at (6) is ((b6 & 15) | 64) to u8
        set raw at (8) is ((b8 & 63) | 128) to u8
        var out as string is ""
        var i as int is 0
        while i < 16:
            if i == 4 or i == 6 or i == 8 or i == 10:
                var dash as string is "{out}-"
                banish out
                set out is dash
            var nb as int is (raw at i) to int
            var piece as string is calling _hex_byte with nb
            var joined as string is "{out}{piece}"
            banish out
            banish piece
            set out is joined
            set i is i + 1
        banish raw
        return calling ok_of with out

    ## SHA-256 of `text` as lowercase hex. One-shot callback.
    weave sha256_hex with text as string, on_ok as weave with value as Value into void, on_err as weave with value as Value into void into result of bool to js.JsError:
        return calling js.sha256_hex with text, on_ok, on_err

    ## HMAC-SHA-256 of `text` with `key` as lowercase hex. One-shot callback.
    weave hmac_sha256_hex with text as string, key as string, on_ok as weave with value as Value into void, on_err as weave with value as Value into void into result of bool to js.JsError:
        return calling js.hmac_sha256_hex with text, key, on_ok, on_err

    ## Reads a callback value as a string.
    weave text_from with value as js.JsValue into result of string to js.JsError:
        return calling js.to_string with value

    ## Reads a callback value as an owned error.
    weave error_from with value as js.JsValue into js.JsError:
        var n as result of string to js.JsError is calling js.get with value, "name"
        var m as result of string to js.JsError is calling js.get with value, "message"
        var st as result of string to js.JsError is calling js.get with value, "stack"
        var name as string is if n.is_ok then n.value else "Error"
        var message as string is if m.is_ok then m.value else "crypto operation failed"
        var stack as string is if st.is_ok then st.value else ""
        return with name is name, message is message, stack is stack

    ## Two lowercase hex digits for one byte.
    weave _hex_byte with n as int into string:
        var hi as int is n / 16
        var lo as int is n % 16
        var sb as builder.StringBuilder is calling builder.new
        defer banish sb
        var hc as int is if hi < 10 then 48 + hi else 87 + hi
        var lc as int is if lo < 10 then 48 + lo else 87 + lo
        calling sb.append_char with (hc to char)
        calling sb.append_char with (lc to char)
        var nchars as int is calling sb.len
        return calling sb.substring with 0, nchars

    ## Structured range error.
    weave _range_error with message as string into js.JsError:
        var m as string is "{message}"
        return with name is "RangeError", message is m, stack is ""

when not wasm:

    weave random_bytes with count as int into result of Bytes to js.JsError:
        return calling err_of with (calling js.last_error)
    weave random_int with min as int, max as int into result of int to js.JsError:
        return calling err_of with (calling js.last_error)
    weave uuid_v4 into result of string to js.JsError:
        return calling err_of with (calling js.last_error)
    weave sha256_hex with text as string, on_ok as weave with value as Value into void, on_err as weave with value as Value into void into result of bool to js.JsError:
        return calling err_of with (calling js.last_error)
    weave hmac_sha256_hex with text as string, key as string, on_ok as weave with value as Value into void, on_err as weave with value as Value into void into result of bool to js.JsError:
        return calling err_of with (calling js.last_error)
    weave text_from with value as js.JsValue into result of string to js.JsError:
        return calling err_of with (calling js.last_error)
    weave error_from with value as js.JsValue into js.JsError:
        return calling js.last_error
