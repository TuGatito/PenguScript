## std.web.canvas — Canvas 2D drawing.
##
## WebAssembly-only. `context2d` looks up a canvas element and returns a drawing
## context. All methods return `result`; a missing element, a null context, or a
## browser exception becomes `JsError` with the real name/message/stack.
##
## ```pengu
## var c as result of canvas.Canvas to js.JsError is calling canvas.context2d with "#board"
## if c.is_ok:
##     calling canvas.set_fill_style with c.value, "#101820"
##     calling canvas.fill_rect with c.value, 0.0, 0.0, 320.0, 200.0
##     calling canvas.free with (sigil of c.value)
## ```
##
## Coordinates and sizes are `f64`. Colour strings are CSS colours. The canvas
## element is kept alive by the `Canvas` value.

import std.web.dom as dom
import std.web.js as js

const CANVAS_VERSION as string is "1.0.0"

## A 2D drawing context and its canvas element.
rune Canvas:
    _ctx as js.JsValue
    _element as dom.Element

## Text measurements returned by `measure_text`.
rune TextMetrics:
    width as f64
    actual_left as f64
    actual_right as f64
    actual_ascent as f64
    actual_descent as f64
    font_left as f64
    font_right as f64
    font_ascent as f64
    font_descent as f64

when wasm:

    ## Looks up `selector` and calls `getContext("2d")`.
    weave context2d with selector as string into result of Canvas to js.JsError:
        var found as result of dom.Element to js.JsError is calling dom.query_required with selector
        if not found.is_ok:
            return calling err_of with found.error
        var el as dom.Element is found.value
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var name as result of js.JsValue to js.JsError is calling js.string with "2d"
        if not name.is_ok:
            calling dom.free with (sigil of el)
            return calling err_of with name.error
        calling args.push with name.value
        var ctx as result of js.JsValue to js.JsError is calling js.call_method with (calling dom.raw with el), "getContext", args
        calling js.release with name.value
        if not ctx.is_ok:
            calling dom.free with (sigil of el)
            return calling err_of with ctx.error
        return calling ok_of with (with _ctx is ctx.value, _element is el)

    ## Wraps an existing canvas element. Retains the element.
    weave from_element with el as dom.Element into result of Canvas to js.JsError:
        var kept as result of bool to js.JsError is calling js.retain with (calling dom.raw with el)
        if not kept.is_ok:
            return calling err_of with kept.error
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var name as result of js.JsValue to js.JsError is calling js.string with "2d"
        if not name.is_ok:
            calling js.release with (calling dom.raw with el)
            return calling err_of with name.error
        calling args.push with name.value
        var ctx as result of js.JsValue to js.JsError is calling js.call_method with (calling dom.raw with el), "getContext", args
        calling js.release with name.value
        if not ctx.is_ok:
            calling js.release with (calling dom.raw with el)
            return calling err_of with ctx.error
        return calling ok_of with (with _ctx is ctx.value, _element is el)

    ## Releases the context and the element. Idempotent.
    weave free with c as ref to Canvas into void:
        if c->_ctx != 0:
            calling js.release with c->_ctx
            set c->_ctx is js.UNDEFINED
        calling dom.free with (sigil of c->_element)

    ## Borrowed canvas element.
    weave element with c as Canvas into dom.Element:
        return c._element

    ## Canvas CSS width.
    weave width with c as Canvas into result of int to js.JsError:
        return calling dom.client_width with c._element

    ## Canvas CSS height.
    weave height with c as Canvas into result of int to js.JsError:
        return calling dom.client_height with c._element

    ## Sets a string property such as `fillStyle` or `font`.
    weave set_text_prop with c as Canvas, name as string, value as string into result of bool to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.string with value
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        return calling js.set with c._ctx, name, v.value

    ## Reads a string property.
    weave text_prop with c as Canvas, name as string into result of string to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with c._ctx, name
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        return calling js.to_string with v.value

    ## Sets a numeric property such as `lineWidth`.
    weave set_number_prop with c as Canvas, name as string, value as f64 into result of bool to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.from_f64 with value
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        return calling js.set with c._ctx, name, v.value

    ## Reads a numeric property.
    weave number_prop with c as Canvas, name as string into result of f64 to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with c._ctx, name
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        return calling js.to_f64 with v.value

