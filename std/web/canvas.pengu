    weave draw_image with c as Canvas, image as dom.Element, dx as f64, dy as f64 into result of bool to js.JsError:
        return calling _void_image with c, "drawImage", image, [dx, dy]

    ## `ctx.drawImage(image, dx, dy, width, height)`.
    weave draw_image_scaled with c as Canvas, image as dom.Element, dx as f64, dy as f64, width as f64, height as f64 into result of bool to js.JsError:
        return calling _void_image with c, "drawImage", image, [dx, dy, width, height]

    ## `canvas.toDataURL(type, quality)`.
    weave to_data_url with c as Canvas, kind as string, quality as f64 into result of string to js.JsError:
        var r as result of js.JsValue to js.JsError is calling _call_text with c, "toDataURL", kind, [quality]
        if not r.is_ok:
            return calling err_of with r.error
        defer calling js.release with r.value
        return calling js.to_string with r.value

    ## Calls a method with numeric arguments and discards its result.
    ## Empty numeric argument list.
    weave _empty_numbers into list of f64:
        return list of f64

    weave _void_numbers with c as Canvas, method as string, values as list of f64 into result of bool to js.JsError:
        var r as result of js.JsValue to js.JsError is calling _call_numbers with c, method, values
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Calls a method with a leading string and numeric arguments.
    weave _void_text with c as Canvas, method as string, text as string, values as list of f64 into result of bool to js.JsError:
        var r as result of js.JsValue to js.JsError is calling _call_text with c, method, text, values
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Calls a method with a leading element and numeric arguments.
    weave _void_image with c as Canvas, method as string, image as dom.Element, values as list of f64 into result of bool to js.JsError:
        var r as result of js.JsValue to js.JsError is calling _call_image with c, method, image, values
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Invokes `ctx[method](...)` with numeric arguments.
    weave _call_numbers with c as Canvas, method as string, values as list of f64 into result of js.JsValue to js.JsError:
        defer banish values
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var i as int is 0
        while i < values.len:
            var h as result of js.JsValue to js.JsError is calling js.from_f64 with (values at i)
            if not h.is_ok:
                calling _release_args with args
                return calling err_of with h.error
            calling args.push with h.value
            set i is i + 1
        var r as result of js.JsValue to js.JsError is calling js.call_method with c._ctx, method, args
        calling _release_args with args
        return r

    ## Invokes `ctx[method](text, ...)`.
    weave _call_text with c as Canvas, method as string, text as string, values as list of f64 into result of js.JsValue to js.JsError:
        defer banish values
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var t as result of js.JsValue to js.JsError is calling js.string with text
        if not t.is_ok:
            return calling err_of with t.error
        calling args.push with t.value
        var i as int is 0
        while i < values.len:
            var h as result of js.JsValue to js.JsError is calling js.from_f64 with (values at i)
            if not h.is_ok:
                calling _release_args with args
                return calling err_of with h.error
            calling args.push with h.value
            set i is i + 1
        var r as result of js.JsValue to js.JsError is calling js.call_method with c._ctx, method, args
        calling _release_args with args
        return r

    ## Invokes `ctx[method](image, ...)`.
    weave _call_image with c as Canvas, method as string, image as dom.Element, values as list of f64 into result of js.JsValue to js.JsError:
        defer banish values
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        calling args.push with (calling dom.raw with image)
        var i as int is 0
        while i < values.len:
            var h as result of js.JsValue to js.JsError is calling js.from_f64 with (values at i)
            if not h.is_ok:
                calling _release_args with args
                return calling err_of with h.error
            calling args.push with h.value
            set i is i + 1
        var r as result of js.JsValue to js.JsError is calling js.call_method with c._ctx, method, args
        calling _release_args with args
        return r

    ## Releases numeric handles built for a call.
    weave _release_args with args as list of js.JsValue into void:
        var i as int is 0
        while i < args.len:
            calling js.release with (args at i)
            set i is i + 1

    ## Builds a structured error.
    weave _error with message as string into js.JsError:
        return with name is "CanvasError", message is message, stack is ""

when not wasm:

    weave context2d with selector as string into result of Canvas to js.JsError:
        return calling err_of with (calling js.last_error)
    weave from_element with el as dom.Element into result of Canvas to js.JsError:
        return calling err_of with (calling js.last_error)
    weave free with c as ref to Canvas into void:
        return
    weave element with c as Canvas into dom.Element:
        return c._element
    weave width with c as Canvas into result of int to js.JsError:
        return calling err_of with (calling js.last_error)
    weave height with c as Canvas into result of int to js.JsError:
        return calling err_of with (calling js.last_error)
    weave set_text_prop with c as Canvas, name as string, value as string into result of bool to js.JsError:
        return calling err_of with (calling js.last_error)
    weave text_prop with c as Canvas, name as string into result of string to js.JsError:
        return calling err_of with (calling js.last_error)
    weave set_number_prop with c as Canvas, name as string, value as f64 into result of bool to js.JsError:
        return calling err_of with (calling js.last_error)
    weave number_prop with c as Canvas, name as string into result of f64 to js.JsError:
        return calling err_of with (calling js.last_error)
    weave set_fill_style with c as Canvas, value as string into result of bool to js.JsError:
