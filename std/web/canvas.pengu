    weave stroke_rect with c as Canvas, x as f64, y as f64, width as f64, height as f64 into result of bool to js.JsError:
        return calling _void_numbers with c, "strokeRect", [x, y, width, height]

    ## `ctx.clearRect(x, y, width, height)`.
    weave clear_rect with c as Canvas, x as f64, y as f64, width as f64, height as f64 into result of bool to js.JsError:
        return calling _void_numbers with c, "clearRect", [x, y, width, height]

    ## `ctx.fillText(text, x, y)`.
    weave fill_text with c as Canvas, text as string, x as f64, y as f64 into result of bool to js.JsError:
        return calling _void_text with c, "fillText", text, [x, y]

    ## `ctx.strokeText(text, x, y)`.
    weave stroke_text with c as Canvas, text as string, x as f64, y as f64 into result of bool to js.JsError:
        return calling _void_text with c, "strokeText", text, [x, y]

    ## `ctx.measureText(text).width`.
    weave measure_text_width with c as Canvas, text as string into result of f64 to js.JsError:
        var m as result of js.JsValue to js.JsError is calling _call_text with c, "measureText", text, (calling _empty_numbers)
        if not m.is_ok:
            return calling err_of with m.error
        defer calling js.release with m.value
        var w as result of js.JsValue to js.JsError is calling js.get with m.value, "width"
        if not w.is_ok:
            return calling err_of with w.error
        defer calling js.release with w.value
        return calling js.to_f64 with w.value

