    weave create_image_data with c as Canvas, width as f64, height as f64 into result of js.JsValue to js.JsError:
        return calling js.call_method_f64 with c._ctx, "createImageData", width, height, 0.0, 0.0, 0.0, 0.0, 2

    ## Sets the backing-store size in device pixels.
    weave set_size with c as Canvas, width as int, height as int into result of bool to js.JsError:
        var w as result of js.JsValue to js.JsError is calling js.from_int with width
        if not w.is_ok:
            return calling err_of with w.error
        defer calling js.release with w.value
        var h as result of js.JsValue to js.JsError is calling js.from_int with height
        if not h.is_ok:
            return calling err_of with h.error
        defer calling js.release with h.value
        var raw as js.JsValue is (calling dom.raw with c._element)
        var a as result of bool to js.JsError is calling js.set with raw, "width", w.value
        if not a.is_ok:
            return calling err_of with a.error
        return calling js.set with raw, "height", h.value

    ## Creates a DPR-aware canvas for `selector`: sets the backing store to
    ## `css_size * devicePixelRatio`, keeps the CSS size, and scales the context.
    weave fit_display with selector as string, dpr as bool is true into result of Canvas to js.JsError:
        var c as result of Canvas to js.JsError is calling context2d with selector
        if not c.is_ok:
            return calling err_of with c.error
        var cw as result of int to js.JsError is calling dom.client_width with c.value._element
        if not cw.is_ok:
            calling free with (sigil of c.value)
            return calling err_of with cw.error
        var ch as result of int to js.JsError is calling dom.client_height with c.value._element
        if not ch.is_ok:
            calling free with (sigil of c.value)
            return calling err_of with ch.error
        var ratio as result of f64 to js.JsError is calling _device_pixel_ratio
        if not ratio.is_ok:
            calling free with (sigil of c.value)
            return calling err_of with ratio.error
        var scale_value as f64 is ratio.value
        if not dpr:
            set scale_value is 1.0
        var pw as int is ((cw.value to f64) * scale_value) to int
        var ph as int is ((ch.value to f64) * scale_value) to int
        var sized as result of bool to js.JsError is calling set_size with c.value, pw, ph
        if not sized.is_ok:
            calling free with (sigil of c.value)
            return calling err_of with sized.error
        var sw as result of bool to js.JsError is calling dom.set_style with c.value._element, "width", "{cw.value}px"
        if not sw.is_ok:
            calling free with (sigil of c.value)
            return calling err_of with sw.error
