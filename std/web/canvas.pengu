    ## `ctx.measureText(text)` with the standard `TextMetrics` fields.
    weave measure_text with c as Canvas, text as string into result of TextMetrics to js.JsError:
        var m as result of js.JsValue to js.JsError is calling _call_text with c, "measureText", text, (calling _empty_numbers)
        if not m.is_ok:
            return calling err_of with m.error
        defer calling js.release with m.value
        var w as result of f64 to js.JsError is calling _metric with m.value, "width"
        if not w.is_ok:
            return calling err_of with w.error
        var metrics as TextMetrics is with width is w.value, actual_left is 0.0, actual_right is 0.0, actual_ascent is 0.0, actual_descent is 0.0, font_left is 0.0, font_right is 0.0, font_ascent is 0.0, font_descent is 0.0
        set metrics.actual_left is (calling _metric_or_zero with m.value, "actualBoundingBoxLeft")
        set metrics.actual_right is (calling _metric_or_zero with m.value, "actualBoundingBoxRight")
        set metrics.actual_ascent is (calling _metric_or_zero with m.value, "actualBoundingBoxAscent")
        set metrics.actual_descent is (calling _metric_or_zero with m.value, "actualBoundingBoxDescent")
        set metrics.font_left is (calling _metric_or_zero with m.value, "fontBoundingBoxLeft")
        set metrics.font_right is (calling _metric_or_zero with m.value, "fontBoundingBoxRight")
        set metrics.font_ascent is (calling _metric_or_zero with m.value, "fontBoundingBoxAscent")
        set metrics.font_descent is (calling _metric_or_zero with m.value, "fontBoundingBoxDescent")
        return calling ok_of with metrics

