## std.web.js — JavaScript interop for WebAssembly builds.
##
## `JsValue` is an opaque handle: `0` is `undefined`, `1` is `null`, and every
## other value is registered on the JavaScript side. Handles are owned: call
## `release` when you are done, or `retain` before storing one past the current
## callback. A released handle is invalid, never silently reused.
##
## `JsCallback` bundles the JavaScript function handle with its C slot id. Pass
## the callback to `free_callback` when it is no longer registered anywhere;
## `dom.on`/`dom.off` and `websocket.close` do that for you.
##
## Callback payloads are borrowed for the duration of the callback. If a
## callback wants to keep a `JsValue` argument, it must call `retain`; otherwise
## the bridge releases its reference when the callback returns.
##
## Every public operation returns a `result` whose error carries the JavaScript
## exception name, message, and stack. JavaScript exceptions never escape
## through the C ABI.
##
## This module is the only bridge that needs the Emscripten JS library. Native
## builds get `NotSupported` stubs so the same application code still compiles.

import std.spark

const JS_VERSION as string is "1.0.0"

seal JsValue as i32

const UNDEFINED as JsValue is 0
const NULL as JsValue is 1

## A JavaScript exception, or a bridge failure.
rune JsError:
    name as string
    message as string
    stack as string

## A registered callback. `_value` is the JavaScript function handle and
## `_slot` is its C slot id; both are invalidated by `free_callback`.
rune JsCallback:
    _value as JsValue
    _slot as int

## Handle de una petición `fetch` abortable. El bridge lo invalida al terminar,
## fallar, agotar el timeout o abortar.
rune FetchHandle:
    id as int

## Live bridge counters, useful in tests and leak checks.
rune Stats:
    handles as int
    callbacks as int
    sockets as int

when wasm:

    ## Includes the C runtime that stores callback pointers.
    include "pengu_runtime.h"

    const IS_WASM as bool is true

    declare free with p as ref to void into void

    declare pengu_js_eval with code as ref to frozen char into i32
    declare pengu_js_global into i32
    declare pengu_js_get with obj as i32, name as ref to frozen char into i32
    declare pengu_js_set with obj as i32, name as ref to frozen char, value as i32 into i32
    declare pengu_js_get_index with obj as i32, index as i32 into i32
    declare pengu_js_set_index with obj as i32, index as i32, value as i32 into i32
    declare pengu_js_call with fn as i32, this_v as i32, args as ref to i32, argc as i32 into i32
    declare pengu_js_call_method with obj as i32, name as ref to frozen char, args as ref to i32, argc as i32 into i32
    declare pengu_js_call_method_f64 with obj as i32, name as ref to frozen char, a as f64, b as f64, c as f64, d as f64, e as f64, f as f64, argc as i32 into i32
    declare pengu_js_call_method_text_f64 with obj as i32, name as ref to frozen char, text as ref to frozen char, a as f64, b as f64 into i32
    declare pengu_js_new with ctor as i32, args as ref to i32, argc as i32 into i32
    declare pengu_js_typeof_string with v as i32 into ref to char
    declare pengu_js_is_undefined with v as i32 into i32
    declare pengu_js_is_null with v as i32 into i32
    declare pengu_js_is_valid with v as i32 into i32
    declare pengu_js_is_truthy with v as i32 into i32
    declare pengu_js_to_string with v as i32 into ref to char
    declare pengu_js_to_f64 with v as i32 into f64
    declare pengu_js_to_i64 with v as i32 into i64
    declare pengu_js_to_bool with v as i32 into i32
    declare pengu_js_from_string with text as ref to frozen char into i32
    declare pengu_js_from_f64 with v as f64 into i32
    declare pengu_js_from_i32 with v as i32 into i32
    declare pengu_js_object into i32
    declare pengu_js_array into i32
    declare pengu_js_length with v as i32 into i32
    declare pengu_js_release with v as i32 into i32
    declare pengu_js_retain with v as i32 into i32
    declare pengu_js_make_callback with slot as i32 into i32
    declare pengu_js_promise_then with p as i32, ok_slot as i32, err_slot as i32, ok_handle as i32, err_handle as i32 into i32
    declare pengu_js_import_module with name as ref to frozen char into i32
    declare pengu_js_last_error into ref to char
    declare pengu_js_last_error_name into ref to char
    declare pengu_js_last_error_stack into ref to char
    declare pengu_js_clear_error into void
    declare pengu_js_has_error into i32
    declare pengu_js_callback_new_ptr with fn as ref to void into i32
    declare pengu_js_callback_string_new_ptr with fn as ref to void into i32
    declare pengu_js_callback_free with id as i32 into void
    declare pengu_js_callback_string_free with id as i32 into void
    declare pengu_js_callback_count into i32
    declare pengu_js_callback_capacity into i32
    declare pengu_js_fetch with method as ref to frozen char, url as ref to frozen char, headers as i32, body as i32, ok_slot as i32, err_slot as i32, ok_handle as i32, err_handle as i32, timeout_ms as i32 into i32
    declare pengu_js_abort with id as i32 into i32
    declare pengu_js_ws_open with url as ref to frozen char, open_slot as i32, msg_slot as i32, close_slot as i32, err_slot as i32, open_handle as i32, msg_handle as i32, close_handle as i32, err_handle as i32 into i32
    declare pengu_js_ws_send with id as i32, text as ref to frozen char into i32
    declare pengu_js_ws_close with id as i32, code as i32, reason as ref to frozen char into i32
    declare pengu_js_ws_state with id as i32 into i32
    declare pengu_js_ws_count into i32
    declare pengu_js_canvas_call with ctx as i32, method as ref to frozen char, a as f64, b as f64, c as f64, d as f64 into i32
    declare pengu_js_canvas_text with ctx as i32, method as ref to frozen char, text as ref to frozen char, a as f64, b as f64 into i32
    declare pengu_js_keys with v as i32 into i32
    declare pengu_js_json_parse with text as ref to frozen char into i32
    declare pengu_js_random_bytes with count as i32 into i32
    declare pengu_js_random_int with min as i32, max as i32 into i32
    declare pengu_js_sha256 with text as ref to frozen char, ok_slot as i32, err_slot as i32, ok_handle as i32, err_handle as i32 into i32
    declare pengu_js_hmac_sha256 with text as ref to frozen char, key as ref to frozen char, ok_slot as i32, err_slot as i32, ok_handle as i32, err_handle as i32 into i32
    declare pengu_js_file_pick with accept as ref to frozen char, ok_slot as i32, err_slot as i32, ok_handle as i32, err_handle as i32 into i32
    declare pengu_js_file_read_text with file as i32, ok_slot as i32, err_slot as i32, ok_handle as i32, err_handle as i32 into i32
    declare pengu_js_file_read_data_url with file as i32, ok_slot as i32, err_slot as i32, ok_handle as i32, err_handle as i32 into i32
    declare pengu_js_file_save with text as ref to frozen char, name as ref to frozen char, mime as ref to frozen char into i32
    declare pengu_js_clipboard_write_text with text as ref to frozen char, ok_slot as i32, err_slot as i32, ok_handle as i32, err_handle as i32 into i32
    declare pengu_js_clipboard_read_text with ok_slot as i32, err_slot as i32, ok_handle as i32, err_handle as i32 into i32
    declare pengu_js_json_stringify with v as i32 into i32
    declare pengu_js_handle_count into i32

    ## Evaluates `code` and returns its value.
    weave eval with code as string into result of JsValue to JsError:
        var h as i32 is calling pengu_js_eval with (calling _cstr with code)
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## The JavaScript `globalThis`.
    weave global into JsValue:
        return calling pengu_js_global

    ## Reads `obj.name`.
    weave get with obj as JsValue, name as string into result of JsValue to JsError:
        var h as i32 is calling pengu_js_get with obj, (calling _cstr with name)
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Writes `obj.name = value`.
    weave set with obj as JsValue, name as string, value as JsValue into result of bool to JsError:
        var rc as i32 is calling pengu_js_set with obj, (calling _cstr with name), value
        if rc < 0:
            return calling _fail_bool
        return calling ok_of with true

    ## Reads `obj[index]`.
    weave get_index with obj as JsValue, index as int into result of JsValue to JsError:
        var h as i32 is calling pengu_js_get_index with obj, (index to i32)
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Writes `obj[index] = value`.
    weave set_index with obj as JsValue, index as int, value as JsValue into result of bool to JsError:
        var rc as i32 is calling pengu_js_set_index with obj, (index to i32), value
        if rc < 0:
            return calling _fail_bool
        return calling ok_of with true

    ## Calls `fn` with `this_v` and `args`.
    weave call with fn as JsValue, this_v as JsValue, args as vector of JsValue into result of JsValue to JsError:
        var h as i32 is calling pengu_js_call with fn, this_v, args.data, args.len
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Calls `obj.name(args...)`; releases the temporary method handle.
    weave call_method with obj as JsValue, name as string, args as vector of JsValue into result of JsValue to JsError:
        var f as result of JsValue to JsError is calling get with obj, name
        if not f.is_ok:
            return f
        var h as result of JsValue to JsError is calling call with f.value, obj, args
        calling release with f.value
        return h

    ## Calls a numeric method without building a JavaScript argument list.
    weave call_method_f64 with obj as JsValue, name as string, a as f64, b as f64, c as f64, d as f64, e as f64, f as f64, count as int into result of JsValue to JsError:
        var h as i32 is calling pengu_js_call_method_f64 with obj, (calling _cstr with name), a, b, c, d, e, f, (count to i32)
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Calls a method with a leading string and up to two numbers.
    weave call_method_text_f64 with obj as JsValue, name as string, text as string, a as f64, b as f64 into result of JsValue to JsError:
        var h as i32 is calling pengu_js_call_method_text_f64 with obj, (calling _cstr with name), (calling _cstr with text), a, b
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Constructs `new ctor(args...)`.
    weave new with ctor as JsValue, args as vector of JsValue into result of JsValue to JsError:
        var h as i32 is calling pengu_js_new with ctor, args.data, args.len
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## JavaScript `typeof`.
    weave typeof with v as JsValue into result of string to JsError:
        var p as ref to char is calling pengu_js_typeof_string with v
        if p == null:
            return calling err_of with (calling _error)
        var s as string is calling _take_cstr with p
        return calling ok_of with s

    ## `true` for the `undefined` handle.
    weave is_undefined with v as JsValue into bool:
        return (calling pengu_js_is_undefined with v) != 0

    ## `true` for the `null` handle.
    weave is_null with v as JsValue into bool:
        return (calling pengu_js_is_null with v) != 0

    ## `true` when `v` is a live handle (including `undefined`/`null`).
    weave is_valid with v as JsValue into bool:
        return (calling pengu_js_is_valid with v) != 0

    ## JavaScript truthiness. Invalid handles are falsy.
    weave is_truthy with v as JsValue into bool:
        return (calling pengu_js_is_truthy with v) != 0

    ## JavaScript `String(v)`.
    weave to_string with v as JsValue into result of string to JsError:
        var p as ref to char is calling pengu_js_to_string with v
        if p == null:
            return calling err_of with (calling _error)
        var s as string is calling _take_cstr with p
        return calling ok_of with s

    ## JavaScript `Number(v)`.
    weave to_f64 with v as JsValue into result of f64 to JsError:
        calling pengu_js_clear_error
        var n as f64 is calling pengu_js_to_f64 with v
        if (calling pengu_js_has_error) != 0:
            return calling err_of with (calling _error)
        return calling ok_of with n

    ## JavaScript `BigInt(v)`.
    weave to_i64 with v as JsValue into result of i64 to JsError:
        calling pengu_js_clear_error
        var n as i64 is calling pengu_js_to_i64 with v
        if (calling pengu_js_has_error) != 0:
            return calling err_of with (calling _error)
        return calling ok_of with n

    ## JavaScript `Boolean(v)`.
    weave to_bool with v as JsValue into bool:
        return (calling pengu_js_to_bool with v) != 0

    ## Wraps a PenguScript string as a JavaScript string.
    weave string with s as string into result of JsValue to JsError:
        var h as i32 is calling pengu_js_from_string with (calling _cstr with s)
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Wraps a number as a JavaScript number.
    weave from_f64 with n as f64 into result of JsValue to JsError:
        var h as i32 is calling pengu_js_from_f64 with n
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Wraps an integer as a JavaScript number.
    weave from_int with n as int into result of JsValue to JsError:
        var h as i32 is calling pengu_js_from_i32 with (n to i32)
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Copies a JavaScript string into an owned PenguScript string.
    weave from_string with v as JsValue into result of string to JsError:
        var r as result of string to JsError is calling to_string with v
        return r

    ## A fresh `{}`.
    weave object into result of JsValue to JsError:
        var h as i32 is calling pengu_js_object
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## A fresh `[]`.
    weave array into result of JsValue to JsError:
        var h as i32 is calling pengu_js_array
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## `v.length`.
    weave length with v as JsValue into result of int to JsError:
        var n as i32 is calling pengu_js_length with v
        if n < 0:
            return calling _fail_int
        return calling ok_of with (n to int)

    ## Drops one reference. Releasing an invalid handle is a no-op.
    weave release with v as JsValue into void:
        calling pengu_js_release with v

    ## Adds a reference. The returned handle is the same value.
    weave retain with v as JsValue into result of JsValue to JsError:
        var h as i32 is calling pengu_js_retain with v
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Registers a callback that receives a borrowed `JsValue`.
    weave make_callback with fn as weave with arg as JsValue into void into result of JsCallback to JsError:
        var slot as i32 is calling pengu_js_callback_new_ptr with fn
        if slot <= 0:
            return calling _fail_callback
        var h as i32 is calling pengu_js_make_callback with slot
        if h < 0:
            calling pengu_js_callback_free with slot
            return calling _fail_callback
        return calling ok_of with (with _value is (h to JsValue), _slot is (slot to int))

    ## Releases a callback and its JavaScript handle. Idempotent.
    weave free_callback with cb as JsCallback into void:
        if cb._slot > 0:
            calling pengu_js_callback_free with (cb._slot to i32)
        if cb._value != 0:
            calling release with cb._value

    ## Reads the callback's JavaScript handle without transferring ownership.
    weave callback_value with cb as JsCallback into JsValue:
        return cb._value

    ## Invokes a callback from PenguScript with an explicit `this` and args.
    weave call_callback with cb as JsCallback, this_v as JsValue, args as vector of JsValue into result of JsValue to JsError:
        return calling call with cb._value, this_v, args

    ## Registers a callback that receives an owned copy of a JavaScript string.
    weave make_string_callback with fn as weave with text as string into void into result of int to JsError:
        var slot as i32 is calling pengu_js_callback_string_new_ptr with fn
        if slot <= 0:
            return calling _fail_int
        return calling ok_of with (slot to int)

    ## Releases a string callback slot. Idempotent on the C side.
    weave free_string_callback with slot as int into void:
        calling pengu_js_callback_string_free with (slot to i32)

    ## Attaches callbacks to a promise. Both callbacks are one-shot; the bridge
    ## releases their handles and slots after the promise settles.
    weave promise_then with p as JsValue, on_ok as weave with v as JsValue into void, on_err as weave with e as JsValue into void into result of bool to JsError:
        var okr as result of JsCallback to JsError is calling make_callback with on_ok
        if not okr.is_ok:
            return calling err_of with (calling _error)
        var errr as result of JsCallback to JsError is calling make_callback with on_err
        if not errr.is_ok:
            calling free_callback with okr.value
            return calling err_of with (calling _error)
        var rc as i32 is calling pengu_js_promise_then with p, (okr.value._slot to i32), (errr.value._slot to i32), (okr.value._value to i32), (errr.value._value to i32)
        if rc < 0:
            calling free_callback with okr.value
            calling free_callback with errr.value
            return calling _fail_bool
        return calling ok_of with true

    ## Dynamic `import(url)`; returns the JavaScript promise.
    weave import_module with url as string into result of JsValue to JsError:
        var h as i32 is calling pengu_js_import_module with (calling _cstr with url)
        if h < 0:
            return calling _fail
        return calling ok_of with h

    ## Performs an HTTP request with `fetch` and returns a handle that can be
    ## aborted with `abort_request`. `headers` is a JavaScript object of string
    ## values (`0` for none) and `body` is a JavaScript string (`1` for no
    ## body). Both are borrowed and may be released after the call.
    ## `timeout_ms > 0` aborts the request after that many milliseconds and
    ## reports a `TimeoutError`; `0` disables the timeout.
    weave fetch_request with method as string, url as string, headers as JsValue, body as JsValue, on_ok as weave with res as JsValue into void, on_err as weave with e as JsValue into void, timeout_ms as int is 0 into result of FetchHandle to JsError:
        var okr as result of JsCallback to JsError is calling make_callback with on_ok
        if not okr.is_ok:
            return calling err_of with (calling _error)
        var errr as result of JsCallback to JsError is calling make_callback with on_err
        if not errr.is_ok:
            calling free_callback with okr.value
            return calling err_of with (calling _error)
        var rc as i32 is calling pengu_js_fetch with (calling _cstr with method), (calling _cstr with url), (headers to i32), (body to i32), (okr.value._slot to i32), (errr.value._slot to i32), (okr.value._value to i32), (errr.value._value to i32), (timeout_ms to i32)
        if rc < 0:
            calling free_callback with okr.value
            calling free_callback with errr.value
            return calling err_of with (calling _error)
        return calling ok_of with (with id is rc)

    ## Performs an HTTP request with `fetch`. Compatibility wrapper around
    ## `fetch_request`: the handle is discarded, so the request cannot be
    ## aborted explicitly (only its timeout can).
    weave fetch with method as string, url as string, headers as JsValue, body as JsValue, on_ok as weave with res as JsValue into void, on_err as weave with e as JsValue into void, timeout_ms as int is 0 into result of bool to JsError:
        var r as result of FetchHandle to JsError is calling fetch_request with method, url, headers, body, on_ok, on_err, timeout_ms
        if not r.is_ok:
            return calling err_of with r.error
        return calling ok_of with true

    ## Aborta una petición todavía viva. Devuelve `false` si ya terminó.
    weave abort_request with h as FetchHandle into result of bool to JsError:
        var rc as i32 is calling pengu_js_abort with (h.id to i32)
        if rc < 0:
            return calling _fail_bool
        return calling ok_of with rc != 0

    ## SHA-256 of `text`, delivered as lowercase hex. One-shot.
    weave sha256_hex with text as string, on_ok as weave with value as JsValue into void, on_err as weave with value as JsValue into void into result of bool to JsError:
        var okr as result of JsCallback to JsError is calling make_callback with on_ok
        if not okr.is_ok:
            return calling err_of with (calling _error)
        var errr as result of JsCallback to JsError is calling make_callback with on_err
        if not errr.is_ok:
            calling free_callback with okr.value
            return calling err_of with (calling _error)
        var rc as i32 is calling pengu_js_sha256 with (calling _cstr with text), (okr.value._slot to i32), (errr.value._slot to i32), (okr.value._value to i32), (errr.value._value to i32)
        if rc < 0:
            calling free_callback with okr.value
            calling free_callback with errr.value
            return calling _fail_bool
        return calling ok_of with true

    ## HMAC-SHA-256 of `text` with `key`, delivered as lowercase hex. One-shot.
    weave hmac_sha256_hex with text as string, key as string, on_ok as weave with value as JsValue into void, on_err as weave with value as JsValue into void into result of bool to JsError:
        var okr as result of JsCallback to JsError is calling make_callback with on_ok
        if not okr.is_ok:
            return calling err_of with (calling _error)
        var errr as result of JsCallback to JsError is calling make_callback with on_err
        if not errr.is_ok:
            calling free_callback with okr.value
            return calling err_of with (calling _error)
        var rc as i32 is calling pengu_js_hmac_sha256 with (calling _cstr with text), (calling _cstr with key), (okr.value._slot to i32), (errr.value._slot to i32), (okr.value._value to i32), (errr.value._value to i32)
        if rc < 0:
            calling free_callback with okr.value
            calling free_callback with errr.value
            return calling _fail_bool
        return calling ok_of with true

    ## Opens a file picker and reads the selected file as text. One-shot.
    weave file_pick_text with accept as string, on_ok as weave with value as JsValue into void, on_err as weave with value as JsValue into void into result of bool to JsError:
        var okr as result of JsCallback to JsError is calling make_callback with on_ok
        if not okr.is_ok:
            return calling err_of with (calling _error)
        var errr as result of JsCallback to JsError is calling make_callback with on_err
        if not errr.is_ok:
            calling free_callback with okr.value
            return calling err_of with (calling _error)
        var rc as i32 is calling pengu_js_file_pick with (calling _cstr with accept), (okr.value._slot to i32), (errr.value._slot to i32), (okr.value._value to i32), (errr.value._value to i32)
        if rc < 0:
            calling free_callback with okr.value
            calling free_callback with errr.value
            return calling _fail_bool
        return calling ok_of with true

    ## Reads a File handle as text. One-shot.
    weave file_read_text with file as JsValue, on_ok as weave with value as JsValue into void, on_err as weave with value as JsValue into void into result of bool to JsError:
        var okr as result of JsCallback to JsError is calling make_callback with on_ok
        if not okr.is_ok:
            return calling err_of with (calling _error)
        var errr as result of JsCallback to JsError is calling make_callback with on_err
        if not errr.is_ok:
            calling free_callback with okr.value
            return calling err_of with (calling _error)
        var rc as i32 is calling pengu_js_file_read_text with (file to i32), (okr.value._slot to i32), (errr.value._slot to i32), (okr.value._value to i32), (errr.value._value to i32)
        if rc < 0:
            calling free_callback with okr.value
            calling free_callback with errr.value
            return calling _fail_bool
        return calling ok_of with true

    ## Reads a File handle as a data URL. One-shot.
    weave file_read_data_url with file as JsValue, on_ok as weave with value as JsValue into void, on_err as weave with value as JsValue into void into result of bool to JsError:
        var okr as result of JsCallback to JsError is calling make_callback with on_ok
        if not okr.is_ok:
            return calling err_of with (calling _error)
        var errr as result of JsCallback to JsError is calling make_callback with on_err
        if not errr.is_ok:
