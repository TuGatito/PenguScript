    ## `element.isConnected`.
    weave is_connected with e as Element into bool:
        var v as result of js.JsValue to js.JsError is calling js.get with e._v, "isConnected"
        if not v.is_ok:
            return false
        defer calling js.release with v.value
        return calling js.is_truthy with v.value

    ## `element.tagName`.
    weave tag_name with e as Element into result of string to js.JsError:
        return calling _text_prop with e, "tagName"

    ## Borrowed JS handle for integrations such as `std.web.canvas`.
    ## Do not release it; it dies with the element.
    weave raw with e as Element into js.JsValue:
        return e._v

    ## Wraps a handle without retaining it; used only for freshly created values.
    weave _from with v as js.JsValue into Element:
        return with _v is v

    ## Reads a property as text.
    weave _text_prop with e as Element, name as string into result of string to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with e._v, name
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        return calling js.to_string with v.value

    ## Reads a property as text, or `none` when null/undefined.
    weave _text_prop_opt with e as Element, name as string into result of maybe string to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with e._v, name
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        if calling js.is_null with v.value or calling js.is_undefined with v.value:
            return calling ok_of with (maybe none)
        var s as result of string to js.JsError is calling js.from_string with v.value
        if not s.is_ok:
            return calling err_of with s.error
        return calling ok_of with (some s.value)

    ## Reads a property as an integer.
    weave _int_prop with e as Element, name as string into result of int to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with e._v, name
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        var n as result of f64 to js.JsError is calling js.to_f64 with v.value
        if not n.is_ok:
            return calling err_of with n.error
        return calling ok_of with (n.value to int)

    ## Reads a property as a float.
    weave _f64_prop with e as js.JsValue, name as string into result of f64 to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with e, name
        if not v.is_ok:
            return calling err_of with v.error
        defer calling js.release with v.value
        return calling js.to_f64 with v.value

    ## Calls a method with no arguments and discards its result.
    weave _call_void with e as Element, method as string into result of bool to js.JsError:
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var r as result of js.JsValue to js.JsError is calling js.call_method with e._v, method, args
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Calls a method with one string argument and discards its result.
    weave _call_text_void with e as Element, method as string, text as string into result of bool to js.JsError:
        var s as result of js.JsValue to js.JsError is calling js.string with text
        if not s.is_ok:
            return calling err_of with s.error
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        calling args.push with s.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with e._v, method, args
        calling js.release with s.value
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Calls a method with one string argument and reads its boolean result.
    weave _call_text_bool with e as Element, method as string, text as string into result of bool to js.JsError:
        var s as result of js.JsValue to js.JsError is calling js.string with text
        if not s.is_ok:
            return calling err_of with s.error
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        calling args.push with s.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with e._v, method, args
        calling js.release with s.value
        if not r.is_ok:
            return calling err_of with r.error
        var value as bool is calling js.is_truthy with r.value
        calling js.release with r.value
        return calling ok_of with value

    ## Calls a method on a handle with one string argument and reads its boolean result.
    weave _call_text_bool_on with target as js.JsValue, method as string, text as string into result of bool to js.JsError:
        var s as result of js.JsValue to js.JsError is calling js.string with text
        if not s.is_ok:
            return calling err_of with s.error
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        calling args.push with s.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with target, method, args
        calling js.release with s.value
        if not r.is_ok:
            return calling err_of with r.error
        var value as bool is calling js.is_truthy with r.value
        calling js.release with r.value
        return calling ok_of with value

    ## Calls a method on a handle with one string argument.
    weave _call_text_on with target as js.JsValue, method as string, text as string into result of bool to js.JsError:
        var s as result of js.JsValue to js.JsError is calling js.string with text
        if not s.is_ok:
            return calling err_of with s.error
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        calling args.push with s.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with target, method, args
        calling js.release with s.value
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Reads a child property as an element.
    weave _get_element with e as Element, name as string into result of Element to js.JsError:
        var v as result of js.JsValue to js.JsError is calling js.get with e._v, name
        if not v.is_ok:
            return calling err_of with v.error
        if calling js.is_null with v.value or calling js.is_undefined with v.value:
            return calling err_of with (calling _missing with name)
        return calling ok_of with (calling _from with v.value)

    ## `element.classList`.
    weave _class_list with e as Element into result of js.JsValue to js.JsError:
        return calling js.get with e._v, "classList"

    ## `element.style`.
    weave _style_object with e as Element into result of js.JsValue to js.JsError:
        return calling js.get with e._v, "style"

    ## Registers a listener, optionally one-shot.
    weave _on_internal with e as Element, event_name as string, cb as weave with ev as EventArg into void, once_only as bool into result of Listener to js.JsError:
        var cbv as result of js.JsCallback to js.JsError is calling js.make_callback with cb
        if not cbv.is_ok:
            return calling err_of with cbv.error
        var kept as result of js.JsValue to js.JsError is calling js.retain with e._v
        if not kept.is_ok:
            calling js.free_callback with cbv.value
            return calling err_of with kept.error
        var ev as result of js.JsValue to js.JsError is calling js.string with event_name
        if not ev.is_ok:
            calling js.free_callback with cbv.value
            calling js.release with kept.value
            return calling err_of with ev.error
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        calling args.push with ev.value
        calling args.push with cbv.value._value
        var opts as js.JsValue is (js.UNDEFINED)
        if once_only:
            var o as result of js.JsValue to js.JsError is calling js.object
            if not o.is_ok:
                calling js.release with ev.value
                calling js.release with kept.value
                calling js.free_callback with cbv.value
                return calling err_of with o.error
            var t as result of js.JsValue to js.JsError is calling js.from_int with 1
            if not t.is_ok:
                calling js.release with o.value
                calling js.release with ev.value
                calling js.release with kept.value
                calling js.free_callback with cbv.value
                return calling err_of with t.error
            var set as result of bool to js.JsError is calling js.set with o.value, "once", t.value
            calling js.release with t.value
            if not set.is_ok:
                calling js.release with o.value
                calling js.release with ev.value
                calling js.release with kept.value
                calling js.free_callback with cbv.value
                return calling err_of with set.error
            set opts is o.value
            calling args.push with opts
        var r as result of js.JsValue to js.JsError is calling js.call_method with e._v, "addEventListener", args
        calling js.release with ev.value
        if opts != 0:
            calling js.release with opts
        if not r.is_ok:
            calling js.release with kept.value
            calling js.free_callback with cbv.value
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with (with _element is kept.value, _event is "{event_name}", _callback is cbv.value)

    ## Frees every element in a list (the list buffer is freed by the caller).
    weave _free_elements with items as list of Element into void:
        var i as int is 0
        while i < items.len:
            var e as Element is items at i
            calling free with (sigil of e)
            set i is i + 1

    ## Builds a missing-node error.
    weave _missing with what as string into js.JsError:
        return with name is "NotFoundError", message is "{what} is not available", stack is ""

    ## Builds a security-policy error.
    weave _security_error with message as string into js.JsError:
        return with name is "SecurityError", message is message, stack is ""

    ## Attributes whose value is a URL and therefore needs the policy check.
    ## HTML attribute names are case-insensitive, so `HREF` must be checked too.
    weave _is_url_attr with name as string into bool:
        return (calling _attr_is with name, "href") or (calling _attr_is with name, "src") or (calling _attr_is with name, "action") or (calling _attr_is with name, "formaction") or (calling _attr_is with name, "poster") or (calling _attr_is with name, "cite")

    ## True when `name` equals `expected`, ignoring ASCII case.
    weave _attr_is with name as string, expected as string into bool:
        if name.len != expected.len:
            return false
        return calling security.starts_with_ignore_case with name, expected

