    ## Registers `cb` for `event_name` and returns its listener.
    weave on with e as Element, event_name as string, cb as weave with ev as EventArg into void into result of Listener to js.JsError:
        return calling _on_internal with e, event_name, cb, false

    ## Registers a one-shot listener.
    weave once with e as Element, event_name as string, cb as weave with ev as EventArg into void into result of Listener to js.JsError:
        return calling _on_internal with e, event_name, cb, true

    ## Removes the listener and releases it.
    weave off with l as ref to Listener into result of bool to js.JsError:
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var ev as result of js.JsValue to js.JsError is calling js.string with l->_event
        if not ev.is_ok:
            return calling err_of with ev.error
        calling args.push with ev.value
        calling args.push with l->_callback._value
        var r as result of js.JsValue to js.JsError is calling js.call_method with l->_element, "removeEventListener", args
        calling js.release with ev.value
        var ok as bool is r.is_ok
        if r.is_ok:
            calling js.release with r.value
        calling free_listener with l
        if not ok:
            return calling err_of with r.error
        return calling ok_of with true

    ## Releases the listener without touching the DOM.
    weave free_listener with l as ref to Listener into void:
        calling js.free_callback with l->_callback
        if l->_element != 0:
            calling js.release with l->_element
            set l->_element is (js.UNDEFINED)
        banish l->_event

    ## `input.value`.
    weave value with e as Element into result of maybe string to js.JsError:
        return calling _text_prop_opt with e, "value"

    ## Sets `input.value`.
    weave set_value with e as Element, value as string into result of bool to js.JsError:
        var s as result of js.JsValue to js.JsError is calling js.string with value
        if not s.is_ok:
            return calling err_of with s.error
        defer calling js.release with s.value
        return calling js.set with e._v, "value", s.value

    ## `input.checked`.
    weave checked with e as Element into bool:
        var v as result of js.JsValue to js.JsError is calling js.get with e._v, "checked"
        if not v.is_ok:
            return false
        defer calling js.release with v.value
        return calling js.is_truthy with v.value

