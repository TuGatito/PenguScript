        if not c.is_ok:
            return calling err_of with c.error
        defer calling js.release with c.value
        return calling _call_text_bool_on with c.value, "contains", name

    ## Reads one inline style property.
    weave style with e as Element, name as string into result of maybe string to js.JsError:
        var s as result of js.JsValue to js.JsError is calling _style_object with e
        if not s.is_ok:
            return calling err_of with s.error
        defer calling js.release with s.value
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var n as result of js.JsValue to js.JsError is calling js.string with name
        if not n.is_ok:
            return calling err_of with n.error
        calling args.push with n.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with s.value, "getPropertyValue", args
        calling js.release with n.value
        if not r.is_ok:
            return calling err_of with r.error
        defer calling js.release with r.value
        var text as result of string to js.JsError is calling js.from_string with r.value
        if not text.is_ok:
            return calling err_of with text.error
        if text.value.len == 0:
            return calling ok_of with (maybe none)
        return calling ok_of with (some text.value)

    ## Sets one inline style property.
    weave set_style with e as Element, name as string, value as string into result of bool to js.JsError:
        var s as result of js.JsValue to js.JsError is calling _style_object with e
        if not s.is_ok:
            return calling err_of with s.error
        defer calling js.release with s.value
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var n as result of js.JsValue to js.JsError is calling js.string with name
        var v as result of js.JsValue to js.JsError is calling js.string with value
        if not n.is_ok:
            if v.is_ok:
                calling js.release with v.value
            return calling err_of with n.error
        if not v.is_ok:
            calling js.release with n.value
            return calling err_of with v.error
        calling args.push with n.value
        calling args.push with v.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with s.value, "setProperty", args
