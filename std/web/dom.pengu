## std.web.dom — DOM access for WebAssembly applications.
##
## `Element` owns one JavaScript handle. Release it with `free` when the element
## is no longer needed; `query` and `create` return owned elements. A
## `Listener` owns the element reference and the callback, so `off` (or
## `free_listener`) releases both.
##
## `query` returns `maybe Element`: a missing selector is absence, not an error.
## That distinction is what makes routing and form handling predictable.
##
## `set_attr` applies `std.web.security.is_safe_url` to `href`, `src`, `action`,
## `formaction`, `poster`, and `cite`. Use `set_attr_unsafe` only for values you
## built yourself from a trusted allowlist.

import std.web.js as js
import std.web.event
import std.web.security

const DOM_VERSION as string is "1.0.0"

alias EventArg as event.Event

## An element handle. Private field: use the module functions.
rune Element:
    _v as js.JsValue

## A registered event listener. `off` frees it.
rune Listener:
    _element as js.JsValue
    _event as string
    _callback as js.JsCallback

## A layout rectangle in CSS pixels.
rune Rect:
    x as f64
    y as f64
    width as f64
    height as f64

when wasm:

    ## Wraps a borrowed handle, retaining it. The caller owns the result.
    weave wrap with v as js.JsValue into result of Element to js.JsError:
        var r as result of js.JsValue to js.JsError is calling js.retain with v
        if not r.is_ok:
            return calling err_of with r.error
        return calling ok_of with (calling _from with r.value)

    ## `document`.
    weave document into result of Element to js.JsError:
        var g as js.JsValue is calling js.global
        defer calling js.release with g
        var d as result of js.JsValue to js.JsError is calling js.get with g, "document"
        if not d.is_ok:
            return calling err_of with d.error
        if calling js.is_null with d.value or calling js.is_undefined with d.value:
            return calling err_of with (calling _missing with "document")
        return calling ok_of with (calling _from with d.value)

    ## `document.body`.
    weave body into result of Element to js.JsError:
        var d as result of Element to js.JsError is calling document
        if not d.is_ok:
            return calling err_of with d.error
        defer calling free with (sigil of d.value)
        return calling _get_element with d.value, "body"

    ## `document.head`.
    weave head into result of Element to js.JsError:
        var d as result of Element to js.JsError is calling document
        if not d.is_ok:
            return calling err_of with d.error
        defer calling free with (sigil of d.value)
        return calling _get_element with d.value, "head"

    ## `document.querySelector(selector)`, or `none` when nothing matches.
    weave query with selector as string into result of maybe Element to js.JsError:
        var d as result of Element to js.JsError is calling document
        if not d.is_ok:
            return calling err_of with d.error
        defer calling free with (sigil of d.value)
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var s as result of js.JsValue to js.JsError is calling js.string with selector
        if not s.is_ok:
            return calling err_of with s.error
        calling args.push with s.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with d.value._v, "querySelector", args
        calling js.release with s.value
        if not r.is_ok:
            return calling err_of with r.error
        if calling js.is_null with r.value or calling js.is_undefined with r.value:
            calling js.release with r.value
            return calling ok_of with (maybe none)
        return calling ok_of with (some (calling _from with r.value))

    ## `document.querySelector(selector)`; a missing element is an error.
    ## Use this when absence is exceptional (canvas, required mounts).
    weave query_required with selector as string into result of Element to js.JsError:
        var d as result of Element to js.JsError is calling document
        if not d.is_ok:
            return calling err_of with d.error
        defer calling free with (sigil of d.value)
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var s as result of js.JsValue to js.JsError is calling js.string with selector
        if not s.is_ok:
            return calling err_of with s.error
        calling args.push with s.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with d.value._v, "querySelector", args
        calling js.release with s.value
        if not r.is_ok:
            return calling err_of with r.error
        if calling js.is_null with r.value or calling js.is_undefined with r.value:
            calling js.release with r.value
            return calling err_of with (calling _missing with "element not found: {selector}")
        return calling ok_of with (calling _from with r.value)

    ## `document.querySelectorAll(selector)`. The list and every element are
    ## owned; free each element and `banish` the list.
    weave query_all with selector as string into result of list of Element to js.JsError:
        var d as result of Element to js.JsError is calling document
        if not d.is_ok:
            return calling err_of with d.error
        defer calling free with (sigil of d.value)
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var s as result of js.JsValue to js.JsError is calling js.string with selector
        if not s.is_ok:
            return calling err_of with s.error
        calling args.push with s.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with d.value._v, "querySelectorAll", args
        calling js.release with s.value
        if not r.is_ok:
            return calling err_of with r.error
        defer calling js.release with r.value
        var total as result of int to js.JsError is calling js.length with r.value
        if not total.is_ok:
            return calling err_of with total.error
        var out as list of Element is list of Element
        var i as int is 0
        while i < total.value:
            var item as result of js.JsValue to js.JsError is calling js.get_index with r.value, i
            if not item.is_ok:
                calling _free_elements with out
                banish out
                return calling err_of with item.error
            calling out.push with (calling _from with item.value)
            set i is i + 1
        return calling ok_of with out

    ## `document.createElement(tag)`.
    weave create with tag as string into result of Element to js.JsError:
        var d as result of Element to js.JsError is calling document
        if not d.is_ok:
            return calling err_of with d.error
        defer calling free with (sigil of d.value)
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var s as result of js.JsValue to js.JsError is calling js.string with tag
        if not s.is_ok:
            return calling err_of with s.error
        calling args.push with s.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with d.value._v, "createElement", args
        calling js.release with s.value
        if not r.is_ok:
            return calling err_of with r.error
        return calling ok_of with (calling _from with r.value)

    ## `document.createTextNode(text)`.
    weave create_text with text as string into result of Element to js.JsError:
        var d as result of Element to js.JsError is calling document
        if not d.is_ok:
            return calling err_of with d.error
        defer calling free with (sigil of d.value)
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var s as result of js.JsValue to js.JsError is calling js.string with text
        if not s.is_ok:
            return calling err_of with s.error
        calling args.push with s.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with d.value._v, "createTextNode", args
        calling js.release with s.value
        if not r.is_ok:
            return calling err_of with r.error
        return calling ok_of with (calling _from with r.value)

    ## Releases the element handle. Idempotent.
    weave free with e as ref to Element into void:
        if e->_v != 0:
            calling js.release with e->_v
            set e->_v is (js.UNDEFINED)

    ## `element.cloneNode(true)`.
    weave clone with e as Element into result of Element to js.JsError:
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var t as result of js.JsValue to js.JsError is calling js.from_int with 1
        if not t.is_ok:
            return calling err_of with t.error
        calling args.push with t.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with e._v, "cloneNode", args
        calling js.release with t.value
        if not r.is_ok:
            return calling err_of with r.error
        return calling ok_of with (calling _from with r.value)

    ## `element.textContent`.
    weave text with e as Element into result of string to js.JsError:
        return calling _text_prop with e, "textContent"

    ## Sets `textContent`; markup is never parsed.
    weave set_text with e as Element, text as string into result of bool to js.JsError:
        var s as result of js.JsValue to js.JsError is calling js.string with text
        if not s.is_ok:
            return calling err_of with s.error
        defer calling js.release with s.value
        return calling js.set with e._v, "textContent", s.value

    ## `element.innerHTML`. Parsed as markup: use only with trusted input.
    weave html with e as Element into result of string to js.JsError:
        return calling _text_prop with e, "innerHTML"

    ## Sets `innerHTML`. This is the unsafe escape hatch; prefer `set_text`.
    weave set_html_unsafe with e as Element, text as string into result of bool to js.JsError:
        var s as result of js.JsValue to js.JsError is calling js.string with text
        if not s.is_ok:
            return calling err_of with s.error
        defer calling js.release with s.value
        return calling js.set with e._v, "innerHTML", s.value

    ## `element.getAttribute(name)`, or `none` when absent.
    weave get_attr with e as Element, name as string into result of maybe string to js.JsError:
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var n as result of js.JsValue to js.JsError is calling js.string with name
        if not n.is_ok:
            return calling err_of with n.error
        calling args.push with n.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with e._v, "getAttribute", args
        calling js.release with n.value
        if not r.is_ok:
            return calling err_of with r.error
        defer calling js.release with r.value
        if calling js.is_null with r.value or calling js.is_undefined with r.value:
            return calling ok_of with (maybe none)
        var s as result of string to js.JsError is calling js.from_string with r.value
        if not s.is_ok:
            return calling err_of with s.error
        return calling ok_of with (some s.value)

    ## `element.setAttribute(name, value)`. URL attributes are validated.
    weave set_attr with e as Element, name as string, value as string into result of bool to js.JsError:
        if calling _is_url_attr with name:
            if not (calling security.is_safe_url with value):
                return calling err_of with (calling _security_error with "unsafe URL in attribute '{name}'")
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var n as result of js.JsValue to js.JsError is calling js.string with name
        var v as result of js.JsValue to js.JsError is calling js.string with value
        if not n.is_ok:
            if v.is_ok:
                calling js.release with v.value
            return calling err_of with n.error
        if not v.is_ok:
            calling js.release with n.value
            return calling err_of with v.error
        calling args.push with n.value
        calling args.push with v.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with e._v, "setAttribute", args
        calling js.release with n.value
        calling js.release with v.value
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## Sets an attribute without the URL policy. Trusted data only.
    weave set_attr_unsafe with e as Element, name as string, value as string into result of bool to js.JsError:
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var n as result of js.JsValue to js.JsError is calling js.string with name
        var v as result of js.JsValue to js.JsError is calling js.string with value
        if not n.is_ok:
            if v.is_ok:
                calling js.release with v.value
            return calling err_of with n.error
        if not v.is_ok:
            calling js.release with n.value
            return calling err_of with v.error
        calling args.push with n.value
        calling args.push with v.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with e._v, "setAttribute", args
        calling js.release with n.value
        calling js.release with v.value
        if not r.is_ok:
            return calling err_of with r.error
        calling js.release with r.value
        return calling ok_of with true

    ## `element.removeAttribute(name)`.
    weave remove_attr with e as Element, name as string into result of bool to js.JsError:
        return calling _call_text_void with e, "removeAttribute", name

    ## `element.hasAttribute(name)`.
    weave has_attr with e as Element, name as string into result of bool to js.JsError:
        return calling _call_text_bool with e, "hasAttribute", name

    ## `element.classList.add(name)`.
    weave add_class with e as Element, name as string into result of bool to js.JsError:
        var c as result of js.JsValue to js.JsError is calling _class_list with e
        if not c.is_ok:
            return calling err_of with c.error
        defer calling js.release with c.value
        return calling _call_text_on with c.value, "add", name

    ## `element.classList.remove(name)`.
    weave remove_class with e as Element, name as string into result of bool to js.JsError:
        var c as result of js.JsValue to js.JsError is calling _class_list with e
        if not c.is_ok:
            return calling err_of with c.error
        defer calling js.release with c.value
        return calling _call_text_on with c.value, "remove", name

    ## `element.classList.toggle(name)`.
    weave toggle_class with e as Element, name as string into result of bool to js.JsError:
        var c as result of js.JsValue to js.JsError is calling _class_list with e
        if not c.is_ok:
            return calling err_of with c.error
        defer calling js.release with c.value
        var args as list of js.JsValue is list of js.JsValue
        defer banish args
        var n as result of js.JsValue to js.JsError is calling js.string with name
        if not n.is_ok:
            return calling err_of with n.error
        calling args.push with n.value
        var r as result of js.JsValue to js.JsError is calling js.call_method with c.value, "toggle", args
