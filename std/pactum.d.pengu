# std/pactum.d.pengu - The Pactum (2D rectangle packing into a single container rectangle)
# Pure C-binding declaration file: every declaration maps 1:1 to the native
# stb_rect_pack C API. This file cannot contain implementation bodies (.d.pengu rule).
# Memory ownership follows the native library contract: read the upstream docs
# next to each declaration; release any returned handle with the library's own
# cleanup routine before dropping the last reference.

## PenguScript declaration binding generated by 'pengu bind'.
## Source header: pactum.h
include "pactum.h"

# -- Constants (#define) ------------------------------

const STBRP__MAXVAL as i64 is 0x7fffffff

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

alias stbrp_context as opaque

alias stbrp_node as opaque

alias stbrp_rect as opaque

alias stbrp_coord as int

# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia stbrp_

# Mostly for internal use, but this is the maximum supported coordinate value.
declare pack_rects with context as ref to stbrp_context, rects as ref to stbrp_rect, num_rects as int into int

declare init_target with context as ref to stbrp_context, width as int, height as int, nodes as ref to stbrp_node, num_nodes as int into void

# Initialize a rectangle packer to:
# pack a rectangle that is 'width' by 'height' in dimensions
# using temporary storage provided by the array 'nodes', which is 'num_nodes' long
#
# You must call this function every time you start packing into a new target.
#
# There is no "shutdown" function. The 'nodes' memory must stay valid for
# the following stbrp_pack_rects() call (or calls), but can be freed after
# the call (or calls) finish.
#
# Note: to guarantee best results, either:
# 1. make sure 'num_nodes' >= 'width'
# or  2. call stbrp_allow_out_of_mem() defined below with 'allow_out_of_mem = 1'
#
# If you don't do either of the above things, widths will be quantized to multiples
# of small integers to guarantee the algorithm doesn't run out of temporary storage.
#
# If you do #2, then the non-quantized algorithm will be used, but the algorithm
# may run out of temporary storage and be unable to pack some rectangles.
declare setup_allow_out_of_mem with context as ref to stbrp_context, allow_out_of_mem as int into void

# Optionally call this function after init but before doing any packing to
# change the handling of the out-of-temp-memory scenario, described above.
# If you call init again, this will be reset to the default (false).
declare setup_heuristic with context as ref to stbrp_context, heuristic as int into void
