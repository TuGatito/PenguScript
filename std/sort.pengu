realm sort

-- Ordenación y búsqueda genéricas.
--
-- Cualquier tipo con `operator <` sirve, incluidas las runes que declaran
-- `operator <=>` (el compilador deriva `<`, `>` y `>=`).

invoke "std/vector"

-- Ordena en el sitio con inserción: estable y suficiente para los
-- tamaños habituales de un juego o de una herramienta de consola.
insertion_sort = <T>( mut items: ref<vector<T>>) -> void
  mut actual = size_t::from(1)
  while actual < #items
    mut posicion = actual
    while posicion > size_t::from(0) and items[posicion] < items[posicion - size_t::from(1)]
      mut temporal: T = items[posicion]
      items[posicion] = items[posicion - size_t::from(1)]
      items[posicion - size_t::from(1)] = temporal
      posicion -= size_t::from(1)
    actual += size_t::from(1)

    -- ¿Está ordenada de menor a mayor?
is_sorted = <T>(items: ref<vector<T>>) -> bool
  mut indice = size_t::from(1)
  while indice < #items
    if items[indice] < items[indice - size_t::from(1)]
      return false
    indice += size_t::from(1)
  true

  -- Búsqueda binaria sobre una secuencia ya ordenada.
binary_search_sorted = <T>(items: ref<vector<T>>, buscado: T) -> size_t?
  mut bajo = size_t::from(0)
  mut alto = #items
  while bajo < alto
    mut medio = (bajo + alto) / size_t::from(2)
    if items[medio] < buscado
      bajo = medio + size_t::from(1)
    else
      if buscado < items[medio]
        alto = medio
      else
        return medio
  none

  -- Copia ordenada: no toca el original.
sorted_copy = <T>(items: ref<vector<T>>) -> vector<T>
  mut copia: vector<T> = []
  for item in items
    copia.push(item)
  insertion_sort<T>( mut ref(copia))
  copia
