# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia nsvg

## Parses SVG file from a file, returns SVG image as paths.
declare ParseFromFile with filename as ref to char, units as ref to char, dpi as f32 into ref to NSVGimage

## Parses SVG file from a null terminated string, returns SVG image as paths.
## Important note: changes the string.
declare Parse with input as ref to char, units as ref to char, dpi as f32 into ref to NSVGimage

## Duplicates a path.
declare DuplicatePath with p as ref to NSVGpath into ref to NSVGpath

## Deletes an image.
declare Delete with image as ref to NSVGimage into void
