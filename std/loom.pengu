# std/loom.pengu - The Loom (Itertools & Collection Utilities)
# Provides algorithms and functional transformations for collections.
#
# Typical usage:
#   import std.loom
#   var nums as list of int is calling loom.range with 1, 6, 1
#   var total as int is calling loom.sum with nums
#   var pairs as list of list of int is calling loom.chunks with nums, 2
#
# Ownership model:
#   * Every function here takes its input lists by value (they are borrowed for
#     the call and never retained) and returns a freshly allocated list owned by
#     the caller: banish the result when done.
#   * None of these functions modify their inputs; returned lists are new
#     containers holding int copies, so callers may keep and reuse the inputs.
#   * All helpers are int-specific (list of int in, int / list of int out).

import std.spark
import std.oracle
import std.tally
import std.atlas
import std.scrolls

# ----------------------------------------------------------------------------
# Sequence generation
# ----------------------------------------------------------------------------
#
# Generators that build a list of int without an input list.
# Builds the integer sequence from `start` (inclusive) up to `end` (exclusive),
# advancing by `step` (default 1). A positive `step` counts up while the value
# is below `end`; a negative `step` counts down while the value is above `end`;
# `step` of 0 (or a sign mismatch with the bounds) yields an empty list. The
# returned list is owned by the caller.
weave range with start as int , end as int , step as int is 1 into list of int:
    var result as list of int is list of int
    var cur as int is start
    if step > 0:
        while cur < end:
            calling result.push with cur
            set cur is cur + step
    else if step < 0:
        while cur > end:
            calling result.push with cur
            set cur is cur + step
    return result

# Builds a list containing `value` repeated `times` times. A `times` of 0 or
# less yields an empty list. The returned list is owned by the caller.
weave repeat with value as int , times as int into list of int:
    var result as list of int is list of int
    var i as int is 0
    while i < times:
        calling result.push with value
        set i is i + 1
    return result

# ----------------------------------------------------------------------------
# Slicing & composition
# ----------------------------------------------------------------------------
#
# Helpers that cut or join whole lists of int.
# Returns a new list holding the first `n` elements of `items` (all of them when
# `items` is shorter). A non-positive `n` yields an empty list. The result is
# owned by the caller; `items` is left untouched.
weave take with items as list of int , n as int into list of int:
    var result as list of int is list of int
    var count as int is n
    if count > items.len:
        set count is items.len
    var i as int is 0
    while i < count:
        var val as int is items at i
        calling result.push with val
        set i is i + 1
    return result

# Returns a new list holding every element of `items` from index `n` onward. A
# negative `n` is treated as 0 and `n` beyond the end yields an empty list. The
# result is owned by the caller; `items` is left untouched.
weave skip with items as list of int , n as int into list of int:
    var result as list of int is list of int
    var start as int is n
    if start < 0:
        set start is 0
    var i as int is start
    while i < items.len:
        var val as int is items at i
        calling result.push with val
        set i is i + 1
    return result

# Returns a new list that concatenates `a` followed by `b` (a deep copy of both;
# neither input is modified). The result is owned by the caller.
weave chain with a as list of int , b as list of int into list of int:
    var result as list of int is list of int
    var i as int is 0
    while i < a.len:
        var val as int is a at i
        calling result.push with val
        set i is i + 1
    var j as int is 0
    while j < b.len:
        var val as int is b at j
        calling result.push with val
        set j is j + 1
    return result

# ----------------------------------------------------------------------------
# Batching: chunks & sliding windows
# ----------------------------------------------------------------------------
#
# Helpers that reorganise a list of int into a list of smaller lists.
# Splits `items` into consecutive non-overlapping chunks of at most `n` elements
# each (the last chunk may be shorter). A non-positive `n` yields an empty list.
# The outer and inner lists are all new and owned by the caller.
weave chunks with items as list of int , n as int into list of list of int:
    var result as list of list of int is list of list of int
    if n <= 0:
        return result
    var i as int is 0
    while i < items.len:
        var chunk as list of int is list of int
        var j as int is 0
        while j < n:
            if i + j >= items.len:
                break
            var val as int is items at (i + j)
            calling chunk.push with val
            set j is j + 1
        calling result.push with chunk
        set i is i + n
    return result

# Returns every contiguous sliding window of exactly `n` consecutive elements of
# `items` (each window is a new list of length `n`; the windows overlap by
# n - 1 elements). Yields an empty list when `n` is non-positive or larger than
# the list. The outer and inner lists are all new and owned by the caller.
weave windows with items as list of int , n as int into list of list of int:
    var result as list of list of int is list of list of int
    if n <= 0:
        return result
    if n > items.len:
        return result
    var i as int is 0
    var limit as int is items.len - n
    while i <= limit:
        var window as list of int is list of int
        var j as int is 0
        while j < n:
            var val as int is items at (i + j)
            calling window.push with val
            set j is j + 1
        calling result.push with window
        set i is i + 1
    return result

# ----------------------------------------------------------------------------
# Reductions & statistics
# ----------------------------------------------------------------------------
#
# Helpers that fold a list of int down to a single int.
# Sums every element of `nums` (0 for an empty list).
weave sum with nums as list of int into int:
    var total as int is 0
    var i as int is 0
    while i < nums.len:
        var n as int is nums at i
        set total is total + n
        set i is i + 1
    return total

# Multiplies every element of `nums` together (1 for an empty list). Watch for
# int overflow on large inputs.
weave product_num with nums as list of int into int:
    var total as int is 1
    var i as int is 0
    while i < nums.len:
        var n as int is nums at i
        set total is total * n
        set i is i + 1
    return total

# Returns the greatest value in `nums` (0 for an empty list). Note that this
# means an empty list is indistinguishable from a list containing only 0/negatives
# when no element exceeds 0.
weave max_int with items as list of int into int:
    if items.len == 0:
        return 0
    var best as int is items at 0
    var i as int is 1
    while i < items.len:
        var cur as int is items at i
        if cur > best:
            set best is cur
        set i is i + 1
    return best

# Returns the smallest value in `items` (0 for an empty list). Note that this
# means an empty list is indistinguishable from a list containing only 0/positives
# when no element is below 0.
weave min_int with items as list of int into int:
    if items.len == 0:
        return 0
    var best as int is items at 0
    var i as int is 1
    while i < items.len:
        var cur as int is items at i
        if cur < best:
            set best is cur
        set i is i + 1
    return best