    var empty as list of list of int is list of list of int
    calling _expect_eq_chunks with (calling pairwise with one), empty, "pairwise corto"
test "pairwise_pairs devuelve Pair adyacentes":
    var xs as list of int is [1, 2, 3]
    var ps as list of Pair of int and int is calling pairwise_pairs with xs
    calling _expect_eq with (calling ps.len), 2, "pairwise_pairs len"
    calling _expect_pair with 1, 2, "pairwise_pairs 0", (ps at 0)
    calling _expect_pair with 2, 3, "pairwise_pairs 1", (ps at 1)
test "pairwise_pairs con un elemento devuelve vacío":
    var one as list of int is [4]
    var ps as list of Pair of int and int is calling pairwise_pairs with one
    calling _expect_eq with (calling ps.len), 0, "pairwise_pairs corto"
test "pairwise_pairs conserva los dos componentes en orden":
    var xs as list of int is [7, 9]
    var ps as list of Pair of int and int is calling pairwise_pairs with xs
    calling _expect_pair with 7, 9, "pairwise_pairs", (ps at 0)

# Plegados
test "sum suma todos los elementos":
    var xs as list of int is [1, 2, 3]
    calling _expect_eq with (calling sum with xs), 6, "sum"
test "sum de la lista vacía es cero":
    var empty as list of int is list of int
    calling _expect_eq with (calling sum with empty), 0, "sum vacía"
test "product_num multiplica todos los elementos":
    var xs as list of int is [2, 3, 4]
    calling _expect_eq with (calling product_num with xs), 24, "product"
test "product_num de la lista vacía es uno":
    var empty as list of int is list of int
    calling _expect_eq with (calling product_num with empty), 1, "product vacía"
test "max_int devuelve el mayor":
    var xs as list of int is [3, 9, 4]
    calling _expect_eq with (calling max_int with xs), 9, "max"
test "min_int devuelve el menor":
    var xs as list of int is [3, 9, 4]
    calling _expect_eq with (calling min_int with xs), 3, "min"
test "max_int y min_int de la lista vacía devuelven cero":
    var empty as list of int is list of int
    calling _expect_eq with (calling max_int with empty), 0, "max vacía"
    calling _expect_eq with (calling min_int with empty), 0, "min vacía"
test "max_int y min_int con negativos":
    var xs as list of int is [-5, -1, -9]
    calling _expect_eq with (calling max_int with xs), -1, "max negativos"
    calling _expect_eq with (calling min_int with xs), -9, "min negativos"
test "min_max devuelve un Pair mínimo máximo":
    var xs as list of int is [3, 9, 4]
    calling _expect_some_pair with 3, 9, "min_max", (calling _min_max_int with xs)
test "min_max de un elemento repite el valor":
    var one as list of int is [7]
    calling _expect_some_pair with 7, 7, "min_max uno", (calling _min_max_int with one)
test "min_max de la lista vacía devuelve none":
    var empty as list of int is list of int
    var bounds as maybe Pair of int and int is calling _min_max_int with empty
    calling _expect_eq with bounds.is_present, false, "min_max vacía"
test "mean calcula la media aritmética":
    var xs as list of int is [1, 2, 3, 4]
    calling _expect_eq with (calling _mean_int with xs), 2.5, "mean"
test "mean de la lista vacía es cero":
    var empty as list of int is list of int
    calling _expect_eq with (calling _mean_int with empty), 0.0, "mean vacía"
test "sum_squares suma los cuadrados":
    var xs as list of int is [1, 2, 3]
    calling _expect_eq with (calling sum_squares with xs), 14, "sum_squares"
test "mean de un solo elemento es ese elemento":
    var one as list of int is [5]
    calling _expect_eq with (calling _mean_int with one), 5.0, "mean uno"
test "running_sum de un elemento es ese elemento":
    var one as list of int is [7]
    calling _expect_eq_ints with (calling _running_sum_int with one), one, "running_sum uno"
test "sum_squares de la lista vacía es cero":
    var empty as list of int is list of int
    calling _expect_eq with (calling sum_squares with empty), 0, "sum_squares vacía"

# Plegados con estado, diferencias y escaneo
test "running_sum acumula las sumas prefijas":
    var xs as list of int is [1, 2, 3]
    var exp as list of int is [1, 3, 6]
    calling _expect_eq_ints with (calling _running_sum_int with xs), exp, "running_sum"
test "running_max y running_min acumulan los extremos":
    var xs as list of int is [3, 1, 4]
    var maxes as list of int is [3, 3, 4]
    var mins as list of int is [3, 1, 1]
    calling _expect_eq_ints with (calling running_max with xs), maxes, "running_max"
    calling _expect_eq_ints with (calling running_min with xs), mins, "running_min"
test "los prefijos de una lista vacía son vacíos":
    var empty as list of int is list of int
    var none as list of int is list of int
    calling _expect_eq_ints with (calling _running_sum_int with empty), none, "running_sum vacía"
    calling _expect_eq_ints with (calling running_max with empty), none, "running_max vacía"
    calling _expect_eq_ints with (calling running_min with empty), none, "running_min vacía"
test "differences calcula las diferencias adyacentes":
    var xs as list of int is [1, 4, 9]
    var exp as list of int is [3, 5]
    calling _expect_eq_ints with (calling differences with xs), exp, "differences"
test "differences de la lista vacía o de un elemento es vacía":
    var empty as list of int is list of int
    var one as list of int is [7]
    var none as list of int is list of int
    calling _expect_eq_ints with (calling differences with empty), none, "differences vacía"
    calling _expect_eq_ints with (calling differences with one), none, "differences uno"

# Predicados
test "any_zero detecta el cero":
    var xs as list of int is [1, 0, 3]
    calling _expect_eq with (calling any_zero with xs), true, "any_zero"
test "any_zero de la lista vacía es false":
    var empty as list of int is list of int
    calling _expect_eq with (calling any_zero with empty), false, "any_zero vacía"
test "all_equal reconoce los elementos repetidos":
    var xs as list of int is [4, 4, 4]
    calling _expect_eq with (calling all_equal with xs), true, "all_equal"
test "all_equal de vacía o de un elemento es true":
    var empty as list of int is list of int
    var one as list of int is [1, 1]
    calling _expect_eq with (calling all_equal with empty), true, "all_equal vacía"
    calling _expect_eq with (calling all_equal with one), true, "all_equal uno"
test "los predicados de orden reconocen secuencias estrictas":
    var asc as list of int is [1, 2, 3]
    var desc as list of int is [3, 2, 1]
    calling _expect_eq with (calling is_strictly_asc with asc), true, "strictly_asc"
    calling _expect_eq with (calling is_strictly_desc with desc), true, "strictly_desc"
test "los predicados de orden aceptan repetidos y listas cortas":
    var ties as list of int is [1, 1, 2]
    var empty as list of int is list of int
    calling _expect_eq with (calling is_sorted_asc with ties), true, "sorted_asc"
    calling _expect_eq with (calling is_strictly_asc with ties), false, "strictly_asc ties"
    calling _expect_eq with (calling is_sorted_desc with empty), true, "sorted_desc vacía"

# Transformaciones y combinaciones
test "zip_with suma por defecto":
    var a as list of int is [1, 2, 3]
    var b as list of int is [10, 20, 30]
    var exp as list of int is [11, 22, 33]
    calling _expect_eq_ints with (calling _zip_with_int with a, b, 0), exp, "zip_with suma"
test "zip_with aplica resta, producto, mínimo y máximo":
    var a as list of int is [10, 20]
    var b as list of int is [3, 5]
    calling _expect_eq_ints with (calling _zip_with_int with a, b, 1), (calling unfold_range with 7, 2, 8), "zip_with resta"
    calling _expect_eq_ints with (calling _zip_with_int with a, b, 2), (calling unfold_range with 30, 2, 70), "zip_with producto"
    calling _expect_eq_ints with (calling _zip_with_int with a, b, 3), (calling unfold_range with 3, 2, 2), "zip_with mínimo"
    calling _expect_eq_ints with (calling _zip_with_int with a, b, 4), (calling unfold_range with 10, 2, 10), "zip_with máximo"
test "zip_with se detiene en la lista más corta":
    var a as list of int is [1, 2, 3]
    var b as list of int is [10]
    var exp as list of int is [11]
    calling _expect_eq_ints with (calling _zip_with_int with a, b, 0), exp, "zip_with corta"
test "zip_with con operador desconocido suma":
    var a as list of int is [1]
    var b as list of int is [2]
    var exp as list of int is [3]
    calling _expect_eq_ints with (calling _zip_with_int with a, b, 9), exp, "zip_with op 9"
test "zip_longest rellena con fill hasta la lista más larga":
    var a as list of int is [1, 2, 3]
    var b as list of int is [9]
    var pairs as list of list of int is calling zip_longest with a, b, 7
    var last as list of int is pairs at 2
    calling _expect_eq_ints with last, (calling unfold_range with 3, 2, 4), "zip_longest relleno"
test "zip_longest con listas de igual longitud no rellena":
    var a as list of int is [1]
    var b as list of int is [2]
    var pairs as list of list of int is calling zip_longest with a, b
    var only as list of int is pairs at 0
    calling _expect_eq_ints with only, (calling unfold_range with 1, 2, 1), "zip_longest iguales"
test "enumerate devuelve pares índice valor":
    var xs as list of int is [10, 20]
    var pairs as list of list of int is calling enumerate with xs
    var second as list of int is pairs at 1
    var exp as list of int is [1, 20]
    calling _expect_eq_ints with second, exp, "enumerate par"
test "enumerate_pairs devuelve Pair en orden":
    var xs as list of int is [10, 20]
    var pairs as list of Pair of int and int is calling _enumerate_pairs_int with xs
    calling _expect_eq with (calling pairs.len), 2, "enumerate_pairs len"
    calling _expect_pair with 1, 20, "enumerate_pairs par", (pairs at 1)
test "enumerate y enumerate_pairs de vacía son vacíos":
    var empty as list of int is list of int
    var none as list of list of int is list of list of int
    calling _expect_eq_chunks with (calling enumerate with empty), none, "enumerate vacía"
test "interleave alterna hasta la lista más corta":
    var a as list of int is [1, 2]
    var b as list of int is [10]
    var out as list of int is calling interleave with a, b
    var exp as list of int is [1, 10]
    calling _expect_eq_ints with out, exp, "interleave"
test "round_robin reparte por turnos todas las listas":
    var lists as list of list of int is list of list of int
    calling lists.push with (calling range with 1, 3, 1)
    calling lists.push with (calling range with 10, 12, 1)
    var exp as list of int is [1, 10, 2, 11]
    calling _expect_eq_ints with (calling round_robin with lists), exp, "round_robin"
test "rotate_left mueve el primer elemento al final":
    var xs as list of int is [10, 20, 30]
    var exp as list of int is [20, 30, 10]
    calling _expect_eq_ints with (calling rotate_left with xs, 1), exp, "rotate_left"
test "rotate_right mueve el último elemento al principio":
    var xs as list of int is [10, 20, 30]
    var exp as list of int is [30, 10, 20]
    calling _expect_eq_ints with (calling rotate_right with xs, 1), exp, "rotate_right"
test "las rotaciones dan la vuelta con k grande o negativo":
    var xs as list of int is [10, 20, 30]
    var empty as list of int is list of int
    calling _expect_eq_ints with (calling rotate_left with xs, 4), (calling rotate_left with xs, 1), "rotate k grande"
    calling _expect_eq_ints with (calling rotate_left with xs, -1), (calling rotate_left with xs, 2), "rotate k negativo"
    calling _expect_eq_ints with (calling rotate_left with empty, 3), empty, "rotate vacía"
test "intersperse inserta el separador entre elementos":
    var xs as list of int is [1, 2, 3]
    var exp as list of int is [1, 0, 2, 0, 3]
    calling _expect_eq_ints with (calling intersperse with xs, 0), exp, "intersperse"
test "intersperse de vacía o de un elemento no añade nada":
    var empty as list of int is list of int
    var none as list of int is list of int
    var one as list of int is [5]
    calling _expect_eq_ints with (calling intersperse with empty, 0), none, "intersperse vacía"
    calling _expect_eq_ints with (calling intersperse with one, 0), one, "intersperse uno"
test "flat_map_identity aplana un nivel de anidamiento":
    var nested as list of list of int is list of list of int
    calling nested.push with (calling range with 1, 3, 1)
    calling nested.push with (calling range with 4, 6, 1)
    var exp as list of int is [1, 2, 4, 5]
    calling _expect_eq_ints with (calling flat_map_identity with nested), exp, "flat_map_identity"
test "flat_map_identity coincide con el núcleo genérico":
    var nested as list of list of int is list of list of int
    calling nested.push with (calling range with 1, 3, 1)
    calling _expect_eq_ints with (calling flatten_generic of int with nested), (calling flat_map_identity with nested), "flatten"
test "flatten_generic aplana listas de cualquier tipo":
    var nested as list of list of string is list of list of string
    var inner as list of string is ["a", "b"]
    calling nested.push with inner
    var flat as list of string is calling flatten_generic of string with nested
    calling _expect_eq with (flat at 1), "b", "flatten_generic"
test "el núcleo genérico de flatten con listas vacías da vacío":
    var nested as list of list of int is list of list of int
    var empty as list of int is list of int
    calling nested.push with empty
    calling _expect_eq_ints with (calling flatten_generic of int with nested), empty, "flatten vacía"

# Conjuntos sobre listas ordenadas
test "union_sorted une listas ascendentes y deduplica":
    var b as list of int is [2, 3]
    calling _expect_eq_ints with (calling union_sorted with (calling unfold_range with 1, 3, 1), b), (calling unfold_range with 1, 3, 1), "union_sorted"
test "las operaciones de conjuntos con listas vacías son vacías":
    var empty as list of int is list of int
    calling _expect_eq_ints with (calling union_sorted with empty, empty), empty, "union vacía"
    calling _expect_eq_ints with (calling difference_sorted with empty, empty), empty, "difference vacía"
test "intersect_sorted conserva lo común":
    var a as list of int is [1, 2, 3]
    var b as list of int is [2, 3]
    calling _expect_eq_ints with (calling intersect_sorted with a, b), b, "intersect_sorted"
test "difference_sorted y symmetric_difference_sorted conservan lo exclusivo":
    var a as list of int is [1, 2, 3]
    var b as list of int is [2, 3]
    var only_a as list of int is [1]
    calling _expect_eq_ints with (calling difference_sorted with a, b), only_a, "difference_sorted"
    calling _expect_eq_ints with (calling symmetric_difference_sorted with a, b), only_a, "symmetric_difference"

# Búsqueda e índices
test "find_first y find_last localizan los extremos":
    var xs as list of int is [10, 20, 10]
    calling _expect_some with (calling find_first with xs, 10), 0, "find_first"
    calling _expect_some with (calling find_last with xs, 10), 2, "find_last"
test "find y binary_search devuelven none cuando no encuentran":
    var xs as list of int is [1, 2, 4]
    var absent as maybe int is calling find_first with xs, 9
    var missed as maybe int is calling binary_search with xs, 3
    calling _expect_eq with absent.is_present, false, "find_first none"
    calling _expect_eq with missed.is_present, false, "binary_search none"
test "binary_search encuentra el índice en listas ordenadas":
    var xs as list of int is [1, 2, 4, 5]
    calling _expect_some with (calling binary_search with xs, 4), 2, "binary_search"
test "count_if_even cuenta los pares, incluidos los negativos":
    var xs as list of int is [-2, 0, 3]
    calling _expect_eq with (calling count_if_even with xs), 2, "count_if_even"
test "count_if_positive cuenta los estrictamente positivos":
    var xs as list of int is [-2, 0, 3]
    calling _expect_eq with (calling count_if_positive with xs), 1, "count_if_positive"
test "index_min e index_max localizan el primer extremo":
    var xs as list of int is [3, 1, 4, 1]
    calling _expect_some with (calling index_min with xs), 1, "index_min"
    calling _expect_some with (calling index_max with xs), 2, "index_max"
test "index_min de la lista vacía devuelve none":
    var empty as list of int is list of int
    var lowest as maybe int is calling index_min with empty
    calling _expect_eq with lowest.is_present, false, "index_min vacía"

# Edición estructural
test "insert_at inserta en la posición pedida":
    var xs as list of int is [1, 2, 3]
    var out as list of int is calling insert_at with xs, 1, 9
    calling _expect_eq with (out at 1), 9, "insert_at"
test "remove_at quita el elemento indicado":
    var xs as list of int is [1, 2, 3]
    var out as list of int is calling remove_at with xs, 1
    calling _expect_eq_ints with out, (calling unfold_range with 1, 2, 2), "remove_at"
test "remove_at con índice fuera de rango copia la lista":
    var xs as list of int is [1, 2]
    calling _expect_eq_ints with (calling remove_at with xs, 5), xs, "remove_at fuera"
test "replace_at con índice fuera de rango copia la lista":
    var xs as list of int is [1, 2]
    calling _expect_eq_ints with (calling replace_at with xs, 5, 9), xs, "replace_at fuera"
test "replace_at sustituye el elemento indicado":
    var xs as list of int is [1, 2, 3]
    var out as list of int is calling replace_at with xs, 1, 7
    calling _expect_eq with (out at 1), 7, "replace_at"
test "swap_at intercambia dos posiciones":
    var xs as list of int is [1, 2, 3]
    var out as list of int is calling swap_at with xs, 0, 2
    calling _expect_eq_ints with out, (calling unfold_range with 3, 3, -1), "swap_at"
test "intersperse de un solo elemento devuelve el elemento":
    var one as list of int is [5]
    calling _expect_eq_ints with (calling intersperse with one, 0), one, "intersperse uno"
test "pad_left y pad_right rellenan los extremos":
    var xs as list of int is [1, 2]
    var left as list of int is calling pad_left with xs, 4, -1
    var right as list of int is calling pad_right with xs, 4, -1
    calling _expect_eq with (left at 0), -1, "pad_left"
    calling _expect_eq with (right at 3), -1, "pad_right"

# Estadística
test "median con longitud impar":
    calling _expect_some with (calling _median_int with (calling unfold_range with 1, 5, 1)), 3.0, "median impar"
test "median con longitud par promedia los centrales":
    calling _expect_some with (calling _median_int with (calling unfold_range with 1, 4, 1)), 2.5, "median par"
test "median de la lista vacía es none":
    var empty as list of int is list of int
    var middle as maybe float is calling _median_int with empty
    calling _expect_eq with middle.is_present, false, "median vacía"
test "mode devuelve el valor más frecuente":
    var xs as list of int is [1, 2, 2, 3]
    calling _expect_some with (calling _mode_int with xs), 2, "mode"
test "mode de la lista vacía es none":
    var empty as list of int is list of int
    var frequent as maybe int is calling _mode_int with empty
    calling _expect_eq with frequent.is_present, false, "mode vacía"
test "variance y stddev miden la dispersión":
    var spread as maybe float is calling variance with (calling unfold_range with 1, 5, 1)
    var deviation as maybe float is calling stddev with (calling unfold_range with 1, 5, 1)
    calling _expect_some with spread, 2.0, "variance"
    calling _expect_float_near with deviation.value, 1.4142, 0.001, "stddev"
test "variance de la lista vacía es none":
    var empty as list of int is list of int
    var spread as maybe float is calling variance with empty
    calling _expect_eq with spread.is_present, false, "variance vacía"
test "percentile interpola linealmente":
    calling _expect_some with (calling percentile with (calling unfold_range with 1, 4, 1), 50.0), 2.5, "percentile"
test "percentile fuera de rango devuelve none":
    var out as maybe float is calling percentile with (calling unfold_range with 1, 4, 1), 150.0
    calling _expect_eq with out.is_present, false, "percentile rango"

# Núcleo genérico y versión
test "first_or devuelve el primero o el valor por defecto":
    var empty as list of int is list of int
    calling _expect_eq with (calling first_or of int with (calling unfold_range with 1, 2, 1), 0), 1, "first_or"
    calling _expect_eq with (calling first_or of int with empty, 5), 5, "first_or default"
test "first_or es genérico también para strings":
    var words as list of string is ["a", "b"]
    calling _expect_eq with (calling first_or of string with words, "z"), "a", "first_or string"
test "generic_take y generic_take_last recortan listas de strings":
    var xs as list of string is ["a", "b", "c"]
    var head as list of string is calling generic_take of string with xs, 2
    var tail as list of string is calling generic_take_last of string with xs, 2
    calling _expect_eq with (calling head.len), 2, "generic_take"
    calling _expect_eq with (tail at 0), "b", "generic_take_last"
test "generic_reverse y generic_chain trabajan con strings":
    var xs as list of string is ["a", "b"]
    var backwards as list of string is calling generic_reverse of string with xs
    var joined as list of string is calling generic_chain of string with backwards, xs
    calling _expect_eq with (backwards at 0), "b", "generic_reverse"
    calling _expect_eq with (calling joined.len), 4, "generic_chain"
test "generic_index_of encuentra o devuelve menos uno":
    var xs as list of string is ["a", "b"]
    calling _expect_eq with (calling generic_index_of of string with xs, "b"), 1, "generic_index_of"
    calling _expect_eq with (calling generic_index_of of string with xs, "z"), -1, "generic_index_of falta"
test "LOOM_VERSION es la versión 0.15.0":
    calling _expect with LOOM_VERSION == "0.15.0", "version"
