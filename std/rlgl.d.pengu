# NOTE (hand-maintained): `import std.raylib` below is added by hand after
# generating. rlgl's declarations use raylib's `Matrix` type, but `rlgl.h` does
# not `#include "raylib.h"` (it relies on the includer having done so), so the
# generator cannot detect the dependency and would declare a duplicate `Matrix`
# rune instead. Importing `std.raylib` keeps a single Matrix type shared by both
# bindings. `regen_std_bindings.py` therefore reports this file as hand-curated
# ("import std.raylib would be lost") and skips it: if you ever regenerate it by
# hand, re-add this import and the `link "raylib"` line.
#
## PenguScript declaration binding generated by 'pengu bind'.
## Source header: rlgl.h
include "rlgl.h"

# OpenGL immediate-mode layer of raylib (rlgl). The generated declarations are
# self-contained except for the raylib types they reuse, which are imported
# explicitly below instead of being duplicated here.
import std.raylib

link "raylib"

