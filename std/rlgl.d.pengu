declare rlGetLocationAttrib with id as u32, attribName as ref to frozen char into int

declare rlSetUniform with locIndex as int, value as ref to frozen void, uniformType as int, count as int into void

declare rlSetUniformMatrix with locIndex as int, mat as Matrix into void

declare rlSetUniformMatrices with locIndex as int, mat as ref to frozen Matrix, count as int into void

declare rlSetUniformSampler with locIndex as int, textureId as u32 into void

declare rlSetShader with id as u32, locs as ref to int into void

# Compute shader management
declare rlComputeShaderDispatch with groupX as u32, groupY as u32, groupZ as u32 into void

# Shader buffer storage object management (ssbo)
declare rlLoadShaderBuffer with size as u32, data as ref to frozen void, usageHint as int into u32

declare rlUnloadShaderBuffer with ssboId as u32 into void

declare rlUpdateShaderBuffer with id as u32, data as ref to frozen void, dataSize as u32, offset as u32 into void

declare rlBindShaderBuffer with id as u32, index as u32 into void

declare rlReadShaderBuffer with id as u32, dest as ref to void, count as u32, offset as u32 into void

declare rlCopyShaderBuffer with destId as u32, srcId as u32, destOffset as u32, srcOffset as u32, count as u32 into void

declare rlGetShaderBufferSize with id as u32 into u32

# Buffer management
declare rlBindImageTexture with id as u32, index as u32, format as int, readonly as bool into void

# Matrix state management
declare rlGetMatrixModelview into Matrix

declare rlGetMatrixProjection into Matrix

declare rlGetMatrixTransform into Matrix

declare rlGetMatrixProjectionStereo with eye as int into Matrix

declare rlGetMatrixViewOffsetStereo with eye as int into Matrix

declare rlSetMatrixProjection with proj as Matrix into void

declare rlSetMatrixModelview with view as Matrix into void

declare rlSetMatrixProjectionStereo with right as Matrix, left as Matrix into void

declare rlSetMatrixViewOffsetStereo with right as Matrix, left as Matrix into void

# Quick and dirty cube/quad buffers load->draw->unload
declare rlLoadDrawCube into void

declare rlLoadDrawQuad into void
