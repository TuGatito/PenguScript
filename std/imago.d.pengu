# std/imago.d.pengu - The stb_image (loading and decoding images in common raster formats)
# Pure C-binding declaration file: every declaration maps 1:1 to the native
# stb_image C API. This file cannot contain implementation bodies (.d.pengu rule).
# Memory ownership follows the native library contract: read the upstream docs
# next to each declaration; release any returned handle with the library's own
# cleanup routine before dropping the last reference.
## PenguScript declaration binding generated by 'pengu bind'.
## Source header: imago.h
include "imago.h"

# -- Constants (#define) ------------------------------

const STBI_VERSION as i64 is 1
const FAST_BITS as i64 is 9
const STBI__MARKER_none as i64 is 0xff
const STBI__ZFAST_BITS as i64 is 9
const STBI__ZNSYMS as i64 is 288
const STBI__HDR_BUFLEN as i64 is 1024

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

alias stbi_uc as byte

alias stbi_us as u16

alias Callback1 as ref to weave with user as ref to void, data as ref to char, size as int into int

alias Callback2 as ref to weave with user as ref to void, n as int into void

alias Callback3 as ref to weave with user as ref to void into int

rune stbi_io_callbacks:
  read as Callback1
  skip as Callback2
  eof as Callback3

# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia stbi_

# 8-bits-per-channel interface
declare load_from_memory with buffer as ref to frozen stbi_uc, len as int, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to stbi_uc

declare load_from_callbacks with clbk as ref to frozen stbi_io_callbacks, user as ref to void, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to stbi_uc

declare load with filename as ref to frozen char, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to stbi_uc

declare load_from_file with f as ref to FILE, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to stbi_uc

declare load_gif_from_memory with buffer as ref to frozen stbi_uc, len as int, delays as ref to ref to int, x as ref to int, y as ref to int, z as ref to int, comp as ref to int, req_comp as int into ref to stbi_uc

# 16-bits-per-channel interface
declare load_16_from_memory with buffer as ref to frozen stbi_uc, len as int, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to stbi_us

declare load_16_from_callbacks with clbk as ref to frozen stbi_io_callbacks, user as ref to void, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to stbi_us

declare load_16 with filename as ref to frozen char, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to stbi_us

declare load_from_file_16 with f as ref to FILE, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to stbi_us

declare loadf_from_memory with buffer as ref to frozen stbi_uc, len as int, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to f32

declare loadf_from_callbacks with clbk as ref to frozen stbi_io_callbacks, user as ref to void, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to f32

declare loadf with filename as ref to frozen char, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to f32

declare loadf_from_file with f as ref to FILE, x as ref to int, y as ref to int, channels_in_file as ref to int, desired_channels as int into ref to f32

declare hdr_to_ldr_gamma with gamma as f32 into void

declare hdr_to_ldr_scale with scale as f32 into void

declare ldr_to_hdr_gamma with gamma as f32 into void

declare ldr_to_hdr_scale with scale as f32 into void

# stbi_is_hdr is always defined, but always returns false if STBI_NO_HDR
declare is_hdr_from_callbacks with clbk as ref to frozen stbi_io_callbacks, user as ref to void into int

declare is_hdr_from_memory with buffer as ref to frozen stbi_uc, len as int into int

declare is_hdr with filename as ref to frozen char into int

declare is_hdr_from_file with f as ref to FILE into int

# get a VERY brief reason for failure
# on most compilers (and ALL modern mainstream compilers) this is threadsafe
declare failure_reason into ref to frozen char

# free the loaded image -- this is just free()
declare image_free with retval_from_stbi_load as ref to void into void

# get image dimensions & components without fully decoding
declare info_from_memory with buffer as ref to frozen stbi_uc, len as int, x as ref to int, y as ref to int, comp as ref to int into int

declare info_from_callbacks with clbk as ref to frozen stbi_io_callbacks, user as ref to void, x as ref to int, y as ref to int, comp as ref to int into int

declare is_16_bit_from_memory with buffer as ref to frozen stbi_uc, len as int into int

declare is_16_bit_from_callbacks with clbk as ref to frozen stbi_io_callbacks, user as ref to void into int

declare info with filename as ref to frozen char, x as ref to int, y as ref to int, comp as ref to int into int

declare info_from_file with f as ref to FILE, x as ref to int, y as ref to int, comp as ref to int into int

declare is_16_bit with filename as ref to frozen char into int

declare is_16_bit_from_file with f as ref to FILE into int

# for image formats that explicitly notate that they have premultiplied alpha,
# we just return the colors as stored in the file. set this flag to force
# unpremultiplication. results are undefined if the unpremultiply overflow.
declare set_unpremultiply_on_load with flag_true_if_should_unpremultiply as int into void

# indicate whether we should process iphone images back to canonical format,
# or just pass them through "as-is"
declare convert_iphone_png_to_rgb with flag_true_if_should_convert as int into void

# flip the image vertically, so the first pixel in the output array is the bottom left
declare set_flip_vertically_on_load with flag_true_if_should_flip as int into void

# as above, but only applies to images loaded on the thread that calls the function
# this function is only available if your compiler supports thread-local variables;
# calling it will fail to link if your compiler doesn't
declare set_unpremultiply_on_load_thread with flag_true_if_should_unpremultiply as int into void

declare convert_iphone_png_to_rgb_thread with flag_true_if_should_convert as int into void

declare set_flip_vertically_on_load_thread with flag_true_if_should_flip as int into void

# ZLIB client - used by PNG, available for other purposes
declare zlib_decode_malloc_guesssize with buffer as ref to frozen char, len as int, initial_size as int, outlen as ref to int into ref to char

declare zlib_decode_malloc_guesssize_headerflag with buffer as ref to frozen char, len as int, initial_size as int, outlen as ref to int, parse_header as int into ref to char

declare zlib_decode_malloc with buffer as ref to frozen char, len as int, outlen as ref to int into ref to char

declare zlib_decode_buffer with obuffer as ref to char, olen as int, ibuffer as ref to frozen char, ilen as int into int

declare zlib_decode_noheader_malloc with buffer as ref to frozen char, len as int, outlen as ref to int into ref to char

declare zlib_decode_noheader_buffer with obuffer as ref to char, olen as int, ibuffer as ref to frozen char, ilen as int into int
