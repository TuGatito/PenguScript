-- std/globus.pengu — patrones glob.
--
-- S9. Sintaxis soportada: `*` (cualquier cosa menos `/`), `**` (cualquier cosa,
-- incluidos `/`), `?` (un carácter), `[abc]`, `[a-z]`, `[!abc]` y `{a,b}`.
scroll globus
    foreign "pengu"
        globus_matches = (pattern: Str, path: Str) -> Bool
        globus_find = (pattern: Str, root: Str) -> Vec[String]
        globus_find_with = (pattern: Str, root: Str, max_depth: Int, include_hidden: Bool, follow_links: Bool) -> Vec[String]

    unveil matches = (pattern: &Str, path: &Str) -> Bool
        globus_matches(pattern, path)

    -- Rutas que casan con el patrón, ordenadas, relativas a `root`.
    unveil find = (pattern: &Str, root: &Str) -> Vec[String]
        globus_find(pattern, root)

    unveil find_in = (pattern: &Str) -> Vec[String]
        globus_find(pattern, ".")

    -- Comodines frecuentes.
    unveil all_files = () -> Vec[String]
        globus_find("**/*", ".")

    unveil rust_files = (root: &Str) -> Vec[String]
        globus_find("**/*.rs", root)

    -- Como `find`, con profundidad máxima (`-1` = sin límite), ocultos y enlaces.
    unveil find_with = (pattern: &Str, root: &Str, max_depth: Int, include_hidden: Bool, follow_links: Bool) -> Vec[String]
        globus_find_with(pattern, root, max_depth, include_hidden, follow_links)
