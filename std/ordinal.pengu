## std/ordinal.pengu — CC-backed generic containers.
##
## These types are additive; the existing `list`, `map`, `Set` and `SetString`
## APIs are untouched.
##
## - `LinkedList of T` → CC `list`
## - `UnorderedSet of T` → CC `set`
## - `OrderedSet of T` → CC `oset`
## - `OrderedMap of K and V` → CC `omap`
##
## The compiler monomorphizes each instantiation, so `T`/`K`/`V` can be any
## value type (including strings and user runes).  Elements are stored by
## bytes; the containers never clone or free the payloads they reference.
## Call `release` on the handle; iteration helpers return an owned `list`.
##
## UnorderedSet hashes/compares `string` by content and other built-ins by
## value. Other types use a bytewise fallback (suitable for POD without
## padding). OrderedSet/OrderedMap likewise order built-in keys and fall back
## to bytewise order for user types.

import std.spark

# --- C bridges ------------------------------------------------------------

declare ccx_ll_new with elem_size as int, kind as int into ref to void
declare ccx_ll_push_back with h as ref to void, value as ref to void into void
declare ccx_ll_push_front with h as ref to void, value as ref to void into void
declare ccx_ll_pop_front_into with h as ref to void, out as ref to void, elem_size as int into void
declare ccx_ll_items_into with h as ref to void, out as ref to void, elem_size as int into void
declare ccx_ll_len with h as ref to void into int
declare ccx_ll_clear with h as ref to void into void
declare ccx_ll_free with h as ref to void into void

declare ccx_uset_new with key_size as int, kind as int into ref to void
declare ccx_uset_add with h as ref to void, key as ref to void into bool
declare ccx_uset_has with h as ref to void, key as ref to void into bool
declare ccx_uset_remove with h as ref to void, key as ref to void into bool
declare ccx_uset_items_into with h as ref to void, out as ref to void, key_size as int into void
declare ccx_uset_len with h as ref to void into int
declare ccx_uset_clear with h as ref to void into void
declare ccx_uset_free with h as ref to void into void

declare ccx_oset_new with key_size as int, kind as int into ref to void
declare ccx_oset_add with h as ref to void, key as ref to void into bool
declare ccx_oset_has with h as ref to void, key as ref to void into bool
declare ccx_oset_remove with h as ref to void, key as ref to void into bool
declare ccx_oset_items_into with h as ref to void, out as ref to void, key_size as int into void
declare ccx_oset_len with h as ref to void into int
declare ccx_oset_clear with h as ref to void into void
declare ccx_oset_free with h as ref to void into void

declare ccx_omap_new with key_size as int, val_size as int, kind as int into ref to void
declare ccx_omap_put with h as ref to void, key as ref to void, value as ref to void into bool
declare ccx_omap_has with h as ref to void, key as ref to void into bool
declare ccx_omap_remove with h as ref to void, key as ref to void into bool
declare ccx_omap_get_into with h as ref to void, key as ref to void, out as ref to void, val_size as int into void
declare ccx_omap_keys_into with h as ref to void, out as ref to void, key_size as int into void
declare ccx_omap_values_into with h as ref to void, out as ref to void, val_size as int into void
declare ccx_omap_len with h as ref to void into int
declare ccx_omap_clear with h as ref to void into void
declare ccx_omap_free with h as ref to void into void

## Constante de tipo para el descriptor CC; el codegen la sustituye por una
## constante según `T` (0 entero, 1 string, 2 float, 9 bytes).
weave cc_type_kind shard T into int:
    return 0

# --- Types ----------------------------------------------------------------

rune LinkedList shard T:
    _handle as ref to void

rune UnorderedSet shard T:
    _handle as ref to void

rune OrderedSet shard T:
    _handle as ref to void

rune OrderedMap shard K and V:
    _handle as ref to void

weave new_linked_list shard T into LinkedList of T:
    return with _handle is calling ccx_ll_new with ((size of T) to int), 0

weave new_unordered_set shard T into UnorderedSet of T:
    return with _handle is calling ccx_uset_new with ((size of T) to int), (calling cc_type_kind of T)

weave new_ordered_set shard T into OrderedSet of T:
    return with _handle is calling ccx_oset_new with ((size of T) to int), (calling cc_type_kind of T)

weave new_ordered_map shard K and V into OrderedMap of K and V:
    return with _handle is calling ccx_omap_new with ((size of K) to int), ((size of V) to int), (calling cc_type_kind of K)

# --- LinkedList -----------------------------------------------------------

enchanting LinkedList shard T:
    ## Appends `value` at the back.
    weave push_back with value as T into void:
        calling ccx_ll_push_back with self->_handle, (sigil of value)
    ## Adds `value` at the front.
    weave push_front with value as T into void:
        calling ccx_ll_push_front with self->_handle, (sigil of value)
    ## Removes and returns the front value, or `maybe none`.
    weave pop_front into maybe T:
        var out as maybe T is maybe none
        calling ccx_ll_pop_front_into with self->_handle, (sigil of out), ((size of T) to int)
        return out
    ## Number of elements.
    weave size into int:
        return calling ccx_ll_len with self->_handle
    ## Owned list copy, front to back.
    weave items into list of T:
        var out as list of T is list of T
        calling ccx_ll_items_into with self->_handle, (sigil of out), ((size of T) to int)
        return out
    weave clear into void:
        calling ccx_ll_clear with self->_handle
    ## Releases the CC handle. The receiver is unusable afterwards.
    weave release into void:
        calling ccx_ll_free with self->_handle

# --- Unordered sets -------------------------------------------------------

enchanting UnorderedSet shard T:
    weave add with value as T into bool:
        return calling ccx_uset_add with self->_handle, (sigil of value)
    weave has with value as T into bool:
        return calling ccx_uset_has with self->_handle, (sigil of value)
    weave remove with value as T into bool:
        return calling ccx_uset_remove with self->_handle, (sigil of value)
    weave size into int:
        return calling ccx_uset_len with self->_handle
    weave items into list of T:
        var out as list of T is list of T
        calling ccx_uset_items_into with self->_handle, (sigil of out), ((size of T) to int)
        return out
    weave clear into void:
        calling ccx_uset_clear with self->_handle
    weave release into void:
        calling ccx_uset_free with self->_handle

# --- Ordered sets ---------------------------------------------------------

enchanting OrderedSet shard T:
    weave add with value as T into bool:
        return calling ccx_oset_add with self->_handle, (sigil of value)
    weave has with value as T into bool:
        return calling ccx_oset_has with self->_handle, (sigil of value)
    weave remove with value as T into bool:
        return calling ccx_oset_remove with self->_handle, (sigil of value)
    weave size into int:
        return calling ccx_oset_len with self->_handle
    ## Elements in ascending order.
    weave items into list of T:
        var out as list of T is list of T
        calling ccx_oset_items_into with self->_handle, (sigil of out), ((size of T) to int)
        return out
    weave clear into void:
        calling ccx_oset_clear with self->_handle
    weave release into void:
        calling ccx_oset_free with self->_handle

# --- Ordered maps ---------------------------------------------------------

enchanting OrderedMap shard K and V:
    weave put with key as K, value as V into bool:
        return calling ccx_omap_put with self->_handle, (sigil of key), (sigil of value)
    weave get with key as K into maybe V:
        var out as maybe V is maybe none
        calling ccx_omap_get_into with self->_handle, (sigil of key), (sigil of out), ((size of V) to int)
        return out
    weave has with key as K into bool:
        return calling ccx_omap_has with self->_handle, (sigil of key)
    weave remove with key as K into bool:
        return calling ccx_omap_remove with self->_handle, (sigil of key)
    weave size into int:
        return calling ccx_omap_len with self->_handle
    ## Keys in ascending order.
    weave keys into list of K:
        var out as list of K is list of K
        calling ccx_omap_keys_into with self->_handle, (sigil of out), ((size of K) to int)
        return out
    ## Values in ascending key order.
    weave values into list of V:
        var out as list of V is list of V
        calling ccx_omap_values_into with self->_handle, (sigil of out), ((size of V) to int)
        return out
    weave clear into void:
        calling ccx_omap_clear with self->_handle
    weave release into void:
        calling ccx_omap_free with self->_handle
