-- std/littera.pengu — módulo `littera`: métodos de `Char`.
--
-- `Char` es un escalar Unicode (el `char` de Rust: 4 bytes, sin surrogates).
-- Los predicados `is_ascii_*` son baratos; los Unicode consultan las tablas de
-- la biblioteca estándar del backend.
--
-- Diferidos: `encode_utf8` (necesita slices mutables `&mut [U8]`).

scroll littera
    foreign "pengu"
        c_is_ascii = (c: Char) -> Bool
        c_is_alphabetic = (c: Char) -> Bool
        c_is_numeric = (c: Char) -> Bool
        c_is_alphanumeric = (c: Char) -> Bool
        c_is_whitespace = (c: Char) -> Bool
        c_is_uppercase = (c: Char) -> Bool
        c_is_lowercase = (c: Char) -> Bool
        c_to_uppercase = (c: Char) -> Char
        c_to_lowercase = (c: Char) -> Char
        c_to_digit = (c: Char, radix: U32) -> Option[U32]
        c_to_string = (c: Char) -> String
        c_len_utf8 = (c: Char) -> Usize
        c_len_utf16 = (c: Char) -> Usize
        c_escape_default = (c: Char) -> String
        c_escape_unicode = (c: Char) -> String
        c_is_control = (c: Char) -> Bool
        c_is_punctuation = (c: Char) -> Bool
        c_is_symbol = (c: Char) -> Bool
        c_is_math = (c: Char) -> Bool
        c_is_currency = (c: Char) -> Bool
        c_is_ascii_digit = (c: Char) -> Bool
        c_is_ascii_alphabetic = (c: Char) -> Bool
        c_is_ascii_alphanumeric = (c: Char) -> Bool
        c_is_ascii_whitespace = (c: Char) -> Bool
        c_is_ascii_control = (c: Char) -> Bool
        c_is_ascii_punctuation = (c: Char) -> Bool
        c_is_ascii_hexdigit = (c: Char) -> Bool
        c_is_ascii_graphic = (c: Char) -> Bool
        c_is_ascii_uppercase = (c: Char) -> Bool
        c_is_ascii_lowercase = (c: Char) -> Bool
        c_to_ascii_uppercase = (c: Char) -> Char
        c_to_ascii_lowercase = (c: Char) -> Char
        c_eq_ignore_ascii_case = (a: Char, b: Char) -> Bool
        c_from_u32 = (code: U32) -> Option[Char]
        c_from_digit = (digit: U32, radix: U32) -> Option[Char]

    ritual Char
        -- Carácter con ese escalar Unicode; `none` si no es válido.
        from_u32 = (code: U32) -> Option[Char]
            c_from_u32(code)

        -- Dígito `digit` en la base `radix` (2..=36) como carácter.
        from_digit = (digit: U32, radix: U32) -> Option[Char]
            c_from_digit(digit, radix)

        is_ascii = (@own) -> Bool
            c_is_ascii(@)

        is_alphabetic = (@own) -> Bool
            c_is_alphabetic(@)

        is_numeric = (@own) -> Bool
            c_is_numeric(@)

        is_alphanumeric = (@own) -> Bool
            c_is_alphanumeric(@)

        is_whitespace = (@own) -> Bool
            c_is_whitespace(@)

        is_uppercase = (@own) -> Bool
            c_is_uppercase(@)

        is_lowercase = (@own) -> Bool
            c_is_lowercase(@)

        to_uppercase = (@own) -> Char
            c_to_uppercase(@)

        to_lowercase = (@own) -> Char
            c_to_lowercase(@)

        to_digit = (@own, radix: U32) -> Option[U32]
            c_to_digit(@, radix)

        to_string = (@) -> String
            c_to_string(@)

        len_utf8 = (@own) -> Usize
            c_len_utf8(@)

        len_utf16 = (@own) -> Usize
            c_len_utf16(@)

        escape_default = (@own) -> String
            c_escape_default(@)

        escape_unicode = (@own) -> String
            c_escape_unicode(@)

        is_control = (@own) -> Bool
            c_is_control(@)

        is_punctuation = (@own) -> Bool
            c_is_punctuation(@)

        is_symbol = (@own) -> Bool
            c_is_symbol(@)

        is_math = (@own) -> Bool
            c_is_math(@)

        is_currency = (@own) -> Bool
            c_is_currency(@)

        is_ascii_digit = (@own) -> Bool
            c_is_ascii_digit(@)

        is_ascii_alphabetic = (@own) -> Bool
            c_is_ascii_alphabetic(@)

        is_ascii_alphanumeric = (@own) -> Bool
            c_is_ascii_alphanumeric(@)

        is_ascii_whitespace = (@own) -> Bool
            c_is_ascii_whitespace(@)

        is_ascii_control = (@own) -> Bool
            c_is_ascii_control(@)

        is_ascii_punctuation = (@own) -> Bool
            c_is_ascii_punctuation(@)

        is_ascii_hexdigit = (@own) -> Bool
            c_is_ascii_hexdigit(@)

        is_ascii_graphic = (@own) -> Bool
            c_is_ascii_graphic(@)

        is_ascii_uppercase = (@own) -> Bool
            c_is_ascii_uppercase(@)

        is_ascii_lowercase = (@own) -> Bool
            c_is_ascii_lowercase(@)

        to_ascii_uppercase = (@own) -> Char
            c_to_ascii_uppercase(@)

        to_ascii_lowercase = (@own) -> Char
            c_to_ascii_lowercase(@)

        eq_ignore_ascii_case = (@own, other: Char) -> Bool
            c_eq_ignore_ascii_case(@, other)
