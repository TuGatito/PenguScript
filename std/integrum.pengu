-- std/integrum.pengu — módulo `integrum`: métodos de `Int`.
--
-- `Int` es i32 (32 bits con signo). La aritmética de la superficie comprueba
-- desbordamiento y hace panic; por eso las variantes `wrapping_*`,
-- `saturating_*`, `checked_*` y `overflowing_*` se resuelven en el backend.
--
-- Convención: `U32` es el unsigned del ancho de `Int` (el `UInt` del
-- documento de la stdlib).

scroll integrum
    foreign "pengu"
        int_pow = (base: Int, exp: U32) -> Int
        int_to_string = (value: Int) -> String
        int_to_float = (value: Int) -> Float
        int_to_radix = (value: Int, radix: U32) -> String
        int_digits = (value: Int) -> Vec[U8]
        int_div_ceil = (a: Int, b: Int) -> Int
        int_div_euclid = (a: Int, b: Int) -> Int
        int_rem_euclid = (a: Int, b: Int) -> Int
        int_abs_diff = (a: Int, b: Int) -> U32
        int_unsigned_abs = (value: Int) -> U32
        int_is_power_of_two = (value: Int) -> Bool
        int_count_ones = (value: Int) -> U32
        int_count_zeros = (value: Int) -> U32
        int_leading_zeros = (value: Int) -> U32
        int_trailing_zeros = (value: Int) -> U32
        int_rotate_left = (value: Int, n: U32) -> Int
        int_rotate_right = (value: Int, n: U32) -> Int
        int_swap_bytes = (value: Int) -> Int
        int_reverse_bits = (value: Int) -> Int
        int_ilog2 = (value: Int) -> U32
        int_ilog10 = (value: Int) -> U32
        int_next_power_of_two = (value: Int) -> Int
        int_checked_next_power_of_two = (value: Int) -> Option[Int]
        int_checked_add = (a: Int, b: Int) -> Option[Int]
        int_checked_sub = (a: Int, b: Int) -> Option[Int]
        int_checked_mul = (a: Int, b: Int) -> Option[Int]
        int_checked_div = (a: Int, b: Int) -> Option[Int]
        int_checked_rem = (a: Int, b: Int) -> Option[Int]
        int_checked_neg = (a: Int) -> Option[Int]
        int_checked_abs = (a: Int) -> Option[Int]
        int_checked_pow = (a: Int, exp: U32) -> Option[Int]
        int_checked_div_euclid = (a: Int, b: Int) -> Option[Int]
        int_checked_rem_euclid = (a: Int, b: Int) -> Option[Int]
        int_wrapping_add = (a: Int, b: Int) -> Int
        int_wrapping_sub = (a: Int, b: Int) -> Int
        int_wrapping_mul = (a: Int, b: Int) -> Int
        int_wrapping_div = (a: Int, b: Int) -> Int
        int_wrapping_rem = (a: Int, b: Int) -> Int
        int_wrapping_neg = (a: Int) -> Int
        int_wrapping_pow = (a: Int, exp: U32) -> Int
        int_wrapping_div_euclid = (a: Int, b: Int) -> Int
        int_wrapping_rem_euclid = (a: Int, b: Int) -> Int
        int_saturating_add = (a: Int, b: Int) -> Int
        int_saturating_sub = (a: Int, b: Int) -> Int
        int_saturating_mul = (a: Int, b: Int) -> Int
        int_saturating_div = (a: Int, b: Int) -> Int
        int_saturating_pow = (a: Int, exp: U32) -> Int
        int_overflowing_add = (a: Int, b: Int) -> (Int, Bool)
        int_overflowing_sub = (a: Int, b: Int) -> (Int, Bool)
        int_overflowing_mul = (a: Int, b: Int) -> (Int, Bool)
        int_overflowing_neg = (a: Int) -> (Int, Bool)
        int_from_str = (s: &Str) -> Option[Int]
        int_from_str_radix = (s: &Str, radix: U32) -> Option[Int]

    ritual Int
        -- Constantes asociadas (equivalentes a `i32::MIN/MAX/BITS`).
        sigil MIN: Int = -2147483648
        sigil MAX: Int = 2147483647
        sigil BITS: Int = 32

        -- Parsea un entero decimal; `none` si el texto no es válido.
        from_str = (s: &Str) -> Option[Int]
            int_from_str(s)

        -- Parsea un entero en la base indicada (2..=36).
        from_str_radix = (s: &Str, radix: U32) -> Option[Int]
            int_from_str_radix(s, radix)

        -- Valor absoluto. Hace panic en `Int.MIN` porque `-MIN` desborda.
        abs = (@own) -> Int
            if @ < 0 then
                -@
            else
                @

        pow = (@own, exp: U32) -> Int
            int_pow(@, exp)

        min = (@own, other: Int) -> Int
            if @ < other then
                @
            else
                other

        max = (@own, other: Int) -> Int
            if @ > other then
                @
            else
                other

        clamp = (@own, lo: Int, hi: Int) -> Int
            if @ < lo then
                lo
            elseif @ > hi then
                hi
            else
                @

        signum = (@own) -> Int
            if @ < 0 then
                -1
            elseif @ > 0 then
                1
            else
                0

        is_even = (@own) -> Bool
            @ % 2 == 0

        is_odd = (@own) -> Bool
            @ % 2 != 0

        is_positive = (@own) -> Bool
            @ > 0

        is_negative = (@own) -> Bool
            @ < 0

        is_power_of_two = (@own) -> Bool
            int_is_power_of_two(@)

        div_ceil = (@own, other: Int) -> Int
            int_div_ceil(@, other)

        div_euclid = (@own, other: Int) -> Int
            int_div_euclid(@, other)

        rem_euclid = (@own, other: Int) -> Int
            int_rem_euclid(@, other)

        abs_diff = (@own, other: Int) -> U32
            int_abs_diff(@, other)

        unsigned_abs = (@own) -> U32
            int_unsigned_abs(@)

        to_float = (@own) -> Float
            int_to_float(@)

        to_string = (@) -> String
            int_to_string(@)

        to_radix = (@, radix: U32) -> String
            int_to_radix(@, radix)

        to_octal = (@) -> String
            int_to_radix(@, 8)

        to_hex = (@) -> String
            int_to_radix(@, 16)

        to_binary = (@) -> String
            int_to_radix(@, 2)

        digits = (@own) -> Vec[U8]
            int_digits(@)

        gcd = (@own, other: Int) -> Int
            morph a = @
            morph b = other
            if a < 0 then
                a = -a
            if b < 0 then
                b = -b
            while b != 0 do
                bind remainder = a % b
                a = b
                b = remainder
            a

        lcm = (@own, other: Int) -> Int
            if @ == 0 or other == 0 then
                0
            else
                ((@ / (@).gcd(other)) * other).abs()

        factorial = (@own) -> Int
            if @ < 0 then
                0
            else
                morph result = 1
                morph factor = 2
                while factor <= @ do
                    result = result * factor
                    factor = factor + 1
                result

        count_ones = (@own) -> U32
            int_count_ones(@)

        count_zeros = (@own) -> U32
            int_count_zeros(@)

        leading_zeros = (@own) -> U32
            int_leading_zeros(@)

        trailing_zeros = (@own) -> U32
            int_trailing_zeros(@)

        rotate_left = (@own, n: U32) -> Int
            int_rotate_left(@, n)

        rotate_right = (@own, n: U32) -> Int
            int_rotate_right(@, n)

        swap_bytes = (@own) -> Int
            int_swap_bytes(@)

        reverse_bits = (@own) -> Int
            int_reverse_bits(@)

        ilog2 = (@own) -> U32
            int_ilog2(@)

        ilog10 = (@own) -> U32
            int_ilog10(@)

        next_power_of_two = (@own) -> Int
            int_next_power_of_two(@)

        checked_next_power_of_two = (@own) -> Option[Int]
            int_checked_next_power_of_two(@)

        checked_add = (@own, other: Int) -> Option[Int]
            int_checked_add(@, other)

        checked_sub = (@own, other: Int) -> Option[Int]
            int_checked_sub(@, other)

        checked_mul = (@own, other: Int) -> Option[Int]
            int_checked_mul(@, other)

        checked_div = (@own, other: Int) -> Option[Int]
            int_checked_div(@, other)

        checked_rem = (@own, other: Int) -> Option[Int]
            int_checked_rem(@, other)

        checked_neg = (@own) -> Option[Int]
            int_checked_neg(@)

        checked_abs = (@own) -> Option[Int]
            int_checked_abs(@)

        checked_pow = (@own, exp: U32) -> Option[Int]
            int_checked_pow(@, exp)

        checked_div_euclid = (@own, other: Int) -> Option[Int]
            int_checked_div_euclid(@, other)

        checked_rem_euclid = (@own, other: Int) -> Option[Int]
            int_checked_rem_euclid(@, other)

        wrapping_add = (@own, other: Int) -> Int
            int_wrapping_add(@, other)

        wrapping_sub = (@own, other: Int) -> Int
            int_wrapping_sub(@, other)

        wrapping_mul = (@own, other: Int) -> Int
            int_wrapping_mul(@, other)

        wrapping_div = (@own, other: Int) -> Int
            int_wrapping_div(@, other)

        wrapping_rem = (@own, other: Int) -> Int
            int_wrapping_rem(@, other)

        wrapping_neg = (@own) -> Int
            int_wrapping_neg(@)

        wrapping_pow = (@own, exp: U32) -> Int
            int_wrapping_pow(@, exp)

        wrapping_div_euclid = (@own, other: Int) -> Int
            int_wrapping_div_euclid(@, other)

        wrapping_rem_euclid = (@own, other: Int) -> Int
            int_wrapping_rem_euclid(@, other)

        saturating_add = (@own, other: Int) -> Int
            int_saturating_add(@, other)

        saturating_sub = (@own, other: Int) -> Int
            int_saturating_sub(@, other)

        saturating_mul = (@own, other: Int) -> Int
            int_saturating_mul(@, other)

        saturating_div = (@own, other: Int) -> Int
            int_saturating_div(@, other)

        saturating_pow = (@own, exp: U32) -> Int
            int_saturating_pow(@, exp)

        overflowing_add = (@own, other: Int) -> (Int, Bool)
            int_overflowing_add(@, other)

        overflowing_sub = (@own, other: Int) -> (Int, Bool)
            int_overflowing_sub(@, other)

        overflowing_mul = (@own, other: Int) -> (Int, Bool)
            int_overflowing_mul(@, other)

        overflowing_neg = (@own) -> (Int, Bool)
            int_overflowing_neg(@)
