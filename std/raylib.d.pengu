## PenguScript declaration binding generated by 'pengu bind'.
## Source header: raylib.h
include "raylib.h"

when os == "windows":
    link "raylib"
    link "opengl32"
    link "gdi32"
    # No se necesitan -ldl, -lrt, -lX11
else:
    link "raylib"
    link "GL"
    link "dl"
    link "rt"
    link "X11"



# -- Constants (#define) ------------------------------

const RAYLIB_VERSION_MAJOR as i64 is 6
const RAYLIB_VERSION_MINOR as i64 is 0
const RAYLIB_VERSION_PATCH as i64 is 0
const RAYLIB_VERSION as string is "6.0"

# Some Basic Colors
# NOTE: Custom raylib color palette for amazing visuals on WHITE background
const LIGHTGRAY as Color is with r is 200 and g is 200 and b is 200 and a is 255
const GRAY as Color is with r is 130 and g is 130 and b is 130 and a is 255
const DARKGRAY as Color is with r is 80 and g is 80 and b is 80 and a is 255
const YELLOW as Color is with r is 253 and g is 249 and b is 0 and a is 255
const GOLD as Color is with r is 255 and g is 203 and b is 0 and a is 255
const ORANGE as Color is with r is 255 and g is 161 and b is 0 and a is 255
const PINK as Color is with r is 255 and g is 109 and b is 194 and a is 255
const RED as Color is with r is 230 and g is 41 and b is 55 and a is 255
const MAROON as Color is with r is 190 and g is 33 and b is 55 and a is 255
const GREEN as Color is with r is 0 and g is 228 and b is 48 and a is 255
const LIME as Color is with r is 0 and g is 158 and b is 47 and a is 255
const DARKGREEN as Color is with r is 0 and g is 117 and b is 44 and a is 255
const SKYBLUE as Color is with r is 102 and g is 191 and b is 255 and a is 255
const BLUE as Color is with r is 0 and g is 121 and b is 241 and a is 255
const DARKBLUE as Color is with r is 0 and g is 82 and b is 172 and a is 255
const PURPLE as Color is with r is 200 and g is 122 and b is 255 and a is 255
const VIOLET as Color is with r is 135 and g is 60 and b is 190 and a is 255
const DARKPURPLE as Color is with r is 112 and g is 31 and b is 126 and a is 255
const BEIGE as Color is with r is 211 and g is 176 and b is 131 and a is 255
const BROWN as Color is with r is 127 and g is 106 and b is 79 and a is 255
const DARKBROWN as Color is with r is 76 and g is 63 and b is 47 and a is 255

const WHITE as Color is with r is 255 and g is 255 and b is 255 and a is 255
const BLACK as Color is with r is 0 and g is 0 and b is 0 and a is 255
const BLANK as Color is with r is 0 and g is 0 and b is 0 and a is 0
const MAGENTA as Color is with r is 255 and g is 0 and b is 255 and a is 255
const RAYWHITE as Color is with r is 245 and g is 245 and b is 245 and a is 255

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

# Vector2, 2 components
rune Vector2:
# Function specifiers in case library is build/used as a shared library
# NOTE: Microsoft specifiers to tell compiler that symbols are imported/exported from a .dll
# NOTE: visibility("default") attribute makes symbols "visible" when compiled with -fvisibility=hidden
# ----------------------------------------------------------------------------------
# Defines and Macros
# Allow custom memory allocators
# NOTE: Require recompiling raylib sources
# NOTE: MSVC C++ compiler does not support compound literals (C99 feature)
# Plain structures in C++ (without constructors) can be initialized with { }
# This is called aggregate initialization (C++11 feature)
# Some compilers (mostly macos clang) default to C++98,
# where aggregate initialization can't be used
# So, give a more clear error stating how to fix this
# NOTE: Set some defines with some data types declared by raylib
# Other modules (raymath, rlgl) also require some of those types, so,
# to be able to use those other modules as standalone (not depending on raylib)
# this defines are useful for internal check and avoid type (re)definitions
# Types and Structures Definition
# Boolean type
# Vector x component
  x as f32
# Vector y component
  y as f32

# Vector3, 3 components
rune Vector3:
  x as f32
  y as f32
# Vector z component
  z as f32

# Vector4, 4 components
rune Vector4:
  x as f32
  y as f32
  z as f32
# Vector w component
  w as f32

# Quaternion, 4 components (Vector4 alias)
alias Quaternion as Vector4

# Matrix, 4x4 components, column major, OpenGL style, right-handed
rune Matrix:
  m0 as f32
  m4 as f32
  m8 as f32
  m12 as f32
  m1 as f32
  m5 as f32
  m9 as f32
  m13 as f32
  m2 as f32
  m6 as f32
  m10 as f32
  m14 as f32
  m3 as f32
  m7 as f32
  m11 as f32
  m15 as f32

# Color, 4 components, R8G8B8A8 (32bit)
rune Color:
# Color red value
  r as byte
# Color green value
  g as byte
# Color blue value
  b as byte
# Color alpha value
  a as byte

# Rectangle, 4 components
rune Rectangle:
# Rectangle top-left corner position x
  x as f32
# Rectangle top-left corner position y
  y as f32
# Rectangle width
  width as f32
# Rectangle height
  height as f32

# Image, pixel data stored in CPU memory (RAM)
rune Image:
  data as ref to void
# Image base width
  width as int
# Image base height
  height as int
# Mipmap levels, 1 by default
  mipmaps as int
# Data format (PixelFormat type)
  format as int

# Texture, tex data stored in GPU memory (VRAM)
rune Texture:
# OpenGL texture id
  id as u32
# Texture base width
  width as int
# Texture base height
  height as int
  mipmaps as int
  format as int

# Texture2D, same as Texture
alias Texture2D as Texture

# TextureCubemap, same as Texture
alias TextureCubemap as Texture

# RenderTexture, fbo for texture rendering
rune RenderTexture:
# OpenGL framebuffer object id
  id as u32
# Color buffer attachment texture
  texture as Texture
# Depth buffer attachment texture
  depth as Texture

# RenderTexture2D, same as RenderTexture
alias RenderTexture2D as RenderTexture

# NPatchInfo, n-patch layout info
rune NPatchInfo:
# Texture source rectangle
  source as Rectangle
# Left border offset
  left as int
# Top border offset
  top as int
# Right border offset
  right as int
# Bottom border offset
  bottom as int
# Layout of the n-patch: 3x3, 1x3 or 3x1
  layout as int

# GlyphInfo, font characters glyphs info
rune GlyphInfo:
# Character value (Unicode)
  value as int
# Character offset X when drawing
  offsetX as int
# Character offset Y when drawing
  offsetY as int
# Character advance position X
  advanceX as int
# Character image data
  image as Image

# Font, font texture and GlyphInfo array data
rune Font:
# Base size (default chars height)
  baseSize as int
# Number of glyph characters
  glyphCount as int
# Padding around the glyph characters
  glyphPadding as int
# Texture atlas containing the glyphs
  texture as Texture2D
  recs as ref to Rectangle
  glyphs as ref to GlyphInfo

# Camera, defines position/orientation in 3d space
rune Camera3D:
# Camera position
  position as Vector3
# Camera target it looks-at
  target as Vector3
# Camera up vector (rotation over its axis)
  up as Vector3
# Camera field-of-view aperture in Y (degrees) in perspective, used as near plane height in world units in orthographic
  fovy as f32
# Camera projection: CAMERA_PERSPECTIVE or CAMERA_ORTHOGRAPHIC
  projection as int

alias Camera as Camera3D

# Camera2D, defines position/orientation in 2d space
rune Camera2D:
# Camera offset (screen space offset from window origin)
  offset as Vector2
# Camera target (world space target point that is mapped to screen space offset)
  target as Vector2
# Camera rotation in degrees (pivots around target)
  rotation as f32
# Camera zoom (scaling around target), must not be set to 0, set to 1.0f for no scale
  zoom as f32

# Mesh, vertex data and vao/vbo
rune Mesh:
# Number of vertices stored in arrays
  vertexCount as int
# Number of triangles stored (indexed or not)
  triangleCount as int
  vertices as ref to f32
  texcoords as ref to f32
  texcoords2 as ref to f32
  normals as ref to f32
  tangents as ref to f32
  colors as ref to byte
  indices as ref to u16
# Vertex attributes data
# Skin data for animation
# Number of bones (MAX: 256 bones)
  boneCount as int
  boneIndices as ref to byte
  boneWeights as ref to f32
  animVertices as ref to f32
  animNormals as ref to f32
# Runtime animation vertex data (CPU skinning)
# NOTE: In case of GPU skinning, not used, pointers are NULL
# OpenGL identifiers
# OpenGL Vertex Array Object id
  vaoId as u32
  vboId as ref to u32

# Vertex attributes data
# Skin data for animation
# Runtime animation vertex data (CPU skinning)
# NOTE: In case of GPU skinning, not used, pointers are NULL
# OpenGL identifiers
# Shader
rune Shader:
# Shader program id
  id as u32
  locs as ref to int

# MaterialMap
rune MaterialMap:
# Material map texture
  texture as Texture2D
# Material map color
  color as Color
# Material map value
  value as f32

# Material, includes shader and maps
rune Material:
# Material shader
  shader as Shader
  maps as ref to MaterialMap
# Material generic parameters (if required)
  params as f32

# Transform, vertex transformation data
rune Transform:
# Translation
  translation as Vector3
# Rotation
  rotation as Quaternion
# Scale
  scale as Vector3

## Anim pose, an array of Transform[]
alias ModelAnimPose as ref to Transform

# Anim pose, an array of Transform[]
# Bone, skeletal animation bone
rune BoneInfo:
# Bone name
  name as char
# Bone parent
  parent as int

# Skeleton, animation bones hierarchy
rune ModelSkeleton:
# Number of bones
  boneCount as int
  bones as ref to BoneInfo
# Bones base transformation (Transform[])
  bindPose as ModelAnimPose

# Model, meshes, materials and animation data
rune Model:
# Local transform matrix
  transform as Matrix
# Number of meshes
  meshCount as int
# Number of materials
  materialCount as int
  meshes as ref to Mesh
  materials as ref to Material
  meshMaterial as ref to int
# Animation data
# Skeleton for animation
  skeleton as ModelSkeleton
# Runtime animation data (CPU/GPU skinning)
# Current animation pose (Transform[])
  currentPose as ModelAnimPose
  boneMatrices as ref to Matrix

# Animation data
# Runtime animation data (CPU/GPU skinning)
# ModelAnimation, contains a full animation sequence
rune ModelAnimation:
# Animation name
  name as char
# Number of bones (per pose)
  boneCount as int
# Number of animation key frames
  keyframeCount as int
  keyframePoses as ref to ModelAnimPose

# Ray, ray for raycasting
rune Ray:
# Ray position (origin)
  position as Vector3
# Ray direction (normalized)
  direction as Vector3

# RayCollision, ray hit information
rune RayCollision:
# Did the ray hit something?
  hit as bool
# Distance to the nearest hit
  distance as f32
# Point of the nearest hit
  point as Vector3
# Surface normal of hit
  normal as Vector3

# BoundingBox
rune BoundingBox:
# Minimum vertex box-corner
  min as Vector3
# Maximum vertex box-corner
  max as Vector3

# Wave, audio wave data
rune Wave:
# Total number of frames (considering channels)
  frameCount as u32
# Frequency (samples per second)
  sampleRate as u32
# Bit depth (bits per sample): 8, 16, 32 (24 not supported)
  sampleSize as u32
# Number of channels (1-mono, 2-stereo, ...)
  channels as u32
  data as ref to void

# Opaque structs declaration
# NOTE: Actual structs are defined internally in raudio module
alias rAudioBuffer as opaque

alias rAudioProcessor as opaque

# AudioStream, custom audio stream
rune AudioStream:
  buffer as ref to rAudioBuffer
  processor as ref to rAudioProcessor
  sampleRate as u32
  sampleSize as u32
  channels as u32

# Sound
rune Sound:
# Audio stream
  stream as AudioStream
  frameCount as u32

# Music, audio stream, anything longer than ~10 seconds should be streamed
rune Music:
  stream as AudioStream
  frameCount as u32
# Music looping enable
  looping as bool
# Type of music context (audio filetype)
  ctxType as int
  ctxData as ref to void

# VrDeviceInfo, Head-Mounted-Display device parameters
rune VrDeviceInfo:
# Horizontal resolution in pixels
  hResolution as int
# Vertical resolution in pixels
  vResolution as int
# Horizontal size in meters
  hScreenSize as f32
# Vertical size in meters
  vScreenSize as f32
# Distance between eye and display in meters
  eyeToScreenDistance as f32
# Lens separation distance in meters
  lensSeparationDistance as f32
# IPD (distance between pupils) in meters
  interpupillaryDistance as f32
# Lens distortion constant parameters
  lensDistortionValues as f32
# Chromatic aberration correction parameters
  chromaAbCorrection as f32

# VrStereoConfig, VR stereo rendering configuration for simulator
rune VrStereoConfig:
# VR projection matrices (per eye)
  projection as Matrix
# VR view offset matrices (per eye)
  viewOffset as Matrix
# VR left lens center
  leftLensCenter as f32
# VR right lens center
  rightLensCenter as f32
# VR left screen center
  leftScreenCenter as f32
# VR right screen center
  rightScreenCenter as f32
# VR distortion scale
  scale as f32
# VR distortion scale in
  scaleIn as f32

# File path list
rune FilePathList:
# Filepaths entries count
  count as u32
  paths as ref to ref to char

# Automation event
rune AutomationEvent:
# Event frame
  frame as u32
# Event type (AutomationEventType)
  type as u32
# Event parameters (if required)
  params as int

# Automation event list
rune AutomationEventList:
# Events max entries (MAX_AUTOMATION_EVENTS)
  capacity as u32
# Events entries count
  count as u32
  events as ref to AutomationEvent

