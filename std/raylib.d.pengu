  CUBEMAP_LAYOUT_CROSS_FOUR_BY_THREE is 4

omen FontType:
  FONT_DEFAULT is 0
  FONT_BITMAP is 1
  FONT_SDF is 2

omen BlendMode:
  BLEND_ALPHA is 0
  BLEND_ADDITIVE is 1
  BLEND_MULTIPLIED is 2
  BLEND_ADD_COLORS is 3
  BLEND_SUBTRACT_COLORS is 4
  BLEND_ALPHA_PREMULTIPLY is 5
  BLEND_CUSTOM is 6
  BLEND_CUSTOM_SEPARATE is 7

omen Gesture:
  GESTURE_NONE is 0
  GESTURE_TAP is 1
  GESTURE_DOUBLETAP is 2
  GESTURE_HOLD is 4
  GESTURE_DRAG is 8
  GESTURE_SWIPE_RIGHT is 16
  GESTURE_SWIPE_LEFT is 32
  GESTURE_SWIPE_UP is 64
  GESTURE_SWIPE_DOWN is 128
  GESTURE_PINCH_IN is 256
  GESTURE_PINCH_OUT is 512

omen CameraMode:
  CAMERA_CUSTOM is 0
  CAMERA_FREE is 1
  CAMERA_ORBITAL is 2
  CAMERA_FIRST_PERSON is 3
  CAMERA_THIRD_PERSON is 4

omen CameraProjection:
  CAMERA_PERSPECTIVE is 0
  CAMERA_ORTHOGRAPHIC is 1

omen NPatchLayout:
  NPATCH_NINE_PATCH is 0
  NPATCH_THREE_PATCH_VERTICAL is 1
  NPATCH_THREE_PATCH_HORIZONTAL is 2

