realm tuple

enchanting tuple<A, B>
  len = -> size_t
    2

  swap = -> tuple<B, A>
    a, b = @
    (b, a)

  to_pair = -> pair<A, B>
    (@.first, @.second)

enchanting tuple<A, B, C>
  len = -> size_t
    3

  first = -> A
    a, b, c = @
    a

  second = -> B
    a, b, c = @
    b

  third = -> C
    a, b, c = @
    c
