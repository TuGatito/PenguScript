-- std/via.pengu — módulo `via`: sistema de archivos, rutas y descriptores.
--
-- S5. El módulo expone tres capas:
--   * funciones libres (`via::read_to_string`, `via::create_dir_all`, …)
--     que trabajan sobre rutas como `Str`;
--   * los runes de datos `FileInfo` y `DirEntry`;
--   * el descriptor `File`, con funciones asociadas (`File.open`) y métodos
--     (`read_to_string`, `write_str`, …).
--
-- Los mensajes de error viajan en `IoError.message`; el módulo define su
-- propio rune de error porque los módulos de `std` no pueden importarse
-- entre sí (ver scratch/LIMITATIONS_AUDIT.md).
scroll via
    unveil rune IoError
        unveil message: String

    unveil rune FileInfo
        unveil len: U64
        unveil is_file: Bool
        unveil is_dir: Bool
        unveil is_symlink: Bool
        unveil readonly: Bool
        unveil modified_ms: Option[I64]

    unveil rune File
        unveil handle: U64

    unveil rune DirEntry
        unveil path: String
        unveil file_name: String
        unveil is_dir: Bool
        unveil is_file: Bool
        unveil is_symlink: Bool
        unveil len: U64

    unveil rune Path
        unveil text: String

    unveil rune PathBuf
        unveil text: String

    unveil rune FileType
        unveil is_file: Bool
        unveil is_dir: Bool
        unveil is_symlink: Bool

    unveil rune Permissions
        unveil readonly: Bool

    unveil rune OpenOptions
        unveil read: Bool
        unveil write: Bool
        unveil append: Bool
        unveil create: Bool
        unveil truncate: Bool

    unveil rune WalkOptions
        unveil follow_links: Bool
        unveil include_hidden: Bool
        unveil max_depth: Option[Int]

    unveil ritual IoError for Show
        show = (@) -> String
            @.message.to_string()

    unveil ritual FileInfo for Show
        show = (@) -> String
            format("FileInfo(len: #{@.len}, is_file: #{@.is_file}, is_dir: #{@.is_dir}, is_symlink: #{@.is_symlink}, readonly: #{@.readonly}, modified_ms: #{@.modified_ms})")

    unveil ritual DirEntry for Show
        show = (@) -> String
            format("DirEntry(path: #{@.path}, is_dir: #{@.is_dir})")

    unveil ritual Path for Show
        show = (@) -> String
            @.text.to_string()

    unveil ritual PathBuf for Show
        show = (@) -> String
            @.text.to_string()

    unveil ritual FileType for Show
        show = (@) -> String
            format("FileType(is_file: #{@.is_file}, is_dir: #{@.is_dir}, is_symlink: #{@.is_symlink})")

    unveil ritual Permissions for Show
        show = (@) -> String
            format("Permissions(readonly: #{@.readonly})")

    unveil ritual OpenOptions for Show
        show = (@) -> String
            format("OpenOptions(read: #{@.read}, write: #{@.write}, append: #{@.append}, create: #{@.create}, truncate: #{@.truncate})")

    unveil ritual WalkOptions for Show
        show = (@) -> String
            format("WalkOptions(follow_links: #{@.follow_links}, include_hidden: #{@.include_hidden}, max_depth: #{@.max_depth})")

    unveil ritual File for Show
        show = (@) -> String
            format("File(handle: #{@.handle})")

    foreign "pengu"
        via_exists = (path: Str) -> Bool
        via_is_file = (path: Str) -> Bool
        via_is_dir = (path: Str) -> Bool
        via_is_symlink = (path: Str) -> Bool
        via_metadata = (path: Str) -> Result[FileInfo, IoError]
        via_read_to_string = (path: Str) -> Result[String, IoError]
        via_read_bytes = (path: Str) -> Result[Vec[U8], IoError]
        via_write_string = (path: Str, contents: Str) -> Result[Unit, IoError]
        via_write_bytes = (path: Str, contents: Vec[U8]) -> Result[Unit, IoError]
        via_append_string = (path: Str, contents: Str) -> Result[Unit, IoError]
        via_create_dir = (path: Str) -> Result[Unit, IoError]
        via_create_dir_all = (path: Str) -> Result[Unit, IoError]
        via_remove_file = (path: Str) -> Result[Unit, IoError]
        via_remove_dir = (path: Str) -> Result[Unit, IoError]
        via_remove_dir_all = (path: Str) -> Result[Unit, IoError]
        via_rename = (from: Str, to: Str) -> Result[Unit, IoError]
        via_copy = (from: Str, to: Str) -> Result[U64, IoError]
        via_canonicalize = (path: Str) -> Result[String, IoError]
        via_read_link = (path: Str) -> Result[String, IoError]
        via_symlink = (target: Str, link: Str) -> Result[Unit, IoError]
        via_hard_link = (from: Str, to: Str) -> Result[Unit, IoError]
        via_set_readonly = (path: Str, readonly: Bool) -> Result[Unit, IoError]
        via_read_dir = (path: Str) -> Result[Vec[DirEntry], IoError]
        via_walk_names = (path: Str) -> Result[Vec[String], IoError]
        via_walk_files = (path: Str) -> Result[Vec[String], IoError]
        via_walk_dirs = (path: Str) -> Result[Vec[String], IoError]
        via_current_dir = () -> Result[String, IoError]
        via_set_current_dir = (path: Str) -> Result[Unit, IoError]
        via_temp_dir = () -> String
        via_which = (program: Str) -> Option[String]
        via_join = (base: Str, child: Str) -> String
        via_parent = (path: Str) -> Option[Str]
        via_file_name = (path: Str) -> Option[Str]
        via_extension = (path: Str) -> Option[Str]
        via_file_stem = (path: Str) -> Option[Str]
        via_is_absolute = (path: Str) -> Bool
        via_file_open_read = (path: Str) -> Result[File, IoError]
        via_file_create = (path: Str) -> Result[File, IoError]
        via_file_append = (path: Str) -> Result[File, IoError]
        via_file_read_to_string = (handle: U64) -> Result[String, IoError]
        via_file_read_to_end = (handle: U64) -> Result[Vec[U8], IoError]
        via_file_write_str = (handle: U64, text: Str) -> Result[Usize, IoError]
        via_file_write_all = (handle: U64, bytes: Vec[U8]) -> Result[Unit, IoError]
        via_file_flush = (handle: U64) -> Result[Unit, IoError]
        via_file_seek = (handle: U64, pos: U64) -> Result[U64, IoError]
        via_file_seek_from_end = (handle: U64, offset: U64) -> Result[U64, IoError]
        via_file_set_len = (handle: U64, len: U64) -> Result[Unit, IoError]
        via_file_metadata = (handle: U64) -> Result[FileInfo, IoError]
        via_file_close = (handle: U64) -> Unit
        via_file_open_with = (path: Str, read: Bool, write: Bool, append: Bool, create: Bool, truncate: Bool) -> Result[File, IoError]
        via_file_read_bytes = (handle: U64, count: U64) -> Result[Vec[U8], IoError]
        via_file_write_bytes = (handle: U64, bytes: Vec[U8]) -> Result[Usize, IoError]
        via_file_sync_all = (handle: U64) -> Result[Unit, IoError]
        via_file_sync_data = (handle: U64) -> Result[Unit, IoError]
        via_file_try_clone = (handle: U64) -> Result[File, IoError]
        via_file_modified_ms = (handle: U64) -> Result[Option[I64], IoError]
        via_path_join = (base: Str, child: Str) -> String
        via_path_parent = (path: Str) -> Option[String]
        via_path_file_name = (path: Str) -> Option[String]
        via_path_extension = (path: Str) -> Option[String]
        via_path_file_stem = (path: Str) -> Option[String]
        via_path_is_absolute = (path: Str) -> Bool
        via_path_starts_with = (path: Str, base: Str) -> Bool
        via_path_ends_with = (path: Str, suffix: Str) -> Bool
        via_path_strip_prefix = (path: Str, base: Str) -> Option[String]
        via_path_components = (path: Str) -> Vec[String]
        via_path_to_string_lossy = (path: Str) -> String
        via_path_pop = (path: Str) -> (String, Bool)
        via_path_set_extension = (path: Str, extension: Str) -> (String, Bool)
        via_path_with_extension = (path: Str, extension: Str) -> String
        via_walk_with = (root: Str, follow_links: Bool, include_hidden: Bool, max_depth: Int, mode: Int) -> Result[Vec[DirEntry], IoError]
        via_permissions = (path: Str) -> Result[Permissions, IoError]
        via_set_permissions = (path: Str, permissions: Permissions) -> Result[Unit, IoError]
        via_file_type = (path: Str) -> Result[FileType, IoError]
        via_modified_ms = (path: Str) -> Result[Option[I64], IoError]
        via_created_ms = (path: Str) -> Result[Option[I64], IoError]
        via_accessed_ms = (path: Str) -> Result[Option[I64], IoError]

    unveil exists = (path: &Str) -> Bool
        via_exists(path)

    unveil is_file = (path: &Str) -> Bool
        via_is_file(path)

    unveil is_dir = (path: &Str) -> Bool
        via_is_dir(path)

    unveil is_symlink = (path: &Str) -> Bool
        via_is_symlink(path)

    unveil metadata = (path: &Str) -> Result[FileInfo, IoError]
        via_metadata(path)

    unveil read_to_string = (path: &Str) -> Result[String, IoError]
        via_read_to_string(path)

    unveil read_bytes = (path: &Str) -> Result[Vec[U8], IoError]
        via_read_bytes(path)

    unveil write_string = (path: &Str, contents: &Str) -> Result[Unit, IoError]
        via_write_string(path, contents)

    unveil write_bytes = (path: &Str, contents: Vec[U8]) -> Result[Unit, IoError]
        via_write_bytes(path, contents)

    unveil append_string = (path: &Str, contents: &Str) -> Result[Unit, IoError]
        via_append_string(path, contents)

    unveil create_dir = (path: &Str) -> Result[Unit, IoError]
        via_create_dir(path)

    unveil create_dir_all = (path: &Str) -> Result[Unit, IoError]
        via_create_dir_all(path)

    unveil remove_file = (path: &Str) -> Result[Unit, IoError]
        via_remove_file(path)

    unveil remove_dir = (path: &Str) -> Result[Unit, IoError]
        via_remove_dir(path)

    unveil remove_dir_all = (path: &Str) -> Result[Unit, IoError]
        via_remove_dir_all(path)

    unveil rename = (from: &Str, to: &Str) -> Result[Unit, IoError]
        via_rename(from, to)

    unveil copy = (from: &Str, to: &Str) -> Result[U64, IoError]
        via_copy(from, to)

    unveil canonicalize = (path: &Str) -> Result[String, IoError]
        via_canonicalize(path)

    unveil read_link = (path: &Str) -> Result[String, IoError]
        via_read_link(path)

    unveil symlink = (target: &Str, link: &Str) -> Result[Unit, IoError]
        via_symlink(target, link)

    unveil hard_link = (from: &Str, to: &Str) -> Result[Unit, IoError]
        via_hard_link(from, to)

    unveil set_readonly = (path: &Str, readonly: Bool) -> Result[Unit, IoError]
        via_set_readonly(path, readonly)

    unveil read_dir = (path: &Str) -> Result[Vec[DirEntry], IoError]
        via_read_dir(path)

    -- Recorrido en pre-orden y ordenado por ruta; no sigue enlaces simbólicos.
    unveil walk = (path: &Str) -> Result[Vec[String], IoError]
        via_walk_names(path)

    unveil walk_files = (path: &Str) -> Result[Vec[String], IoError]
        via_walk_files(path)

    unveil walk_dirs = (path: &Str) -> Result[Vec[String], IoError]
        via_walk_dirs(path)

    unveil current_dir = () -> Result[String, IoError]
        via_current_dir()

    unveil set_current_dir = (path: &Str) -> Result[Unit, IoError]
        via_set_current_dir(path)

    unveil temp_dir = () -> String
        via_temp_dir()

    unveil which = (program: &Str) -> Option[String]
        via_which(program)

    unveil join = (base: &Str, child: &Str) -> String
        via_join(base, child)

    unveil parent = (path: &Str) -> Option[Str]
        via_parent(path)

    unveil file_name = (path: &Str) -> Option[Str]
        via_file_name(path)

    unveil extension = (path: &Str) -> Option[Str]
        via_extension(path)

    unveil file_stem = (path: &Str) -> Option[Str]
        via_file_stem(path)

    unveil is_absolute = (path: &Str) -> Bool
        via_is_absolute(path)

    -- ------------------------------------------------------------------
    -- Path / PathBuf: rutas con métodos. Guardan el texto y delegan en el
    -- runtime; las mutaciones devuelven el `Path` nuevo porque no hay
    -- prestatarios en el lenguaje (equivalente a `PathBuf::push`).
    -- ------------------------------------------------------------------
    unveil ritual Path
        new = (text: &Str) -> Path
            Path(text: String.from(text))

        join = (@, other: Path) -> PathBuf
            PathBuf(text: via_path_join(@.text.as_str(), other.text.as_str()))

        parent = (@) -> Option[Path]
            match via_path_parent(@.text.as_str())
                when some(text) then some(Path(text: text))
                when none then none

        file_name = (@) -> Option[String]
            via_path_file_name(@.text.as_str())

        extension = (@) -> Option[String]
            via_path_extension(@.text.as_str())

        file_stem = (@) -> Option[String]
            via_path_file_stem(@.text.as_str())

        is_absolute = (@) -> Bool
            via_path_is_absolute(@.text.as_str())

        is_relative = (@) -> Bool
            if via_path_is_absolute(@.text.as_str()) then false else true

        exists = (@) -> Bool
            via_exists(@.text.as_str())

        is_file = (@) -> Bool
            via_is_file(@.text.as_str())

        is_dir = (@) -> Bool
            via_is_dir(@.text.as_str())

        is_symlink = (@) -> Bool
            via_is_symlink(@.text.as_str())

        starts_with = (@, base: Path) -> Bool
            via_path_starts_with(@.text.as_str(), base.text.as_str())

        ends_with = (@, suffix: &Str) -> Bool
            via_path_ends_with(@.text.as_str(), suffix)

        strip_prefix = (@, base: Path) -> Option[Path]
            match via_path_strip_prefix(@.text.as_str(), base.text.as_str())
                when some(text) then some(Path(text: text))
                when none then none

        components = (@) -> Vec[String]
            via_path_components(@.text.as_str())

        display = (@) -> String
            via_path_to_string_lossy(@.text.as_str())

        to_string_lossy = (@) -> String
            via_path_to_string_lossy(@.text.as_str())

        to_string = (@) -> String
            @.text.to_string()

        as_path = (@) -> Path
            Path(text: @.text.clone())

        metadata = (@) -> Result[FileInfo, IoError]
            via_metadata(@.text.as_str())

        file_type = (@) -> Result[FileType, IoError]
            via_file_type(@.text.as_str())

        read_to_string = (@) -> Result[String, IoError]
            via_read_to_string(@.text.as_str())

        read_bytes = (@) -> Result[Vec[U8], IoError]
            via_read_bytes(@.text.as_str())

        write_string = (@, contents: &Str) -> Result[Unit, IoError]
            via_write_string(@.text.as_str(), contents)

        create_dir_all = (@) -> Result[Unit, IoError]
            via_create_dir_all(@.text.as_str())

    unveil ritual PathBuf
        new = (text: &Str) -> PathBuf
            PathBuf(text: String.from(text))

        from_path = (path: Path) -> PathBuf
            PathBuf(text: path.text.clone())

        push = (@mut, part: &Str) -> Unit
            @.text = via_path_join(@.text.as_str(), part)

        push_path = (@mut, part: Path) -> Unit
            @.text = via_path_join(@.text.as_str(), part.text.as_str())

        pop = (@mut) -> Bool
            bind (text, removed) = via_path_pop(@.text.as_str())
            if removed then
                @.text = text
                true
            else
                false

        set_extension = (@mut, extension: &Str) -> Bool
            bind (text, changed) = via_path_set_extension(@.text.as_str(), extension)
            if changed then
                @.text = text
                true
            else
                false

        with_extension = (@, extension: &Str) -> PathBuf
            PathBuf(text: via_path_with_extension(@.text.as_str(), extension))

        file_name = (@) -> Option[String]
            via_path_file_name(@.text.as_str())

        extension = (@) -> Option[String]
            via_path_extension(@.text.as_str())

        file_stem = (@) -> Option[String]
            via_path_file_stem(@.text.as_str())

        parent = (@) -> Option[Path]
            match via_path_parent(@.text.as_str())
                when some(text) then some(Path(text: text))
                when none then none

        as_path = (@) -> Path
            Path(text: @.text.clone())

        display = (@) -> String
            via_path_to_string_lossy(@.text.as_str())

        to_string = (@) -> String
            @.text.to_string()

        is_absolute = (@) -> Bool
            via_path_is_absolute(@.text.as_str())

        exists = (@) -> Bool
            via_exists(@.text.as_str())

        is_file = (@) -> Bool
            via_is_file(@.text.as_str())

        is_dir = (@) -> Bool
            via_is_dir(@.text.as_str())

        metadata = (@) -> Result[FileInfo, IoError]
            via_metadata(@.text.as_str())

        read_to_string = (@) -> Result[String, IoError]
            via_read_to_string(@.text.as_str())

        write_string = (@, contents: &Str) -> Result[Unit, IoError]
            via_write_string(@.text.as_str(), contents)

        join = (@, other: Path) -> PathBuf
            PathBuf(text: via_path_join(@.text.as_str(), other.text.as_str()))

    -- ------------------------------------------------------------------
    -- OpenOptions: apertura configurable. Los métodos devuelven `&mut` para
    -- encadenar sobre una variable (`morph options = OpenOptions.new()`).
    -- ------------------------------------------------------------------
    unveil ritual OpenOptions
        new = () -> OpenOptions
            OpenOptions(read: false, write: false, append: false, create: false, truncate: false)

        read = (@mut, allow: Bool) -> &mut OpenOptions
            @.read = allow
            @

        write = (@mut, allow: Bool) -> &mut OpenOptions
            @.write = allow
            @

        append = (@mut, allow: Bool) -> &mut OpenOptions
            @.append = allow
            @

        create = (@mut, allow: Bool) -> &mut OpenOptions
            @.create = allow
            @

        truncate = (@mut, allow: Bool) -> &mut OpenOptions
            @.truncate = allow
            @

        open = (@, path: &Str) -> Result[File, IoError]
            via_file_open_with(path, @.read, @.write, @.append, @.create, @.truncate)

    -- ------------------------------------------------------------------
    -- FileType / Permissions: vistas de metadatos con métodos.
    -- ------------------------------------------------------------------
    unveil ritual FileType
        is_file = (@) -> Bool
            @.is_file

        is_dir = (@) -> Bool
            @.is_dir

        is_symlink = (@) -> Bool
            @.is_symlink

    unveil ritual Permissions
        readonly = (@) -> Bool
            @.readonly

    unveil ritual DirEntry
        path_of = (@) -> String
            @.path.clone()

        file_name = (@) -> String
            @.file_name.clone()

        name = (@) -> String
            @.file_name.clone()

        is_dir = (@) -> Bool
            @.is_dir

        is_file = (@) -> Bool
            @.is_file

        is_symlink = (@) -> Bool
            @.is_symlink

        len = (@) -> U64
            @.len

        file_type = (@) -> FileType
            FileType(is_file: @.is_file, is_dir: @.is_dir, is_symlink: @.is_symlink)

        metadata = (@) -> Result[FileInfo, IoError]
            via_metadata(@.path.as_str())

    -- ------------------------------------------------------------------
    -- WalkOptions: recorrido configurable.
    -- ------------------------------------------------------------------
    unveil ritual WalkOptions
        new = () -> WalkOptions
            WalkOptions(follow_links: false, include_hidden: false, max_depth: none)

        follow_links = (@mut, enabled: Bool) -> Unit
            @.follow_links = enabled

        include_hidden = (@mut, enabled: Bool) -> Unit
            @.include_hidden = enabled

        max_depth = (@mut, depth: Int) -> Unit
            @.max_depth = some(depth)

        walk = (@, root: &Str) -> Result[Vec[DirEntry], IoError]
            via_walk_with(root, @.follow_links, @.include_hidden, walk_depth(@.max_depth), 0)

        walk_files = (@, root: &Str) -> Result[Vec[DirEntry], IoError]
            via_walk_with(root, @.follow_links, @.include_hidden, walk_depth(@.max_depth), 1)

        walk_dirs = (@, root: &Str) -> Result[Vec[DirEntry], IoError]
            via_walk_with(root, @.follow_links, @.include_hidden, walk_depth(@.max_depth), 2)

    unveil ritual File
        open_with = (path: &Str, options: OpenOptions) -> Result[File, IoError]
            via_file_open_with(path, options.read, options.write, options.append, options.create, options.truncate)

        read_bytes = (@mut, count: U64) -> Result[Vec[U8], IoError]
            via_file_read_bytes(@.handle, count)

        write_bytes = (@mut, data: Vec[U8]) -> Result[Usize, IoError]
            via_file_write_bytes(@.handle, data)

        open = (path: &Str) -> Result[File, IoError]
            via_file_open_read(path)

        create = (path: &Str) -> Result[File, IoError]
            via_file_create(path)

        append = (path: &Str) -> Result[File, IoError]
            via_file_append(path)

        read_to_string = (@mut) -> Result[String, IoError]
            via_file_read_to_string(@.handle)

        read_to_end = (@mut) -> Result[Vec[U8], IoError]
            via_file_read_to_end(@.handle)

        write_str = (@mut, text: &Str) -> Result[Usize, IoError]
            via_file_write_str(@.handle, text)

        write_all = (@mut, bytes: Vec[U8]) -> Result[Unit, IoError]
            via_file_write_all(@.handle, bytes)

        flush = (@mut) -> Result[Unit, IoError]
            via_file_flush(@.handle)

        seek = (@mut, pos: U64) -> Result[U64, IoError]
            via_file_seek(@.handle, pos)

        seek_from_end = (@mut, offset: U64) -> Result[U64, IoError]
            via_file_seek_from_end(@.handle, offset)

        set_len = (@mut, len: U64) -> Result[Unit, IoError]
            via_file_set_len(@.handle, len)

        metadata = (@) -> Result[FileInfo, IoError]
            via_file_metadata(@.handle)

        close = (@own) -> Unit
            via_file_close(@.handle)

        sync_all = (@mut) -> Result[Unit, IoError]
            via_file_sync_all(@.handle)

        sync_data = (@mut) -> Result[Unit, IoError]
            via_file_sync_data(@.handle)

        try_clone = (@) -> Result[File, IoError]
            via_file_try_clone(@.handle)

        modified_ms = (@) -> Result[Option[I64], IoError]
            via_file_modified_ms(@.handle)

    unveil file_type = (path: &Str) -> Result[FileType, IoError]
        via_file_type(path)

    unveil permissions = (path: &Str) -> Result[Permissions, IoError]
        via_permissions(path)

    unveil set_permissions = (path: &Str, permissions: Permissions) -> Result[Unit, IoError]
        via_set_permissions(path, permissions)

    unveil modified_ms = (path: &Str) -> Result[Option[I64], IoError]
        via_modified_ms(path)

    unveil created_ms = (path: &Str) -> Result[Option[I64], IoError]
        via_created_ms(path)

    unveil accessed_ms = (path: &Str) -> Result[Option[I64], IoError]
        via_accessed_ms(path)

    unveil walk_with = (root: &Str, options: WalkOptions, mode: Int) -> Result[Vec[DirEntry], IoError]
        via_walk_with(root, options.follow_links, options.include_hidden, walk_depth(options.max_depth), mode)

    -- Convierte `max_depth` (`Option[Int]`) al entero del runtime: `0` = sin límite.
    unveil walk_depth = (depth: Option[Int]) -> Int
        match depth
            when some(value) then value
            when none then 0

    -- Azúcar sobre `Path`/`PathBuf` para el código que aún usa texto.
    unveil open_with = (path: &Str, options: OpenOptions) -> Result[File, IoError]
        via_file_open_with(path, options.read, options.write, options.append, options.create, options.truncate)

    unveil path = (text: &Str) -> Path
        Path(text: String.from(text))

    unveil path_buf = (text: &Str) -> PathBuf
        PathBuf(text: String.from(text))
