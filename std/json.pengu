# ----------------------------------------------------------------------------
# Deep-copy helpers
# ----------------------------------------------------------------------------

## Deep-copies a list of JSON values.
##
## ## Parámetros
## - `items`: the list to copy. Borrowed.
##
## ## Retorno
## A new list whose elements are independent deep copies. Release it with
## `free_values`.
##
## ## Complejidad
## O(total size of the elements).
weave _clone_values with items as list of JsonValue into list of JsonValue:
    var out as list of JsonValue is list of JsonValue with capacity items.len
    for item in items:
        calling out.push with (calling _json_clone_value with item)
    return out

## Deep-copies a list of object entries.
##
## ## Parámetros
## - `entries`: the entry list to copy. Borrowed.
##
## ## Retorno
## A new list whose entries are independent deep copies. Release it with
## `free_entries`.
weave _clone_entries with entries as list of JsonEntry into list of JsonEntry:
    var out as list of JsonEntry is list of JsonEntry with capacity entries.len
    for e in entries:
        var value_copy as JsonValue is calling _json_clone_value with e.value
        var key_copy as string is "{e.key}"
        calling out.push with (with key is key_copy, value is value_copy)
    return out

# ----------------------------------------------------------------------------
# Comparison helpers
# ----------------------------------------------------------------------------

## Compares two JSON values with strict type identity.
##
## ## Parámetros
## - `a`, `b`: values to compare. Borrowed.
##
## ## Retorno
## `true` when both have the same variant and equal payload; `Int(1)` and
## `Float(1.0)` are **not** equal.
##
## ## Complejidad
## O(size of the values).
weave _strict_eq with a as JsonValue, b as JsonValue into bool:
    return a == b

# ----------------------------------------------------------------------------
# JsonValue: predicates and typed access
# ----------------------------------------------------------------------------

enchanting JsonValue:
    ## True when the value is `null`.
    weave is_null into bool:
        return judge (essence of self):
            when Null -> true
            else -> false

    ## True when the value is a boolean.
    weave is_bool into bool:
        return judge (essence of self):
            when Bool -> true
            else -> false

    ## True when the value is an integer.
    weave is_int into bool:
        return judge (essence of self):
            when Int -> true
            else -> false

    ## True when the value is a float.
    weave is_float into bool:
        return judge (essence of self):
            when Float -> true
            else -> false

    ## True when the value is an integer or a float.
    weave is_number into bool:
        return judge (essence of self):
            when Int -> true
            when Float -> true
            else -> false

    ## True when the value is a string.
    weave is_string into bool:
        return judge (essence of self):
            when Str -> true
            else -> false

    ## True when the value is an array.
    weave is_array into bool:
        return judge (essence of self):
            when Arr -> true
            else -> false

    ## True when the value is an object.
    weave is_object into bool:
        return judge (essence of self):
            when Obj -> true
            else -> false

    ## The lowercase JSON type name.
    ##
    ## ## Retorno
    ## `"null"`, `"bool"`, `"int"`, `"float"`, `"string"`, `"array"` or
    ## `"object"`.
    weave type_name into string:
        return judge (essence of self):
            when Null -> "null"
            when Bool -> "bool"
            when Int -> "int"
            when Float -> "float"
            when Str -> "string"
            when Arr -> "array"
            when Obj -> "object"

    ## The boolean payload, when the value is a boolean.
    ##
    ## ## Retorno
    ## `some b` or `none`. The box is a plain value; release it with `banish`.
    weave as_bool into maybe bool:
        var out as maybe bool is maybe none
        var ignored as int is judge (essence of self):
            when Bool with value ->
                set out is some value
                0
            else ->
                0
        return out

    ## The integer payload, when the value is an integer.
    ##
    ## ## Retorno
    ## `some i` or `none`.
    weave as_int into maybe i64:
        var out as maybe i64 is maybe none
        var ignored as int is judge (essence of self):
            when Int with value ->
                set out is some value
                0
            else ->
                0
        return out

    ## The float payload, when the value is a float.
    ##
    ## ## Retorno
    ## `some f` or `none`. An `Int` is **not** converted; use `as_number`.
    weave as_float into maybe f64:
        var out as maybe f64 is maybe none
        var ignored as int is judge (essence of self):
            when Float with value ->
                set out is some value
                0
            else ->
                0
        return out

    ## The value as an `f64`, converting integers.
    ##
    ## ## Retorno
    ## `some f` for an `Int` or a `Float`, `none` otherwise.
    weave as_number into maybe f64:
        var out as maybe f64 is maybe none
        var ignored as int is judge (essence of self):
            when Int with value ->
                set out is some (value to f64)
                0
            when Float with value ->
                set out is some value
                0
            else ->
                0
        return out

    ## An owned copy of the string payload.
    ##
    ## ## Retorno
    ## `some s` (owned copy; release it with `banish`) or `none`.
    weave as_string into maybe string:
        var out as maybe string is maybe none
        var ignored as int is judge (essence of self):
            when Str with value ->
                var text_copy as string is "{value}"
                set out is some text_copy
                0
            else ->
                0
        return out

    ## An owned deep copy of the array payload.
    ##
    ## ## Retorno
    ## `some items` (deep copy; release it with `free_values`) or `none`.
    weave as_array into maybe list of JsonValue:
        var out as maybe list of JsonValue is maybe none
        var ignored as int is judge (essence of self):
            when Arr with items ->
                set out is some (calling _clone_values with items)
                0
            else ->
                0
        return out

    ## An owned deep copy of the object payload.
    ##
    ## ## Retorno
    ## `some entries` (deep copy; release it with `free_entries`) or `none`.
    weave as_object into maybe list of JsonEntry:
        var out as maybe list of JsonEntry is maybe none
        var ignored as int is judge (essence of self):
            when Obj with entries ->
                set out is some (calling _clone_entries with entries)
                0
            else ->
                0
        return out

    # ------------------------------------------------------------------------
    # Array access
    # ------------------------------------------------------------------------

    ## Number of elements in an array.
    ##
    ## ## Retorno
    ## The element count, or `0` when the value is not an array.
    weave array_len into int:
        return judge (essence of self):
            when Arr with items -> items.len
            else -> 0

    ## Element at `i`, as an owned deep copy.
    ##
    ## ## Parámetros
    ## - `i`: 0-based index.
    ##
    ## ## Retorno
    ## `some value` (owned; release it with `banish`) or `none` when the value
    ## is not an array or `i` is out of range.
    weave at with i as int into maybe JsonValue:
        var out as maybe JsonValue is maybe none
        var ignored as int is judge (essence of self):
            when Arr with items ->
                if i >= 0 and i < items.len:
                    set out is some (calling _json_clone_value with (items at i))
                0
            else ->
                0
        return out

    ## First element, as an owned deep copy.
    ##
    ## ## Retorno
    ## `some value` or `none` for an empty/non-array value.
    weave first into maybe JsonValue:
        return calling self.at with 0

    ## Last element, as an owned deep copy.
    ##
    ## ## Retorno
    ## `some value` or `none` for an empty/non-array value.
    weave last into maybe JsonValue:
        var n as int is calling self.array_len
        if n == 0:
            return maybe none
        return calling self.at with (n - 1)

    # ------------------------------------------------------------------------
    # Object access
    # ------------------------------------------------------------------------

    ## Number of members in an object.
    ##
    ## ## Retorno
    ## The member count, or `0` when the value is not an object.
    weave object_len into int:
        return judge (essence of self):
            when Obj with entries -> entries.len
            else -> 0

    ## True when `key` is a member of the object.
    ##
    ## ## Parámetros
    ## - `key`: the member name. Borrowed.
    weave has_key with key as string into bool:
        var found as bool is false
        var ignored as int is judge (essence of self):
            when Obj with entries ->
                for e in entries:
                    if e.key == key:
                        set found is true
                0
            else ->
                0
        return found

    ## Member `key`, as an owned deep copy.
    ##
    ## ## Retorno
    ## `some value` (owned; release it with `banish`) or `none`.
    weave get with key as string into maybe JsonValue:
        var out as maybe JsonValue is maybe none
        var ignored as int is judge (essence of self):
            when Obj with entries ->
                for e in entries:
                    if e.key == key:
                        set out is some (calling _json_clone_value with e.value)
                0
            else ->
                0
        return out

    ## An owned copy of every key, in insertion order.
    ##
    ## ## Retorno
    ## A `list of string` (release it with `free_strings`); empty for a
    ## non-object.
    weave keys into list of string:
        var out as list of string is list of string
        var ignored as int is judge (essence of self):
            when Obj with entries ->
                for e in entries:
                    calling out.push with "{e.key}"
                0
            else ->
                0
        return out

    ## An owned deep copy of every value, in insertion order.
    ##
    ## ## Retorno
    ## A `list of JsonValue` (release it with `free_values`); empty for a
    ## non-object.
    weave values into list of JsonValue:
        var out as list of JsonValue is list of JsonValue
        var ignored as int is judge (essence of self):
            when Obj with entries ->
                for e in entries:
                    calling out.push with (calling _json_clone_value with e.value)
                0
            else ->
                0
        return out

    ## An owned deep copy of every entry, in insertion order.
    ##
    ## ## Retorno
    ## A `list of JsonEntry` (release it with `free_entries`); empty for a
    ## non-object.
    weave entries into list of JsonEntry:
        var out as list of JsonEntry is list of JsonEntry
        var ignored as int is judge (essence of self):
            when Obj with entries ->
                for e in entries:
                    var key_copy as string is "{e.key}"
                    var val_copy as JsonValue is calling _json_clone_value with e.value
                    calling out.push with (with key is key_copy, value is val_copy)
                0
            else ->
                0
        return out

    # ------------------------------------------------------------------------
    # JSON Pointer (RFC 6901)
    # ------------------------------------------------------------------------

    ## Resolves a JSON Pointer against the value.
    ##
    ## A pointer is a sequence of `/`-prefixed tokens. `""` addresses the
    ## value itself, `"/"` addresses the member with the empty key, `"~1"`
    ## decodes to `/` and `"~0"` to `~`. Array tokens must be canonical decimal
    ## indices (`0`, `7`; `01` is invalid).
    ##
    ## ## Parámetros
    ## - `path`: the pointer. Borrowed.
    ##
    ## ## Retorno
    ## `some value` (an owned deep copy; release it with `banish`) or `none`
    ## when a token is missing, an index is invalid/out of range, or the path
    ## does not start with `/`.
    ##
    ## ## Complejidad
    ## O(number of tokens × size of the current container).
    ##
    ## ## Ejemplo
    ## ```pengu
    ## var v as JsonValue is (calling root.pointer with "/a/b/0") or:
    ##     return 1
    ## defer banish v
    ## ```
    weave pointer with path as string into maybe JsonValue:
        var out as maybe JsonValue is maybe none
        if path == "":
            set out is some (calling self.clone)
            return out
        var n as int is path length
        var raw as ref to frozen byte is bytes of path
        if n == 0 or ((raw at 0) to int) != JSON_SLASH:
            return out
        var current as JsonValue is calling self.clone
        var pos as int is 1
        var more as bool is true
        while more:
            var start as int is pos
            while pos < n and ((raw at pos) to int) != JSON_SLASH:
                set pos is pos + 1
            var token as string is calling _json_substring with path, start, pos
            var token_out as string is calling _unescape_pointer with token
            banish token
            var step as maybe JsonValue is maybe none
            if calling current.is_object:
                set step is calling current.get with token_out
            else if calling current.is_array:
                var idx as int is calling _index_token with token_out
                if idx >= 0:
                    set step is calling current.at with idx
            banish token_out
            if not step.is_present:
                calling _json_drop_maybe with (sigil of step)
                banish current
                return out
            var next as JsonValue is step.value
            calling _json_drop_maybe with (sigil of step)
            banish current
            set current is next
            if pos < n:
                set pos is pos + 1
            else:
                set more is false
        banish out
        return some current

    # ------------------------------------------------------------------------
    # Search, comparison, copy, free
    # ------------------------------------------------------------------------

    ## Every value of a member named `key`, anywhere in the tree.
    ##
    ## The search is depth-first in document order, and it descends into both
    ## arrays and objects. The result contains owned deep copies.
    ##
    ## ## Parámetros
    ## - `key`: the member name to look for. Borrowed.
    ##
    ## ## Retorno
    ## A `list of JsonValue`; empty when nothing matches. Release it with
    ## `free_values`.
    weave find_key with key as string into list of JsonValue:
        var out as list of JsonValue is list of JsonValue
        var root as JsonValue is essence of self
        set out is calling _find_key_into with root, key, out
        return out

    ## Strict structural equality.
    ##
    ## ## Parámetros
    ## - `other`: the value to compare against.
    ##
    ## ## Retorno
    ## `true` when both values have the same variant and equal payload.
    ## `Int(1)` and `Float(1.0)` are not equal; use `equals_numeric` for that.
    weave equals with other as JsonValue into bool:
        var me as JsonValue is essence of self
        return me == other

    ## Numeric-aware equality: `Int(1)` equals `Float(1.0)`.
    ##
    ## Arrays and objects compare structurally with the same numeric rule at the
    ## top level of each element/member.
    ##
    ## ## Parámetros
    ## - `other`: the value to compare against.
    ##
    ## ## Retorno
    ## `true` when both are numbers with the same IEEE-754 value, or both are
    ## the same non-numeric variant with equal payload, or arrays/objects whose
    ## elements are numerically equal.
    weave equals_numeric with other as JsonValue into bool:
        var me as JsonValue is essence of self
        return calling _numeric_eq with me, other

    ## A deep, independent copy of the value.
    ##
    ## ## Retorno
    ## A new tree with its own strings and lists. Release it with `banish`.
    weave clone into JsonValue:
        var me as JsonValue is essence of self
        return calling _json_clone_value with me

    ## Releases the value and resets it to `null`.
    ##
    ## `free` is the method form of `banish`: it works on a `ref to JsonValue`
    ## (a method receiver) and is idempotent.
    ##
    ## ## Memoria
    ## Frees every owned buffer below the value.
    weave free into void:
        calling _json_free_raw with self

    # ------------------------------------------------------------------------
    # In-place mutation
    # ------------------------------------------------------------------------

    ## Appends `v` to an array, taking ownership of it.
    ##
    ## ## Parámetros
    ## - `v`: the element. Its ownership transfers to the array.
    ##
    ## ## Efectos
    ## Panics when the receiver is not an array.
    weave push_json with v as JsonValue into void:
        if not calling self.is_array:
            calling spark.panic with "JsonValue.push_json: value is not an array"
        calling _json_push_arr with self, v

    ## Removes and returns the last array element.
    ##
    ## ## Retorno
    ## `some value` (owned) or `none` for an empty/non-array value.
    ##
    ## ## Efectos
    ## Panics when the receiver is not an array.
    weave pop_json into maybe JsonValue:
        if not calling self.is_array:
            calling spark.panic with "JsonValue.pop_json: value is not an array"
        var out as maybe JsonValue is maybe none
        var slot as JsonValue is calling JsonValue.null_value
        if calling _json_pop_arr with self, sigil of slot:
            set out is some slot
        return out

    ## Replaces array element `i`, releasing the old subtree.
    ##
    ## ## Parámetros
    ## - `i`: 0-based index.
    ## - `v`: the new element; its ownership transfers to the array.
    ##
    ## ## Efectos
    ## Panics when the receiver is not an array or `i` is out of range.
    weave set_at with i as int, v as JsonValue into void:
        if not calling self.is_array:
            calling spark.panic with "JsonValue.set_at: value is not an array"
        if not calling _json_set_at_arr with self, i, v:
            calling spark.panic with "JsonValue.set_at: index out of range"

    ## Inserts or replaces `key`, taking ownership of `v`.
    ##
    ## The key is copied; replacing an existing member releases its old value.
    ##
    ## ## Parámetros
    ## - `key`: the member name. Borrowed.
    ## - `v`: the new value; its ownership transfers to the object.
    ##
    ## ## Efectos
    ## Panics when the receiver is not an object.
    weave put_json with key as string, v as JsonValue into void:
        if not calling self.is_object:
            calling spark.panic with "JsonValue.put_json: value is not an object"
        calling _json_set_key_obj with self, key, v

    ## Removes `key` and returns its value.
    ##
    ## ## Parámetros
    ## - `key`: the member name. Borrowed.
    ##
    ## ## Retorno
    ## `some value` (owned) or `none` when the key is absent.
    ##
    ## ## Efectos
    ## Panics when the receiver is not an object.
    weave remove_key with key as string into maybe JsonValue:
        if not calling self.is_object:
            calling spark.panic with "JsonValue.remove_key: value is not an object"
        var out as maybe JsonValue is maybe none
        var slot as JsonValue is calling JsonValue.null_value
        if calling _json_remove_key_obj with self, key, sigil of slot:
            set out is some slot
        return out

    ## Inserts or replaces `key`; the explicit-name form of `put_json`.
    ##
    ## ## Parámetros
    ## - `key`: the member name. Borrowed.
    ## - `v`: the new value; its ownership transfers to the object.
    weave set_key with key as string, v as JsonValue into void:
        calling self.put_json with key, v

    ## Shallow merge: every member of `other` is put into the receiver.
    ##
    ## ## Parámetros
    ## - `other`: a JSON object. Borrowed; its values are deep-copied.
    ##
    ## ## Efectos
    ## Panics when either value is not an object.
    weave merge with other as JsonValue into void:
        if not calling self.is_object:
            calling spark.panic with "JsonValue.merge: receiver is not an object"
        if not calling other.is_object:
            calling spark.panic with "JsonValue.merge: argument is not an object"
        var ignored as int is judge other:
            when Obj with entries ->
                for e in entries:
                    calling self.put_json with e.key, (calling _json_clone_value with e.value)
                0
            else ->
                0

# ----------------------------------------------------------------------------
# Pointer, numeric-equality and search helpers
# ----------------------------------------------------------------------------

## Decodes one RFC 6901 reference token (`~1` -> `/`, `~0` -> `~`).
##
## ## Parámetros
## - `token`: the raw token (no `/`). Borrowed.
##
## ## Retorno
## An owned decoded string; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## var t as string is calling json._unescape_pointer with "a~1b"   # "a/b"
## ```
weave _unescape_pointer with token as string into string:
    var sb as StringBuilder is calling StringBuilder.new
    var raw as ref to frozen byte is bytes of token
    var n as int is token length
    var i as int is 0
    while i < n:
        var b as int is (raw at i) to int
        if b == 126:
            if i + 1 < n and ((raw at (i + 1)) to int) == 48:
                calling sb.append with "~"
                set i is i + 2
            else if i + 1 < n and ((raw at (i + 1)) to int) == 49:
                calling sb.append with "/"
                set i is i + 2
            else:
                calling sb.append_char with '~'
                set i is i + 1
        else:
            calling sb.append_char with (b to char)
            set i is i + 1
    return calling sb.finish

## Parses a JSON Pointer array token as a canonical non-negative index.
##
## ## Parámetros
## - `token`: a decoded pointer token. Borrowed.
##
## ## Retorno
## The index, or `-1` when the token is empty, has a leading zero (`01`), is
## not all digits, or does not fit an `int`.
##
## ## Ejemplo
## ```pengu
## calling json._index_token with "12"   # 12
## calling json._index_token with "01"   # -1
## ```
weave _index_token with token as string into int:
    var n as int is token length
    if n == 0:
        return -1
    var raw as ref to frozen byte is bytes of token
    var lead_byte as int is (raw at 0) to int
    if lead_byte == 48 and n > 1:
        return -1
    var value as int is 0
    var i as int is 0
    while i < n:
        var b as int is (raw at i) to int
        if b < 48 or b > 57:
            return -1
        var digit as int is b - 48
        if value > (2147483647 - digit) / 10:
            return -1
        set value is value * 10 + digit
        set i is i + 1
    return value

## Numeric-aware structural equality.
##
## ## Parámetros
## - `a`, `b`: values to compare. Borrowed.
##
## ## Retorno
## `true` when the values match, treating `Int(n)` and `Float(n)` as equal.
weave _numeric_eq with a as JsonValue, b as JsonValue into bool:
    var result as bool is false
    var ignored as int is judge a:
        when Int with value ->
            let av is value
            var inner as int is judge b:
                when Int with value ->
                    if av == value:
                        set result is true
                    0
                when Float with value ->
                    if (av to f64) == value:
                        set result is true
                    0
                else ->
                    0
            inner
        when Float with value ->
            let avf is value
            var inner2 as int is judge b:
                when Int with value ->
                    if avf == (value to f64):
                        set result is true
                    0
                when Float with value ->
                    if avf == value:
                        set result is true
                    0
                else ->
                    0
            inner2
        when Arr with items ->
            let ai is items
            var inner3 as int is judge b:
                when Arr with items ->
                    if ai.len == items.len:
                        var same as bool is true
                        var i as int is 0
                        while i < ai.len and same:
                            if not calling _numeric_eq with (ai at i), (items at i):
                                set same is false
                            set i is i + 1
                        if same:
                            set result is true
                    0
                else ->
                    0
            inner3
        when Obj with entries ->
            let ae is entries
            var inner4 as int is judge b:
                when Obj with entries ->
                    if ae.len == entries.len:
                        var same2 as bool is true
                        for e in ae:
                            var bval as JsonValue is calling JsonValue.null_value
                            var have as bool is false
                            for f in entries:
                                if f.key == e.key:
                                    set bval is calling _json_clone_value with f.value
                                    set have is true
                            if not have:
                                set same2 is false
                            else:
                                if not calling _numeric_eq with e.value, bval:
                                    set same2 is false
                            banish bval
                        if same2:
                            set result is true
                    0
                else ->
                    0
            inner4
        else ->
            if a == b:
                set result is true
            0
    return result

## Recursive worker for `JsonValue.find_key`.
##
## ## Parámetros
## - `v`: the subtree to scan. Borrowed.
## - `key`: the member name to look for. Borrowed.
## - `out`: accumulator. Appends owned deep copies.
weave _find_key_into with v as JsonValue, key as string, out as list of JsonValue into list of JsonValue:
    var acc as list of JsonValue is out
    var ignored as int is judge v:
        when Obj with entries ->
            for e in entries:
                if e.key == key:
                    calling acc.push with (calling _json_clone_value with e.value)
                set acc is calling _find_key_into with e.value, key, acc
            0
        when Arr with items ->
            for item in items:
                set acc is calling _find_key_into with item, key, acc
            0
        else ->
            0
    return acc

# ----------------------------------------------------------------------------
# Parser
# ----------------------------------------------------------------------------

## The recursive-descent JSON parser state.
##
## One `Parser` parses one document. It owns `err_message` only after a failure;
## `src` is **borrowed** (the caller keeps the source alive for the duration of
## the parse). The parser is not derived `Nexus`: it never owns the source.
rune Parser:
    ## Source text. Borrowed.
    src as string
    ## Current byte offset.
    pos as int
    ## Current 1-indexed line.
    line as int
    ## Current 1-indexed byte column.
    col as int
    ## Current nesting depth.
    depth as int
    ## Parse options.
    opts as ParseOptions
    ## When `false`, `validate` mode: values are checked but no DOM is built.
    build as bool
    ## Set as soon as the first error is recorded.
    failed as bool
    ## Error category.
    err_kind as JsonErrorKind
    ## Owned error message once `failed` is true.
    err_message as string
    ## Error line.
    err_line as int
    ## Error column.
    err_col as int
    ## Error byte offset.
    err_offset as int

## Computes the 1-indexed `(line, col)` of a byte offset.
##
## ## Parámetros
## - `s`: the source. Borrowed.
## - `offset`: a byte offset (clamped to the string).
## - `line`: output, 1-indexed.
## - `col`: output, 1-indexed byte column.
weave _line_col_at with s as string, offset as int, line as ref to int, col as ref to int into void:
    var n as int is s length
    var off as int is offset
    if off < 0:
        set off is 0
    if off > n:
        set off is n
    var raw as ref to frozen byte is bytes of s
    var l as int is 1
    var c as int is 1
    var i as int is 0
    while i < off:
        if ((raw at i) to int) == JSON_NEWLINE:
            set l is l + 1
            set c is 1
        else:
            set c is c + 1
        set i is i + 1
    set essence of line is l
    set essence of col is c

enchanting Parser:
    ## Returns the byte at `pos + off`, or `-1` past the end.
    weave peek_at with off as int into int:
        var n as int is self->src length
        var at as int is self->pos + off
        if at < 0 or at >= n:
            return -1
        var raw as ref to frozen byte is bytes of self->src
        return (raw at at) to int

    ## Returns the current byte, or `-1` at end of input.
    weave peek into int:
        return calling self.peek_at with 0

    ## Consumes one byte, updating the line/column counters.
    ##
    ## ## Retorno
    ## The byte consumed, or `-1` at end of input.
    weave advance into int:
        var b as int is calling self.peek
        if b < 0:
            return -1
        set self->pos is self->pos + 1
        if b == JSON_NEWLINE:
            set self->line is self->line + 1
            set self->col is 1
        else:
            set self->col is self->col + 1
        return b

    ## Records the first error and releases a later competing message.
    ##
    ## ## Parámetros
    ## - `kind`: the category.
    ## - `message`: an owned message; ownership transfers to the parser.
    weave fail with kind as JsonErrorKind, message as string into void:
        if self->failed:
            banish message
            return
        set self->failed is true
        set self->err_kind is kind
        set self->err_message is message
        set self->err_line is self->line
        set self->err_col is self->col
        set self->err_offset is self->pos

    ## Moves the recorded error out of the parser.
    ##
    ## ## Retorno
    ## A `JsonError` that owns the parser's message.
    weave take_error into JsonError:
        var e as JsonError is with kind is self->err_kind, message is self->err_message, line is self->err_line, col is self->err_col, offset is self->err_offset
        set self->err_message is ""
        return e

    ## True when the remaining input begins with `word`.
    ##
    ## ## Parámetros
    ## - `word`: an ASCII literal (`null`, `true`, `false`, `NaN`, ...).
    weave starts_with_word with word as string into bool:
        var wl as int is word length
        var n as int is self->src length
        if self->pos + wl > n:
            return false
        var src_bytes as ref to frozen byte is bytes of self->src
        var word_bytes as ref to frozen byte is bytes of word
        var i as int is 0
        while i < wl:
            if ((src_bytes at (self->pos + i)) to int) != ((word_bytes at i) to int):
                return false
            set i is i + 1
        return true

    ## Consumes `word` after `starts_with_word` returned true.
    weave consume_word with word as string into void:
        var wl as int is word length
        var i as int is 0
        while i < wl:
            calling self.advance
            set i is i + 1

    ## Skips RFC 8259 whitespace and, when enabled, comments.
    weave skip_whitespace into void:
        var again as bool is true
        while again:
            set again is false
            var scanning as bool is true
            while scanning:
                var b as int is calling self.peek
                if b == 32 or b == 9 or b == 10 or b == 13:
                    calling self.advance
                else:
                    set scanning is false
            if self->failed:
                return
            if self->opts.allow_comments and ((calling self.peek) == JSON_SLASH):
                var nxt as int is calling self.peek_at with 1
                if nxt == JSON_SLASH:
                    calling self.advance
                    calling self.advance
                    while (calling self.peek) >= 0 and (calling self.peek) != JSON_NEWLINE:
                        calling self.advance
                    set again is true
                else if nxt == 42:
                    calling self.advance
                    calling self.advance
                    var closed as bool is false
                    while (calling self.peek) >= 0:
                        if (calling self.peek) == 42 and ((calling self.peek_at with 1) == JSON_SLASH):
                            calling self.advance
                            calling self.advance
                            set closed is true
                            break
                        calling self.advance
                    if not closed:
                        set self->pos is self->src length
                        calling self.fail with JsonErrorKind.UnexpectedEof, "unterminated block comment"
                        return
                    set again is true

    ## Parses the whole document: one value plus optional trailing whitespace.
    ##
    ## ## Retorno
    ## The parsed value, or `JsonValue.Null` (with `failed` set) on error.
    weave parse_document into JsonValue:
        calling self.skip_whitespace
        if self->failed:
            return calling JsonValue.null_value
        if (calling self.peek) < 0:
            calling self.fail with JsonErrorKind.UnexpectedEof, "expected a JSON value, found end of input"
            return calling JsonValue.null_value
        var v as JsonValue is calling self.parse_value
        if self->failed:
            return v
        calling self.skip_whitespace
        if self->failed:
            banish v
            return calling JsonValue.null_value
        if (calling self.peek) >= 0:
            calling self.fail with JsonErrorKind.TrailingCharacters, "trailing characters after the JSON value"
            banish v
            return calling JsonValue.null_value
        return v

    ## Parses one value.
    ##
    ## ## Retorno
    ## The value, or `JsonValue.Null` with `failed` set.
    weave parse_value into JsonValue:
        calling self.skip_whitespace
        if self->failed:
            return calling JsonValue.null_value
        var b as int is calling self.peek
        if b < 0:
            calling self.fail with JsonErrorKind.UnexpectedEof, "expected a JSON value, found end of input"
            return calling JsonValue.null_value
        if b == 123:
            return calling self.parse_object
        if b == 91:
            return calling self.parse_array
        if b == JSON_QUOTE:
            return calling self.parse_string
        if b == 116:
            return calling self.parse_literal with "true", (calling JsonValue.bool_val with true)
        if b == 102:
            return calling self.parse_literal with "false", (calling JsonValue.bool_val with false)
        if b == 110:
            return calling self.parse_literal with "null", (calling JsonValue.null_value)
        if self->opts.allow_non_standard and b == 78:
            if calling self.starts_with_word with "NaN":
                calling self.consume_word with "NaN"
                var nan as f64 is 0.0 / 0.0
                return calling JsonValue.float_val with nan
            calling self.fail with JsonErrorKind.InvalidLiteral, "expected 'NaN'"
            return calling JsonValue.null_value
        if self->opts.allow_non_standard and b == 73:
            if calling self.starts_with_word with "Infinity":
                calling self.consume_word with "Infinity"
                var inf as f64 is 1.0 / 0.0
                return calling JsonValue.float_val with inf
            calling self.fail with JsonErrorKind.InvalidLiteral, "expected 'Infinity'"
            return calling JsonValue.null_value
        if b == 45:
            if self->opts.allow_non_standard and ((calling self.peek_at with 1) == 73):
                calling self.advance
                if calling self.starts_with_word with "Infinity":
                    calling self.consume_word with "Infinity"
                    var ninf as f64 is (0.0 - 1.0) / 0.0
                    return calling JsonValue.float_val with ninf
                calling self.fail with JsonErrorKind.InvalidLiteral, "expected '-Infinity'"
                return calling JsonValue.null_value
            return calling self.parse_number
        if b >= 48 and b <= 57:
            return calling self.parse_number
        if b >= 32 and b <= 126:
            var ch as string is chr b
            var msg as string is "unexpected character '{ch}'"
            banish ch
            calling self.fail with JsonErrorKind.UnexpectedChar, msg
            return calling JsonValue.null_value
        calling self.fail with JsonErrorKind.UnexpectedChar, "unexpected non-printable byte"
        return calling JsonValue.null_value

    ## Parses `word` and returns `v`, or records `InvalidLiteral`.
    weave parse_literal with word as string, v as JsonValue into JsonValue:
        if not calling self.starts_with_word with word:
            var msg as string is "expected literal '{word}'"
            calling self.fail with JsonErrorKind.InvalidLiteral, msg
            banish v
            return calling JsonValue.null_value
        calling self.consume_word with word
        return v

    ## Parses an RFC 8259 number.
    ##
    ## Integers that do not fit `i64` are `IntegerOverflow`; numbers with a
    ## fraction or exponent are `Float`.
    weave parse_number into JsonValue:
        var start as int is self->pos
        var b as int is calling self.peek
        if b == 45:
            calling self.advance
            set b is calling self.peek
        if b < 48 or b > 57:
            calling self.fail with JsonErrorKind.InvalidNumber, "expected a digit after '-'"
            return calling JsonValue.null_value
        if b == 48:
            calling self.advance
            set b is calling self.peek
            if b >= 48 and b <= 57:
                calling self.fail with JsonErrorKind.InvalidNumber, "leading zeros are not allowed"
                return calling JsonValue.null_value
        else:
            var scanning as bool is true
            while scanning:
                set b is calling self.peek
                if b >= 48 and b <= 57:
                    calling self.advance
                else:
                    set scanning is false
        var is_float as bool is false
        set b is calling self.peek
        if b == 46:
            set is_float is true
            calling self.advance
            set b is calling self.peek
            if b < 48 or b > 57:
                calling self.fail with JsonErrorKind.InvalidNumber, "expected a digit after '.'"
                return calling JsonValue.null_value
            var frac as bool is true
            while frac:
                set b is calling self.peek
                if b >= 48 and b <= 57:
                    calling self.advance
                else:
                    set frac is false
        set b is calling self.peek
        if b == 101 or b == 69:
            set is_float is true
            calling self.advance
            set b is calling self.peek
            if b == 43 or b == 45:
                calling self.advance
            set b is calling self.peek
            if b < 48 or b > 57:
                calling self.fail with JsonErrorKind.InvalidNumber, "expected a digit in the exponent"
                return calling JsonValue.null_value
            var exp_scan as bool is true
            while exp_scan:
                set b is calling self.peek
                if b >= 48 and b <= 57:
                    calling self.advance
                else:
                    set exp_scan is false
        var end as int is self->pos
        if is_float:
            var fv as f64 is 0.0
            if not calling _json_strtod with self->src, start, end, sigil of fv:
                calling self.fail with JsonErrorKind.InvalidNumber, "floating-point number is out of range"
                return calling JsonValue.null_value
            return calling JsonValue.float_val with fv
        var iv as i64 is 0
        if not calling _json_strtoll with self->src, start, end, sigil of iv:
            calling self.fail with JsonErrorKind.IntegerOverflow, "integer literal does not fit in i64"
            return calling JsonValue.null_value
        return calling JsonValue.int_val with iv

    ## Parses a quoted string with RFC 8259 escapes.
    ##
    ## ## Retorno
    ## `JsonValue.Str`, or `JsonValue.Null` with `failed` set.
    weave parse_string into JsonValue:
        calling self.advance
        var sb as StringBuilder is calling StringBuilder.new
        defer banish sb
        var done as bool is false
        while not done:
            var b as int is calling self.peek
            if b < 0:
                calling self.fail with JsonErrorKind.UnexpectedEof, "unterminated string"
                return calling JsonValue.null_value
            if b == JSON_QUOTE:
                calling self.advance
                set done is true
            else if b == JSON_BACKSLASH:
                calling self.advance
                var e as int is calling self.advance
                if e < 0:
                    calling self.fail with JsonErrorKind.UnexpectedEof, "unterminated escape sequence"
                    return calling JsonValue.null_value
                if e == JSON_QUOTE:
                    calling sb.append_char with '"'
                else if e == JSON_BACKSLASH:
                    calling sb.append_char with '\\'
                else if e == JSON_SLASH:
                    calling sb.append_char with '/'
                else if e == 98:
                    calling sb.append_char with (8 to char)
                else if e == 102:
                    calling sb.append_char with (12 to char)
                else if e == 110:
                    calling sb.append_char with (10 to char)
                else if e == 114:
                    calling sb.append_char with (13 to char)
                else if e == 116:
                    calling sb.append_char with (9 to char)
                else if e == 117:
                    var cp as int is calling self.parse_unicode_escape
                    if self->failed:
                        return calling JsonValue.null_value
                    if self->build:
                        calling _append_codepoint with sigil of sb, cp
                else:
                    var msg as string is "invalid escape '\\{e}'"
                    calling self.fail with JsonErrorKind.InvalidEscape, msg
                    return calling JsonValue.null_value
            else:
                if b < 32:
                    if self->opts.strict:
                        calling self.fail with JsonErrorKind.InvalidString, "unescaped control character in string"
                        return calling JsonValue.null_value
                calling self.advance
                if self->build:
                    calling sb.append_char with (b to char)
        if not self->build:
            return calling JsonValue.null_value
        var text as string is calling sb.finish
        return calling JsonValue.string_val with text

    ## Parses the four hex digits of a `\u` escape, combining surrogate pairs.
    ##
    ## The leading `\u` must already be consumed.
    ##
    ## ## Retorno
    ## The Unicode scalar value, or `-1` with `failed` set.
    weave parse_unicode_escape into int:
        var high as int is calling self.parse_hex4
        if self->failed:
            return -1
        if high >= 55296 and high <= 56319:
            if (calling self.peek) != JSON_BACKSLASH or (calling self.peek_at with 1) != 117:
                calling self.fail with JsonErrorKind.InvalidUnicode, "unpaired high surrogate"
                return -1
            calling self.advance
            calling self.advance
            var low as int is calling self.parse_hex4
            if self->failed:
                return -1
            if low < 56320 or low > 57343:
                calling self.fail with JsonErrorKind.InvalidUnicode, "high surrogate not followed by a low surrogate"
                return -1
            return 65536 + ((high - 55296) << 10) + (low - 56320)
        if high >= 56320 and high <= 57343:
            calling self.fail with JsonErrorKind.InvalidUnicode, "unpaired low surrogate"
            return -1
        return high

    ## Parses exactly four hexadecimal digits.
    ##
    ## ## Retorno
    ## `0..65535`, or `-1` with `failed` set.
    weave parse_hex4 into int:
        var value as int is 0
        var i as int is 0
        while i < 4:
            var b as int is calling self.advance
            if b < 0:
                calling self.fail with JsonErrorKind.UnexpectedEof, "truncated Unicode escape"
                return -1
            var h as int is calling _hex_val with b
            if h < 0:
                calling self.fail with JsonErrorKind.InvalidUnicode, "invalid hexadecimal digit in Unicode escape"
                return -1
            set value is value * 16 + h
            set i is i + 1
        return value

    ## Parses an array.
    ##
    ## ## Retorno
    ## `JsonValue.Arr`, or `JsonValue.Null` with `failed` set.
    weave parse_array into JsonValue:
        var items as list of JsonValue is list of JsonValue
        calling self.advance
        set self->depth is self->depth + 1
        if self->depth > self->opts.max_depth:
            set self->depth is self->depth - 1
            calling self.fail with JsonErrorKind.DepthExceeded, "maximum nesting depth exceeded"
            return calling JsonValue.null_value
        calling self.skip_whitespace
        if self->failed:
            set self->depth is self->depth - 1
            return calling JsonValue.null_value
        if (calling self.peek) == 93:
            calling self.advance
            set self->depth is self->depth - 1
            return with Arr is items
        var more as bool is true
        while more:
            var item as JsonValue is calling self.parse_value
            if self->failed:
                calling free_values with items
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
            if self->build:
                calling items.push with item
            else:
                banish item
            calling self.skip_whitespace
            if self->failed:
                calling free_values with items
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
            var b as int is calling self.peek
            if b == 44:
                calling self.advance
                calling self.skip_whitespace
                if self->failed:
                    calling free_values with items
                    set self->depth is self->depth - 1
                    return calling JsonValue.null_value
                if (calling self.peek) == 93:
                    if self->opts.allow_trailing_commas:
                        calling self.advance
                        set more is false
                    else:
                        calling self.fail with JsonErrorKind.UnexpectedChar, "trailing comma is not allowed"
                        calling free_values with items
                        set self->depth is self->depth - 1
                        return calling JsonValue.null_value
            else if b == 93:
                calling self.advance
                set more is false
            else:
                calling self.fail with JsonErrorKind.UnexpectedChar, "expected ',' or ']' in array"
                calling free_values with items
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
        set self->depth is self->depth - 1
        return with Arr is items

    ## Parses an object.
    ##
    ## ## Retorno
    ## `JsonValue.Obj`, or `JsonValue.Null` with `failed` set.
    weave parse_object into JsonValue:
        var entries as list of JsonEntry is list of JsonEntry
        calling self.advance
        set self->depth is self->depth + 1
        if self->depth > self->opts.max_depth:
            set self->depth is self->depth - 1
            calling self.fail with JsonErrorKind.DepthExceeded, "maximum nesting depth exceeded"
            return calling JsonValue.null_value
        calling self.skip_whitespace
        if self->failed:
            set self->depth is self->depth - 1
            return calling JsonValue.null_value
        if (calling self.peek) == 125:
            calling self.advance
            set self->depth is self->depth - 1
            return with Obj is entries
        var more as bool is true
        while more:
            if (calling self.peek) != JSON_QUOTE:
                calling self.fail with JsonErrorKind.UnexpectedChar, "expected a quoted object key"
                calling free_entries with entries
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
            var keyv as JsonValue is calling self.parse_string
            if self->failed:
                calling free_entries with entries
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
            var key as string is ""
            var key_extract as int is judge keyv:
                when Str with value ->
                    set key is value
                    0
                else ->
                    0
            calling self.skip_whitespace
            if self->failed:
                banish key
                calling free_entries with entries
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
            if (calling self.peek) != 58:
                banish key
                calling self.fail with JsonErrorKind.UnexpectedChar, "expected ':' after object key"
                calling free_entries with entries
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
            calling self.advance
            var value as JsonValue is calling self.parse_value
            if self->failed:
                banish key
                calling free_entries with entries
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
            if self->build:
                calling _json_obj_put with (sigil of entries), key, value
            else:
                banish key
                banish value
            calling self.skip_whitespace
            if self->failed:
                calling free_entries with entries
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
            var b as int is calling self.peek
            if b == 44:
                calling self.advance
                calling self.skip_whitespace
                if self->failed:
                    calling free_entries with entries
                    set self->depth is self->depth - 1
                    return calling JsonValue.null_value
                if (calling self.peek) == 125:
                    if self->opts.allow_trailing_commas:
                        calling self.advance
                        set more is false
                    else:
                        calling self.fail with JsonErrorKind.UnexpectedChar, "trailing comma is not allowed"
                        calling free_entries with entries
                        set self->depth is self->depth - 1
                        return calling JsonValue.null_value
            else if b == 125:
                calling self.advance
                set more is false
            else:
                calling self.fail with JsonErrorKind.UnexpectedChar, "expected ',' or '}' in object"
                calling free_entries with entries
                set self->depth is self->depth - 1
                return calling JsonValue.null_value
        set self->depth is self->depth - 1
        return with Obj is entries

# ----------------------------------------------------------------------------
# Public parsing entry points
# ----------------------------------------------------------------------------

## Parses `s` with the strict RFC 8259 defaults.
##
## ## Parámetros
## - `s`: the JSON text. Borrowed; the returned DOM owns its own buffers.
##
## ## Retorno
## `ok value`, or `err JsonError` with line, column and byte offset.
##
## ## Ejemplo
## ```pengu
## var r as result of JsonValue to JsonError is calling json.parse with "[1,2]"
## ```
weave parse with s as string into result of JsonValue to JsonError:
    return calling parse_with with s, (calling default_parse_options)

## Parses `s` with explicit options.
##
## ## Parámetros
## - `s`: the JSON text. Borrowed.
## - `opts`: parser knobs.
##
## ## Retorno
## `ok value`, or `err JsonError`.
##
## ## Ejemplo
## ```pengu
## var o as json.ParseOptions is calling json.default_parse_options
## var r as result of JsonValue to json.JsonError is calling json.parse_with with "// x\n{}", o
## ```
weave parse_with with s as string, opts as ParseOptions into result of JsonValue to JsonError:
    var bad as int is calling _json_valid_utf8 with s
    if bad >= 0:
        var eline as int is 1
        var ecol as int is 1
        calling _line_col_at with s, bad, sigil of eline, sigil of ecol
        var emsg as string is "invalid UTF-8 at byte {bad}"
        var utf_err as JsonError is with kind is JsonErrorKind.InvalidUtf8, message is emsg, line is eline, col is ecol, offset is bad
        return calling err_of with utf_err
    var p as Parser is with src is s, pos is 0, line is 1, col is 1, depth is 0, opts is opts, build is true, failed is false, err_kind is JsonErrorKind.UnexpectedEof, err_message is "", err_line is 1, err_col is 1, err_offset is 0
    var v as JsonValue is calling p.parse_document
    if p.failed:
        var e as JsonError is calling p.take_error
        banish v
        return calling err_of with e
    return calling ok_of with v

## Parses a byte slice as JSON.
##
## ## Parámetros
## - `s`: the bytes. Borrowed; the parser takes one private copy internally.
##
## ## Retorno
## `ok value`, or `err JsonError`.
weave parse_bytes with s as slice of byte into result of JsonValue to JsonError:
    var owned as string is calling _json_bytes_to_string with s
    var r as result of JsonValue to JsonError is calling parse_with with owned, (calling default_parse_options)
    banish owned
    return r

## Checks that `s` is one valid JSON document, without building a DOM.
##
## Memory use is O(depth), independent of the document size.
##
## ## Parámetros
## - `s`: the JSON text. Borrowed.
##
## ## Retorno
## `ok 0`, or `err JsonError`.
##
## ## Ejemplo
## ```pengu
## var ok as bool is calling json.validate with "{\"a\":1}" is_ok
## ```
weave validate with s as string into result of void to JsonError:
    var bad as int is calling _json_valid_utf8 with s
    if bad >= 0:
        var eline as int is 1
        var ecol as int is 1
        calling _line_col_at with s, bad, sigil of eline, sigil of ecol
        var emsg as string is "invalid UTF-8 at byte {bad}"
        var utf_err as JsonError is with kind is JsonErrorKind.InvalidUtf8, message is emsg, line is eline, col is ecol, offset is bad
        return calling err_of with utf_err
    var p as Parser is with src is s, pos is 0, line is 1, col is 1, depth is 0, opts is (calling default_parse_options), build is false, failed is false, err_kind is JsonErrorKind.UnexpectedEof, err_message is "", err_line is 1, err_col is 1, err_offset is 0
    var v as JsonValue is calling p.parse_document
    if p.failed:
        var e as JsonError is calling p.take_error
        return calling err_of with e
    banish v
    return calling ok_of with 0

## Checks that a byte slice is one valid JSON document.
##
## ## Parámetros
## - `s`: the bytes. Borrowed.
##
## ## Retorno
## `ok 0`, or `err JsonError`.
weave validate_bytes with s as slice of byte into result of void to JsonError:
    var owned as string is calling _json_bytes_to_string with s
    var r as result of void to JsonError is calling validate with owned
    banish owned
    return r

# ----------------------------------------------------------------------------
# Arena mode
# ----------------------------------------------------------------------------

## Releases the box of a `result of JsonValue to JsonError` without its value.
##
## ## Parámetros
## - `r`: the result. The box is consumed; the payload must already have been
##   moved out or released.
##
## ## Memoria
## Frees the box slot only.
##
## ## Ejemplo
## ```pengu
## var v as JsonValue is r.value
## calling json.discard_result_box with (sigil of r)
## ```
weave discard_result_box with r as ref to result of JsonValue to JsonError into void:
    calling _json_drop_result_box with r

## Copies a heap DOM into arena memory.
##
## Strings become non-owning views over arena blocks and list headers are
## marked `cap < 0` (non-owning). The result is therefore released by
## `banish arena`, while banishing any value inside it is a safe no-op.
##
## ## Parámetros
## - `v`: the heap value to copy. Borrowed; it is not modified.
## - `a`: destination arena. Mutated.
##
## ## Retorno
## The arena-backed equivalent of `v`.
##
## ## Memoria
## Allocates every string byte, list element and entry in `a`.
weave _json_to_arena with v as JsonValue, a as ref to arena.Arena into JsonValue:
    var out as JsonValue is calling JsonValue.null_value
    var ignored as int is judge v:
        when Null ->
            0
        when Bool with value ->
            set out is calling JsonValue.bool_val with value
            0
        when Int with value ->
            set out is calling JsonValue.int_val with value
            0
        when Float with value ->
            set out is calling JsonValue.float_val with value
            0
        when Str with value ->
            var n as int is value length
            var p as ref to byte is calling a.alloc_str with value
            var sview as string is calling _json_arena_string with p, n
            set out is calling JsonValue.string_val with sview
            0
        when Arr with items ->
            var count as int is items.len
            var dst as ref to JsonValue is calling arena.arena_alloc of JsonValue with a, count
            var i as int is 0
            while i < count:
                let src is items at i
                set dst at i is calling _json_to_arena with src, a
                set i is i + 1
            var lst as list of JsonValue is calling _json_arena_list with dst, count
            set out is with Arr is lst
            0
        when Obj with entries ->
            var ecount as int is entries.len
            var edst as ref to JsonEntry is calling arena.arena_alloc of JsonEntry with a, ecount
            var j as int is 0
            while j < ecount:
                let e is entries at j
                var kn as int is e.key length
                var kp as ref to byte is calling a.alloc_str with e.key
                var kview as string is calling _json_arena_string with kp, kn
                var av as JsonValue is calling _json_to_arena with e.value, a
                set edst at j is with key is kview, value is av
                set j is j + 1
            var elst as list of JsonEntry is calling _json_arena_entries with edst, ecount
            set out is with Obj is elst
            0
    return out

## Parses `s` into an arena-backed DOM.
##
## Every string byte, array element and object entry lives in `arena`. A single
## `banish arena` (or `calling arena.free`) releases the whole document, and
## banishing the returned value is a safe no-op. The implementation parses into
## a temporary heap DOM and copies it into the arena, so the transient cost is
## O(size); the retained cost is entirely in the arena.
##
## ## Parámetros
## - `s`: the JSON text. Borrowed.
## - `arena`: destination arena. Mutated.
##
## ## Retorno
## `ok value` (arena-backed), or `err JsonError`.
##
## ## Ejemplo
## ```pengu
## var a as Arena is calling Arena.new
## defer calling a.free
## var v as JsonValue is (calling json.parse_in_arena with payload, sigil of a) or:
##     return 1
## banish v          # safe no-op; the arena owns the memory
## ```
weave parse_in_arena with s as string, arena as ref to arena.Arena into result of JsonValue to JsonError:
    var r as result of JsonValue to JsonError is calling parse with s
    if not r.is_ok:
        return r
    var heap as JsonValue is r.value
    var arena_value as JsonValue is calling _json_to_arena with heap, arena
    banish heap
    calling _json_drop_result_box with (sigil of r)
    return calling ok_of with arena_value

# ----------------------------------------------------------------------------
# Serializer
# ----------------------------------------------------------------------------

## Returns the UTF-8 length of the codepoint starting at byte `i`.
##
## ## Parámetros
## - `s`: a valid UTF-8 string (the parser guarantees this for its own output).
## - `i`: the offset of a lead byte.
##
## ## Retorno
## `1..4`; `1` for a stray continuation/invalid byte (treated as U+FFFD).
weave _utf8_len with s as string, i as int into int:
    var raw as ref to frozen byte is bytes of s
    var b as int is (raw at i) to int
    if b < 128:
        return 1
    if (b & 224) == 192:
        return 2
    if (b & 240) == 224:
        return 3
    if (b & 248) == 240:
        return 4
    return 1

## Decodes one UTF-8 codepoint at byte `i`.
##
## ## Parámetros
## - `s`: the text. Borrowed.
## - `i`: offset of the lead byte.
##
## ## Retorno
## The scalar value, or `65533` (U+FFFD) for a malformed sequence.
weave _utf8_cp with s as string, i as int into int:
    var n as int is s length
    var raw as ref to frozen byte is bytes of s
    var b as int is (raw at i) to int
    var len as int is calling _utf8_len with s, i
    if len == 1:
        if b < 128:
            return b
        return 65533
    if i + len > n:
        return 65533
    var cp as int is 0
    if len == 2:
        set cp is b & 31
    else if len == 3:
        set cp is b & 15
    else:
        set cp is b & 7
    var k as int is 1
    while k < len:
        var cc as int is (raw at (i + k)) to int
        if (cc & 192) != 128:
            return 65533
        set cp is (cp << 6) | (cc & 63)
        set k is k + 1
    return cp

## Writes a JSON string literal, including its surrounding quotes.
##
## ## Parámetros
## - `s`: the decoded text. Borrowed.
## - `opts`: serializer options.
## - `sb`: destination builder. Mutated.
##
## ## Memoria
## Appends only; no temporary string is allocated.
weave _write_string with s as string, opts as SerializeOptions, sb as ref to StringBuilder into void:
    calling sb.append_char with '"'
    var n as int is s length
    var raw as ref to frozen byte is bytes of s
    var i as int is 0
    while i < n:
        var b as int is (raw at i) to int
        if b == 34:
            calling sb.append with "\\\""
            set i is i + 1
        else if b == 92:
            calling sb.append with "\\\\"
            set i is i + 1
        else if b == 47 and opts.escape_slash:
            calling sb.append with "\\/"
            set i is i + 1
        else if b == 8:
            calling sb.append with "\\b"
            set i is i + 1
        else if b == 12:
            calling sb.append with "\\f"
            set i is i + 1
        else if b == 10:
            calling sb.append with "\\n"
            set i is i + 1
        else if b == 13:
            calling sb.append with "\\r"
            set i is i + 1
        else if b == 9:
            calling sb.append with "\\t"
            set i is i + 1
        else if b < 32:
            calling _append_u4 with sb, b
            set i is i + 1
        else if b < 128:
            calling sb.append_char with (b to char)
            set i is i + 1
        else:
            if not opts.ensure_ascii:
                calling sb.append_char with (b to char)
                set i is i + 1
            else:
                var cp as int is calling _utf8_cp with s, i
                var step as int is calling _utf8_len with s, i
                if cp > 65535:
                    var high as int is 55296 + ((cp - 65536) >> 10)
                    var low as int is 56320 + ((cp - 65536) & 1023)
                    calling _append_u4 with sb, high
                    calling _append_u4 with sb, low
                else:
                    calling _append_u4 with sb, cp
                set i is i + step
    calling sb.append_char with '"'

## Writes one float, rejecting non-finite values unless `allow_nan`.
##
## ## Parámetros
## - `f`: the value.
## - `opts`: serializer options.
## - `sb`: destination builder. Mutated.
weave _write_float with f as f64, opts as SerializeOptions, sb as ref to StringBuilder into void:
    if not calling _json_is_finite with f:
        if not opts.allow_nan:
            calling spark.panic with "json.stringify: non-finite float (set allow_nan to emit it)"
        if f != f:
            calling sb.append with "NaN"
        else if f > 0.0:
            calling sb.append with "Infinity"
        else:
            calling sb.append with "-Infinity"
        return
    var text as string is calling _json_format_f64 with f
    calling sb.append with text
    banish text

## Writes `indent * depth` spaces, preceded by a newline.
##
## ## Parámetros
## - `sb`: destination builder. Mutated.
## - `depth`: nesting level (`0` is the top level).
## - `opts`: serializer options.
weave _write_newline_indent with sb as ref to StringBuilder, depth as int, opts as SerializeOptions into void:
    calling sb.append_char with (10 to char)
    calling sb.append_spaces with (opts.indent * depth)

## Appends the currently active pair separator.
##
## ## Parámetros
## - `sb`: destination builder. Mutated.
## - `opts`: serializer options.
weave _write_comma with sb as ref to StringBuilder, opts as SerializeOptions into void:
    calling sb.append_char with ','
    if opts.indent == 0 and not opts.compact_separators:
        calling sb.append_char with ' '

## Appends the currently active key/value separator.
##
## ## Parámetros
## - `sb`: destination builder. Mutated.
## - `opts`: serializer options.
weave _write_colon with sb as ref to StringBuilder, opts as SerializeOptions into void:
    calling sb.append_char with ':'
    if opts.indent > 0 or not opts.compact_separators:
        calling sb.append_char with ' '

## Sorts a shallow copy of an object's entries by key.
##
## The copy aliases the entries' payloads; only the returned list buffer is
## owned. Release it with `banish sorted` (never `free_entries`).
##
## ## Parámetros
## - `entries`: the entry list. Borrowed.
##
## ## Retorno
## A new `list of JsonEntry` in byte-wise key order.
weave _sorted_entries with entries as list of JsonEntry into list of JsonEntry:
    var out as list of JsonEntry is list of JsonEntry with capacity entries.len
    for e in entries:
        calling out.push with e
    var i as int is 1
    while i < out.len:
        var key as JsonEntry is out at i
        var j as int is i - 1
        var moving as bool is true
        while j >= 0 and moving:
            var prev as JsonEntry is out at j
            if (calling _json_str_cmp with prev.key, key.key) > 0:
                set out at (j + 1) is prev
                set j is j - 1
            else:
                set moving is false
        set out at (j + 1) is key
        set i is i + 1
    return out

## Writes `v` into `sb` using `opts`.
##
## This is the primitive every other serializer entry point uses.
##
## ## Parámetros
## - `v`: the value. Borrowed.
## - `opts`: serializer options.
## - `sb`: destination builder. Mutated.
##
## ## Efectos
## Panics on a non-finite float unless `opts.allow_nan` is set.
weave _write_value with v as JsonValue, opts as SerializeOptions, sb as ref to builder.StringBuilder, depth as int into void:
    var ignored as int is judge v:
        when Null ->
            calling sb.append with "null"
            0
        when Bool with value ->
            if value:
                calling sb.append with "true"
            else:
                calling sb.append with "false"
            0
        when Int with value ->
            calling sb.append_i64 with value
            0
        when Float with value ->
            calling _write_float with value, opts, sb
            0
        when Str with value ->
            calling _write_string with value, opts, sb
            0
        when Arr with items ->
            if items.len == 0:
                calling sb.append with "[]"
            else:
                calling sb.append_char with '['
                var idx as int is 0
                while idx < items.len:
                    if idx > 0:
                        calling _write_comma with sb, opts
                    if opts.indent > 0:
                        calling _write_newline_indent with sb, depth + 1, opts
                    let item is items at idx
                    calling _write_value with item, opts, sb, depth + 1
                    set idx is idx + 1
                if opts.indent > 0:
                    calling _write_newline_indent with sb, depth, opts
                calling sb.append_char with ']'
            0
        when Obj with entries ->
            if entries.len == 0:
                calling sb.append with r"{}"
            else:
                var source as list of JsonEntry is entries
                var sorted as list of JsonEntry is list of JsonEntry
                if opts.sort_keys:
                    set sorted is calling _sorted_entries with entries
                    set source is sorted
                calling sb.append_char with '{'
                var k as int is 0
                while k < source.len:
                    if k > 0:
                        calling _write_comma with sb, opts
                    if opts.indent > 0:
                        calling _write_newline_indent with sb, depth + 1, opts
                    let e is source at k
                    calling _write_string with e.key, opts, sb
                    calling _write_colon with sb, opts
                    calling _write_value with e.value, opts, sb, depth + 1
                    set k is k + 1
                if opts.indent > 0:
                    calling _write_newline_indent with sb, depth, opts
                calling sb.append_char with '}'
                # `sorted` is either the sorted copy or the empty list created
                # above; both own a buffer, so release it unconditionally.
                banish sorted
            0

## Writes `v` into `sb` using `opts`.
##
## This is the primitive every other serializer entry point uses. A `builder`
## accumulates the output, so serializing a large tree is O(size) rather than
## O(size²).
##
## ## Parámetros
## - `v`: the value. Borrowed.
## - `opts`: serializer options.
## - `sb`: destination builder. Mutated.
##
## ## Efectos
## Panics on a non-finite float unless `opts.allow_nan` is set.
##
## ## Ejemplo
## ```pengu
## var sb as StringBuilder is calling StringBuilder.new
## calling json.write_to_builder with v, (calling json.default_serialize_options), (sigil of sb)
## var s as string is calling sb.finish
## ```
weave write_to_builder with v as JsonValue, opts as SerializeOptions, sb as ref to builder.StringBuilder into void:
    calling _write_value with v, opts, sb, 0

## Serializes `v` with explicit options.
##
## ## Parámetros
## - `v`: the value. Borrowed.
## - `opts`: serializer options.
##
## ## Retorno
## An owned JSON string; release it with `banish`.
##
## ## Efectos
## Panics on a non-finite float unless `opts.allow_nan` is set.
##
## ## Ejemplo
## ```pengu
## var o as json.SerializeOptions is calling json.default_serialize_options
## var s as string is calling json.stringify_with with v, o
## ```
weave stringify_with with v as JsonValue, opts as SerializeOptions into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling write_to_builder with v, opts, sigil of sb
    if opts.trailing_newline:
        calling sb.append_char with (10 to char)
    return calling sb.finish

## Serializes `v` as compact JSON with the default options.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## An owned JSON string; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## var s as string is calling json.stringify with v    # {"a":1,"b":[2,3]}
## ```
weave stringify with v as JsonValue into string:
    return calling stringify_with with v, (calling default_serialize_options)

## Serializes `v` with `indent` spaces per nesting level.
##
## ## Parámetros
## - `v`: the value. Borrowed.
## - `indent`: spaces per level (`0` is compact).
##
## ## Retorno
## An owned pretty JSON string; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## var s as string is calling json.stringify_pretty with v, 2
## ```
weave stringify_pretty with v as JsonValue, indent as int into string:
    var opts as SerializeOptions is calling default_serialize_options
    set opts.indent is indent
    set opts.compact_separators is false
    return calling stringify_with with v, opts

## True when the tree contains a `NaN` or an infinity.
##
## ## Parámetros
## - `v`: the value to scan. Borrowed.
##
## ## Retorno
## `true` when any float is non-finite.
weave _has_non_finite with v as JsonValue into bool:
    var found as bool is false
    var ignored as int is judge v:
        when Float with value ->
            if not calling _json_is_finite with value:
                set found is true
            0
        when Arr with items ->
            for item in items:
                if calling _has_non_finite with item:
                    set found is true
            0
        when Obj with entries ->
            for e in entries:
                if calling _has_non_finite with e.value:
                    set found is true
            0
        else ->
            0
    return found

## Serializes `v`, returning an error instead of panicking on a non-finite float.
##
## ## Parámetros
## - `v`: the value. Borrowed.
## - `opts`: serializer options. `allow_nan` still opts in to emitting them.
##
## ## Retorno
## `ok string` (owned) or `err JsonError` with `InvalidNumber`.
weave try_stringify with v as JsonValue, opts as SerializeOptions into result of string to JsonError:
    if not opts.allow_nan and calling _has_non_finite with v:
        var msg as string is "non-finite float cannot be serialized as JSON"
        var e as JsonError is with kind is JsonErrorKind.InvalidNumber, message is msg, line is 0, col is 0, offset is 0
        return calling err_of with e
    var text as string is calling stringify_with with v, opts
    return calling ok_of with text

# ----------------------------------------------------------------------------
# Deep merge
# ----------------------------------------------------------------------------

## Recursively merges `overlay` into `base`, returning a new value.
##
## Object members merge recursively when both sides are objects; otherwise the
## overlay value wins. The inputs are never modified.
##
## ## Parámetros
## - `base`: the starting value. Borrowed.
## - `overlay`: the value applied on top. Borrowed.
##
## ## Retorno
## A new tree. Release it with `banish`.
##
## ## Ejemplo
## ```pengu
## var merged as JsonValue is calling json.deep_merge with defaults, user_config
## defer banish merged
## ```
weave deep_merge with base as JsonValue, overlay as JsonValue into JsonValue:
    var out as JsonValue is calling base.clone
    if not calling base.is_object or not calling overlay.is_object:
        banish out
        return calling overlay.clone
    var ignored as int is judge overlay:
        when Obj with entries ->
            for e in entries:
                var existing as maybe JsonValue is calling out.get with e.key
                if existing.is_present:
                    var oldv as JsonValue is existing.value
                    calling _json_drop_maybe with (sigil of existing)
                    let ev is e.value
                    if calling oldv.is_object and calling ev.is_object:
                        var merged as JsonValue is calling deep_merge with oldv, ev
                        calling out.put_json with e.key, merged
                    else:
                        calling out.put_json with e.key, (calling _json_clone_value with ev)
                    banish oldv
                else:
                    calling _json_drop_maybe with (sigil of existing)
                    calling out.put_json with e.key, (calling _json_clone_value with e.value)
            0
        else ->
            0
    return out

# ----------------------------------------------------------------------------
# JSON Schema subset
# ----------------------------------------------------------------------------

## True when `v` matches one JSON Schema `type` name.
##
## ## Parámetros
## - `v`: the value. Borrowed.
## - `name`: `null`, `boolean`, `object`, `array`, `string`, `number` or
##   `integer`.
##
## ## Retorno
## `true` for a match; `false` for a mismatch or an unknown name.
weave _schema_type_matches with v as JsonValue, name as string into bool:
    if name == "null":
        return calling v.is_null
    if name == "boolean":
        return calling v.is_bool
    if name == "object":
        return calling v.is_object
    if name == "array":
        return calling v.is_array
    if name == "string":
        return calling v.is_string
    if name == "number":
        return calling v.is_number
    if name == "integer":
        return calling v.is_int
    return false

## Pushes one schema error, formatting the path and detail.
##
## ## Parámetros
## - `out`: accumulator. Mutated.
## - `path`: JSON-path-style location.
## - `detail`: the problem.
##
## ## Retorno
## The same accumulator, with one owned string appended.
weave _schema_push with out as list of string, path as string, detail as string into list of string:
    var acc as list of string is out
    var msg as string is "{path}: {detail}"
    calling acc.push with msg
    return acc

## Validates one value against one schema node, appending errors.
##
## ## Parámetros
## - `v`: the value. Borrowed.
## - `schema`: the schema node. Borrowed.
## - `path`: JSON-path-style location used in messages.
## - `out`: accumulator.
##
## ## Retorno
## The accumulator, with zero or more owned messages appended.
weave _schema_check with v as JsonValue, schema as JsonValue, path as string, out as list of string into list of string:
    var acc as list of string is out
    if not calling schema.is_object:
        return acc

    # type
    var ok as bool is false
    var tv as maybe JsonValue is calling schema.get with "type"
    if tv.is_present:
        var typev as JsonValue is tv.value
        if calling typev.is_string:
            var tn as maybe string is calling typev.as_string
            if tn.is_present:
                set ok is calling _schema_type_matches with v, tn.value
            banish tn
        else if calling typev.is_array:
            var items as maybe list of JsonValue is calling typev.as_array
            if items.is_present:
                for t in items.value:
                    if calling t.is_string:
                        var tn2 as maybe string is calling t.as_string
                        if tn2.is_present and calling _schema_type_matches with v, tn2.value:
                            set ok is true
                        banish tn2
                calling free_values with items.value
            calling _json_drop_maybe_values with (sigil of items)
        banish typev
    calling _json_drop_maybe with (sigil of tv)
    if tv.is_present and not ok:
        set acc is calling _schema_push with acc, path, "type mismatch"

    # const
    var cv as maybe JsonValue is calling schema.get with "const"
    if cv.is_present:
        var cval as JsonValue is cv.value
        if not calling v.equals with cval:
            set acc is calling _schema_push with acc, path, "must equal the const value"
        banish cval
    calling _json_drop_maybe with (sigil of cv)

    # enum
    var ev as maybe JsonValue is calling schema.get with "enum"
    if ev.is_present:
        var evalue as JsonValue is ev.value
        if calling evalue.is_array:
            var members as maybe list of JsonValue is calling evalue.as_array
            var match as bool is false
            if members.is_present:
                for m in members.value:
                    if calling v.equals with m:
                        set match is true
                calling free_values with members.value
            calling _json_drop_maybe_values with (sigil of members)
            if not match:
                set acc is calling _schema_push with acc, path, "value is not in the enum"
        banish evalue
    calling _json_drop_maybe with (sigil of ev)

    # numeric bounds
    var minv as maybe JsonValue is calling schema.get with "minimum"
    if minv.is_present:
        var mv as JsonValue is minv.value
        var mnum as maybe f64 is calling mv.as_number
        var vnum as maybe f64 is calling v.as_number
        if mnum.is_present and vnum.is_present and vnum.value < mnum.value:
            set acc is calling _schema_push with acc, path, "number is below the minimum"
        banish mnum
        banish vnum
        banish mv
    calling _json_drop_maybe with (sigil of minv)
    var maxv as maybe JsonValue is calling schema.get with "maximum"
    if maxv.is_present:
        var xv as JsonValue is maxv.value
        var xnum as maybe f64 is calling xv.as_number
        var ynum as maybe f64 is calling v.as_number
        if xnum.is_present and ynum.is_present and ynum.value > xnum.value:
            set acc is calling _schema_push with acc, path, "number is above the maximum"
        banish xnum
        banish ynum
        banish xv
    calling _json_drop_maybe with (sigil of maxv)

    # string length (bytes) and array size
    var slv as maybe JsonValue is calling schema.get with "minLength"
    if slv.is_present and calling v.is_string:
        var lv as JsonValue is slv.value
        var lnum as maybe i64 is calling lv.as_int
        var sv as maybe string is calling v.as_string
        if lnum.is_present and sv.is_present and (sv.value length) < (lnum.value to int):
            set acc is calling _schema_push with acc, path, "string is shorter than minLength"
        banish lnum
        banish sv
        banish lv
    calling _json_drop_maybe with (sigil of slv)
    var xlv as maybe JsonValue is calling schema.get with "maxLength"
    if xlv.is_present and calling v.is_string:
        var lv2 as JsonValue is xlv.value
        var lnum2 as maybe i64 is calling lv2.as_int
        var sv2 as maybe string is calling v.as_string
        if lnum2.is_present and sv2.is_present and (sv2.value length) > (lnum2.value to int):
            set acc is calling _schema_push with acc, path, "string is longer than maxLength"
        banish lnum2
        banish sv2
        banish lv2
    calling _json_drop_maybe with (sigil of xlv)

    var miniv as maybe JsonValue is calling schema.get with "minItems"
    if miniv.is_present and calling v.is_array:
        var iv as JsonValue is miniv.value
        var inum as maybe i64 is calling iv.as_int
        if inum.is_present and calling v.array_len < (inum.value to int):
            set acc is calling _schema_push with acc, path, "array is shorter than minItems"
        banish inum
        banish iv
    calling _json_drop_maybe with (sigil of miniv)
    var maxiv as maybe JsonValue is calling schema.get with "maxItems"
    if maxiv.is_present and calling v.is_array:
        var iv2 as JsonValue is maxiv.value
        var inum2 as maybe i64 is calling iv2.as_int
        if inum2.is_present and calling v.array_len > (inum2.value to int):
            set acc is calling _schema_push with acc, path, "array is longer than maxItems"
        banish inum2
        banish iv2
    calling _json_drop_maybe with (sigil of maxiv)

    # required + properties + additionalProperties
    var props as maybe JsonValue is calling schema.get with "properties"
    var has_props as bool is props.is_present
    if has_props:
        var propv as JsonValue is props.value
        if calling propv.is_object and calling v.is_object:
            var preg as maybe JsonValue is calling schema.get with "required"
            if preg.is_present:
                var reqv as JsonValue is preg.value
                if calling reqv.is_array:
                    var reqs as maybe list of JsonValue is calling reqv.as_array
                    if reqs.is_present:
                        for r in reqs.value:
                            var rname as maybe string is calling r.as_string
                            if rname.is_present and not calling v.has_key with rname.value:
                                var detail as string is "missing required property '{rname.value}'"
                                set acc is calling _schema_push with acc, path, detail
                                banish detail
                            banish rname
                        calling free_values with reqs.value
                    calling _json_drop_maybe_values with (sigil of reqs)
                banish reqv
            calling _json_drop_maybe with (sigil of preg)
            var pents as maybe list of JsonEntry is calling propv.as_object
            if pents.is_present:
                for pe in pents.value:
                    var sub as maybe JsonValue is calling v.get with pe.key
                    if sub.is_present:
                        var subv as JsonValue is sub.value
                        var child_path as string is "{path}.{pe.key}"
                        set acc is calling _schema_check with subv, pe.value, child_path, acc
                        banish child_path
                        banish subv
                    calling _json_drop_maybe with (sigil of sub)
                calling free_entries with pents.value
            calling _json_drop_maybe_entries with (sigil of pents)
            var addv as maybe JsonValue is calling schema.get with "additionalProperties"
            if addv.is_present:
                var ap as JsonValue is addv.value
                if calling ap.is_bool:
                    var allow as maybe bool is calling ap.as_bool
                    if allow.is_present and not allow.value:
                        var names as list of string is calling propv.keys
                        var entries as maybe list of JsonEntry is calling v.as_object
                        if entries.is_present:
                            for ve in entries.value:
                                var known as bool is false
                                for kn in names:
                                    if kn == ve.key:
                                        set known is true
                                if not known:
                                    var detail2 as string is "unexpected property '{ve.key}'"
                                    set acc is calling _schema_push with acc, path, detail2
                                    banish detail2
                            calling free_entries with entries.value
                        calling _json_drop_maybe_entries with (sigil of entries)
                        calling free_strings with names
                    banish allow
                banish ap
            calling _json_drop_maybe with (sigil of addv)
        banish propv
    calling _json_drop_maybe with (sigil of props)

    # items
    var itemsv as maybe JsonValue is calling schema.get with "items"
    if itemsv.is_present and calling v.is_array:
        var item_schema as JsonValue is itemsv.value
        var elems as maybe list of JsonValue is calling v.as_array
        if elems.is_present:
            var idx as int is 0
            for el in elems.value:
                var child2 as string is "{path}[{idx}]"
                if calling item_schema.is_array:
                    var tuple as maybe list of JsonValue is calling item_schema.as_array
                    if tuple.is_present and idx < tuple.value.len:
                        set acc is calling _schema_check with el, (tuple.value at idx), child2, acc
                    calling _json_drop_maybe_values with (sigil of tuple)
                else:
                    set acc is calling _schema_check with el, item_schema, child2, acc
                banish child2
                set idx is idx + 1
            calling free_values with elems.value
        calling _json_drop_maybe_values with (sigil of elems)
        banish item_schema
    calling _json_drop_maybe with (sigil of itemsv)

    # allOf / anyOf / oneOf
    set acc is calling _schema_combinator with v, schema, "allOf", path, acc
    set acc is calling _schema_combinator with v, schema, "anyOf", path, acc
    set acc is calling _schema_combinator with v, schema, "oneOf", path, acc
    return acc

## Applies one `allOf`/`anyOf`/`oneOf` combinator, if present.
##
## ## Parámetros
## - `v`, `schema`, `keyword`, `path`: the value, schema node, keyword and path.
## - `out`: accumulator.
##
## ## Retorno
## The accumulator, with one message when the combinator fails.
weave _schema_combinator with v as JsonValue, schema as JsonValue, keyword as string, path as string, out as list of string into list of string:
    var acc as list of string is out
    var kv as maybe JsonValue is calling schema.get with keyword
    if not kv.is_present:
        calling _json_drop_maybe with (sigil of kv)
        return acc
    var branchv as JsonValue is kv.value
    calling _json_drop_maybe with (sigil of kv)
    if not calling branchv.is_array:
        banish branchv
        return acc
    var branches as maybe list of JsonValue is calling branchv.as_array
    banish branchv
    if not branches.is_present:
        calling _json_drop_maybe_values with (sigil of branches)
        return acc
    var matched as int is 0
    for b in branches.value:
        var tmp as list of string is list of string
        set tmp is calling _schema_check with v, b, path, tmp
        if tmp.len == 0:
            set matched is matched + 1
        calling free_strings with tmp
    var branch_count as int is branches.value.len
    calling free_values with branches.value
    calling _json_drop_maybe_values with (sigil of branches)
    if keyword == "allOf":
        if matched != branch_count:
            set acc is calling _schema_push with acc, path, "allOf branch failed"
    else if keyword == "anyOf":
        if matched == 0:
            set acc is calling _schema_push with acc, path, "no anyOf branch matched"
    else:
        if matched != 1:
            set acc is calling _schema_push with acc, path, "oneOf requires exactly one matching branch"
    return acc

## Validates `v` against a JSON Schema (a practical subset).
##
## Supported keywords: `type`, `const`, `enum`, `minimum`, `maximum`,
## `minLength`, `maxLength`, `minItems`, `maxItems`, `required`, `properties`,
## `additionalProperties` (boolean `false`), `items` (schema or tuple array),
## `allOf`, `anyOf`, `oneOf`.
##
## ## Parámetros
## - `v`: the value to validate. Borrowed.
## - `schema`: the schema document. Borrowed.
##
## ## Retorno
## A `list of string` of human-readable errors (`"$..."` paths); empty when the
## value is valid. Release it with `free_strings`.
##
## ## Ejemplo
## ```pengu
## var schema as JsonValue is (calling json.parse with r"""{"type":"object","required":["name"]}""") or:
##     return 1
## var errs as list of string is calling json.validate_schema with v, schema
## if errs.len > 0:
##     calling spark.println with (errs at 0)
## calling json.free_strings with errs
## ```
weave validate_schema with v as JsonValue, schema as JsonValue into list of string:
    var out as list of string is list of string
    return calling _schema_check with v, schema, "$", out
