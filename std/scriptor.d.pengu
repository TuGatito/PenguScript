# std/scriptor.d.pengu - The Scriptor (writes images to file or memory: PNG, BMP, TGA, JPG, HDR)
# Pure C-binding declaration file: every declaration maps 1:1 to the native
# stb_image_write C API. This file cannot contain implementation bodies (.d.pengu rule).
# Memory ownership follows the native library contract: read the upstream docs
# next to each declaration; release any returned handle with the library's own
# cleanup routine before dropping the last reference.

## PenguScript declaration binding generated by 'pengu bind'.
## Source header: scriptor.h
include "scriptor.h"

# -- Constants (#define) ------------------------------

const stbiw__ZHASH as i64 is 16384

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

alias stbi_write_func as ref to weave with context as ref to void, data as ref to void, size as int into void

# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia stbi_

declare write_png with filename as ref to frozen char, w as int, h as int, comp as int, data as ref to frozen void, stride_in_bytes as int into int

declare write_bmp with filename as ref to frozen char, w as int, h as int, comp as int, data as ref to frozen void into int

declare write_tga with filename as ref to frozen char, w as int, h as int, comp as int, data as ref to frozen void into int

declare write_hdr with filename as ref to frozen char, w as int, h as int, comp as int, data as ref to frozen f32 into int

declare write_jpg with filename as ref to frozen char, x as int, y as int, comp as int, data as ref to frozen void, quality as int into int

declare write_png_to_func with func as ref to stbi_write_func, context as ref to void, w as int, h as int, comp as int, data as ref to frozen void, stride_in_bytes as int into int

declare write_bmp_to_func with func as ref to stbi_write_func, context as ref to void, w as int, h as int, comp as int, data as ref to frozen void into int

declare write_tga_to_func with func as ref to stbi_write_func, context as ref to void, w as int, h as int, comp as int, data as ref to frozen void into int

declare write_hdr_to_func with func as ref to stbi_write_func, context as ref to void, w as int, h as int, comp as int, data as ref to frozen f32 into int

declare write_jpg_to_func with func as ref to stbi_write_func, context as ref to void, x as int, y as int, comp as int, data as ref to frozen void, quality as int into int

declare flip_vertically_on_write with flip_boolean as int into void
