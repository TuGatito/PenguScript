-- std/verbum.pengu — módulo `verbum`: `Str` (vista prestada) y `String`.
--
-- `get(range)`, `split_at` y `as_bytes` (devuelve `Vec[U8]`) ya usan el tipo
-- `Range[Usize]` (fase A6).
-- Diferidos (necesitan `funis`, S7): `chars`, `bytes`, `char_indices`,
-- `matches`, `match_indices`, `parse[T]`, `get(range: Range)`, `as_bytes`,
-- `String.from_utf8`, `String.from_utf8_lossy`, `String.drain`,
-- `String.retain`, `String.as_bytes`.

scroll verbum
    foreign "pengu"
        s_len = (s: Str) -> Usize
        s_is_empty = (s: Str) -> Bool
        s_to_string = (s: Str) -> String
        s_chars_count = (s: Str) -> Usize
        s_trim = (s: Str) -> Str
        s_trim_start = (s: Str) -> Str
        s_trim_end = (s: Str) -> Str
        s_split = (s: Str, sep: Str) -> Vec[Str]
        s_rsplit = (s: Str, sep: Str) -> Vec[Str]
        s_splitn = (s: Str, n: Usize, sep: Str) -> Vec[Str]
        s_rsplitn = (s: Str, n: Usize, sep: Str) -> Vec[Str]
        s_split_terminator = (s: Str, sep: Str) -> Vec[Str]
        s_split_whitespace = (s: Str) -> Vec[Str]
        s_split_ascii_whitespace = (s: Str) -> Vec[Str]
        s_lines = (s: Str) -> Vec[Str]
        s_splitlines = (s: Str) -> Vec[Str]
        s_starts_with = (s: Str, prefix: Str) -> Bool
        s_ends_with = (s: Str, suffix: Str) -> Bool
        s_starts_with_ignore_case = (s: Str, prefix: Str) -> Bool
        s_contains = (s: Str, pat: Str) -> Bool
        s_find = (s: Str, pat: Str) -> Option[Usize]
        s_rfind = (s: Str, pat: Str) -> Option[Usize]
        s_replace = (s: Str, from: Str, to: Str) -> String
        s_replacen = (s: Str, from: Str, to: Str, n: Usize) -> String
        s_to_lowercase = (s: Str) -> String
        s_to_uppercase = (s: Str) -> String
        s_to_ascii_lowercase = (s: Str) -> String
        s_to_ascii_uppercase = (s: Str) -> String
        s_eq_ignore_ascii_case = (s: Str, other: Str) -> Bool
        s_strip_prefix = (s: Str, prefix: Str) -> Option[Str]
        s_strip_suffix = (s: Str, suffix: Str) -> Option[Str]
        s_partition = (s: Str, sep: Str) -> (Str, Str, Str)
        s_rpartition = (s: Str, sep: Str) -> (Str, Str, Str)
        s_trim_matches = (s: Str, ch: Char) -> Str
        s_trim_start_matches = (s: Str, ch: Char) -> Str
        s_trim_end_matches = (s: Str, ch: Char) -> Str
        s_is_char_boundary = (s: Str, index: Usize) -> Bool
        s_get_range = (s: Str, range: Range[Usize]) -> Option[Str]
        s_split_at = (s: Str, mid: Usize) -> (Str, Str)
        s_as_bytes = (s: Str) -> Vec[U8]
        s_isalpha = (s: Str) -> Bool
        s_isdigit = (s: Str) -> Bool
        s_isalnum = (s: Str) -> Bool
        s_isspace = (s: Str) -> Bool
        s_islower = (s: Str) -> Bool
        s_isupper = (s: Str) -> Bool
        s_istitle = (s: Str) -> Bool
        s_capitalize = (s: Str) -> String
        s_title = (s: Str) -> String
