        str_push = (s: &mut String, c: Char) -> Unit
        str_push_str = (s: &mut String, other: Str) -> Unit
        str_pop = (s: &mut String) -> Option[Char]
        str_clear = (s: &mut String) -> Unit
        str_insert = (s: &mut String, index: Usize, c: Char) -> Unit
