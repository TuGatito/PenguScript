realm integers

-- Enteros de ancho fijo. Archivo generado por scripts/gen_integers.ts:
-- no lo edites a mano, cambia la tabla del generador y vuelve a ejecutarlo.

declare
  int8_max = () -> int8_t
  int8_min = () -> int8_t
  int16_max = () -> int16_t
  int16_min = () -> int16_t
  int32_max = () -> int32_t
  int32_min = () -> int32_t
  int64_max = () -> int64_t
  int64_min = () -> int64_t
  uint8_max = () -> uint8_t
  uint8_min = () -> uint8_t
  uint16_max = () -> uint16_t
  uint16_min = () -> uint16_t
  uint32_max = () -> uint32_t
  uint32_min = () -> uint32_t
  uint64_max = () -> uint64_t
  uint64_min = () -> uint64_t

enchanting int8_t
  abs = -> int8_t
    if @ < 0 then -@ else @

  min = (otro: int8_t) -> int8_t
    if @ < otro then @ else otro

  max = (otro: int8_t) -> int8_t
    if @ > otro then @ else otro

  clamp = (minimo: int8_t, maximo: int8_t) -> int8_t
    if @ < minimo then minimo else if @ > maximo then maximo else @

  sign = -> int
    if @ > 0 then 1 else if @ < 0 then -1 else 0

  is_even = -> bool
    (@ & 1) == 0

  is_odd = -> bool
    (@ & 1) != 0

  is_positive = -> bool
    @ > 0

  is_negative = -> bool
    @ < 0

  is_zero = -> bool
    @ == 0

  min_value = -> int8_t
    int8_min()

  max_value = -> int8_t
    int8_max()

  to_int = -> int?
    int::try_from(@)

  to_int64 = -> int64_t?
    int64_t::try_from(@)

  to_uint64 = -> uint64_t?
    uint64_t::try_from(@)

  to_double = -> double
    @ as double

  to_size = -> size_t?
    size_t::try_from(@)

