# ----------------------------------------------------------------------------
# Base85 (RFC 1924), Z85 (ZeroMQ) and Base58 (Bitcoin)
# ----------------------------------------------------------------------------

## Index of the character `c` inside `alphabet`, or `-1` when absent.
##
## ## Parámetros
## - `alphabet`: the alphabet to scan. Borrowed.
## - `c`: exactly one character. Borrowed.
##
## ## Retorno
## The 0-based index of `c`, or `-1` when `c` is not in `alphabet` (or is not a
## single character).
weave _char_index with alphabet as string, cb as int into int:
    var i as int is 0
    var n as int is alphabet length
    while i < n:
        if (calling _byte_at with alphabet, i) == cb:
            return i
        set i is i + 1
    return -1

## Emits the `count` most significant RFC 1924 Base85 digits of `v`.
##
## ## Parámetros
## - `v`: a 32-bit group value in `0..0xFFFFFFFF`.
## - `count`: how many digits to keep (`1..5`).
##
## ## Retorno
## An owned string of exactly `count` alphabet characters; release it with
## `banish`.
weave _b85_group with v as i64, count as int into string:
    var lows as list of int is list of int with capacity 5
    var x as i64 is v
    var k as int is 0
    while k < 5:
        calling lows.push with ((x % 85) to int)
        set x is x / 85
        set k is k + 1
    var alpha as string is calling _base85_alphabet
    var parts as list of string is list of string with capacity count
    var j as int is 4
    var taken as int is 0
    while taken < count:
        calling parts.push with (alpha at (lows at j))
        set j is j - 1
        set taken is taken + 1
    var out as string is calling _finish_parts with parts
    banish lows
    return out

## Encodes `data` into RFC 1924 Base85 (Python `base64.b85encode`).
##
## ## Parámetros
## - `data`: the bytes to encode. Borrowed.
##
## ## Retorno
## An owned Base85 string; release it with `banish`. A trailing partial group is
## zero-padded to four bytes and truncated to `ceil(n*5/4)` characters, exactly
## like Python. Empty input yields `""`.
##
## ## Ejemplo
## ```pengu
## calling cipher.encode_base85 with "hello"    # "Xk~0{Zv"
## ```
weave encode_base85 with data as string into string:
    var dl as int is data length
    if dl == 0:
        return ""
    var parts as list of string is list of string
    var i as int is 0
    while i + 4 <= dl:
        var v as i64 is 0
        var k as int is 0
        while k < 4:
            set v is (v << 8) | ((calling _byte_at with data, (i + k)) to i64)
            set k is k + 1
        calling parts.push with (calling _b85_group with v, 5)
        set i is i + 4
    var rem as int is dl - i
    if rem > 0:
        var vp as i64 is 0
        var k2 as int is 0
        while k2 < 4:
            var b as int is 0
            if k2 < rem:
                set b is (calling _byte_at with data, (i + k2))
            set vp is (vp << 8) | (b to i64)
            set k2 is k2 + 1
        calling parts.push with (calling _b85_group with vp, (((rem * 5) + 3) / 4))
    return calling _finish_parts with parts

## Decodes an RFC 1924 Base85 string (Python `base64.b85decode`).
##
## ## Parámetros
## - `data`: the Base85 text. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none` when a character is out of alphabet, a full
## group exceeds `0xFFFFFFFF`, or the length is `5k+1`. Empty input is `some ""`.
weave decode_base85 with data as string into maybe string:
    var dl as int is data length
    if dl == 0:
        return some ""
    if (dl % 5) == 1:
        return maybe none
    var alpha as string is calling _base85_alphabet
    var parts as list of string is list of string
    var i as int is 0
    while i < dl:
        var left as int is dl - i
        var group_len as int is 5
        if left < 5:
            set group_len is left
        var v as i64 is 0
        var k as int is 0
        while k < group_len:
            var idx as int is calling _char_index with alpha, (calling _byte_at with data, (i + k))
            if idx < 0:
                return maybe none
            set v is v * 85 + (idx to i64)
            set k is k + 1
        if group_len == 5 and v > 4294967295:
            return maybe none
        var missing as int is 5 - group_len
        var mz as int is 0
        while mz < missing:
            set v is v * 85
            set mz is mz + 1
        if missing > 0:
            var filler as i64 is 1
            var mz2 as int is 0
            while mz2 < missing:
                set filler is filler * 85
                set mz2 is mz2 + 1
            set v is v + filler - 1
        var bytes_n as int is (group_len * 4) / 5
        var piece as list of string is list of string with capacity bytes_n
        var j as int is 0
        while j < bytes_n:
            var shift as int is 8 * (3 - j)
            calling piece.push with (chr (((v >> (shift to i64)) & 255) to int))
            set j is j + 1
        calling parts.push with (calling _finish_parts with piece)
        set i is i + group_len
    return some (calling _finish_parts with parts)

## Encodes `data` into ZeroMQ Z85 (RFC 32/Z85).
##
## ## Parámetros
## - `data`: the bytes to encode; the length must be a multiple of four.
##   Borrowed.
##
## ## Retorno
## An owned Z85 string, or `""` when the length is not a multiple of four (Z85
## has no padding).
##
## ## Ejemplo
## ```pengu
## calling cipher.encode_base85_z85 with "hello worl"    # "HelloWorld"
## ```
weave encode_base85_z85 with data as string into string:
    var dl as int is data length
    if dl == 0:
        return ""
    if (dl % 4) != 0:
        return ""
    var alpha as string is calling _z85_alphabet
    var parts as list of string is list of string
    var i as int is 0
    while i < dl:
        var v as i64 is 0
        var k as int is 0
        while k < 4:
            set v is (v << 8) | ((calling _byte_at with data, (i + k)) to i64)
            set k is k + 1
        var lows as list of int is list of int with capacity 5
        var x as i64 is v
        var d as int is 0
        while d < 5:
            calling lows.push with ((x % 85) to int)
            set x is x / 85
            set d is d + 1
        var j as int is 4
        while j >= 0:
            calling parts.push with (alpha at (lows at j))
            set j is j - 1
        banish lows
        set i is i + 4
    return calling _finish_parts with parts

## Decodes a ZeroMQ Z85 string.
##
## ## Parámetros
## - `data`: the Z85 text; the length must be a multiple of five. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none` when the length is wrong or a character is out
## of alphabet. Empty input is `some ""`.
weave decode_base85_z85 with data as string into maybe string:
    var dl as int is data length
    if dl == 0:
        return some ""
    if (dl % 5) != 0:
        return maybe none
    var alpha as string is calling _z85_alphabet
    var parts as list of string is list of string
    var i as int is 0
    while i < dl:
        var v as i64 is 0
        var k as int is 0
        while k < 5:
            var idx as int is calling _char_index with alpha, (calling _byte_at with data, (i + k))
            if idx < 0:
                return maybe none
            set v is v * 85 + (idx to i64)
            set k is k + 1
        if v > 4294967295:
            return maybe none
        var piece as list of string is list of string with capacity 4
        var j as int is 0
        while j < 4:
            var shift as int is 8 * (3 - j)
            calling piece.push with (chr (((v >> (shift to i64)) & 255) to int))
            set j is j + 1
        calling parts.push with (calling _finish_parts with piece)
        set i is i + 5
    return some (calling _finish_parts with parts)

## Encodes `data` into Bitcoin Base58.
##
## ## Parámetros
## - `data`: the bytes to encode. Borrowed.
##
## ## Retorno
## An owned Base58 string; release it with `banish`. Each leading zero byte
## becomes a leading `"1"`, exactly as in Bitcoin. Empty input yields `""`.
##
## ## Ejemplo
## ```pengu
## calling cipher.encode_base58 with "\x00\x01"    # "12"
## ```
weave encode_base58 with data as string into string:
    var dl as int is data length
    if dl == 0:
        return ""
    var zeros as int is 0
    while zeros < dl:
        if (calling _byte_at with data, zeros) != 0:
            break
        set zeros is zeros + 1
    var digits as list of int is list of int
    if zeros < dl:
        var i as int is zeros
        while i < dl:
            var carry as int is (calling _byte_at with data, i)
            var j as int is 0
            while j < digits.len:
                var cur as int is (digits at j) * 256 + carry
                set digits at j is cur % 58
                set carry is cur / 58
                set j is j + 1
            while carry > 0:
                calling digits.push with (carry % 58)
                set carry is carry / 58
            set i is i + 1
    var parts as list of string is list of string with capacity zeros + digits.len
    var z as int is 0
    while z < zeros:
        calling parts.push with "1"
        set z is z + 1
    var d as int is digits.len - 1
    while d >= 0:
        calling parts.push with (BASE58_ALPHABET at (digits at d))
        set d is d - 1
    var out as string is calling _finish_parts with parts
    banish digits
    return out

## Decodes a Bitcoin Base58 string.
##
## ## Parámetros
## - `data`: the Base58 text. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none` when a character is out of alphabet. Empty
## input is `some ""`. Leading `"1"` characters decode to leading zero bytes.
##
## ## Ejemplo
## ```pengu
## var b as maybe string is calling cipher.decode_base58 with "12"
## ```
weave decode_base58 with data as string into maybe string:
    var dl as int is data length
    if dl == 0:
        return some ""
    var zeros as int is 0
    while zeros < dl:
        if (calling _byte_at with data, zeros) != 49:
            break
        set zeros is zeros + 1
    var octets as list of int is list of int
    if zeros < dl:
        var i as int is zeros
        while i < dl:
            var idx as int is calling _char_index with BASE58_ALPHABET, (calling _byte_at with data, i)
            if idx < 0:
                banish octets
                return maybe none
            var carry as int is idx
            var j as int is 0
            while j < octets.len:
                var cur as int is (octets at j) * 58 + carry
                set octets at j is cur % 256
                set carry is cur / 256
                set j is j + 1
            while carry > 0:
                calling octets.push with (carry % 256)
                set carry is carry / 256
            set i is i + 1
    var parts as list of string is list of string with capacity zeros + octets.len
    var z as int is 0
    while z < zeros:
        calling parts.push with (calling nul_byte)
        set z is z + 1
    var b as int is octets.len - 1
    while b >= 0:
        calling parts.push with (chr (octets at b))
        set b is b - 1
    var out as maybe string is some (calling _finish_parts with parts)
    banish octets
    return out

# ----------------------------------------------------------------------------
# URL percent-encoding
# ----------------------------------------------------------------------------

## Percent-encodes `s` as a URL component (RFC 3986 unreserved set kept).
##
## ## Parámetros
## - `s`: the text to encode. Borrowed.
##
## ## Retorno
## An owned percent-encoded string; release it with `banish`. `A`–`Z`, `a`–`z`,
## `0`–`9`, `-`, `_`, `.` and `~` pass through; every other byte becomes `%XX`
## with **uppercase** hex digits, matching `urllib.parse.quote(s, safe="")`.
##
## ## Ejemplo
## ```pengu
## calling cipher.encode_url with "a b"    # "a%20b"
## ```
weave encode_url with s as string into string:
    var sl as int is s length
    if sl == 0:
        return ""
    var parts as list of string is list of string
    var i as int is 0
    while i < sl:
        var code as int is (calling _byte_at with s, i)
        var plain as bool is false
        if code >= 65 and code <= 90:
            set plain is true
        else if code >= 97 and code <= 122:
            set plain is true
        else if code >= 48 and code <= 57:
            set plain is true
        else if code == 45 or code == 95 or code == 46 or code == 126:
            set plain is true
        if plain:
            calling parts.push with (s at i)
        else:
            var hi as int is (code >> 4) & 15
            var lo as int is code & 15
            calling parts.push with "%"
            calling parts.push with (chr (calling _byte_at with HEX_UPPER, hi))
            calling parts.push with (chr (calling _byte_at with HEX_UPPER, lo))
        set i is i + 1
    return calling _finish_parts with parts

## Decodes a percent-encoded URL component.
##
## ## Parámetros
## - `data`: the encoded text. `+` is left as a literal plus, like
##   `urllib.parse.unquote`. Borrowed.
##
## ## Retorno
## `some bytes` (owned) or `none` when a `%` is not followed by two hex digits.
## Empty input is `some ""`.
##
## ## Ejemplo
## ```pengu
## var d as maybe string is calling cipher.decode_url with "a%20b"
## ```
weave decode_url with data as string into maybe string:
    var dl as int is data length
    if dl == 0:
        return some ""
    var parts as list of string is list of string
    var i as int is 0
    while i < dl:
        var code is (calling _byte_at with data, i)
        if code != 37:
            calling parts.push with (data at i)
            set i is i + 1
        else:
            if i + 2 >= dl:
                calling _drop_parts with parts
                return maybe none
            var hi as int is calling _hex_val_byte with (calling _byte_at with data, (i + 1))
            var lo as int is calling _hex_val_byte with (calling _byte_at with data, (i + 2))
            if hi < 0 or lo < 0:
                calling _drop_parts with parts
                return maybe none
            calling parts.push with (chr ((hi << 4) | lo))
            set i is i + 3
    return some (calling _finish_parts with parts)

# ----------------------------------------------------------------------------
# CRC-32
# ----------------------------------------------------------------------------

## Returns the IEEE 802.3 CRC-32 of `data` as eight lowercase hex digits.
##
## ## Parámetros
## - `data`: the bytes to checksum. Borrowed.
##
## ## Retorno
## An owned eight-character hex string (zero-padded); release it with `banish`.
## The numeric value matches `zlib.crc32(data) & 0xffffffff` and this module's
## `decode_hex` reads it back.
##
## ## Ejemplo
## ```pengu
## calling cipher.crc32_hex with "hello"    # "3610a686"
## ```
weave crc32_hex with data as string into string:
    var crc as u32 is calling _crc32_raw with data
    var parts as list of string is list of string with capacity 8
    var shift as int is 28
    while shift >= 0:
        calling parts.push with (HEX_DIGITS at (((crc >> (shift to u32)) & 15) to int))
        set shift is shift - 4
    return calling _finish_parts with parts

# ----------------------------------------------------------------------------
# JSON string escaping and unescaping
# ----------------------------------------------------------------------------

## Returns a single double-quote character.
##
## ## Motivo
## `chr 34` as a compile-time constant folds into a C string literal that the
## constant emitter fails to re-escape (it sees a string that starts with a double
## quote and treats it as already quoted). Going through an `int` variable keeps
## the runtime `chr` and the C stays well formed.
##
## ## Retorno
## A one-character string; release it with `banish`.
weave _quote_char into string:
    var code as int is 34
    return chr code

## Returns a single backslash character (same reason as `_quote_char`).
##
## ## Retorno
## A one-character string; release it with `banish`.
weave _backslash_char into string:
    var code as int is 92
    return chr code

## Returns a single NUL byte as a one-byte string.
##
## ## Motivo
## A constant `chr 0` folds into a C string literal that terminates there, so the
## byte disappears (or becomes an empty string). The `int` variable forces the
## runtime path and the byte survives.
##
## ## Retorno
## A one-byte string holding `0x00`; release it with `banish`.
weave nul_byte into string:
    var code as int is 0
    return chr code

## Wraps `s` in double quotes.
##
## ## Parámetros
## - `s`: the already-escaped payload. Borrowed.
##
## ## Retorno
## An owned `"…"` string; release it with `banish`.
weave _quote with s as string into string:
    var q as string is calling _quote_char
    return "{q}{s}{q}"

## Escapes `s` for a JSON string literal (RFC 8259 §7).
##
## ## Parámetros
## - `s`: the raw text to escape. Borrowed.
##
## ## Retorno
## An owned escaped string (without the surrounding quotes); release it with
## `banish`. `"`, `\`, `\b`, `\f`, `\n`, `\r` and `\t` get their short escapes;
## the remaining C0 controls become `\u00XX`. Bytes at or above `0x80` pass
## through unescaped, which keeps UTF-8 intact (Python's `ensure_ascii=True`
## would spell them `\uXXXX`; both spellings decode to the same string).
##
## ## Ejemplo
## ```pengu
## calling cipher.json_escape with "a\"b"    # "a\\\"b"
## ```
weave json_escape with s as string into string:
    return calling _json_escape_raw with s

## Scans a JSON string body (or a bare escaped run) into its decoded text.
##
## ## Parámetros
## - `s`: the text to scan. Borrowed.
## - `start`: index of the first byte to read. When `quoted` this must be the
##   opening `"`.
## - `quoted`: `true` to consume a quoted literal, `false` to consume `s` from
##   `start` to the end.
## - `strict`: `true` to reject raw control bytes, malformed escapes, invalid
##   UTF-8 and lone surrogates; `false` for the lenient 2.0.0 behaviour.
## - `endp`: receives the index just past the consumed text.
##
## ## Retorno
## `some text` (owned; release with `banish`) or `none` when the input is
## malformed. Under `strict` a surrogate pair such as `\uD83D\uDE00` becomes one
## four-byte UTF-8 code point; under the lenient mode an unpaired surrogate is
## encoded on its own (CESU-8), which is the 2.0.0 behaviour.
weave _scan_string_body with s as string, start as int, quoted as bool, strict as bool, endp as ref to int into maybe string:
    var sl as int is s length
    var cur as int is start
    if quoted:
        if cur >= sl:
            return maybe none
        if (calling _byte_at with s, cur) != 34:
            return maybe none
        set cur is cur + 1
    var parts as list of string is list of string
    var closed as bool is not quoted
    while cur < sl:
        var code as int is (calling _byte_at with s, cur)
        if quoted and code == 34:
            set cur is cur + 1
            set closed is true
            break
        if code != 92:
            if strict:
                if code < 32:
                    calling _drop_parts with parts
                    return maybe none
                if code < 128:
                    calling parts.push with (s at cur)
                    set cur is cur + 1
                    continue
                var nlen as int is calling _utf8_seq_len with code
                if nlen == 0:
                    calling _drop_parts with parts
                    return maybe none
                if not (calling _utf8_valid_seq with s, cur, nlen):
                    calling _drop_parts with parts
                    return maybe none
                calling parts.push with (s at cur to (cur + nlen))
                set cur is cur + nlen
                continue
            calling parts.push with (s at cur)
            set cur is cur + 1
            continue
        set cur is cur + 1
        if cur >= sl:
            if strict:
                calling _drop_parts with parts
                return maybe none
            calling parts.push with "\\"
            break
        var ec as int is (calling _byte_at with s, cur)
        if ec == 110:
            calling parts.push with (chr 10)
            set cur is cur + 1
        else if ec == 116:
            calling parts.push with (chr 9)
            set cur is cur + 1
        else if ec == 114:
            calling parts.push with (chr 13)
            set cur is cur + 1
        else if ec == 98:
            calling parts.push with (chr 8)
            set cur is cur + 1
        else if ec == 102:
            calling parts.push with (chr 12)
            set cur is cur + 1
        else if ec == 34:
            calling parts.push with (calling _quote_char)
            set cur is cur + 1
        else if ec == 92:
            calling parts.push with (calling _backslash_char)
            set cur is cur + 1
        else if ec == 47:
            calling parts.push with "/"
            set cur is cur + 1
        else if ec == 117:
            if cur + 4 >= sl:
                if strict:
                    calling _drop_parts with parts
                    return maybe none
                calling parts.push with "u"
                set cur is cur + 1
                continue
            var h0 as int is calling _hex_val_byte with (calling _byte_at with s, (cur + 1))
            var h1 as int is calling _hex_val_byte with (calling _byte_at with s, (cur + 2))
            var h2 as int is calling _hex_val_byte with (calling _byte_at with s, (cur + 3))
            var h3 as int is calling _hex_val_byte with (calling _byte_at with s, (cur + 4))
            if h0 < 0 or h1 < 0 or h2 < 0 or h3 < 0:
                if strict:
                    calling _drop_parts with parts
                    return maybe none
                calling parts.push with "u"
                set cur is cur + 1
                continue
            var cp as int is (h0 * 4096) + (h1 * 256) + (h2 * 16) + h3
            if cp >= 55296 and cp <= 56319:
                if cur + 10 < sl:
                    if (calling _byte_at with s, (cur + 5)) == 92 and (calling _byte_at with s, (cur + 6)) == 117:
                        var l0 as int is calling _hex_val_byte with (calling _byte_at with s, (cur + 7))
                        var l1 as int is calling _hex_val_byte with (calling _byte_at with s, (cur + 8))
                        var l2 as int is calling _hex_val_byte with (calling _byte_at with s, (cur + 9))
                        var l3 as int is calling _hex_val_byte with (calling _byte_at with s, (cur + 10))
                        if l0 >= 0 and l1 >= 0 and l2 >= 0 and l3 >= 0:
                            var low as int is (l0 * 4096) + (l1 * 256) + (l2 * 16) + l3
                            if low >= 56320 and low <= 57343:
                                var full as int is 65536 + ((cp - 55296) * 1024) + (low - 56320)
                                calling parts.push with (calling _utf8_encode_cp with full)
                                set cur is cur + 11
                                continue
                if strict:
                    calling _drop_parts with parts
                    return maybe none
            else if cp >= 56320 and cp <= 57343:
                if strict:
                    calling _drop_parts with parts
                    return maybe none
            calling parts.push with (calling _utf8_encode_cp with cp)
            set cur is cur + 5
        else:
            if strict:
                calling _drop_parts with parts
                return maybe none
            calling parts.push with (s at cur)
            set cur is cur + 1
    if not closed:
        calling _drop_parts with parts
        return maybe none
    set essence of endp is cur
    return some (calling _finish_parts with parts)

## Unescapes a JSON-encoded string body (translates `\"`, `\\`, `\n`, `\r`,
## `\t`, `\b`, `\f`, `\/` and `\uXXXX` back to literals).
##
## ## Parámetros
## - `s`: the escaped text, without surrounding quotes. Borrowed.
##
## ## Retorno
## An owned unescaped string; release it with `banish`. The mode is lenient (the
## 2.0.0 contract): an unknown escape keeps the escaped character and a lone
## surrogate is encoded as CESU-8. `\uD83D\uDE00` *is* combined into `U+1F600`.
##
## ## Ejemplo
## ```pengu
## calling cipher.json_unescape with "a\\nb"    # "a<LF>b"
## ```
weave json_unescape with s as string into string:
    var end as int is 0
    var decoded as maybe string is calling _scan_string_body with s, 0, false, false, (sigil of end)
    if v as string is decoded:
        # `decoded` owns the payload; copy it out so the box can be released
        # (banishing the box frees the payload too).
        var out as string is "{v}"
        banish decoded
        return out
    banish decoded
    return ""

# ----------------------------------------------------------------------------
# JSON tokenizer (legacy helpers, strictness in the parsers below)
# ----------------------------------------------------------------------------

## Advances the cursor `p` past JSON whitespace.
##
## ## Parámetros
## - `s`: the document. Borrowed.
## - `p`: read/write cursor into `s`.
##
## ## Retorno
## Nothing; `p` ends at the first non-whitespace byte or at `s`'s end.
weave json_skip_ws with s as string, p as ref to int into void:
    var sl as int is s length
    var cur as int is essence of p
    var done as bool is false
    while cur < sl:
        if done:
            break
        var code as int is (calling _byte_at with s, cur)
        if code == 32 or code == 9 or code == 10 or code == 13:
            set cur is cur + 1
        else:
            set done is true
    set essence of p is cur

## Reads a quoted JSON string starting at `p` and returns its decoded text.
##
## ## Parámetros
## - `s`: the document. Borrowed.
## - `p`: read/write cursor; must point at the opening quote.
##
## ## Retorno
## The decoded string (owned; release with `banish`), or `""` when the cursor
## does not point at a well-formed string. This is the lenient 2.0.0 entry point;
## the strict parsers use `_read_str_strict`.
weave json_read_str with s as string, p as ref to int into string:
    var got as maybe string is calling _scan_string_body with s, (essence of p), true, false, p
    if v as string is got:
        return v
    return ""

## Reads a quoted JSON string strictly, returning `none` on any malformed escape.
##
## ## Parámetros
## - `s`: the document. Borrowed.
## - `p`: read/write cursor; must point at the opening quote.
##
## ## Retorno
## `some text` (owned) or `none`.
weave _read_str_strict with s as string, p as ref to int into maybe string:
    return calling _scan_string_body with s, (essence of p), true, true, p

## Reads a JSON value as raw text (legacy tokenizer).
##
## ## Parámetros
## - `s`: the document. Borrowed.
## - `p`: read/write cursor.
##
## ## Retorno
## For a quoted string, its decoded text. For `{…}` or `[…]`, the balanced raw
## text **including** the delimiters (2.0.0 dropped the opening delimiter, which
## corrupted every nested value). For anything else, the raw token up to the next
## delimiter. Owned; release it with `banish`.
weave json_read_value with s as string, p as ref to int into string:
    var sl as int is s length
    calling json_skip_ws with s, p
    var cur as int is essence of p
    if cur >= sl:
        return ""
    var code as int is (calling _byte_at with s, cur)
    if code == 34:
        return calling json_read_str with s, p
    if code == 123 or code == 91:
        var open as int is code
        var close as int is 125
        if code == 91:
            set close is 93
        var depth as int is 0
        var parts as list of string is list of string
        var done2 as bool is false
        while cur < sl:
            if done2:
                break
            var cc as int is (calling _byte_at with s, cur)
            if cc == 34:
                var inner as string is calling json_read_str with s, (sigil of cur)
                calling parts.push with (calling _quote with (calling _json_escape_raw with inner))
                continue
            if cc == open:
                set depth is depth + 1
            else if cc == close:
                set depth is depth - 1
            calling parts.push with (s at cur)
            set cur is cur + 1
            if depth == 0:
                set done2 is true
        set essence of p is cur
        return calling _finish_parts with parts
    var start as int is cur
    while cur < sl:
        var rc as int is (calling _byte_at with s, cur)
        if rc == 44 or rc == 125 or rc == 93 or rc == 32 or rc == 9 or rc == 10 or rc == 13:
            break
        set cur is cur + 1
    set essence of p is cur
    return s at start to cur

## True when `v` is the raw text of a JSON literal (object/array/number/bool/null).
##
## ## Parámetros
## - `v`: the raw text. Borrowed.
##
## ## Retorno
## `true` for `{…}`, `[…]`, a leading digit or `-` followed by a digit, and the
## exact words `true`, `false` and `null`.
weave json_is_literal with v as string into bool:
    var vl as int is v length
    if vl == 0:
        return false
    var c0 as int is (calling _byte_at with v, 0)
    if c0 == 123 or c0 == 91:
        return true
    if v == "true" or v == "false" or v == "null":
        return true
    if c0 >= 48 and c0 <= 57:
        return true
    if c0 == 45 and vl > 1:
        var c1 as int is (calling _byte_at with v, 1)
        if c1 >= 48 and c1 <= 57:
            return true
    return false

## Reads a JSON number token strictly (`-?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)?`).
##
## ## Parámetros
## - `s`: the document. Borrowed.
## - `p`: read/write cursor.
##
## ## Retorno
## `some raw text` (owned) or `none` when the input is not a JSON number.
weave _read_number_strict with s as string, p as ref to int into maybe string:
    var sl as int is s length
    var start as int is essence of p
    var cur as int is start
    if cur < sl and (s at cur) == "-":
        set cur is cur + 1
    if cur >= sl:
        return maybe none
    var c as int is (calling _byte_at with s, cur)
    if c == 48:
        set cur is cur + 1
    else if c >= 49 and c <= 57:
        set cur is cur + 1
        while cur < sl:
            var c2 as int is (calling _byte_at with s, cur)
            if c2 < 48 or c2 > 57:
                break
            set cur is cur + 1
    else:
        return maybe none
    if cur < sl and (s at cur) == ".":
        set cur is cur + 1
        var frac as int is 0
        while cur < sl:
            var c3 as int is (calling _byte_at with s, cur)
            if c3 < 48 or c3 > 57:
                break
            set cur is cur + 1
            set frac is frac + 1
        if frac == 0:
            return maybe none
    if cur < sl:
        var ce as int is (calling _byte_at with s, cur)
        if ce == 101 or ce == 69:
            set cur is cur + 1
            if cur < sl and ((s at cur) == "+" or (s at cur) == "-"):
                set cur is cur + 1
            var ed as int is 0
            while cur < sl:
                var c4 as int is (calling _byte_at with s, cur)
                if c4 < 48 or c4 > 57:
                    break
                set cur is cur + 1
                set ed is ed + 1
            if ed == 0:
                return maybe none
    set essence of p is cur
    return some (s at start to cur)

## Consumes the exact literal `lit` at the cursor.
##
## ## Parámetros
## - `s`: the document. Borrowed.
## - `p`: read/write cursor.
## - `lit`: `"true"`, `"false"` or `"null"`.
##
## ## Retorno
## `true` when the literal was present (and `p` advanced past it), else `false`.
weave _read_literal_strict with s as string, p as ref to int, lit as string into bool:
    var cur as int is essence of p
    var ll as int is lit length
    if (cur + ll) > (s length):
        return false
    if (s at cur to (cur + ll)) != lit:
        return false
    set essence of p is cur + ll
    return true

## Parses a strict JSON number into a 32-bit `float`, with bounded work.
##
## ## Parámetros
## - `s`: the number text, taken from `_read_number_strict` (already known to
##   match the JSON grammar). Borrowed.
##
## ## Retorno
## `some value` or `none`. The exponent is clamped to 60 iterations, so
## `1e1000000` costs constant time instead of the one-million-iteration loop the
## 2.0.0 `json_get_float` ran; the result then saturates to infinity (or to zero
## for a very negative exponent) because PenguScript's `float` is 32-bit.
weave _parse_json_float with s as string into maybe float:
    var sl as int is s length
    if sl == 0:
        return maybe none
    var i as int is 0
    var neg as bool is false
    if (s at 0) == "-":
        set neg is true
        set i is 1
    var mant as float is 0.0
    var int_digits as int is 0
    while i < sl:
        var c as int is (calling _byte_at with s, i)
        if c < 48 or c > 57:
            break
        if int_digits < 9:
            set mant is mant * 10.0 + ((c - 48) to float)
        set int_digits is int_digits + 1
        set i is i + 1
    if int_digits == 0:
        return maybe none
    if i < sl and (s at i) == ".":
        set i is i + 1
        var frac_digits as int is 0
        var scale as float is 1.0
        while i < sl:
            var c2 as int is (calling _byte_at with s, i)
            if c2 < 48 or c2 > 57:
                break
            if frac_digits < 9:
                set scale is scale * 10.0
                var scaled as float is ((c2 - 48) to float) / scale
                set mant is mant + scaled
            set frac_digits is frac_digits + 1
            set i is i + 1
        if frac_digits == 0:
            return maybe none
    var expv as int is 0
    var exp_neg as bool is false
    if i < sl:
        var ce as int is (calling _byte_at with s, i)
        if ce == 101 or ce == 69:
            set i is i + 1
            if i < sl and (s at i) == "-":
                set exp_neg is true
                set i is i + 1
            else if i < sl and (s at i) == "+":
                set i is i + 1
            var exp_digits as int is 0
            while i < sl:
                var c3 as int is (calling _byte_at with s, i)
                if c3 < 48 or c3 > 57:
                    return maybe none
                if expv < 1000:
                    set expv is expv * 10 + (c3 - 48)
                set exp_digits is exp_digits + 1
                set i is i + 1
            if exp_digits == 0:
                return maybe none
    if i != sl:
        return maybe none
    var steps as int is expv
    if steps > 60:
        set steps is 60
    var k as int is 0
    while k < steps:
        if exp_neg:
            set mant is mant / 10.0
        else:
            set mant is mant * 10.0
        set k is k + 1
    if neg:
        set mant is 0.0 - mant
    return some mant

## Recursive descent parser producing the generic `JsonValue` tree.
##
## ## Parámetros
## - `json`: the document. Borrowed.
## - `p`: read/write cursor.
## - `depth`: current nesting depth; input deeper than 128 levels is rejected so
##   that hostile documents cannot exhaust the C stack.
##
## ## Retorno
## `some value` (owned) or `none` when the value is malformed.
weave _parse_value_at_depth with json as string, p as ref to int, depth as int into maybe JsonValue:
    if depth > 128:
        return maybe none
    calling json_skip_ws with json, p
    var sl as int is json length
    var cur as int is essence of p
    if cur >= sl:
        return maybe none
    var code as int is (calling _byte_at with json, cur)
    if code == 34:
        var got as maybe string is calling _read_str_strict with json, p
        if text as string is got:
            var snode as JsonValue is with JvString is with value is text
            return some snode
        return maybe none
    if code == 116:
        if calling _read_literal_strict with json, p, "true":
            var tnode as JsonValue is with JvBool is with value is true
            return some tnode
        return maybe none
    if code == 102:
        if calling _read_literal_strict with json, p, "false":
            var fnode as JsonValue is with JvBool is with value is false
            return some fnode
        return maybe none
    if code == 110:
        if calling _read_literal_strict with json, p, "null":
            return some JvNull
        return maybe none
    if code == 123:
        set cur is cur + 1
        set essence of p is cur
        var pairs as map of string to JsonValue is map of string to JsonValue
        var is_first as bool is true
        var running as bool is true
        while running:
            calling json_skip_ws with json, p
            var cp as int is essence of p
            if cp >= sl:
                return maybe none
            if (calling _byte_at with json, cp) == 125:
                set essence of p is cp + 1
                set running is false
                continue
            if not is_first:
                if (calling _byte_at with json, cp) != 44:
                    return maybe none
                set essence of p is cp + 1
                calling json_skip_ws with json, p
            set is_first is false
            var key as maybe string is calling _read_str_strict with json, p
            if k as string is key:
                calling json_skip_ws with json, p
                var cc as int is essence of p
                if cc >= sl:
                    return maybe none
                if (calling _byte_at with json, cc) != 58:
                    return maybe none
                set essence of p is cc + 1
                var child as maybe JsonValue is calling _parse_value_at_depth with json, p, depth + 1
                if cv as JsonValue is child:
                    calling pairs.put with k, cv
                else:
                    return maybe none
            else:
                return maybe none
        var onode as JsonObjectNode is with pairs is pairs
        var ovalue as JsonValue is with JvObject is with node is onode
        return some ovalue
    if code == 91:
        set cur is cur + 1
        set essence of p is cur
        var items as list of JsonValue is list of JsonValue
        var first2 as bool is true
        var running2 as bool is true
        while running2:
            calling json_skip_ws with json, p
            var cp2 as int is essence of p
            if cp2 >= sl:
                return maybe none
            if (calling _byte_at with json, cp2) == 93:
                set essence of p is cp2 + 1
                set running2 is false
                continue
            if not first2:
                if (calling _byte_at with json, cp2) != 44:
                    return maybe none
                set essence of p is cp2 + 1
            set first2 is false
            var child2 as maybe JsonValue is calling _parse_value_at_depth with json, p, depth + 1
            if cv2 as JsonValue is child2:
                calling items.push with cv2
            else:
                return maybe none
        var anode as JsonArrayNode is with items is items
        var avalue as JsonValue is with JvArray is with node is anode
        return some avalue
    var num as maybe string is calling _read_number_strict with json, p
    if raw as string is num:
        var has_dot as bool is false
        var has_exp as bool is false
        var ki as int is 0
        while ki < (raw length):
            var ch as string is raw at ki
            if ch == ".":
                set has_dot is true
            else if ch == "e" or ch == "E":
                set has_exp is true
            set ki is ki + 1
        if not has_dot and not has_exp:
            var iv as maybe int is calling spark.parse_int with raw
            if iiv as int is iv:
                var inode as JsonValue is with JvInt is with value is iiv
                return some inode
        var fv as maybe float is calling _parse_json_float with raw
        if ffv as float is fv:
            var fnode2 as JsonValue is with JvFloat is with value is ffv
            return some fnode2
        return maybe none
    return maybe none

## Index just past the composite (`{…}` or `[…]`) that starts at `p`, or `none`.
##
## ## Parámetros
## - `s`: the document. Borrowed.
## - `p`: cursor; must point at `{` or `[`.
##
## ## Retorno
## `some end` (index just past the matching close) or `none` when the composite
## is unterminated or contains a malformed string. Strings are validated but the
## grammar inside is not (the caller re-parses the slice with the strict parser).
weave _skip_composite with s as string, p as int into maybe int:
    var sl as int is s length
    if p >= sl:
        return maybe none
    var open as int is (calling _byte_at with s, p)
    if open != 123 and open != 91:
        return maybe none
    var close as int is 125
    if open == 91:
        set close is 93
    var depth as int is 0
    var cur as int is p
    while cur < sl:
        var code as int is (calling _byte_at with s, cur)
        if code == 34:
            var end as int is 0
            var inner as maybe string is calling _scan_string_body with s, cur, true, true, (sigil of end)
            if not inner.is_present:
                return maybe none
            set cur is end
            continue
        if code == open:
            set depth is depth + 1
        else if code == close:
            set depth is depth - 1
            if depth == 0:
                return some (cur + 1)
        set cur is cur + 1
    return maybe none

## Reads any JSON value as its raw text, validating the whole token.
##
## ## Parámetros
## - `s`: the document. Borrowed.
## - `p`: read/write cursor.
##
## ## Retorno
## `some raw text` (owned) or `none`. A quoted string is returned decoded (the
## 2.0.0 contract); a composite is returned with its delimiters intact.
weave _read_raw_value_strict with s as string, p as ref to int into maybe string:
    calling json_skip_ws with s, p
    var cur as int is essence of p
    var sl as int is s length
    if cur >= sl:
        return maybe none
    var code as int is (calling _byte_at with s, cur)
    if code == 34:
        return calling _read_str_strict with s, p
    if code == 123 or code == 91:
        var end as maybe int is calling _skip_composite with s, cur
        if stop as int is end:
            var raw as string is s at cur to stop
            var cursor as int is 0
            var parsed as maybe JsonValue is calling _parse_value_at_depth with raw, (sigil of cursor), 0
            if not parsed.is_present:
                return maybe none
            calling json_skip_ws with raw, (sigil of cursor)
            if cursor != (raw length):
                return maybe none
            set essence of p is stop
            return some raw
        return maybe none
    if code == 116:
        if calling _read_literal_strict with s, p, "true":
            return some "true"
        return maybe none
    if code == 102:
        if calling _read_literal_strict with s, p, "false":
            return some "false"
        return maybe none
    if code == 110:
        if calling _read_literal_strict with s, p, "null":
            return some "null"
        return maybe none
    return calling _read_number_strict with s, p

# ----------------------------------------------------------------------------
# JSON core API (legacy flat surface)
# ----------------------------------------------------------------------------

## Parses a JSON object into a `map of string to string`.
##
## ## Parámetros
## - `json`: the document; must be a single JSON object. Borrowed.
##
## ## Retorno
## `some map` (owned; release with `banish`) or `none`. Each value is the raw
## JSON text of the member (a JSON string arrives unquoted, a nested object
## arrives as its full `{…}` text). Strict RFC 8259: trailing commas, empty
## member values, incomplete literals, unescaped control bytes, invalid UTF-8
## and trailing content are all rejected.
##
## ## Ejemplo
## ```pengu
## var m as maybe map of string to string is calling cipher.parse_json with "{\"a\": 1}"
## ```
weave parse_json with json as string into maybe map of string to string:
    var dl as int is json length
    if dl == 0:
        return maybe none
    var m as map of string to string is map of string to string
    var p as int is 0
    calling json_skip_ws with json, (sigil of p)
    if p >= dl:
        return maybe none
    if (calling _byte_at with json, p) != 123:
        return maybe none
    set p is p + 1
    var is_first as bool is true
    var running as bool is true
    while running:
        calling json_skip_ws with json, (sigil of p)
        if p >= dl:
            return maybe none
        var cc as int is (calling _byte_at with json, p)
        if cc == 125:
            set p is p + 1
            calling json_skip_ws with json, (sigil of p)
            if p != dl:
                return maybe none
            return some m
        if not is_first:
            if cc != 44:
                return maybe none
            set p is p + 1
            calling json_skip_ws with json, (sigil of p)
        set is_first is false
        var key as maybe string is calling _read_str_strict with json, (sigil of p)
        if k as string is key:
            calling json_skip_ws with json, (sigil of p)
            if p >= dl:
                return maybe none
            if (calling _byte_at with json, p) != 58:
                return maybe none
            set p is p + 1
            var val as maybe string is calling _read_raw_value_strict with json, (sigil of p)
            if v as string is val:
                calling m.put with k, v
            else:
                return maybe none
        else:
            return maybe none
    return maybe none

## Serializes a `map of string to string` as compact JSON.
##
## ## Parámetros
## - `data`: the map. A value is emitted verbatim when `json_is_literal` accepts
##   it (numbers, booleans, `null`, nested `{…}`/`[…]`), and as a quoted,
##   escaped JSON string otherwise. Borrowed.
##
## ## Retorno
## `some json` (owned; release with `banish`). Members are emitted in
## **sorted key order**, so two runs produce byte-identical JSON; 2.0.0 used the
## map's hash order, which varied between runs.
##
## ## Ejemplo
## ```pengu
## calling cipher.stringify_json with my_map
## ```
weave stringify_json with data as map of string to string into maybe string:
    var parts as list of string is list of string
    calling parts.push with r"{"
    var key_list as list of string is calling _sorted_keys with data
    var i as int is 0
    while i < key_list.len:
        var key as string is key_list at i
        var val as string is calling data.get with key
        if i > 0:
            calling parts.push with ","
        calling parts.push with (calling _quote with (calling json_escape with key))
        calling parts.push with ":"
        if calling json_is_literal with val:
            calling parts.push with val
        else:
            calling parts.push with (calling _quote with (calling json_escape with val))
        set i is i + 1
    calling parts.push with r"}"
    return some (calling _finish_parts with parts)

## Like `stringify_json` but indented across multiple lines.
##
## ## Parámetros
## - `data`: the map. Borrowed.
## - `indent`: spaces per nesting level (default `2`).
##
## ## Retorno
## `some json` (owned; release with `banish`) with sorted keys.
##
## ## Ejemplo
## ```pengu
## calling cipher.pretty_json with my_map, 4
## ```
weave pretty_json with data as map of string to string, indent as int is 2 into maybe string:
    var key_list as list of string is calling _sorted_keys with data
    if key_list.len == 0:
        return some r"{}"
    var pad as string is calling _spaces with indent
    var parts as list of string is list of string
    calling parts.push with "{\n"
    var i as int is 0
    while i < key_list.len:
        var key as string is key_list at i
        var val as string is calling data.get with key
        if i > 0:
            calling parts.push with ",\n"
        calling parts.push with pad
        calling parts.push with (calling _quote with (calling json_escape with key))
        calling parts.push with ": "
        if calling json_is_literal with val:
            calling parts.push with val
        else:
            calling parts.push with (calling _quote with (calling json_escape with val))
        set i is i + 1
    calling parts.push with "\n}"
    return some (calling _finish_parts with parts)

## Reads a single JSON value and returns it as raw text.
##
## ## Parámetros
## - `json`: the document; must contain exactly one value. Borrowed.
##
## ## Retorno
## `some raw` (owned) or `none`. A JSON string is returned decoded, everything
## else as its literal text. Trailing content is rejected (2.0.0 accepted
## `"1 2 3"` and returned `"1"`).
##
## ## Ejemplo
## ```pengu
## var v as maybe string is calling cipher.parse_value with "[1, 2]"
## ```
weave parse_value with json as string into maybe string:
    var dl as int is json length
    if dl == 0:
        return maybe none
    var p as int is 0
    var val as maybe string is calling _read_raw_value_strict with json, (sigil of p)
    if v as string is val:
        calling json_skip_ws with json, (sigil of p)
        if p != dl:
            return maybe none
        return some v
    return maybe none

## Identity passthrough returning `some value`.
##
## ## Parámetros
## - `value`: the raw JSON text. Borrowed.
##
## ## Retorno
## `some value`; release it with `banish`.
weave stringify_value with value as string into maybe string:
    return some value

## Parses a JSON array into a list of raw member texts.
##
## ## Parámetros
## - `json`: the document; must be a single JSON array. Borrowed.
##
## ## Retorno
## `some list` (owned; release with `banish`) or `none`. Strict: trailing commas
## and empty elements are rejected.
##
## ## Ejemplo
## ```pengu
## var xs as maybe list of string is calling cipher.parse_json_array with "[1, 2]"
## ```
weave parse_json_array with json as string into maybe list of string:
    var dl as int is json length
    if dl == 0:
        return maybe none
    var items as list of string is list of string
    var p as int is 0
    calling json_skip_ws with json, (sigil of p)
    if p >= dl:
        return maybe none
    if (calling _byte_at with json, p) != 91:
        return maybe none
    set p is p + 1
    var is_first as bool is true
    var running as bool is true
    while running:
        calling json_skip_ws with json, (sigil of p)
        if p >= dl:
            return maybe none
        var cc as int is (calling _byte_at with json, p)
        if cc == 93:
            set p is p + 1
            calling json_skip_ws with json, (sigil of p)
            if p != dl:
                return maybe none
            return some items
        if not is_first:
            if cc != 44:
                return maybe none
            set p is p + 1
            calling json_skip_ws with json, (sigil of p)
        set is_first is false
        var val as maybe string is calling _read_raw_value_strict with json, (sigil of p)
        if v as string is val:
            calling items.push with v
        else:
            return maybe none
    return maybe none

## Serializes a list of raw JSON texts as a compact JSON array.
##
## ## Parámetros
## - `items`: the raw texts. Each is emitted verbatim when `json_is_literal`
##   accepts it, and quoted otherwise. Borrowed.
##
## ## Retorno
## `some json` (owned; release with `banish`).
##
## ## Ejemplo
## ```pengu
## calling cipher.stringify_json_array with my_list
## ```
weave stringify_json_array with items as list of string into maybe string:
    var parts as list of string is list of string
    calling parts.push with "["
    var i as int is 0
    while i < items.len:
        var val as string is items at i
        if i > 0:
            calling parts.push with ","
        if calling json_is_literal with val:
            calling parts.push with val
        else:
            calling parts.push with (calling _quote with (calling json_escape with val))
        set i is i + 1
    calling parts.push with "]"
    return some (calling _finish_parts with parts)

## Reads a file and parses its contents as a JSON array.
##
## ## Parámetros
## - `path`: the file to read. Borrowed.
##
## ## Retorno
## `some list` (owned) or `none` when the file cannot be read or is not a JSON
## array.
weave read_json_array_file with path as string into maybe list of string:
    var content as maybe string is calling archivum.read_file with path
    if c as string is content:
        return calling parse_json_array with c
    return maybe none

## Returns the keys of `m` in ascending byte order.
##
## ## Parámetros
## - `m`: the map. Borrowed.
##
## ## Retorno
## An owned sorted list of keys; release it with `banish`. `pengu_map_keys_string`
## returns them in hash order, which changes from run to run; every serializer in
## this module sorts them so its output is deterministic.
weave _sorted_keys with m as map of string to string into list of string:
    return calling _sorted_map_keys with m

## Returns `n` spaces.
##
## ## Parámetros
## - `n`: how many spaces.
##
## ## Retorno
## An owned string of `n` spaces; release it with `banish`.
weave _spaces with n as int into string:
    if n <= 0:
        return ""
    var parts as list of string is list of string with capacity n
    var i as int is 0
    while i < n:
        calling parts.push with " "
        set i is i + 1
    return calling _finish_parts with parts

# ----------------------------------------------------------------------------
# Generic JSON tree: parsing and serialization
# ----------------------------------------------------------------------------

## Parses a JSON document into the generic `JsonValue` tree.
##
## ## Parámetros
## - `json`: the document; must contain exactly one value. Borrowed.
##
## ## Retorno
## `some value` (owned; release with `banish`) or `none`. Strict RFC 8259:
## trailing commas, empty members, incomplete literals, unescaped control bytes,
## invalid UTF-8, malformed `\uXXXX` escapes and trailing content are rejected.
## Valid surrogate pairs are combined into one code point.
##
## ## Ejemplo
## ```pengu
## var v as maybe cipher.JsonValue is calling cipher.parse_json_value with "[1, 2, 3]"
## ```
weave parse_json_value with json as string into maybe JsonValue:
    if not (calling _utf8_validate with json):
        return maybe none
    var dl as int is json length
    if dl == 0:
        return maybe none
    var p as int is 0
    var parsed as maybe JsonValue is calling _parse_value_at_depth with json, (sigil of p), 0
    if v as JsonValue is parsed:
        calling json_skip_ws with json, (sigil of p)
        if p != dl:
            return maybe none
        return some v
    return maybe none

## Parses a JSON object into a `map of string to JsonValue`.
##
## ## Parámetros
## - `json`: the document; must be a single JSON object. Borrowed.
##
## ## Retorno
## `some map` (owned; release with `banish`) or `none` when the document is not
## an object or is malformed.
weave parse_json_to_map with json as string into maybe map of string to JsonValue:
    var parsed as maybe JsonValue is calling parse_json_value with json
    if v as JsonValue is parsed:
        if calling json_value_is_object with v:
            return some (calling _jv_pairs_of with v)
    return maybe none

## Parses a JSON array into a `list of JsonValue`.
##
## ## Parámetros
## - `json`: the document; must be a single JSON array. Borrowed.
##
## ## Retorno
## `some list` (owned; release with `banish`) or `none` when the document is not
## an array or is malformed.
weave parse_json_to_list with json as string into maybe list of JsonValue:
    var parsed as maybe JsonValue is calling parse_json_value with json
    if v as JsonValue is parsed:
        if calling json_value_is_array with v:
            return some (calling _jv_items_of with v)
    return maybe none

## Kind of a `JsonValue` as an integer code (private, for dispatch).
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `0` null, `1` bool, `2` int, `3` float, `4` string, `5` array, `6` object.
weave _jv_kind with v as JsonValue into int:
    return judge v:
        when JsonValue.JvNull -> 0
        when JsonValue.JvBool with value -> 1
        when JsonValue.JvInt with value -> 2
        when JsonValue.JvFloat with value -> 3
        when JsonValue.JvString with value -> 4
        when JsonValue.JvArray with node -> 5
        when JsonValue.JvObject with node -> 6

## Shallow copy of an object payload, so a mutation cannot alias the original.
##
## ## Parámetros
## - `m`: the object payload. Borrowed.
##
## ## Retorno
## A new map sharing the child `JsonValue`s; release it with `banish`.
weave _copy_value_map with m as map of string to JsonValue into map of string to JsonValue:
    var out as map of string to JsonValue is map of string to JsonValue
    for k in m:
        calling out.put with k, (m at k)
    return out

## Shallow copy of an array payload.
##
## ## Parámetros
## - `xs`: the array payload. Borrowed.
##
## ## Retorno
## A new list sharing the child `JsonValue`s; release it with `banish`.
weave _copy_value_list with xs as list of JsonValue into list of JsonValue:
    var out as list of JsonValue is list of JsonValue with capacity xs.len
    for x in xs:
        calling out.push with x
    return out

## Object payload of `v` as a fresh mutable map (empty for other kinds).
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## A new map; release it with `banish`.
weave _jv_pairs_of with v as JsonValue into map of string to JsonValue:
    return judge v:
        when JsonValue.JvObject with node -> calling _copy_value_map with node.pairs
        else -> map of string to JsonValue

## Array payload of `v` as a fresh mutable list (empty for other kinds).
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## A new list; release it with `banish`.
weave _jv_items_of with v as JsonValue into list of JsonValue:
    return judge v:
        when JsonValue.JvArray with node -> calling _copy_value_list with node.items
        else -> list of JsonValue

## Typed empty `maybe int` (a bare `maybe none` inside a `judge` arm has no type
## context and is rejected with E0014).
##
## ## Retorno
## `none`.
weave _none_int into maybe int:
    return maybe none

## Typed empty `maybe float` for `judge` arms.
##
## ## Retorno
## `none`.
weave _none_float into maybe float:
    return maybe none

## Typed empty `maybe bool` for `judge` arms.
##
## ## Retorno
## `none`.
weave _none_bool into maybe bool:
    return maybe none

## Returns the variant name of `v`.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## One of `"null"`, `"bool"`, `"int"`, `"float"`, `"string"`, `"array"`,
## `"object"` (owned; release with `banish`).
##
## ## Ejemplo
## ```pengu
## calling cipher.json_value_type with v    # "array"
## ```
weave json_value_type with v as JsonValue into string:
    return judge v:
        when JsonValue.JvNull -> "null"
        when JsonValue.JvBool with value -> "bool"
        when JsonValue.JvInt with value -> "int"
        when JsonValue.JvFloat with value -> "float"
        when JsonValue.JvString with value -> "string"
        when JsonValue.JvArray with node -> "array"
        when JsonValue.JvObject with node -> "object"

## Formats a 32-bit float as JSON number text.
##
## ## Parámetros
## - `v`: the value.
##
## ## Retorno
## An owned string; release it with `banish`. Integral values inside ±1e9 are
## rendered with a trailing `.0`, like Python's `json.dumps(1.0)`; everything else
## uses PenguScript's float formatting, which is not guaranteed to be the
## shortest round-tripping spelling.
weave _format_float with v as float into string:
    if v >= -1000000000.0 and v <= 1000000000.0:
        var iv as int is (v to int)
        var back as float is iv to float
        if back == v:
            return "{iv}.0"
    return "{v}"

## Serializes a `JsonValue` as JSON, optionally indented (private workhorse).
##
## ## Parámetros
## - `v`: the value. Borrowed.
## - `pretty`: `true` for multi-line output.
## - `level`: current nesting level (callers pass `0`).
## - `indent`: spaces per level when `pretty`.
##
## ## Retorno
## An owned JSON document; release it with `banish`. Object members are emitted in
## sorted key order, so the output is deterministic.
weave _stringify_value with v as JsonValue, pretty as bool, level as int, indent as int into string:
    var kind as int is calling _jv_kind with v
    if kind == 0:
        return "null"
    if kind == 1:
        return judge v:
            when JsonValue.JvBool with value -> if value then "true" else "false"
            else -> "false"
    if kind == 2:
        return judge v:
            when JsonValue.JvInt with value -> "{value}"
            else -> "0"
    if kind == 3:
        return judge v:
            when JsonValue.JvFloat with value -> calling _format_float with value
            else -> "0.0"
    if kind == 4:
        return judge v:
            when JsonValue.JvString with value -> calling _quote with (calling json_escape with value)
            else -> "\"\""
    if kind == 5:
        var items as list of JsonValue is calling _jv_items_of with v
        return calling _stringify_items with items, pretty, level, indent
    var pairs as map of string to JsonValue is calling _jv_pairs_of with v
    return calling _stringify_pairs with pairs, pretty, level, indent

## Collects the keys of `m` into a fresh list sorted by ascending bytes.
##
## ## Parámetros
## - `m`: any `map of string to V`. Borrowed.
##
## ## Retorno
## An owned sorted list of keys; release it with `banish`. Every serializer in
## this module routes through here so its member order is deterministic.
weave _sorted_map_keys shard V with m as map of string to V into list of string:
    var ks as list of string is list of string
    for k in m:
        calling ks.push with k
    var i as int is 1
    while i < ks.len:
        var key as string is ks at i
        var j as int is i - 1
        while j >= 0:
            if (calling scrolls.compare with (ks at j), key) > 0:
                set ks at (j + 1) is (ks at j)
                set j is j - 1
            else:
                break
        set ks at (j + 1) is key
        set i is i + 1
    return ks

## Serializes an array payload (helper of `_stringify_value`).
##
## ## Parámetros
## - `items`: the elements. Borrowed.
## - `pretty`, `level`, `indent`: layout controls.
##
## ## Retorno
## An owned JSON array; release it with `banish`.
weave _stringify_items with items as list of JsonValue, pretty as bool, level as int, indent as int into string:
    if items.len == 0:
        return "[]"
    var parts as list of string is list of string
    calling parts.push with "["
    var i as int is 0
    while i < items.len:
        if i > 0:
            calling parts.push with ","
        if pretty:
            calling parts.push with "\n"
            calling parts.push with (calling _spaces with ((level + 1) * indent))
        calling parts.push with (calling _stringify_value with (items at i), pretty, level + 1, indent)
        set i is i + 1
    if pretty:
        calling parts.push with "\n"
        calling parts.push with (calling _spaces with (level * indent))
    calling parts.push with "]"
    return calling _finish_parts with parts

## Serializes an object payload (helper of `_stringify_value`).
##
## ## Parámetros
## - `pairs`: the members. Borrowed.
## - `pretty`, `level`, `indent`: layout controls.
##
## ## Retorno
## An owned JSON object with sorted keys; release it with `banish`.
weave _stringify_pairs with pairs as map of string to JsonValue, pretty as bool, level as int, indent as int into string:
    var ks as list of string is calling _sorted_map_keys with pairs
    if ks.len == 0:
        return r"{}"
    var parts as list of string is list of string
    calling parts.push with r"{"
    var i as int is 0
    while i < ks.len:
        var key as string is ks at i
        if i > 0:
            calling parts.push with ","
        if pretty:
            calling parts.push with "\n"
            calling parts.push with (calling _spaces with ((level + 1) * indent))
        calling parts.push with (calling _quote with (calling json_escape with key))
        if pretty:
            calling parts.push with ": "
        else:
            calling parts.push with ":"
        calling parts.push with (calling _stringify_value with (pairs at key), pretty, level + 1, indent)
        set i is i + 1
    if pretty:
        calling parts.push with "\n"
        calling parts.push with (calling _spaces with (level * indent))
    calling parts.push with r"}"
    return calling _finish_parts with parts

## Serializes a `JsonValue` as compact JSON.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## An owned compact JSON document with sorted object keys; release it with
## `banish`. This is the `json.dumps` counterpart of `parse_json_value`.
##
## ## Ejemplo
## ```pengu
## calling cipher.stringify_json_value with v
## ```
weave stringify_json_value with v as JsonValue into string:
    return calling _stringify_value with v, false, 0, 0

## Serializes a `JsonValue` as indented JSON.
##
## ## Parámetros
## - `v`: the value. Borrowed.
## - `indent`: spaces per nesting level (default `2`).
##
## ## Retorno
## An owned pretty JSON document with sorted object keys; release it with
## `banish`.
##
## ## Ejemplo
## ```pengu
## calling cipher.stringify_json_value_pretty with v, 4
## ```
weave stringify_json_value_pretty with v as JsonValue, indent as int is 2 into string:
    return calling _stringify_value with v, true, 0, indent

## Serializes a `JsonValue` in canonical form: compact with sorted keys (the
## RFC 8785 shape).
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## An owned compact document with object keys in ascending byte order; release it
## with `banish`. Number formatting follows `_format_float` (32-bit), the one
## place this serializer is not byte-for-byte RFC 8785.
##
## ## Ejemplo
## ```pengu
## calling cipher.json_dumps_canonical with v
## ```
weave json_dumps_canonical with v as JsonValue into string:
    return calling _stringify_value with v, false, 0, 0

## Renders a `JsonValue` as human-readable text (containers become compact JSON).
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## An owned string; release it with `banish`. Scalars render as their bare value
## (`null`, `true`, `42`, `hello`) and containers as compact JSON.
##
## ## Ejemplo
## ```pengu
## calling cipher.json_value_to_string with v
## ```
weave json_value_to_string with v as JsonValue into string:
    var kind as int is calling _jv_kind with v
    if kind == 4:
        return judge v:
            when JsonValue.JvString with value -> value
            else -> ""
    return calling _stringify_value with v, false, 0, 0

# ----------------------------------------------------------------------------
# Generic JSON tree: accessors and coercions
# ----------------------------------------------------------------------------

## True when `v` is JSON `null`.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `true` for the `JvNull` variant.
weave json_value_is_null with v as JsonValue into bool:
    return (calling _jv_kind with v) == 0

## True when `v` is a JSON boolean.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `true` for the `JvBool` variant.
weave json_value_is_bool with v as JsonValue into bool:
    return (calling _jv_kind with v) == 1

## True when `v` is an integral JSON number.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `true` for the `JvInt` variant.
weave json_value_is_int with v as JsonValue into bool:
    return (calling _jv_kind with v) == 2

## True when `v` is a fractional JSON number.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `true` for the `JvFloat` variant.
weave json_value_is_float with v as JsonValue into bool:
    return (calling _jv_kind with v) == 3

## True when `v` is a JSON string.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `true` for the `JvString` variant.
weave json_value_is_string with v as JsonValue into bool:
    return (calling _jv_kind with v) == 4

## True when `v` is a JSON array.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `true` for the `JvArray` variant.
weave json_value_is_array with v as JsonValue into bool:
    return (calling _jv_kind with v) == 5

## True when `v` is a JSON object.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `true` for the `JvObject` variant.
weave json_value_is_object with v as JsonValue into bool:
    return (calling _jv_kind with v) == 6

## Number of elements in an array, members in an object or bytes in a string.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## The length, or `0` for the scalar variants.
##
## ## Ejemplo
## ```pengu
## calling cipher.json_value_len with v    # 3
## ```
weave json_value_len with v as JsonValue into int:
    return judge v:
        when JsonValue.JvString with value -> value length
        when JsonValue.JvArray with node -> node.items.len
        when JsonValue.JvObject with node -> node.pairs.len
        else -> 0

## Returns the array elements of `v` as a fresh list.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `some list` (owned; release with `banish`) or `none` when `v` is not an array.
weave json_value_items with v as JsonValue into maybe list of JsonValue:
    if (calling _jv_kind with v) != 5:
        return maybe none
    return some (calling _jv_items_of with v)

## Returns the object members of `v` as a fresh map.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `some map` (owned; release with `banish`) or `none` when `v` is not an object.
weave json_value_pairs with v as JsonValue into maybe map of string to JsonValue:
    if (calling _jv_kind with v) != 6:
        return maybe none
    return some (calling _jv_pairs_of with v)

## Returns the member `key` of an object.
##
## ## Parámetros
## - `v`: the value; must be an object for a hit. Borrowed.
## - `key`: the member name. Borrowed.
##
## ## Retorno
## `some value` (the child is shared, not copied) or `none`.
##
## ## Ejemplo
## ```pengu
## calling cipher.json_value_get with v, "name"
## ```
weave json_value_get with v as JsonValue, key as string into maybe JsonValue:
    if (calling _jv_kind with v) != 6:
        return maybe none
    var pairs as map of string to JsonValue is calling _jv_pairs_of with v
    if key in pairs:
        return some (pairs at key)
    return maybe none

## Returns element `idx` of an array.
##
## ## Parámetros
## - `v`: the value; must be an array for a hit. Borrowed.
## - `idx`: the 0-based index; negative counts from the end.
##
## ## Retorno
## `some value` (the child is shared, not copied) or `none`.
##
## ## Ejemplo
## ```pengu
## calling cipher.json_value_at with v, 0
## ```
weave json_value_at with v as JsonValue, idx as int into maybe JsonValue:
    if (calling _jv_kind with v) != 5:
        return maybe none
    var items as list of JsonValue is calling _jv_items_of with v
    var real as int is idx
    if real < 0:
        set real is real + items.len
    if real < 0 or real >= items.len:
        return maybe none
    return some (items at real)

## Coerces `v` to an `int`.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `some n` for `JvInt`; the truncated value for `JvFloat`; `1`/`0` for `JvBool`;
## the parsed number for a numeric `JvString`; `0` for `JvNull`; `none`
## otherwise.
weave json_value_as_int with v as JsonValue into maybe int:
    var kind as int is calling _jv_kind with v
    if kind == 2:
        return judge v:
            when JsonValue.JvInt with value -> some value
            else -> calling _none_int
    if kind == 3:
        return judge v:
            when JsonValue.JvFloat with value -> some (value to int)
            else -> calling _none_int
    if kind == 1:
        return judge v:
            when JsonValue.JvBool with value -> some (if value then 1 else 0)
            else -> calling _none_int
    if kind == 0:
        return some 0
    if kind == 4:
        return judge v:
            when JsonValue.JvString with value -> calling spark.parse_int with value
            else -> calling _none_int
    return maybe none

## Coerces `v` to a 32-bit `float`.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `some f` for `JvFloat` and `JvInt`; `1.0`/`0.0` for `JvBool`; the parsed number
## for a numeric `JvString`; `0.0` for `JvNull`; `none` otherwise.
weave json_value_as_float with v as JsonValue into maybe float:
    var kind as int is calling _jv_kind with v
    if kind == 3:
        return judge v:
            when JsonValue.JvFloat with value -> some value
            else -> calling _none_float
    if kind == 2:
        return judge v:
            when JsonValue.JvInt with value -> some (value to float)
            else -> calling _none_float
    if kind == 1:
        return judge v:
            when JsonValue.JvBool with value -> some (if value then 1.0 else 0.0)
            else -> calling _none_float
    if kind == 0:
        return some 0.0
    if kind == 4:
        return judge v:
            when JsonValue.JvString with value -> calling _parse_json_float with value
            else -> calling _none_float
    return maybe none

## Coerces `v` to a `bool`.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `some b` for `JvBool`; `false` for `JvNull`; `n != 0` for `JvInt`; `f != 0.0`
## for `JvFloat`; `none` for arrays, objects and strings.
weave json_value_as_bool with v as JsonValue into maybe bool:
    var kind as int is calling _jv_kind with v
    if kind == 1:
        return judge v:
            when JsonValue.JvBool with value -> some value
            else -> calling _none_bool
    if kind == 0:
        return some false
    if kind == 2:
        return judge v:
            when JsonValue.JvInt with value -> some (value != 0)
            else -> calling _none_bool
    if kind == 3:
        return judge v:
            when JsonValue.JvFloat with value -> some (value != 0.0)
            else -> calling _none_bool
    return maybe none

## Coerces `v` to a `string`.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## `some text` for `JvString`; the scalar rendering for `JvInt`, `JvFloat`,
## `JvBool` and `JvNull`; the compact JSON for arrays and objects.
weave json_value_as_string with v as JsonValue into maybe string:
    return some (calling json_value_to_string with v)

# ----------------------------------------------------------------------------
# Typed getters over the legacy flat map
# ----------------------------------------------------------------------------

## Returns the value for `key` in `m` if present.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
## - `key`: the member name. Borrowed.
##
## ## Retorno
## `some raw` (owned) or `none`. The value is the raw JSON text stored by
## `parse_json`.
weave json_get with m as map of string to string, key as string into maybe string:
    if key in m:
        return some (calling m.get with key)
    return maybe none

## Returns the value for `key` in `m`, or `default` when absent.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
## - `key`: the member name. Borrowed.
## - `default`: the fallback (default `""`).
##
## ## Retorno
## The stored raw text or `default` (owned).
weave json_get_or with m as map of string to string, key as string, default as string is "" into string:
    if key in m:
        return calling m.get with key
    return default

## True when `key` is present in the flat JSON map `m`.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
## - `key`: the member name. Borrowed.
##
## ## Retorno
## `true` when the key exists.
weave json_has with m as map of string to string, key as string into bool:
    return key in m

## Retrieves `key` from `m` and parses it as an integer.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
## - `key`: the member name. Borrowed.
##
## ## Retorno
## `some n` (owned) or `none` when the key is absent or the text is not an integer
## that fits an `int`.
weave json_get_int with m as map of string to string, key as string into maybe int:
    var val as maybe string is calling json_get with m, key
    if v as string is val:
        return calling spark.parse_int with v
    return maybe none

## Retrieves `key` from `m` and parses it as a 32-bit float.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
## - `key`: the member name. Borrowed.
##
## ## Retorno
## `some f` (owned) or `none` when the key is absent or the text is not a JSON
## number. The parse is bounded: `1e1000000` is evaluated in at most 60 steps and
## saturates to infinity (2.0.0 looped a million times).
##
## ## Ejemplo
## ```pengu
## calling cipher.json_get_float with m, "ratio"
## ```
weave json_get_float with m as map of string to string, key as string into maybe float:
    var val as maybe string is calling json_get with m, key
    if v as string is val:
        var p as int is 0
        var raw as maybe string is calling _read_number_strict with v, (sigil of p)
        if n as string is raw:
            if p != (v length):
                return maybe none
            return calling _parse_json_float with n
    return maybe none

## Retrieves `key` from `m` and parses it as a boolean.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
## - `key`: the member name. Borrowed.
##
## ## Retorno
## `some true`/`some false` for the exact words `true`/`false`, else `none`.
weave json_get_bool with m as map of string to string, key as string into maybe bool:
    var val as maybe string is calling json_get with m, key
    if v as string is val:
        if v == "true":
            return some true
        if v == "false":
            return some false
    return maybe none

## Retrieves the raw value at `key` as a string.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
## - `key`: the member name. Borrowed.
##
## ## Retorno
## `some raw` (owned) or `none`. Values are stored as JSON raw text: strings
## arrive unquoted, numbers/booleans/nested objects as their literal text. Use
## `json_kind_of` to tell them apart.
weave json_get_string with m as map of string to string, key as string into maybe string:
    return calling json_get with m, key

# ----------------------------------------------------------------------------
# Typed map serializers
# ----------------------------------------------------------------------------

## Serializes a `map of string to int` as compact JSON with sorted keys.
##
## ## Parámetros
## - `data`: the map. Borrowed.
##
## ## Retorno
## An owned JSON object; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## calling cipher.stringify_json_map_int with counts
## ```
weave stringify_json_map_int with data as map of string to int into string:
    var ks as list of string is calling _sorted_map_keys with data
    var parts as list of string is list of string
    calling parts.push with r"{"
    var i as int is 0
    while i < ks.len:
        var key as string is ks at i
        if i > 0:
            calling parts.push with ","
        calling parts.push with (calling _quote with (calling json_escape with key))
        calling parts.push with ":{(data at key)}"
        set i is i + 1
    calling parts.push with r"}"
    return calling _finish_parts with parts

## Serializes a `map of string to float` as compact JSON with sorted keys.
##
## ## Parámetros
## - `data`: the map. Borrowed.
##
## ## Retorno
## An owned JSON object; release it with `banish`.
weave stringify_json_map_float with data as map of string to float into string:
    var ks as list of string is calling _sorted_map_keys with data
    var parts as list of string is list of string
    calling parts.push with r"{"
    var i as int is 0
    while i < ks.len:
        var key as string is ks at i
        if i > 0:
            calling parts.push with ","
        calling parts.push with (calling _quote with (calling json_escape with key))
        calling parts.push with ":"
        calling parts.push with (calling _format_float with (data at key))
        set i is i + 1
    calling parts.push with r"}"
    return calling _finish_parts with parts

## Serializes a `map of string to bool` as compact JSON with sorted keys.
##
## ## Parámetros
## - `data`: the map. Borrowed.
##
## ## Retorno
## An owned JSON object; release it with `banish`.
weave stringify_json_map_bool with data as map of string to bool into string:
    var ks as list of string is calling _sorted_map_keys with data
    var parts as list of string is list of string
    calling parts.push with r"{"
    var i as int is 0
    while i < ks.len:
        var key as string is ks at i
        if i > 0:
            calling parts.push with ","
        calling parts.push with (calling _quote with (calling json_escape with key))
        if (data at key):
            calling parts.push with ":true"
        else:
            calling parts.push with ":false"
        set i is i + 1
    calling parts.push with r"}"
    return calling _finish_parts with parts

# ----------------------------------------------------------------------------
# JSON navigation: cloning, merging, paths and RFC 6901 pointers
# ----------------------------------------------------------------------------

## Creates an independent copy of the flat JSON map `m`.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
##
## ## Retorno
## An owned map with the same members; release it with `banish`. The member
## strings are shared (PenguScript strings are immutable), so only the map itself
## is duplicated.
weave json_deep_clone with m as map of string to string into map of string to string:
    var out as map of string to string is map of string to string
    for k in m:
        calling out.put with k, (m at k)
    return out

## Merges the flat JSON maps `a` and `b`; members of `b` win.
##
## ## Parámetros
## - `a`: the base map. Borrowed.
## - `b`: the overriding map. Borrowed.
##
## ## Retorno
## An owned map holding every member of `a` and `b`; release it with `banish`.
weave json_merge with a as map of string to string, b as map of string to string into map of string to string:
    var out as map of string to string is calling json_deep_clone with a
    for k in b:
        calling out.put with k, (b at k)
    return out

## Deep-copies a `JsonValue` tree.
##
## ## Parámetros
## - `v`: the value. Borrowed.
##
## ## Retorno
## An owned tree with fresh maps and lists (scalars are copied by value); release
## it with `banish`.
weave json_value_deep_clone with v as JsonValue into JsonValue:
    var kind as int is calling _jv_kind with v
    if kind == 5:
        var items as list of JsonValue is calling _jv_items_of with v
        var out as list of JsonValue is list of JsonValue with capacity items.len
        for x in items:
            calling out.push with (calling json_value_deep_clone with x)
        var node as JsonArrayNode is with items is out
        var av as JsonValue is with JvArray is with node is node
        return av
    if kind == 6:
        var pairs as map of string to JsonValue is calling _jv_pairs_of with v
        var out2 as map of string to JsonValue is map of string to JsonValue
        for k in pairs:
            calling out2.put with k, (calling json_value_deep_clone with (pairs at k))
        var node2 as JsonObjectNode is with pairs is out2
        var ov as JsonValue is with JvObject is with node is node2
        return ov
    return v

## Deep structural equality for `JsonValue` trees.
##
## ## Parámetros
## - `a`: the left value. Borrowed.
## - `b`: the right value. Borrowed.
##
## ## Retorno
## `true` when both trees have the same shape, members, elements and scalar
## values. An `int` and a `float` compare equal when their numeric values match.
weave json_value_equal with a as JsonValue, b as JsonValue into bool:
    var ka as int is calling _jv_kind with a
    var kb as int is calling _jv_kind with b
    if ka != kb:
        if (ka == 2 and kb == 3) or (ka == 3 and kb == 2):
            var fa as maybe float is calling json_value_as_float with a
            var fb as maybe float is calling json_value_as_float with b
            if x as float is fa:
                if y as float is fb:
                    return x == y
        return false
    if ka == 0:
        return true
    if ka == 1:
        var ba as maybe bool is calling json_value_as_bool with a
        var bb as maybe bool is calling json_value_as_bool with b
        if x2 as bool is ba:
            if y2 as bool is bb:
                return x2 == y2
        return false
    if ka == 2:
        var ia as maybe int is calling json_value_as_int with a
        var ib as maybe int is calling json_value_as_int with b
        if x3 as int is ia:
            if y3 as int is ib:
                return x3 == y3
        return false
    if ka == 3:
        var xa as maybe float is calling json_value_as_float with a
        var xb as maybe float is calling json_value_as_float with b
        if x4 as float is xa:
            if y4 as float is xb:
                return x4 == y4
        return false
    if ka == 4:
        var sa as maybe string is calling json_value_as_string with a
        var sb as maybe string is calling json_value_as_string with b
        if x5 as string is sa:
            if y5 as string is sb:
                return x5 == y5
        return false
    if ka == 5:
        var la as list of JsonValue is calling _jv_items_of with a
        var lb as list of JsonValue is calling _jv_items_of with b
        if la.len != lb.len:
            return false
        var i as int is 0
        while i < la.len:
            if not (calling json_value_equal with (la at i), (lb at i)):
                return false
            set i is i + 1
        return true
    var ma as map of string to JsonValue is calling _jv_pairs_of with a
    var mb as map of string to JsonValue is calling _jv_pairs_of with b
    if ma.len != mb.len:
        return false
    for k in ma:
        if not (k in mb):
            return false
        if not (calling json_value_equal with (ma at k), (mb at k)):
            return false
    return true

## Shallow merge of two `JsonValue` objects; members of `b` win.
##
## ## Parámetros
## - `a`: the base value. Borrowed.
## - `b`: the overriding value. Borrowed.
##
## ## Retorno
## An owned merged value. When either side is not an object the result is a deep
## clone of `b`. Use `json_merge_patch` for the recursive RFC 7396 semantics.
weave json_value_merge with a as JsonValue, b as JsonValue into JsonValue:
    if (calling _jv_kind with a) != 6 or (calling _jv_kind with b) != 6:
        return calling json_value_deep_clone with b
    var out as map of string to JsonValue is calling _jv_pairs_of with a
    var pb as map of string to JsonValue is calling _jv_pairs_of with b
    for k in pb:
        calling out.put with k, (pb at k)
    var node as JsonObjectNode is with pairs is out
    var ov as JsonValue is with JvObject is with node is node
    return ov

## Applies an RFC 7396 JSON Merge Patch.
##
## ## Parámetros
## - `a`: the target document. Borrowed.
## - `b`: the merge patch. Borrowed.
##
## ## Retorno
## An owned patched value. A `null` member in `b` deletes the member in `a`; a
## non-object patch replaces the target entirely.
##
## ## Ejemplo
## ```pengu
## calling cipher.json_merge_patch with target, patch
## ```
weave json_merge_patch with a as JsonValue, b as JsonValue into JsonValue:
    if (calling _jv_kind with b) != 6:
        return b
    var out as map of string to JsonValue is map of string to JsonValue
    if (calling _jv_kind with a) == 6:
        set out is calling _jv_pairs_of with a
    var pb as map of string to JsonValue is calling _jv_pairs_of with b
    for k in pb:
        var bv as JsonValue is pb at k
        if calling json_value_is_null with bv:
            var kept as map of string to JsonValue is map of string to JsonValue
            for k2 in out:
                if k2 != k:
                    calling kept.put with k2, (out at k2)
            set out is kept
        else:
            var base as JsonValue is JvNull
            if k in out:
                set base is (out at k)
            calling out.put with k, (calling json_merge_patch with base, bv)
    var node as JsonObjectNode is with pairs is out
    var ov as JsonValue is with JvObject is with node is node
    return ov

## Splits a dotted/bracketed path into traversal segments.
##
## ## Parámetros
## - `path`: a legacy path such as `user.name` or `users[0].name`. Borrowed.
##
## ## Retorno
## An owned list of segments (`["users", "0", "name"]`); release it with
## `banish`. Dots and `[n]` groups both separate segments.
weave _parse_path_segments with path as string into list of string:
    var segs as list of string is list of string
    var sl as int is path length
    if sl == 0:
        return segs
    var cur as list of string is list of string
    var i as int is 0
    while i < sl:
        var ch as string is path at i
        if ch == ".":
            if cur.len > 0:
                calling segs.push with (calling _concat_parts with cur)
                set cur is list of string
            set i is i + 1
        else if ch == "[":
            if cur.len > 0:
                calling segs.push with (calling _concat_parts with cur)
                set cur is list of string
            set i is i + 1
            var digits as list of string is list of string
            while i < sl:
                if (path at i) == "]":
                    break
                calling digits.push with (path at i)
                set i is i + 1
            calling segs.push with (calling _concat_parts with digits)
            if i < sl:
                set i is i + 1
        else:
            calling cur.push with ch
            set i is i + 1
    if cur.len > 0:
        calling segs.push with (calling _concat_parts with cur)
    return segs

## Parses one legacy raw value as a `JsonValue`, falling back to a string.
##
## ## Parámetros
## - `raw`: the raw JSON text stored by `parse_json`. Borrowed. A member that is
##   a JSON string arrives unquoted, so `hello` is not a valid JSON document and
##   becomes `JvString("hello")`.
##
## ## Retorno
## An owned value; release it with `banish`.
weave _value_from_raw with raw as string into JsonValue:
    var parsed as maybe JsonValue is calling parse_json_value with raw
    if pv as JsonValue is parsed:
        return pv
    var sv as JsonValue is with JvString is with value is raw
    return sv

## Builds a `JsonValue` object from a flat JSON map.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
##
## ## Retorno
## An owned object value; release it with `banish`. Members that look like JSON
## literals become typed values; the rest become strings.
weave _value_from_map with m as map of string to string into JsonValue:
    var pairs as map of string to JsonValue is map of string to JsonValue
    for k in m:
        calling pairs.put with k, (calling _value_from_raw with (m at k))
    var node as JsonObjectNode is with pairs is pairs
    var out as JsonValue is with JvObject is with node is node
    return out

## Traverses a dotted/bracketed path through a flat JSON map.
##
## ## Parámetros
## - `m`: the flat JSON map produced by `parse_json`. Borrowed.
## - `path`: `user.profile.name`, `users[0].name`, … Borrowed.
##
## ## Retorno
## `some raw` (owned) or `none`. A final string is returned unquoted; any other
## final value is returned as compact JSON. Array indices are supported and
## nested objects keep their braces (2.0.0 dropped the opening brace and could
## not index arrays).
##
## ## Ejemplo
## ```pengu
## calling cipher.json_path with m, "users[0].name"
## ```
weave json_path with m as map of string to string, path as string into maybe string:
    var segs as list of string is calling _parse_path_segments with path
    if segs.len == 0:
        return maybe none
    var cur as JsonValue is calling _value_from_map with m
    var i as int is 0
    while i < segs.len:
        var seg as string is segs at i
        if seg == "":
            return maybe none
        var kind as int is calling _jv_kind with cur
        if kind == 6:
            var child as maybe JsonValue is calling json_value_get with cur, seg
            if cv as JsonValue is child:
                set cur is cv
            else:
                return maybe none
        else if kind == 5:
            var idx as int is calling _segment_index with seg, (calling json_value_len with cur), false
            if idx < 0:
                return maybe none
            var item as maybe JsonValue is calling json_value_at with cur, idx
            if iv as JsonValue is item:
                set cur is iv
            else:
                return maybe none
        else:
            return maybe none
        set i is i + 1
    if calling json_value_is_string with cur:
        return some (calling json_value_to_string with cur)
    return some (calling stringify_json_value with cur)

## Traverses to `path` in `m` and parses the target as a flat JSON map.
##
## ## Parámetros
## - `m`: the flat JSON map. Borrowed.
## - `path`: the traversal path. Borrowed.
##
## ## Retorno
## `some map` (owned) or `none` when the path is missing or the target is not a
## JSON object.
weave json_parse_at with m as map of string to string, path as string into maybe map of string to string:
    var val as maybe string is calling json_path with m, path
    if v as string is val:
        return calling parse_json with v
    return maybe none

## Converts an array index segment into a position, or `-1` when invalid.
##
## ## Parámetros
## - `seg`: the segment text. Borrowed.
## - `n`: the current array length.
## - `allow_end`: `true` when index `n` (append) and `-` are legal.
##
## ## Retorno
## The index, or `-1`. Leading zeros (`"01"`) are rejected per RFC 6901.
weave _segment_index with seg as string, n as int, allow_end as bool into int:
    if seg == "-":
        if allow_end:
            return n
        return -1
    var sl as int is seg length
    if sl == 0:
        return -1
    if sl > 1 and (seg at 0) == "0":
        return -1
    var val as int is 0
    var i as int is 0
    while i < sl:
        var c as int is (calling _byte_at with seg, i)
        if c < 48 or c > 57:
            return -1
        if val > 100000000:
            return -1
        set val is val * 10 + (c - 48)
        set i is i + 1
    if val > n:
        return -1
    if val == n and not allow_end:
        return -1
    return val

## Splits an RFC 6901 JSON Pointer into its unescaped reference tokens.
##
## ## Parámetros
## - `pointer`: the pointer text (`""` is the whole document, otherwise it starts
##   with `/`). Borrowed.
##
## ## Retorno
## `some segments` (owned; release with `banish`) or `none` when the pointer does
## not start with `/`. `~1` becomes `/` and `~0` becomes `~`.
weave _pointer_segments with pointer as string into maybe list of string:
    var segs as list of string is list of string
    if (pointer length) == 0:
        return some segs
    if (pointer at 0) != "/":
        return maybe none
    var raw as list of string is calling pointer.split with "/"
    var i as int is 1
    while i < raw.len:
        var seg as string is raw at i
        var s1 as string is calling seg.get_replace_all with "~1", "/"
        var s2 as string is calling s1.get_replace_all with "~0", "~"
        calling segs.push with s2
        set i is i + 1
    return some segs

## Resolves an RFC 6901 JSON Pointer against a `JsonValue`.
##
## ## Parámetros
## - `v`: the document. Borrowed.
## - `pointer`: the pointer; `""` selects the whole document. Borrowed.
##
## ## Retorno
## `some value` (shared child) or `none` when a token does not resolve.
##
## ## Ejemplo
## ```pengu
## calling cipher.json_pointer_get with v, "/users/0/name"
## ```
weave json_pointer_get with v as JsonValue, pointer as string into maybe JsonValue:
    var segs as maybe list of string is calling _pointer_segments with pointer
    if s as list of string is segs:
        return calling _jv_get with v, s, 0
    return maybe none

## Recursive resolver behind `json_pointer_get` (private).
##
## ## Parámetros
## - `v`: the current value. Borrowed.
## - `segs`: the reference tokens. Borrowed.
## - `i`: the current token index.
##
## ## Retorno
## `some value` or `none`.
weave _jv_get with v as JsonValue, segs as list of string, i as int into maybe JsonValue:
    if i >= segs.len:
        return some v
    var seg as string is segs at i
    var kind as int is calling _jv_kind with v
    if kind == 6:
        var child as maybe JsonValue is calling json_value_get with v, seg
        if cv as JsonValue is child:
            return calling _jv_get with cv, segs, i + 1
        return maybe none
    if kind == 5:
        var idx as int is calling _segment_index with seg, (calling json_value_len with v), false
        if idx < 0:
            return maybe none
        var item as maybe JsonValue is calling json_value_at with v, idx
        if iv as JsonValue is item:
            return calling _jv_get with iv, segs, i + 1
        return maybe none
    return maybe none

## Recursive "add" and "replace" behind `json_patch` (private).
##
## ## Parámetros
## - `root`: the document. Borrowed.
## - `segs`: the target pointer tokens. Borrowed.
## - `i`: the current token index.
## - `value`: the value to insert.
## - `replace_only`: `true` for RFC 6902 `replace` (the target must exist and no
##   insertion or `-` index is allowed).
##
## ## Retorno
## `some patched document` (owned) or `none` when the path does not resolve.
weave _jv_put with root as JsonValue, segs as list of string, i as int, value as JsonValue, replace_only as bool into maybe JsonValue:
    if i >= segs.len:
        return some value
    var seg as string is segs at i
    var kind as int is calling _jv_kind with root
    if kind == 6:
        var pairs as map of string to JsonValue is calling _jv_pairs_of with root
        if seg in pairs:
            if i == (segs.len - 1):
                calling pairs.put with seg, value
            else:
                var child as maybe JsonValue is calling _jv_put with (pairs at seg), segs, i + 1, value, replace_only
                if cv as JsonValue is child:
                    calling pairs.put with seg, cv
                else:
                    return maybe none
        else:
            if replace_only:
                return maybe none
            if i != (segs.len - 1):
                return maybe none
            calling pairs.put with seg, value
        var onode as JsonObjectNode is with pairs is pairs
        var ovalue as JsonValue is with JvObject is with node is onode
        return some ovalue
    if kind == 5:
        var items as list of JsonValue is calling _jv_items_of with root
        var n as int is items.len
        var pos as int is calling _segment_index with seg, n, (not replace_only)
        if pos < 0:
            return maybe none
        if i == (segs.len - 1):
            if not replace_only:
                var out as list of JsonValue is list of JsonValue with capacity n + 1
                var k as int is 0
                while k < n:
                    if k == pos:
                        calling out.push with value
                    calling out.push with (items at k)
                    set k is k + 1
                if pos == n:
                    calling out.push with value
                var inode as JsonArrayNode is with items is out
                var ivalue as JsonValue is with JvArray is with node is inode
                return some ivalue
            set items at pos is value
        else:
            if pos >= n:
                return maybe none
            var child2 as maybe JsonValue is calling _jv_put with (items at pos), segs, i + 1, value, replace_only
            if cv2 as JsonValue is child2:
                set items at pos is cv2
            else:
                return maybe none
        var inode2 as JsonArrayNode is with items is items
        var ivalue2 as JsonValue is with JvArray is with node is inode2
        return some ivalue2
    return maybe none

## Recursive "remove" behind `json_patch` (private).
##
## ## Parámetros
## - `root`: the document. Borrowed.
## - `segs`: the target pointer tokens. Borrowed.
## - `i`: the current token index.
##
## ## Retorno
## `some patched document` (owned) or `none` when the path does not resolve.
weave _jv_remove with root as JsonValue, segs as list of string, i as int into maybe JsonValue:
    if i >= segs.len:
        return maybe none
    var seg as string is segs at i
    var kind as int is calling _jv_kind with root
    if kind == 6:
        var pairs as map of string to JsonValue is calling _jv_pairs_of with root
        if not (seg in pairs):
            return maybe none
        if i == (segs.len - 1):
            var out as map of string to JsonValue is map of string to JsonValue
            for k in pairs:
                if k != seg:
                    calling out.put with k, (pairs at k)
            var onode as JsonObjectNode is with pairs is out
            var ovalue as JsonValue is with JvObject is with node is onode
            return some ovalue
        var child as maybe JsonValue is calling _jv_remove with (pairs at seg), segs, i + 1
        if cv as JsonValue is child:
            calling pairs.put with seg, cv
        else:
            return maybe none
        var onode2 as JsonObjectNode is with pairs is pairs
        var ovalue2 as JsonValue is with JvObject is with node is onode2
        return some ovalue2
    if kind == 5:
        var items as list of JsonValue is calling _jv_items_of with root
        var n as int is items.len
        var pos as int is calling _segment_index with seg, n, false
        if pos < 0:
            return maybe none
        if i == (segs.len - 1):
            var out2 as list of JsonValue is list of JsonValue with capacity n
            var k2 as int is 0
            while k2 < n:
                if k2 != pos:
                    calling out2.push with (items at k2)
                set k2 is k2 + 1
            var inode as JsonArrayNode is with items is out2
            var ivalue as JsonValue is with JvArray is with node is inode
            return some ivalue
        var child2 as maybe JsonValue is calling _jv_remove with (items at pos), segs, i + 1
        if cv2 as JsonValue is child2:
            set items at pos is cv2
        else:
            return maybe none
        var inode2 as JsonArrayNode is with items is items
        var ivalue2 as JsonValue is with JvArray is with node is inode2
        return some ivalue2
    return maybe none

## Reads a string member of an operation object.
##
## ## Parámetros
## - `op`: the operation object. Borrowed.
## - `name`: the member name. Borrowed.
##
## ## Retorno
## `some text` (owned) when the member exists and is a JSON string, else `none`.
weave _op_field with op as JsonValue, name as string into maybe string:
    var got as maybe JsonValue is calling json_value_get with op, name
    if gv as JsonValue is got:
        if calling json_value_is_string with gv:
            return some (calling json_value_to_string with gv)
    return maybe none

## Applies an RFC 6902 JSON Patch document.
##
## ## Parámetros
## - `v`: the target document. Borrowed.
## - `patch`: a `JsonValue` that must be an array of operation objects (`add`,
##   `remove`, `replace`, `move`, `copy`, `test`). Borrowed.
##
## ## Retorno
## `ok patched` or `err message` (a `result of JsonValue to string`).
##
## ## Ejemplo
## ```pengu
## var r as result of cipher.JsonValue to string is calling cipher.json_patch with doc, patch
## ```
weave json_patch with v as JsonValue, patch as JsonValue into result of JsonValue to string:
    if (calling _jv_kind with patch) != 5:
        return calling err_of with "json_patch: patch must be an array of operations"
    var ops as list of JsonValue is calling _jv_items_of with patch
    return calling _json_patch_ops with v, ops, 0

## Applies the operations of a patch document in order (private, recursive).
##
## ## Parámetros
## - `root`: the document after the operations applied so far. Borrowed.
## - `ops`: the operation list. Borrowed.
## - `i`: the index of the next operation.
##
## ## Retorno
## `ok patched` or `err message`.
weave _json_patch_ops with root as JsonValue, ops as list of JsonValue, i as int into result of JsonValue to string:
    if i >= ops.len:
        return calling ok_of with root
    var op as JsonValue is ops at i
    if (calling _jv_kind with op) != 6:
        return calling err_of with "json_patch: operation is not an object"
    var opname as maybe string is calling _op_field with op, "op"
    var path_text as maybe string is calling _op_field with op, "path"
    if os as string is opname:
        if ps as string is path_text:
            var segs as maybe list of string is calling _pointer_segments with ps
            if sg as list of string is segs:
                if os == "test":
                    var want as maybe JsonValue is calling json_value_get with op, "value"
                    if wv as JsonValue is want:
                        var got as maybe JsonValue is calling _jv_get with root, sg, 0
                        if gv as JsonValue is got:
                            if calling json_value_equal with gv, wv:
                                return calling _json_patch_ops with root, ops, i + 1
                            return calling err_of with "json_patch: test failed at {ps}"
                    return calling err_of with "json_patch: test operation without value"
                if os == "remove":
                    var removed as maybe JsonValue is calling _jv_remove with root, sg, 0
                    if rv as JsonValue is removed:
                        return calling _json_patch_ops with rv, ops, i + 1
                    return calling err_of with "json_patch: cannot remove {ps}"
                if os == "add" or os == "replace":
                    var value as maybe JsonValue is calling json_value_get with op, "value"
                    if vv as JsonValue is value:
                        var added as maybe JsonValue is calling _jv_put with root, sg, 0, vv, (os == "replace")
                        if av as JsonValue is added:
                            return calling _json_patch_ops with av, ops, i + 1
                        return calling err_of with "json_patch: {os} failed at {ps}"
                    return calling err_of with "json_patch: {os} without value"
                if os == "copy" or os == "move":
                    var from as maybe string is calling _op_field with op, "from"
                    if fs as string is from:
                        var fsegs as maybe list of string is calling _pointer_segments with fs
                        if fg as list of string is fsegs:
                            var src as maybe JsonValue is calling _jv_get with root, fg, 0
                            if sv as JsonValue is src:
                                var cloned as JsonValue is calling json_value_deep_clone with sv
                                var base_root as JsonValue is root
                                if os == "move":
                                    var pulled as maybe JsonValue is calling _jv_remove with root, fg, 0
                                    if rv2 as JsonValue is pulled:
                                        set base_root is rv2
                                    else:
                                        return calling err_of with "json_patch: move source {fs} missing"
                                var placed as maybe JsonValue is calling _jv_put with base_root, sg, 0, cloned, false
                                if av2 as JsonValue is placed:
                                    return calling _json_patch_ops with av2, ops, i + 1
                                return calling err_of with "json_patch: {os} target {ps} failed"
                            return calling err_of with "json_patch: {os} source {fs} missing"
                    return calling err_of with "json_patch: {os} without from"
                return calling err_of with "json_patch: unknown operation {os}"
            return calling err_of with "json_patch: invalid pointer {ps}"
    return calling err_of with "json_patch: operation without op/path"

# ----------------------------------------------------------------------------
# JSON Validation
# ----------------------------------------------------------------------------

## True when `json` is a single valid JSON object or array.
##
## ## Parámetros
## - `json`: the document. Borrowed.
##
## ## Retorno
## `true` for a well-formed object or array. Scalars are rejected (use
## `is_valid_json_value`).
weave is_valid_json with json as string into bool:
    if (calling parse_json with json).is_present:
        return true
    if (calling parse_json_array with json).is_present:
        return true
    return false

## True when `v` is any single valid JSON value.
##
## ## Parámetros
## - `v`: the document. Borrowed.
##
## ## Retorno
## `true` for objects, arrays, strings, numbers, booleans and `null`. Trailing
## content is rejected (2.0.0 accepted `"1 2 3"`).
weave is_valid_json_value with v as string into bool:
    return (calling parse_json_value with v).is_present

# ----------------------------------------------------------------------------
# File helpers (I/O via std.archivum)
# ----------------------------------------------------------------------------

## Reads the file at `path` and parses it as a JSON object.
##
## ## Parámetros
## - `path`: the file to read. Borrowed.
##
## ## Retorno
## `some map` (owned) or `none` when the file cannot be read or is not a valid
## JSON object.
weave read_json_file with path as string into maybe map of string to string:
    var content as maybe string is calling archivum.read_file with path
    if c as string is content:
        return calling parse_json with c
    return maybe none

## Serializes `data` as compact JSON and writes it to `path`.
##
## ## Parámetros
## - `path`: the destination file. Borrowed.
## - `data`: the flat JSON map. Borrowed.
##
## ## Retorno
## `true` when the write succeeded.
weave write_json_file with path as string, data as map of string to string into bool:
    var json as maybe string is calling stringify_json with data
    if j as string is json:
        return calling archivum.write_file with path, j
    return false

## Serializes `data` as indented JSON and writes it to `path`.
##
## ## Parámetros
## - `path`: the destination file. Borrowed.
## - `data`: the flat JSON map. Borrowed.
## - `indent`: spaces per level (default `2`).
##
## ## Retorno
## `true` when the write succeeded.
weave write_json_file_pretty with path as string, data as map of string to string, indent as int is 2 into bool:
    var json as maybe string is calling pretty_json with data, indent
    if j as string is json:
        return calling archivum.write_file with path, j
    return false

# ----------------------------------------------------------------------------
# Tests
#
# Private harness: `std.ward` cannot be imported here (it would be a cycle), so
# the assertions use `std.spark` directly, like the other migrated modules.
# ----------------------------------------------------------------------------

## Replaces the `^` placeholder with a double quote.
##
## ## Parámetros
## - `s`: the template text. Borrowed.
##
## ## Retorno
## An owned string with every `^` turned into `"`; release it with `banish`. Raw
## strings cannot contain a double quote, so the JSON fixtures below spell their
## quotes as `^`.
weave _dq with s as string into string:
    var q as string is calling _quote_char
    return calling s.get_replace_all with "^", q

## Aborts unless `cond` holds.
weave _expect_true with cond as bool, label as string into void:
    if not cond:
        calling spark.println with "FAIL {label}"
        calling spark.panic with "cipher: test failed"

## Aborts unless the two ints are equal.
weave _expect_eq_int with got as int, want as int, label as string into void:
    if got != want:
        calling spark.println with "FAIL {label}: got {got}, want {want}"
        calling spark.panic with "cipher: test failed"

## Aborts unless the two strings are byte-equal.
weave _expect_eq_string with got as string, want as string, label as string into void:
    if (calling scrolls.compare with got, want) != 0:
        calling spark.println with "FAIL {label}: got \"{got}\", want \"{want}\""
        calling spark.panic with "cipher: test failed"

## Aborts unless the maybe string is present and equals `want`.
weave _expect_some_string with got as maybe string, want as string, label as string into void:
    if v as string is got:
        calling _expect_eq_string with v, want, label
    else:
        calling spark.println with "FAIL {label}: expected some \"{want}\", got none"
        calling spark.panic with "cipher: test failed"

test "CIPHER_VERSION is the frozen 2.1.0 contract":
    calling _expect_eq_string with CIPHER_VERSION, "2.1.0", "version literal"

test "BUG-C1: Base64 encodes a long input without quadratic blow-up":
    var parts as list of string is list of string with capacity 4096
    var i as int is 0
    while i < 4096:
        calling parts.push with "0123456789abcdef"
        set i is i + 1
    var data as string is calling _concat_parts with parts
    calling _expect_eq_int with (data length), 65536, "input length"
    var b64 as string is calling encode_base64 with data
    calling _expect_eq_int with (b64 length), 87384, "base64 length"
    var back as maybe string is calling decode_base64 with b64
    if v as string is back:
        calling _expect_true with (v == data), "roundtrip"
    else:
        calling spark.panic with "cipher: base64 roundtrip failed"

test "BUG-C1: Hex and Base32 encode long inputs linearly":
    var parts as list of string is list of string with capacity 2048
    var i as int is 0
    while i < 2048:
        calling parts.push with "abcdefghijklmnop"
        set i is i + 1
    var data as string is calling _concat_parts with parts
    var hex as string is calling encode_hex with data
    calling _expect_eq_int with (hex length), 65536, "hex length"
    var hb as maybe string is calling decode_hex with hex
    if b as string is hb:
        calling _expect_true with (b == data), "hex roundtrip"
    else:
        calling spark.panic with "cipher: hex roundtrip failed"
    var b32 as string is calling encode_base32 with data
    var back as maybe string is calling decode_base32 with b32
    if bv as string is back:
        calling _expect_true with (bv == data), "base32 roundtrip"
    else:
        calling spark.panic with "cipher: base32 roundtrip failed"

test "encode_base64/decode_base64 round-trip the documented example":
    calling _expect_eq_string with (calling encode_base64 with "hello"), "aGVsbG8=", "hello"
    calling _expect_some_string with (calling decode_base64 with "aGVsbG8="), "hello", "hello back"

test "BUG-C14: decode_base64 rejects characters outside the alphabet":
    calling _expect_true with (not (calling decode_base64 with "AB*D").is_present), "star"
    calling _expect_true with (not (calling decode_base64 with "AB-D").is_present), "url dash is not standard"
    calling _expect_true with (calling decode_base64_url with "AB-D").is_present, "url dash accepted"

test "BUG-C15: decode_base64 rejects misplaced and excessive padding":
    calling _expect_true with (not (calling decode_base64 with "QQ==QQ==").is_present), "padding in the middle"
    calling _expect_true with (not (calling decode_base64 with "====").is_present), "only padding"
    calling _expect_true with (not (calling decode_base64 with "Q===").is_present), "three pads"
    calling _expect_some_string with (calling decode_base64 with ""), "", "empty"

test "encode_base64_url and decode_base64_url round-trip binary bytes":
    var b251 as int is 251
    var b255 as int is 255
    var b0 as int is 0
    var blob as string is "{(chr b251)}{(chr b255)}{(chr b0)}"
    var enc as string is calling encode_base64_url with blob
    calling _expect_eq_string with enc, "-_8A", "url encoding"
    var dec as maybe string is calling decode_base64_url with enc
    if v as string is dec:
        calling _expect_eq_int with (v length), 3, "decoded length"
    else:
        calling spark.panic with "cipher: url decode failed"

test "base64_length matches the encoder":
    calling _expect_eq_int with (calling base64_length with 0), 0, "0"
    calling _expect_eq_int with (calling base64_length with 1), 4, "1"
    calling _expect_eq_int with (calling base64_length with 3), 4, "3"
    calling _expect_eq_int with (calling base64_length with 4), 8, "4"

test "BUG-C12: _hex_val rejects multi-character input":
    calling _expect_eq_int with (calling _hex_val with "a"), 10, "single"
    calling _expect_eq_int with (calling _hex_val with "ab"), -1, "multi"
    calling _expect_eq_int with (calling _hex_val with ""), -1, "empty"
    calling _expect_eq_int with (calling _hex_val with "z"), -1, "non hex"

test "BUG-C13: cb64_val and _b32_val reject multi-character input":
    calling _expect_eq_int with (calling cb64_val with "+"), 62, "plus"
    calling _expect_eq_int with (calling cb64_val with "ab"), -2, "multi"
    calling _expect_eq_int with (calling cb64_val with ""), -2, "empty"
    calling _expect_eq_int with (calling _b32_val with "7"), 31, "seven"
    calling _expect_eq_int with (calling _b32_val with "77"), -2, "multi"

test "BUG-C19: decode_base32 rejects padding that does not close the string":
    calling _expect_true with (not (calling decode_base32 with "AA======AA======").is_present), "two groups"
    calling _expect_true with (not (calling decode_base32 with "AB======AA======").is_present), "mixed groups"
    calling _expect_some_string with (calling decode_base32 with "NBUQ===="), "hi", "hi"
    calling _expect_true with (calling decode_base32 with "AA======").is_present, "one padded group"

test "Base32 is case-insensitive and ignores whitespace":
    calling _expect_some_string with (calling decode_base32 with "nbuq===="), "hi", "lowercase"
    calling _expect_some_string with (calling decode_base32 with "NBUQ ===="), "hi", "space"

test "BUG-C2: json_unescape combines a surrogate pair into one code point":
    var esc as string is "\\uD83D\\uDE00"
    var decoded as string is calling json_unescape with esc
    calling _expect_eq_int with (decoded length), 4, "utf8 byte length"
    var hex as string is calling encode_hex with decoded
    calling _expect_eq_string with hex, "f09f9880", "utf8 bytes"

test "json_unescape keeps lone surrogates as CESU-8 (lenient mode)":
    var esc as string is "\\uD83D"
    var decoded as string is calling json_unescape with esc
    calling _expect_eq_string with (calling encode_hex with decoded), "eda0bd", "cesu8"

test "json_unescape handles the short escapes":
    calling _expect_eq_string with (calling json_unescape with "a\\nb"), "a{(chr 10)}b", "newline"
    calling _expect_eq_string with (calling json_unescape with "a\\tb"), "a{(chr 9)}b", "tab"
    calling _expect_eq_string with (calling json_unescape with "\\\""), "\"", "quote"
    calling _expect_eq_string with (calling json_unescape with "\\\\"), "\\", "backslash"

test "json_escape uses the short escapes and \\u00XX for controls":
    calling _expect_eq_string with (calling json_escape with "a\"b"), "a\\\"b", "quote"
    calling _expect_eq_string with (calling json_escape with "a\\b"), "a\\\\b", "backslash"
    calling _expect_eq_string with (calling json_escape with "a\nb"), "a\\nb", "newline"
    calling _expect_eq_string with (calling json_escape with "a{(chr 1)}b"), "a\\u0001b", "control"

test "BUG-C5: parse_json rejects incomplete literals and trailing commas":
    var ob as string is r"{"
    var cb as string is r"}"
    var q as string is calling _quote_char
    calling _expect_true with (not (calling parse_json with "{ob}{q}a{q}: tru{cb}").is_present), "tru"
    calling _expect_true with (not (calling parse_json with "{ob}{q}a{q}: 1,{cb}").is_present), "trailing comma"
    calling _expect_true with (not (calling parse_json with "{ob}{q}a{q}:{cb}").is_present), "empty value"
    calling _expect_true with (not (calling parse_json with "{ob}{q}a{q}: 1{cb} trailing").is_present), "trailing content"
    calling _expect_true with (not (calling parse_json with "{ob}{q}a{q}: 1 2 3{cb}").is_present), "garbage after number"

test "BUG-C4: parse_json rejects unescaped control bytes and invalid UTF-8":
    var ob as string is r"{"
    var cb as string is r"}"
    var q as string is calling _quote_char
    var ctrl as string is "{ob}{q}a{q}: {q}x{(chr 1)}y{q}{cb}"
    calling _expect_true with (not (calling parse_json with ctrl).is_present), "raw control"
    var b255 as int is 255
    var bad_utf8 as string is "{ob}{q}a{q}: {q}{(chr b255)}{q}{cb}"
    calling _expect_true with (not (calling parse_value with bad_utf8).is_present), "invalid utf8"

test "BUG-C8: parse_json keeps the full braces of a nested object":
    var ob as string is r"{"
    var cb as string is r"}"
    var q as string is calling _quote_char
    var doc as string is "{ob}{q}a{q}: {ob}{q}b{q}: 1{cb}{cb}"
    var m as maybe map of string to string is calling parse_json with doc
    if mv as map of string to string is m:
        var inner as string is calling mv.get with "a"
        calling _expect_eq_string with inner, "{ob}{q}b{q}: 1{cb}", "nested raw value"
        calling _expect_true with (calling json_is_literal with inner), "nested value is a literal"
    else:
        calling spark.panic with "cipher: nested parse failed"

test "BUG-C24: stringify_json sorts keys deterministically":
    var m as map of string to string is map of string to string
    calling m.put with "b", "2"
    calling m.put with "a", "1"
    calling m.put with "c", "3"
    var out as maybe string is calling stringify_json with m
    calling _expect_some_string with out, (calling _dq with r"{^a^:1,^b^:2,^c^:3}"), "sorted"

test "stringify_json emits raw literals and escapes strings":
    var q as string is calling _quote_char
    var m as map of string to string is map of string to string
    calling m.put with "n", "42"
    calling m.put with "s", "a b"
    var out as maybe string is calling stringify_json with m
    calling _expect_some_string with out, (calling _dq with r"{^n^:42,^s^:^a b^}"), "mixed"

test "parse_value validates the whole input":
    calling _expect_true with (not (calling parse_value with "1 2 3").is_present), "trailing garbage"
    calling _expect_true with (not (calling parse_value with "tru").is_present), "incomplete literal"
    calling _expect_some_string with (calling parse_value with "[1, 2]"), "[1, 2]", "array text"
    calling _expect_true with (not (calling is_valid_json_value with "1 2 3")), "validator agrees"

test "BUG-C9: json_get_float bounds the exponent":
    var q as string is calling _quote_char
    var ob as string is r"{"
    var cb as string is r"}"
    var doc as string is "{ob}{q}a{q}: 1e1000000{cb}"
    var m as maybe map of string to string is calling parse_json with doc
    if mv as map of string to string is m:
        var f as maybe float is calling json_get_float with mv, "a"
        if fv as float is f:
            calling _expect_true with (fv > 1000000.0), "saturates instead of looping"
        else:
            calling spark.panic with "cipher: float parse failed"
    else:
        calling spark.panic with "cipher: doc parse failed"

test "json_get_float parses ordinary numbers":
    var q as string is calling _quote_char
    var ob as string is r"{"
    var cb as string is r"}"
    var doc as string is "{ob}{q}a{q}: -2.5e2{cb}"
    var m as maybe map of string to string is calling parse_json with doc
    if mv as map of string to string is m:
        var f as maybe float is calling json_get_float with mv, "a"
        if fv as float is f:
            calling _expect_true with (fv < -249.0 and fv > -251.0), "value"
        else:
            calling spark.panic with "cipher: float parse failed"
    else:
        calling spark.panic with "cipher: doc parse failed"

test "parse_json_value builds the generic tree":
    var ob as string is r"{"
    var cb as string is r"}"
    var q as string is calling _quote_char
    var doc as string is "{ob}{q}name{q}:{q}Ada{q},{q}age{q}:36,{q}tags{q}:[{q}a{q},{q}b{q}],{q}ok{q}:true{cb}"
    var v as maybe JsonValue is calling parse_json_value with doc
    if jv as JsonValue is v:
        calling _expect_eq_string with (calling json_value_type with jv), "object", "type"
        calling _expect_eq_int with (calling json_value_len with jv), 4, "member count"
        var name as maybe JsonValue is calling json_value_get with jv, "name"
        if nv as JsonValue is name:
            calling _expect_true with (calling json_value_is_string with nv), "name is a string"
            calling _expect_eq_string with (calling json_value_to_string with nv), "Ada", "name value"
        else:
            calling spark.panic with "cipher: name missing"
        var age as maybe JsonValue is calling json_value_get with jv, "age"
        if av as JsonValue is age:
            calling _expect_true with (calling json_value_is_int with av), "age is an int"
            calling _expect_eq_int with (calling json_value_as_int with av).value, 36, "age value"
        var tags as maybe JsonValue is calling json_value_get with jv, "tags"
        if tv as JsonValue is tags:
            calling _expect_true with (calling json_value_is_array with tv), "tags is an array"
            calling _expect_eq_int with (calling json_value_len with tv), 2, "tags length"
            var first_tag as maybe JsonValue is calling json_value_at with tv, 0
            if fv as JsonValue is first_tag:
                calling _expect_eq_string with (calling json_value_to_string with fv), "a", "first tag"
        var okv as maybe JsonValue is calling json_value_get with jv, "ok"
        if ov as JsonValue is okv:
            calling _expect_true with (calling json_value_as_bool with ov).value, "ok is true"
    else:
        calling spark.panic with "cipher: generic parse failed"

test "parse_json_value rejects trailing commas and lone surrogates (strict mode)":
    var ob as string is r"{"
    var cb as string is r"}"
    var q as string is calling _quote_char
    calling _expect_true with (not (calling parse_json_value with "{ob}{q}a{q}: 1,{cb}").is_present), "trailing comma"
    var lone as string is "{q}\\uD83D{q}"
    calling _expect_true with (not (calling parse_json_value with lone).is_present), "lone surrogate"
    var pair as string is "{q}\\uD83D\\uDE00{q}"
    var pv as maybe JsonValue is calling parse_json_value with pair
    if sv as JsonValue is pv:
        var text as string is calling json_value_to_string with sv
        calling _expect_eq_string with (calling encode_hex with text), "f09f9880", "surrogate pair"
    else:
        calling spark.panic with "cipher: surrogate pair parse failed"

test "generic round-trip: parse then stringify is stable":
    var doc as string is calling _dq with r"[1, {^a^: [true, null, ^x^]}, -2.5]"
    var v as maybe JsonValue is calling parse_json_value with doc
    if jv as JsonValue is v:
        var out as string is calling stringify_json_value with jv
        var again as maybe JsonValue is calling parse_json_value with out
        if av as JsonValue is again:
            calling _expect_true with (calling json_value_equal with jv, av), "stable round-trip"
        else:
            calling spark.panic with "cipher: reparse failed"
    else:
        calling spark.panic with "cipher: parse failed"

test "stringify_json_value_pretty indents nested members":
    var doc as string is r"[1, 2]"
    var v as maybe JsonValue is calling parse_json_value with doc
    if jv as JsonValue is v:
        var out as string is calling stringify_json_value_pretty with jv, 2
        calling _expect_eq_string with out, "[\n  1,\n  2\n]", "pretty array"
    else:
        calling spark.panic with "cipher: parse failed"

test "json_value_as_* coerce across kinds":
    var doc as string is calling _dq with r"[42, 4.5, ^7^, true, null]"
    var v as maybe list of JsonValue is calling parse_json_to_list with doc
    if xs as list of JsonValue is v:
        calling _expect_eq_int with (calling json_value_as_int with (xs at 0)).value, 42, "int"
        calling _expect_eq_int with (calling json_value_as_int with (xs at 1)).value, 4, "float to int"
        calling _expect_eq_int with (calling json_value_as_int with (xs at 2)).value, 7, "string to int"
        calling _expect_true with (calling json_value_as_bool with (xs at 3)).value, "bool"
        calling _expect_true with (not (calling json_value_as_bool with (xs at 4)).value), "null is false"
    else:
        calling spark.panic with "cipher: list parse failed"

test "json_value_deep_clone is independent and equal":
    var doc as string is calling _dq with r"{^a^: [1, 2]}"
    var v as maybe JsonValue is calling parse_json_value with doc
    if jv as JsonValue is v:
        var copy as JsonValue is calling json_value_deep_clone with jv
        calling _expect_true with (calling json_value_equal with jv, copy), "clone equals"
        calling _expect_eq_string with (calling stringify_json_value with copy), (calling stringify_json_value with jv), "clone text"
    else:
        calling spark.panic with "cipher: parse failed"

test "BUG-C23: json_path walks arrays and keeps nested braces":
    var q as string is calling _quote_char
    var ob as string is r"{"
    var cb as string is r"}"
    var inner as string is "{ob}{q}b{q}: 1{cb}"
    var arr as string is "[{ob}{q}b{q}: 1{cb},{ob}{q}b{q}: 2{cb}]"
    var m as map of string to string is map of string to string
    calling m.put with "users", arr
    calling m.put with "top", inner
    calling _expect_some_string with (calling json_path with m, "users[1].b"), "2", "array index"
    calling _expect_some_string with (calling json_path with m, "top.b"), "1", "nested object"
    calling _expect_true with (not (calling json_path with m, "users[9].b").is_present), "out of range"

test "json_pointer_get resolves RFC 6901 pointers":
    var doc as string is calling _dq with r"{^users^: [{^name^: ^Ada^}, {^name^: ^Bob^}], ^a/b^: 1, ^m~n^: 2}"
    var v as maybe JsonValue is calling parse_json_value with doc
    if jv as JsonValue is v:
        var n as maybe JsonValue is calling json_pointer_get with jv, "/users/1/name"
        if nv as JsonValue is n:
            calling _expect_eq_string with (calling json_value_to_string with nv), "Bob", "escape free"
        else:
            calling spark.panic with "cipher: pointer miss"
        var slash as maybe JsonValue is calling json_pointer_get with jv, "/a~1b"
        if sv as JsonValue is slash:
            calling _expect_eq_int with (calling json_value_as_int with sv).value, 1, "escaped slash"
        var tilde as maybe JsonValue is calling json_pointer_get with jv, "/m~0n"
        if tv as JsonValue is tilde:
            calling _expect_eq_int with (calling json_value_as_int with tv).value, 2, "escaped tilde"
        var root as maybe JsonValue is calling json_pointer_get with jv, ""
        calling _expect_true with (root.is_present), "empty pointer is the root"
        calling _expect_true with (not (calling json_pointer_get with jv, "users").is_present), "missing slash"
    else:
        calling spark.panic with "cipher: parse failed"

test "json_patch applies add, replace, remove and test":
    var doc as string is calling _dq with r"{^a^: 1, ^b^: [1, 2]}"
    var patch as string is calling _dq with r"[{^op^: ^add^, ^path^: ^/c^, ^value^: 3}, {^op^: ^replace^, ^path^: ^/a^, ^value^: 9}, {^op^: ^remove^, ^path^: ^/b/0^}, {^op^: ^test^, ^path^: ^/c^, ^value^: 3}]"
    var d as maybe JsonValue is calling parse_json_value with doc
    var p as maybe JsonValue is calling parse_json_value with patch
    if dv as JsonValue is d:
        if pv as JsonValue is p:
            var r as result of JsonValue to string is calling json_patch with dv, pv
            if r.is_ok:
                var out as JsonValue is calling r.unwrap
                calling _expect_eq_string with (calling stringify_json_value with out), (calling _dq with r"{^a^:9,^b^:[2],^c^:3}"), "patched"
            else:
                calling spark.println with "patch error: {calling r.unwrap_err}"
                calling spark.panic with "cipher: patch failed"
        else:
            calling spark.panic with "cipher: patch parse failed"
    else:
        calling spark.panic with "cipher: doc parse failed"

test "json_patch reports a failing test operation":
    var doc as string is calling _dq with r"{^a^: 1}"
    var patch as string is calling _dq with r"[{^op^: ^test^, ^path^: ^/a^, ^value^: 2}]"
    var d as maybe JsonValue is calling parse_json_value with doc
    var p as maybe JsonValue is calling parse_json_value with patch
    if dv as JsonValue is d:
        if pv as JsonValue is p:
            var r as result of JsonValue to string is calling json_patch with dv, pv
            calling _expect_true with (not (r.is_ok)), "test must fail"
        else:
            calling spark.panic with "cipher: patch parse failed"
    else:
        calling spark.panic with "cipher: doc parse failed"

test "json_merge_patch follows RFC 7396":
    var doc as string is calling _dq with r"{^a^: 1, ^b^: {^x^: 1, ^y^: 2}}"
    var patch as string is calling _dq with r"{^a^: null, ^b^: {^y^: 5, ^z^: 6}}"
    var d as maybe JsonValue is calling parse_json_value with doc
    var p as maybe JsonValue is calling parse_json_value with patch
    if dv as JsonValue is d:
        if pv as JsonValue is p:
            var out as JsonValue is calling json_merge_patch with dv, pv
            calling _expect_eq_string with (calling stringify_json_value with out), (calling _dq with r"{^b^:{^x^:1,^y^:5,^z^:6}}"), "merged"
        else:
            calling spark.panic with "cipher: patch parse failed"
    else:
        calling spark.panic with "cipher: doc parse failed"

test "json_dumps_canonical sorts keys at every level":
    var doc as string is calling _dq with r"{^b^: 1, ^a^: {^d^: 2, ^c^: 3}}"
    var v as maybe JsonValue is calling parse_json_value with doc
    if jv as JsonValue is v:
        calling _expect_eq_string with (calling json_dumps_canonical with jv), (calling _dq with r"{^a^:{^c^:3,^d^:2},^b^:1}"), "canonical"
    else:
        calling spark.panic with "cipher: parse failed"

test "Base85 matches the RFC 1924 examples":
    calling _expect_eq_string with (calling encode_base85 with ""), "", "empty"
    calling _expect_eq_string with (calling encode_base85 with "a"), "VE", "one byte"
    calling _expect_eq_string with (calling encode_base85 with "abc"), "VPaz", "three bytes"
    calling _expect_eq_string with (calling encode_base85 with "abcd"), "VPa!s", "four bytes"
    calling _expect_some_string with (calling decode_base85 with "VPaz"), "abc", "decode"
    calling _expect_true with (not (calling decode_base85 with "V").is_present), "one char is invalid"

test "Z85 matches the ZeroMQ test vector":
    var c0 as int is 134
    var c1 as int is 79
    var c2 as int is 210
    var c3 as int is 111
    var c4 as int is 181
    var c5 as int is 89
    var c6 as int is 247
    var c7 as int is 91
    var raw as string is "{(chr c0)}{(chr c1)}{(chr c2)}{(chr c3)}{(chr c4)}{(chr c5)}{(chr c6)}{(chr c7)}"
    calling _expect_eq_string with (calling encode_base85_z85 with raw), "HelloWorld", "encode"
    calling _expect_some_string with (calling decode_base85_z85 with "HelloWorld"), raw, "decode"
    calling _expect_eq_string with (calling encode_base85_z85 with "abc"), "", "length must be a multiple of four"
    calling _expect_true with (not (calling decode_base85_z85 with "abcd").is_present), "decode length"

test "Base58 matches the Bitcoin alphabet rules":
    calling _expect_eq_string with (calling encode_base58 with ""), "", "empty"
    calling _expect_eq_string with (calling encode_base58 with "a"), "2g", "one byte"
    var zero_code as int is 0
    var one_code as int is 1
    var lead as string is "{(chr zero_code)}{(chr one_code)}"
    calling _expect_eq_string with (calling encode_base58 with lead), "12", "leading zero"
    calling _expect_some_string with (calling decode_base58 with "2g"), "a", "decode"
    calling _expect_true with (not (calling decode_base58 with "0").is_present), "zero is not in the alphabet"

test "encode_url and decode_url handle the unreserved set":
    calling _expect_eq_string with (calling encode_url with "a b"), "a%20b", "space"
    calling _expect_eq_string with (calling encode_url with "a~b-c_d.e"), "a~b-c_d.e", "unreserved"
    calling _expect_some_string with (calling decode_url with "a%20b"), "a b", "decode"
    calling _expect_true with (not (calling decode_url with "a%2").is_present), "truncated escape"
    calling _expect_true with (not (calling decode_url with "a%zz").is_present), "bad hex"

test "crc32_hex matches zlib for a known input":
    calling _expect_eq_string with (calling crc32_hex with "hello"), "3610a686", "hello"
    calling _expect_eq_string with (calling crc32_hex with ""), "00000000", "empty"

test "string enchantments delegate to the module functions":
    var hello as string is "hello"
    var hi as string is "hi"
    var hexs as string is "6869"
    calling _expect_eq_string with (calling hello.to_base64), "aGVsbG8=", "to_base64"
    calling _expect_eq_string with (calling hi.to_hex), "6869", "to_hex"
    calling _expect_eq_string with (calling hi.to_base32), "NBUQ====", "to_base32"
    calling _expect_eq_string with (calling hello.to_crc32_hex), "3610a686", "to_crc32_hex"
    calling _expect_some_string with (calling hexs.from_hex), "hi", "from_hex"
    calling _expect_eq_string with (calling hi.to_base58), "8wr", "to_base58"

test "typed map serializers emit sorted JSON":
    var ints as map of string to int is map of string to int
    calling ints.put with "b", 2
    calling ints.put with "a", 1
    calling _expect_eq_string with (calling stringify_json_map_int with ints), (calling _dq with r"{^a^:1,^b^:2}"), "ints"
    var bools as map of string to bool is map of string to bool
    calling bools.put with "z", true
    calling _expect_eq_string with (calling stringify_json_map_bool with bools), (calling _dq with r"{^z^:true}"), "bools"
