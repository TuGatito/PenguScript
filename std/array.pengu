realm array

enchanting array<T>
  is_empty = -> bool
    #@ == 0

  first = -> T?
    if #@ == 0 then none else @[0]

  last = -> T?
    if #@ == 0 then none else @[#@ - 1]

  index_of = (buscado: T) -> size_t?
    mut i: size_t = 0
    mut encontrado: size_t? = none
    while i < #@
      if @[i] == buscado
        encontrado = i
        break
      i += 1
    encontrado

  contains = (buscado: T) -> bool
    mut i: size_t = 0
    mut esta = false
    while i < #@
      if @[i] == buscado
        esta = true
        break
      i += 1
    esta

  to_vector = -> vector<T>
    mut salida: vector<T> = []
    mut i: size_t = 0
    while i < #@
      salida.push(@[i])
      i += 1
    salida

  reversed = -> vector<T>
    mut salida: vector<T> = []
    mut i = #@
    while i > 0
      i -= 1
      salida.push(@[i])
    salida

  slice = (inicio: size_t, largo: size_t) -> vector<T>
    mut salida: vector<T> = []
    mut i = inicio
    while i < #@ and i < inicio + largo
      salida.push(@[i])
      i += 1
    salida

  join = (separador: string) -> string
    mut salida = ""
    mut i: size_t = 0
    while i < #@
      if i > 0
        salida += separador
      salida += "#{@[i]}"
      i += 1
    salida

  min = -> T?
    if #@ == 0
      return none
    mut candidato = @[0]
    mut i: size_t = 1
    while i < #@
      if candidato > @[i]
        candidato = @[i]
      i += 1
    candidato

  max = -> T?
    if #@ == 0
      return none
    mut candidato = @[0]
    mut i: size_t = 1
    while i < #@
      if candidato < @[i]
        candidato = @[i]
      i += 1
    candidato

  find_if = (predicado: function<(T) -> bool>) -> T?
    for valor in @
      if predicado(valor)
        return valor
    none

  any = (predicado: function<(T) -> bool>) -> bool
    for valor in @
      if predicado(valor)
        return true
    false

  all = (predicado: function<(T) -> bool>) -> bool
    for valor in @
      if not predicado(valor)
        return false
    true

  none = (predicado: function<(T) -> bool>) -> bool
    for valor in @
      if predicado(valor)
        return false
    true
