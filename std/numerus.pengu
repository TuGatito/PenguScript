-- std/numerus.pengu — Matemáticas
--
-- S4. Funciones libres (se importan con `summon std::numerus::sqrt`) y
-- constantes en `sigil` (accesibles como `numerus::PI`).
--
-- Clases: los intrínsecos `num_*` cubren lo que necesita la libm de Rust; el
-- resto se escribe en PenguScript puro para hacer dogfooding del lenguaje
-- (`abs`, `clamp`, `lerp`, `gcd`, `dist`…). Los vectores 2D usan tuplas
-- `(Float, Float)`.
scroll numerus
    unveil sigil PI: Float = 3.141592653589793
    unveil sigil E: Float = 2.718281828459045
    unveil sigil TAU: Float = 6.283185307179586
    unveil sigil INFINITY: Float = 1.0 / 0.0
    unveil sigil NEG_INFINITY: Float = -1.0 / 0.0
    unveil sigil NAN: Float = 0.0 / 0.0
    unveil sigil EPSILON: Float = 2.220446049250313e-16
    unveil sigil MIN: Float = -1.7976931348623157e308
    unveil sigil MAX: Float = 1.7976931348623157e308

    foreign "pengu"
        num_sqrt = (x: Float) -> Float
        num_cbrt = (x: Float) -> Float
        num_pow = (x: Float, y: Float) -> Float
        num_exp = (x: Float) -> Float
        num_exp2 = (x: Float) -> Float
        num_exp_m1 = (x: Float) -> Float
        num_ln = (x: Float) -> Float
        num_ln_1p = (x: Float) -> Float
        num_log10 = (x: Float) -> Float
        num_log2 = (x: Float) -> Float
        num_sin = (x: Float) -> Float
        num_cos = (x: Float) -> Float
        num_tan = (x: Float) -> Float
        num_asin = (x: Float) -> Float
        num_acos = (x: Float) -> Float
        num_atan = (x: Float) -> Float
        num_atan2 = (y: Float, x: Float) -> Float
        num_sinh = (x: Float) -> Float
        num_cosh = (x: Float) -> Float
        num_tanh = (x: Float) -> Float
        num_asinh = (x: Float) -> Float
        num_acosh = (x: Float) -> Float
        num_atanh = (x: Float) -> Float
        num_floor = (x: Float) -> Float
        num_ceil = (x: Float) -> Float
        num_round = (x: Float) -> Float
        num_trunc = (x: Float) -> Float
        num_fract = (x: Float) -> Float
        num_copysign = (x: Float, y: Float) -> Float
        num_hypot = (x: Float, y: Float) -> Float
        num_mul_add = (a: Float, b: Float, c: Float) -> Float
        num_sin_cos = (x: Float) -> (Float, Float)
        num_fmod = (x: Float, y: Float) -> Float
        num_remainder = (x: Float, y: Float) -> Float
        num_modf = (x: Float) -> (Float, Float)
        num_frexp = (x: Float) -> (Float, Int)
        num_ldexp = (x: Float, exp: Int) -> Float
        num_nextafter = (x: Float, y: Float) -> Float
        num_erf = (x: Float) -> Float
        num_erfc = (x: Float) -> Float
        num_gamma = (x: Float) -> Float
        num_lgamma = (x: Float) -> Float
        num_isqrt = (n: U32) -> U32

    unveil abs = (x: Float) -> Float
        if x < 0.0 then -x else x

    unveil sqrt = (x: Float) -> Float
        num_sqrt(x)

    unveil cbrt = (x: Float) -> Float
        num_cbrt(x)

    unveil pow = (x: Float, y: Float) -> Float
        num_pow(x, y)

    unveil exp = (x: Float) -> Float
        num_exp(x)

    unveil exp2 = (x: Float) -> Float
        num_exp2(x)

    unveil exp_m1 = (x: Float) -> Float
        num_exp_m1(x)

    unveil ln = (x: Float) -> Float
        num_ln(x)

    unveil ln_1p = (x: Float) -> Float
        num_ln_1p(x)

    unveil log1p = (x: Float) -> Float
        ln_1p(x)

    unveil log10 = (x: Float) -> Float
        num_log10(x)

    unveil log2 = (x: Float) -> Float
        num_log2(x)

    unveil log = (x: Float, base: Float) -> Float
        ln(x) / ln(base)

    unveil sin = (x: Float) -> Float
        num_sin(x)

    unveil cos = (x: Float) -> Float
        num_cos(x)

    unveil tan = (x: Float) -> Float
        num_tan(x)

    unveil asin = (x: Float) -> Float
        num_asin(x)

    unveil acos = (x: Float) -> Float
        num_acos(x)

    unveil atan = (x: Float) -> Float
        num_atan(x)

    unveil atan2 = (y: Float, x: Float) -> Float
        num_atan2(y, x)

    unveil sinh = (x: Float) -> Float
        num_sinh(x)

    unveil cosh = (x: Float) -> Float
        num_cosh(x)

    unveil tanh = (x: Float) -> Float
        num_tanh(x)

    unveil asinh = (x: Float) -> Float
        num_asinh(x)

    unveil acosh = (x: Float) -> Float
        num_acosh(x)

    unveil atanh = (x: Float) -> Float
        num_atanh(x)

    unveil floor = (x: Float) -> Float
        num_floor(x)

    unveil ceil = (x: Float) -> Float
        num_ceil(x)

    unveil round = (x: Float) -> Float
        num_round(x)

    unveil trunc = (x: Float) -> Float
        num_trunc(x)

    unveil fract = (x: Float) -> Float
        num_fract(x)

    unveil min = (a: Float, b: Float) -> Float
        if a < b then a else b

    unveil max = (a: Float, b: Float) -> Float
        if a > b then a else b

    unveil clamp = (x: Float, lo: Float, hi: Float) -> Float
        if x < lo then lo else if x > hi then hi else x

    unveil lerp = (a: Float, b: Float, t: Float) -> Float
        a + (b - a) * t

    unveil smoothstep = (edge0: Float, edge1: Float, x: Float) -> Float
        bind t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0)
        t * t * (3.0 - 2.0 * t)

    unveil to_radians = (x: Float) -> Float
        x * (PI / 180.0)

    unveil to_degrees = (x: Float) -> Float
        x * (180.0 / PI)

    unveil radians = (x: Float) -> Float
        to_radians(x)

    unveil degrees = (x: Float) -> Float
        to_degrees(x)

    unveil signum = (x: Float) -> Float
        if x < 0.0 then -1.0 else if x > 0.0 then 1.0 else 0.0

    unveil copysign = (x: Float, y: Float) -> Float
        num_copysign(x, y)

    unveil hypot = (x: Float, y: Float) -> Float
        num_hypot(x, y)

    unveil recip = (x: Float) -> Float
        1.0 / x

    unveil mul_add = (a: Float, b: Float, c: Float) -> Float
        num_mul_add(a, b, c)

    unveil sin_cos = (x: Float) -> (Float, Float)
        num_sin_cos(x)

    unveil fmod = (x: Float, y: Float) -> Float
        num_fmod(x, y)

    unveil remainder = (x: Float, y: Float) -> Float
        num_remainder(x, y)

    unveil modf = (x: Float) -> (Float, Float)
        num_modf(x)

    unveil frexp = (x: Float) -> (Float, Int)
        num_frexp(x)

    unveil ldexp = (x: Float, exp: Int) -> Float
        num_ldexp(x, exp)

    unveil nextafter = (x: Float, y: Float) -> Float
        num_nextafter(x, y)

    unveil erf = (x: Float) -> Float
        num_erf(x)

    unveil erfc = (x: Float) -> Float
        num_erfc(x)

    unveil gamma = (x: Float) -> Float
        num_gamma(x)

    unveil lgamma = (x: Float) -> Float
        num_lgamma(x)

    unveil is_nan = (x: Float) -> Bool
        x.is_nan()

    unveil is_infinite = (x: Float) -> Bool
        x.is_infinite()

    unveil is_finite = (x: Float) -> Bool
        x.is_finite()

    unveil isclose = (a: Float, b: Float, rel_tol: Float, abs_tol: Float) -> Bool
        bind diff = abs(a - b)
        if a == b then true else diff <= max(rel_tol * max(abs(a), abs(b)), abs_tol)

    unveil isqrt = (n: U32) -> U32
        num_isqrt(n)

    unveil gcd = (a: Int, b: Int) -> Int
        morph x = a.abs()
        morph y = b.abs()
        while y != 0 do
            bind t = y
            y = x % y
            x = t
        x

    unveil lcm = (a: Int, b: Int) -> Int
        if a == 0 or b == 0 then 0 else (a / gcd(a, b) * b).abs()

    unveil factorial = (n: Int) -> Int
        morph acc = 1
        morph i = 2
        while i <= n do
            acc = acc * i
            i = i + 1
        acc

    unveil comb = (n: Int, k: Int) -> Int
        morph result = 0
        if k >= 0 and k <= n then
            result = 1
            morph i = 0
            while i < k do
                result = result * (n - i) / (i + 1)
                i = i + 1
        result

    unveil perm = (n: Int, k: Int) -> Int
        morph result = 0
        if k >= 0 and k <= n then
            result = 1
            morph i = 0
            while i < k do
                result = result * (n - i)
                i = i + 1
        result

    unveil distance = (a: (Float, Float), b: (Float, Float)) -> Float
        hypot(b.0 - a.0, b.1 - a.1)

    unveil dist = (a: (Float, Float), b: (Float, Float)) -> Float
        distance(a, b)

    unveil dot = (a: (Float, Float), b: (Float, Float)) -> Float
        a.0 * b.0 + a.1 * b.1

    unveil cross = (a: (Float, Float), b: (Float, Float)) -> Float
        a.0 * b.1 - a.1 * b.0

    unveil angle_between = (a: (Float, Float), b: (Float, Float)) -> Float
        atan2(cross(a, b), dot(a, b))

    unveil normalize = (v: (Float, Float)) -> (Float, Float)
        bind len = hypot(v.0, v.1)
        (v.0 / len, v.1 / len)
