realm set

enchanting set<T>
  is_empty = -> bool
    #@ == 0

  contains = (valor: T) -> bool
    valor in @

  to_vector = -> vector<T>
    mut salida: vector<T> = []
    for valor in @
      salida.push(valor)
    salida

  union = (otro: ref<set<T>>) -> set<T>
    mut salida: set<T> = set{}
    for valor in @
      salida.insert(valor)
    for valor in otro
      salida.insert(valor)
    salida

  intersection = (otro: ref<set<T>>) -> set<T>
    mut salida: set<T> = set{}
    for valor in @
      if valor in otro
        salida.insert(valor)
    salida

  difference = (otro: ref<set<T>>) -> set<T>
    mut salida: set<T> = set{}
    for valor in @
      if not (valor in otro)
        salida.insert(valor)
    salida

  symmetric_difference = (otro: ref<set<T>>) -> set<T>
    mut salida: set<T> = set{}
    for valor in @
      if not (valor in otro)
        salida.insert(valor)
    for valor in otro
      if not (valor in @)
        salida.insert(valor)
    salida

  is_subset = (otro: ref<set<T>>) -> bool
    for valor in @
      if not (valor in otro)
        return false
    true
