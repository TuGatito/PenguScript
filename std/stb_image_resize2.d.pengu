# std/stb_image_resize2.d.pengu - The stb_image_resize2 (high-quality image scaling/resizing)
# Pure C-binding declaration file: every declaration maps 1:1 to the native
# stb_image_resize2 C API. This file cannot contain implementation bodies (.d.pengu rule).
# Memory ownership follows the native library contract: read the upstream docs
# next to each declaration; release any returned handle with the library's own
# cleanup routine before dropping the last reference.
## PenguScript declaration binding generated by 'pengu bind'.
## Source header: stb_image_resize2.h
include "stb_image_resize2.h"

# -- Constants (#define) ------------------------------

const STBIR__HEADER_FILENAME as string is "stb_image_resize2.h"
const STBIR_FORCE_GATHER_FILTER_SCANLINES_AMOUNT as i64 is 32
const STBIR_FORCE_MINIMUM_SCANLINES_FOR_SPLITS as i64 is 4
const STBIR_INPUT_CALLBACK_PADDING as i64 is 3
const stbir__simdfX_float_count as i64 is 8
const STBIR__MERGE_RUNS_PIXEL_THRESHOLD as i64 is 16
const stbir__coder_min_num as i64 is 1
const stbir__decode_order1 as i64 is 1
const stbir__decode_order2 as i64 is 0
const stbir__decode_order3 as i64 is 3
const stbir__encode_order0 as i64 is 2
const stbir__encode_order1 as i64 is 1
const stbir__encode_order2 as i64 is 0
const stbir__encode_order3 as i64 is 3
const STBIR__horizontal_channels as i64 is 1
const STBIR__vertical_channels as i64 is 1
const STBIR_RESIZE_CLASSIFICATIONS as i64 is 8
const STBIR__V_FIRST_INFO_POINTER as i64 is 0
const stbir__decode_order0 as i64 is 0

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

alias stbir_uint8 as byte

alias stbir_uint16 as u16

alias stbir_uint32 as u32

alias stbir_uint64 as u64

omen stbir_pixel_layout:
  STBIR_1CHANNEL is 1
  STBIR_2CHANNEL is 2
  STBIR_RGB is 3
  STBIR_BGR is 0
  STBIR_4CHANNEL is 5
  STBIR_RGBA is 4
  STBIR_BGRA is 6
  STBIR_ARGB is 7
  STBIR_ABGR is 8
  STBIR_RA is 9
  STBIR_AR is 10
  STBIR_RGBA_PM is 11
  STBIR_BGRA_PM is 12
  STBIR_ARGB_PM is 13
  STBIR_ABGR_PM is 14
  STBIR_RA_PM is 15
  STBIR_AR_PM is 16

omen stbir_edge:
  STBIR_EDGE_CLAMP is 0
  STBIR_EDGE_REFLECT is 1
  STBIR_EDGE_WRAP is 2
  STBIR_EDGE_ZERO is 3

omen stbir_filter:
  STBIR_FILTER_DEFAULT is 0
  STBIR_FILTER_BOX is 1
  STBIR_FILTER_TRIANGLE is 2
  STBIR_FILTER_CUBICBSPLINE is 3
  STBIR_FILTER_CATMULLROM is 4
  STBIR_FILTER_MITCHELL is 5
  STBIR_FILTER_POINT_SAMPLE is 6
  STBIR_FILTER_OTHER is 7

omen stbir_datatype:
  STBIR_TYPE_UINT8 is 0
  STBIR_TYPE_UINT8_SRGB is 1
  STBIR_TYPE_UINT8_SRGB_ALPHA is 2
  STBIR_TYPE_UINT16 is 3
  STBIR_TYPE_FLOAT is 4
  STBIR_TYPE_HALF_FLOAT is 5

# INPUT CALLBACK: this callback is used for input scanlines
alias stbir_input_callback as ref to weave with optional_output as ref to void, input_ptr as ref to frozen void, num_pixels as int, x as int, y as int, context as ref to void into ref to frozen void

# OUTPUT CALLBACK: this callback is used for output scanlines
alias stbir_output_callback as ref to weave with output_ptr as ref to frozen void, num_pixels as int, y as int, context as ref to void into void

# callbacks for user installed filters
alias stbir__kernel_callback as ref to weave with x as f32, scale as f32, user_data as ref to void into f32

alias stbir__support_callback as ref to weave with scale as f32, user_data as ref to void into f32

alias stbir__info as opaque

rune STBIR_RESIZE:
  user_data as ref to void
  input_pixels as ref to frozen void
  input_w as int
  input_h as int
  input_s0 as f64
  input_t0 as f64
  input_s1 as f64
  input_t1 as f64
  input_cb as ref to stbir_input_callback
  output_pixels as ref to void
  output_w as int
  output_h as int
  output_subx as int
  output_suby as int
  output_subw as int
  output_subh as int
  output_cb as ref to stbir_output_callback
  input_stride_in_bytes as int
  output_stride_in_bytes as int
  splits as int
  fast_alpha as int
  needs_rebuild as int
  called_alloc as int
  input_pixel_layout_public as stbir_pixel_layout
  output_pixel_layout_public as stbir_pixel_layout
  input_data_type as stbir_datatype
  output_data_type as stbir_datatype
  horizontal_filter as stbir_filter
  vertical_filter as stbir_filter
  horizontal_edge as stbir_edge
  vertical_edge as stbir_edge
  horizontal_filter_kernel as ref to stbir__kernel_callback
  horizontal_filter_support as ref to stbir__support_callback
  vertical_filter_kernel as ref to stbir__kernel_callback
  vertical_filter_support as ref to stbir__support_callback
  samplers as ref to stbir__info

# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia stbir_

# ===============================================================
# Simple-complexity API
#
# If output_pixels is NULL (0), then we will allocate the buffer and return it to you.
# --------------------------------
declare resize_uint8_srgb with input_pixels as ref to frozen byte, input_w as int, input_h as int, input_stride_in_bytes as int, output_pixels as ref to byte, output_w as int, output_h as int, output_stride_in_bytes as int, pixel_type as stbir_pixel_layout into ref to byte

declare resize_uint8_linear with input_pixels as ref to frozen byte, input_w as int, input_h as int, input_stride_in_bytes as int, output_pixels as ref to byte, output_w as int, output_h as int, output_stride_in_bytes as int, pixel_type as stbir_pixel_layout into ref to byte

declare resize_float_linear with input_pixels as ref to frozen f32, input_w as int, input_h as int, input_stride_in_bytes as int, output_pixels as ref to f32, output_w as int, output_h as int, output_stride_in_bytes as int, pixel_type as stbir_pixel_layout into ref to f32

# medium api
declare resize with input_pixels as ref to frozen void, input_w as int, input_h as int, input_stride_in_bytes as int, output_pixels as ref to void, output_w as int, output_h as int, output_stride_in_bytes as int, pixel_layout as stbir_pixel_layout, data_type as stbir_datatype, edge as stbir_edge, filter as stbir_filter into ref to void

# First off, you must ALWAYS call stbir_resize_init on your resize structure before any of the other calls!
declare resize_init with resize as ref to STBIR_RESIZE, input_pixels as ref to frozen void, input_w as int, input_h as int, input_stride_in_bytes as int, output_pixels as ref to void, output_w as int, output_h as int, output_stride_in_bytes as int, pixel_layout as stbir_pixel_layout, data_type as stbir_datatype into void

# ===============================================================
# You can update these parameters any time after resize_init and there is no cost
# --------------------------------
declare set_datatypes with resize as ref to STBIR_RESIZE, input_type as stbir_datatype, output_type as stbir_datatype into void

declare set_pixel_callbacks with resize as ref to STBIR_RESIZE, input_cb as ref to stbir_input_callback, output_cb as ref to stbir_output_callback into void

declare set_user_data with resize as ref to STBIR_RESIZE, user_data as ref to void into void

declare set_buffer_ptrs with resize as ref to STBIR_RESIZE, input_pixels as ref to frozen void, input_stride_in_bytes as int, output_pixels as ref to void, output_stride_in_bytes as int into void

# ===============================================================
# If you call any of these functions, you will trigger a sampler rebuild!
# --------------------------------
declare set_pixel_layouts with resize as ref to STBIR_RESIZE, input_pixel_layout as stbir_pixel_layout, output_pixel_layout as stbir_pixel_layout into int

declare set_edgemodes with resize as ref to STBIR_RESIZE, horizontal_edge as stbir_edge, vertical_edge as stbir_edge into int

declare set_filters with resize as ref to STBIR_RESIZE, horizontal_filter as stbir_filter, vertical_filter as stbir_filter into int

declare set_filter_callbacks with resize as ref to STBIR_RESIZE, horizontal_filter as ref to stbir__kernel_callback, horizontal_support as ref to stbir__support_callback, vertical_filter as ref to stbir__kernel_callback, vertical_support as ref to stbir__support_callback into int

declare set_pixel_subrect with resize as ref to STBIR_RESIZE, subx as int, suby as int, subw as int, subh as int into int

declare set_input_subrect with resize as ref to STBIR_RESIZE, s0 as f64, t0 as f64, s1 as f64, t1 as f64 into int

declare set_output_pixel_subrect with resize as ref to STBIR_RESIZE, subx as int, suby as int, subw as int, subh as int into int

# when inputting AND outputting non-premultiplied alpha pixels, we use a slower but higher quality technique
# that fills the zero alpha pixel's RGB values with something plausible.  If you don't care about areas of
# zero alpha, you can call this function to get about a 25% speed improvement for STBIR_RGBA to STBIR_RGBA
# types of resizes.
declare set_non_pm_alpha_speed_over_quality with resize as ref to STBIR_RESIZE, non_pma_alpha_speed_over_quality as int into int

# This builds the samplers and does one allocation
declare build_samplers with resize as ref to STBIR_RESIZE into int

# You MUST call this, if you call stbir_build_samplers or stbir_build_samplers_with_splits
declare free_samplers with resize as ref to STBIR_RESIZE into void

# And this is the main function to perform the resize synchronously on one thread.
declare resize_extended with resize as ref to STBIR_RESIZE into int

# This will build samplers for threading.
# You can pass in the number of threads you'd like to use (try_splits).
# It returns the number of splits (threads) that you can call it with.
# It might be less if the image resize can't be split up that many ways.
declare build_samplers_with_splits with resize as ref to STBIR_RESIZE, try_splits as int into int

# Usually, you will always call stbir_resize_split with split_start as the thread_index
# and "1" for the split_count.
# But, if you have a weird situation where you MIGHT want 8 threads, but sometimes
# only 4 threads, you can use 0,2,4,6 for the split_start's and use "2" for the
# split_count each time to turn in into a 4 thread resize. (This is unusual).
declare resize_extended_split with resize as ref to STBIR_RESIZE, split_start as int, split_count as int into int
