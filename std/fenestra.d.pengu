# std/fenestra.d.pengu - The Fenestra (cross-platform native dialogs: message boxes and open/save-file pickers)
# Pure C-binding declaration file: every declaration maps 1:1 to the native
# tinyfiledialogs C API. This file cannot contain implementation bodies (.d.pengu rule).
# Memory ownership follows the native library contract: read the upstream docs
# next to each declaration; release any returned handle with the library's own
# cleanup routine before dropping the last reference.

## PenguScript declaration binding generated by 'pengu bind'.
## Source header: tinyfiledialogs.h
include "tinyfiledialogs.h"

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia tinyfd_

# 3 funtions for C# (you don't need this in C or C++) :
declare getGlobalChar with aCharVariableName as ref to frozen char into ref to frozen char

declare getGlobalInt with aIntVariableName as ref to frozen char into int

declare setGlobalInt with aIntVariableName as ref to frozen char, aValue as int into int

declare beep into void

declare notifyPopup with aTitle as ref to frozen char, aMessage as ref to frozen char, aIconType as ref to frozen char into int

# return has only meaning for tinyfd_query
declare messageBox with aTitle as ref to frozen char, aMessage as ref to frozen char, aDialogType as ref to frozen char, aIconType as ref to frozen char, aDefaultButton as int into int

# 0 for cancel/no , 1 for ok/yes , 2 for no in yesnocancel
declare inputBox with aTitle as ref to frozen char, aMessage as ref to frozen char, aDefaultInput as ref to frozen char into ref to char

# returns NULL on cancel
declare saveFileDialog with aTitle as ref to frozen char, aDefaultPathAndOrFile as ref to frozen char, aNumOfFilterPatterns as int, aFilterPatterns as ref to ref to frozen char, aSingleFilterDescription as ref to frozen char into ref to char

# returns NULL on cancel
declare openFileDialog with aTitle as ref to frozen char, aDefaultPathAndOrFile as ref to frozen char, aNumOfFilterPatterns as int, aFilterPatterns as ref to ref to frozen char, aSingleFilterDescription as ref to frozen char, aAllowMultipleSelects as int into ref to char

# in case of multiple files, the separator is |
# returns NULL on cancel
declare selectFolderDialog with aTitle as ref to frozen char, aDefaultPath as ref to frozen char into ref to char

# returns NULL on cancel
declare colorChooser with aTitle as ref to frozen char, aDefaultHexRGB as ref to frozen char, aDefaultRGB as frozen byte, aoResultRGB as byte into ref to char
