# Private helpers
# ----------------------------------------------------------------------------

## Test harness: panics with `label` when `cond` is false.
weave _expect_coven with cond as bool, label as string into void:
    if not cond:
        calling spark.panic with "coven test failed: {label}"

## Test harness: int equality.
weave _expect_coven_eq_int with actual as int, expected as int, label as string into void:
    if actual != expected:
        calling spark.panic with "coven test failed: {label}"

## Test harness: string equality.
weave _expect_coven_eq_string with actual as string, expected as string, label as string into void:
    if actual != expected:
        calling spark.panic with "coven test failed: {label}"

## Test harness: bool equality.
weave _expect_coven_eq_bool with actual as bool, expected as bool, label as string into void:
    if actual != expected:
        calling spark.panic with "coven test failed: {label}"

# --- Tests ---

## Test-only value type used to exercise `Set of T` with a user `rune`.
rune _TestPlayer derive Par, Vinculum:
    id as int

# The generic module functions `make_set of T` / `from_items_set of T` are the
# supported constructors: unlike a type-qualified generic ritual they keep
# working when the bundle holds several `Set of T` specialisations. See the
# design notes.
test "generic set of custom rune deduplicates":
    var s as Set of _TestPlayer is calling make_set of _TestPlayer
    var p as _TestPlayer with:
        set .id is 7
    calling s.add with p
    calling s.add with p
    calling _expect_coven_eq_int with (calling s.len), 1, "player dedupe"
    calling _expect_coven with (calling s.contains with p), "player contains"
    banish s.items

test "make_set of int builds an empty set":
    var s as Set of int is calling make_set of int
    calling _expect_coven with (calling s.is_empty), "make_set int empty"
    calling s.add with 3
    calling s.add with 3
    calling _expect_coven_eq_int with (calling s.len), 1, "make_set int dedupe"
    banish s.items

test "make_set of string builds an empty set":
    var s as Set of string is calling make_set of string
    calling s.add with "ada"
    calling s.add with "ada"
    calling _expect_coven_eq_int with (calling s.len), 1, "make_set string dedupe"
    calling _expect_coven with (calling s.contains with "ada"), "make_set string contains"
    banish s.items

test "make_set of float builds an empty set":
    var s as Set of float is calling make_set of float
    calling _expect_coven with (calling s.is_empty), "make_set float empty"
    calling s.add with 1.5
    calling _expect_coven_eq_int with (calling s.len), 1, "make_set float len"
    banish s.items

test "from_items_set deduplicates for int and string":
    var ints as list of int is list of int
    calling ints.push with 4
    calling ints.push with 4
    calling ints.push with 5
    var si as Set of int is calling from_items_set of int with ints
    var names as list of string is list of string
    calling names.push with "a"
    calling names.push with "a"
    var ss as Set of string is calling from_items_set of string with names
    calling _expect_coven_eq_int with (calling si.len), 2, "from_items_set int"
    calling _expect_coven_eq_int with (calling ss.len), 1, "from_items_set string"
    banish si.items
    banish ss.items
    banish ints
    banish names

test "set_string.add deduplicates elements":
    var s as SetString is calling new_set_string
    calling s.add with "ada"
    calling s.add with "ada"
    calling _expect_coven_eq_int with (calling s.len), 1, "add dedupe"
    calling _expect_coven with (calling s.contains with "ada"), "contains ada"
    banish s.items

test "set_string.remove reports membership":
    var s as SetString is calling new_set_string
    calling s.add with "a"
    calling s.add with "b"
    var first as bool is calling s.remove with "a"
    var second as bool is calling s.remove with "a"
    calling _expect_coven_eq_bool with first, true, "remove present"
    calling _expect_coven_eq_bool with second, false, "remove absent"
    calling _expect_coven_eq_int with (calling s.len), 1, "remove len"
    banish s.items

test "set_string.clear empties the set":
    var s as SetString is calling new_set_string
    calling s.add with "a"
    calling s.clear
    calling _expect_coven_eq_int with (calling s.len), 0, "clear len"
    calling _expect_coven with (calling s.is_empty), "clear is_empty"
    banish s.items

test "set_string.union merges both sets":
    var a as SetString is calling new_set_string
    var b as SetString is calling new_set_string
    calling a.add with "x"
    calling b.add with "y"
    var u as SetString is calling a.union with b
    calling _expect_coven_eq_int with (calling u.len), 2, "union len"
    calling _expect_coven with (calling u.contains with "x"), "union x"
    calling _expect_coven with (calling u.contains with "y"), "union y"
    banish u.items
    banish a.items
    banish b.items

test "set_string.intersect keeps common elements":
    var a as SetString is calling new_set_string
    var b as SetString is calling new_set_string
    calling a.add with "x"
    calling a.add with "y"
    calling b.add with "y"
    calling b.add with "z"
    var i as SetString is calling a.intersect with b
    calling _expect_coven_eq_int with (calling i.len), 1, "intersect len"
    calling _expect_coven with (calling i.contains with "y"), "intersect y"
    banish i.items
    banish a.items
    banish b.items

test "set_string.difference keeps only the left side":
    var a as SetString is calling new_set_string
    var b as SetString is calling new_set_string
    calling a.add with "x"
    calling a.add with "y"
    calling b.add with "y"
    var d as SetString is calling a.difference with b
    calling _expect_coven_eq_int with (calling d.len), 1, "difference len"
    calling _expect_coven with (calling d.contains with "x"), "difference x"
    banish d.items
    banish a.items
    banish b.items

test "set_string.symmetric_difference keeps elements in exactly one set":
    var a as SetString is calling new_set_string
    var b as SetString is calling new_set_string
    calling a.add with "x"
    calling a.add with "y"
    calling b.add with "y"
    calling b.add with "z"
    var x as SetString is calling a.symmetric_difference with b
    calling _expect_coven_eq_int with (calling x.len), 2, "symmetric len"
    calling _expect_coven with (calling x.contains with "x"), "symmetric x"
    calling _expect_coven with (calling x.contains with "z"), "symmetric z"
    banish x.items
    banish a.items
    banish b.items

test "set_string.is_subset and is_superset":
    var a as SetString is calling new_set_string
    var b as SetString is calling new_set_string
    calling a.add with "x"
    calling b.add with "x"
    calling b.add with "y"
    var sub as bool is calling a.is_subset with b
    var sup as bool is calling b.is_superset with a
    calling _expect_coven_eq_bool with sub, true, "subset"
    calling _expect_coven_eq_bool with sup, true, "superset"
    banish a.items
    banish b.items

test "set_string.is_disjoint detects shared elements":
    var a as SetString is calling new_set_string
    var b as SetString is calling new_set_string
    var c as SetString is calling new_set_string
    calling a.add with "x"
    calling b.add with "x"
    calling c.add with "y"
    var shared as bool is calling a.is_disjoint with b
    var apart as bool is calling a.is_disjoint with c
    calling _expect_coven_eq_bool with shared, false, "shared"
    calling _expect_coven_eq_bool with apart, true, "apart"
    banish a.items
    banish b.items
    banish c.items

test "set_string.equals compares membership":
    var a as SetString is calling new_set_string
    var b as SetString is calling new_set_string
    var c as SetString is calling new_set_string
    calling a.add with "x"
    calling a.add with "y"
    calling b.add with "y"
    calling b.add with "x"
    calling c.add with "x"
    var same as bool is calling a.equals with b
    var different as bool is calling a.equals with c
    calling _expect_coven_eq_bool with same, true, "equals same"
    calling _expect_coven_eq_bool with different, false, "equals different"
    banish a.items
    banish b.items
    banish c.items

test "set_string.clone is independent":
    var a as SetString is calling new_set_string
    calling a.add with "a"
    var c as SetString is calling a.clone
    calling c.add with "b"
    calling _expect_coven_eq_int with (calling a.len), 1, "clone original len"
    calling _expect_coven_eq_int with (calling c.len), 2, "clone copy len"
    banish a.items
    banish c.items

test "set_string.to_list lists every element":
    var s as SetString is calling new_set_string
    calling s.add with "a"
    calling s.add with "b"
    var xs as list of string is calling s.to_list
    calling _expect_coven_eq_int with (calling xs.len), 2, "to_list len"
    banish xs
    banish s.items

test "set_string.to_set_int parses numeric elements":
    var s as SetString is calling new_set_string
    calling s.add with "1"
    calling s.add with "2"
    calling s.add with "x"
    var ints as SetInt is calling s.to_set_int
    calling _expect_coven_eq_int with (calling ints.len), 2, "parsed len"
    calling _expect_coven with (calling ints.contains with 1), "parsed 1"
    banish ints.items
    banish s.items

test "set_string.filter_starts_with keeps the prefix":
    var s as SetString is calling new_set_string
    calling s.add with "alpha"
    calling s.add with "alps"
    calling s.add with "beta"
    var r as SetString is calling s.filter_starts_with with "al"
    calling _expect_coven_eq_int with (calling r.len), 2, "starts_with len"
    calling _expect_coven with (calling r.contains with "alpha"), "starts_with alpha"
    calling _expect_coven with ((calling r.contains with "beta") == false), "starts_with beta absent"
    banish r.items
    banish s.items

test "set_string.filter_length_ge keeps long elements":
    var s as SetString is calling new_set_string
    calling s.add with "a"
    calling s.add with "abc"
    calling s.add with "abcde"
    var r as SetString is calling s.filter_length_ge with 3
    calling _expect_coven_eq_int with (calling r.len), 2, "length_ge len"
    calling _expect_coven with (calling r.contains with "abc"), "length_ge abc"
    banish r.items
    banish s.items

test "empty_set_string and from_list_string deduplicate":
    var e as SetString is calling empty_set_string
    calling _expect_coven with (calling e.is_empty), "empty_set_string"
    var xs as list of string is list of string
    calling xs.push with "a"
    calling xs.push with "a"
    calling xs.push with "b"
    var s as SetString is calling from_list_string with xs
    calling _expect_coven_eq_int with (calling s.len), 2, "from_list_string dedupe"
    banish e.items
    banish s.items
    banish xs

test "set_string.from_items builds a set from a list":
    var xs as list of string is list of string
    calling xs.push with "p"
    calling xs.push with "q"
    var s as SetString is calling SetString.from_items with xs
    calling _expect_coven_eq_int with (calling s.len), 2, "from_items len"
    calling _expect_coven with (calling s.contains with "q"), "from_items q"
    banish s.items
    banish xs

test "set_string.empty ritual builds an empty set":
    var s as SetString is calling SetString.empty
    calling _expect_coven with (calling s.is_empty), "SetString.empty"
    banish s.items

test "set_int.add deduplicates elements":
    var s as SetInt is calling new_set_int
    calling s.add with 7
    calling s.add with 7
    calling _expect_coven_eq_int with (calling s.len), 1, "int add dedupe"
    calling _expect_coven with (calling s.contains with 7), "int contains"
    banish s.items

test "set_int.remove and is_empty":
    var s as SetInt is calling new_set_int
    calling s.add with 3
    var removed as bool is calling s.remove with 3
    var missing as bool is calling s.remove with 3
    calling _expect_coven_eq_bool with removed, true, "int remove present"
    calling _expect_coven_eq_bool with missing, false, "int remove absent"
    calling _expect_coven with (calling s.is_empty), "int is_empty"
    banish s.items

test "set_int.union merges both sets":
    var a as SetInt is calling new_set_int
    var b as SetInt is calling new_set_int
    calling a.add with 1
    calling b.add with 2
    var u as SetInt is calling a.union with b
    calling _expect_coven_eq_int with (calling u.len), 2, "int union len"
    calling _expect_coven with (calling u.contains with 2), "int union 2"
    banish u.items
    banish a.items
    banish b.items

test "set_int.intersect and difference":
    var a as SetInt is calling new_set_int
    var b as SetInt is calling new_set_int
    calling a.add with 1
    calling a.add with 2
    calling b.add with 2
    calling b.add with 3
    var i as SetInt is calling a.intersect with b
    var d as SetInt is calling a.difference with b
    calling _expect_coven_eq_int with (calling i.len), 1, "int intersect len"
    calling _expect_coven with (calling i.contains with 2), "int intersect 2"
    calling _expect_coven_eq_int with (calling d.len), 1, "int difference len"
    calling _expect_coven with (calling d.contains with 1), "int difference 1"
    banish i.items
    banish d.items
    banish a.items
    banish b.items

test "set_int.symmetric_difference":
    var a as SetInt is calling new_set_int
    var b as SetInt is calling new_set_int
    calling a.add with 1
    calling a.add with 2
    calling b.add with 2
    calling b.add with 3
    var x as SetInt is calling a.symmetric_difference with b
    calling _expect_coven_eq_int with (calling x.len), 2, "int symmetric len"
    calling _expect_coven with (calling x.contains with 1), "int symmetric 1"
    calling _expect_coven with (calling x.contains with 3), "int symmetric 3"
    banish x.items
    banish a.items
    banish b.items

test "set_int.is_subset is_superset and is_disjoint":
    var a as SetInt is calling new_set_int
    var b as SetInt is calling new_set_int
    var c as SetInt is calling new_set_int
    calling a.add with 1
    calling b.add with 1
    calling b.add with 2
    calling c.add with 9
    var sub as bool is calling a.is_subset with b
    var sup as bool is calling b.is_superset with a
    var shared as bool is calling a.is_disjoint with b
    var apart as bool is calling a.is_disjoint with c
    calling _expect_coven_eq_bool with sub, true, "int subset"
    calling _expect_coven_eq_bool with sup, true, "int superset"
    calling _expect_coven_eq_bool with shared, false, "int shared"
    calling _expect_coven_eq_bool with apart, true, "int apart"
    banish a.items
    banish b.items
    banish c.items

test "set_int.equals and clone":
    var a as SetInt is calling new_set_int
    var b as SetInt is calling new_set_int
    calling a.add with 1
    calling a.add with 2
    calling b.add with 2
    calling b.add with 1
    var same as bool is calling a.equals with b
    var c as SetInt is calling a.clone
    calling c.add with 5
    calling _expect_coven_eq_bool with same, true, "int equals"
    calling _expect_coven_eq_int with (calling a.len), 2, "int clone original"
    calling _expect_coven_eq_int with (calling c.len), 3, "int clone copy"
    banish a.items
    banish b.items
    banish c.items

test "set_int.to_list_int and sum_ints":
    var s as SetInt is calling new_set_int
    calling s.add with 2
    calling s.add with 3
    var xs as list of int is calling s.to_list_int
    var total as int is calling s.sum_ints
    calling _expect_coven_eq_int with (calling xs.len), 2, "to_list_int len"
    calling _expect_coven_eq_int with total, 5, "sum_ints"
    banish xs
    banish s.items

test "set_int.min_int and max_int":
    var s as SetInt is calling new_set_int
    var e as SetInt is calling new_set_int
    calling s.add with 5
    calling s.add with -2
    calling s.add with 9
    calling _expect_coven_eq_int with (calling s.min_int), -2, "min_int"
    calling _expect_coven_eq_int with (calling s.max_int), 9, "max_int"
    calling _expect_coven_eq_int with (calling e.min_int), 0, "empty min_int"
    calling _expect_coven_eq_int with (calling e.max_int), 0, "empty max_int"
    banish s.items
    banish e.items

test "set_int.to_set_string roundtrips":
    var s as SetInt is calling new_set_int
    calling s.add with 7
    calling s.add with -3
    var t as SetString is calling s.to_set_string
    calling _expect_coven_eq_int with (calling t.len), 2, "to_set_string len"
    calling _expect_coven with (calling t.contains with "7"), "to_set_string 7"
    calling _expect_coven with (calling t.contains with "-3"), "to_set_string -3"
    calling t.release
    banish s.items

test "empty_set_int and from_list_int":
    var e as SetInt is calling empty_set_int
    calling _expect_coven with (calling e.is_empty), "empty_set_int"
    var xs as list of int is list of int
    calling xs.push with 4
    calling xs.push with 4
    calling xs.push with 5
    var s as SetInt is calling from_list_int with xs
    calling _expect_coven_eq_int with (calling s.len), 2, "from_list_int dedupe"
    banish e.items
    banish s.items
    banish xs

test "set_int.from_items builds a set from a list":
    var xs as list of int is list of int
    calling xs.push with 8
    calling xs.push with 9
    var s as SetInt is calling SetInt.from_items with xs
    calling _expect_coven_eq_int with (calling s.len), 2, "int from_items len"
    calling _expect_coven with (calling s.contains with 9), "int from_items 9"
    banish s.items
    banish xs

test "set_int.empty ritual builds an empty set":
    var s as SetInt is calling SetInt.empty
    calling _expect_coven with (calling s.is_empty), "SetInt.empty"
    banish s.items

test "generic set of int deduplicates and removes":
    var s as Set of int is calling new_int_set
    calling s.add with 7
    calling s.add with 7
    calling _expect_coven_eq_int with (calling s.len), 1, "generic int dedupe"
    calling _expect_coven with (calling s.contains with 7), "generic int contains"
    var removed as bool is calling s.remove with 7
    calling _expect_coven_eq_bool with removed, true, "generic int remove"
    calling _expect_coven with (calling s.is_empty), "generic int is_empty"
    banish s.items

test "generic set of int set algebra":
    var a as Set of int is calling new_int_set
    var b as Set of int is calling new_int_set
    calling a.add with 1
    calling a.add with 2
    calling b.add with 2
    calling b.add with 3
    var u as Set of int is calling a.union with b
    var i as Set of int is calling a.intersect with b
    var d as Set of int is calling a.difference with b
    var x as Set of int is calling a.symmetric_difference with b
    calling _expect_coven_eq_int with (calling u.len), 3, "generic union len"
    calling _expect_coven_eq_int with (calling i.len), 1, "generic intersect len"
    calling _expect_coven with (calling i.contains with 2), "generic intersect 2"
    calling _expect_coven_eq_int with (calling d.len), 1, "generic difference len"
    calling _expect_coven with (calling d.contains with 1), "generic difference 1"
    calling _expect_coven_eq_int with (calling x.len), 2, "generic symmetric len"
    banish u.items
    banish i.items
    banish d.items
    banish x.items
    banish a.items
    banish b.items

test "generic set of int subset superset disjoint equals clone":
    var a as Set of int is calling new_int_set
    var b as Set of int is calling new_int_set
    calling a.add with 1
    calling b.add with 1
    calling b.add with 2
    var sub as bool is calling a.is_subset with b
    var sup as bool is calling b.is_superset with a
    var shared as bool is calling a.is_disjoint with b
    var copy as Set of int is calling b.clone
    var same as bool is calling b.equals with copy
    calling _expect_coven_eq_bool with sub, true, "generic subset"
    calling _expect_coven_eq_bool with sup, true, "generic superset"
    calling _expect_coven_eq_bool with shared, false, "generic not disjoint"
    calling _expect_coven_eq_bool with same, true, "generic equals clone"
    banish a.items
    banish b.items
    banish copy.items

test "generic set of string stores and lists strings":
    var s as Set of string is calling new_string_set
    calling s.add with "alpha"
    calling s.add with "alpha"
    var out as list of string is calling s.to_list
    calling _expect_coven_eq_int with (calling s.len), 1, "string set len"
    calling _expect_coven_eq_int with (calling out.len), 1, "string to_list len"
    calling _expect_coven_eq_string with (out at 0), "alpha", "string element"
    banish out
    banish s.items

test "generic set of string clear and is_empty":
    var s as Set of string is calling new_string_set
    calling s.add with "a"
    calling s.clear
    calling _expect_coven with (calling s.is_empty), "generic clear is_empty"
    calling _expect_coven_eq_int with (calling s.len), 0, "generic clear len"
    banish s.items

test "generic set of float stores floats":
    var s as Set of float is calling new_float_set
    calling s.add with 1.5
    calling s.add with 1.5
    calling s.add with 2.5
    calling _expect_coven_eq_int with (calling s.len), 2, "float set len"
    calling _expect_coven with (calling s.contains with 1.5), "float contains"
    banish s.items

test "concrete bool and char constructors build sets":
    var b as Set of bool is calling new_bool_set
    calling b.add with true
    calling b.add with true
    calling _expect_coven_eq_int with (calling b.len), 1, "bool dedupe"
    var c as Set of char is calling new_char_set
    calling c.add with (65 to char)
    calling _expect_coven with (calling c.contains with (65 to char)), "char contains"
    banish b.items
    banish c.items

test "generic set of i64 keys on the full 64-bit value":
    var s as Set of i64 is calling make_set of i64
    calling s.add with 5000000000
    calling s.add with -5000000000
    calling s.add with 5000000000
    calling _expect_coven_eq_int with (calling s.len), 2, "i64 len"
    calling _expect_coven with (calling s.contains with 5000000000), "i64 positive contains"
    calling _expect_coven with (calling s.contains with -5000000000), "i64 negative contains"
    calling _expect_coven with ((calling s.contains with 705032704) == false), "i64 not truncated to int32"
    var removed as bool is calling s.remove with -5000000000
    calling _expect_coven_eq_bool with removed, true, "i64 remove"
    banish s.items

test "new_i64_set and new_u64_set build working sets":
    var a as Set of i64 is calling new_i64_set
    var b as Set of u64 is calling new_u64_set
    calling _expect_coven with (calling a.is_empty), "i64 set empty"
    calling a.add with 12000000000
    calling b.add with 12000000000
    calling b.add with 12000000000
    calling _expect_coven_eq_int with (calling b.len), 1, "u64 dedupe"
    calling _expect_coven with (calling a.contains with 12000000000), "i64 contains"
    calling _expect_coven with (calling b.contains with 12000000000), "u64 contains"
    banish a.items
    banish b.items

test "new_usize_set and new_isize_set handle wide and negative keys":
    var a as Set of usize is calling new_usize_set
    var b as Set of isize is calling new_isize_set
    calling _expect_coven with (calling a.is_empty), "usize set empty"
    calling a.add with 9000000000
    calling b.add with -9000000000
    calling _expect_coven_eq_int with (calling a.len), 1, "usize len"
    calling _expect_coven_eq_int with (calling b.len), 1, "isize len"
    calling _expect_coven with (calling a.contains with 9000000000), "usize contains"
    calling _expect_coven with (calling b.contains with -9000000000), "isize contains"
    banish a.items
    banish b.items

test "generic set of usize supports set algebra":
    var a as Set of usize is calling new_usize_set
    var b as Set of usize is calling new_usize_set
    calling a.add with 1
    calling a.add with 2
    calling b.add with 2
    calling b.add with 3
    var u as Set of usize is calling a.union with b
    var i as Set of usize is calling a.intersect with b
    calling _expect_coven_eq_int with (calling u.len), 3, "usize union len"
    calling _expect_coven_eq_int with (calling i.len), 1, "usize intersect len"
    calling _expect_coven with (calling i.contains with 2), "usize intersect 2"
    banish u.items
    banish i.items
    banish a.items
    banish b.items

test "from_items_set of isize round-trips through to_list":
    var xs as list of isize is list of isize
    calling xs.push with -5
    calling xs.push with -5
    calling xs.push with 7
    var s as Set of isize is calling from_items_set of isize with xs
    calling _expect_coven_eq_int with (calling s.len), 2, "isize from_items len"
    var out as list of isize is calling s.to_list
    calling _expect_coven_eq_int with (calling out.len), 2, "isize to_list len"
    var back as Set of isize is calling from_items_set of isize with out
    calling _expect_coven with (calling back.equals with s), "isize round-trip"
    banish out
    banish back.items
    banish s.items
    banish xs

test "narrow integer and byte element types work":
    var a as Set of i8 is calling make_set of i8
    var b as Set of i16 is calling make_set of i16
    var c as Set of i32 is calling make_set of i32
    var d as Set of u8 is calling make_set of u8
    var e as Set of u16 is calling make_set of u16
    var f as Set of u32 is calling make_set of u32
    var g as Set of byte is calling make_set of byte
    calling a.add with 1
    calling a.add with 1
    calling b.add with 1
    calling c.add with 1
    calling d.add with 1
    calling e.add with 1
    calling f.add with 1
    calling g.add with 1
    calling _expect_coven_eq_int with (calling a.len), 1, "i8 dedupe"
    calling _expect_coven_eq_int with (calling b.len), 1, "i16 len"
    calling _expect_coven_eq_int with (calling c.len), 1, "i32 len"
    calling _expect_coven_eq_int with (calling d.len), 1, "u8 len"
    calling _expect_coven_eq_int with (calling e.len), 1, "u16 len"
    calling _expect_coven_eq_int with (calling f.len), 1, "u32 len"
    calling _expect_coven_eq_int with (calling g.len), 1, "byte len"
    banish a.items
    banish b.items
    banish c.items
    banish d.items
    banish e.items
    banish f.items
    banish g.items

test "f32 and f64 element types work":
    var a as Set of f32 is calling make_set of f32
    var b as Set of f64 is calling make_set of f64
    calling a.add with 1.5
    calling a.add with 1.5
    calling b.add with 2.5
    calling b.add with 2.5
    calling _expect_coven_eq_int with (calling a.len), 1, "f32 dedupe"
    calling _expect_coven_eq_int with (calling b.len), 1, "f64 dedupe"
    calling _expect_coven with (calling a.contains with 1.5), "f32 contains"
    calling _expect_coven with (calling b.contains with 2.5), "f64 contains"
    banish a.items
    banish b.items

test "generic set of float keys 0.0 and -0.0 separately":
    var s as Set of float is calling new_float_set
    calling s.add with 0.0
    calling s.add with -0.0
    calling s.add with 0.0
    calling _expect_coven_eq_int with (calling s.len), 2, "signed zero keys"
    calling _expect_coven with (calling s.contains with 0.0), "positive zero present"
    calling _expect_coven with (calling s.contains with -0.0), "negative zero present"
    banish s.items

test "empty string is a valid set element":
    var s as Set of string is calling new_string_set
    calling s.add with ""
    calling s.add with ""
    calling s.add with "x"
    calling _expect_coven_eq_int with (calling s.len), 2, "empty string len"
    calling _expect_coven with (calling s.contains with ""), "empty string contains"
    var removed as bool is calling s.remove with ""
    calling _expect_coven_eq_bool with removed, true, "empty string remove"
    banish s.items

test "generic union and intersect deduplicate shared elements":
    var a as Set of string is calling new_string_set
    var b as Set of string is calling new_string_set
    calling a.add with "shared"
    calling a.add with "left"
    calling b.add with "shared"
    calling b.add with "right"
    var u as Set of string is calling a.union with b
    var i as Set of string is calling a.intersect with b
    calling _expect_coven_eq_int with (calling u.len), 3, "union shared once"
    calling _expect_coven_eq_int with (calling i.len), 1, "intersect shared once"
    calling _expect_coven with (calling i.contains with "shared"), "intersect shared"
    calling _expect_coven with ((calling i.contains with "left") == false), "intersect excludes left"
    banish u.items
    banish i.items
    banish a.items
    banish b.items

test "custom rune elements deduplicate by derived value equality":
    var s as Set of _TestPlayer is calling make_set of _TestPlayer
    var a as _TestPlayer with:
        set .id is 7
    var b as _TestPlayer with:
        set .id is 7
    var c as _TestPlayer with:
        set .id is 8
    calling s.add with a
    calling s.add with b
    calling s.add with c
    calling _expect_coven_eq_int with (calling s.len), 2, "rune value dedupe"
    calling _expect_coven with (calling s.contains with b), "rune equal value contains"
    banish s.items

test "add_owned survives releasing the source string":
    # The bug this pins: `add` only copies the PenguString header, so the set
    # aliased a caller-owned buffer and a lookup after `banish` read freed
    # memory (it silently answered "not found"). `add_owned` must store a copy.
    var s as SetString is calling new_set_string
    var src as string is "hello"
    var tmp as string is calling src.get_upper
    calling s.add_owned with tmp
    banish tmp
    banish src
    var probe as string is "HELLO"
    calling _expect_coven_eq_bool with (calling s.contains with probe), true, "add_owned keeps a copy"
    calling _expect_coven_eq_int with (calling s.len), 1, "add_owned stores one element"
    calling s.release

test "borrowing add keeps its documented lifetime rule":
    # `add` borrows: the stored key is a non-owning header. A caller-owned
    # string stays the caller's, so `clear` must NOT free it (doing so was a
    # double free once the caller banished its own string - see the audit test
    # `test_coven_no_internal_leak`).
    var s as SetString is calling new_set_string
    var base as string is "borrowed"
    var owned as string is calling base.get_upper
    calling s.add with owned
    calling _expect_coven_eq_bool with (calling s.contains with owned), true, "borrowed lookup"
    calling s.clear
    calling _expect_coven_eq_int with (calling s.len), 0, "clear empties"
    banish owned       # safe: `clear` did not take ownership of it
    banish s.items

test "clone_owned outlives the set it came from":
    var s as SetString is calling new_set_string
    var src as string is "x"
    calling s.add_owned with src
    var c as SetString is calling s.clone_owned
    calling s.release
    var probe as string is "x"
    calling _expect_coven_eq_bool with (calling c.contains with probe), true, "clone_owned is independent"
    calling c.release

test "remove and clear free the copies the set owns":
    var s as SetString is calling new_set_string
    var a as string is "aa"
    var b as string is "bb"
    calling s.add_owned with a
    calling s.add_owned with b
    calling _expect_coven_eq_bool with (calling s.remove with a), true, "remove owned element"
    calling _expect_coven_eq_int with (calling s.len), 1, "one left after remove"
    calling s.clear
    calling _expect_coven_eq_int with (calling s.len), 0, "clear after remove"
    banish s.items

test "_put_owned replaces a duplicate key without leaking the old buffer":
    # `pengu_map_put` keeps the first key on a match and overwrites only the
    # value, so a naive transfer would leak the second buffer. `_put_owned`
    # drops the existing entry first; under ASan this must not leak or
    # double-free the replaced copy.
    var s as SetString is calling new_set_string
    var base as string is "dup"
    var first as string is calling base.get_upper
    calling s._put_owned with first
    var second as string is calling base.get_upper
    calling s._put_owned with second
    calling _expect_coven_eq_int with (calling s.len), 1, "_put_owned dedupes"
    calling _expect_coven_eq_bool with (calling s.contains with second), true, "_put_owned keeps the new key"
    calling s.release

test "coven version is 2.3.0":
    calling _expect_coven_eq_string with COVEN_VERSION, "2.3.0", "version"
