## std/secrets.pengu — optional libsodium-backed secure primitives.
##
## Import this module only when the project links libsodium
## (`links = ["sodium"]` in `pengu.toml`).  It provides cryptographically
## secure random bytes, SHA-256 and secure memory wiping; for TLS/HTTP use
## `std.petitio` (libcurl) or a dedicated mbedTLS satellite.
##
## ## Memory
## `random_bytes` returns an owned string; `sha256_raw` returns owned bytes;
## `wipe` mutates the caller's buffer and allocates nothing.

import std.spark
link "sodium"

const SECRETS_VERSION as string is "1.0.0"

declare ccx_sodium_init into bool
declare ccx_sodium_random with bytes as list of byte, n as int into bool
declare ccx_sodium_list_string with bytes as list of byte, n as int into string
declare ccx_sodium_sha256 with data as string into string
declare ccx_sodium_wipe with p as ref to void, n as int into void
declare ccx_sodium_compare with a as ref to void, b as ref to void, n as int into int

## Initializes libsodium once. `random_bytes`/`sha256_raw` call it implicitly.
weave init into bool:
    return calling ccx_sodium_init

## Returns `n` cryptographically secure random bytes as an owned string.
weave random_bytes with n as int into string:
    if n <= 0:
        return ""
    var buf as list of byte is list of byte
    var i as int is 0
    while i < n:
        calling buf.push with 0
        set i is i + 1
    if not calling ccx_sodium_random with buf, n:
        banish buf
        return ""
    var raw as string is calling ccx_sodium_list_string with buf, n
    banish buf
    return raw

## SHA-256 raw bytes, owned.
weave sha256_raw with data as string into string:
    return calling ccx_sodium_sha256 with data

## Overwrites `n` bytes at `p` with zeros through sodium_memzero.
weave wipe with p as ref to void, n as int into void:
    calling ccx_sodium_wipe with p, n

## Constant-time comparison; 0 means equal.
weave compare with a as ref to void, b as ref to void, n as int into int:
    return calling ccx_sodium_compare with a, b, n

antiquus bytes_to_string with data as ref to byte, n as int into string:
    r"""
if (!data || n <= 0) return pengu_string_from_cstr("");
return pengu_string_owned(data, n);
"""
