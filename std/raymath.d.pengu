## PenguScript declaration binding generated by 'pengu bind'.
## Source header: pengu_raymath.h
## Non-inline C wrappers for raymath.h 3D math and vector operations.
include "pengu_raymath.h"

# Bindings of the headers included above: the types they declare
# must be the very same ones this file uses, so import them.
#   raylib.h
import std.raylib

link "pengu_raymath"
link "m"

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

rune float3:
  v as array of f32 with size 3

rune float16:
  v as array of f32 with size 16

