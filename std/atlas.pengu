    with m:
        calling .put with 1, "uno"
        calling .put with 2, "dos"
        calling .put with 3, "tres"
    return m

## Test predicate: value greater than one.
weave _value_gt_one with k as string, v as int into bool:
    v > 1

## Test transformation: increment.
weave _inc with x as int into int:
    x + 1
test "size counts the entries":
    let m is calling _sample_str_int
    calling _expect_eq_int with (calling m.size), 3, "size"
test "size of an empty map is zero":
    var m as map of string to int is map of string to int
    calling _expect_eq_int with (calling m.size), 0, "empty size"
test "is_empty is false with entries":
    let m is calling _sample_str_int
    calling _expect_true with (not (calling m.is_empty)), "is_empty false"
test "is_empty is true without entries":
    var m as map of string to int is map of string to int
    calling _expect_true with (calling m.is_empty), "is_empty"
test "has_key finds a present key":
    let m is calling _sample_str_int
    calling _expect_true with (calling m.has_key with "beta"), "has_key"
test "has_key rejects a missing key":
    let m is calling _sample_str_int
    calling _expect_true with (not (calling m.has_key with "zeta")), "has_key missing"
test "has_any_key with one match":
    let m is calling _sample_str_int
    var ks as list of string is ["zeta", "beta"]
    calling _expect_true with (calling m.has_any_key with ks), "has_any_key"
test "has_any_key without matches":
    let m is calling _sample_str_int
    var ks as list of string is ["zeta", "omega"]
    calling _expect_true with (not (calling m.has_any_key with ks)), "has_any_key none"
test "has_all_keys with every key":
