# --- Helpers privados -------------------------------------------------------

weave _sort_strings with xs as list of string into list of string:
    var ks as list of string is list of string
    for s in xs:
        calling ks.push with s
    var n as int is calling ks.len
    var i as int is 0
    while i < n:
        var j as int is i + 1
        while j < n:
            var a as string is ks at i
            var b as string is ks at j
            if (calling a.compare with b) > 0:
                var tmp as string is ks at i
                set ks at i is ks at j
                set ks at j is tmp
            set j is j + 1
        set i is i + 1
    return ks

# --- Tests ------------------------------------------------------------------
# Harness privado: `std.ward` no puede importarse aquí (ward importa atlas y el
# ciclo sería E0004), así que las aserciones usan `std.spark` directamente.

## Falla con `label` si `got != want`.
weave _expect_eq_int with got as int, want as int, label as string into void:
    if got != want:
        calling spark.println with "FAIL {label}: got {got}, want {want}"
        calling spark.panic with "atlas: test failed"

## Falla con `label` si `got != want` (comparación con `std.scrolls.compare`).
weave _expect_eq_string with got as string, want as string, label as string into void:
    if (calling got.compare with want) != 0:
        calling spark.println with "FAIL {label}: got {got}, want {want}"
        calling spark.panic with "atlas: test failed"

## Falla con `label` si `cond` es falso.
weave _expect_true with cond as bool, label as string into void:
    if not cond:
        calling spark.println with "FAIL {label}"
        calling spark.panic with "atlas: test failed"

## Mapa de una sola entrada `k -> v` (helper de tests).
weave _one shard K and V where K: Par, V: Par with k as K, v as V into map of K to V:
    var m as map of K to V is map of K to V
    with m:
        calling .put with k, v
    return m

