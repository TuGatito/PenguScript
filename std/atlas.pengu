    ## Alias of `values`.
    weave to_values_list into list of bool:
        return calling self.values

# ============================================================================
# Module-level binary operations & constructors
# ============================================================================

# --- map of string to int ---

## Returns a fresh map combining all entries of `a` and `b`. Entries in `b` overwrite `a`.
weave merge with a as map of string to int, b as map of string to int into map of string to int:
    var result as map of string to int is map of string to int
    for k in a:
        calling result.put with k, (calling a.get with k)
    for k in b:
        calling result.put with k, (calling b.get with k)
    return result

## Returns a fresh map combining `a` and `b`, keeping `a`'s values on key collision.
weave merge_keep_left with a as map of string to int, b as map of string to int into map of string to int:
    var result as map of string to int is map of string to int
    for k in a:
        calling result.put with k, (calling a.get with k)
    for k in b:
        if (calling result.contains with k) == false:
            calling result.put with k, (calling b.get with k)
    return result

## Returns a fresh map combining `a` and `b`, with `b`'s values taking precedence on collision (alias of merge).
weave merge_keep_right with a as map of string to int, b as map of string to int into map of string to int:
    return calling merge with a, b

## Builds a fresh map from parallel lists of keys and values up to `min(ks.len, vs.len)`.
weave from_lists with ks as list of string, vs as list of int into map of string to int:
    var result as map of string to int is map of string to int
    var limit as int is calling ks.len
    var vs_len as int is calling vs.len
    if vs_len < limit:
        set limit is vs_len
    var i as int is 0
    while i < limit:
        calling result.put with (ks at i), (vs at i)
        set i is i + 1
    return result

# --- map of string to string ---

## Returns a fresh map combining all entries of `a` and `b`. Entries in `b` overwrite `a`.
weave merge_ss with a as map of string to string, b as map of string to string into map of string to string:
    var result as map of string to string is map of string to string
    for k in a:
        calling result.put with k, (a at k)
    for k in b:
        calling result.put with k, (b at k)
    return result

## Returns a fresh map combining `a` and `b`, keeping `a`'s values on key collision.
weave merge_keep_left_ss with a as map of string to string, b as map of string to string into map of string to string:
    var result as map of string to string is map of string to string
    for k in a:
        calling result.put with k, (a at k)
    for k in b:
        if not (calling result.contains with k):
            calling result.put with k, (b at k)
    return result

## Returns a fresh map combining `a` and `b`, keeping `b`'s values on key collision.
weave merge_keep_right_ss with a as map of string to string, b as map of string to string into map of string to string:
    return calling merge_ss with a, b

## Builds a fresh map from parallel lists of keys and values up to `min(ks.len, vs.len)`.
weave from_lists_ss with ks as list of string, vs as list of string into map of string to string:
    var result as map of string to string is map of string to string
    var limit as int is ks.len
    if vs.len < limit:
        set limit is vs.len
    var i as int is 0
    while i < limit:
        calling result.put with (ks at i), (vs at i)
        set i is i + 1
    return result

