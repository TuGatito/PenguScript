test "merge_sb combina mapas bool":
    var m as map of string to bool is calling merge_sb with (calling _sample_str_bool), (calling _one with "z", false)
    calling _expect_eq_int with (calling size_sb with m), 4, "merge_sb"
test "from_lists_ii construye desde listas int":
    var ks as list of int is [1, 2]
    var vs as list of int is [10, 20]
    var m as map of int to int is calling from_lists_ii with ks, vs
    calling _expect_eq_int with (calling get_or_ii with m, 2, 0), 20, "from_lists_ii"
test "from_lists_sf construye desde listas float":
    var ks as list of string is ["a"]
    var vs as list of float is [1.5]
    var m as map of string to float is calling from_lists_sf with ks, vs
    calling _expect_true with ((calling get_or_sf with m, "a", 0.0) == 1.5), "from_lists_sf"
test "values_in_range de módulo":
    calling _expect_true with (calling values_in_range with (calling _sample_str_int), 1, 3), "values_in_range módulo"
test "filter_keys_contains de módulo":
    calling _expect_eq_int with (calling size with (calling filter_keys_contains with (calling _sample_str_int), "a")), 2, "filter_keys_contains módulo"
test "filter_keys_startswith de módulo":
    calling _expect_eq_int with (calling size with (calling filter_keys_startswith with (calling _sample_str_int), "be")), 1, "filter_keys_startswith módulo"
test "map_values_double de módulo":
    calling _expect_eq_int with (calling get_or with (calling map_values_double with (calling _sample_str_int)), "beta", 0), 4, "map_values_double módulo"
test "get_or de módulo":
    calling _expect_eq_int with (calling get_or with (calling _sample_str_int), "gamma", 0), 3, "get_or módulo"
test "put de módulo":
    var m as map of string to int is map of string to int
    calling put with m, "a", 1
    calling _expect_eq_int with (calling get_or with m, "a", 0), 1, "put módulo"
test "remove de módulo":
    calling _expect_true with (calling remove with (calling _one with "a", 1), "a"), "remove módulo"
test "update de módulo":
    var m as map of string to int is calling _one with "a", 1
    calling _expect_true with (calling update with m, "a", 5), "update módulo"
test "keys de módulo":
    calling _expect_eq_int with (calling _count with (calling keys with (calling _sample_str_int))), 3, "keys módulo"
test "is_empty de módulo":
    var m as map of string to int is map of string to int
    calling _expect_true with (calling is_empty with m), "is_empty módulo"
test "size de módulo":
    calling _expect_eq_int with (calling size with (calling _sample_str_int)), 3, "size módulo"
test "has_key de módulo":
    calling _expect_true with (calling has_key with (calling _sample_str_int), "beta"), "has_key módulo"
test "value_gt_one es un predicado reutilizable":
    calling _expect_true with (calling _value_gt_one with "k", 2), "predicado"
