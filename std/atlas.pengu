    with m:
        calling .put with "alpha", true
        calling .put with "beta", false
        calling .put with "gamma", true
    return m

## Fixture `{1: 10, 2: -20, 3: 30}`.
weave _sample_int_int into map of int to int:
    var m as map of int to int is map of int to int
    with m:
        calling .put with 1, 10
        calling .put with 2, -20
        calling .put with 3, 30
    return m

## Fixture `{1: "uno", 2: "dos", 3: "tres"}`.
weave _sample_int_str into map of int to string:
    var m as map of int to string is map of int to string
    with m:
        calling .put with 1, "uno"
        calling .put with 2, "dos"
        calling .put with 3, "tres"
    return m

## Predicado de prueba: valor mayor que uno.
weave _value_gt_one with k as string, v as int into bool:
    v > 1

## Transformación de prueba: incremento.
weave _inc with x as int into int:
    x + 1
