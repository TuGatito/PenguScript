# std/atlas.pengu - The Atlas (Maps)
# Utilities for map collections in PenguScript: key-value access, safe lookups,
# bulk accessors, predicates, reductions, transformations, and filters.
#
# Supported map types (0.15.0 expansion):
#   * `map of string to int`   (baseline: counters, discrete IDs, numeric config)
#   * `map of string to string`(JSON objects, HTTP headers, textual config)
#   * `map of string to float` (metrics, stats, weights, embeddings, scientific)
#   * `map of int to int`      (caches, frequency tables, sparse integer arrays)
#   * `map of int to string`   (ID to label lookups, enum stringification tables)
#   * `map of string to bool`  (feature flags, capabilities, permission sets)
#
# Calling conventions:
#   * Method style (recommended): importing std.atlas enchants all supported map
#     types directly, allowing object-oriented method calls on map variables:
#       calling m.size
#       calling m.has_key with "apple"
#       calling m.get_or with "cherry", 0
#       calling m.keys_sorted
#       calling m.clone
#   * Module-level style (100% backward compatible for `map of string to int`):
#       calling atlas.size with m
#       calling atlas.has_key with m, "apple"
#       calling atlas.get_or with m, "cherry", 0
#   * Concrete type wrappers (for non-string-to-int maps):
#       calling atlas.size_ss with m_ss
#       calling atlas.get_or_ss with m_ss, "key", "fallback"
#       calling atlas.size_sf with m_sf
#       calling atlas.size_ii with m_ii
#       calling atlas.size_is with m_is
#       calling atlas.size_sb with m_sb
#   * Generic module-level utilities (`shard K, V`):
#       calling atlas.map_size of string, string with m
#       calling atlas.map_has_key of string, string with m, "k"
#       calling atlas.map_get_or of int, int with m, 10, -1
#
# Ownership / memory model:
#   * Maps in PenguScript are reference-like structures carrying pointers to
#     underlying bucket allocations. Modifying helpers modify the map in-place.
#   * Helpers that RETURN a map or list allocate an owned fresh container.
#   * Map iteration (`for k in essence of self:` or `for k in m:`) traverses keys
#     in internal hash bucket order. Deterministic ordering requires `keys_sorted`.
#
# Documented TODOs:
#   * Custom key comparison and hashing for user-defined rune types requires Ord
#     and Hash concepts, not yet supported in current compiler.
#   * Streaming serialization of large maps (>2GB) across FFI boundaries.

import std.spark
import std.scrolls

# ----------------------------------------------------------------------------
# Version constant
# ----------------------------------------------------------------------------

## Atlas module version constant.
const ATLAS_VERSION as string is "0.15.0"

# ----------------------------------------------------------------------------
# Internal helpers (avoiding local essence-of-self auto-banish aliasing crashes)
# ----------------------------------------------------------------------------

# string -> int helpers
weave _map_len with m as map of string to int into int:
    return calling m.len

weave _map_contains with m as map of string to int, k as string into bool:
    return calling m.contains with k

# string -> string helpers
weave _contains_ss with m as map of string to string, k as string into bool:
    return calling m.contains with k

# string -> float helpers
weave _contains_sf with m as map of string to float, k as string into bool:
    return calling m.contains with k

# int -> int helpers
weave _contains_ii with m as map of int to int, k as int into bool:
    return calling m.contains with k

# int -> string helpers
weave _contains_is with m as map of int to string, k as int into bool:
    return calling m.contains with k

# string -> bool helpers
weave _contains_sb with m as map of string to bool, k as string into bool:
    return calling m.contains with k

# ----------------------------------------------------------------------------
# Pre-existing function (kept verbatim for 100% backward compatibility)
# ----------------------------------------------------------------------------

# Returns the number of key -> value entries currently stored in the
# `map of string to int` `m`, equivalent to `calling m.len`. The map is
# only read, never modified.
weave map_len_str_int with m as map of string to int into int:
    return calling m.len

# ============================================================================
# 0. Generic Enchanting: `map of shard K to shard V` (Plan B Monomorphization)
# ============================================================================

enchanting map of shard K to shard V where K: Par, V: Par:

    # --- Length & predicates ---

    ## Returns the number of entries stored in `self`. Equivalent to `calling self.len`.
    weave size into int:
        return (essence of self).len

    ## Returns true when `self` contains no entries.
    weave is_empty into bool:
        return (essence of self).len == 0

    ## Returns true when `key` exists in `self`.
    weave has_key with key as K into bool:
        return calling self.contains with key

    ## Returns true if `self` contains at least one key from `keys`.
    weave has_any_key with keys as list of K into bool:
        for k in keys:
            if calling self.contains with k:
                return true
        return false

    ## Returns true if `self` contains all keys in `keys`. Empty keys returns true.
    weave has_all_keys with keys as list of K into bool:
        for k in keys:
            if not (calling self.contains with k):
                return false
        return true

    # --- Access ---

    ## Returns the value associated with `key`, or `default_val` if `key` is absent.
    weave get_or with key as K, default_val as V into V:
        if calling self.contains with key:
            return self at key
        return default_val

    ## Returns `some v` when `key` is present in `self`, or `maybe none` when absent.
    weave get_safe with key as K into maybe V:
        if calling self.contains with key:
            return some (self at key)
        return maybe none

    ## Finds the first key associated with `target` value, or none if not found.
    weave find_key_by_value with target as V into maybe K:
        for k in essence of self:
            if (self at k) == target:
                return some k
        return maybe none

    # --- Mutation ---

    ## Updates the value of an existing `key` in `self`. Returns true if updated, false if absent.
    weave update with key as K, value as V into bool:
        if calling self.contains with key:
            calling self.put with key, value
            return true
        return false

    ## Renames `old_key` to `new_key` preserving its value. Returns false if `old_key` absent.
    weave rename_key with old_key as K, new_key as K into bool:
        if calling self.contains with old_key:
            var v as V is self at old_key
            calling self.put with new_key, v
            if not (old_key == new_key):
                calling self.remove with old_key
            return true
        return false

    ## Removes `key` and its value from `self`. Returns true if key was present.
    weave remove with key as K into bool:
        return calling self.remove with key

    ## Removes all entries from `self`.
    weave clear into void:
        calling self.clear

    ## Removes every key in `keys` from `self`. Returns count of keys actually removed.
    weave remove_all with keys as list of K into int:
        var count as int is 0
        for k in keys:
            if calling self.remove with k:
                set count is count + 1
        return count

    ## Inserts all entries from `other` into `self`, overwriting existing keys.
    weave put_all with other as map of K to V into void:
        for k in other:
            calling self.put with k, (other at k)

    # --- Bulk accessors ---

    ## Returns a fresh list of every key in `self`, in internal hash iteration order.
    weave keys into list of K:
        var result as list of K is list of K
        for k in essence of self:
            calling result.push with k
        return result

    ## Returns a fresh list of every value in `self`, in internal hash iteration order.
    weave values into list of V:
        var result as list of V is list of V
        for k in essence of self:
            calling result.push with self at k
        return result

    ## Returns an independent shallow clone of `self`.
    weave clone into map of K to V:
        var result as map of K to V is map of K to V
        for k in essence of self:
            calling result.put with k, (self at k)
        return result

    ## Creates an independent copy of `self` (alias for `clone`).
    weave copy into map of K to V:
        return calling self.clone

    ## Compares two maps for structural key-value equality.
    weave is_equal with other as map of K to V into bool:
        if (essence of self).len != other.len:
            return false
        for k in essence of self:
            if not (calling other.contains with k):
                return false
            if (self at k) != (other at k):
                return false
        return true

# ============================================================================
# 1. Enchanting: `map of string to int` (Baseline + Enhancements)
# ============================================================================

enchanting map of string to int:

    # --- Length & predicates ---

    ## Returns the number of entries stored in `self`. Equivalent to `calling self.len`.
    weave size into int:
        return (essence of self).len

    ## Returns true when `self` contains no entries.
    weave is_empty into bool:
        return (essence of self).len == 0

    ## Returns true when `key` exists in `self`.
    weave has_key with key as string into bool:
        return calling _map_contains with (essence of self), key

    ## Returns true if every value in `self` is strictly positive (> 0). Empty returns true.
    weave all_values_positive into bool:
        for k in essence of self:
            var v as int is self at k
            if v <= 0:
                return false
        return true

    ## Returns true if any value in `self` is strictly negative (< 0). Empty returns false.
    weave any_value_negative into bool:
        for k in essence of self:
            var v as int is self at k
            if v < 0:
                return true
        return false

    ## Returns true if all values in `self` fall within `[lo, hi]` inclusive. Empty returns true.
    weave values_in_range with lo as int, hi as int into bool:
        for k in essence of self:
            var v as int is self at k
            if v < lo:
                return false
            if v > hi:
                return false
        return true

    ## Returns the count of entries whose value is strictly positive (> 0).
    weave count_if_value_positive into int:
        var count as int is 0
        for k in essence of self:
            if (self at k) > 0:
                set count is count + 1
        return count

    ## Returns the count of entries whose value is strictly negative (< 0).
    weave count_if_value_negative into int:
        var count as int is 0
        for k in essence of self:
            if (self at k) < 0:
                set count is count + 1
        return count

    ## Returns true if `self` contains at least one key from `keys`.
    weave has_any_key with keys as list of string into bool:
        for k in keys:
            if calling _map_contains with (essence of self), k:
                return true
        return false

    ## Returns true if `self` contains all keys in `keys`. Empty keys returns true.
    weave has_all_keys with keys as list of string into bool:
        for k in keys:
            if not (calling _map_contains with (essence of self), k):
                return false
        return true

    # --- Access ---

    ## Returns the value associated with `key`, or `default` if `key` is absent.
    weave get_or with key as string, default as int is 0 into int:
        if calling _map_contains with (essence of self), key:
            return self at key
        return default

    ## Returns `some v` when `key` is present in `self`, or `maybe none` when absent.
    weave get_safe with key as string into maybe int:
        if calling _map_contains with (essence of self), key:
            return some (self at key)
        return maybe none

    ## Finds the first key associated with `target` value, or none if not found.
    weave find_key_by_value with target as int into maybe string:
        for k in essence of self:
            if (self at k) == target:
                return some k
        return maybe none

    # --- Mutation ---

    ## Updates the value of an existing `key` in `self`. Returns true if updated, false if absent.
    weave update with key as string, value as int into bool:
        if calling _map_contains with (essence of self), key:
            with self:
                calling .put with key, value
            return true
        return false

    ## Removes `key` from `self`. Returns true if present and removed, false otherwise.
    weave remove with key as string into bool:
        if calling _map_contains with (essence of self), key:
            with self:
                calling .remove with key
            return true
        return false

    ## Removes every entry from `self`, resetting its length to 0.
    weave clear into void:
        with self:
            calling .clear

    ## Removes all entries matching keys in `keys`. Returns count of entries removed.
    weave remove_all with keys as list of string into int:
        var removed as int is 0
        for k in keys:
            if calling self.remove with k:
                set removed is removed + 1
        return removed

    ## Renames an existing key `old_key` to `new_key`, preserving its value.
    weave rename_key with old_key as string, new_key as string into bool:
        if old_key == new_key:
            return calling _map_contains with (essence of self), old_key
        if calling _map_contains with (essence of self), old_key:
            var v as int is self at old_key
            with self:
                calling .put with new_key, v
                calling .remove with old_key
            return true
        return false

    # --- Bulk accessors ---

    ## Returns a fresh list of every key in `self`, in internal hash iteration order.
    weave keys into list of string:
        var result as list of string is list of string
        for k in essence of self:
            calling result.push with k
        return result

    ## Returns a fresh list of every value in `self`, in internal hash iteration order.
    weave values into list of int:
        var result as list of int is list of int
        for k in essence of self:
            var v as int is self at k
            calling result.push with v
        return result

    ## Returns a fresh list of all keys in `self` sorted alphabetically using `std.scrolls.compare`.
    weave keys_sorted into list of string:
        var ks as list of string is calling self.keys
        var n as int is calling ks.len
        var i as int is 0
        while i < n:
            var j as int is i + 1
            while j < n:
                var a as string is ks at i
                var b as string is ks at j
                if (calling a.compare with b) > 0:
                    var tmp as string is ks at i
                    set ks at i is ks at j
                    set ks at j is tmp
                set j is j + 1
            set i is i + 1
        return ks

    ## Returns a fresh list of all values in `self` sorted numerically ascending.
    weave values_sorted into list of int:
        var vs as list of int is calling self.values
        var n as int is calling vs.len
        var i as int is 0
        while i < n:
            var j as int is i + 1
            while j < n:
                if (vs at i) > (vs at j):
                    var tmp as int is vs at i
                    set vs at i is vs at j
                    set vs at j is tmp
                set j is j + 1
            set i is i + 1
        return vs

    # --- Reductions ---

    ## Returns the arithmetic sum of every value in `self`. Returns 0 if empty.
    weave sum_values into int:
        var total as int is 0
        for k in essence of self:
            var v as int is self at k
            set total is total + v
        return total

    ## Returns the sum of values that fall within `[lo, hi]` inclusive.
    weave sum_values_filtered with lo as int, hi as int into int:
        var total as int is 0
        for k in essence of self:
            var v as int is self at k
            if v >= lo and v <= hi:
                set total is total + v
        return total

    ## Returns the maximum value stored across all entries in `self`. Returns 0 if empty.
    weave max_value into int:
        if (essence of self).len == 0:
            return 0
        var first as bool is true
        var hi as int is 0
        for k in essence of self:
            var v as int is self at k
            if first:
                set hi is v
                set first is false
            else:
                if v > hi:
                    set hi is v
        return hi

    ## Returns the minimum value stored across all entries in `self`. Returns 0 if empty.
    weave min_value into int:
        if (essence of self).len == 0:
            return 0
        var first as bool is true
        var lo as int is 0
        for k in essence of self:
            var v as int is self at k
            if first:
                set lo is v
                set first is false
            else:
                if v < lo:
                    set lo is v
        return lo

    # --- Filters ---

    ## Returns a fresh map with only the entries whose key contains `sub`.
    weave filter_keys_contains with sub as string into map of string to int:
        var result as map of string to int is map of string to int
        for k in essence of self:
            if calling k.contains with sub:
                calling result.put with k, (self at k)
        return result

    ## Returns a fresh map with only the entries whose key starts with `prefix`.
    weave filter_keys_startswith with prefix as string into map of string to int:
        var result as map of string to int is map of string to int
        for k in essence of self:
            if calling k.starts_with with prefix:
                calling result.put with k, (self at k)
        return result

    ## Returns a fresh map with entries whose value is within `[lo, hi]` inclusive.
    weave filter_values_range with lo as int, hi as int into map of string to int:
        var result as map of string to int is map of string to int
        for k in essence of self:
            var v as int is self at k
            if v >= lo:
                if v <= hi:
                    calling result.put with k, v
        return result

    # --- Transformations ---

    ## Returns a fresh map where each value is multiplied by 2 (`v * 2`).
    weave map_values_double into map of string to int:
        var result as map of string to int is map of string to int
        for k in essence of self:
            var v as int is self at k
            calling result.put with k, (v * 2)
        return result

    ## Returns a fresh map where each value is negated (`-v`).
    weave map_values_negate into map of string to int:
        var result as map of string to int is map of string to int
        for k in essence of self:
            var v as int is self at k
            calling result.put with k, (-v)
        return result

    # --- Conversions & Duplication ---

    ## Returns a shallow duplicate of `self` containing fresh entry copies.
    weave clone into map of string to int:
        var result as map of string to int is map of string to int
        for k in essence of self:
            calling result.put with k, (self at k)
        return result

    ## Alias of `clone`.
    weave copy into map of string to int:
        return calling self.clone

    ## Alias of `keys`.
    weave to_keys_list into list of string:
        return calling self.keys

    ## Alias of `values`.
    weave to_values_list into list of int:
        return calling self.values

# ============================================================================
# 2. Enchanting: `map of string to string` (JSON, HTTP, Config)
# ============================================================================

enchanting map of string to string:

    ## Returns the number of entries stored in `self`.
    weave size into int:
        return (essence of self).len

    ## Returns true when `self` contains no entries.
    weave is_empty into bool:
        return (essence of self).len == 0

    ## Returns true when `key` exists in `self`.
    weave has_key with key as string into bool:
        return calling _contains_ss with (essence of self), key

    ## Returns true if `self` contains at least one key from `keys`.
    weave has_any_key with keys as list of string into bool:
        for k in keys:
            if calling _contains_ss with (essence of self), k:
                return true
        return false

    ## Returns true if `self` contains all keys in `keys`.
    weave has_all_keys with keys as list of string into bool:
        for k in keys:
            if not (calling _contains_ss with (essence of self), k):
                return false
        return true

    ## Returns the value associated with `key`, or `default` if `key` is absent.
    weave get_or with key as string, default as string is "" into string:
        if calling _contains_ss with (essence of self), key:
            return self at key
        return default

    ## Returns `some v` when `key` is present in `self`, or `maybe none` when absent.
    weave get_safe with key as string into maybe string:
        if calling _contains_ss with (essence of self), key:
            return some (self at key)
        return maybe none

    ## Finds the first key associated with `target` value, or none if absent.
    weave find_key_by_value with target as string into maybe string:
        for k in essence of self:
            if (self at k) == target:
                return some k
        return maybe none

    ## Updates the value of an existing `key` in `self`. Returns true if updated, false if absent.
    weave update with key as string, value as string into bool:
        if calling _contains_ss with (essence of self), key:
            with self:
                calling .put with key, value
            return true
        return false

    ## Removes `key` from `self`. Returns true if present and removed, false otherwise.
    weave remove with key as string into bool:
        if calling _contains_ss with (essence of self), key:
            with self:
                calling .remove with key
            return true
        return false

    ## Removes every entry from `self`, resetting its length to 0.
    weave clear into void:
        with self:
            calling .clear

    ## Removes all entries matching keys in `keys`. Returns count of entries removed.
    weave remove_all with keys as list of string into int:
        var removed as int is 0
        for k in keys:
            if calling self.remove with k:
                set removed is removed + 1
        return removed

    ## Renames `old_key` to `new_key`, preserving its value.
    weave rename_key with old_key as string, new_key as string into bool:
        if old_key == new_key:
            return calling _contains_ss with (essence of self), old_key
        if calling _contains_ss with (essence of self), old_key:
            var v as string is self at old_key
            with self:
                calling .put with new_key, v
                calling .remove with old_key
            return true
        return false

    ## Returns a fresh list of every key in `self`.
    weave keys into list of string:
        var result as list of string is list of string
        for k in essence of self:
            calling result.push with k
        return result

    ## Returns a fresh list of every value in `self`.
    weave values into list of string:
        var result as list of string is list of string
        for k in essence of self:
            calling result.push with (self at k)
        return result

    ## Returns all keys in `self` sorted alphabetically using `std.scrolls.compare`.
    weave keys_sorted into list of string:
        var ks as list of string is calling self.keys
        var n as int is calling ks.len
        var i as int is 0
        while i < n:
            var j as int is i + 1
            while j < n:
                var a as string is ks at i
                var b as string is ks at j
                if (calling a.compare with b) > 0:
                    var tmp as string is ks at i
                    set ks at i is ks at j
                    set ks at j is tmp
                set j is j + 1
            set i is i + 1
        return ks

    ## Returns all values in `self` sorted alphabetically using `std.scrolls.compare`.
    weave values_sorted into list of string:
        var vs as list of string is calling self.values
        var n as int is calling vs.len
        var i as int is 0
        while i < n:
            var j as int is i + 1
            while j < n:
                var a as string is vs at i
                var b as string is vs at j
                if (calling a.compare with b) > 0:
                    var tmp as string is vs at i
                    set vs at i is vs at j
                    set vs at j is tmp
                set j is j + 1
            set i is i + 1
        return vs

    ## Returns a fresh map with only entries whose key contains `sub`.
    weave filter_keys_contains with sub as string into map of string to string:
        var result as map of string to string is map of string to string
        for k in essence of self:
            if calling k.contains with sub:
                calling result.put with k, (self at k)
        return result

    ## Returns a fresh map with only entries whose key starts with `prefix`.
    weave filter_keys_startswith with prefix as string into map of string to string:
        var result as map of string to string is map of string to string
        for k in essence of self:
            if calling k.starts_with with prefix:
                calling result.put with k, (self at k)
        return result

    ## Returns a fresh map with only entries whose value contains `sub`.
    weave filter_values_contains with sub as string into map of string to string:
        var result as map of string to string is map of string to string
        for k in essence of self:
            var v as string is self at k
            if calling v.contains with sub:
                calling result.put with k, v
        return result

    ## Returns an owned shallow copy of `self`.
    weave clone into map of string to string:
        var result as map of string to string is map of string to string
        for k in essence of self:
            calling result.put with k, (self at k)
        return result

    ## Alias of `clone`.
    weave copy into map of string to string:
        return calling self.clone

    ## Alias of `keys`.
    weave to_keys_list into list of string:
        return calling self.keys

    ## Alias of `values`.
    weave to_values_list into list of string:
        return calling self.values

# ============================================================================
# 3. Enchanting: `map of string to float` (Metrics, Stats, Weights)
# ============================================================================

enchanting map of string to float:

    ## Returns the number of entries stored in `self`.
    weave size into int:
        return (essence of self).len

    ## Returns true when `self` contains no entries.
    weave is_empty into bool:
        return (essence of self).len == 0

    ## Returns true when `key` exists in `self`.
    weave has_key with key as string into bool:
        return calling _contains_sf with (essence of self), key

    ## Returns true if `self` contains at least one key from `keys`.
    weave has_any_key with keys as list of string into bool:
        for k in keys:
            if calling _contains_sf with (essence of self), k:
                return true
        return false

    ## Returns true if `self` contains all keys in `keys`.
    weave has_all_keys with keys as list of string into bool:
        for k in keys:
            if not (calling _contains_sf with (essence of self), k):
                return false
        return true

    ## Returns true if every value in `self` is strictly positive (> 0.0). Empty returns true.
    weave all_values_positive into bool:
        for k in essence of self:
            if (self at k) <= 0.0:
                return false
        return true

    ## Returns true if any value in `self` is strictly negative (< 0.0). Empty returns false.
    weave any_value_negative into bool:
        for k in essence of self:
            if (self at k) < 0.0:
                return true
        return false

