# ============================================================================
# Generic module-level utilities (`shard K, V`)
# ============================================================================

## Returns the number of entries in generic map `m`.
weave map_size shard K, V with m as map of K to V into int:
    return m.len

## Returns true if generic map `m` has no entries.
weave map_is_empty shard K, V with m as map of K to V into bool:
    return m.len == 0

## Returns true if `key` exists in generic map `m`.
weave map_has_key shard K, V with m as map of K to V, key as K into bool:
    return calling m.contains with key

## Returns the value associated with `key` in `m`, or `fallback` if absent.
weave map_get_or shard K, V with m as map of K to V, key as K, fallback as V into V:
    if calling m.contains with key:
        return m at key
    return fallback

## Returns a fresh list of all keys in generic map `m`.
weave map_keys shard K, V with m as map of K to V into list of K:
    var result as list of K is list of K
    for k in m:
        calling result.push with k
    return result

## Returns a fresh list of all values in generic map `m`.
weave map_values shard K, V with m as map of K to V into list of V:
    var result as list of V is list of V
    for k in m:
        calling result.push with (m at k)
    return result

## Inserts or updates `key -> value` in generic map `m`.
weave map_put shard K, V with m as map of K to V, key as K, value as V into void:
    calling m.put with key, value

## Removes `key` from generic map `m`.
weave map_remove shard K, V with m as map of K to V, key as K into bool:
    return calling m.remove with key

## Clears all entries from generic map `m`.
weave map_clear shard K, V with m as map of K to V into void:
    calling m.clear

# ============================================================================
# Module-level wrappers (100% backward compatibility for `map of string to int`)
# ============================================================================

## Returns the number of entries stored in `m`. Equivalent to `calling m.len`.
weave size with m as map of string to int into int:
    return calling m.size

## Returns true when `m` contains no entries.
weave is_empty with m as map of string to int into bool:
    return calling m.is_empty

## Returns true when `key` exists in `m`.
weave has_key with m as map of string to int, key as string into bool:
    return calling m.has_key with key

## Returns true if every value in `m` is strictly positive (> 0). Empty returns true.
weave all_values_positive with m as map of string to int into bool:
    return calling m.all_values_positive

## Returns true if any value in `m` is strictly negative (< 0). Empty returns false.
weave any_value_negative with m as map of string to int into bool:
    return calling m.any_value_negative

## Returns true if all values in `m` fall within `[lo, hi]` inclusive. Empty returns true.
weave values_in_range with m as map of string to int, lo as int, hi as int into bool:
    return calling m.values_in_range with lo, hi

## Returns the value associated with `key`, or `default` if `key` is absent.
weave get_or with m as map of string to int, key as string, default as int is 0 into int:
    return calling m.get_or with key, default

## Returns `some v` when `key` is present in `m`, or `maybe none` when absent.
weave get_safe with m as map of string to int, key as string into maybe int:
    return calling m.get_safe with key

## Inserts or updates the entry `key -> value` in `m`.
weave put with m as map of string to int, key as string, value as int into void:
    calling m.put with key, value

## Removes `key` from `m`. Returns true if the key was present and removed, false otherwise.
weave remove with m as map of string to int, key as string into bool:
    return calling m.remove with key

## Removes every entry from `m`, resetting its length to 0.
weave clear with m as map of string to int into void:
    calling m.clear

## Updates the value of an existing `key` in `m`. Returns true if updated, false if absent.
weave update with m as map of string to int, key as string, value as int into bool:
    return calling m.update with key, value

## Returns a fresh list of every key in `m`, in internal hash iteration order.
weave keys with m as map of string to int into list of string:
    return calling m.keys

## Returns a fresh list of every value in `m`, in internal hash iteration order.
weave values with m as map of string to int into list of int:
    return calling m.values

## Returns a fresh list of all keys in `m` sorted alphabetically.
weave keys_sorted with m as map of string to int into list of string:
    return calling m.keys_sorted

## Returns the arithmetic sum of every value in `m`. Returns 0 if empty.
weave sum_values with m as map of string to int into int:
    return calling m.sum_values

## Returns the maximum value stored across all entries in `m`. Returns 0 if empty.
weave max_value with m as map of string to int into int:
    return calling m.max_value

## Returns the minimum value stored across all entries in `m`. Returns 0 if empty.
weave min_value with m as map of string to int into int:
    return calling m.min_value

## Returns a fresh map with only the entries whose key contains `sub`.
weave filter_keys_contains with m as map of string to int, sub as string into map of string to int:
    return calling m.filter_keys_contains with sub

## Returns a fresh map with only the entries whose key starts with `prefix`.
weave filter_keys_startswith with m as map of string to int, prefix as string into map of string to int:
    return calling m.filter_keys_startswith with prefix

## Returns a fresh map with entries whose value is within `[lo, hi]` inclusive.
weave filter_values_range with m as map of string to int, lo as int, hi as int into map of string to int:
    return calling m.filter_values_range with lo, hi

## Returns a fresh map where each value is multiplied by 2 (`v * 2`).
weave map_values_double with m as map of string to int into map of string to int:
    return calling m.map_values_double

## Returns a fresh map where each value is negated (`-v`).
weave map_values_negate with m as map of string to int into map of string to int:
    return calling m.map_values_negate

## Alias of `keys`.
weave to_keys_list with m as map of string to int into list of string:
    return calling m.to_keys_list

## Alias of `values`.
weave to_values_list with m as map of string to int into list of int:
    return calling m.to_values_list

