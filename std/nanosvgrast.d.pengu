# std/nanosvgrast.d.pengu - The NanoSVG rasterizer (rasterizing SVG shapes into RGBA bitmaps)
# Pure C-binding declaration file: every declaration maps 1:1 to the native
# nanosvgrast C API. This file cannot contain implementation bodies (.d.pengu rule).
# Memory ownership follows the native library contract: read the upstream docs
# next to each declaration; release any returned handle with the library's own
# cleanup routine before dropping the last reference.
## PenguScript declaration binding generated by 'pengu bind'.
## Source header: nanosvgrast.h
include "nanosvgrast.h"

# Bindings of the headers included above: the types they declare
# must be the very same ones this file uses, so import them.
#   nanosvg.h
import std.nanosvg

# -- Constants (#define) ------------------------------

const NSVG__SUBSAMPLES as i64 is 5
const NSVG__FIXSHIFT as i64 is 10
const NSVG__MEMPAGE_SIZE as i64 is 1024

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

alias NSVGrasterizer as opaque

# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia nsvg

# Allocated rasterizer context.
declare CreateRasterizer into ref to NSVGrasterizer

# Rasterizes SVG image, returns RGBA image (non-premultiplied alpha)
# r - pointer to rasterizer context
# image - pointer to image to rasterize
# tx,ty - image offset (applied after scaling)
# scale - image scale
# dst - pointer to destination image data, 4 bytes per pixel (RGBA)
# w - width of the image to render
# h - height of the image to render
# stride - number of bytes per scaleline in the destination buffer
declare Rasterize with r as ref to NSVGrasterizer, image as ref to NSVGimage, tx as f32, ty as f32, scale as f32, dst as ref to byte, w as int, h as int, stride as int into void

# Deletes rasterizer context.
declare DeleteRasterizer with p0 as ref to NSVGrasterizer into void
