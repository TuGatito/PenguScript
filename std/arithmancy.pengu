        var b01 as float is self->m00 * self->m12 - self->m02 * self->m10
        var b02 as float is self->m00 * self->m13 - self->m03 * self->m10
        var b03 as float is self->m01 * self->m12 - self->m02 * self->m11
        var b04 as float is self->m01 * self->m13 - self->m03 * self->m11
        var b05 as float is self->m02 * self->m13 - self->m03 * self->m12
        var b06 as float is self->m20 * self->m31 - self->m21 * self->m30
        var b07 as float is self->m20 * self->m32 - self->m22 * self->m30
        var b08 as float is self->m20 * self->m33 - self->m23 * self->m30
        var b09 as float is self->m21 * self->m32 - self->m22 * self->m31
        var b10 as float is self->m21 * self->m33 - self->m23 * self->m31
