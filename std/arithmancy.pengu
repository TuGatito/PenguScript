## Constructs a new Quaternion (x, y, z, w).
weave quat with x as float , y as float , z as float , w as float into Quat:
    return with x is x , y is y , z is z , w is w

## Returns an identity Quaternion (0, 0, 0, 1).
weave quat_identity into Quat:
    return with x is 0.0 , y is 0.0 , z is 0.0 , w is 1.0

## Constructs a Quaternion from an axis and rotation angle in radians.
weave quat_from_axis_angle with axis as Vec3 , angle_rad as float into Quat:
    var half_angle as float is angle_rad * 0.5
    var s as float is calling sin with half_angle
    var a as Vec3 is calling axis.normalize
    return with x is a.x * s , y is a.y * s , z is a.z * s , w is calling cos with half_angle

## Constructs a Quaternion from Euler angles roll (rx), pitch (ry), yaw (rz) in radians.
weave quat_from_euler with rx as float , ry as float , rz as float into Quat:
    var c1 as float is calling cos with (rx * 0.5)
    var s1 as float is calling sin with (rx * 0.5)
    var c2 as float is calling cos with (ry * 0.5)
    var s2 as float is calling sin with (ry * 0.5)
    var c3 as float is calling cos with (rz * 0.5)
    var s3 as float is calling sin with (rz * 0.5)
    return with x is s1 * c2 * c3 - c1 * s2 * s3 , y is c1 * s2 * c3 + s1 * c2 * s3 , z is c1 * c2 * s3 - s1 * s2 * c3 , w is c1 * c2 * c3 + s1 * s2 * s3

enchanting Quat:
    weave ritual identity into Quat:
        return calling quat_identity

    weave ritual zero into Quat:
        return with x is 0.0 , y is 0.0 , z is 0.0 , w is 0.0

    weave multiply with other as Quat into Quat:
        return with x is self->w * other.x + self->x * other.w + self->y * other.z - self->z * other.y , y is self->w * other.y - self->x * other.z + self->y * other.w + self->z * other.x , z is self->w * other.z + self->x * other.y - self->y * other.x + self->z * other.w , w is self->w * other.w - self->x * other.x - self->y * other.y - self->z * other.z

    weave conjugate into Quat:
        return with x is -self->x , y is -self->y , z is -self->z , w is self->w

    weave length_sq into float:
        return self->x * self->x + self->y * self->y + self->z * self->z + self->w * self->w

    weave length into float:
        return calling sqrt with (calling self.length_sq)

    weave normalize into Quat:
        var l as float is calling self.length
        if l == 0.0:
            return with x is 0.0 , y is 0.0 , z is 0.0 , w is 1.0
        return with x is self->x / l , y is self->y / l , z is self->z / l , w is self->w / l

    weave dot with other as Quat into float:
        return self->x * other.x + self->y * other.y + self->z * other.z + self->w * other.w

    weave inverse into Quat:
        var lsq as float is calling self.length_sq
        if lsq == 0.0:
            return calling quat_identity
        return with x is -self->x / lsq , y is -self->y / lsq , z is -self->z / lsq , w is self->w / lsq

    weave rotate_vector with v as Vec3 into Vec3:
        var qv as Vec3 is with x is self->x , y is self->y , z is self->z
        var uv as Vec3 is calling qv.cross with v
        var uuv as Vec3 is calling qv.cross with uv
        var term1 as Vec3 is calling uv.scale with (2.0 * self->w)
        var term2 as Vec3 is calling uuv.scale with 2.0
        var sum1 as Vec3 is calling v.add with term1
        return calling sum1.add with term2

    weave slerp with other as Quat , t as float into Quat:
        var cos_half_theta as float is calling self.dot with other
        var target as Quat is other
        if cos_half_theta < 0.0:
            set target is with x is -other.x , y is -other.y , z is -other.z , w is -other.w
            set cos_half_theta is -cos_half_theta
        if cos_half_theta > 0.9995:
            var res as Quat is with x is self->x + (target.x - self->x) * t , y is self->y + (target.y - self->y) * t , z is self->z + (target.z - self->z) * t , w is self->w + (target.w - self->w) * t
            return calling res.normalize
        var half_theta as float is calling acos with cos_half_theta
        var sin_half_theta as float is calling sqrt with (1.0 - cos_half_theta * cos_half_theta)
        if sin_half_theta == 0.0:
            return essence of self
        var ratio_a as float is (calling sin with ((1.0 - t) * half_theta)) / sin_half_theta
        var ratio_b as float is (calling sin with (t * half_theta)) / sin_half_theta
        return with x is self->x * ratio_a + target.x * ratio_b , y is self->y * ratio_a + target.y * ratio_b , z is self->z * ratio_a + target.z * ratio_b , w is self->w * ratio_a + target.w * ratio_b

    weave to_matrix into Mat4:
        var qx as float is self->x
        var qy as float is self->y
        var qz as float is self->z
        var qw as float is self->w
        return with m00 is 1.0 - 2.0 * (qy * qy + qz * qz) , m01 is 2.0 * (qx * qy - qz * qw) , m02 is 2.0 * (qx * qz + qy * qw) , m03 is 0.0 , m10 is 2.0 * (qx * qy + qz * qw) , m11 is 1.0 - 2.0 * (qx * qx + qz * qz) , m12 is 2.0 * (qy * qz - qx * qw) , m13 is 0.0 , m20 is 2.0 * (qx * qz - qy * qw) , m21 is 2.0 * (qy * qz + qx * qw) , m22 is 1.0 - 2.0 * (qx * qx + qy * qy) , m23 is 0.0 , m30 is 0.0 , m31 is 0.0 , m32 is 0.0 , m33 is 1.0

    weave to_string into string:
        return "({(self->x to string)}, {(self->y to string)}, {(self->z to string)}, {(self->w to string)})"