        var x as float is self->m00 * p.x + self->m01 * p.y + self->m02 * p.z + self->m03
        var y as float is self->m10 * p.x + self->m11 * p.y + self->m12 * p.z + self->m13
        var z as float is self->m20 * p.x + self->m21 * p.y + self->m22 * p.z + self->m23
        if w != 0.0 and w != 1.0:
            return with x is x / w , y is y / w , z is z / w
        return with x is x , y is y , z is z

    weave transform_direction with d as Vec3 into Vec3:
