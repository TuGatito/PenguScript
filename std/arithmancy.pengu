## Constructs a new Vec4 with components `x`, `y`, `z`, and `w`.
weave vec4 with x as float , y as float , z as float , w as float into Vec4:
    return with x is x , y is y , z is z , w is w

enchanting Vec4:
    weave ritual zero into Vec4:
        return with x is 0.0 , y is 0.0 , z is 0.0 , w is 0.0

    weave ritual one into Vec4:
        return with x is 1.0 , y is 1.0 , z is 1.0 , w is 1.0

    weave add with other as Vec4 into Vec4:
        return with x is self->x + other.x , y is self->y + other.y , z is self->z + other.z , w is self->w + other.w

    weave sub with other as Vec4 into Vec4:
        return with x is self->x - other.x , y is self->y - other.y , z is self->z - other.z , w is self->w - other.w

    weave scale with s as float into Vec4:
        return with x is self->x * s , y is self->y * s , z is self->z * s , w is self->w * s

    weave div with s as float into Vec4:
        if s == 0.0:
            return with x is 0.0 , y is 0.0 , z is 0.0 , w is 0.0
        return with x is self->x / s , y is self->y / s , z is self->z / s , w is self->w / s

    weave negate into Vec4:
        return with x is -self->x , y is -self->y , z is -self->z , w is -self->w

    weave dot with other as Vec4 into float:
        return self->x * other.x + self->y * other.y + self->z * other.z + self->w * other.w

    weave length_sq into float:
        return self->x * self->x + self->y * self->y + self->z * self->z + self->w * self->w

    weave length into float:
        return calling sqrt with (calling self.length_sq)

    weave normalize into Vec4:
        var l as float is calling self.length
        if l == 0.0:
            return with x is 0.0 , y is 0.0 , z is 0.0 , w is 0.0
        return with x is self->x / l , y is self->y / l , z is self->z / l , w is self->w / l

    weave normalize_or_zero into Vec4:
        return calling self.normalize

    weave lerp with other as Vec4 , t as float into Vec4:
        return with x is self->x + (other.x - self->x) * t , y is self->y + (other.y - self->y) * t , z is self->z + (other.z - self->z) * t , w is self->w + (other.w - self->w) * t

    weave equals with other as Vec4 , eps as float is 0.000001 into bool:
        return (calling approx_eq with self->x , other.x , eps) and (calling approx_eq with self->y , other.y , eps) and (calling approx_eq with self->z , other.z , eps) and (calling approx_eq with self->w , other.w , eps)

    weave is_zero into bool:
        return (calling approx_eq with self->x , 0.0) and (calling approx_eq with self->y , 0.0) and (calling approx_eq with self->z , 0.0) and (calling approx_eq with self->w , 0.0)

    weave xyz into Vec3:
        return with x is self->x , y is self->y , z is self->z

    weave to_vec2 into Vec2:
        return with x is self->x , y is self->y

    weave to_vec3 into Vec3:
        return with x is self->x , y is self->y , z is self->z

    weave homogeneous_divide into Vec3:
        if self->w == 0.0:
            return with x is self->x , y is self->y , z is self->z
        return with x is self->x / self->w , y is self->y / self->w , z is self->z / self->w

    weave to_string into string:
        return "({(self->x to string)}, {(self->y to string)}, {(self->z to string)}, {(self->w to string)})"

