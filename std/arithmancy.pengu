# std/arithmancy.pengu - Arithmancy (Game-Ready Mathematics)
# Provides comprehensive mathematical functions, scalar utilities, and
# pure PenguScript geometric types (Vec2, Vec3, Vec4, Mat4, Quat) for
# 2D/3D game development and scientific computing without dependencies.
#
# Typical usage:
#   import std.arithmancy
#   var v as arithmancy.Vec2 is calling arithmancy.vec2 with 3.0, 4.0
#   var len as float is calling v.length
#   var rot as arithmancy.Mat4 is calling arithmancy.mat4_rotate_z with arithmancy.HALF_PI
#
# Notes & Architecture:
#   * Vector and Matrix types are pure PenguScript value records (runes).
#     They are passed and returned by value; no heap allocations, no banish.
#   * Trigonometric and transcendental functions bind to libm via C99 bridges.
#   * Coexists with 'std.raymath': arithmancy covers ~90% of common game math
#     in pure PenguScript; raymath provides specialized C raylib bindings.
#   * Unsupported here (use raymath if needed): Perlin/simplex noise,
#     complex spline curves, and specialized 3D mesh collision queries.

import std.spark

# ----------------------------------------------------------------------------
# Module Version & Mathematical Constants
# ----------------------------------------------------------------------------

## Arithmancy module version.
const ARITHMANCY_VERSION as string is "0.16.0"

## Pi: ratio of a circle's circumference to its diameter.
const PI as float is 3.141592653589793
## Tau: one full turn in radians (equal to 2 * PI).
const TAU as float is 6.283185307179586
## Euler's number: base of the natural logarithm.
const E as float is 2.718281828459045

## Degrees to radians conversion factor (PI / 180).
const DEG2RAD as float is 0.017453292519943295
## Radians to degrees conversion factor (180 / PI).
const RAD2DEG as float is 57.29577951308232
## Standard floating-point comparison epsilon.
const EPSILON as float is 0.000001

## Half Pi (90 degrees in radians).
const HALF_PI as float is 1.5707963267948966
## Quarter Pi (45 degrees in radians).
const QUARTER_PI as float is 0.7853981633974483
## Two Pi (alias for TAU, 360 degrees in radians).
const TWO_PI as float is 6.283185307179586
## Inverse of Pi (1 / PI).
const INV_PI as float is 0.3183098861837907
## Square root of 2.
const SQRT2 as float is 1.4142135623730951
## Square root of 3.
const SQRT3 as float is 1.7320508075688772

# ----------------------------------------------------------------------------
# C Math Runtime Declarations (libm bridges)
# ----------------------------------------------------------------------------

declare pengu_c_fabs with x as float into float
declare pengu_c_sqrt with x as float into float
declare pengu_c_pow with x as float , y as float into float
declare pengu_c_floor with x as float into float
declare pengu_c_ceil with x as float into float
declare pengu_c_round with x as float into float
declare pengu_c_trunc with x as float into float
declare pengu_c_fmod with x as float , y as float into float
declare pengu_c_sin with x as float into float
declare pengu_c_cos with x as float into float
declare pengu_c_tan with x as float into float
declare pengu_c_asin with x as float into float
declare pengu_c_acos with x as float into float
declare pengu_c_atan with x as float into float
declare pengu_c_atan2 with y as float , x as float into float
declare pengu_c_exp with x as float into float
declare pengu_c_log with x as float into float
declare pengu_c_log10 with x as float into float
declare pengu_c_log2 with x as float into float
declare pengu_c_sinh with x as float into float
declare pengu_c_cosh with x as float into float
declare pengu_c_tanh with x as float into float
declare pengu_c_asinh with x as float into float
declare pengu_c_acosh with x as float into float
declare pengu_c_atanh with x as float into float

# ----------------------------------------------------------------------------
# C Math Wrappers (float in, float out)
# ----------------------------------------------------------------------------

## Absolute value of `x` (C fabs).
weave abs with x as float into float:
    return calling pengu_c_fabs with x

## Absolute value of integer `x`.
weave abs_i with x as int into int:
    if x < 0:
        return -x
    return x

## Square root of `x` (C sqrt). Domain: x >= 0.
weave sqrt with x as float into float:
    return calling pengu_c_sqrt with x

## Raises `x` to the power `y` (C pow).
weave pow with x as float , y as float into float:
    return calling pengu_c_pow with x , y

## Largest integer not greater than `x`, returned as a float (C floor).
weave floor with x as float into float:
    return calling pengu_c_floor with x

## Smallest integer not less than `x`, returned as a float (C ceil).
weave ceil with x as float into float:
    return calling pengu_c_ceil with x

## Rounds `x` to the nearest integer, returned as a float (C round).
weave round with x as float into float:
    return calling pengu_c_round with x

## Truncates `x` towards zero (drops fractional part), returned as a float.
weave trunc with x as float into float:
    return calling pengu_c_trunc with x

## Floating-point remainder of `x` divided by `y` (C fmod).
weave fmod with x as float , y as float into float:
    return calling pengu_c_fmod with x , y

## Sine of angle `x` in radians (C sin).
weave sin with x as float into float:
    return calling pengu_c_sin with x

## Cosine of angle `x` in radians (C cos).
weave cos with x as float into float:
    return calling pengu_c_cos with x

## Tangent of angle `x` in radians (C tan).
weave tan with x as float into float:
    return calling pengu_c_tan with x

## Arc sine of `x` in radians (C asin). Domain: [-1, 1].
weave asin with x as float into float:
    return calling pengu_c_asin with x

## Arc cosine of `x` in radians (C acos). Domain: [-1, 1].
weave acos with x as float into float:
    return calling pengu_c_acos with x

## Arc tangent of `x` in radians (C atan).
weave atan with x as float into float:
    return calling pengu_c_atan with x

## Four-quadrant arc tangent of `y` / `x` in radians (C atan2).
weave atan2 with y as float , x as float into float:
    return calling pengu_c_atan2 with y , x

## Exponential: e raised to the power `x` (C exp).
weave exp with x as float into float:
    return calling pengu_c_exp with x

## Natural logarithm of `x` (C log). Domain: x > 0.
weave log with x as float into float:
    return calling pengu_c_log with x

## Base-10 logarithm of `x` (C log10). Domain: x > 0.
weave log10 with x as float into float:
    return calling pengu_c_log10 with x

## Base-2 logarithm of `x` (C log2). Domain: x > 0.
weave log2 with x as float into float:
    return calling pengu_c_log2 with x

# ----------------------------------------------------------------------------
# Pure PenguScript Scalar & Integer Helpers
# ----------------------------------------------------------------------------

## Primality test for integer `n` using 6k +/- 1 trial division.
weave is_prime with n as int into bool:
    if n <= 1:
        return false
    if n <= 3:
        return true
    if n % 2 == 0:
        return false
    if n % 3 == 0:
        return false
    var i as int is 5
    while i <= n / i:
        if n % i == 0:
            return false
        if n % (i + 2) == 0:
            return false
        set i is i + 6
    return true

## Greatest common divisor of `a` and `b` (Euclid's algorithm).
weave gcd with a as int , b as int into int:
    var x as int is calling abs_i with a
    var y as int is calling abs_i with b
    while y != 0:
        var t as int is y
        set y is x % y
        set x is t
    return x

## Least common multiple of `a` and `b`.
weave lcm with a as int , b as int into int:
    if a == 0 or b == 0:
        return 0
    var g as int is calling gcd with a , b
    return calling abs_i with (a / g) * b

## Smaller of two floats.
weave min with a as float , b as float into float:
    if a < b:
        return a
    return b

## Smaller of two ints.
weave min_i with a as int , b as int into int:
    if a < b:
        return a
    return b

## Larger of two floats.
weave max with a as float , b as float into float:
    if a > b:
        return a
    return b

## Larger of two ints.
weave max_i with a as int , b as int into int:
    if a > b:
        return a
    return b

## Clamps float `val` into the inclusive range [min_val, max_val].
weave clamp with val as float , min_val as float , max_val as float into float:
    if val < min_val:
        return min_val
    if val > max_val:
        return max_val
    return val

## Clamps int `val` into the inclusive range [lo, hi].
weave clamp_i with val as int , lo as int , hi as int into int:
    if val < lo:
        return lo
    if val > hi:
        return hi
    return val

## Linear interpolation between `a` and `b`: a + (b - a) * t.
weave lerp with a as float , b as float , t as float into float:
    return a + (b - a) * t

## Converts angle from degrees to radians.
weave deg_to_rad with deg as float into float:
    return deg * (PI / 180.0)

## Converts angle from radians to degrees.
weave rad_to_deg with rad as float into float:
    return rad * (180.0 / PI)

## Returns -1.0, 0.0, or 1.0 depending on the sign of float `x`.
weave sign with x as float into float:
    if x > 0.0:
        return 1.0
    if x < 0.0:
        return -1.0
    return 0.0

## Returns -1, 0, or 1 depending on the sign of int `x`.
weave sign_i with x as int into int:
    if x > 0:
        return 1
    if x < 0:
        return -1
    return 0

## Compares two floats for approximate equality within `eps` tolerance.
weave approx_eq with a as float , b as float , eps as float is 0.000001 into bool:
    return (calling abs with (a - b)) <= eps

## Smoothstep: Hermite interpolation between `edge0` and `edge1`.
weave smoothstep with edge0 as float , edge1 as float , x as float into float:
    if edge0 == edge1:
        return 0.0
    var t as float is calling clamp with ((x - edge0) / (edge1 - edge0)) , 0.0 , 1.0
    return t * t * (3.0 - 2.0 * t)

## Step function: returns 0.0 if `x < edge`, 1.0 otherwise.
weave step with edge as float , x as float into float:
    if x < edge:
        return 0.0
    return 1.0

## Remaps `v` from range [in_min, in_max] to range [out_min, out_max].
weave remap with v as float , in_min as float , in_max as float , out_min as float , out_max as float into float:
    var t as float is (v - in_min) / (in_max - in_min)
    return out_min + t * (out_max - out_min)

## Wraps `val` into the range [lo, hi).
weave wrap_val with val as float , lo as float , hi as float into float:
    var range as float is hi - lo
    if range == 0.0:
        return lo
    var rem as float is calling fmod with (val - lo) , range
    if rem < 0.0:
        set rem is rem + range
    return lo + rem

## Normalizes an angle into [0, 2*PI).
weave wrap_angle with a as float into float:
    return calling wrap_val with a , 0.0 , TAU

## Shortest angular difference from angle `a` to `b` in radians (range [-PI, PI]).
weave angle_diff with a as float , b as float into float:
    var diff as float is calling fmod with (b - a + PI) , TAU
    if diff < 0.0:
        set diff is diff + TAU
    return diff - PI

## Moves `current` towards `target` by at most `max_delta`.
weave move_towards with current as float , target as float , max_delta as float into float:
    if (calling abs with (target - current)) <= max_delta:
        return target
    return current + (calling sign with (target - current)) * max_delta

## Ping-pong oscillating value between 0.0 and `length`.
weave ping_pong with t as float , length as float into float:
    if length == 0.0:
        return 0.0
    var l2 as float is 2.0 * length
    var rem as float is calling fmod with t , l2
    if rem < 0.0:
        set rem is rem + l2
    if rem > length:
        return l2 - rem
    return rem

## Repeats `t` in the range [0.0, length).
weave repeat_val with t as float , length as float into float:
    if length == 0.0:
        return 0.0
    var rem as float is calling fmod with t , length
    if rem < 0.0:
        set rem is rem + length
    return rem

## Returns true if integer `n` is a positive power of two.
weave is_power_of_two with n as int into bool:
    return n > 0 and (n & (n - 1)) == 0

## Returns the smallest power of two greater than or equal to `n`.
weave next_power_of_two with n as int into int:
    if n <= 1:
        return 1
    var p as int is 1
    while p < n:
        set p is p * 2
    return p

## Rounds float `x` to nearest int.
weave to_int_round with x as float into int:
    return (calling round with x) to int

## Rounds float `x` down to int.
weave to_int_floor with x as float into int:
    return (calling floor with x) to int

## Rounds float `x` up to int.
weave to_int_ceil with x as float into int:
    return (calling ceil with x) to int

## Inverse square: 1 / (x * x). Returns 0.0 if x == 0.
weave inv_sq with x as float into float:
    if x == 0.0:
        return 0.0
    return 1.0 / (x * x)

## Hypotenuse: sqrt(a^2 + b^2).
weave hypot with a as float , b as float into float:
    return calling sqrt with (a * a + b * b)

## 2D Euclidean distance between (x1, y1) and (x2, y2).
weave dist_2d with x1 as float , y1 as float , x2 as float , y2 as float into float:
    var dx as float is x2 - x1
    var dy as float is y2 - y1
    return calling sqrt with (dx * dx + dy * dy)

## 3D Euclidean distance between (x1, y1, z1) and (x2, y2, z2).
weave dist_3d with x1 as float , y1 as float , z1 as float , x2 as float , y2 as float , z2 as float into float:
    var dx as float is x2 - x1
    var dy as float is y2 - y1
    var dz as float is z2 - z1
    return calling sqrt with (dx * dx + dy * dy + dz * dz)

# ----------------------------------------------------------------------------
# Vector & Matrix Geometric Types (Pure PenguScript)
# ----------------------------------------------------------------------------

## 2D Vector with x and y float components.
rune Vec2:
    x as float
    y as float

## 3D Vector with x, y, and z float components.
rune Vec3:
    x as float
    y as float
    z as float

## 4D Vector with x, y, z, and w float components.
rune Vec4:
    x as float
    y as float
    z as float
    w as float

## 4x4 Transformation Matrix in row-major order.
rune Mat4:
    m00 as float
    m01 as float
    m02 as float
    m03 as float
    m10 as float
    m11 as float
    m12 as float
    m13 as float
    m20 as float
    m21 as float
    m22 as float
    m23 as float
    m30 as float
    m31 as float
    m32 as float
    m33 as float

## Unit Quaternion representing 3D rotation (x, y, z, w).
rune Quat:
    x as float
    y as float
    z as float
    w as float

# ----------------------------------------------------------------------------
# Vec2 Construction & Methods
# ----------------------------------------------------------------------------

## Constructs a new Vec2 with components `x` and `y`.
weave vec2 with x as float , y as float into Vec2:
    return with x is x , y is y

enchanting Vec2:
    weave ritual zero into Vec2:
        return with x is 0.0 , y is 0.0

    weave ritual one into Vec2:
        return with x is 1.0 , y is 1.0

    weave ritual up into Vec2:
        return with x is 0.0 , y is -1.0

    weave ritual down into Vec2:
        return with x is 0.0 , y is 1.0

    weave ritual left into Vec2:
        return with x is -1.0 , y is 0.0

    weave ritual right into Vec2:
        return with x is 1.0 , y is 0.0

    weave add with other as Vec2 into Vec2:
        return with x is self->x + other.x , y is self->y + other.y

    weave sub with other as Vec2 into Vec2:
        return with x is self->x - other.x , y is self->y - other.y

    weave scale with s as float into Vec2:
        return with x is self->x * s , y is self->y * s

    weave div with s as float into Vec2:
        if s == 0.0:
            return with x is 0.0 , y is 0.0
        return with x is self->x / s , y is self->y / s

    weave negate into Vec2:
        return with x is -self->x , y is -self->y

    weave dot with other as Vec2 into float:
        return self->x * other.x + self->y * other.y

    weave cross_2d with other as Vec2 into float:
        return self->x * other.y - self->y * other.x

    weave length_sq into float:
        return self->x * self->x + self->y * self->y

    weave length into float:
        return calling sqrt with (calling self.length_sq)

    weave distance_sq with other as Vec2 into float:
        var dx as float is self->x - other.x
        var dy as float is self->y - other.y
        return dx * dx + dy * dy

    weave distance with other as Vec2 into float:
        return calling sqrt with (calling self.distance_sq with other)

    weave normalize into Vec2:
        var l as float is calling self.length
        if l == 0.0:
            return with x is 0.0 , y is 0.0
        return with x is self->x / l , y is self->y / l

    weave normalize_or_zero into Vec2:
        return calling self.normalize

    weave perpendicular into Vec2:
        return with x is -self->y , y is self->x

    weave rotate with angle_rad as float into Vec2:
        var c as float is calling cos with angle_rad
        var s as float is calling sin with angle_rad
        return with x is self->x * c - self->y * s , y is self->x * s + self->y * c

    weave rotate_around with center as Vec2 , angle_rad as float into Vec2:
        var rel as Vec2 is calling self.sub with center
        var rot as Vec2 is calling rel.rotate with angle_rad
        return calling rot.add with center

    weave angle into float:
        return calling atan2 with self->y , self->x

    weave angle_between with other as Vec2 into float:
        var d as float is calling self.dot with other
        var mag as float is (calling self.length) * (calling other.length)
        if mag == 0.0:
            return 0.0
        var cos_theta as float is calling clamp with (d / mag) , -1.0 , 1.0
        return calling acos with cos_theta

    weave direction_to with other as Vec2 into Vec2:
        var diff as Vec2 is with x is other.x - self->x , y is other.y - self->y
        return calling diff.normalize

    weave lerp with other as Vec2 , t as float into Vec2:
        return with x is self->x + (other.x - self->x) * t , y is self->y + (other.y - self->y) * t

    weave move_towards with other as Vec2 , max_dist as float into Vec2:
        var diff as Vec2 is with x is other.x - self->x , y is other.y - self->y
        var dist as float is calling diff.length
        if dist <= max_dist or dist == 0.0:
            return other
        var sc as Vec2 is calling diff.scale with (max_dist / dist)
        return calling self.add with sc

    weave reflect with normal as Vec2 into Vec2:
        var d as float is 2.0 * (calling self.dot with normal)
        return calling self.sub with (calling normal.scale with d)

    weave min_v with other as Vec2 into Vec2:
        return with x is (calling min with self->x , other.x) , y is (calling min with self->y , other.y)

    weave max_v with other as Vec2 into Vec2:
        return with x is (calling max with self->x , other.x) , y is (calling max with self->y , other.y)

    weave equals with other as Vec2 , eps as float is 0.000001 into bool:
        return (calling approx_eq with self->x , other.x , eps) and (calling approx_eq with self->y , other.y , eps)

    weave is_zero into bool:
        return (calling approx_eq with self->x , 0.0) and (calling approx_eq with self->y , 0.0)

    weave to_vec3 with z as float into Vec3:
        return with x is self->x , y is self->y , z is z

    weave to_vec4 with z as float , w as float into Vec4:
        return with x is self->x , y is self->y , z is z , w is w

    weave to_string into string:
        return "({(self->x to string)}, {(self->y to string)})"

# ----------------------------------------------------------------------------
# Vec3 Construction & Methods
# ----------------------------------------------------------------------------

## Constructs a new Vec3 with components `x`, `y`, and `z`.
weave vec3 with x as float , y as float , z as float into Vec3:
    return with x is x , y is y , z is z

enchanting Vec3:
    weave ritual zero into Vec3:
        return with x is 0.0 , y is 0.0 , z is 0.0

    weave ritual one into Vec3:
        return with x is 1.0 , y is 1.0 , z is 1.0

    weave ritual up into Vec3:
        return with x is 0.0 , y is 1.0 , z is 0.0

    weave ritual down into Vec3:
        return with x is 0.0 , y is -1.0 , z is 0.0

    weave ritual left into Vec3:
        return with x is -1.0 , y is 0.0 , z is 0.0

    weave ritual right into Vec3:
        return with x is 1.0 , y is 0.0 , z is 0.0

    weave ritual forward into Vec3:
        return with x is 0.0 , y is 0.0 , z is -1.0

    weave ritual back into Vec3:
        return with x is 0.0 , y is 0.0 , z is 1.0

    weave add with other as Vec3 into Vec3:
        return with x is self->x + other.x , y is self->y + other.y , z is self->z + other.z

    weave sub with other as Vec3 into Vec3:
        return with x is self->x - other.x , y is self->y - other.y , z is self->z - other.z

    weave scale with s as float into Vec3:
        return with x is self->x * s , y is self->y * s , z is self->z * s

    weave div with s as float into Vec3:
        if s == 0.0:
            return with x is 0.0 , y is 0.0 , z is 0.0
        return with x is self->x / s , y is self->y / s , z is self->z / s

    weave negate into Vec3:
        return with x is -self->x , y is -self->y , z is -self->z

    weave dot with other as Vec3 into float:
        return self->x * other.x + self->y * other.y + self->z * other.z

    weave cross with other as Vec3 into Vec3:
        return with x is self->y * other.z - self->z * other.y , y is self->z * other.x - self->x * other.z , z is self->x * other.y - self->y * other.x

    weave length_sq into float:
        return self->x * self->x + self->y * self->y + self->z * self->z

    weave length into float:
        return calling sqrt with (calling self.length_sq)

    weave distance_sq with other as Vec3 into float:
        var dx as float is self->x - other.x
        var dy as float is self->y - other.y
        var dz as float is self->z - other.z
        return dx * dx + dy * dy + dz * dz

    weave distance with other as Vec3 into float:
        return calling sqrt with (calling self.distance_sq with other)

    weave normalize into Vec3:
        var l as float is calling self.length
        if l == 0.0:
            return with x is 0.0 , y is 0.0 , z is 0.0
        return with x is self->x / l , y is self->y / l , z is self->z / l

    weave normalize_or_zero into Vec3:
        return calling self.normalize

    weave rotate_around_axis with axis as Vec3 , angle_rad as float into Vec3:
        var a as Vec3 is calling axis.normalize
        var cos_a as float is calling cos with angle_rad
        var sin_a as float is calling sin with angle_rad
        var dot_a as float is calling self.dot with a
        var cr as Vec3 is calling a.cross with (essence of self)
        var term1 as Vec3 is calling self.scale with cos_a
        var term2 as Vec3 is calling cr.scale with sin_a
        var term3 as Vec3 is calling a.scale with (dot_a * (1.0 - cos_a))
        var sum1 as Vec3 is calling term1.add with term2
        return calling sum1.add with term3

    weave angle_between with other as Vec3 into float:
        var d as float is calling self.dot with other
        var mag as float is (calling self.length) * (calling other.length)
        if mag == 0.0:
            return 0.0
        var cos_theta as float is calling clamp with (d / mag) , -1.0 , 1.0
        return calling acos with cos_theta

    weave direction_to with other as Vec3 into Vec3:
        var diff as Vec3 is with x is other.x - self->x , y is other.y - self->y , z is other.z - self->z
        return calling diff.normalize

    weave lerp with other as Vec3 , t as float into Vec3:
        return with x is self->x + (other.x - self->x) * t , y is self->y + (other.y - self->y) * t , z is self->z + (other.z - self->z) * t

    weave move_towards with other as Vec3 , max_dist as float into Vec3:
        var diff as Vec3 is with x is other.x - self->x , y is other.y - self->y , z is other.z - self->z
        var dist as float is calling diff.length
        if dist <= max_dist or dist == 0.0:
            return other
        var sc as Vec3 is calling diff.scale with (max_dist / dist)
        return calling self.add with sc

    weave reflect with normal as Vec3 into Vec3:
        var d as float is 2.0 * (calling self.dot with normal)
        return calling self.sub with (calling normal.scale with d)

    weave min_v with other as Vec3 into Vec3:
        return with x is (calling min with self->x , other.x) , y is (calling min with self->y , other.y) , z is (calling min with self->z , other.z)

    weave max_v with other as Vec3 into Vec3:
        return with x is (calling max with self->x , other.x) , y is (calling max with self->y , other.y) , z is (calling max with self->z , other.z)

    weave equals with other as Vec3 , eps as float is 0.000001 into bool:
        return (calling approx_eq with self->x , other.x , eps) and (calling approx_eq with self->y , other.y , eps) and (calling approx_eq with self->z , other.z , eps)

    weave is_zero into bool:
        return (calling approx_eq with self->x , 0.0) and (calling approx_eq with self->y , 0.0) and (calling approx_eq with self->z , 0.0)

    weave to_vec2 into Vec2:
        return with x is self->x , y is self->y

    weave to_vec4 with w as float into Vec4:
        return with x is self->x , y is self->y , z is self->z , w is w

    weave to_string into string:
        return "({(self->x to string)}, {(self->y to string)}, {(self->z to string)})"

