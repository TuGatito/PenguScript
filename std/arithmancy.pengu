# std/arithmancy.pengu - Arithmancy (Mathematics)
# Provides comprehensive mathematical functions.
#
# Typical usage:
#   import std.arithmancy
#   var x as float is calling arithmancy.sqrt with 16.0
#   var g as int is calling arithmancy.gcd with 24, 36
#   var c as float is calling arithmancy.clamp with x, 0.0, 1.0
#
# Notes:
#   * Every function here takes and returns scalar floats/ints/bools by value,
#     so there are no ownership, aliasing or null concerns.
#   * The trig/exponential wrappers forward to the C math library: out-of-domain
#     inputs (e.g. sqrt of a negative number, log of a non-positive number)
#     follow C semantics and yield NaN / infinity instead of an error.

import std.spark

# ----------------------------------------------------------------------------
# C Math Runtime Declarations
# ----------------------------------------------------------------------------
#
# Each declare is the runtime binding for the libm function of the same name;
# all of them take and return IEEE double values by value.
# Runtime primitive: absolute value of `x` (C fabs).
declare pengu_c_fabs with x as float into float
# Runtime primitive: square root of `x` (C sqrt).
declare pengu_c_sqrt with x as float into float
# Runtime primitive: `x` raised to the power `y` (C pow).
declare pengu_c_pow with x as float , y as float into float
# Runtime primitive: largest integer not greater than `x`, as a float (C floor).
declare pengu_c_floor with x as float into float
# Runtime primitive: smallest integer not less than `x`, as a float (C ceil).
declare pengu_c_ceil with x as float into float
# Runtime primitive: `x` rounded to the nearest integer (C round).
declare pengu_c_round with x as float into float
# Runtime primitive: `x` truncated towards zero, as a float (C trunc).
declare pengu_c_trunc with x as float into float
# Runtime primitive: floating-point remainder of `x` / `y` (C fmod).
declare pengu_c_fmod with x as float , y as float into float
# Runtime primitive: sine of `x` radians (C sin).
declare pengu_c_sin with x as float into float
# Runtime primitive: cosine of `x` radians (C cos).
declare pengu_c_cos with x as float into float
# Runtime primitive: tangent of `x` radians (C tan).
declare pengu_c_tan with x as float into float
# Runtime primitive: arc sine of `x` (C asin).
declare pengu_c_asin with x as float into float
# Runtime primitive: arc cosine of `x` (C acos).
declare pengu_c_acos with x as float into float
# Runtime primitive: arc tangent of `x` (C atan).
declare pengu_c_atan with x as float into float
# Runtime primitive: arc tangent of `y` / `x` honouring both signs (C atan2).
declare pengu_c_atan2 with y as float , x as float into float
# Runtime primitive: e raised to the power `x` (C exp).
declare pengu_c_exp with x as float into float
# Runtime primitive: natural logarithm of `x` (C log).
declare pengu_c_log with x as float into float
# Runtime primitive: base-10 logarithm of `x` (C log10).
declare pengu_c_log10 with x as float into float
# Runtime primitive: base-2 logarithm of `x` (C log2).
declare pengu_c_log2 with x as float into float
# Runtime primitive: hyperbolic sine of `x` (C sinh).
declare pengu_c_sinh with x as float into float
# Runtime primitive: hyperbolic cosine of `x` (C cosh).
declare pengu_c_cosh with x as float into float
# Runtime primitive: hyperbolic tangent of `x` (C tanh).
declare pengu_c_tanh with x as float into float
# Runtime primitive: inverse hyperbolic sine of `x` (C asinh).
declare pengu_c_asinh with x as float into float
# Runtime primitive: inverse hyperbolic cosine of `x` (C acosh).
declare pengu_c_acosh with x as float into float
# Runtime primitive: inverse hyperbolic tangent of `x` (C atanh).
declare pengu_c_atanh with x as float into float

# ----------------------------------------------------------------------------
# Mathematical Constants
# ----------------------------------------------------------------------------
#
# Pi, the ratio of a circle's circumference to its diameter.
const PI as float is 3.141592653589793
# Tau, one full turn in radians (equal to 2 * PI).
const TAU as float is 6.283185307179586
# Euler's number, the base of the natural logarithm.
const E as float is 2.718281828459045

# ----------------------------------------------------------------------------
# C Math Wrappers (float in, float out)
# ----------------------------------------------------------------------------
#
# These weaves expose the C math library; unless noted they take radians for
# angles and return the mathematical result by value. Domain errors follow C.
# Absolute value of `x` (C fabs). Always returns a non-negative float.
weave abs with x as float into float:
    return calling pengu_c_fabs with x

# Absolute value of `x` as an int. Returns `x` unchanged when it is already
# non-negative.
weave abs_i with x as int into int:
    if x < 0:
        return -x
    return x

# Square root of `x` (C sqrt). Domain: x >= 0; a negative input yields NaN.
weave sqrt with x as float into float:
    return calling pengu_c_sqrt with x

# Raises `x` to the power `y` (C pow). Returns x^y as a float.
weave pow with x as float , y as float into float:
    return calling pengu_c_pow with x , y

# Largest integer not greater than `x`, returned as a float (C floor).
weave floor with x as float into float:
    return calling pengu_c_floor with x

# Smallest integer not less than `x`, returned as a float (C ceil).
weave ceil with x as float into float:
    return calling pengu_c_ceil with x

# Rounds `x` to the nearest integer, returned as a float (C round: halfway
# cases round away from zero).
weave round with x as float into float:
    return calling pengu_c_round with x

# Truncates `x` towards zero (drops the fractional part), returned as a float.
weave trunc with x as float into float:
    return calling pengu_c_trunc with x

# Floating-point remainder of `x` divided by `y` (C fmod). Domain: y != 0; the
# result carries the sign of `x`.
weave fmod with x as float , y as float into float:
    return calling pengu_c_fmod with x , y

# Sine of angle `x` given in radians (C sin).
weave sin with x as float into float:
    return calling pengu_c_sin with x

# Cosine of angle `x` given in radians (C cos).
weave cos with x as float into float:
    return calling pengu_c_cos with x

# Tangent of angle `x` given in radians (C tan).
weave tan with x as float into float:
    return calling pengu_c_tan with x

# Arc sine of `x` in radians (C asin). Domain: x in [-1, 1]; outside that range
# the result is NaN.
weave asin with x as float into float:
    return calling pengu_c_asin with x

# Arc cosine of `x` in radians (C acos). Domain: x in [-1, 1]; outside that
# range the result is NaN.
weave acos with x as float into float:
    return calling pengu_c_acos with x

# Arc tangent of `x` in radians (C atan).
weave atan with x as float into float:
    return calling pengu_c_atan with x

# Arc tangent of the ratio `y` / `x` in radians, using the signs of both
# arguments to select the correct quadrant (C atan2).
weave atan2 with y as float , x as float into float:
    return calling pengu_c_atan2 with y , x

# Exponential: e raised to the power `x` (C exp).
weave exp with x as float into float:
    return calling pengu_c_exp with x

# Natural logarithm of `x` (C log). Domain: x > 0.
weave log with x as float into float:
    return calling pengu_c_log with x

# Base-10 logarithm of `x` (C log10). Domain: x > 0.
weave log10 with x as float into float:
    return calling pengu_c_log10 with x

# Base-2 logarithm of `x` (C log2). Domain: x > 0.
weave log2 with x as float into float:
    return calling pengu_c_log2 with x

# ----------------------------------------------------------------------------
# Pure PenguScript helpers (integer & float algorithms)
# ----------------------------------------------------------------------------
#
# Primality test for a non-negative integer `n` (6k +/- 1 trial division).
# Returns true for primes; 0 and 1 are not prime, and n <= 0 is not prime.
weave is_prime with n as int into bool:
    if n <= 1:
        return false
    if n <= 3:
        return true
    if n % 2 == 0:
        return false
    if n % 3 == 0:
        return false
    var i as int is 5
    while i <= n / i:
        if n % i == 0:
            return false
        if n % (i + 2) == 0:
            return false
        set i is i + 6
    return true

# Greatest common divisor of `a` and `b` (Euclid's algorithm over absolute
# values). gcd(0, b) is |b| and gcd(0, 0) is 0. Always non-negative.
weave gcd with a as int , b as int into int:
    var x as int is calling abs_i with a
    var y as int is calling abs_i with b
    while y != 0:
        var t as int is y
        set y is x % y
        set x is t
    return x

# Least common multiple of `a` and `b`. Returns 0 when either argument is 0;
# otherwise |a * b / gcd(a, b)| (watch for int overflow on large inputs).
weave lcm with a as int , b as int into int:
    if a == 0:
        return 0
    if b == 0:
        return 0
    var g as int is calling gcd with a , b
    return calling abs_i with (a / g) * b

# Smaller of `a` and `b` (float comparison).
weave min with a as float , b as float into float:
    if a < b:
        return a
    return b

# Larger of `a` and `b` (float comparison).
weave max with a as float , b as float into float:
    if a > b:
        return a
    return b

# Clamps `val` into the inclusive range [min_val, max_val]: values below
# `min_val` become `min_val` and values above `max_val` become `max_val`.
weave clamp with val as float , min_val as float , max_val as float into float:
    if val < min_val:
        return min_val
    if val > max_val:
        return max_val
    return val

# Linear interpolation between `a` and `b`: a + (b - a) * t. `t` of 0.0 yields
# `a`, `t` of 1.0 yields `b`; values outside [0, 1] extrapolate.
weave lerp with a as float , b as float , t as float into float:
    return a + (b - a) * t

# Converts an angle from degrees to radians (deg * PI / 180).
weave deg_to_rad with deg as float into float:
    return deg * (PI / 180.0)

# Converts an angle from radians to degrees (rad * 180 / PI).
weave rad_to_deg with rad as float into float:
    return rad * (180.0 / PI)