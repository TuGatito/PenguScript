## Returns a 4x4 orthographic projection matrix.
weave mat4_ortho with left as float , right as float , bottom as float , top as float , near_v as float , far_v as float into Mat4:
    var rl as float is 1.0 / (right - left)
    var tb as float is 1.0 / (top - bottom)
    var fn as float is 1.0 / (far_v - near_v)
    return with m00 is 2.0 * rl , m01 is 0.0 , m02 is 0.0 , m03 is -(right + left) * rl , m10 is 0.0 , m11 is 2.0 * tb , m12 is 0.0 , m13 is -(top + bottom) * tb , m20 is 0.0 , m21 is 0.0 , m22 is -2.0 * fn , m23 is -(far_v + near_v) * fn , m30 is 0.0 , m31 is 0.0 , m32 is 0.0 , m33 is 1.0

## Returns a 4x4 view matrix looking from `eye` to `center` with `up` vector.
weave mat4_look_at with eye as Vec3 , center as Vec3 , up as Vec3 into Mat4:
