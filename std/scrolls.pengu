# std/scrolls.pengu - The Scrolls (Strings)
# String utilities implemented in pure PenguScript.
#
# High-level string logic (search, slicing, trimming, splitting, repetition,
# reversal, replacement, ASCII case mapping and classification) lives in
# PenguScript and compiles to optimized C. Only low-level compiler primitives
# (substring/char_at views, concatenation, equality) come from the runtime.
#
# Module-level C names are prefixed with 'pengu_' through 'insignia'; methods
# enchanting primitive types (string) intentionally keep their plain C names so
# they never collide with the pengu_string_* runtime primitives.
#
# Naming notes:
# - Methods are exposed through 'enchanting string' (e.g. 'calling s.trim').
# - 'starts_with' and 'substring' are also module-level members used by other
#   std modules (e.g. 'calling scrolls.starts_with'), so both names exist.
# - Internal helpers use the 'sc_' prefix so they never collide with the
#   enchanting methods' names in the code generator's function registry.
#
# Usage: import std.scrolls. String utilities are exposed as methods
# enchanting the primitive string type, e.g. "calling s.trim",
# "calling s.split with delim". starts_with and substring are additionally
# module members so other std modules can call them functionally, e.g.
# "calling scrolls.starts_with with text, prefix".
# Ownership: strings are values; every operation returns a new owned string or
# list and never mutates its input, so results may be banished or dropped
# normally.

# Applies the "pengu_" prefix to the module-level C symbol names so they never
# collide with the enchanting method names (see the header notes).
insignia pengu_

import std.spark  # kept for parity with prior module layout

# ----------------------------------------------------------------------------
# Internal helpers (sc_*) - distinct names avoid clashing with methods.
# ----------------------------------------------------------------------------

# True when c is an ASCII whitespace character (space, tab, line feed,
# carriage return, vertical tab or form feed).
weave sc_is_space with c as string into bool:
  if c == " ":
    return true
  if c == "\t":
    return true
  if c == "\n":
    return true
  if c == "\r":
    return true
  if c == "\v":
    return true
  if c == "\f":
    return true
  return false

# True when s begins with prefix (plain prefix compare).
weave sc_starts_with with s as string , prefix as string into bool:
  var sl as int is s length
  var pl as int is prefix length
  if pl > sl:
    return false
  if (s at 0 to pl) == prefix:
    return true
  return false

# True when s ends with suffix.
weave sc_ends_with with s as string , suffix as string into bool:
  var sl as int is s length
  var xl as int is suffix length
  if xl > sl:
    return false
  var start as int is sl - xl
  if (s at start to sl) == suffix:
    return true
  return false

# Index of the first occurrence of sub in s; 0 for an empty sub and -1 when
# absent.
weave sc_index_of with s as string , sub as string into int:
  var sl as int is s length
  var sub_len as int is sub length
  if sub_len == 0:
    return 0
  if sub_len > sl:
    return -1
  var i as int is 0
  while i <= sl - sub_len:
    if (s at i to (i + sub_len)) == sub:
      return i
    set i is i + 1
  return -1

# Index of the last occurrence of sub in s; the length of s for an empty sub
# and -1 when absent.
weave sc_last_index_of with s as string , sub as string into int:
  var sl as int is s length
  var sub_len as int is sub length
  if sub_len == 0:
    return sl
  if sub_len > sl:
    return -1
  var i as int is sl - sub_len
  while i >= 0:
    if (s at i to (i + sub_len)) == sub:
      return i
    set i is i - 1
  return -1

# Substring of s from start_pos (inclusive) to end_pos (exclusive).
weave sc_substring with s as string , start_pos as int , end_pos as int into string:
  return s at start_pos to end_pos

# ----------------------------------------------------------------------------
# Module-level members used by other std modules.
# ----------------------------------------------------------------------------

# Functional (module-level) form of starts_with for other std modules, e.g.
# "calling scrolls.starts_with with text, prefix".
weave starts_with with s as string , prefix as string into bool:
  return calling sc_starts_with with s , prefix

# Functional (module-level) form of substring for other std modules, e.g.
# "calling scrolls.substring with text, 0, 5".
weave substring with s as string , start_pos as int , end_pos as int into string:
  return calling sc_substring with s , start_pos , end_pos

# ----------------------------------------------------------------------------
# String methods (enchanting)
# ----------------------------------------------------------------------------

# Enchants the primitive string type with the utility methods below, so they
# can be invoked on any string value, e.g. "calling s.trim".
enchanting string:
  # Length of the string.
  weave len into int:
    var sv as string is essence of self
    return sv length

  # True when the string is empty (length 0).
  weave is_empty into bool:
    var sv as string is essence of self
    if sv length == 0:
      return true
    return false

  # True when the string contains sub somewhere.
  weave contains with sub as string into bool:
    var sv as string is essence of self
    var found as int is calling sc_index_of with sv , sub
    if found >= 0:
      return true
    return false

  # True when the string begins with prefix.
  weave starts_with with prefix as string into bool:
    var sv as string is essence of self
    return calling sc_starts_with with sv , prefix

  # True when the string ends with suffix.
  weave ends_with with suffix as string into bool:
    var sv as string is essence of self
    return calling sc_ends_with with sv , suffix

  # Index of the first occurrence of sub; 0 for an empty sub and -1 when absent.
  weave index_of with sub as string into int:
    var sv as string is essence of self
    return calling sc_index_of with sv , sub

  # Index of the last occurrence of sub; the string length for an empty sub and
  # -1 when absent.
  weave last_index_of with sub as string into int:
    var sv as string is essence of self
    return calling sc_last_index_of with sv , sub

  # Substring from start_pos (inclusive) to end_pos (exclusive).
  weave substring with start_pos as int , end_pos as int into string:
    var sv as string is essence of self
    return calling sc_substring with sv , start_pos , end_pos

  # The single character at idx as a one-character string.
  weave char_at with idx as int into string:
    var sv as string is essence of self
    return calling sc_substring with sv , idx , (idx + 1)

  # Copy of the string with ASCII letters A-Z mapped to lowercase; other
  # characters are unchanged.
  weave lower into string:
    var sv as string is essence of self
    var sl as int is sv length
    var res as string is ""
    var i as int is 0
    while i < sl:
      var code as int is ord (sv at i)
      if code >= 65:
        if code <= 90:
          set res is "{res}{(chr (code + 32))}"
        else:
          set res is "{res}{(sv at i)}"
      else:
        set res is "{res}{(sv at i)}"
      set i is i + 1
    return res

  # Copy of the string with ASCII letters a-z mapped to uppercase; other
  # characters are unchanged.
  weave upper into string:
    var sv as string is essence of self
    var sl as int is sv length
    var res as string is ""
    var i as int is 0
    while i < sl:
      var code as int is ord (sv at i)
      if code >= 97:
        if code <= 122:
          set res is "{res}{(chr (code - 32))}"
        else:
          set res is "{res}{(sv at i)}"
      else:
        set res is "{res}{(sv at i)}"
      set i is i + 1
    return res

  ## Copy of the string with ASCII letters A-Z mapped to lowercase (alias of lower).
  ##
  ## Signature: to_lower() into string
  ## Ownership: Returns a freshly allocated owned string.
  weave to_lower into string:
    return calling self.lower

  ## Copy of the string with ASCII letters a-z mapped to uppercase (alias of upper).
  ##
  ## Signature: to_upper() into string
  ## Ownership: Returns a freshly allocated owned string.
  weave to_upper into string:
    return calling self.upper

  # Copy of the string without leading and trailing ASCII whitespace.
  weave trim into string:
    var sv as string is essence of self
    var sl as int is sv length
    var start as int is 0
    while start < sl:
      if calling sc_is_space with (sv at start):
        set start is start + 1
      else:
        break
    var end as int is sl - 1
    while end >= start:
      if calling sc_is_space with (sv at end):
        set end is end - 1
      else:
        break
    return calling sc_substring with sv , start , (end + 1)

  # Copy of the string without leading ASCII whitespace.
  weave trim_start into string:
    var sv as string is essence of self
    var sl as int is sv length
    var start as int is 0
    while start < sl:
      if calling sc_is_space with (sv at start):
        set start is start + 1
      else:
        break
    return calling sc_substring with sv , start , sl

  # Copy of the string without trailing ASCII whitespace.
  weave trim_end into string:
    var sv as string is essence of self
    var sl as int is sv length
    var end as int is sl - 1
    while end >= 0:
      if calling sc_is_space with (sv at end):
        set end is end - 1
      else:
        break
    return calling sc_substring with sv , 0 , (end + 1)

  # Copy of the string with the first occurrence of from_str replaced by
  # to_str; unchanged when from_str does not occur.
  weave replace with from_str as string , to_str as string into string:
    var sv as string is essence of self
    var hit as int is calling sc_index_of with sv , from_str
    if hit < 0:
      return sv
    var fl as int is from_str length
    var prefix_str as string is calling sc_substring with sv , 0 , hit
    var suffix_str as string is calling sc_substring with sv , (hit + fl) , sv length
    return "{prefix_str}{to_str}{suffix_str}"

  # Copy of the string with every non-overlapping occurrence of from_str
  # replaced by to_str; an empty from_str returns the string unchanged.
  weave replace_all with from_str as string , to_str as string into string:
    var sv as string is essence of self
    var fl as int is from_str length
    if fl == 0:
      return sv
    var out as string is ""
    var rest as string is sv
    var hit as int is calling sc_index_of with rest , from_str
    while hit >= 0:
      set out is "{out}{(calling sc_substring with rest , 0 , hit)}{to_str}"
      set rest is calling sc_substring with rest , (hit + fl) , rest length
      set hit is calling sc_index_of with rest , from_str
    return "{out}{rest}"

  # Splits the string at every occurrence of delim; an empty delim yields a
  # list holding the whole string.
  weave split with delim as string into list of string:
    var sv as string is essence of self
    var parts as list of string is list of string
    var dl as int is delim length
    var sl as int is sv length
    if dl == 0:
      calling parts.push with sv
      return parts
    var seg_start as int is 0
    var pos as int is 0
    while pos <= sl - dl:
      if (sv at pos to (pos + dl)) == delim:
        calling parts.push with (sv at seg_start to pos)
        set seg_start is pos + dl
        set pos is pos + dl
      else:
        set pos is pos + 1
    calling parts.push with (sv at seg_start to sl)
    return parts

  # The string repeated count times; "" for count <= 0 or an empty string.
  weave repeat with count as int into string:
    var sv as string is essence of self
    if count <= 0:
      return ""
    if sv length == 0:
      return ""
    var res as string is ""
    var i as int is 0
    while i < count:
      set res is "{res}{sv}"
      set i is i + 1
    return res

  # Copy of the string with its characters in reverse order.
  weave reverse into string:
    var sv as string is essence of self
    var sl as int is sv length
    var res as string is ""
    var i as int is sl - 1
    while i >= 0:
      set res is "{res}{(sv at i)}"
      set i is i - 1
    return res

  # True when every character is an ASCII letter (A-Z or a-z); false for the
  # empty string.
  weave is_alpha into bool:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return false
    var i as int is 0
    while i < sl:
      var code as int is ord (sv at i)
      if code >= 65:
        if code <= 90:
          set i is i + 1
          continue
      if code >= 97:
        if code <= 122:
          set i is i + 1
          continue
      return false
    return true

  # True when every character is an ASCII digit (0-9); false for the empty
  # string.
  weave is_digit into bool:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return false
    var i as int is 0
    while i < sl:
      var code as int is ord (sv at i)
      if code >= 48:
        if code <= 57:
          set i is i + 1
          continue
      return false
    return true

  # True when every character is ASCII alphanumeric (letter or digit); false for
  # the empty string.
  weave is_alnum into bool:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return false
    var i as int is 0
    while i < sl:
      var code as int is ord (sv at i)
      if code >= 65:
        if code <= 90:
          set i is i + 1
          continue
      if code >= 97:
        if code <= 122:
          set i is i + 1
          continue
      if code >= 48:
        if code <= 57:
          set i is i + 1
          continue
      return false
    return true

  # --------------------------------------------------------------------------
  # Case Mapping & Transformations
  # --------------------------------------------------------------------------

  ## Converts the first character to uppercase and the remaining characters to lowercase.
  ##
  ## Signature: capitalize() into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: Returns an empty string if the input string is empty.
  weave capitalize into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return ""
    var res as string is ""
    var first_code as int is ord (sv at 0)
    if first_code >= 97 and first_code <= 122:
      set res is "{res}{(chr (first_code - 32))}"
    else:
      set res is "{res}{(sv at 0)}"
    var i as int is 1
    while i < sl:
      var code as int is ord (sv at i)
      if code >= 65 and code <= 90:
        set res is "{res}{(chr (code + 32))}"
      else:
        set res is "{res}{(sv at i)}"
      set i is i + 1
    return res

  ## Converts the first character of each whitespace-separated word to uppercase and the rest to lowercase.
  ##
  ## Signature: title() into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: Preserves all whitespace characters; returns empty string if empty.
  weave title into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return ""
    var res as string is ""
    var new_word as bool is true
    var i as int is 0
    while i < sl:
      var c as string is sv at i
      var code as int is ord c
      if c == " " or c == "\t" or c == "\n" or c == "\r":
        set res is "{res}{c}"
        set new_word is true
      else:
        if new_word:
          if code >= 97 and code <= 122:
            set res is "{res}{(chr (code - 32))}"
          else:
            set res is "{res}{c}"
          set new_word is false
        else:
          if code >= 65 and code <= 90:
            set res is "{res}{(chr (code + 32))}"
          else:
            set res is "{res}{c}"
      set i is i + 1
    return res

  ## Converts the first character of each whitespace-separated word to uppercase and the rest to lowercase (alias of title).
  ##
  ## Signature: title_case() into string
  ## Ownership: Returns a freshly allocated owned string.
  weave title_case into string:
    return calling self.title

  ## Returns a copy of the string with uppercase characters converted to lowercase and vice versa.
  ##
  ## Signature: swap_case() into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: Non-alphabetic ASCII characters are left unchanged.
  weave swap_case into string:
    var sv as string is essence of self
    var sl as int is sv length
    var res as string is ""
    var i as int is 0
    while i < sl:
      var code as int is ord (sv at i)
      if code >= 65 and code <= 90:
        set res is "{res}{(chr (code + 32))}"
      else:
        if code >= 97 and code <= 122:
          set res is "{res}{(chr (code - 32))}"
        else:
          set res is "{res}{(sv at i)}"
      set i is i + 1
    return res

  ## Converts camelCase, PascalCase, or space/hyphen-separated strings to snake_case.
  ##
  ## Signature: to_snake_case() into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: Collapses adjacent separators; returns empty string for empty input.
  weave to_snake_case into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return ""
    var res as string is ""
    var i as int is 0
    while i < sl:
      var c as string is sv at i
      var code as int is ord c
      if c == " " or c == "-" or c == "_":
        var rl as int is res length
        if rl > 0:
          if (res at (rl - 1)) != "_":
            set res is "{res}_"
      else:
        if code >= 65 and code <= 90:
          var rl as int is res length
          if rl > 0:
            var prev_code as int is ord (sv at (i - 1))
            var is_prev_lower_or_digit as bool is (prev_code >= 97 and prev_code <= 122) or (prev_code >= 48 and prev_code <= 57)
            var is_next_lower as bool is false
            if (i + 1) < sl:
              var next_code as int is ord (sv at (i + 1))
              if next_code >= 97 and next_code <= 122:
                set is_next_lower is true
            if (is_prev_lower_or_digit or (is_next_lower and (prev_code >= 65 and prev_code <= 90))) and ((res at (rl - 1)) != "_"):
              set res is "{res}_"
          set res is "{res}{(chr (code + 32))}"
        else:
          set res is "{res}{c}"
      set i is i + 1
    return res

  ## Converts camelCase, PascalCase, or space/underscore-separated strings to kebab-case.
  ##
  ## Signature: to_kebab_case() into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: Collapses adjacent separators; returns empty string for empty input.
  weave to_kebab_case into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return ""
    var res as string is ""
    var i as int is 0
    while i < sl:
      var c as string is sv at i
      var code as int is ord c
      if c == " " or c == "-" or c == "_":
        var rl as int is res length
        if rl > 0:
          if (res at (rl - 1)) != "-":
            set res is "{res}-"
      else:
        if code >= 65 and code <= 90:
          var rl as int is res length
          if rl > 0:
            var prev_code as int is ord (sv at (i - 1))
            var is_prev_lower_or_digit as bool is (prev_code >= 97 and prev_code <= 122) or (prev_code >= 48 and prev_code <= 57)
            var is_next_lower as bool is false
            if (i + 1) < sl:
              var next_code as int is ord (sv at (i + 1))
              if next_code >= 97 and next_code <= 122:
                set is_next_lower is true
            if (is_prev_lower_or_digit or (is_next_lower and (prev_code >= 65 and prev_code <= 90))) and ((res at (rl - 1)) != "-"):
              set res is "{res}-"
          set res is "{res}{(chr (code + 32))}"
        else:
          set res is "{res}{c}"
      set i is i + 1
    return res

  # --------------------------------------------------------------------------
  # Search & Occurrence Counting
  # --------------------------------------------------------------------------

  ## Returns the index of the first occurrence of `sub`, or -1 if not found (alias of index_of).
  ##
  ## Signature: find(sub as string) into int
  ## Ownership: Operates on borrowed strings; returns a scalar integer offset.
  ## Edge cases: Returns 0 when sub is empty; returns -1 when sub is absent.
  weave find with sub as string into int:
    var sv as string is essence of self
    return calling sc_index_of with sv , sub

  ## Returns the index of the last occurrence of `sub`, or -1 if not found (alias of last_index_of).
  ##
  ## Signature: rfind(sub as string) into int
  ## Ownership: Operates on borrowed strings; returns a scalar integer offset.
  ## Edge cases: Returns string length when sub is empty; returns -1 when sub is absent.
  weave rfind with sub as string into int:
    var sv as string is essence of self
    return calling sc_last_index_of with sv , sub

  ## Returns the number of non-overlapping occurrences of `sub` in the string.
  ##
  ## Signature: count(sub as string) into int
  ## Ownership: Operates on borrowed strings; returns a scalar integer count.
  ## Edge cases: Returns 0 if `sub` is empty or longer than the string.
  weave count with sub as string into int:
    var sv as string is essence of self
    var sl as int is sv length
    var sub_l as int is sub length
    if sub_l == 0 or sub_l > sl:
      return 0
    var cnt as int is 0
    var i as int is 0
    while i <= sl - sub_l:
      if (sv at i to (i + sub_l)) == sub:
        set cnt is cnt + 1
        set i is i + sub_l
      else:
        set i is i + 1
    return cnt

  ## Counts the number of non-overlapping occurrences of `sub` in this string (alias of count).
  ##
  ## Signature: count_matches(sub as string) into int
  ## Ownership: Operates on borrowed strings; returns a scalar integer count.
  weave count_matches with sub as string into int:
    return calling self.count with sub

  # --------------------------------------------------------------------------
  # Whitespace Manipulation
  # --------------------------------------------------------------------------

  ## Returns a copy of the string with leading whitespace removed (alias of trim_start).
  ##
  ## Signature: lstrip() into string
  ## Ownership: Returns a freshly allocated owned string.
  weave lstrip into string:
    var sv as string is essence of self
    var sl as int is sv length
    var start as int is 0
    while start < sl:
      if calling sc_is_space with (sv at start):
        set start is start + 1
      else:
        break
    return calling sc_substring with sv , start , sl

  ## Returns a copy of the string with trailing whitespace removed (alias of trim_end).
  ##
  ## Signature: rstrip() into string
  ## Ownership: Returns a freshly allocated owned string.
  weave rstrip into string:
    var sv as string is essence of self
    var sl as int is sv length
    var end as int is sl - 1
    while end >= 0:
      if calling sc_is_space with (sv at end):
        set end is end - 1
      else:
        break
    return calling sc_substring with sv , 0 , (end + 1)

  ## Returns true if the string is non-empty and contains only whitespace characters.
  ##
  ## Signature: is_space() into bool
  ## Ownership: Operates on borrowed string; returns a scalar boolean.
  ## Edge cases: Returns false for an empty string.
  weave is_space into bool:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return false
    var i as int is 0
    while i < sl:
      if not (calling sc_is_space with (sv at i)):
        return false
      set i is i + 1
    return true

  ## Returns true if the string is non-empty and contains only whitespace characters (alias of is_space).
  ##
  ## Signature: is_whitespace() into bool
  ## Ownership: Operates on borrowed string; returns a scalar boolean.
  weave is_whitespace into bool:
    return calling self.is_space

  ## Splits the string by runs of consecutive ASCII whitespace characters.
  ##
  ## Signature: split_whitespace() into list of string
  ## Ownership: Returns a newly allocated scope-owned list of owned strings.
  ## Edge cases: Leading/trailing whitespace is ignored; returns an empty list if string is empty or all spaces.
  weave split_whitespace into list of string:
    var sv as string is essence of self
    var parts as list of string is list of string
    var sl as int is sv length
    var i as int is 0
    while i < sl:
      while i < sl:
        if calling sc_is_space with (sv at i):
          set i is i + 1
        else:
          break
      if i >= sl:
        break
      var word_start as int is i
      while i < sl:
        if not (calling sc_is_space with (sv at i)):
          set i is i + 1
        else:
          break
      calling parts.push with (sv at word_start to i)
    return parts

  # --------------------------------------------------------------------------
  # Alignment & Padding
  # --------------------------------------------------------------------------

  ## Left-aligns the string within a field of specified width, padding with `pad_char` on the right.
  ##
  ## Signature: ljust(width as int, pad_char as string is " ") into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: If width <= length or pad_char is empty, returns the original string unchanged.
  weave ljust with width as int , pad_char as string is " " into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl >= width or (pad_char length) == 0:
      return sv
    var res as string is sv
    while (res length) < width:
      set res is "{res}{pad_char}"
    if (res length) > width:
      return res at 0 to width
    return res

  ## Right-aligns the string within a field of specified width, padding with `pad_char` on the left.
  ##
  ## Signature: rjust(width as int, pad_char as string is " ") into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: If width <= length or pad_char is empty, returns the original string unchanged.
  weave rjust with width as int , pad_char as string is " " into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl >= width or (pad_char length) == 0:
      return sv
    var pad as string is ""
    while ((pad length) + sl) < width:
      set pad is "{pad}{pad_char}"
    var total as string is "{pad}{sv}"
    if (total length) > width:
      return total at ((total length) - width) to (total length)
    return total

  ## Right-aligns the string, padding on the left with `pad_char` (alias of rjust).
  ##
  ## Signature: pad_left(width as int, pad_char as string is " ") into string
  ## Ownership: Returns a freshly allocated owned string.
  weave pad_left with width as int , pad_char as string is " " into string:
    return calling self.rjust with width, pad_char

  ## Left-aligns the string, padding on the right with `pad_char` (alias of ljust).
  ##
  ## Signature: pad_right(width as int, pad_char as string is " ") into string
  ## Ownership: Returns a freshly allocated owned string.
  weave pad_right with width as int , pad_char as string is " " into string:
    return calling self.ljust with width, pad_char

  ## Pads a numeric string with zeros on the left until it reaches `width`, preserving leading sign.
  ##
  ## Signature: zfill(width as int) into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: If string starts with '+' or '-', the sign stays at the front and zeros follow it.
  weave zfill with width as int into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl >= width:
      return sv
    var sign as string is ""
    var rest as string is sv
    if sl > 0:
      var first as string is sv at 0
      if first == "-" or first == "+":
        set sign is first
        set rest is sv at 1 to sl
    var pad_len as int is width - (rest length) - (sign length)
    var pad as string is ""
    var i as int is 0
    while i < pad_len:
      set pad is "{pad}0"
      set i is i + 1
    return "{sign}{pad}{rest}"

  ## Centers the string in a field of `width` padded with `pad_char` (default space).
  ##
  ## Signature: center(width as int, pad_char as string is " ") into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: If padding is odd, left padding gets the smaller half (Python parity).
  weave center with width as int , pad_char as string is " " into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl >= width or (pad_char length) == 0:
      return sv
    var total_pad as int is width - sl
    var left_pad as int is total_pad / 2
    var right_pad as int is total_pad - left_pad
    var pad_l as string is ""
    var i as int is 0
    while i < left_pad:
      set pad_l is "{pad_l}{pad_char}"
      set i is i + 1
    var pad_r as string is ""
    var j as int is 0
    while j < right_pad:
      set pad_r is "{pad_r}{pad_char}"
      set j is j + 1
    return "{pad_l}{sv}{pad_r}"

  # --------------------------------------------------------------------------
  # Prefix, Suffix & Partition
  # --------------------------------------------------------------------------

  ## Removes `prefix` from the start of the string if present, returning the remainder.
  ##
  ## Signature: removeprefix(prefix as string) into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: Returns unchanged string if prefix is not matched.
  weave removeprefix with prefix as string into string:
    var sv as string is essence of self
    if calling sc_starts_with with sv , prefix:
      return sv at (prefix length) to (sv length)
    return sv

  ## Removes `suffix` from the end of the string if present, returning the remainder.
  ##
  ## Signature: removesuffix(suffix as string) into string
  ## Ownership: Returns a freshly allocated owned string.
  ## Edge cases: Returns unchanged string if suffix is not matched.
  weave removesuffix with suffix as string into string:
    var sv as string is essence of self
    if calling sc_ends_with with sv , suffix:
      return sv at 0 to ((sv length) - (suffix length))
    return sv

  ## Splits the string at the first occurrence of `sep`, returning a list of 3 strings: [before, sep, after].
  ##
  ## Signature: partition(sep as string) into list of string
  ## Ownership: Returns a newly allocated scope-owned list of 3 owned strings.
  ## Edge cases: If `sep` is not found or empty, returns [sv, "", ""].
  weave partition with sep as string into list of string:
    var sv as string is essence of self
    var parts as list of string is list of string with capacity 3
    var idx as int is calling sc_index_of with sv , sep
    if idx < 0 or (sep length) == 0:
      calling parts.push with sv
      calling parts.push with ""
      calling parts.push with ""
      return parts
    calling parts.push with (sv at 0 to idx)
    calling parts.push with sep
    calling parts.push with (sv at (idx + (sep length)) to (sv length))
    return parts

  # --------------------------------------------------------------------------
  # Classification Predicates
  # --------------------------------------------------------------------------

  ## Returns true if all cased characters are lowercase and there is at least one cased character.
  ##
  ## Signature: is_lower() into bool
  ## Ownership: Operates on borrowed string; returns a scalar boolean.
  ## Edge cases: Returns false for empty string or strings without cased characters.
  weave is_lower into bool:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return false
    var has_cased as bool is false
    var i as int is 0
    while i < sl:
      var code as int is ord (sv at i)
      if code >= 65 and code <= 90:
        return false
      if code >= 97 and code <= 122:
        set has_cased is true
      set i is i + 1
    return has_cased

  ## Returns true if all cased characters are uppercase and there is at least one cased character.
  ##
  ## Signature: is_upper() into bool
  ## Ownership: Operates on borrowed string; returns a scalar boolean.
  ## Edge cases: Returns false for empty string or strings without cased characters.
  weave is_upper into bool:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return false
    var has_cased as bool is false
    var i as int is 0
    while i < sl:
      var code as int is ord (sv at i)
      if code >= 97 and code <= 122:
        return false
      if code >= 65 and code <= 90:
        set has_cased is true
      set i is i + 1
    return has_cased

  ## Returns true if the string reads the same forwards and backwards.
  ##
  ## Signature: is_palindrome() into bool
  ## Ownership: Operates on borrowed string; returns a scalar boolean.
  ## Edge cases: Returns true for strings of length <= 1.
  weave is_palindrome into bool:
    var sv as string is essence of self
    var sl as int is sv length
    if sl <= 1:
      return true
    var i as int is 0
    var half as int is sl / 2
    while i < half:
      if (ord (sv at i)) != (ord (sv at (sl - 1 - i))):
        return false
      set i is i + 1
    return true

  # --------------------------------------------------------------------------
  # Ordering & Comparison
  # --------------------------------------------------------------------------

  ## Performs lexicographical byte-by-byte comparison between this string and `other`.
  ## Returns -1 if self < other, 0 if self == other, and 1 if self > other.
  ##
  ## Signature: compare(other as string) into int
  ## Ownership: Operates on borrowed strings; returns a scalar integer (-1, 0, 1).
  ## NOTE: PenguScript disallows '<', '<=', '>', '>=' operators on strings (E0005).
  ## This method is the canonical way to sort or order strings.
  weave compare with other as string into int:
    var sv as string is essence of self
    var l1 as int is sv length
    var l2 as int is other length
    var min_l as int is l1
    if l2 < min_l:
      set min_l is l2
    var i as int is 0
    while i < min_l:
      var c1 as int is ord (sv at i)
      var c2 as int is ord (other at i)
      if c1 < c2:
        return -1
      if c1 > c2:
        return 1
      set i is i + 1
    if l1 < l2:
      return -1
    if l1 > l2:
      return 1
    return 0

  # --------------------------------------------------------------------------
  # Iteration & Splitting Helpers
  # --------------------------------------------------------------------------

  ## Returns a list containing every character of the string as a single-character string.
  ##
  ## Signature: chars() into list of string
  ## Ownership: Returns a newly allocated scope-owned list of owned strings.
  ## Edge cases: Returns an empty list if the string is empty.
  weave chars into list of string:
    var sv as string is essence of self
    var sl as int is sv length
    var parts as list of string is list of string with capacity sl
    var i as int is 0
    while i < sl:
      calling parts.push with (sv at i to (i + 1))
      set i is i + 1
    return parts

  ## Returns a list containing the numeric ASCII byte codes of the characters in the string.
  ##
  ## Signature: bytes() into list of int
  ## Ownership: Returns a newly allocated scope-owned list of scalar integers.
  ## Edge cases: Returns an empty list if the string is empty.
  weave bytes into list of int:
    var sv as string is essence of self
    var sl as int is sv length
    var codes as list of int is list of int with capacity sl
    var i as int is 0
    while i < sl:
      calling codes.push with (ord (sv at i))
      set i is i + 1
    return codes

  ## Splits the string by newline ('\n') boundaries without stripping carriage returns ('\r').
  ##
  ## Signature: split_lines() into list of string
  ## Ownership: Returns a newly allocated scope-owned list of owned strings.
  ## Edge cases: Returns an empty list for empty string; preserves '\r'.
  weave split_lines into list of string:
    var sv as string is essence of self
    var parts as list of string is list of string
    var sl as int is sv length
    if sl == 0:
      return parts
    var start as int is 0
    var i as int is 0
    while i < sl:
      if (ord (sv at i)) == 10:
        calling parts.push with (sv at start to i)
        set start is i + 1
      set i is i + 1
    calling parts.push with (sv at start to sl)
    return parts

  ## Returns the number of lines separated by newline ('\n') characters.
  ##
  ## Signature: line_count() into int
  ## Ownership: Operates on borrowed string; returns a scalar integer.
  ## Edge cases: Returns 0 for empty string, 1 for string without newlines.
  weave line_count into int:
    var sv as string is essence of self
    var sl as int is sv length
    if sl == 0:
      return 0
    var count as int is 1
    var i as int is 0
    while i < sl:
      if (ord (sv at i)) == 10:
        set count is count + 1
      set i is i + 1
    return count

  ## Returns the number of whitespace-delimited words in the string.
  ##
  ## Signature: word_count() into int
  ## Ownership: Operates on borrowed string; returns a scalar integer.
  ## Edge cases: Returns 0 for empty string or strings containing only whitespace.
  weave word_count into int:
    var sv as string is essence of self
    var sl as int is sv length
    var count as int is 0
    var in_word as bool is false
    var i as int is 0
    while i < sl:
      if calling sc_is_space with (sv at i):
        set in_word is false
      else:
        if not in_word:
          set count is count + 1
          set in_word is true
      set i is i + 1
    return count

  # --------------------------------------------------------------------------
  # Truncation
  # --------------------------------------------------------------------------

  ## Truncates the string to at most `max_len` characters, appending `suffix` if truncated.
  ##
  ## Signature: truncate(max_len as int, suffix as string) into string
  ## Ownership: Returns a freshly allocated owned string or original value.
  ## Edge cases: If length <= max_len, returns unchanged; if max_len <= suffix length, cuts without suffix.
  weave truncate with max_len as int , suffix as string into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl <= max_len:
      return sv
    var sufl as int is suffix length
    if max_len <= sufl:
      if max_len <= 0:
        return ""
      return sv at 0 to max_len
    return "{(sv at 0 to (max_len - sufl))}{suffix}"

  ## Truncates the string to at most `max_len` characters, appending "..." if truncated.
  ##
  ## Signature: ellipsis(max_len as int) into string
  ## Ownership: Returns a freshly allocated owned string or original value.
  ## Edge cases: If max_len <= 3, truncates without "..."; if length <= max_len, returns unchanged.
  weave ellipsis with max_len as int into string:
    var sv as string is essence of self
    var sl as int is sv length
    if sl <= max_len:
      return sv
    if max_len <= 3:
      if max_len <= 0:
        return ""
      return sv at 0 to max_len
    return "{(sv at 0 to (max_len - 3))}..."

# ----------------------------------------------------------------------------
# Module-level Sequence Operations
# ----------------------------------------------------------------------------

## Concatenates the elements of `parts` into a single string using `sep` as a separator.
##
## Signature: join(parts as list of string, sep as string) into string
## Ownership: Returns a freshly allocated owned string.
## Edge cases: Returns an empty string for an empty list.
weave join with parts as list of string , sep as string into string:
  var res as string is ""
  for i, p in parts:
    if i > 0:
      set res is "{res}{sep}"
    set res is "{res}{p}"
  return res
