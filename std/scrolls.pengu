test "capitalize of the empty string is empty":
    var empty_s as string is ""
    var _ls_4420 as string is calling empty_s.get_capitalize
    defer banish _ls_4420
    calling _expect_eq_string with _ls_4420, "", "empty capitalize"
test "title capitalizes the initial of every word":
    var s as string is "hello world"
    var _lt_4391 as string is calling s.get_title
    defer banish _lt_4391
