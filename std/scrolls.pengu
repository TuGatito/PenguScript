    # --- Replacing and splitting ----------------------------------------
    ## Copy with the first occurrence of `from_str` replaced by `to_str`.
    ##
    ## ## Parámetros
    ## - `from_str`: the text to replace; may be empty.
    ## - `to_str`: the replacement text.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`. An empty `from_str` inserts
    ## `to_str` at the start (legacy behaviour).
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "cat, cat".replace with "cat", "dog"    # "dog, cat"
    ## ```
    weave replace with from_str as string, to_str as string into string:
        let sv is essence of self
        let hit as int is calling pengu__find_sub with sv, from_str, 0
        if hit < 0:
            return sv
        let fl as int is from_str length
        let head is sv at 0 to hit
        let tail is sv at (hit + fl) to (sv length)
        return "{head}{to_str}{tail}"
    ## Copy with **every** non-overlapping occurrence of `from_str` replaced.
    ##
    ## ## Parámetros
    ## - `from_str`: the text to replace; an empty `from_str` changes nothing.
    ## - `to_str`: the replacement text.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "cat, cat".replace_all with "cat", "dog"    # "dog, dog"
    ## ```
    weave replace_all with from_str as string, to_str as string into string:
        let sv is essence of self
        return calling pengu_string_replace with sv, from_str, to_str
    ## Split on every occurrence of `delim`.
    ##
    ## ## Parámetros
    ## - `delim`: the separator; an empty `delim` keeps the whole string.
    ##
    ## ## Retorno
    ## A new owned `list of string`; release it with `banish`. An absent
    ## delimiter yields one element.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "a,,b".split with ","    # ["a", "", "b"]
    ## ```
    weave split with delim as string into list of string:
        let sv is essence of self
        let dl as int is delim length
        var parts as list of string is list of string
        if dl == 0:
            calling parts.push with sv
            return parts
        var start as int is 0
        var hit as int is calling pengu__find_sub with sv, delim, start
        while hit >= 0:
            calling parts.push with (sv at start to hit)
            set start is hit + dl
            set hit is calling pengu__find_sub with sv, delim, start
        calling parts.push with (sv at start to (sv length))
        return parts
    ## Split into **at most** `n` parts on `delim`.
    ##
    ## ## Parámetros
    ## - `delim`: the separator; an empty `delim` keeps the whole string.
    ## - `n`: maximum number of parts; `n <= 0` performs no split at all.
    ##
    ## ## Retorno
    ## A new owned `list of string`; release it with `banish`. The last element
    ## keeps the remaining delimiters.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "a,b,c".splitn with ",", 2    # ["a", "b,c"]
    ## ```
    weave splitn with delim as string, n as int into list of string:
        let sv is essence of self
        let dl as int is delim length
        var parts as list of string is list of string
        if n <= 0 or dl == 0:
            calling parts.push with sv
            return parts
        var start as int is 0
        var left as int is n
        while left > 1:
            let hit as int is calling pengu__find_sub with sv, delim, start
            if hit < 0:
                break
            calling parts.push with (sv at start to hit)
            set start is hit + dl
            set left is left - 1
        calling parts.push with (sv at start to (sv length))
        return parts
    ## Split on `delim` into the same parts `split` produces.
    ##
    ## ## Parámetros
    ## - `delim`: the separator; an empty `delim` keeps the whole string.
    ##
    ## ## Retorno
    ## A new owned `list of string` in left-to-right order; release it with
    ## `banish`. Without a part limit the result is identical to `split`'s; the
    ## name exists so code that reads a right-hand variant stays expressive.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "a:b:c".rsplit with ":"    # ["a", "b", "c"]
    ## ```
    weave rsplit with delim as string into list of string:
        let sv is essence of self
        let dl as int is delim length
        var parts as list of string is list of string
        if dl == 0:
            calling parts.push with sv
            return parts
        var hits as list of int is list of int
        defer banish hits
        var start as int is 0
        var hit as int is calling pengu__find_sub with sv, delim, start
        while hit >= 0:
            calling hits.push with hit
            set start is hit + dl
            set hit is calling pengu__find_sub with sv, delim, start
        var prev as int is 0
        var j as int is 0
        while j < (hits length):
            let pos as int is hits at j
            calling parts.push with (sv at prev to pos)
            set prev is pos + dl
            set j is j + 1
        calling parts.push with (sv at prev to (sv length))
        return parts
    ## Split on the **first** occurrence of `sep`: `[before, sep, after]`.
    ##
    ## ## Parámetros
    ## - `sep`: the separator; when absent or empty no split happens.
    ##
    ## ## Retorno
    ## A new owned 3-element `list of string`; release it with `banish`. When
    ## `sep` is missing it returns `[self, "", ""]`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "a=b=c".partition with "="    # ["a", "=", "b=c"]
    ## ```
    weave partition with sep as string into list of string:
        let sv is essence of self
        var parts as list of string is list of string with capacity 3
        let hit as int is calling pengu__find_sub with sv, sep, 0
        if hit < 0 or (sep length) == 0:
            calling parts.push with sv
            calling parts.push with ""
            calling parts.push with ""
            return parts
        let sl as int is sep length
        calling parts.push with (sv at 0 to hit)
        calling parts.push with sep
        calling parts.push with (sv at (hit + sl) to (sv length))
        return parts
    ## Copy repeated `count` times.
    ##
    ## ## Parámetros
    ## - `count`: the number of copies.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`. `count <= 0` or an empty
    ## receiver yields "".
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "ha".repeat with 3    # "hahaha"
    ## ```
    weave repeat with count as int into string:
        let sv is essence of self
        return calling pengu_string_repeat with sv, count
    ## Copy repeated `count` times and joined with `sep`.
    ##
    ## ## Parámetros
    ## - `count`: the number of copies.
    ## - `sep`: the text placed between copies.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`. `count <= 0` or an empty
    ## receiver yields "".
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "ab".repeat_join with 3, ", "    # "ab, ab, ab"
    ## ```
    weave repeat_join with count as int, sep as string into string:
        let sv is essence of self
        if count <= 0 or (sv length) == 0:
            return ""
        var parts as list of string is list of string with capacity count
        for i from 0 to count:
            calling parts.push with sv
        return calling _join_parts with parts, sep

    # --- Alignment ------------------------------------------------------
    ## Left-align in `width`, padding on the right with `pad_char`.
    ##
    ## ## Parámetros
    ## - `width`: the target byte width.
    ## - `pad_char`: the padding text (default `" "`); empty means no padding.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`. Values that already fit are
    ## returned unchanged and the result is truncated to `width`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "ab".ljust with 4, "."    # "ab.."
    ## ```
    weave ljust with width as int, pad_char as string is " " into string:
        let sv is essence of self
        let ll as int is sv length
        let pl as int is pad_char length
        if ll >= width or pl == 0:
            return sv
        let pad_count as int is ((width - ll) + pl - 1) / pl
        let padded is calling _pad_right with sv, pad_count, pad_char
        if (padded length) > width:
            return padded at 0 to width
        return padded
    ## Right-align in `width`, padding on the left with `pad_char`.
    ##
    ## ## Parámetros
    ## - `width`: the target byte width.
    ## - `pad_char`: the padding text (default `" "`); empty means no padding.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`. Values that already fit are
    ## returned unchanged and the result is truncated to `width`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "42".rjust with 5, "0"    # "00042"
    ## ```
    weave rjust with width as int, pad_char as string is " " into string:
        let sv is essence of self
        let ll as int is sv length
        let pl as int is pad_char length
        if ll >= width or pl == 0:
            return sv
        let pad_count as int is ((width - ll) + pl - 1) / pl
        let padded is calling _pad_left with sv, pad_count, pad_char
        if (padded length) > width:
            return padded at ((padded length) - width) to (padded length)
        return padded
    ## @deprecated Use rjust instead.
    ##
    ## ## Parámetros
    ## - `width`: the target byte width.
    ## - `pad_char`: the padding text (default `" "`).
    ##
    ## ## Retorno
    ## Same as `rjust`; kept only for compatibility.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "42".pad_left with 5, "0"    # "00042"
    ## ```
    weave pad_left with width as int, pad_char as string is " " into string:
        return calling self.rjust with width, pad_char
    ## @deprecated Use ljust instead.
    ##
    ## ## Parámetros
    ## - `width`: the target byte width.
    ## - `pad_char`: the padding text (default `" "`).
    ##
    ## ## Retorno
    ## Same as `ljust`; kept only for compatibility.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "ab".pad_right with 4, "."    # "ab.."
    ## ```
    weave pad_right with width as int, pad_char as string is " " into string:
        return calling self.ljust with width, pad_char
    ## Zero-pad on the left up to `width`, preserving a leading sign.
    ##
    ## ## Parámetros
    ## - `width`: the target byte width.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`. `-`/`+` stays first and a
    ## value that already fits is returned unchanged.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "-42".zfill with 6    # "-00042"
    ## ```
    weave zfill with width as int into string:
        let sv is essence of self
        if (sv length) >= width:
            return sv
        let has_bytes as bool is (sv length) > 0
        let first is if has_bytes then (sv at 0 to 1) else ""
        let signed as bool is has_bytes and (first == "-" or first == "+")
        let sign as string is if signed then first else ""
        let rest as string is if signed then (sv at 1 to (sv length)) else sv
        let zeros as int is width - (rest length) - (sign length)
        let padded is calling _pad_left with rest, zeros, "0"
        return "{sign}{padded}"
    ## Center in a field of `width`, padding both sides with `pad_char`.
    ##
    ## ## Parámetros
    ## - `width`: the target byte width.
    ## - `pad_char`: the padding text (default `" "`); empty means no padding.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`. With an odd amount of
    ## padding the left side gets the smaller half (Python's rule).
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "ab".center with 5, "-"    # "-ab--"
    ## ```
    weave center with width as int, pad_char as string is " " into string:
        let sv is essence of self
        let ll as int is sv length
        if ll >= width or (pad_char length) == 0:
            return sv
        let total as int is width - ll
        let left_count as int is total / 2
        let right_count as int is total - left_count
        let left_pad is calling _pad_left with "", left_count, pad_char
        let right_pad is calling _pad_right with "", right_count, pad_char
        return "{left_pad}{sv}{right_pad}"

    # --- Prefixes and suffixes ------------------------------------------
    ## Copy with `prefix` removed from the start when present.
    ##
    ## ## Parámetros
    ## - `prefix`: the prefix to strip; empty leaves the string unchanged.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "Hello".removeprefix with "He"    # "llo"
    ## ```
    weave removeprefix with prefix as string into string:
        let sv is essence of self
        if calling pengu_string_starts_with with sv, prefix:
            return sv at (prefix length) to (sv length)
        return sv
    ## Copy with `suffix` removed from the end when present.
    ##
    ## ## Parámetros
    ## - `suffix`: the suffix to strip; empty leaves the string unchanged.
    ##
    ## ## Retorno
    ## A new owned string; release it with `banish`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "Hello".removesuffix with "lo"    # "Hel"
    ## ```
    weave removesuffix with suffix as string into string:
        let sv is essence of self
        let ll as int is sv length
        let sl as int is suffix length
        if calling pengu_string_ends_with with sv, suffix:
            return sv at 0 to (ll - sl)
        return sv

    # --- Comparison -----------------------------------------------------
    ## Compare byte by byte against `other` and return -1, 0 or 1.
    ##
    ## ## Parámetros
    ## - `other`: the string to compare against.
    ##
    ## ## Retorno
    ## -1 when `self` sorts first, 1 when it sorts last, 0 when equal. Ties on the
    ## common prefix fall back to length. Comparison is byte-ordered, so uppercase
    ## sorts before lowercase.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "apple".compare with "banana"    # -1
    ## ```
    weave compare with other as string into int:
        let sv is essence of self
        let l1 as int is sv length
        let l2 as int is other length
        let min_l is if l1 < l2 then l1 else l2
        for i from 0 to min_l:
            let c1 as int is ord (sv at i)
            let c2 as int is ord (other at i)
            if c1 != c2:
                return if c1 < c2 then -1 else 1
        return judge (l1 == l2):
            when true -> 0
            when false -> (if l1 < l2 then -1 else 1)

    # --- Truncation -----------------------------------------------------
    ## Cut to `max_len` bytes, appending `suffix` when anything was cut.
    ##
    ## ## Parámetros
    ## - `max_len`: the maximum result length in bytes.
    ## - `suffix`: the marker appended after a cut (e.g. `"..."`).
    ##
    ## ## Retorno
    ## A new owned string; `max_len <= len(suffix)` cuts without the marker and
    ## `max_len <= 0` yields "".
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "Hello, World!".truncate with 10, "..."    # "Hello, ..."
    ## ```
    weave truncate with max_len as int, suffix as string into string:
        let sv is essence of self
        let ll as int is sv length
        if ll <= max_len:
            return sv
        let sl as int is suffix length
        if max_len <= sl:
            if max_len <= 0:
                return ""
            return sv at 0 to max_len
        let head is sv at 0 to (max_len - sl)
        return "{head}{suffix}"
    ## Cut to `max_len` bytes, appending "..." when anything was cut.
    ##
    ## ## Parámetros
    ## - `max_len`: the maximum result length in bytes.
    ##
    ## ## Retorno
    ## A new owned string; the short form of `truncate` with `"..."`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "abcdef".ellipsis with 4    # "a..."
    ## ```
    weave ellipsis with max_len as int into string:
        return calling self.truncate with max_len, "..."

    # --- Parsing --------------------------------------------------------
    ## Interpret the string as an integer (optional whitespace and sign).
    ##
    ## ## Parámetros
    ## - None: the receiver is parsed in base 10.
    ##
    ## ## Retorno
    ## `some value`, or `none` for garbage or overflow. The boxed payload lives in
    ## a heap `maybe`; release it with `banish`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling " 42 ".parse_int    # some 42
    ## ```
    weave parse_int into maybe int:
        let sv is essence of self
        return calling spark.parse_int with sv
    ## True when the string is an exact numeric literal: optional sign and `.`.
    ##
    ## ## Parámetros
    ## - None: the receiver is validated.
    ##
    ## ## Retorno
    ## `true` for `[+-]?digits[.digits]?` with at least one digit; `false` for
    ## whitespace, exponents or repeated dots.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "-3.5".is_numeric    # true
    ## ```
    weave is_numeric into bool:
        let sv is essence of self
        var has_digit as bool is false
        var has_dot as bool is false
        for i, ch in sv:
            let is_sign as bool is ch == "+" or ch == "-"
            if is_sign and i != 0:
                return false
            if not is_sign:
                if ch == ".":
                    if has_dot:
                        return false
                    set has_dot is true
                else:
                    if not (calling _char_is_digit with ch):
                        return false
                    set has_digit is true
        return has_digit
    ## Interpret the string as a decimal (optional whitespace, no exponents).
    ##
    ## ## Parámetros
    ## - None: the receiver is trimmed and then validated by `is_numeric`.
    ##
    ## ## Retorno
    ## `some value`, or `none` when `is_numeric` rejects it. The boxed payload
    ## lives in a heap `maybe`; release it with `banish`.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling "3.5".parse_float    # some 3.5
    ## ```
    weave parse_float into maybe float:
        let sv as string is essence of self
        let trimmed as string is calling sv.trim
        if not (calling trimmed.is_numeric):
            return maybe none
        return some (calling _float_from_literal with trimmed)

# --- Module functions ---------------------------------------------------
# Functional form of every method: the receiver becomes the first parameter `s`
# and the `weave` delegates to the method of the same name, documented above.
# The contract and the edge cases are identical.

## Functional form of `len`: number of bytes in `s`.
##
## ## Parámetros
## - `s`: the string to measure.
##
## ## Retorno
## The byte length as an `int`.
##
## ## Ejemplo
## ```pengu
## calling scrolls.len with "abc"    # 3
## ```
weave len with s as string into int:
    return calling s.len
## Functional form of `is_empty`: true when `s` has zero bytes.
##
## ## Parámetros
## - `s`: the string to test.
##
## ## Retorno
## `true` for "" and `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling scrolls.is_empty with ""    # true
## ```
weave is_empty with s as string into bool:
    return calling s.is_empty

# --- Search -------------------------------------------------------------
## Functional form of `contains`: true when `sub` occurs in `s`.
##
## ## Parámetros
## - `s`: the haystack.
## - `sub`: the needle; may be empty.
##
## ## Retorno
## `true` when `sub` is found.
##
## ## Ejemplo
## ```pengu
## calling scrolls.contains with "abc", "b"    # true
## ```
weave contains with s as string, sub as string into bool:
    return calling s.contains with sub
## Functional form of `starts_with`: true when `s` starts with `prefix`.
##
## ## Parámetros
## - `s`: the string to test.
## - `prefix`: the prefix; empty always matches.
##
## ## Retorno
## `true` when the prefix matches.
##
## ## Ejemplo
## ```pengu
## calling scrolls.starts_with with "abc", "ab"    # true
## ```
weave starts_with with s as string, prefix as string into bool:
    return calling s.starts_with with prefix
## Functional form of `starts_with_any`: true when any prefix matches.
##
## ## Parámetros
## - `s`: the string to test.
## - `prefixes`: the candidate prefixes; empty never matches.
##
## ## Retorno
## `true` at the first match, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling scrolls.starts_with_any with "abc", ["x", "ab"]    # true
## ```
weave starts_with_any with s as string, prefixes as list of string into bool:
    return calling s.starts_with_any with prefixes
## Functional form of `ends_with`: true when `s` ends with `suffix`.
##
## ## Parámetros
## - `s`: the string to test.
## - `suffix`: the suffix; empty always matches.
##
## ## Retorno
## `true` when the suffix matches.
##
## ## Ejemplo
## ```pengu
## calling scrolls.ends_with with "abc", "bc"    # true
## ```
weave ends_with with s as string, suffix as string into bool:
    return calling s.ends_with with suffix
## Functional form of `ends_with_any`: true when any suffix matches.
##
## ## Parámetros
## - `s`: the string to test.
## - `suffixes`: the candidate suffixes; empty never matches.
##
## ## Retorno
## `true` at the first match, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling scrolls.ends_with_any with "abc", ["x", "bc"]    # true
## ```
weave ends_with_any with s as string, suffixes as list of string into bool:
    return calling s.ends_with_any with suffixes
## Functional form of `index_of`: first index of `sub`, or -1.
##
## ## Parámetros
## - `s`: the haystack.
## - `sub`: the needle; may be empty.
##
## ## Retorno
## The 0-based byte index, or -1.
##
## ## Ejemplo
## ```pengu
## calling scrolls.index_of with "abc", "c"    # 2
## ```
weave index_of with s as string, sub as string into int:
    return calling s.index_of with sub
## Functional form of `last_index_of`: last index of `sub`, or -1.
##
## ## Parámetros
## - `s`: the haystack.
## - `sub`: the needle; may be empty.
##
## ## Retorno
## The 0-based byte index of the last match, or -1.
##
## ## Ejemplo
## ```pengu
## calling scrolls.last_index_of with "abca", "a"    # 3
## ```
weave last_index_of with s as string, sub as string into int:
    return calling s.last_index_of with sub

# --- Slicing ------------------------------------------------------------
## Functional form of `substring`: bytes from `start_pos` to `end_pos`.
##
## ## Parámetros
## - `s`: the source string.
## - `start_pos`: first byte index to keep.
## - `end_pos`: byte index to stop at.
##
## ## Retorno
## A new owned string; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## calling scrolls.substring with "abcdef", 1, 3    # "bc"
## ```
weave substring with s as string, start_pos as int, end_pos as int into string:
    return calling s.substring with start_pos, end_pos
## Functional form of `char_at`: the byte at `idx` as a one-byte string.
##
## ## Parámetros
## - `s`: the source string.
## - `idx`: the byte position.
##
## ## Retorno
## A new owned one-byte string; release it with `banish`.
##
## ## Ejemplo
## ```pengu
## calling scrolls.char_at with "abc", 1    # "b"
## ```
weave char_at with s as string, idx as int into string:
    return calling s.char_at with idx

# --- Case ---------------------------------------------------------------
## Functional form of `lower`: ASCII A-Z lowered.
