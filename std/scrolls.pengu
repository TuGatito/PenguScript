## Join the elements of `parts` with `sep` between them.
##
## ## Parámetros
## - `parts`: the pieces to join; an empty list yields "".
## - `sep`: the text placed between pieces.
##
## ## Retorno
## A new owned string; release it with `banish`. The empty pieces are preserved
## (`["", "x", ""]` joined with `"|"` is `"|x|"`).
##
## ## Ejemplo
## ```pengu
## calling scrolls.join with ["a", "b"], "-"    # "a-b"
## ```
weave join with parts as list of string, sep as string into string:
    return calling _join_parts with parts, sep

# --- Private helpers ----------------------------------------------------
## Join `parts` with `sep` between elements (the real body of `join`).
##
## ## Parámetros
## - `parts`: the pieces to join.
## - `sep`: the text between pieces.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _join_parts with parts as list of string, sep as string into string:
    let ll as int is parts length
    if ll == 0:
        return ""
    var pieces as list of string is list of string with capacity ll
    calling pieces.push with (parts at 0)
    var i as int is 1
    while i < ll:
        calling pieces.push with "{sep}{parts at i}"
        set i is i + 1
    return calling _concat with pieces
## The module's single string accumulation point: concatenate `parts` as they are.
##
## ## Parámetros
## - `parts`: the pieces to concatenate, in order.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _concat with parts as list of string into string:
    var out as string is ""
    for part in parts:
        set out is "{out}{part}"
    return out
## Copy of `ch` lowercased when it is an ASCII uppercase letter.
##
## ## Parámetros
## - `ch`: the one-byte string to transform.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _lower_char with ch as string into string:
    if calling _char_is_upper with ch:
        return chr ((ord ch) + 32)
    return ch
## Copy of `ch` uppercased when it is an ASCII lowercase letter.
##
## ## Parámetros
## - `ch`: the one-byte string to transform.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _upper_char with ch as string into string:
    if calling _char_is_lower with ch:
        return chr ((ord ch) - 32)
    return ch
## Copy of `ch` with its ASCII case swapped.
##
## ## Parámetros
## - `ch`: the one-byte string to transform.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _swap_char with ch as string into string:
    if calling _char_is_upper with ch:
        return chr ((ord ch) + 32)
    if calling _char_is_lower with ch:
        return chr ((ord ch) - 32)
    return ch
## Copy of `s` with `count` copies of `pad_char` in front.
##
## ## Parámetros
## - `s`: the base string.
## - `count`: how many copies of `pad_char` to prepend.
## - `pad_char`: the padding text.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _pad_left with s as string, count as int, pad_char as string into string:
    if count <= 0:
        return s
    var parts as list of string is list of string with capacity (count + 1)
    for i from 0 to count:
        calling parts.push with pad_char
    calling parts.push with s
    return calling _concat with parts
## Copy of `s` with `count` copies of `pad_char` behind.
##
## ## Parámetros
## - `s`: the base string.
## - `count`: how many copies of `pad_char` to append.
## - `pad_char`: the padding text.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _pad_right with s as string, count as int, pad_char as string into string:
    if count <= 0:
        return s
    var parts as list of string is list of string with capacity (count + 1)
    calling parts.push with s
    for i from 0 to count:
        calling parts.push with pad_char
    return calling _concat with parts
## Decimal value of a valid numeric literal (precondition: `is_numeric`).
##
## ## Parámetros
## - `s`: a literal accepted by `is_numeric`.
##
## ## Retorno
## The `float` value; exponents are not supported.
weave _float_from_literal with s as string into float:
    var int_val as float is 0.0
    var frac_val as float is 0.0
    var scale as float is 1.0
    var seen_dot as bool is false
    for ch in s:
        if ch == ".":
            set seen_dot is true
        else:
            if calling _char_is_digit with ch:
                let digit as float is ((ord ch) - 48) to float
                if seen_dot:
                    set scale is scale * 10.0
                    set frac_val is (frac_val * 10.0) + digit
                else:
                    set int_val is (int_val * 10.0) + digit
    var sign as float is 1.0
    if (s at 0 to 1) == "-":
        set sign is -1.0
    return sign * (int_val + (frac_val / scale))
## Private test harness: panic with `label` when `cond` is false.
##
## ## Parámetros
## - `cond`: the condition that must hold.
## - `label`: the message reported on failure.
##
## ## Retorno
## Nothing; it panics through `spark.panic` on failure.
weave _expect with cond as bool, label as string into void:
    if not cond:
        calling spark.panic with "scrolls test failed: {label}"
## Private test harness: integer equality.
##
## ## Parámetros
## - `actual`: the observed value.
## - `expected`: the required value.
## - `label`: the message reported on failure.
##
## ## Retorno
## Nothing; it panics through `spark.panic` on mismatch.
weave _expect_eq_int with actual as int, expected as int, label as string into void:
    if actual != expected:
        calling spark.panic with "scrolls test failed: {label}: {(actual to string)} != {(expected to string)}"
## Private test harness: string equality.
##
## ## Parámetros
## - `actual`: the observed value.
## - `expected`: the required value.
## - `label`: the message reported on failure.
##
## ## Retorno
## Nothing; it panics through `spark.panic` on mismatch.
weave _expect_eq_string with actual as string, expected as string, label as string into void:
    if actual != expected:
        calling spark.panic with "scrolls test failed: {label}: {actual} != {expected}"
## Private test harness: boolean equality.
##
## ## Parámetros
## - `actual`: the observed value.
## - `expected`: the required value.
## - `label`: the message reported on failure.
##
## ## Retorno
## Nothing; it panics through `spark.panic` on mismatch.
weave _expect_eq_bool with actual as bool, expected as bool, label as string into void:
    if actual != expected:
        calling spark.panic with "scrolls test failed: {label}"

# --- Tests ---
# Private harness in `_expect*` (see `## Design notes`).

# Length and iteration
test "len counts bytes, also in UTF-8":
    var s as string is "café"
    calling _expect_eq_int with (calling s.len), 5, "len"
    calling _expect_eq_int with (calling len with "abc"), 3, "functional len"
test "is_empty distinguishes the empty string":
    var empty_s as string is ""
    calling _expect_eq_bool with (calling empty_s.is_empty), true, "is_empty"
    calling _expect_eq_bool with (calling is_empty with "x"), false, "functional is_empty"
test "chars returns a one-byte string per element":
    var s as string is "abc"
    var parts as list of string is calling s.chars
    calling _expect_eq_int with (parts length), 3, "chars"
    var letters as list of string is calling chars with s
    calling _expect_eq_string with (letters at 1), "b", "functional chars"
test "bytes returns the ASCII codes":
    var s as string is "AB"
    var codes as list of int is calling s.bytes
    calling _expect_eq_int with (codes at 0), 65, "bytes"
    var func_codes as list of int is calling bytes with s
    calling _expect_eq_int with (func_codes at 1), 66, "functional bytes"

# Search
test "contains finds and discards substrings":
    var s as string is "abc"
    calling _expect_eq_bool with (calling s.contains with "bc"), true, "contains"
    calling _expect_eq_bool with (calling contains with s, "z"), false, "functional contains"
test "starts_with accepts the empty prefix":
    var s as string is "abc"
    calling _expect_eq_bool with (calling s.starts_with with ""), true, "empty prefix"
    calling _expect_eq_bool with (calling starts_with with s, "bc"), false, "wrong prefix"
test "ends_with recognises suffixes":
    var s as string is "abc"
    calling _expect_eq_bool with (calling s.ends_with with "bc"), true, "ends_with"
    calling _expect_eq_bool with (calling ends_with with s, "abcd"), false, "long suffix"
test "index_of returns the first position":
    var s as string is "abracadabra"
    calling _expect_eq_int with (calling s.index_of with "cad"), 4, "index_of"
    calling _expect_eq_int with (calling index_of with s, ""), 0, "empty sub"
test "index_of returns -1 when it does not find":
    var s as string is "abc"
    calling _expect_eq_int with (calling s.index_of with "z"), -1, "absent"
    calling _expect_eq_int with (calling s.index_of with "abcd"), -1, "longer"
test "last_index_of returns the last position":
    var s as string is "abracadabra"
    calling _expect_eq_int with (calling s.last_index_of with "abra"), 7, "last_index_of"
    calling _expect_eq_int with (calling last_index_of with s, "z"), -1, "absent"
test "last_index_of with an empty sub returns the length":
    var s as string is "abc"
    calling _expect_eq_int with (calling s.last_index_of with ""), 3, "empty sub"
test "count counts non-overlapping occurrences":
    var s as string is "abracadabra"
    calling _expect_eq_int with (calling s.count with "a"), 5, "count"
    calling _expect_eq_int with (calling count with s, "abra"), 2, "functional count"
test "count ignores the empty sub and the longer sub":
    var s as string is "abc"
    calling _expect_eq_int with (calling s.count with ""), 0, "empty"
    var repeated as string is "aaaa"
    calling _expect_eq_int with (calling repeated.count with "aa"), 2, "non-overlapping"
test "find, rfind and count_matches still work":
    var s as string is "abracadabra"
    calling _expect_eq_int with (calling s.find with "cad"), 4, "find"
    calling _expect_eq_int with (calling s.rfind with "abra"), 7, "rfind"
    calling _expect_eq_int with (calling s.count_matches with "a"), 5, "count_matches"
test "functional query forms":
    calling _expect_eq_bool with (calling contains with "abc", "b"), true, "contains"
    calling _expect_eq_bool with (calling starts_with with "abc", "ab"), true, "starts_with"
    calling _expect_eq_bool with (calling ends_with with "abc", "bc"), true, "ends_with"
test "functional position and count forms":
    calling _expect_eq_int with (calling index_of with "abc", "c"), 2, "index_of"
    calling _expect_eq_int with (calling last_index_of with "abca", "a"), 3, "last_index_of"
    calling _expect_eq_int with (calling count_matches with "aaaa", "aa"), 2, "count_matches"

# Slicing
test "substring cuts the requested range":
    var s as string is "abcdef"
    calling _expect_eq_string with (calling s.substring with 1, 4), "bcd", "substring"
    calling _expect_eq_string with (calling substring with s, 0, 0), "", "empty range"
test "char_at returns one byte as a string":
    var s as string is "abc"
    calling _expect_eq_string with (calling s.char_at with 1), "b", "char_at"
    calling _expect_eq_string with (calling char_at with s, 2), "c", "functional char_at"
test "reverse flips the byte order":
    var s as string is "pengu"
    calling _expect_eq_string with (calling s.reverse), "ugnep", "reverse"
    calling _expect_eq_string with (calling reverse with s), "ugnep", "functional reverse"
test "reverse of the empty string is empty":
    var empty_s as string is ""
    calling _expect_eq_string with (calling empty_s.reverse), "", "empty reverse"

# Case
test "lower converts A-Z and leaves the rest alone":
    var s as string is "Hello, World!"
    calling _expect_eq_string with (calling s.lower), "hello, world!", "lower"
    calling _expect_eq_string with (calling lower with s), "hello, world!", "functional lower"
test "upper converts a-z to uppercase":
    var s as string is "abc"
    calling _expect_eq_string with (calling s.upper), "ABC", "upper"
    calling _expect_eq_string with (calling upper with s), "ABC", "functional upper"
test "to_lower and to_upper still work":
    var s as string is "AbC"
    calling _expect_eq_string with (calling s.to_lower), "abc", "to_lower"
    calling _expect_eq_string with (calling to_upper with s), "ABC", "functional to_upper"
test "lower leaves UTF-8 bytes untouched":
    var s as string is "CAFé"
    calling _expect_eq_string with (calling s.lower), "café", "UTF-8"
test "capitalize keeps only the first letter uppercase":
    var s as string is "hELLO world"
    calling _expect_eq_string with (calling s.capitalize), "Hello world", "capitalize"
    calling _expect_eq_string with (calling capitalize with "1abc"), "1abc", "leading digit"
test "capitalize of the empty string is empty":
    var empty_s as string is ""
    calling _expect_eq_string with (calling empty_s.capitalize), "", "empty capitalize"
test "title capitalizes the initial of every word":
    var s as string is "hello world"
    calling _expect_eq_string with (calling s.title), "Hello World", "title"
    calling _expect_eq_string with (calling title with s), "Hello World", "functional title"
test "title preserves the original spacing":
    var s as string is "  a  b "
    calling _expect_eq_string with (calling s.title), "  A  B ", "spaces"
test "title_case still works":
    var s as string is "hello world"
    calling _expect_eq_string with (calling s.title_case), "Hello World", "title_case"
test "swap_case flips the case of every letter":
    var s as string is "Hello, World!"
    calling _expect_eq_string with (calling s.swap_case), "hELLO, wORLD!", "swap_case"
    calling _expect_eq_string with (calling swap_case with "a1B"), "A1b", "non-letters"
test "to_snake_case splits camelCase and PascalCase":
    var s as string is "helloWorld"
    calling _expect_eq_string with (calling s.to_snake_case), "hello_world", "camel"
    calling _expect_eq_string with (calling to_snake_case with "HTTPServer"), "http_server", "acronym"
test "to_snake_case normalises separators":
    var s as string is "hello--world"
    calling _expect_eq_string with (calling s.to_snake_case), "hello_world", "dashes"
    calling _expect_eq_string with (calling to_snake_case with ""), "", "empty"
test "to_kebab_case uses dashes":
    var s as string is "HelloWorld"
    calling _expect_eq_string with (calling s.to_kebab_case), "hello-world", "kebab"
    calling _expect_eq_string with (calling to_kebab_case with s), "hello-world", "functional kebab"
test "snake_case and kebab_case are short forms":
    var s as string is "helloWorld"
    calling _expect_eq_string with (calling s.snake_case), "hello_world", "snake_case"
    calling _expect_eq_string with (calling kebab_case with s), "hello-world", "functional kebab_case"
test "pascal_case capitalizes every word":
    var s as string is "hello_world"
    calling _expect_eq_string with (calling s.pascal_case), "HelloWorld", "snake to pascal"
    calling _expect_eq_string with (calling pascal_case with "helloWorld"), "HelloWorld", "functional"
test "is_alpha demands ASCII letters only":
    var s as string is "aB"
    calling _expect_eq_bool with (calling s.is_alpha), true, "is_alpha"
    calling _expect_eq_bool with (calling is_alpha with "a1"), false, "with digit"
test "is_digit demands ASCII digits only":
    var s as string is "123"
    calling _expect_eq_bool with (calling s.is_digit), true, "is_digit"
    calling _expect_eq_bool with (calling is_digit with "12a"), false, "with letter"
test "is_alnum accepts letters and digits":
    var s as string is "a1"
    calling _expect_eq_bool with (calling s.is_alnum), true, "is_alnum"
    calling _expect_eq_bool with (calling is_alnum with "a 1"), false, "with space"
test "is_lower and is_upper ignore non-alphabetic bytes":
    var s as string is "a1"
    calling _expect_eq_bool with (calling s.is_lower), true, "is_lower"
    calling _expect_eq_bool with (calling is_upper with "A1"), true, "is_upper"
test "is_palindrome detects palindromes":
    var s as string is "racecar"
    calling _expect_eq_bool with (calling s.is_palindrome), true, "palindrome"
    calling _expect_eq_bool with (calling is_palindrome with "ab"), false, "not a palindrome"
test "functional case forms":
    calling _expect_eq_string with (calling capitalize with "hOLA"), "Hola", "capitalize"
    calling _expect_eq_string with (calling title with "a b"), "A B", "title"
    calling _expect_eq_string with (calling swap_case with "aB"), "Ab", "swap_case"
test "functional style-conversion forms":
    calling _expect_eq_string with (calling to_snake_case with "aB"), "a_b", "to_snake_case"
    calling _expect_eq_string with (calling to_kebab_case with "aB"), "a-b", "to_kebab_case"
    calling _expect_eq_string with (calling snake_case with "aB"), "a_b", "snake_case"
    calling _expect_eq_string with (calling pascal_case with "a_b"), "AB", "pascal_case"
test "functional legacy case forms":
    calling _expect_eq_string with (calling to_lower with "AbC"), "abc", "to_lower"
    calling _expect_eq_string with (calling to_upper with "AbC"), "ABC", "to_upper"
    calling _expect_eq_string with (calling title_case with "a b"), "A B", "title_case"

# Whitespace
test "trim removes ASCII whitespace from both ends":
    var s as string is "\t\n x \r\v\f "
    calling _expect_eq_string with (calling s.trim), "x", "trim"
    calling _expect_eq_string with (calling trim with "  a  "), "a", "functional trim"
test "strip is an alias of trim":
    var s as string is "  a  "
    calling _expect_eq_string with (calling s.strip), "a", "strip"
    calling _expect_eq_string with (calling strip with "\tx\t"), "x", "functional strip"
test "trim_start removes only the leading side":
    var s as string is "  a  "
    calling _expect_eq_string with (calling s.trim_start), "a  ", "trim_start"
test "trim_end removes only the trailing side":
    var s as string is "  a  "
    calling _expect_eq_string with (calling s.trim_end), "  a", "trim_end"
test "lstrip and rstrip still work":
    var s as string is "  a  "
    calling _expect_eq_string with (calling s.lstrip), "a  ", "lstrip"
    calling _expect_eq_string with (calling rstrip with s), "  a", "functional rstrip"
test "is_space is false for the empty string":
    var empty_s as string is ""
    calling _expect_eq_bool with (calling empty_s.is_space), false, "empty"
    calling _expect_eq_bool with (calling is_space with "   "), true, "only spaces"
test "is_whitespace still works":
    var s as string is "\t\n"
    calling _expect_eq_bool with (calling s.is_whitespace), true, "is_whitespace"
    calling _expect_eq_bool with (calling is_whitespace with " x"), false, "with text"
test "is_blank is true for empty or whitespace-only":
    var empty_s as string is ""
    calling _expect_eq_bool with (calling empty_s.is_blank), true, "empty"
    calling _expect_eq_bool with (calling is_blank with "a"), false, "with text"
test "split_whitespace ignores repeated spaces":
    var s as string is "  a  b "
    var parts as list of string is calling s.split_whitespace
    calling _expect_eq_int with (parts length), 2, "split_whitespace"
    var func_words as list of string is calling split_whitespace with s
    calling _expect_eq_string with (func_words at 0), "a", "functional"
test "words is the short form of split_whitespace":
    var s as string is "a\tb\nc"
    calling _expect_eq_int with ((calling s.words) length), 3, "words"
    calling _expect_eq_int with ((calling words with "   ") length), 0, "only spaces"
test "split_lines splits on LF and keeps the CR":
    var s as string is "a\r\nb"
    var parts as list of string is calling s.split_lines
    calling _expect_eq_int with (parts length), 2, "split_lines"
    var func_lines as list of string is calling split_lines with s
    calling _expect_eq_string with (func_lines at 0), "a\r", "functional"
test "lines drops the trailing CR of every line":
    var s as string is "a\r\nb\nc"
    var parts as list of string is calling s.lines
    calling _expect_eq_int with (parts length), 3, "lines"
    var func_clean as list of string is calling lines with s
    calling _expect_eq_string with (func_clean at 0), "a", "functional"
test "line_count counts LF-separated lines":
    var s as string is "a\nb\nc"
    calling _expect_eq_int with (calling s.line_count), 3, "line_count"
    calling _expect_eq_int with (calling line_count with ""), 0, "empty"
test "word_count counts whitespace-separated words":
    var s as string is "  a  b "
    calling _expect_eq_int with (calling s.word_count), 2, "word_count"
    calling _expect_eq_int with (calling word_count with "abc"), 1, "one word"
test "functional whitespace forms":
    calling _expect_eq_string with (calling trim_start with " a"), "a", "trim_start"
    calling _expect_eq_string with (calling trim_end with "a "), "a", "trim_end"
    calling _expect_eq_string with (calling lstrip with " a"), "a", "lstrip"
    calling _expect_eq_string with (calling rstrip with "a "), "a", "rstrip"
test "functional whitespace-splitting forms":
    calling _expect_eq_int with ((calling split_whitespace with "a b") length), 2, "split_whitespace"
    calling _expect_eq_int with ((calling words with "a b") length), 2, "words"
    calling _expect_eq_int with ((calling lines with "a\nb") length), 2, "lines"
    calling _expect_eq_int with ((calling split_lines with "a\nb") length), 2, "split_lines"
test "functional line and word count forms":
    calling _expect_eq_int with (calling line_count with "a\nb"), 2, "line_count"
    calling _expect_eq_int with (calling word_count with "a b"), 2, "word_count"
    calling _expect_eq_bool with (calling is_whitespace with " "), true, "is_whitespace"
    calling _expect_eq_bool with (calling is_blank with ""), true, "is_blank"

# Replacing and splitting
test "replace substitutes only the first occurrence":
    var s as string is "cat, dog, cat"
    calling _expect_eq_string with (calling s.replace with "cat", "bird"), "bird, dog, cat", "replace"
    calling _expect_eq_string with (calling replace with s, "cat", "bird"), "bird, dog, cat", "functional"
test "replace without a match leaves the string alone":
    var s as string is "abc"
    calling _expect_eq_string with (calling s.replace with "z", "x"), "abc", "no match"
test "replace with an empty from_str inserts at the start":
    var s as string is "abc"
    calling _expect_eq_string with (calling s.replace with "", "X"), "Xabc", "legacy"
test "replace_all substitutes every occurrence":
    var s as string is "cat, dog, cat"
    calling _expect_eq_string with (calling s.replace_all with "cat", "bird"), "bird, dog, bird", "replace_all"
    calling _expect_eq_string with (calling replace_all with s, "cat", "bird"), "bird, dog, bird", "functional"
test "replace_all with an empty from_str changes nothing":
    var s as string is "abc"
    calling _expect_eq_string with (calling s.replace_all with "", "X"), "abc", "empty"
test "split divides on every delimiter":
    var s as string is "a,,b"
    var parts as list of string is calling s.split with ","
    calling _expect_eq_int with (parts length), 3, "split"
    var func_chunks as list of string is calling split with s, ","
    calling _expect_eq_string with (func_chunks at 1), "", "functional"
test "split with an empty delimiter returns the whole string":
    var s as string is "abc"
    var parts as list of string is calling s.split with ""
    calling _expect_eq_int with (parts length), 1, "empty split"
    calling _expect_eq_string with (parts at 0), "abc", "content"
test "split with an absent delimiter returns one element":
    var s as string is "abc"
    var parts as list of string is calling s.split with "::"
    calling _expect_eq_int with (parts length), 1, "absent"
test "split accepts multi-byte delimiters":
    var s as string is "a::b::c"
    var parts as list of string is calling s.split with "::"
    calling _expect_eq_int with (parts length), 3, "multi-char"
test "splitn keeps the remaining delimiters in the last part":
    var s as string is "a,b,c,d"
    var parts as list of string is calling s.splitn with ",", 3
    calling _expect_eq_int with (parts length), 3, "splitn"
    calling _expect_eq_string with (parts at 2), "c,d", "last part"
    var single as list of string is calling splitn with s, ",", 1
    calling _expect_eq_int with (single length), 1, "functional one part"
    calling _expect_eq_string with (single at 0), "a,b,c,d", "functional whole"
test "splitn with n <= 0 does not split":
    var s as string is "a,b"
    var parts as list of string is calling s.splitn with ",", 0
    calling _expect_eq_int with (parts length), 1, "no split"
    calling _expect_eq_string with (parts at 0), "a,b", "whole string"
test "rsplit scans from the right and preserves the order":
    var s as string is "a:b:c"
    var parts as list of string is calling s.rsplit with ":"
    calling _expect_eq_int with (parts length), 3, "rsplit"
    calling _expect_eq_string with (parts at 0), "a", "first"
    calling _expect_eq_string with (parts at 2), "c", "last"
    var func_parts as list of string is calling rsplit with s, ":"
    calling _expect_eq_int with (func_parts length), 3, "functional rsplit"
test "rsplit keeps empty pieces and handles an empty delimiter":
    var s as string is "a::b"
    var parts as list of string is calling s.rsplit with ":"
    calling _expect_eq_string with (parts at 1), "", "empty piece"
    var whole as list of string is calling s.rsplit with ""
    calling _expect_eq_int with (whole length), 1, "empty delimiter"
test "partition returns before, separator and after":
    var s as string is "a=b=c"
    var parts as list of string is calling s.partition with "="
    calling _expect_eq_int with (parts length), 3, "partition"
    var func_parts as list of string is calling partition with s, "="
    calling _expect_eq_string with (func_parts at 2), "b=c", "functional"
test "partition without a separator returns the string and two empties":
    var s as string is "abc"
    var parts as list of string is calling s.partition with "="
    calling _expect_eq_string with (parts at 0), "abc", "no sep"
    calling _expect_eq_string with (parts at 1), "", "empty"
test "repeat repeats the string count times":
    var s as string is "ha"
    calling _expect_eq_string with (calling s.repeat with 3), "hahaha", "repeat"
    calling _expect_eq_string with (calling repeat with s, 1), "ha", "functional repeat"
test "repeat with a non-positive count is empty":
    var s as string is "ha"
    calling _expect_eq_string with (calling s.repeat with 0), "", "zero"
    calling _expect_eq_string with (calling s.repeat with -1), "", "negative"
test "repeat_join joins the repetitions with the separator":
    var s as string is "ab"
    calling _expect_eq_string with (calling s.repeat_join with 3, ", "), "ab, ab, ab", "repeat_join"
    calling _expect_eq_string with (calling repeat_join with s, 1, ","), "ab", "one copy"
test "functional replacement and splitting forms":
    calling _expect_eq_string with (calling replace with "abc", "b", "X"), "aXc", "replace"
    calling _expect_eq_string with (calling replace_all with "abc", "", "X"), "abc", "replace_all"
    calling _expect_eq_int with ((calling split with "a,b", ",") length), 2, "split"
    calling _expect_eq_int with ((calling partition with "a=b", "=") length), 3, "partition"

# Alignment
test "ljust pads on the right":
    var s as string is "ab"
    calling _expect_eq_string with (calling s.ljust with 4, "."), "ab..", "ljust"
    calling _expect_eq_string with (calling ljust with s, 4, "."), "ab..", "functional ljust"
test "ljust leaves what already fits and respects an empty pad_char":
    var s as string is "abc"
    calling _expect_eq_string with (calling s.ljust with 2, "."), "abc", "already fits"
    calling _expect_eq_string with (calling s.ljust with 5, ""), "abc", "empty pad"
test "ljust truncates when a multi-character pad overflows":
    var s as string is "ab"
    calling _expect_eq_string with (calling s.ljust with 5, "xy"), "abxyx", "truncation"
test "rjust pads on the left":
    var s as string is "42"
    calling _expect_eq_string with (calling s.rjust with 5, "0"), "00042", "rjust"
    calling _expect_eq_string with (calling rjust with s, 5, "0"), "00042", "functional rjust"
test "rjust truncates when a multi-character pad overflows":
    var s as string is "ab"
    calling _expect_eq_string with (calling s.rjust with 5, "xy"), "yxyab", "truncation"
test "pad_left and pad_right still work":
    var s as string is "42"
    calling _expect_eq_string with (calling s.pad_left with 5, "0"), "00042", "pad_left"
    calling _expect_eq_string with (calling pad_right with "ab", 4, "."), "ab..", "pad_right"
test "zfill pads with zeros on the left":
    var s as string is "42"
    calling _expect_eq_string with (calling s.zfill with 5), "00042", "zfill"
    calling _expect_eq_string with (calling zfill with s, 5), "00042", "functional zfill"
test "zfill preserves the sign and leaves what already fits":
    var a as string is "-42"
    var b as string is "+42"
    calling _expect_eq_string with (calling a.zfill with 6), "-00042", "negative"
    calling _expect_eq_string with (calling b.zfill with 5), "+0042", "positive"
test "center spreads the padding on both sides":
    var s as string is "42"
    calling _expect_eq_string with (calling s.center with 6, "-"), "--42--", "center"
    calling _expect_eq_string with (calling center with s, 6, "-"), "--42--", "functional center"
test "center gives the smaller half to the left":
    var s as string is "ab"
    calling _expect_eq_string with (calling s.center with 5, "-"), "-ab--", "odd"
test "center with a multi-character pad does not truncate":
    var s as string is "ab"
    calling _expect_eq_string with (calling s.center with 6, "xy"), "xyxyabxyxy", "multi-char"
test "functional alignment forms":
    calling _expect_eq_string with (calling ljust with "ab", 4), "ab  ", "ljust"
    calling _expect_eq_string with (calling rjust with "ab", 4), "  ab", "rjust"
    calling _expect_eq_string with (calling zfill with "7", 3), "007", "zfill"
    calling _expect_eq_string with (calling center with "a", 3, "."), ".a.", "center"

# Prefixes and suffixes
test "removeprefix drops the prefix when present":
    var s as string is "Hello"
    calling _expect_eq_string with (calling s.removeprefix with "He"), "llo", "removeprefix"
    calling _expect_eq_string with (calling removeprefix with s, ""), "Hello", "empty prefix"
test "removeprefix leaves the string alone when it does not match":
    var s as string is "Hello"
    calling _expect_eq_string with (calling s.removeprefix with "x"), "Hello", "no match"
    calling _expect_eq_string with (calling s.removeprefix with "Hello!"), "Hello", "longer"
test "removesuffix drops the suffix when present":
    var s as string is "Hello"
    calling _expect_eq_string with (calling s.removesuffix with "lo"), "Hel", "removesuffix"
    calling _expect_eq_string with (calling removesuffix with s, ""), "Hello", "empty suffix"
test "removesuffix leaves the string alone when it does not match":
    var s as string is "Hello"
    calling _expect_eq_string with (calling s.removesuffix with "x"), "Hello", "no match"
    calling _expect_eq_string with (calling s.removesuffix with "Hello!"), "Hello", "longer"

# Comparison
test "compare orders lexicographically by byte":
    var a as string is "apple"
    var b as string is "banana"
    calling _expect_eq_int with (calling a.compare with b), -1, "smaller"
    calling _expect_eq_int with (calling compare with b, a), 1, "functional larger"
test "compare uses the length as a tie-break":
    var a as string is "ab"
    calling _expect_eq_int with (calling a.compare with "abc"), -1, "shorter prefix"
    calling _expect_eq_int with (calling a.compare with ""), 1, "against empty"
test "compare returns 0 for equal strings":
    var a as string is "abc"
    calling _expect_eq_int with (calling a.compare with "abc"), 0, "equal"
    calling _expect_eq_int with (calling compare with "", ""), 0, "both empty"
test "compare distinguishes uppercase from lowercase":
    var a as string is "a"
    calling _expect_eq_int with (calling a.compare with "A"), 1, "larger byte"

# Truncation
test "truncate appends the suffix when it cuts":
    var s as string is "Hello, PenguScript!"
    calling _expect_eq_string with (calling s.truncate with 10, "..."), "Hello, ...", "truncate"
    calling _expect_eq_string with (calling truncate with s, 10, "..."), "Hello, ...", "functional"
test "truncate leaves what already fits":
    var s as string is "abc"
    calling _expect_eq_string with (calling s.truncate with 10, "..."), "abc", "no cut"
test "truncate with a small max_len cuts without the suffix":
    var s as string is "abcdef"
    calling _expect_eq_string with (calling s.truncate with 3, "..."), "abc", "no suffix"
    calling _expect_eq_string with (calling s.truncate with 0, "..."), "", "zero"
test "ellipsis cuts adding an ellipsis":
    var s as string is "Hello, PenguScript!"
    calling _expect_eq_string with (calling s.ellipsis with 10), "Hello, ...", "ellipsis"
    calling _expect_eq_string with (calling ellipsis with "abcdef", 3), "abc", "functional"
test "functional truncation and prefix forms":
    calling _expect_eq_string with (calling truncate with "abcdef", 4, ".."), "ab..", "truncate"
    calling _expect_eq_string with (calling ellipsis with "abcdef", 4), "a...", "ellipsis"
    calling _expect_eq_string with (calling removeprefix with "abc", "a"), "bc", "removeprefix"
    calling _expect_eq_string with (calling removesuffix with "abc", "c"), "ab", "removesuffix"

# Parsing
test "parse_int reads integers with spaces and sign":
    var s as string is " 42 "
    var m as maybe int is calling s.parse_int
    calling _expect_eq_bool with (m.is_present), true, "present"
    if v as int is m:
        calling _expect_eq_int with v, 42, "value"
test "parse_int rejects garbage and overflow":
    var s as string is "4x"
    var m as maybe int is calling s.parse_int
    calling _expect_eq_bool with (m.is_present), false, "garbage"
    var big as string is "99999999999999999999"
    var g as maybe int is calling big.parse_int
    calling _expect_eq_bool with (g.is_present), false, "overflow"
test "parse_float computes the decimal value":
    var s as string is "3.5"
    var m as maybe float is calling s.parse_float
    if v as float is m:
        calling _expect with (v > 3.4 and v < 3.6), "3.5"
    else:
        calling _expect with false, "3.5 present"
test "parse_float accepts a sign, a leading dot and spaces":
    var a as string is "-0.25"
    var b as string is ".5"
    var c as string is " 2 "
    if va as float is (calling a.parse_float):
        calling _expect with (va > -0.3 and va < -0.2), "-0.25"
    if vb as float is (calling b.parse_float):
        calling _expect with (vb > 0.4 and vb < 0.6), ".5"
    if vc as float is (calling c.parse_float):
        calling _expect with (vc > 1.9 and vc < 2.1), " 2 "
test "parse_float rejects empty, garbage and exponents":
    var empty_s as string is ""
    var garbage as string is "abc"
    var exponent as string is "1e3"
    calling _expect_eq_bool with ((calling empty_s.parse_float).is_present), false, "empty"
    calling _expect_eq_bool with ((calling garbage.parse_float).is_present), false, "garbage"
    calling _expect_eq_bool with ((calling exponent.parse_float).is_present), false, "exponent"
test "is_numeric accepts exact literals":
    var a as string is "-3.5"
    var b as string is ".5"
    calling _expect_eq_bool with (calling a.is_numeric), true, "negative"
    calling _expect_eq_bool with (calling b.is_numeric), true, "leading dot"
    calling _expect_eq_bool with (calling is_numeric with "42"), true, "functional"
test "is_numeric rejects spaces, exponents and garbage":
    var s as string is " 1"
    calling _expect_eq_bool with (calling s.is_numeric), false, "space"
    var exponent as string is "1e3"
    var double_dot as string is "1.2.3"
    calling _expect_eq_bool with (calling exponent.is_numeric), false, "exponent"
    calling _expect_eq_bool with (calling double_dot.is_numeric), false, "two dots"

# join
test "join connects the elements with the separator":
    var parts as list of string is ["alpha", "beta", "gamma"]
    calling _expect_eq_string with (calling join with parts, ", "), "alpha, beta, gamma", "join"
    calling _expect_eq_string with (calling join with parts, "|"), "alpha|beta|gamma", "other sep"
test "join of an empty list is empty":
    var parts as list of string is list of string
    calling _expect_eq_string with (calling join with parts, ","), "", "empty"
test "join of one element adds no separator":
    var parts as list of string is ["x"]
    calling _expect_eq_string with (calling join with parts, ","), "x", "one element"
test "join preserves the empty elements":
    var parts as list of string is ["", "x", ""]
    calling _expect_eq_string with (calling join with parts, "|"), "|x|", "empties"

# Functional forms and edges
test "functional length and slicing forms":
    calling _expect_eq_int with (calling len with "abcd"), 4, "len"
    calling _expect_eq_string with (calling substring with "abcdef", 1, 3), "bc", "substring"
    calling _expect_eq_string with (calling char_at with "abc", 1), "b", "char_at"
test "functional chars and bytes forms":
    calling _expect_eq_int with ((calling chars with "ab") length), 2, "chars"
    var letter_a as string is "A"
    var codes_a as list of int is calling bytes with letter_a
    calling _expect_eq_int with (codes_a at 0), 65, "bytes"
    calling _expect_eq_bool with (calling is_empty with ""), true, "is_empty"
test "the methods do not mutate the receiver":
    var s as string is "  hola  "
    var t as string is calling s.trim
    calling _expect_eq_string with s, "  hola  ", "receiver intact"
    calling _expect_eq_string with t, "hola", "result"
test "chars and bytes of the empty string are empty":
    var empty_s as string is ""
    calling _expect_eq_int with ((calling empty_s.chars) length), 0, "chars"
    calling _expect_eq_int with ((calling bytes with empty_s) length), 0, "bytes"
test "the content predicates are false for the empty string":
    var empty_s as string is ""
    calling _expect_eq_bool with (calling empty_s.is_alpha), false, "is_alpha"
    calling _expect_eq_bool with (calling empty_s.is_digit), false, "is_digit"
    calling _expect_eq_bool with (calling empty_s.is_alnum), false, "is_alnum"
test "functional predicate forms":
    calling _expect_eq_bool with (calling is_alpha with "aB"), true, "is_alpha"
    calling _expect_eq_bool with (calling is_digit with "12"), true, "is_digit"
    calling _expect_eq_bool with (calling is_alnum with "a1"), true, "is_alnum"
    calling _expect_eq_bool with (calling is_lower with "a1"), true, "is_lower"
test "to_snake_case separates letters from digits":
    var s as string is "a1B"
    calling _expect_eq_string with (calling s.to_snake_case), "a1_b", "digit"
test "parse_int of the empty string is none":
    var empty_s as string is ""
    var m as maybe int is calling empty_s.parse_int
    calling _expect_eq_bool with (m.is_present), false, "empty"
test "index_of and last_index_of with an empty sub on empty":
    var empty_s as string is ""
    calling _expect_eq_int with (calling empty_s.index_of with ""), 0, "index_of"
    calling _expect_eq_int with (calling empty_s.last_index_of with ""), 0, "last_index_of"
test "repeat_join with an empty separator":
    var s as string is "ab"
    calling _expect_eq_string with (calling s.repeat_join with 2, ""), "abab", "no separator"
test "lines with a trailing LF adds an empty line":
    var s as string is "a\n"
    var parts as list of string is calling s.lines
    calling _expect_eq_int with (parts length), 2, "two lines"
    calling _expect_eq_string with (parts at 1), "", "last empty"
test "is_numeric rejects a lone sign":
    var s as string is "+"
    calling _expect_eq_bool with (calling s.is_numeric), false, "sign only"
    var five as string is "5."
    calling _expect_eq_bool with (calling five.is_numeric), true, "trailing dot"
test "compare with a common prefix and different lengths":
    var a as string is "abc"
    calling _expect_eq_int with (calling a.compare with "ab"), 1, "longer"
    var short_s as string is "ab"
    calling _expect_eq_int with (calling short_s.compare with "abc"), -1, "shorter"
test "functional reverse and repetition forms":
    calling _expect_eq_string with (calling reverse with "abc"), "cba", "reverse"
    calling _expect_eq_string with (calling repeat with "ab", 2), "abab", "repeat"

# New in 2.0: strip, splitn, rsplit and the any-prefix/any-suffix predicates
test "starts_with_any matches any prefix":
    var s as string is "abc"
    var some_prefixes as list of string is ["x", "ab"]
    var no_prefixes as list of string is list of string
    var other_prefixes as list of string is ["x"]
    calling _expect_eq_bool with (calling s.starts_with_any with some_prefixes), true, "match"
    calling _expect_eq_bool with (calling s.starts_with_any with no_prefixes), false, "empty list"
    calling _expect_eq_bool with (calling starts_with_any with s, other_prefixes), false, "functional"
test "ends_with_any matches any suffix":
    var s as string is "abc"
    var some_suffixes as list of string is ["x", "bc"]
    var no_suffixes as list of string is list of string
    var other_suffixes as list of string is ["x"]
    calling _expect_eq_bool with (calling s.ends_with_any with some_suffixes), true, "match"
    calling _expect_eq_bool with (calling s.ends_with_any with no_suffixes), false, "empty list"
    calling _expect_eq_bool with (calling ends_with_any with s, other_suffixes), false, "functional"
test "starts_with_any and ends_with_any accept the empty pattern":
    var s as string is "abc"
    var empty_prefixes as list of string is [""]
    var empty_suffixes as list of string is [""]
    calling _expect_eq_bool with (calling s.starts_with_any with empty_prefixes), true, "empty prefix"
    calling _expect_eq_bool with (calling s.ends_with_any with empty_suffixes), true, "empty suffix"
test "strip is the module alias of trim":
    calling _expect_eq_string with (calling strip with "  x  "), "x", "strip"
    var raw as string is "\n x \t"
    calling _expect_eq_string with (calling raw.strip), "x", "method strip"
test "splitn splits into at most n parts":
    var s as string is "a,b,c"
    var parts as list of string is calling s.splitn with ",", 2
    calling _expect_eq_int with (parts length), 2, "two parts"
    calling _expect_eq_string with (parts at 1), "b,c", "remainder"
    var func_parts as list of string is calling splitn with s, ",", 4
    calling _expect_eq_int with (func_parts length), 3, "functional"
test "rsplit agrees with split on a simple string":
    var s as string is "a-b-c"
    var parts as list of string is calling s.rsplit with "-"
    calling _expect_eq_int with (parts length), 3, "rsplit"
    calling _expect_eq_string with (parts at 1), "b", "middle"
