test "split divides on every delimiter":
    var s as string is "a,,b"
    var parts as list of string is calling s.split with ","
    defer banish parts
    calling _expect_eq_int with (parts length), 3, "split"
    var func_chunks as list of string is calling split with s, ","
    defer banish func_chunks
    calling _expect_eq_string with (func_chunks at 1), "", "functional"
test "split with an empty delimiter returns the whole string":
    var s as string is "abc"
    var parts as list of string is calling s.split with ""
    defer banish parts
    calling _expect_eq_int with (parts length), 1, "empty split"
    calling _expect_eq_string with (parts at 0), "abc", "content"
test "split with an absent delimiter returns one element":
    var s as string is "abc"
    var parts as list of string is calling s.split with "::"
    defer banish parts
    calling _expect_eq_int with (parts length), 1, "absent"
test "split accepts multi-byte delimiters":
    var s as string is "a::b::c"
    var parts as list of string is calling s.split with "::"
    defer banish parts
    calling _expect_eq_int with (parts length), 3, "multi-char"
test "splitn keeps the remaining delimiters in the last part":
    var s as string is "a,b,c,d"
    var parts as list of string is calling s.splitn with ",", 3
    defer banish parts
    calling _expect_eq_int with (parts length), 3, "splitn"
