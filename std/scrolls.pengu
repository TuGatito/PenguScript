test "lower leaves UTF-8 bytes untouched":
    var s as string is "CAFé"
    var _lt_4381 as string is calling s.get_lower
    defer banish _lt_4381
    calling _expect_eq_string with _lt_4381, "café", "UTF-8"
test "capitalize keeps only the first letter uppercase":
    var s as string is "hELLO world"
    var _lt_4384 as string is calling s.get_capitalize
    defer banish _lt_4384
    calling _expect_eq_string with _lt_4384, "Hello world", "capitalize"
    var _lt_4385 as string is calling capitalize with "1abc"
    defer banish _lt_4385
