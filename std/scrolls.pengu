## Join the elements of `parts` with `sep` between them.
##
## ## Parámetros
## - `parts`: the pieces to join; an empty list yields "".
## - `sep`: the text placed between pieces.
##
## ## Retorno
## A new owned string; release it with `banish`. The empty pieces are preserved
## (`["", "x", ""]` joined with `"|"` is `"|x|"`).
##
## ## Ejemplo
## ```pengu
## calling scrolls.join with ["a", "b"], "-"    # "a-b"
## ```
weave join with parts as list of string, sep as string into string:
    return calling _join_parts with parts, sep

# --- Private helpers ----------------------------------------------------
## Join `parts` with `sep` between elements (the real body of `join`).
##
## ## Parámetros
## - `parts`: the pieces to join.
## - `sep`: the text between pieces.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _join_parts with parts as list of string, sep as string into string:
    let ll as int is parts length
    if ll == 0:
        return ""
    var out as string is "{parts at 0}"
    var i as int is 1
    while i < ll:
        var next as string is "{out}{sep}{parts at i}"
        banish out
        set out is next
        set i is i + 1
    return out
## The module's single string accumulation point: concatenate `parts` as they are.
##
## ## Parámetros
## - `parts`: the pieces to concatenate, in order.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _concat with parts as list of string into string:
    var out as string is ""
    for part in parts:
        var next as string is "{out}{part}"
        banish out
        set out is next
    return out
## Copy of `ch` lowercased when it is an ASCII uppercase letter.
##
## ## Parámetros
## - `ch`: the one-byte string to transform.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _lower_char with ch as string into string:
    if calling _char_is_upper with ch:
        return chr ((ord ch) + 32)
    return ch
## Copy of `ch` uppercased when it is an ASCII lowercase letter.
##
## ## Parámetros
## - `ch`: the one-byte string to transform.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _upper_char with ch as string into string:
    if calling _char_is_lower with ch:
        return chr ((ord ch) - 32)
    return ch
## Copy of `ch` with its ASCII case swapped.
##
## ## Parámetros
## - `ch`: the one-byte string to transform.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _swap_char with ch as string into string:
    if calling _char_is_upper with ch:
        return chr ((ord ch) + 32)
    if calling _char_is_lower with ch:
        return chr ((ord ch) - 32)
    return ch
## Copy of `s` with `count` copies of `pad_char` in front.
##
## ## Parámetros
## - `s`: the base string.
## - `count`: how many copies of `pad_char` to prepend.
## - `pad_char`: the padding text.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _pad_left with s as string, count as int, pad_char as string into string:
    if count <= 0:
        return "{s}"
    var parts as list of string is list of string with capacity (count + 1)
    for i from 0 to count:
        calling parts.push with pad_char
    calling parts.push with s
    var out as string is calling _concat with parts
    banish parts
    return out
## Copy of `s` with `count` copies of `pad_char` behind.
##
## ## Parámetros
## - `s`: the base string.
## - `count`: how many copies of `pad_char` to append.
## - `pad_char`: the padding text.
##
## ## Retorno
## A new owned string; the caller releases it with `banish`.
weave _pad_right with s as string, count as int, pad_char as string into string:
    if count <= 0:
        return "{s}"
    var parts as list of string is list of string with capacity (count + 1)
    calling parts.push with s
    for i from 0 to count:
        calling parts.push with pad_char
    var out as string is calling _concat with parts
    banish parts
    return out
## Private test harness: panic with `label` when `cond` is false.
##
## ## Parámetros
## - `cond`: the condition that must hold.
## - `label`: the message reported on failure.
##
## ## Retorno
## Nothing; it panics through `spark.panic` on failure.
weave _expect with cond as bool, label as string into void:
    if not cond:
        calling spark.panic with "scrolls test failed: {label}"
## Private test harness: integer equality.
##
## ## Parámetros
## - `actual`: the observed value.
## - `expected`: the required value.
## - `label`: the message reported on failure.
##
## ## Retorno
## Nothing; it panics through `spark.panic` on mismatch.
weave _expect_eq_int with actual as int, expected as int, label as string into void:
    if actual != expected:
        calling spark.panic with "scrolls test failed: {label}: {(actual to string)} != {(expected to string)}"
## Private test harness: string equality.
##
## ## Parámetros
## - `actual`: the observed value.
## - `expected`: the required value.
## - `label`: the message reported on failure.
##
## ## Retorno
## Nothing; it panics through `spark.panic` on mismatch.
weave _expect_eq_string with actual as string, expected as string, label as string into void:
    if actual != expected:
        calling spark.panic with "scrolls test failed: {label}: {actual} != {expected}"
## Private test harness: boolean equality.
##
## ## Parámetros
## - `actual`: the observed value.
## - `expected`: the required value.
## - `label`: the message reported on failure.
##
## ## Retorno
## Nothing; it panics through `spark.panic` on mismatch.
weave _expect_eq_bool with actual as bool, expected as bool, label as string into void:
    if actual != expected:
        calling spark.panic with "scrolls test failed: {label}"

# --- Tests ---
# Private harness in `_expect*` (see `## Design notes`).

# Length and iteration
test "len counts bytes, also in UTF-8":
    var s as string is "café"
    calling _expect_eq_int with (calling s.len), 5, "len"
    calling _expect_eq_int with (calling len with "abc"), 3, "functional len"
test "is_empty distinguishes the empty string":
    var empty_s as string is ""
    calling _expect_eq_bool with (calling empty_s.is_empty), true, "is_empty"
    calling _expect_eq_bool with (calling is_empty with "x"), false, "functional is_empty"
test "chars returns a one-byte string per element":
    var s as string is "abc"
    var parts as list of string is calling s.chars
    defer banish parts
    calling _expect_eq_int with (parts length), 3, "chars"
    var letters as list of string is calling chars with s
    defer banish letters
    calling _expect_eq_string with (letters at 1), "b", "functional chars"
test "bytes returns the ASCII codes":
    var s as string is "AB"
    var codes as list of int is calling s.bytes
    defer banish codes
    calling _expect_eq_int with (codes at 0), 65, "bytes"
    var func_codes as list of int is calling bytes with s
    defer banish func_codes
    calling _expect_eq_int with (func_codes at 1), 66, "functional bytes"

# Search
test "contains finds and discards substrings":
    var s as string is "abc"
    calling _expect_eq_bool with (calling s.contains with "bc"), true, "contains"
    calling _expect_eq_bool with (calling contains with s, "z"), false, "functional contains"
test "starts_with accepts the empty prefix":
    var s as string is "abc"
    calling _expect_eq_bool with (calling s.starts_with with ""), true, "empty prefix"
    calling _expect_eq_bool with (calling starts_with with s, "bc"), false, "wrong prefix"
test "ends_with recognises suffixes":
    var s as string is "abc"
    calling _expect_eq_bool with (calling s.ends_with with "bc"), true, "ends_with"
    calling _expect_eq_bool with (calling ends_with with s, "abcd"), false, "long suffix"
test "index_of returns the first position":
    var s as string is "abracadabra"
    calling _expect_eq_int with (calling s.index_of with "cad"), 4, "index_of"
    calling _expect_eq_int with (calling index_of with s, ""), 0, "empty sub"
test "index_of returns -1 when it does not find":
    var s as string is "abc"
    calling _expect_eq_int with (calling s.index_of with "z"), -1, "absent"
    calling _expect_eq_int with (calling s.index_of with "abcd"), -1, "longer"
test "last_index_of returns the last position":
    var s as string is "abracadabra"
    calling _expect_eq_int with (calling s.last_index_of with "abra"), 7, "last_index_of"
    calling _expect_eq_int with (calling last_index_of with s, "z"), -1, "absent"
test "last_index_of with an empty sub returns the length":
    var s as string is "abc"
    calling _expect_eq_int with (calling s.last_index_of with ""), 3, "empty sub"
test "count counts non-overlapping occurrences":
    var s as string is "abracadabra"
    calling _expect_eq_int with (calling s.count with "a"), 5, "count"
    calling _expect_eq_int with (calling count with s, "abra"), 2, "functional count"
test "count ignores the empty sub and the longer sub":
    var s as string is "abc"
    calling _expect_eq_int with (calling s.count with ""), 0, "empty"
    var repeated as string is "aaaa"
    calling _expect_eq_int with (calling repeated.count with "aa"), 2, "non-overlapping"
test "find, rfind and count_matches still work":
    var s as string is "abracadabra"
    calling _expect_eq_int with (calling s.find with "cad"), 4, "find"
    calling _expect_eq_int with (calling s.rfind with "abra"), 7, "rfind"
    calling _expect_eq_int with (calling s.count_matches with "a"), 5, "count_matches"
test "functional query forms":
    calling _expect_eq_bool with (calling contains with "abc", "b"), true, "contains"
    calling _expect_eq_bool with (calling starts_with with "abc", "ab"), true, "starts_with"
    calling _expect_eq_bool with (calling ends_with with "abc", "bc"), true, "ends_with"
test "functional position and count forms":
    calling _expect_eq_int with (calling index_of with "abc", "c"), 2, "index_of"
    calling _expect_eq_int with (calling last_index_of with "abca", "a"), 3, "last_index_of"
    calling _expect_eq_int with (calling count_matches with "aaaa", "aa"), 2, "count_matches"

# Slicing
test "substring cuts the requested range":
    var s as string is "abcdef"
    var _lt_4352 as string is calling s.get_substring with 1, 4
    defer banish _lt_4352
    calling _expect_eq_string with _lt_4352, "bcd", "substring"
    var _ls_4359 as string is calling substring with s, 0, 0
    defer banish _ls_4359
    calling _expect_eq_string with _ls_4359, "", "empty range"
test "char_at returns one byte as a string":
    var s as string is "abc"
    var _lt_4356 as string is calling s.get_char_at with 1
    defer banish _lt_4356
    calling _expect_eq_string with _lt_4356, "b", "char_at"
    var _lt_4357 as string is calling char_at with s, 2
    defer banish _lt_4357
    calling _expect_eq_string with _lt_4357, "c", "functional char_at"
test "reverse flips the byte order":
    var s as string is "pengu"
    var _lt_4360 as string is calling s.get_reverse
    defer banish _lt_4360
    calling _expect_eq_string with _lt_4360, "ugnep", "reverse"
    var _lt_4361 as string is calling reverse with s
    defer banish _lt_4361
    calling _expect_eq_string with _lt_4361, "ugnep", "functional reverse"
test "reverse of the empty string is empty":
    var empty_s as string is ""
    var _ls_4378 as string is calling empty_s.get_reverse
    defer banish _ls_4378
    calling _expect_eq_string with _ls_4378, "", "empty reverse"

# Case
test "lower converts A-Z and leaves the rest alone":
    var s as string is "Hello, World!"
    var _lt_4369 as string is calling s.get_lower
    defer banish _lt_4369
    calling _expect_eq_string with _lt_4369, "hello, world!", "lower"
