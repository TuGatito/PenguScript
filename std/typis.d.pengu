# std/typis.d.pengu - The stb_truetype (TrueType font parsing and glyph rendering)
# Pure C-binding declaration file: every declaration maps 1:1 to the native
# stb_truetype C API. This file cannot contain implementation bodies (.d.pengu rule).
# Memory ownership follows the native library contract: read the upstream docs
# next to each declaration; release any returned handle with the library's own
# cleanup routine before dropping the last reference.
## PenguScript declaration binding generated by 'pengu bind'.
## Source header: typis.h
include "typis.h"

# -- Constants (#define) ------------------------------

const STBTT_MACSTYLE_DONTCARE as i64 is 0
const STBTT_MACSTYLE_BOLD as i64 is 1
const STBTT_MACSTYLE_ITALIC as i64 is 2
const STBTT_MACSTYLE_UNDERSCORE as i64 is 4
const STBTT_MACSTYLE_NONE as i64 is 8
const STBTT_MAX_OVERSAMPLE as i64 is 8
const STBTT_RASTERIZER_VERSION as i64 is 2
const STBTT_FIXSHIFT as i64 is 10

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

rune stbtt__buf:
  data as ref to byte
  cursor as int
  size as int

rune stbtt_bakedchar:
  x0 as u16
  y0 as u16
  x1 as u16
  y1 as u16
  xoff as f32
  yoff as f32
  xadvance as f32

rune stbtt_aligned_quad:
  x0 as f32
  y0 as f32
  s0 as f32
  t0 as f32
  x1 as f32
  y1 as f32
  s1 as f32
  t1 as f32

rune stbtt_packedchar:
  x0 as u16
  y0 as u16
  x1 as u16
  y1 as u16
  xoff as f32
  yoff as f32
  xadvance as f32
  xoff2 as f32
  yoff2 as f32

alias stbtt_pack_context as opaque

alias stbtt_fontinfo as opaque

alias stbrp_rect as opaque

rune stbtt_pack_range:
  font_size as f32
  first_unicode_codepoint_in_range as int
  array_of_unicode_codepoints as ref to int
  num_chars as int
  chardata_for_range as ref to stbtt_packedchar
  h_oversample as byte
  v_oversample as byte

rune stbtt_kerningentry:
  glyph1 as int
  glyph2 as int
  advance as int

rune stbtt_vertex:
  x as i16
  y as i16
  cx as i16
  cy as i16
  cx1 as i16
  cy1 as i16
  type as byte
  padding as byte

rune stbtt__bitmap:
  w as int
  h as int
  stride as int
  pixels as ref to byte

# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia stbtt_

declare BakeFontBitmap with data as ref to frozen byte, offset as int, pixel_height as f32, pixels as ref to byte, pw as int, ph as int, first_char as int, num_chars as int, chardata as ref to stbtt_bakedchar into int

declare GetBakedQuad with chardata as ref to frozen stbtt_bakedchar, pw as int, ph as int, char_index as int, xpos as ref to f32, ypos as ref to f32, q as ref to stbtt_aligned_quad, opengl_fillrule as int into void

# Call GetBakedQuad with char_index = 'character - first_char', and it
# creates the quad you need to draw and advances the current position.
#
# The coordinate system used assumes y increases downwards.
#
# Characters will extend both above and below the current position;
# see discussion of "BASELINE" above.
#
# It's inefficient; you might want to c&p it and optimize it.
declare GetScaledFontVMetrics with fontdata as ref to frozen byte, index as int, size as f32, ascent as ref to f32, descent as ref to f32, lineGap as ref to f32 into void

declare PackBegin with spc as ref to stbtt_pack_context, pixels as ref to byte, width as int, height as int, stride_in_bytes as int, padding as int, alloc_context as ref to void into int

# Initializes a packing context stored in the passed-in stbtt_pack_context.
# Future calls using this context will pack characters into the bitmap passed
# in here: a 1-channel bitmap that is width * height. stride_in_bytes is
# the distance from one row to the next (or 0 to mean they are packed tightly
# together). "padding" is the amount of padding to leave between each
# character (normally you want '1' for bitmaps you'll use as textures with
# bilinear filtering).
#
# Returns 0 on failure, 1 on success.
declare PackEnd with spc as ref to stbtt_pack_context into void

declare PackFontRange with spc as ref to stbtt_pack_context, fontdata as ref to frozen byte, font_index as int, font_size as f32, first_unicode_char_in_range as int, num_chars_in_range as int, chardata_for_range as ref to stbtt_packedchar into int

declare PackFontRanges with spc as ref to stbtt_pack_context, fontdata as ref to frozen byte, font_index as int, ranges as ref to stbtt_pack_range, num_ranges as int into int

# Creates character bitmaps from multiple ranges of characters stored in
# ranges. This will usually create a better-packed bitmap than multiple
# calls to stbtt_PackFontRange. Note that you can call this multiple
# times within a single PackBegin/PackEnd.
declare PackSetOversampling with spc as ref to stbtt_pack_context, h_oversample as u32, v_oversample as u32 into void

# Oversampling a font increases the quality by allowing higher-quality subpixel
# positioning, and is especially valuable at smaller text sizes.
#
# This function sets the amount of oversampling for all following calls to
# stbtt_PackFontRange(s) or stbtt_PackFontRangesGatherRects for a given
# pack context. The default (no oversampling) is achieved by h_oversample=1
# and v_oversample=1. The total number of pixels required is
# h_oversample*v_oversample larger than the default; for example, 2x2
# oversampling requires 4x the storage of 1x1. For best results, render
# oversampled textures with bilinear filtering. Look at the readme in
# stb/tests/oversample for information about oversampled fonts
#
# To use with PackFontRangesGather etc., you must set it before calls
# call to PackFontRangesGatherRects.
declare PackSetSkipMissingCodepoints with spc as ref to stbtt_pack_context, skip as int into void

# If skip != 0, this tells stb_truetype to skip any codepoints for which
# there is no corresponding glyph. If skip=0, which is the default, then
# codepoints without a glyph recived the font's "missing character" glyph,
# typically an empty box by convention.
declare GetPackedQuad with chardata as ref to frozen stbtt_packedchar, pw as int, ph as int, char_index as int, xpos as ref to f32, ypos as ref to f32, q as ref to stbtt_aligned_quad, align_to_integer as int into void

declare PackFontRangesGatherRects with spc as ref to stbtt_pack_context, info as ref to frozen stbtt_fontinfo, ranges as ref to stbtt_pack_range, num_ranges as int, rects as ref to stbrp_rect into int

declare PackFontRangesPackRects with spc as ref to stbtt_pack_context, rects as ref to stbrp_rect, num_rects as int into void

declare PackFontRangesRenderIntoRects with spc as ref to stbtt_pack_context, info as ref to frozen stbtt_fontinfo, ranges as ref to stbtt_pack_range, num_ranges as int, rects as ref to stbrp_rect into int

# FONT LOADING
declare GetNumberOfFonts with data as ref to frozen byte into int

# This function will determine the number of fonts in a font file.  TrueType
# collection (.ttc) files may contain multiple fonts, while TrueType font
# (.ttf) files only contain one font. The number of fonts can be used for
# indexing with the previous function where the index is between zero and one
# less than the total fonts. If an error occurs, -1 is returned.
declare GetFontOffsetForIndex with data as ref to frozen byte, index as int into int

declare InitFont with info as ref to stbtt_fontinfo, data as ref to frozen byte, offset as int into int

# CHARACTER TO GLYPH-INDEX CONVERSIOn
declare FindGlyphIndex with info as ref to frozen stbtt_fontinfo, unicode_codepoint as int into int

# CHARACTER PROPERTIES
declare ScaleForPixelHeight with info as ref to frozen stbtt_fontinfo, pixels as f32 into f32

# computes a scale factor to produce a font whose "height" is 'pixels' tall.
# Height is measured as the distance from the highest ascender to the lowest
# descender; in other words, it's equivalent to calling stbtt_GetFontVMetrics
# and computing:
# scale = pixels / (ascent - descent)
# so if you prefer to measure height by the ascent only, use a similar calculation.
declare ScaleForMappingEmToPixels with info as ref to frozen stbtt_fontinfo, pixels as f32 into f32

# computes a scale factor to produce a font whose EM size is mapped to
# 'pixels' tall. This is probably what traditional APIs compute, but
# I'm not positive.
declare GetFontVMetrics with info as ref to frozen stbtt_fontinfo, ascent as ref to int, descent as ref to int, lineGap as ref to int into void

# ascent is the coordinate above the baseline the font extends; descent
# is the coordinate below the baseline the font extends (i.e. it is typically negative)
# lineGap is the spacing between one row's descent and the next row's ascent...
# so you should advance the vertical position by "*ascent - *descent + *lineGap"
# these are expressed in unscaled coordinates, so you must multiply by
# the scale factor for a given size
declare GetFontVMetricsOS2 with info as ref to frozen stbtt_fontinfo, typoAscent as ref to int, typoDescent as ref to int, typoLineGap as ref to int into int

# analogous to GetFontVMetrics, but returns the "typographic" values from the OS/2
# table (specific to MS/Windows TTF files).
#
# Returns 1 on success (table present), 0 on failure.
declare GetFontBoundingBox with info as ref to frozen stbtt_fontinfo, x0 as ref to int, y0 as ref to int, x1 as ref to int, y1 as ref to int into void

# the bounding box around all possible characters
declare GetCodepointHMetrics with info as ref to frozen stbtt_fontinfo, codepoint as int, advanceWidth as ref to int, leftSideBearing as ref to int into void

# leftSideBearing is the offset from the current horizontal position to the left edge of the character
# advanceWidth is the offset from the current horizontal position to the next horizontal position
# these are expressed in unscaled coordinates
declare GetCodepointKernAdvance with info as ref to frozen stbtt_fontinfo, ch1 as int, ch2 as int into int

# an additional amount to add to the 'advance' value between ch1 and ch2
declare GetCodepointBox with info as ref to frozen stbtt_fontinfo, codepoint as int, x0 as ref to int, y0 as ref to int, x1 as ref to int, y1 as ref to int into int

# Gets the bounding box of the visible part of the glyph, in unscaled coordinates
declare GetGlyphHMetrics with info as ref to frozen stbtt_fontinfo, glyph_index as int, advanceWidth as ref to int, leftSideBearing as ref to int into void

declare GetGlyphKernAdvance with info as ref to frozen stbtt_fontinfo, glyph1 as int, glyph2 as int into int

declare GetGlyphBox with info as ref to frozen stbtt_fontinfo, glyph_index as int, x0 as ref to int, y0 as ref to int, x1 as ref to int, y1 as ref to int into int

declare GetKerningTableLength with info as ref to frozen stbtt_fontinfo into int

declare GetKerningTable with info as ref to frozen stbtt_fontinfo, table as ref to stbtt_kerningentry, table_length as int into int

declare IsGlyphEmpty with info as ref to frozen stbtt_fontinfo, glyph_index as int into int

# returns non-zero if nothing is drawn for this glyph
declare GetCodepointShape with info as ref to frozen stbtt_fontinfo, unicode_codepoint as int, vertices as ref to ref to stbtt_vertex into int

declare GetGlyphShape with info as ref to frozen stbtt_fontinfo, glyph_index as int, vertices as ref to ref to stbtt_vertex into int

# returns # of vertices and fills *vertices with the pointer to them
# these are expressed in "unscaled" coordinates
#
# The shape is a series of contours. Each one starts with
# a STBTT_moveto, then consists of a series of mixed
# STBTT_lineto and STBTT_curveto segments. A lineto
# draws a line from previous endpoint to its x,y; a curveto
# draws a quadratic bezier from previous endpoint to
# its x,y, using cx,cy as the bezier control point.
declare FreeShape with info as ref to frozen stbtt_fontinfo, vertices as ref to stbtt_vertex into void

# frees the data allocated above
declare FindSVGDoc with info as ref to frozen stbtt_fontinfo, gl as int into ref to byte

declare GetCodepointSVG with info as ref to frozen stbtt_fontinfo, unicode_codepoint as int, svg as ref to ref to frozen char into int

declare GetGlyphSVG with info as ref to frozen stbtt_fontinfo, gl as int, svg as ref to ref to frozen char into int

# BITMAP RENDERING
declare FreeBitmap with bitmap as ref to byte, userdata as ref to void into void

# frees the bitmap allocated below
declare GetCodepointBitmap with info as ref to frozen stbtt_fontinfo, scale_x as f32, scale_y as f32, codepoint as int, width as ref to int, height as ref to int, xoff as ref to int, yoff as ref to int into ref to byte

# allocates a large-enough single-channel 8bpp bitmap and renders the
# specified character/glyph at the specified scale into it, with
# antialiasing. 0 is no coverage (transparent), 255 is fully covered (opaque).
# *width & *height are filled out with the width & height of the bitmap,
# which is stored left-to-right, top-to-bottom.
#
# xoff/yoff are the offset it pixel space from the glyph origin to the top-left of the bitmap
declare GetCodepointBitmapSubpixel with info as ref to frozen stbtt_fontinfo, scale_x as f32, scale_y as f32, shift_x as f32, shift_y as f32, codepoint as int, width as ref to int, height as ref to int, xoff as ref to int, yoff as ref to int into ref to byte

# the same as stbtt_GetCodepoitnBitmap, but you can specify a subpixel
# shift for the character
declare MakeCodepointBitmap with info as ref to frozen stbtt_fontinfo, output as ref to byte, out_w as int, out_h as int, out_stride as int, scale_x as f32, scale_y as f32, codepoint as int into void

# the same as stbtt_GetCodepointBitmap, but you pass in storage for the bitmap
# in the form of 'output', with row spacing of 'out_stride' bytes. the bitmap
# is clipped to out_w/out_h bytes. Call stbtt_GetCodepointBitmapBox to get the
# width and height and positioning info for it first.
declare MakeCodepointBitmapSubpixel with info as ref to frozen stbtt_fontinfo, output as ref to byte, out_w as int, out_h as int, out_stride as int, scale_x as f32, scale_y as f32, shift_x as f32, shift_y as f32, codepoint as int into void

# same as stbtt_MakeCodepointBitmap, but you can specify a subpixel
# shift for the character
declare MakeCodepointBitmapSubpixelPrefilter with info as ref to frozen stbtt_fontinfo, output as ref to byte, out_w as int, out_h as int, out_stride as int, scale_x as f32, scale_y as f32, shift_x as f32, shift_y as f32, oversample_x as int, oversample_y as int, sub_x as ref to f32, sub_y as ref to f32, codepoint as int into void

# same as stbtt_MakeCodepointBitmapSubpixel, but prefiltering
# is performed (see stbtt_PackSetOversampling)
declare GetCodepointBitmapBox with font as ref to frozen stbtt_fontinfo, codepoint as int, scale_x as f32, scale_y as f32, ix0 as ref to int, iy0 as ref to int, ix1 as ref to int, iy1 as ref to int into void

# get the bbox of the bitmap centered around the glyph origin; so the
# bitmap width is ix1-ix0, height is iy1-iy0, and location to place
# the bitmap top left is (leftSideBearing*scale,iy0).
# (Note that the bitmap uses y-increases-down, but the shape uses
# y-increases-up, so CodepointBitmapBox and CodepointBox are inverted.)
declare GetCodepointBitmapBoxSubpixel with font as ref to frozen stbtt_fontinfo, codepoint as int, scale_x as f32, scale_y as f32, shift_x as f32, shift_y as f32, ix0 as ref to int, iy0 as ref to int, ix1 as ref to int, iy1 as ref to int into void

# the following functions are equivalent to the above functions, but operate
# on glyph indices instead of Unicode codepoints (for efficiency)
declare GetGlyphBitmap with info as ref to frozen stbtt_fontinfo, scale_x as f32, scale_y as f32, glyph as int, width as ref to int, height as ref to int, xoff as ref to int, yoff as ref to int into ref to byte

declare GetGlyphBitmapSubpixel with info as ref to frozen stbtt_fontinfo, scale_x as f32, scale_y as f32, shift_x as f32, shift_y as f32, glyph as int, width as ref to int, height as ref to int, xoff as ref to int, yoff as ref to int into ref to byte

declare MakeGlyphBitmap with info as ref to frozen stbtt_fontinfo, output as ref to byte, out_w as int, out_h as int, out_stride as int, scale_x as f32, scale_y as f32, glyph as int into void

declare MakeGlyphBitmapSubpixel with info as ref to frozen stbtt_fontinfo, output as ref to byte, out_w as int, out_h as int, out_stride as int, scale_x as f32, scale_y as f32, shift_x as f32, shift_y as f32, glyph as int into void

declare MakeGlyphBitmapSubpixelPrefilter with info as ref to frozen stbtt_fontinfo, output as ref to byte, out_w as int, out_h as int, out_stride as int, scale_x as f32, scale_y as f32, shift_x as f32, shift_y as f32, oversample_x as int, oversample_y as int, sub_x as ref to f32, sub_y as ref to f32, glyph as int into void

declare GetGlyphBitmapBox with font as ref to frozen stbtt_fontinfo, glyph as int, scale_x as f32, scale_y as f32, ix0 as ref to int, iy0 as ref to int, ix1 as ref to int, iy1 as ref to int into void

declare GetGlyphBitmapBoxSubpixel with font as ref to frozen stbtt_fontinfo, glyph as int, scale_x as f32, scale_y as f32, shift_x as f32, shift_y as f32, ix0 as ref to int, iy0 as ref to int, ix1 as ref to int, iy1 as ref to int into void

# rasterize a shape with quadratic beziers into a bitmap
declare Rasterize with result as ref to stbtt__bitmap, flatness_in_pixels as f32, vertices as ref to stbtt_vertex, num_verts as int, scale_x as f32, scale_y as f32, shift_x as f32, shift_y as f32, x_off as int, y_off as int, invert as int, userdata as ref to void into void

# Signed Distance Function (or Field) rendering
declare FreeSDF with bitmap as ref to byte, userdata as ref to void into void

# frees the SDF bitmap allocated below
declare GetGlyphSDF with info as ref to frozen stbtt_fontinfo, scale as f32, glyph as int, padding as int, onedge_value as byte, pixel_dist_scale as f32, width as ref to int, height as ref to int, xoff as ref to int, yoff as ref to int into ref to byte

declare GetCodepointSDF with info as ref to frozen stbtt_fontinfo, scale as f32, codepoint as int, padding as int, onedge_value as byte, pixel_dist_scale as f32, width as ref to int, height as ref to int, xoff as ref to int, yoff as ref to int into ref to byte

# Finding the right font...
#
# You should really just solve this offline, keep your own tables
# of what font is what, and don't try to get it out of the .ttf file.
# That's because getting it out of the .ttf file is really hard, because
# the names in the file can appear in many possible encodings, in many
# possible languages, and e.g. if you need a case-insensitive comparison,
# the details of that depend on the encoding & language in a complex way
# (actually underspecified in truetype, but also gigantic).
#
# But you can use the provided functions in two possible ways:
# stbtt_FindMatchingFont() will use *case-sensitive* comparisons on
# unicode-encoded names to try to find the font you want;
# you can run this before calling stbtt_InitFont()
#
# stbtt_GetFontNameString() lets you get any of the various strings
# from the file yourself and do your own comparisons on them.
# You have to have called stbtt_InitFont() first.
declare FindMatchingFont with fontdata as ref to frozen byte, name as ref to frozen char, flags as int into int

declare CompareUTF8toUTF16_bigendian with s1 as ref to frozen char, len1 as int, s2 as ref to frozen char, len2 as int into int

# returns 1/0 whether the first string interpreted as utf8 is identical to
# the second string interpreted as big-endian utf16... useful for strings from next func
declare GetFontNameString with font as ref to frozen stbtt_fontinfo, length as ref to int, platformID as int, encodingID as int, languageID as int, nameID as int into ref to frozen char
