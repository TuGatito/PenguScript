-- std/terminus.pengu — terminal: estilos ANSI y utilidades.
--
-- S9. Los estilos son cadenas de escape, así que no necesitan runtime.
scroll terminus
    foreign "pengu"
        terminus_clear_screen = () -> Unit
        terminus_move_cursor = (row: Usize, column: Usize) -> Unit
        terminus_hide_cursor = () -> Unit
        terminus_show_cursor = () -> Unit
        terminus_cursor_up = (lines: Usize) -> Unit
        terminus_cursor_down = (lines: Usize) -> Unit
        terminus_cursor_left = (columns: Usize) -> Unit
        terminus_cursor_right = (columns: Usize) -> Unit
        terminus_progress_bar = (done: Usize, total: Usize, width: Usize) -> String
        terminus_read_key = () -> Option[Char]
        terminus_is_terminal = () -> Bool
        terminus_width = () -> Usize
        terminus_supports_color = () -> Bool
        terminus_rgb = (text: Str, r: U8, g: U8, b: U8) -> String

    unveil sigil RESET: Str = "\u{1b}[0m"
    unveil sigil BOLD: Str = "\u{1b}[1m"
    unveil sigil DIM: Str = "\u{1b}[2m"
    unveil sigil ITALIC: Str = "\u{1b}[3m"
    unveil sigil UNDERLINE: Str = "\u{1b}[4m"
    unveil sigil BLINK: Str = "\u{1b}[5m"
    unveil sigil REVERSE: Str = "\u{1b}[7m"
    unveil sigil HIDDEN: Str = "\u{1b}[8m"
    unveil sigil STRIKETHROUGH: Str = "\u{1b}[9m"

    unveil sigil BLACK: Str = "\u{1b}[30m"
    unveil sigil RED: Str = "\u{1b}[31m"
    unveil sigil GREEN: Str = "\u{1b}[32m"
    unveil sigil YELLOW: Str = "\u{1b}[33m"
    unveil sigil BLUE: Str = "\u{1b}[34m"
    unveil sigil MAGENTA: Str = "\u{1b}[35m"
    unveil sigil CYAN: Str = "\u{1b}[36m"
    unveil sigil WHITE: Str = "\u{1b}[37m"
    unveil sigil BRIGHT_BLACK: Str = "\u{1b}[90m"
    unveil sigil BRIGHT_RED: Str = "\u{1b}[91m"
    unveil sigil BRIGHT_GREEN: Str = "\u{1b}[92m"
    unveil sigil BRIGHT_YELLOW: Str = "\u{1b}[93m"
    unveil sigil BRIGHT_BLUE: Str = "\u{1b}[94m"
    unveil sigil BRIGHT_MAGENTA: Str = "\u{1b}[95m"
    unveil sigil BRIGHT_CYAN: Str = "\u{1b}[96m"
    unveil sigil BRIGHT_WHITE: Str = "\u{1b}[97m"

    -- Estilos compuestos (los más usados).
    unveil style = (text: &Str, code: &Str) -> String
        format("#{code}#{text}#{RESET}")

    unveil red = (text: &Str) -> String
        style(text, RED)

    unveil green = (text: &Str) -> String
        style(text, GREEN)

    unveil yellow = (text: &Str) -> String
        style(text, YELLOW)

    unveil blue = (text: &Str) -> String
        style(text, BLUE)

    unveil magenta = (text: &Str) -> String
        style(text, MAGENTA)

    unveil cyan = (text: &Str) -> String
        style(text, CYAN)

    unveil white = (text: &Str) -> String
        style(text, WHITE)

    unveil dim = (text: &Str) -> String
        style(text, DIM)

    unveil bold = (text: &Str) -> String
        style(text, BOLD)

    unveil underline = (text: &Str) -> String
        style(text, UNDERLINE)

    unveil rgb = (text: &Str, r: U8, g: U8, b: U8) -> String
        terminus_rgb(text, r, g, b)

    unveil is_terminal = () -> Bool
        terminus_is_terminal()

    unveil width = () -> Usize
        terminus_width()

    unveil supports_color = () -> Bool
        terminus_supports_color()

    -- Control de pantalla y cursor (secuencias ANSI).
    unveil clear_screen = () -> Unit
        terminus_clear_screen()

    unveil move_cursor = (row: Usize, column: Usize) -> Unit
        terminus_move_cursor(row, column)

    unveil hide_cursor = () -> Unit
        terminus_hide_cursor()

    unveil show_cursor = () -> Unit
        terminus_show_cursor()

    unveil cursor_up = (lines: Usize) -> Unit
        terminus_cursor_up(lines)

    unveil cursor_down = (lines: Usize) -> Unit
        terminus_cursor_down(lines)

    unveil cursor_left = (columns: Usize) -> Unit
        terminus_cursor_left(columns)

    unveil cursor_right = (columns: Usize) -> Unit
        terminus_cursor_right(columns)

    -- Barra de progreso: `[####----]  42%`.
    unveil progress_bar = (done: Usize, total: Usize, width: Usize) -> String
        terminus_progress_bar(done, total, width)

    -- Lee una tecla. Sin modo crudo hace falta pulsar Intro (ver N63).
    unveil read_key = () -> Option[Char]
        terminus_read_key()
