  moveTo = (x: double, y: double) -> void
  open = (url: any?, target: string?, features: string?) -> any?
  postMessage = (message: any, targetOrigin: string, transfer: any<any>?) -> void
  print = () -> void
  prompt = (message: string?, _default: string?) -> string?
  releaseEvents = () -> void
  requestIdleCallback = (callback_: any, options: js::IdleRequestOptions?) -> double
  resizeBy = (x: double, y: double) -> void
  resizeTo = (width: int, height: int) -> void
  scroll = (options: js::ScrollToOptions?) -> void
  scrollBy = (options: js::ScrollToOptions?) -> void
  scrollTo = (options: js::ScrollToOptions?) -> void
  stop = () -> void
  toString = () -> string
  dispatchEvent = (event: js::Event) -> bool
  cancelAnimationFrame = (handle: double) -> void
  requestAnimationFrame = (callback_: any) -> double
  atob = (data: string) -> string
  btoa = (data: string) -> string
  clearInterval = (id: double?) -> void
  clearTimeout = (id: double?) -> void
  createImageBitmap = (image: any, options: js::ImageBitmapOptions?) -> any<js::ImageBitmap>
  fetch = (input: any, init: js::RequestInit?) -> any<js::Response>
  queueMicrotask = (callback_: any) -> void
  reportError = (e: any) -> void
  setInterval = (handler: any, timeout: double?, ...arguments: any) -> double
  setTimeout = (handler: any, timeout: double?, ...arguments: any) -> double
  structuredClone = (value: any, options: js::StructuredSerializeOptions?) -> any
  addEventListener = (type: any, listener: function<(js::Window, any) -> any>, options: any?) -> void
  removeEventListener = (type: any, listener: function<(js::Window, any) -> any>, options: any?) -> void
