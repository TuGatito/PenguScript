# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia Gui

# Global gui state control functions
declare Enable into void

declare Disable into void

declare Lock into void

declare Unlock into void

declare IsLocked into bool

declare SetAlpha with alpha as f32 into void

declare SetState with state as int into void

declare GetState into int

# Font set/get functions
declare SetFont with font as Font into void

declare GetFont into Font

# Style set/get functions
declare SetStyle with control as int, property as int, value as int into void

declare GetStyle with control as int, property as int into int

# Styles loading functions
declare LoadStyle with fileName as ref to frozen char into void

declare LoadStyleFromMemory with fileData as ref to frozen byte, dataSize as int into void

declare LoadStyleDefault into void

# Tooltips management functions
declare EnableTooltip into void

declare DisableTooltip into void

declare SetTooltip with tooltip as ref to frozen char into void

# Icons functionality
declare IconText with iconId as int, text as ref to frozen char into ref to frozen char

declare SetIconScale with scale as int into void

declare GetIcons into ref to u32

declare LoadIcons with fileName as ref to frozen char, loadIconsName as bool into ref to ref to char

declare LoadIconsFromMemory with fileData as ref to frozen byte, dataSize as int, loadIconsName as bool into ref to ref to char

declare DrawIcon with iconId as int, posX as int, posY as int, pixelSize as int, color as Color into void

# Utility functions
declare GetTextWidth with text as ref to frozen char into int

# Controls
# ----------------------------------------------------------------------------------------------------------
# Container/separator controls, useful for controls organization
declare WindowBox with bounds as Rectangle, title as ref to frozen char into int

declare GroupBox with bounds as Rectangle, text as ref to frozen char into int

declare Line with bounds as Rectangle, text as ref to frozen char into int

declare Panel with bounds as Rectangle, text as ref to frozen char into int

declare ScrollPanel with bounds as Rectangle, text as ref to frozen char, content as Rectangle, scroll as ref to Vector2, view as ref to Rectangle into int

# Basic controls set
declare Label with bounds as Rectangle, text as ref to frozen char into int

declare Button with bounds as Rectangle, text as ref to frozen char into int

declare LabelButton with bounds as Rectangle, text as ref to frozen char into int

declare Toggle with bounds as Rectangle, text as ref to frozen char, active as ref to bool into int

declare ToggleGroup with bounds as Rectangle, text as ref to frozen char, active as ref to int into int

declare ToggleSlider with bounds as Rectangle, text as ref to frozen char, active as ref to int into int

declare CheckBox with bounds as Rectangle, text as ref to frozen char, checked as ref to bool into int

declare ComboBox with bounds as Rectangle, text as ref to frozen char, active as ref to int into int

declare DropdownBox with bounds as Rectangle, text as ref to frozen char, active as ref to int, editMode as bool into int

declare Spinner with bounds as Rectangle, text as ref to frozen char, value as ref to int, minValue as int, maxValue as int, editMode as bool into int

declare ValueBox with bounds as Rectangle, text as ref to frozen char, value as ref to int, minValue as int, maxValue as int, editMode as bool into int

declare ValueBoxFloat with bounds as Rectangle, text as ref to frozen char, textValue as ref to char, value as ref to f32, editMode as bool into int

declare TextBox with bounds as Rectangle, text as ref to char, textSize as int, editMode as bool into int

declare Slider with bounds as Rectangle, textLeft as ref to frozen char, textRight as ref to frozen char, value as ref to f32, minValue as f32, maxValue as f32 into int

declare SliderBar with bounds as Rectangle, textLeft as ref to frozen char, textRight as ref to frozen char, value as ref to f32, minValue as f32, maxValue as f32 into int

declare ProgressBar with bounds as Rectangle, textLeft as ref to frozen char, textRight as ref to frozen char, value as ref to f32, minValue as f32, maxValue as f32 into int

declare StatusBar with bounds as Rectangle, text as ref to frozen char into int

declare DummyRec with bounds as Rectangle, text as ref to frozen char into int

declare Grid with bounds as Rectangle, text as ref to frozen char, spacing as f32, subdivs as int, mouseCell as ref to Vector2 into int

# Advance controls set
declare ListView with bounds as Rectangle, text as ref to frozen char, scrollIndex as ref to int, active as ref to int into int

declare ListViewEx with bounds as Rectangle, text as ref to ref to char, count as int, scrollIndex as ref to int, active as ref to int, focus as ref to int into int

declare TabBar with bounds as Rectangle, text as ref to frozen char, hscroll as ref to int, active as ref to int into int

declare TabBarEx with bounds as Rectangle, text as ref to ref to char, count as int, hscroll as ref to int, active as ref to int, focus as ref to int into int

declare MessageBox with bounds as Rectangle, title as ref to frozen char, message as ref to frozen char, btnText as ref to frozen char, btnActive as ref to int into int

declare TextInputBox with bounds as Rectangle, title as ref to frozen char, message as ref to frozen char, text as ref to char, textSize as int, btnText as ref to frozen char, btnActive as ref to int, secretViewActive as ref to bool into int

declare ColorPicker with bounds as Rectangle, text as ref to frozen char, color as ref to Color into int

declare ColorPanel with bounds as Rectangle, text as ref to frozen char, color as ref to Color into int

declare ColorBarAlpha with bounds as Rectangle, text as ref to frozen char, alpha as ref to f32 into int

declare ColorBarHue with bounds as Rectangle, text as ref to frozen char, value as ref to f32 into int

declare ColorPickerHSV with bounds as Rectangle, text as ref to frozen char, colorHsv as ref to Vector3 into int

declare ColorPanelHSV with bounds as Rectangle, text as ref to frozen char, colorHsv as ref to Vector3 into int
