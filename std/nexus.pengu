-- std/nexus.pengu — cadenas de C sin punteros.
--
-- S6. `CString` (propiedad) y `CStr` (vista) son tipos integrados del lenguaje
-- y el backend los mapea a `std::ffi::CString` / `std::ffi::CStr`. En v1 no hay
-- punteros crudos ni `unsafe` en la superficie, así que `from_raw`/`into_raw`/
-- `as_ptr` quedan fuera por diseño (N38 en scratch/LIMITATIONS_AUDIT.md). Este
-- módulo ofrece toda la superficie segura: construir una `CString` validando
-- que no haya NUL intermedios, verla como `CStr` sin copiar y convertirla de
-- vuelta a texto (validando UTF-8 o de forma lossy).
--
-- Llamar a C se hace declarando `foreign "C"` y ejecutando la llamada dentro
-- de un bloque `curse` (docs/LANGUAGE.md §16).
scroll nexus
    foreign "pengu"
        nexus_cstring_new = (text: &Str) -> Option[CString]
        nexus_cstring_from_bytes = (bytes: Vec[U8]) -> Option[CString]
        nexus_cstring_into_string = (value: CString) -> Option[String]
        nexus_cstring_as_bytes = (value: &CString) -> Vec[U8]
        nexus_cstring_len = (value: &CString) -> Usize
        nexus_cstring_to_str = (value: &CString) -> Option[String]
        nexus_cstring_to_string_lossy = (value: &CString) -> String
        nexus_cstring_clone = (value: &CString) -> CString
        nexus_cstring_as_c_str = (value: &CString) -> CStr
        nexus_cstr_to_str = (value: &CStr) -> Option[String]
        nexus_cstr_to_string_lossy = (value: &CStr) -> String
        nexus_cstr_as_bytes = (value: &CStr) -> Vec[U8]
        nexus_cstr_len = (value: &CStr) -> Usize
        nexus_cstr_equals_str = (value: &CStr, text: &Str) -> Bool
        nexus_cstr_to_cstring = (value: &CStr) -> CString

    -- `CString`: cadena propia, termina en NUL y no contiene NUL intermedios.

    unveil cstring_new = (text: &Str) -> Option[CString]
        nexus_cstring_new(text)

    unveil cstring_from_bytes = (bytes: Vec[U8]) -> Option[CString]
        nexus_cstring_from_bytes(bytes)

    unveil cstring_into_string = (value: CString) -> Option[String]
        nexus_cstring_into_string(value)

    -- Copia a `String` validando UTF-8.
    unveil cstring_to_str = (value: &CString) -> Option[String]
        nexus_cstring_to_str(value)

    -- Copia a `String` sustituyendo el UTF-8 invalido por U+FFFD.
    unveil cstring_to_string_lossy = (value: &CString) -> String
        nexus_cstring_to_string_lossy(value)

    -- Bytes sin el NUL final.
    unveil cstring_as_bytes = (value: &CString) -> Vec[U8]
        nexus_cstring_as_bytes(value)

    unveil cstring_len = (value: &CString) -> Usize
        nexus_cstring_len(value)

    unveil cstring_is_empty = (value: &CString) -> Bool
        nexus_cstring_len(value) == 0_usize

    unveil cstring_clone = (value: &CString) -> CString
        nexus_cstring_clone(value)

    -- Vista prestada, sin copiar: lo que consume una funcion `foreign "C"`.
    unveil cstring_as_c_str = (value: &CString) -> CStr
        nexus_cstring_as_c_str(value)

    -- `CStr`: vista prestada de una cadena terminada en NUL.

    -- Copia a `String` validando UTF-8.
    unveil cstr_to_str = (value: &CStr) -> Option[String]
        nexus_cstr_to_str(value)

    unveil cstr_to_string_lossy = (value: &CStr) -> String
        nexus_cstr_to_string_lossy(value)

    -- Bytes sin el NUL final.
    unveil cstr_as_bytes = (value: &CStr) -> Vec[U8]
        nexus_cstr_as_bytes(value)

    unveil cstr_len = (value: &CStr) -> Usize
        nexus_cstr_len(value)

    unveil cstr_is_empty = (value: &CStr) -> Bool
        nexus_cstr_len(value) == 0_usize

    -- Compara la vista con un `Str` sin asignar memoria.
    unveil cstr_equals_str = (value: &CStr, text: &Str) -> Bool
        nexus_cstr_equals_str(value, text)

    -- Copia la vista a una cadena propia.
    unveil cstr_to_cstring = (value: &CStr) -> CString
        nexus_cstr_to_cstring(value)
