-- std/libra.pengu — TOML de configuración.
--
-- S8b. En vez de un árbol recursivo (que `iason` ya ocupa y los módulos de
-- `std` no pueden compartir, N42), se aplana el documento: cada hoja queda
-- como `clave.punteada -> texto` con su tipo. Sirve para leer configuración;
-- las tablas anidadas se aplanan con claves punteadas y los arrays se guardan
-- como texto separado por comas.
scroll libra
    unveil rune LibraError
        unveil message: String
        unveil line: Int

    unveil rune Table
        unveil keys: Vec[String]
        unveil values: Vec[String]
        unveil kinds: Vec[String]

    unveil ritual LibraError for Show
        show = (@) -> String
            format("LibraError(línea #{@.line}: #{@.message})")

    unveil ritual Table for Show
        show = (@) -> String
            format("Table(#{@.keys.len()} claves)")

    foreign "pengu"
        libra_parse = (text: Str) -> Result[Table, LibraError]
        libra_parse_file = (path: Str) -> Result[Table, LibraError]
        libra_get = (table: &Table, key: Str) -> Option[String]
        libra_get_array = (table: &Table, key: Str) -> Option[Vec[String]]
        libra_get_int = (table: &Table, key: Str) -> Option[Int]
        libra_get_float = (table: &Table, key: Str) -> Option[Float]
        libra_get_bool = (table: &Table, key: Str) -> Option[Bool]
        libra_has = (table: &Table, key: Str) -> Bool
        libra_kind_of = (table: &Table, key: Str) -> Option[String]
        libra_keys_of = (table: &Table, prefix: Str) -> Vec[String]

    unveil parse = (text: &Str) -> Result[Table, LibraError]
        libra_parse(text)

    unveil parse_file = (path: &Str) -> Result[Table, LibraError]
        libra_parse_file(path)

    unveil ritual Table
        get = (@, key: &Str) -> Option[String]
            libra_get(@, key)

        get_array = (@, key: &Str) -> Option[Vec[String]]
            libra_get_array(@, key)

        get_int = (@, key: &Str) -> Option[Int]
            libra_get_int(@, key)

        get_float = (@, key: &Str) -> Option[Float]
            libra_get_float(@, key)

        get_bool = (@, key: &Str) -> Option[Bool]
            libra_get_bool(@, key)

        has = (@, key: &Str) -> Bool
            libra_has(@, key)

        kind_of = (@, key: &Str) -> Option[String]
            libra_kind_of(@, key)

        keys_of = (@, prefix: &Str) -> Vec[String]
            libra_keys_of(@, prefix)

        len = (@) -> Usize
            @.keys.len()
