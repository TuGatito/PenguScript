# std/compass.pengu - The Compass (Path Manipulation)
# File-path manipulation implemented in pure PenguScript.
#
# High-level path logic (separator detection, basename/dirname, extension
# handling, normalization, joining, relative paths) lives here in PenguScript.
# The former C implementations (pengu_c_path_*) were removed from the runtime
# header; nothing below calls the C runtime for path work.
#
# Internal helpers use the 'cp_' prefix so they never collide with the
# enchanting Path methods or module-level member names in the code generator's
# function registry.
#
# Usage: import std.compass. Call module members directly, e.g. joining parts
# with "calling compass.join with parts" and normalizing with
# "calling compass.normalize with path", or build an owned Path value with
# "calling compass.path with raw" and query it through methods such as
# "calling p.name" and "calling p.with_suffix with ext".
# Ownership: every function below takes plain strings and returns new owned
# strings, lists or maybe values; Path owns its raw path string, so results
# can be banished or dropped normally. Nothing here borrows or aliases input
# memory.

# ----------------------------------------------------------------------------
# Internal helpers (cp_*)
# ----------------------------------------------------------------------------

# Compile-time platform flag: baked from the target 'os' variable.
weave cp_win into bool:
    when os == "windows":
        return true
    else:
        return false

# True when c is a path separator: "/" or a backslash (both accepted on every
# platform).
weave cp_is_sep with c as string into bool:
    if c == "/":
        return true
    if c == "\\":
        return true
    return false

# True when c is an ASCII letter (A-Z or a-z); used to detect Windows drive
# letters.
weave cp_is_letter with c as string into bool:
    var code as int is ord c
    if code >= 65:
        if code <= 90:
            return true
    if code >= 97:
        if code <= 122:
            return true
    return false

# Preferred separator for this platform: a backslash on Windows, "/" everywhere
# else.
weave cp_sep into string:
    if calling cp_win:
        return "\\"
    return "/"

# True when path is absolute: it starts with a separator, or on Windows with a
# drive prefix such as "C:".
weave cp_is_abs with path as string into bool:
    var pl as int is path length
    if pl == 0:
        return false
    if calling cp_win:
        if pl >= 2:
            var d0 as string is path at 0
            var d1 as string is path at 1
            if calling cp_is_letter with d0:
                if d1 == ":":
                    return true
        var c0 as string is path at 0
        if calling cp_is_sep with c0:
            return true
        return false
    var c0p as string is path at 0
    if c0p == "/":
        return true
    return false

# True when path is exactly a filesystem root: a bare separator or a Windows
# drive prefix, with an optional trailing separator.
weave cp_is_root with path as string into bool:
    var pl as int is path length
    if pl == 0:
        return false
    if pl == 1:
        var c0 as string is path at 0
        if calling cp_is_sep with c0:
            return true
    if calling cp_win:
        if pl == 2:
            var d0 as string is path at 0
            var d1 as string is path at 1
            if calling cp_is_letter with d0:
                if d1 == ":":
                    return true
        if pl == 3:
            var e0 as string is path at 0
            var e1 as string is path at 1
            var e2 as string is path at 2
            if calling cp_is_letter with e0:
                if e1 == ":":
                    if calling cp_is_sep with e2:
                        return true
    return false

# Windows drive prefix of path (e.g. "C:"), or "" when path has none.
weave cp_drive with path as string into string:
    var pl as int is path length
    if calling cp_win:
        if pl >= 2:
            var d0 as string is path at 0
            var d1 as string is path at 1
            if calling cp_is_letter with d0:
                if d1 == ":":
                    return d0 + ":"
    return ""

# Final component of path; "" for an empty path or one that ends in separators.
weave cp_basename with path as string into string:
    var pl as int is path length
    if pl == 0:
        return ""
    var e as int is pl - 1
    while e > 0:
        var ec as string is path at e
        if calling cp_is_sep with ec:
            set e is e - 1
        else:
            break
    if e == 0:
        var c0 as string is path at 0
        if calling cp_is_sep with c0:
            return ""
    var s as int is e
    while true:
        if s < 0:
            break
        var sc as string is path at s
        if calling cp_is_sep with sc:
            break
        if calling cp_win:
            if s == 1:
                var w1 as string is path at 1
                var w0 as string is path at 0
                if w1 == ":":
                    if calling cp_is_letter with w0:
                        break
        set s is s - 1
    set s is s + 1
    var bl as int is e - s + 1
    if bl <= 0:
        return ""
    return path at s to (e + 1)

# Directory portion of path without a trailing separator; "" when path has no
# parent directory.
weave cp_dirname with path as string into string:
    var pl as int is path length
    if pl == 0:
        return ""
    var e as int is pl - 1
    while e > 0:
        var ec as string is path at e
        if calling cp_is_sep with ec:
            set e is e - 1
        else:
            break
    var skip as bool is true
    while skip:
        if e < 0:
            set skip is false
        else:
            var ec2 as string is path at e
            if calling cp_is_sep with ec2:
                set skip is false
            else:
                if calling cp_win:
                    if e == 1:
                        var w1 as string is path at 1
                        var w0 as string is path at 0
                        if w1 == ":":
                            if calling cp_is_letter with w0:
                                set skip is false
                if skip:
                    set e is e - 1
    if e < 0:
        return ""
    var skip2 as bool is true
    while skip2:
        if e <= 0:
            set skip2 is false
        else:
            var ec3 as string is path at e
            if calling cp_is_sep with ec3:
                if calling cp_win:
                    if e == 2:
                        var w1b as string is path at 1
                        var w0b as string is path at 0
                        if w1b == ":":
                            if calling cp_is_letter with w0b:
                                set skip2 is false
                if skip2:
                    set e is e - 1
            else:
                set skip2 is false
    return path at 0 to (e + 1)

# Extension of the basename, dot included (e.g. ".txt"); "" when there is none.
# A leading dot (hidden file) is not treated as an extension.
weave cp_ext with path as string into string:
    var base as string is calling cp_basename with path
    var bl as int is base length
    if bl == 0:
        return ""
    var last_dot as int is -1
    var i as int is bl - 1
    while i >= 0:
        var ic as string is base at i
        if ic == ".":
            set last_dot is i
            break
        set i is i - 1
    if last_dot <= 0:
        return ""
    return base at last_dot to bl

# Basename without its final extension; the whole basename when there is no
# extension.
weave cp_stem with path as string into string:
    var base as string is calling cp_basename with path
    var bl as int is base length
    if bl == 0:
        return ""
    var last_dot as int is -1
    var i as int is bl - 1
    while i >= 0:
        var ic as string is base at i
        if ic == ".":
            set last_dot is i
            break
        set i is i - 1
    if last_dot <= 0:
        return base
    return base at 0 to last_dot

# True when the basename has an extension (cp_ext is non-empty).
weave cp_has_ext with path as string into bool:
    var ex as string is calling cp_ext with path
    var el as int is ex length
    if el > 0:
        return true
    return false

# True when the tail of path equals suffix (plain, case-sensitive endswith).
weave cp_has_suffix with path as string , suffix as string into bool:
    var sl as int is path length
    var xl as int is suffix length
    if xl > sl:
        return false
    var st as int is sl - xl
    var tail as string is path at st to sl
    if tail == suffix:
        return true
    return false

# Suffixes of the basename split at dots, e.g. "a.tar.gz" gives ["tar", "gz"].
weave cp_suffixes with path as string into list of string:
    var out as list of string is list of string
    var base as string is calling cp_basename with path
    var bl as int is base length
    if bl == 0:
        return out
    var i as int is 1
    while i < bl:
        var ic as string is base at i
        if ic == ".":
            var j as int is i + 1
            var nd as int is bl
            var look as bool is true
            while look:
                if j >= bl:
                    set look is false
                else:
                    var jc as string is base at j
                    if jc == ".":
                        set nd is j
                        set look is false
                    else:
                        set j is j + 1
            var slen as int is nd - (i + 1)
            if slen >= 0:
                var piece as string is base at (i + 1) to nd
                calling out.push with piece
        set i is i + 1
    return out

# Collapses redundant separators and resolves "." and ".." segments; empty
# input becomes ".". Keeps the drive prefix and uses the platform separator.
weave cp_normalize with path as string into string:
    var pl as int is path length
    if pl == 0:
        return "."
    var sep as string is calling cp_sep
    var drv as string is ""
    var p_idx as int is 0
    if calling cp_win:
        if pl >= 2:
            var d0 as string is path at 0
            var d1 as string is path at 1
            if calling cp_is_letter with d0:
                if d1 == ":":
                    set drv is d0 + ":"
                    set p_idx is 2
    var is_abs as bool is false
    if p_idx < pl:
        var pc as string is path at p_idx
        if calling cp_is_sep with pc:
            set is_abs is true
            set p_idx is p_idx + 1
    var stack as list of string is list of string
    var cur_start as int is p_idx
    var i as int is p_idx
    while i <= pl:
        var at_end as bool is false
        if i == pl:
            set at_end is true
        else:
            var ic as string is path at i
            if calling cp_is_sep with ic:
                set at_end is true
        if at_end:
            var seg_len as int is i - cur_start
            if seg_len > 0:
                var seg as string is path at cur_start to i
                if seg == ".":
                    set i is i
                else:
                    if seg == "..":
                        var stl as int is stack.len
                        if stl > 0:
                            var last_seg as string is stack at (stl - 1)
                            if last_seg == "..":
                                if is_abs == false:
                                    calling stack.push with seg
                            else:
                                var popped as string is calling stack.pop
                        else:
                            if is_abs == false:
                                calling stack.push with seg
                    else:
                        calling stack.push with seg
            set cur_start is i + 1
        set i is i + 1
    var out as string is ""
    if drv length > 0:
        set out is drv
    if is_abs:
        set out is out + sep
    var k as int is 0
    while k < stack.len:
        if k > 0:
            set out is out + sep
        else:
            if is_abs == false:
                if out length > 0:
                    set out is out + sep
        var item as string is stack at k
        set out is out + item
        set k is k + 1
    if out length == 0:
        set out is "."
    return out

# Parent directory of path as maybe string; none when path is a root or has no
# directory part.
weave cp_parent with path as string into maybe string:
    if calling cp_is_root with path:
        return maybe none
    var dir as string is calling cp_dirname with path
    if dir length == 0:
        return maybe none
    return some dir

# Splits path into components: optional drive prefix, the root separator
# (reported as "/"), then each remaining segment.
weave cp_split with path as string into list of string:
    var out as list of string is list of string
    var pl as int is path length
    if pl == 0:
        return out
    var p_idx as int is 0
    if calling cp_win:
        if pl >= 2:
            var d0 as string is path at 0
            var d1 as string is path at 1
            if calling cp_is_letter with d0:
                if d1 == ":":
                    calling out.push with (d0 + ":")
                    set p_idx is 2
    if p_idx < pl:
        var pc as string is path at p_idx
        if calling cp_is_sep with pc:
            calling out.push with "/"
            set p_idx is p_idx + 1
    var cur_start as int is p_idx
    var i as int is p_idx
    while i <= pl:
        var at_end as bool is false
        if i == pl:
            set at_end is true
        else:
            var ic as string is path at i
            if calling cp_is_sep with ic:
                set at_end is true
        if at_end:
            var seg_len as int is i - cur_start
            if seg_len > 0:
                var seg as string is path at cur_start to i
                calling out.push with seg
            set cur_start is i + 1
        set i is i + 1
    return out

# Joins parts with the platform separator and normalizes the result; "" for an
# empty list. An absolute part restarts the accumulated path.
weave cp_join with parts as list of string into string:
    if parts.len == 0:
        return ""
    var sep as string is calling cp_sep
    var buf as string is ""
    var i as int is 0
    while i < parts.len:
        var p as string is parts at i
        if p length > 0:
            if calling cp_is_abs with p:
                set buf is p
            else:
                if buf length > 0:
                    var last_c as string is buf at (buf length - 1)
                    if not (calling cp_is_sep with last_c):
                        set buf is buf + sep
                set buf is buf + p
        set i is i + 1
    return calling cp_normalize with buf

# Replaces the extension of path with new_ext, adding the dot when new_ext
# lacks one and removing the extension when new_ext is empty.
weave cp_change_ext with path as string , new_ext as string into string:
    var dir as string is calling cp_dirname with path
    var st as string is calling cp_stem with path
    var buf as string is ""
    if dir length > 0:
        var sd as string is calling cp_sep
        set buf is dir + sd + st
    else:
        set buf is st
    if new_ext length > 0:
        var n0 as string is new_ext at 0
        if n0 == ".":
            set buf is buf + new_ext
        else:
            set buf is buf + "." + new_ext
    return buf

# Appends ext to path only when path has no extension yet; otherwise returns
# path unchanged.
weave cp_add_ext with path as string , ext as string into string:
    if calling cp_has_ext with path:
        return path
    if ext length == 0:
        return path
    var e0 as string is ext at 0
    if e0 == ".":
        return path + ext
    return path + "." + ext

# Relative path that reaches target from base, using ".." segments when needed;
# none when the paths are absolute and unrelated.
weave cp_relative_to with target as string , base as string into maybe string:
    var nt as string is calling cp_normalize with target
    var nb as string is calling cp_normalize with base
    var tp as list of string is calling cp_split with nt
    var bp as list of string is calling cp_split with nb
    if tp.len == 0:
        return maybe none
    if bp.len == 0:
        return maybe none
    var common as int is 0
    var cm as bool is true
    while cm:
        if common >= tp.len:
            set cm is false
        else:
            if common >= bp.len:
                set cm is false
            else:
                var p1 as string is tp at common
                var p2 as string is bp at common
                if p1 == p2:
                    set common is common + 1
                else:
                    set cm is false
    if common == 0:
        if calling cp_is_abs with nt:
            return maybe none
    var res as list of string is list of string
    var i as int is common
    while i < bp.len:
        calling res.push with ".."
        set i is i + 1
    var j as int is common
    while j < tp.len:
        var tj as string is tp at j
        calling res.push with tj
        set j is j + 1
    var joined as string is calling cp_join with res
    return some joined

# ----------------------------------------------------------------------------
# Module-level members
# ----------------------------------------------------------------------------

# Joins path parts with the platform separator and normalizes the result.
weave join with parts as list of string into string:
    return calling cp_join with parts

# Joins path parts with the platform separator and normalizes the result; kept
# as a twin of join.
weave join_all with parts as list of string into string:
    return calling cp_join with parts

# Final component of path, or "" when there is none.
weave basename with path as string into string:
    return calling cp_basename with path

# Directory portion of path without a trailing separator, or "" when there is
# none.
weave dirname with path as string into string:
    return calling cp_dirname with path

# Extension of the basename including the dot, or "" when there is none.
weave ext with path as string into string:
    return calling cp_ext with path

# Basename without its final extension.
weave stem with path as string into string:
    return calling cp_stem with path

# True when path is absolute (drive prefix on Windows, or a leading separator).
weave is_absolute with path as string into bool:
    return calling cp_is_abs with path

# True when path is not absolute.
weave is_relative with path as string into bool:
    var abs as bool is calling cp_is_abs with path
    return not abs

# Collapses redundant separators and resolves "." and ".." segments.
weave normalize with path as string into string:
    return calling cp_normalize with path

# Parent directory as maybe string; none when path is a root or has no parent
# directory.
weave parent with path as string into maybe string:
    return calling cp_parent with path

# Splits path into its drive, root separator and segment components.
weave split with path as string into list of string:
    return calling cp_split with path

# True when the basename has an extension.
weave has_ext with path as string into bool:
    return calling cp_has_ext with path

# Preferred path separator for this platform.
weave separator into string:
    return calling cp_sep

# Alternate path separator as maybe string: some "/" on Windows, none on other
# platforms.
weave alt_separator into maybe string:
    if calling cp_win:
        return some "/"
    return maybe none

# True when path is exactly a filesystem root.
weave is_root with path as string into bool:
    return calling cp_is_root with path

# Windows drive prefix of path (e.g. "C:"), or "" when there is none.
weave drive with path as string into string:
    return calling cp_drive with path

# Replaces the extension of path with new_ext (dot added when missing; ""
# removes the extension).
weave change_ext with path as string , new_ext as string into string:
    return calling cp_change_ext with path , new_ext

# Appends ext only when path has no extension yet.
weave add_ext with path as string , ext as string into string:
    return calling cp_add_ext with path , ext

# Relative path from base to target, using ".." segments when needed; none for
# unrelated absolute paths.
weave relative_to with target as string , base as string into maybe string:
    return calling cp_relative_to with target , base

# True when the tail of path equals suffix.
weave has_suffix with path as string , suffix as string into bool:
    return calling cp_has_suffix with path , suffix

# The dotted suffixes of the basename, e.g. "a.tar.gz" gives ["tar", "gz"].
weave suffixes with path as string into list of string:
    return calling cp_suffixes with path

# True when this build targets Windows.
weave is_windows into bool:
    return calling cp_win

# True when this build targets a Unix-like platform (not Windows).
weave is_unix into bool:
    if calling cp_win:
        return false
    return true

# ----------------------------------------------------------------------------
# Path value type
# ----------------------------------------------------------------------------

# Path value: an owned wrapper around a raw path string that exposes
# chainable query and transform methods.
rune Path:
    raw as string

# Method implementations for Path; each method operates on the wrapped raw
# string (self->raw).
enchanting Path:
    # The underlying raw path as a plain string.
    weave to_string into string:
        return self->raw

    # Final component of the path (basename), "" when there is none.
    weave name into string:
        return calling cp_basename with self->raw

    # Directory of the path as maybe string; none when it is a root or has no
    # parent directory.
    weave parent into maybe string:
        return calling cp_parent with self->raw

    # Basename without the final extension.
    weave stem into string:
        return calling cp_stem with self->raw

    # Extension including the dot, "" when there is none.
    weave suffix into string:
        return calling cp_ext with self->raw

    # Dotted suffixes of the basename, e.g. "a.tar.gz" gives ["tar", "gz"].
    weave suffixes into list of string:
        return calling cp_suffixes with self->raw

    # Windows drive prefix, "" when there is none.
    weave drive into string:
        return calling cp_drive with self->raw

    # Path split into drive, root separator and segment components.
    weave parts into list of string:
        return calling cp_split with self->raw

    # True when the path is absolute.
    weave is_absolute into bool:
        return calling cp_is_abs with self->raw

    # True when the path is relative (not absolute).
    weave is_relative into bool:
        var abs as bool is calling cp_is_abs with self->raw
        return not abs

    # True when the path is exactly a filesystem root.
    weave is_root into bool:
        return calling cp_is_root with self->raw

    # True when the basename carries an extension.
    weave has_suffix into bool:
        return calling cp_has_ext with self->raw

    # True when the tail of the path equals the given suffix.
    weave has_suffix_with with suffix as string into bool:
        return calling cp_has_suffix with self->raw , suffix

    # True when the wrapped path is the empty string.
    weave is_empty into bool:
        return self->raw == ""

    # A new Path with redundant separators and "." / ".." segments resolved.
    weave normalize into Path:
        var res as string is calling cp_normalize with self->raw
        return with raw is res

    # Relative path from base to this path as maybe string; none when the paths
    # are unrelated.
    weave relative_to with base as string into maybe string:
        return calling cp_relative_to with self->raw , base

    # A new Path whose extension is replaced by new_ext (dot added when missing;
    # "" removes the extension).
    weave with_suffix with new_ext as string into Path:
        var res as string is calling cp_change_ext with self->raw , new_ext
        return with raw is res

    # A new Path with its final component replaced by new_name; the directory
    # portion is kept.
    weave with_name with new_name as string into Path:
        var parent_str as string is calling cp_dirname with self->raw
        if parent_str == "":
            return with raw is new_name
        var parts as list of string is list of string
        calling parts.push with parent_str
        calling parts.push with new_name
        var res as string is calling cp_join with parts
        return with raw is res

    # A new Path with ext appended when it has no extension yet, unchanged
    # otherwise.
    weave add_suffix with ext as string into Path:
        var res as string is calling cp_add_ext with self->raw , ext
        return with raw is res

    # A new Path without its final extension.
    weave without_suffix into Path:
        var res as string is calling cp_change_ext with self->raw , ""
        return with raw is res

# Builds an owned Path value from a raw path string.
weave path with raw as string into Path:
    return with raw is raw

# Builds an owned Path by joining parts with the platform separator and
# normalizing the result.
weave path_join with parts as list of string into Path:
    var joined as string is calling cp_join with parts
    return with raw is joined
