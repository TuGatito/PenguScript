# std/stb_herringbone_wang_tile.d.pengu - The Herringbone Wang Tile (generates herringbone Wang-tile sets for seamless tile textures)
# Pure C-binding declaration file: every declaration maps 1:1 to the native
# stb_herringbone_wang_tile C API. This file cannot contain implementation bodies (.d.pengu rule).
# Memory ownership follows the native library contract: read the upstream docs
# next to each declaration; release any returned handle with the library's own
# cleanup routine before dropping the last reference.

## PenguScript declaration binding generated by 'pengu bind'.
## Source header: stb_herringbone_wang_tile.h
include "stb_herringbone_wang_tile.h"

# -- Constants (#define) ------------------------------

const STB_HBWANG_MAX_X as i64 is 100
const STB_HBWANG_MAX_Y as i64 is 100

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

alias stbhw_tileset as opaque

rune stbhw_tile:
  a as char
  b as char
  c as char
  d as char
  e as char
  f as char
  pixels as byte

# if corner_type_color_template[s][t] is non-zero, then any
# corner of type s generated as color t will get a little
# corner sample markup in the template image data
rune stbhw_config:
  is_corner as int
  short_side_len as int
  num_color as int
  num_vary_x as int
  num_vary_y as int
  corner_type_color_template as int

# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia stbh_

# returns description of last error produced by any function (not thread-safe)
declare stbhw_get_last_error into ref to frozen char

# build a tileset from an image that conforms to a template created by this
# library. (you allocate storage for stbhw_tileset and function fills it out;
# memory for individual tiles are malloc()ed).
# returns non-zero on success, 0 on error
declare stbhw_build_tileset_from_image with ts as ref to stbhw_tileset, pixels as ref to byte, stride_in_bytes as int, w as int, h as int into int

# free a tileset built by stbhw_build_tileset_from_image
declare stbhw_free_tileset with ts as ref to stbhw_tileset into void

# generate a map that is w * h pixels (3-bytes each)
# returns non-zero on success, 0 on error
# not thread-safe (uses a global data structure to avoid memory management)
# weighting should be NULL, as non-NULL weighting is currently untested
declare stbhw_generate_image with ts as ref to stbhw_tileset, weighting as ref to ref to int, pixels as ref to byte, stride_in_bytes as int, w as int, h as int into int

# computes the size needed for the template image
declare stbhw_get_template_size with c as ref to stbhw_config, w as ref to int, h as ref to int into void

# generates a template image, assuming data is 3*w*h bytes long, RGB format
declare stbhw_make_template with c as ref to stbhw_config, data as ref to byte, w as int, h as int, stride_in_bytes as int into int
