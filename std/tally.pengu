test "index_of returns -1 when absent":
    let _a16 as list of int is [3, 1, 2]
    calling _expect_eq_int with (calling index_of with _a16, 9), -1, "index_of missing"
test "last_index_of returns the last position":
    let _a17 as list of int is [3, 1, 4, 1, 5]
    calling _expect_eq_int with (calling last_index_of with _a17, 1), 3, "last_index_of"
test "last_index_of returns -1 when absent":
    let _a18 as list of int is [3, 1, 2]
    calling _expect_eq_int with (calling last_index_of with _a18, 9), -1, "last_index_of missing"
test "count_of counts the occurrences":
