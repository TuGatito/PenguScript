weave unique shard T where T: Par with l as list of T into list of T:
    let n as int is calling l.len
    var keep as list of int is list of int
    defer banish keep
    var i as int is 0
    while i < n:
        var dup as bool is false
        var j as int is 0
        while j < i:
            if (l at j) == (l at i):
                set dup is true
            set j is j + 1
        if not dup:
            calling keep.push with i
        set i is i + 1
    for k in keep then (l at k)

