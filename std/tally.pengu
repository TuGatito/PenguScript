# --- Transformations ---

test "reverse returns a reversed copy":
    let _a51 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling reverse with _a51
    calling _expect_eq_int with (out at 0), 5, "reverse first"
test "sort_asc sorts ascending without mutating the input":
    let _a52 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling sort_asc with _a52
    calling _expect_eq_int with (out at 0), 1, "sort_asc first"
    calling _expect_eq_int with (_a52 at 0), 3, "sort_asc input intact"
test "sort_desc sorts descending":
    let _a53 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling sort_desc with _a53
    calling _expect_eq_int with (out at 0), 5, "sort_desc first"
test "sort_asc and sort_desc are generic over float":
    let fs as list of float is [2.5, -1.5, 4.5]
    let up as list of float is calling fs.sort_asc
    let down as list of float is calling fs.sort_desc
    calling _expect_eq_float with (up at 0), -1.5, "float sort_asc"
    calling _expect_eq_float with (down at 0), 4.5, "float sort_desc"
test "unique removes duplicates keeping the order":
    let _a54 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling unique with _a54
    calling _expect_eq_int with (calling out.len), 4, "unique len"
    calling _expect_eq_int with (out at 1), 1, "unique second"
test "dedup is an alias of unique":
    let _a55 as list of int is [1, 2, 1, 2, 3]
    let out as list of int is calling dedup with _a55
    calling _expect_eq_int with (calling out.len), 3, "dedup len"
test "flatten returns an identity copy":
    let _a56 as list of int is [3, 1, 2]
    let out as list of int is calling flatten with _a56
    calling _expect_eq_int with (out at 2), 2, "flatten"
test "abs_all turns negatives into positives":
    let _a57 as list of int is [-3, 1, -2]
    let out as list of int is calling abs_all with _a57
    calling _expect_eq_int with (out at 0), 3, "abs first"
    calling _expect_eq_int with (out at 2), 2, "abs last"
test "clamp_all clips to the given range":
    let _a58 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling clamp_all with _a58, 2, 4
    calling _expect_eq_int with (out at 1), 2, "clamp low"
    calling _expect_eq_int with (out at 4), 4, "clamp high"
test "clamp_all uses the default range [0, 100]":
    let _a59 as list of int is [-5, 150]
    let out as list of int is calling clamp_all with _a59
    calling _expect_eq_int with (out at 0), 0, "clamp default low"
    calling _expect_eq_int with (out at 1), 100, "clamp default high"
test "is_sorted_asc detects unsorted and sorted lists":
    let _a60 as list of int is [3, 1, 2]
    let _a61 as list of int is [1, 2, 3]
    calling _expect_eq_bool with (calling is_sorted_asc with _a60), false, "not sorted asc"
    calling _expect_eq_bool with (calling is_sorted_asc with _a61), true, "sorted asc"
test "is_sorted_desc detects descending order":
    let _a62 as list of int is [3, 2, 1]
    calling _expect_eq_bool with (calling is_sorted_desc with _a62), true, "sorted desc"
test "the map_square, map_negate and map_add_scalar methods transform":
    let xs as list of int is [3, -1]
    let sq as list of int is calling xs.map_square
    let neg as list of int is calling xs.map_negate
    let add as list of int is calling xs.map_add_scalar with 10
    calling _expect_eq_int with (sq at 0), 9, "method square"
    calling _expect_eq_int with (neg at 0), -3, "method negate"
    calling _expect_eq_int with (add at 0), 13, "method add scalar"
test "the map_increment method uses delta 1 by default":
    let xs as list of int is [3, 1]
    let out as list of int is calling xs.map_increment
    calling _expect_eq_int with (out at 0), 4, "method increment"
test "the abs_all method removes signs":
    let xs as list of int is [-3, 1, -2]
    let out as list of int is calling xs.abs_all
    calling _expect_eq_int with (out at 0), 3, "method abs_all"
test "the median method matches the module function":
    let xs as list of float is [3.5, 1.5, 2.5]
    calling _expect_eq_float with (calling xs.median), 2.5, "method median"
test "the clamp_all method clips to the span":
    let xs as list of int is [-5, 150]
    let out as list of int is calling xs.clamp_all
    calling _expect_eq_int with (out at 0), 0, "method clamp low"
    calling _expect_eq_int with (out at 1), 100, "method clamp high"
# --- Selection ---

test "take returns the first n elements":
    let _a64 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling take with _a64, 2
    calling _expect_eq_int with (calling out.len), 2, "take len"
    calling _expect_eq_int with (out at 1), 1, "take second"
test "take without an argument returns one element":
    let _a65 as list of int is [3, 1, 4]
    let out as list of int is calling take with _a65
    calling _expect_eq_int with (calling out.len), 1, "take default"
test "drop skips the first n elements":
    let _a67 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling drop with _a67, 2
    calling _expect_eq_int with (calling out.len), 3, "drop len"
    calling _expect_eq_int with (out at 0), 4, "drop first"
test "slice_list returns the [start, end) range":
    let _a69 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling slice_list with _a69, 1, 3
    calling _expect_eq_int with (calling out.len), 2, "slice len"
    calling _expect_eq_int with (out at 0), 1, "slice first"
test "take and drop are generic over float":
    let fs as list of float is [2.5, -1.5, 4.5]
    let firsts as list of float is calling fs.take with 2
    let rest as list of float is calling fs.drop with 1
    calling _expect_eq_float with (firsts at 0), 2.5, "float take"
    calling _expect_eq_float with (rest at 0), -1.5, "float drop"
test "take clips n above the length":
    let xs as list of int is [3, 1]
    let out as list of int is calling take with xs, 9
    calling _expect_eq_int with (calling out.len), 2, "take clipping"
test "drop beyond the length is empty":
    let xs as list of int is [3, 1]
    let out as list of int is calling drop with xs, 9
    calling _expect_eq_int with (calling out.len), 0, "drop beyond"
test "slice_list with start above end is empty":
    let xs as list of int is [3, 1, 2]
    let out as list of int is calling slice_list with xs, 2, 1
    calling _expect_eq_int with (calling out.len), 0, "slice inverted"
# --- Predicates ---

test "all_positive is true only with strict positives":
    let _a72 as list of int is [3, 1, 4]
    let _a73 as list of int is [3, 0, 4]
    calling _expect_eq_bool with (calling all_positive with _a72), true, "all positive"
    calling _expect_eq_bool with (calling all_positive with _a73), false, "zero is not positive"
test "all_zero is true only when everything is zero":
    let _a74 as list of int is [0, 0]
    let _a75 as list of int is [0, 1]
    calling _expect_eq_bool with (calling all_zero with _a74), true, "all zero"
    calling _expect_eq_bool with (calling all_zero with _a75), false, "not all zero"
test "any_negative detects at least one negative":
    let _a76 as list of int is [-1, 2]
    let _a77 as list of int is [1, 2]
    calling _expect_eq_bool with (calling any_negative with _a76), true, "has negative"
    calling _expect_eq_bool with (calling any_negative with _a77), false, "no negative"
test "all_in_range checks the inclusive range":
    let _a78 as list of int is [1, 3, 5]
    let _a79 as list of int is [1, 9]
    calling _expect_eq_bool with (calling all_in_range with _a78, 1, 5), true, "in range"
    calling _expect_eq_bool with (calling all_in_range with _a79, 1, 5), false, "out of range"
test "the is_sorted methods inspect the order":
    let up as list of int is [1, 2, 3]
    let down as list of int is [3, 2, 1]
    calling _expect_eq_bool with (calling up.is_sorted_asc), true, "method sorted asc"
    calling _expect_eq_bool with (calling down.is_sorted_desc), true, "method sorted desc"
    calling _expect_eq_bool with (calling up.is_sorted_desc), false, "method not sorted desc"
test "the all_positive and any_negative methods scan the sign":
    let pos as list of int is [3, 1]
    let mixed as list of int is [3, -1]
    let zeroed as list of int is [0, 0]
    calling _expect_eq_bool with (calling pos.all_positive), true, "method all positive"
    calling _expect_eq_bool with (calling zeroed.all_positive), false, "method zero not positive"
    calling _expect_eq_bool with (calling mixed.any_negative), true, "method any negative"
test "the all_zero method checks the zero sentinel":
    let xs as list of int is [0, 0]
    let ys as list of int is [0, 1]
    calling _expect_eq_bool with (calling xs.all_zero), true, "method all zero"
    calling _expect_eq_bool with (calling ys.all_zero), false, "method not all zero"
test "the all_in_range method checks the inclusive span":
    let xs as list of int is [1, 3, 5]
    calling _expect_eq_bool with (calling xs.all_in_range with 1, 5), true, "method in range"
    calling _expect_eq_bool with (calling xs.all_in_range with 2, 5), false, "method out of range"
# --- Filters ---

test "filter_even keeps the even elements":
    let _a80 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling filter_even with _a80
    calling _expect_eq_int with (calling out.len), 1, "evens len"
    calling _expect_eq_int with (out at 0), 4, "evens value"
test "filter_odd keeps the odd elements":
    let _a81 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling filter_odd with _a81
    calling _expect_eq_int with (calling out.len), 4, "odds len"
test "filter_positive and filter_negative split by sign":
    let _a82 as list of int is [-3, 1, -2, 4]
    let pos as list of int is calling filter_positive with _a82
    let neg as list of int is calling filter_negative with _a82
    calling _expect_eq_int with (calling pos.len), 2, "positives"
    calling _expect_eq_int with (calling neg.len), 2, "negatives"
test "filter_in_range keeps the inclusive range":
    let _a83 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling filter_in_range with _a83, 2, 4
    calling _expect_eq_int with (calling out.len), 2, "in range len"
test "filter_range is an alias of filter_in_range":
    let _a84 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling filter_range with _a84, 2, 4
    calling _expect_eq_int with (calling out.len), 2, "filter_range"
test "filter_positive is generic over float":
    let fs as list of float is [2.5, -1.5, 4.5]
    let out as list of float is calling fs.filter_positive
    calling _expect_eq_int with (calling out.len), 2, "float filter positive"
test "the filter_even and filter_odd methods split by parity":
    let xs as list of int is [3, 1, 4, 2]
    let evens as list of int is calling xs.filter_even
    let odds as list of int is calling xs.filter_odd
    calling _expect_eq_int with (calling evens.len), 2, "method evens"
    calling _expect_eq_int with (calling odds.len), 2, "method odds"
test "the filter_negative method keeps negatives":
    let xs as list of int is [3, -1, 0, -2]
    let out as list of int is calling xs.filter_negative
    calling _expect_eq_int with (calling out.len), 2, "method negatives len"
    calling _expect_eq_int with (out at 0), -1, "method negatives first"
test "the filter_in_range and filter_range methods agree":
    let xs as list of int is [3, 1, 4, 1, 5]
    let a as list of int is calling xs.filter_in_range with 2, 4
    let b as list of int is calling xs.filter_range with 2, 4
    calling _expect_eq_int with (calling a.len), 2, "method filter_in_range"
    calling _expect_eq_int with (calling b.len), 2, "method filter_range"
test "the unique and dedup methods remove duplicates":
    let xs as list of int is [3, 1, 3, 2]
    let a as list of int is calling xs.unique
    let b as list of int is calling xs.dedup
    calling _expect_eq_int with (calling a.len), 3, "method unique len"
    calling _expect_eq_int with (calling b.len), 3, "method dedup len"
# --- Maps ---

test "map_double doubles every element":
    let _a86 as list of int is [3, 1, 4]
    let out as list of int is calling map_double with _a86
    calling _expect_eq_int with (out at 0), 6, "double first"
    calling _expect_eq_int with (out at 2), 8, "double last"
test "map_square squares every element":
    let _a87 as list of int is [3, 1, 4]
    let out as list of int is calling map_square with _a87
    calling _expect_eq_int with (out at 2), 16, "square"
test "map_negate flips the sign":
    let _a88 as list of int is [3, -1]
    let out as list of int is calling map_negate with _a88
    calling _expect_eq_int with (out at 0), -3, "negate first"
    calling _expect_eq_int with (out at 1), 1, "negate second"
test "map_add_scalar adds the scalar":
    let _a89 as list of int is [3, 1, 4]
    let out as list of int is calling map_add_scalar with _a89, 10
    calling _expect_eq_int with (out at 0), 13, "add scalar"
test "map_increment uses delta 1 by default":
    let _a90 as list of int is [3, 1, 4]
    let out as list of int is calling map_increment with _a90
    calling _expect_eq_int with (out at 0), 4, "increment default"
test "map_double is generic over float":
    let fs as list of float is [2.5, -1.5]
    let out as list of float is calling fs.map_double
    calling _expect_eq_float with (out at 0), 5.0, "float double"
# --- Combination ---

test "concat joins two lists into a new one":
    let _a92 as list of int is [3, 1]
    let _a93 as list of int is [4, 5]
    let out as list of int is calling concat with _a92, _a93
    calling _expect_eq_int with (calling out.len), 4, "concat len"
    calling _expect_eq_int with (out at 2), 4, "concat third"
test "zip_sum adds element by element":
    let _a94 as list of int is [3, 1, 2]
    let _a95 as list of int is [1, 1, 1]
    let out as list of int is calling zip_sum with _a94, _a95
    calling _expect_eq_int with (out at 0), 4, "zip_sum first"
test "repeat repeats a value":
    let out as list of int is calling repeat with 7, 3
    calling _expect_eq_int with (calling out.len), 3, "repeat len"
    calling _expect_eq_int with (out at 1), 7, "repeat value"
test "repeat with a non-positive times returns an empty list":
    let out as list of int is calling repeat with 7, 0
    calling _expect_eq_int with (calling out.len), 0, "repeat zero"

# --- New API ---

test "zip_with combines two lists with a function":
    let _a98 as list of int is [3, 1, 2]
    let _a99 as list of int is [1, 1, 1]
    let out as list of int is calling zip_with with _a98, _a99, (lambda a as int, b as int into a + b)
    calling _expect_eq_int with (out at 0), 4, "zip_with sum"
test "zip_with accepts different input types":
    let _a100 as list of int is [3, 1]
    let _a101 as list of float is [0.5, 0.5]
    let out as list of float is calling zip_with with _a100, _a101, (lambda a as int, b as float into (a to float) + b)
    calling _expect_eq_float with (out at 0), 3.5, "zip_with mixed"
test "chunk splits into consecutive runs":
    let _a102 as list of int is [3, 1, 4, 1, 5]
    let out as list of list of int is calling chunk with _a102, 2
    calling _expect_eq_int with (calling out.len), 3, "chunk count"
    let last as list of int is out at 2
    calling _expect_eq_int with (calling last.len), 1, "chunk last len"
test "chunk with a span greater than the list gives one run":
    let _a104 as list of int is [3, 1, 4]
    let out as list of list of int is calling chunk with _a104, 9
    calling _expect_eq_int with (calling out.len), 1, "chunk big span"
test "windowed produces sliding windows":
    let _a105 as list of int is [3, 1, 4, 1, 5]
    let out as list of list of int is calling windowed with _a105, 3
    calling _expect_eq_int with (calling out.len), 3, "windowed count"
    let w1 as list of int is out at 1
    calling _expect_eq_int with (w1 at 0), 1, "windowed second start"
test "running_sum accumulates the prefixes":
    let _a107 as list of int is [3, 1, 2]
    let out as list of int is calling running_sum with _a107
    calling _expect_eq_int with (out at 0), 3, "running first"
    calling _expect_eq_int with (out at 2), 6, "running last"
test "scan_left accumulates with the given function":
    let _a109 as list of int is [1, 2, 3]
    let out as list of int is calling scan_left with _a109, (lambda acc as int, x as int into acc + x)
    calling _expect_eq_int with (out at 1), 3, "scan second"
    calling _expect_eq_int with (out at 2), 6, "scan third"
test "scan_left is generic over float":
    let fs as list of float is [2.5, -1.5, 4.5]
    let out as list of float is calling scan_left with fs, (lambda acc as float, x as float into acc + x)
    calling _expect_eq_float with (out at 2), 5.5, "float scan"
test "min_max returns [min, max]":
    let _a110 as list of int is [3, 1, 4, 1, 5]
    let out as list of int is calling min_max with _a110
    calling _expect_eq_int with (out at 0), 1, "min_max min"
    calling _expect_eq_int with (out at 1), 5, "min_max max"
test "enumerate_pairs returns [index, value] pairs":
    let _a112 as list of int is [3, 1]
    let out as list of list of int is calling enumerate_pairs with _a112
    let p1 as list of int is out at 1
    calling _expect_eq_int with (p1 at 0), 1, "pair index"
    calling _expect_eq_int with (p1 at 1), 1, "pair value"
test "partition_by splits according to the predicate":
    let _a114 as list of int is [3, 1, 4, 1, 5]
    let out as list of list of int is calling partition_by with _a114, (lambda x as int into (x % 2) == 0)
    let yes as list of int is out at 0
    let no as list of int is out at 1
    calling _expect_eq_int with (calling yes.len), 1, "partition yes"
    calling _expect_eq_int with (calling no.len), 4, "partition no"
test "frequencies counts every value":
    let _a115 as list of int is [3, 1, 3]
    let m as map of int to int is calling frequencies with _a115
    calling _expect_eq_int with (calling m.get with 3), 2, "freq three"
    calling _expect_eq_int with (calling m.get with 1), 1, "freq one"
test "group_count is an alias of frequencies":
    let _a116 as list of int is [2, 2, 2]
    let m as map of int to int is calling group_count with _a116
    calling _expect_eq_int with (calling m.get with 2), 3, "group count"
test "zip_with stops at the shorter list":
    let xs as list of int is [3, 1, 2]
    let ys as list of int is [1, 1]
    let out as list of int is calling zip_with with xs, ys, (lambda a as int, b as int into a + b)
    calling _expect_eq_int with (calling out.len), 2, "zip_with short len"
    calling _expect_eq_int with (out at 0), 4, "zip_with short first"
test "zip_with is generic over float":
    let xs as list of float is [2.5, -1.5]
    let ys as list of float is [0.5, 0.5]
    let out as list of float is calling zip_with with xs, ys, (lambda a as float, b as float into a + b)
    calling _expect_eq_float with (out at 0), 3.0, "zip_with float"
test "chunk with a non-positive span is empty":
    let xs as list of int is [3, 1, 4]
    let out as list of list of int is calling chunk with xs, 0
    calling _expect_eq_int with (calling out.len), 0, "chunk zero span"
test "windowed with a non-positive width is empty":
    let xs as list of int is [3, 1, 4]
    let out as list of list of int is calling windowed with xs, 0
    calling _expect_eq_int with (calling out.len), 0, "windowed zero width"
test "windowed wider than the list is empty":
    let xs as list of int is [3, 1]
    let out as list of list of int is calling windowed with xs, 5
    calling _expect_eq_int with (calling out.len), 0, "windowed too wide"
test "running_sum and scan_left of the empty list are empty":
    let xs as list of int is list of int
    let a as list of int is calling running_sum with xs
    let b as list of int is calling scan_left with xs, (lambda acc as int, x as int into acc + x)
    calling _expect_eq_int with (calling a.len), 0, "running_sum empty"
    calling _expect_eq_int with (calling b.len), 0, "scan_left empty"
test "scan_left seeds the accumulator with the first element":
    let xs as list of int is [3, 1, 2]
    let out as list of int is calling scan_left with xs, (lambda acc as int, x as int into acc + x)
    calling _expect_eq_int with (out at 0), 3, "scan seed"
    calling _expect_eq_int with (out at 2), 6, "scan total"
test "min_max of the empty list is empty":
    let xs as list of int is list of int
    let out as list of int is calling min_max with xs
    calling _expect_eq_int with (calling out.len), 0, "min_max empty"
test "min_max of a single element repeats it":
    let xs as list of int is [7]
    let out as list of int is calling min_max with xs
    calling _expect_eq_int with (out at 0), 7, "min_max single min"
    calling _expect_eq_int with (out at 1), 7, "min_max single max"
test "enumerate_pairs of the empty list is empty":
    let xs as list of int is list of int
    let out as list of list of int is calling enumerate_pairs with xs
    calling _expect_eq_int with (calling out.len), 0, "enumerate empty"
test "partition_by of the empty list returns two empty lists":
    let xs as list of int is list of int
    let out as list of list of int is calling partition_by with xs, (lambda x as int into x > 0)
    calling _expect_eq_int with (calling out.len), 2, "partition empty outer"
    let yes as list of int is out at 0
    let no as list of int is out at 1
    calling _expect_eq_int with (calling yes.len), 0, "partition empty yes"
    calling _expect_eq_int with (calling no.len), 0, "partition empty no"
test "frequencies of the empty list is an empty map":
    let xs as list of int is list of int
    let m as map of int to int is calling frequencies with xs
    calling _expect_eq_int with (calling m.get with 1), 0, "frequencies empty"
# --- Edge cases ---

test "a one-element list reduces to itself":
    let _a118 as list of int is [42]
    calling _expect_eq_int with (calling sum with _a118), 42, "single sum"
    calling _expect_eq_int with (calling max_val with _a118), 42, "single max"
    calling _expect_eq_int with (calling median with _a118), 42, "single median"
test "a list of negatives keeps its sign in the reductions":
    let _a119 as list of int is [-3, -1, -2]
    calling _expect_eq_int with (calling sum with _a119), -6, "neg sum"
    calling _expect_eq_int with (calling max_val with _a119), -1, "neg max"
    calling _expect_eq_int with (calling min_val with _a119), -3, "neg min"
test "duplicates affect count_of and unique":
    let _a120 as list of int is [1, 2, 1, 2, 3]
    calling _expect_eq_int with (calling count_of with _a120, 2), 2, "dups count"
    let out as list of int is calling unique with _a120
    calling _expect_eq_int with (calling out.len), 3, "dups unique"
test "operations on the empty list are safe":
    let _a121 as list of int is list of int
    calling _expect_eq_int with (calling sum with _a121), 0, "empty sum"
    calling _expect_eq_int with (calling product with _a121), 1, "empty product"
    calling _expect_eq_int with (calling len with _a121), 0, "empty len"
    calling _expect_eq_bool with (calling is_empty with _a121), true, "empty is_empty"
