    calling _expect_eq_int with (calling count_of with _a19, 1), 2, "count_of"
test "find_first_gt returns the first greater element":
    let _a20 as list of int is [3, 1, 4, 1, 5]
    let m as maybe int is calling find_first_gt with _a20, 3
