test "sort_asc y sort_desc son genéricos sobre float":
    var fs as list of float is [2.5, -1.5, 4.5]
    var up as list of float is calling fs.sort_asc
    var down as list of float is calling fs.sort_desc
    calling _expect_eq_float with (up at 0), -1.5, "float sort_asc"
    calling _expect_eq_float with (down at 0), 4.5, "float sort_desc"
test "unique elimina duplicados conservando el orden":
    var _a54 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling unique with _a54
    calling _expect_eq_int with (calling out.len), 4, "unique len"
    calling _expect_eq_int with (out at 1), 1, "unique second"
test "dedup es alias de unique":
    var _a55 as list of int is [1, 2, 1, 2, 3]
    var out as list of int is calling dedup with _a55
    calling _expect_eq_int with (calling out.len), 3, "dedup len"
test "flatten devuelve una copia identidad":
    var _a56 as list of int is [3, 1, 2]
    var out as list of int is calling flatten with _a56
    calling _expect_eq_int with (out at 2), 2, "flatten"
test "abs_all convierte los negativos en positivos":
    var _a57 as list of int is [-3, 1, -2]
    var out as list of int is calling abs_all with _a57
    calling _expect_eq_int with (out at 0), 3, "abs first"
    calling _expect_eq_int with (out at 2), 2, "abs last"
test "clamp_all limita al rango indicado":
    var _a58 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling clamp_all with _a58, 2, 4
    calling _expect_eq_int with (out at 1), 2, "clamp low"
    calling _expect_eq_int with (out at 4), 4, "clamp high"
test "clamp_all usa el rango por defecto [0, 100]":
    var _a59 as list of int is [-5, 150]
    var out as list of int is calling clamp_all with _a59
    calling _expect_eq_int with (out at 0), 0, "clamp default low"
    calling _expect_eq_int with (out at 1), 100, "clamp default high"
test "is_sorted_asc detecta listas desordenadas y ordenadas":
    var _a60 as list of int is [3, 1, 2]
    var _a61 as list of int is [1, 2, 3]
    calling _expect_eq_bool with (calling is_sorted_asc with _a60), false, "not sorted asc"
    calling _expect_eq_bool with (calling is_sorted_asc with _a61), true, "sorted asc"
test "is_sorted_desc detecta el orden descendente":
    var _a62 as list of int is [3, 2, 1]
    calling _expect_eq_bool with (calling is_sorted_desc with _a62), true, "sorted desc"
# --- Selección ---

test "take devuelve los primeros n elementos":
    var _a64 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling take with _a64, 2
    calling _expect_eq_int with (calling out.len), 2, "take len"
    calling _expect_eq_int with (out at 1), 1, "take second"
test "take sin argumento devuelve un elemento":
    var _a65 as list of int is [3, 1, 4]
    var out as list of int is calling take with _a65
    calling _expect_eq_int with (calling out.len), 1, "take default"
test "drop omite los primeros n elementos":
    var _a67 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling drop with _a67, 2
    calling _expect_eq_int with (calling out.len), 3, "drop len"
    calling _expect_eq_int with (out at 0), 4, "drop first"
test "slice_list devuelve el rango [start, end)":
    var _a69 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling slice_list with _a69, 1, 3
    calling _expect_eq_int with (calling out.len), 2, "slice len"
    calling _expect_eq_int with (out at 0), 1, "slice first"
test "take y drop son genéricos sobre float":
    var fs as list of float is [2.5, -1.5, 4.5]
    var firsts as list of float is calling fs.take with 2
    var rest as list of float is calling fs.drop with 1
    calling _expect_eq_float with (firsts at 0), 2.5, "float take"
    calling _expect_eq_float with (rest at 0), -1.5, "float drop"
# --- Predicados ---

test "all_positive es true solo con positivos estrictos":
    var _a72 as list of int is [3, 1, 4]
    var _a73 as list of int is [3, 0, 4]
    calling _expect_eq_bool with (calling all_positive with _a72), true, "all positive"
    calling _expect_eq_bool with (calling all_positive with _a73), false, "zero is not positive"
test "all_zero es true solo si todo es cero":
    var _a74 as list of int is [0, 0]
    var _a75 as list of int is [0, 1]
    calling _expect_eq_bool with (calling all_zero with _a74), true, "all zero"
    calling _expect_eq_bool with (calling all_zero with _a75), false, "not all zero"
test "any_negative detecta al menos un negativo":
    var _a76 as list of int is [-1, 2]
    var _a77 as list of int is [1, 2]
    calling _expect_eq_bool with (calling any_negative with _a76), true, "has negative"
    calling _expect_eq_bool with (calling any_negative with _a77), false, "no negative"
test "all_in_range comprueba el rango inclusivo":
    var _a78 as list of int is [1, 3, 5]
    var _a79 as list of int is [1, 9]
    calling _expect_eq_bool with (calling all_in_range with _a78, 1, 5), true, "in range"
    calling _expect_eq_bool with (calling all_in_range with _a79, 1, 5), false, "out of range"
# --- Filtros ---

test "filter_even conserva los pares":
    var _a80 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling filter_even with _a80
    calling _expect_eq_int with (calling out.len), 1, "evens len"
    calling _expect_eq_int with (out at 0), 4, "evens value"
test "filter_odd conserva los impares":
    var _a81 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling filter_odd with _a81
    calling _expect_eq_int with (calling out.len), 4, "odds len"
test "filter_positive y filter_negative separan por signo":
    var _a82 as list of int is [-3, 1, -2, 4]
    var pos as list of int is calling filter_positive with _a82
    var neg as list of int is calling filter_negative with _a82
    calling _expect_eq_int with (calling pos.len), 2, "positives"
    calling _expect_eq_int with (calling neg.len), 2, "negatives"
test "filter_in_range conserva el rango inclusivo":
    var _a83 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling filter_in_range with _a83, 2, 4
    calling _expect_eq_int with (calling out.len), 2, "in range len"
test "filter_range es alias de filter_in_range":
    var _a84 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling filter_range with _a84, 2, 4
    calling _expect_eq_int with (calling out.len), 2, "filter_range"
test "filter_positive es genérico sobre float":
    var fs as list of float is [2.5, -1.5, 4.5]
    var out as list of float is calling fs.filter_positive
    calling _expect_eq_int with (calling out.len), 2, "float filter positive"
# --- Mapas ---

test "map_double duplica cada elemento":
    var _a86 as list of int is [3, 1, 4]
    var out as list of int is calling map_double with _a86
    calling _expect_eq_int with (out at 0), 6, "double first"
    calling _expect_eq_int with (out at 2), 8, "double last"
test "map_square eleva al cuadrado":
    var _a87 as list of int is [3, 1, 4]
    var out as list of int is calling map_square with _a87
    calling _expect_eq_int with (out at 2), 16, "square"
test "map_negate cambia el signo":
    var _a88 as list of int is [3, -1]
    var out as list of int is calling map_negate with _a88
    calling _expect_eq_int with (out at 0), -3, "negate first"
    calling _expect_eq_int with (out at 1), 1, "negate second"
test "map_add_scalar suma el escalar":
    var _a89 as list of int is [3, 1, 4]
    var out as list of int is calling map_add_scalar with _a89, 10
    calling _expect_eq_int with (out at 0), 13, "add scalar"
test "map_increment usa delta 1 por defecto":
    var _a90 as list of int is [3, 1, 4]
    var out as list of int is calling map_increment with _a90
    calling _expect_eq_int with (out at 0), 4, "increment default"
test "map_double es genérico sobre float":
    var fs as list of float is [2.5, -1.5]
    var out as list of float is calling fs.map_double
    calling _expect_eq_float with (out at 0), 5.0, "float double"
# --- Combinación ---

test "concat une dos listas en una nueva":
    var _a92 as list of int is [3, 1]
    var _a93 as list of int is [4, 5]
    var out as list of int is calling concat with _a92, _a93
    calling _expect_eq_int with (calling out.len), 4, "concat len"
    calling _expect_eq_int with (out at 2), 4, "concat third"
test "zip_sum suma elemento a elemento":
    var _a94 as list of int is [3, 1, 2]
    var _a95 as list of int is [1, 1, 1]
    var out as list of int is calling zip_sum with _a94, _a95
    calling _expect_eq_int with (out at 0), 4, "zip_sum first"
test "repeat repite un valor":
    var out as list of int is calling repeat with 7, 3
    calling _expect_eq_int with (calling out.len), 3, "repeat len"
    calling _expect_eq_int with (out at 1), 7, "repeat value"
test "repeat con times no positivo devuelve lista vacía":
    var out as list of int is calling repeat with 7, 0
    calling _expect_eq_int with (calling out.len), 0, "repeat zero"

# --- API nueva ---

test "zip_with combina dos listas con una función":
    var _a98 as list of int is [3, 1, 2]
    var _a99 as list of int is [1, 1, 1]
    var out as list of int is calling zip_with with _a98, _a99, (lambda a as int, b as int into a + b)
    calling _expect_eq_int with (out at 0), 4, "zip_with sum"
test "zip_with admite tipos distintos de entrada":
    var _a100 as list of int is [3, 1]
    var _a101 as list of float is [0.5, 0.5]
    var out as list of float is calling zip_with with _a100, _a101, (lambda a as int, b as float into (a to float) + b)
    calling _expect_eq_float with (out at 0), 3.5, "zip_with mixed"
test "chunk divide en tramos consecutivos":
    var _a102 as list of int is [3, 1, 4, 1, 5]
    var out as list of list of int is calling chunk with _a102, 2
    calling _expect_eq_int with (calling out.len), 3, "chunk count"
    var last as list of int is out at 2
    calling _expect_eq_int with (calling last.len), 1, "chunk last len"
test "chunk con span mayor que la lista da un tramo":
    var _a104 as list of int is [3, 1, 4]
    var out as list of list of int is calling chunk with _a104, 9
    calling _expect_eq_int with (calling out.len), 1, "chunk big span"
test "windowed produce ventanas deslizantes":
    var _a105 as list of int is [3, 1, 4, 1, 5]
    var out as list of list of int is calling windowed with _a105, 3
    calling _expect_eq_int with (calling out.len), 3, "windowed count"
    var w1 as list of int is out at 1
    calling _expect_eq_int with (w1 at 0), 1, "windowed second start"
test "running_sum acumula los prefijos":
    var _a107 as list of int is [3, 1, 2]
    var out as list of int is calling running_sum with _a107
    calling _expect_eq_int with (out at 0), 3, "running first"
    calling _expect_eq_int with (out at 2), 6, "running last"
test "scan_left acumula con la función dada":
    var _a109 as list of int is [1, 2, 3]
    var out as list of int is calling scan_left with _a109, (lambda acc as int, x as int into acc + x)
    calling _expect_eq_int with (out at 1), 3, "scan second"
    calling _expect_eq_int with (out at 2), 6, "scan third"
test "scan_left es genérico sobre float":
    var fs as list of float is [2.5, -1.5, 4.5]
    var out as list of float is calling scan_left with fs, (lambda acc as float, x as float into acc + x)
    calling _expect_eq_float with (out at 2), 5.5, "float scan"
test "min_max devuelve [min, max]":
    var _a110 as list of int is [3, 1, 4, 1, 5]
    var out as list of int is calling min_max with _a110
    calling _expect_eq_int with (out at 0), 1, "min_max min"
    calling _expect_eq_int with (out at 1), 5, "min_max max"
test "enumerate_pairs devuelve pares [índice, valor]":
    var _a112 as list of int is [3, 1]
    var out as list of list of int is calling enumerate_pairs with _a112
    var p1 as list of int is out at 1
    calling _expect_eq_int with (p1 at 0), 1, "pair index"
    calling _expect_eq_int with (p1 at 1), 1, "pair value"
test "partition_by separa según el predicado":
    var _a114 as list of int is [3, 1, 4, 1, 5]
    var out as list of list of int is calling partition_by with _a114, (lambda x as int into (x % 2) == 0)
    var yes as list of int is out at 0
    var no as list of int is out at 1
    calling _expect_eq_int with (calling yes.len), 1, "partition yes"
    calling _expect_eq_int with (calling no.len), 4, "partition no"
test "frequencies cuenta cada valor":
    var _a115 as list of int is [3, 1, 3]
    var m as map of int to int is calling frequencies with _a115
    calling _expect_eq_int with (calling m.get with 3), 2, "freq three"
    calling _expect_eq_int with (calling m.get with 1), 1, "freq one"
test "group_count es alias de frequencies":
    var _a116 as list of int is [2, 2, 2]
    var m as map of int to int is calling group_count with _a116
    calling _expect_eq_int with (calling m.get with 2), 3, "group count"
# --- Casos borde ---

test "una lista de un solo elemento se reduce a sí misma":
    var _a118 as list of int is [42]
    calling _expect_eq_int with (calling sum with _a118), 42, "single sum"
    calling _expect_eq_int with (calling max_val with _a118), 42, "single max"
    calling _expect_eq_int with (calling median with _a118), 42, "single median"
test "una lista de negativos conserva el signo en las reducciones":
    var _a119 as list of int is [-3, -1, -2]
    calling _expect_eq_int with (calling sum with _a119), -6, "neg sum"
    calling _expect_eq_int with (calling max_val with _a119), -1, "neg max"
    calling _expect_eq_int with (calling min_val with _a119), -3, "neg min"
test "los duplicados afectan a count_of y unique":
    var _a120 as list of int is [1, 2, 1, 2, 3]
    calling _expect_eq_int with (calling count_of with _a120, 2), 2, "dups count"
    var out as list of int is calling unique with _a120
    calling _expect_eq_int with (calling out.len), 3, "dups unique"
test "las operaciones sobre la lista vacía son seguras":
    var _a121 as list of int is list of int
    calling _expect_eq_int with (calling sum with _a121), 0, "empty sum"
    calling _expect_eq_int with (calling product with _a121), 1, "empty product"
    calling _expect_eq_int with (calling len with _a121), 0, "empty len"
    calling _expect_eq_bool with (calling is_empty with _a121), true, "empty is_empty"
