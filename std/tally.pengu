## is empty. Borrows `l`.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1, 3]
## calling mode with xs    # 3
## ```
weave mode shard T where T: Donum and T: Par with l as list of T into T:
    let n as int is calling l.len
    if n == 0:
        return donum T
    var best as T is l at 0
    var best_count as int is 0
    for x in l:
        var count_n as int is 0
        for y in l:
            if y == x:
                set count_n is count_n + 1
        if count_n > best_count:
            set best_count is count_n
            set best is x
    return best

## Functional form of `reverse`: copy with the elements reversed.
