##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1]
## calling map_increment with xs, 2    # [5, 3]
## ```
weave map_increment shard T where T: Num with l as list of T, delta as int is 1 into list of T:
    let d as T is delta
    return for x in l then (x + d)

# --- New API (generic) --------------------------------------------------

## Combines `xs` and `ys` with `f` up to the shorter list.
##
## ## Parámetros
## - `xs`: first list. Read only.
## - `ys`: second list. Read only.
## - `f`: binary weave `with a as T, b as U into V`.
##
## ## Retorno
## A new owned `list of V`, one element per position of the shorter input;
## release it with `banish`.
##
## ## Memoria
## `xs` and `ys` are only read; the result is a fresh list that the caller
## releases with `banish`.
##
## ## Ejemplo
## ```pengu
## weave add with a as int, b as int into int:
##     return a + b
##
## var xs as list of int is [3, 1]
## var ys as list of int is [1, 1]
## calling zip_with with xs, ys, add    # [4, 2]
## ```
weave zip_with shard T and U and V with xs as list of T, ys as list of U, f as weave with a as T, b as U into V into list of V:
    let na as int is calling xs.len
    let nb as int is calling ys.len
    let limit as int is (if nb < na then nb else na)
    var idxs as list of int is list of int
    defer banish idxs
    var i as int is 0
    while i < limit:
        calling idxs.push with i
        set i is i + 1
    for k in idxs then (calling f with (xs at k), (ys at k))

## Splits `xs` into consecutive runs of `span` elements; the last one may be
## shorter.
##
## ## Parámetros
## - `xs`: the list to split. Read only.
## - `span`: run length; `span <= 0` gives an empty list.
##
## ## Retorno
## A new owned `list of list of T`; release every inner list and the outer one
## with `banish`.
##
## ## Memoria
## Each inner list and the outer list are freshly allocated.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1, 4, 1, 5]
## calling chunk with xs, 2    # [[3, 1], [4, 1], [5]]
## ```
weave chunk shard T with xs as list of T, span as int into list of list of T:
    let n as int is calling xs.len
    if span <= 0:
        return for x in xs when false then x
    var out as list of list of T is list of list of T
    var c as int is 0
    while c < n:
        let stop as int is (if (c + span) < n then (c + span) else n)
        var piece as list of T is list of T
        var i as int is c
        while i < stop:
            calling piece.push with (xs at i)
            set i is i + 1
        calling out.push with piece
        set c is stop
    return out

## Sliding windows of width `width`.
##
## ## Parámetros
## - `xs`: the list to window. Read only.
## - `width`: window length; `width <= 0`, or greater than the list, gives an
##   empty list.
##
## ## Retorno
## A new owned `list of list of T`; release every inner list and the outer one
## with `banish`.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1, 4]
## calling windowed with xs, 2    # [[3, 1], [1, 4]]
## ```
weave windowed shard T with xs as list of T, width as int into list of list of T:
    let n as int is calling xs.len
    if width <= 0:
        return for x in xs when false then x
    if width > n:
        return for x in xs when false then x
    var out as list of list of T is list of list of T
    var c as int is 0
    let last_start as int is (n - width)
    while c <= last_start:
        var piece as list of T is list of T
        var j as int is 0
        while j < width:
            calling piece.push with (xs at (c + j))
            set j is j + 1
        calling out.push with piece
        set c is c + 1
    return out

## Cumulative scan with `f`, seeded with the first element.
##
## The result has the same length as `xs` and `out[0] = xs[0]`; every later
## position is `f(previous, current)`, so `scan_left` with `+` equals
## `running_sum`.
##
## ## Parámetros
## - `xs`: the list to scan. Read only.
## - `f`: binary weave `with acc as T, x as T into T`.
##
## ## Retorno
## A new owned `list of T` with the prefix results; release it with `banish`. An
## empty input gives an empty list.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [1, 2, 3]
## calling scan_left with xs, (lambda acc as int, x as int into acc + x)    # [1, 3, 6]
## ```
weave scan_left shard T where T: Num with xs as list of T, f as weave with acc as T, x as T into T into list of T:
    let n as int is calling xs.len
    if n == 0:
        return for x in xs then x
    var out as list of T is list of T
    var seed as int is 0
    while seed < n:
        calling out.push with (xs at 0)
        set seed is seed + 1
    var i as int is 0
    while i < n:
        set out at i is (calling f with (if i > 0 then (out at (i - 1)) else donum T), (xs at i))
        set i is i + 1
    return out

## Cumulative (prefix) sums of `xs`.
##
## ## Parámetros
## - `xs`: the list to accumulate. Read only.
##
## ## Retorno
## A new owned `list of T` where position `i` is the sum of `xs[0..i]`; release
## it with `banish`. An empty input gives an empty list.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1, 2]
## calling running_sum with xs    # [3, 4, 6]
## ```
weave running_sum shard T where T: Num with xs as list of T into list of T:
    let n as int is calling xs.len
    if n == 0:
        return for x in xs then x
    var out as list of T is list of T
    var seed as int is 0
    while seed < n:
        calling out.push with (xs at 0)
        set seed is seed + 1
    var i as int is 0
    while i < n:
        set out at i is ((xs at i) + (if i > 0 then (out at (i - 1)) else donum T))
        set i is i + 1
    return out

## Minimum and maximum as a two-element list `[min, max]`.
##
## ## Parámetros
## - `xs`: the list to scan. Read only.
##
## ## Retorno
## A new owned `list of T` with exactly two elements, or an empty list when
## `xs` is empty; release it with `banish`. The module uses no tuples, so it
## does not depend on `std.oracle`.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1, 4]
## calling min_max with xs    # [1, 4]
## ```
weave min_max shard T where T: Ordered with xs as list of T into list of T:
    var out as list of T is list of T
    if (calling xs.len) == 0:
        return out
    var lo as T is xs at 0
    var hi as T is xs at 0
    for x in xs:
        let c_lo as int is calling x.cmp with lo
        if c_lo < 0:
            set lo is x
        let c_hi as int is calling x.cmp with hi
        if c_hi > 0:
            set hi is x
    calling out.push with lo
    calling out.push with hi
    return out

## `[index, value]` pairs of `xs`, in order.
##
## The pair stays `list of int` because its first component is an index, so this
## function keeps the concrete `list of int` receiver.
##
## ## Parámetros
## - `xs`: the list to enumerate. Read only.
##
## ## Retorno
## A new owned `list of list of int` with one `[index, value]` pair per element;
## release every inner list and the outer one with `banish`.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1]
## calling enumerate_pairs with xs    # [[0, 3], [1, 1]]
## ```
weave _enumerate_pairs_int with xs as list of int into list of list of int:
    var out as list of list of int is list of list of int
    var i as int is 0
    for x in xs:
        var pair as list of int is list of int
        calling pair.push with i
        calling pair.push with x
        calling out.push with pair
        set i is i + 1
    return out

## Pairs every element with its index as `[index, value]`.
##
## ## Parámetros
## - `xs`: the list to enumerate. Read only.
##
## ## Retorno
## A new owned `list of list of int` with one two-element list per input
## element; release every inner list and the outer one with `banish`.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1]
## calling enumerate_pairs with xs    # [[0, 3], [1, 1]]
## ```
weave enumerate_pairs with xs as list of int into list of list of int:
    return calling _enumerate_pairs_int with xs

## Partitions `xs` with `predicate` into `[matching, non_matching]`.
##
## The predicate stays `int`-typed, so this function keeps the concrete
## `list of int` receiver.
##
## ## Parámetros
## - `xs`: the list to partition. Read only.
## - `predicate`: unary weave `with x as int into bool`.
##
## ## Retorno
## A new owned `list of list of int` with exactly two lists (either may be
## empty); release every inner list and the outer one with `banish`.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1, 4]
## calling partition_by with xs, (lambda x as int into (x % 2) == 0)    # [[4], [3, 1]]
## ```
weave partition_by with xs as list of int, predicate as weave with x as int into bool into list of list of int:
    var yes as list of int is list of int
    var no as list of int is list of int
    for x in xs:
        if calling predicate with x:
            calling yes.push with x
        else:
            calling no.push with x
    var out as list of list of int is list of list of int
    calling out.push with yes
    calling out.push with no
    return out

## Frequency of every value of `xs` as a value -> count map.
##
## ## Parámetros
## - `xs`: the list to count. Read only.
##
## ## Retorno
## A new owned `map of T to int`; release it with `banish`. The empty list gives
## an empty map.
##
## ## Memoria
## The map is freshly allocated by the caller and released with `banish`.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [3, 1, 3]
## calling frequencies with xs    # 3 -> 2, 1 -> 1
## ```
weave frequencies shard T where T: Vinculum with xs as list of T into map of T to int:
    var m as map of T to int is map of T to int
    for x in xs:
        calling m.put with x, ((calling m.get with x) + 1)
    return m

## @deprecated Use `frequencies` instead.
##
## ## Parámetros
## - `xs`: the list to count. Read only.
##
## ## Retorno
## Same as `frequencies`; kept only for compatibility.
##
## ## Ejemplo
## ```pengu
## var xs as list of int is [2, 2]
## calling group_count with xs    # 2 -> 2
## ```
weave group_count shard T where T: Vinculum with xs as list of T into map of T to int:
    var m as map of T to int is map of T to int
    for x in xs:
        calling m.put with x, ((calling m.get with x) + 1)
    return m

# --- Private helpers ----------------------------------------------------

## Internal harness: panics with `label` when `cond` is false.
weave _expect with cond as bool, label as string into void:
    if not cond:
        calling spark.panic with "tally test failed: {label}"

## Internal harness: integer equality.
weave _expect_eq_int with actual as int, expected as int, label as string into void:
    if actual != expected:
        calling spark.panic with "tally test failed: {label}: {(actual to string)} != {(expected to string)}"

## Internal harness: float equality.
weave _expect_eq_float with actual as float, expected as float, label as string into void:
    if actual != expected:
        calling spark.panic with "tally test failed: {label}"

## Internal harness: boolean equality.
weave _expect_eq_bool with actual as bool, expected as bool, label as string into void:
    if actual != expected:
        calling spark.panic with "tally test failed: {label}"

# --- Tests --------------------------------------------------------------

test "TALLY_VERSION is 2.2.0":
    calling _expect with TALLY_VERSION == "2.2.0", "version"

# --- Length and access ---
test "is_empty is true for the empty list":
    let _a1 as list of int is list of int
    calling _expect_eq_bool with (calling is_empty with _a1), true, "is_empty empty"
test "is_empty is false with elements":
    let _a2 as list of int is [1]
    calling _expect_eq_bool with (calling is_empty with _a2), false, "is_empty one"
test "len returns the number of elements":
    let _a3 as list of int is [3, 1, 4, 1, 5]
    calling _expect_eq_int with (calling len with _a3), 5, "len"
test "first returns the first element":
    let _a4 as list of int is [3, 1, 2]
    calling _expect_eq_int with (calling first with _a4), 3, "first"
test "first returns 0 on the empty list":
    let _a5 as list of int is list of int
    calling _expect_eq_int with (calling first with _a5), 0, "first empty"
test "last returns the last element":
    let _a6 as list of int is [3, 1, 2]
    calling _expect_eq_int with (calling last with _a6), 2, "last"
test "last returns 0 on the empty list":
    let _a7 as list of int is list of int
    calling _expect_eq_int with (calling last with _a7), 0, "last empty"
test "at_or returns the element in range":
    let _a8 as list of int is [3, 1, 2]
    calling _expect_eq_int with (calling at_or with _a8, 1), 1, "at_or in range"
test "at_or returns the default out of range":
    let _a9 as list of int is [3, 1, 2]
    calling _expect_eq_int with (calling at_or with _a9, 9, -1), -1, "at_or default"
test "at_or returns the default for a negative index":
    let _a10 as list of int is [3, 1, 2]
    calling _expect_eq_int with (calling at_or with _a10, -1, 7), 7, "at_or negative"
test "the at_or method uses its default 0":
    let xs as list of int is [3, 1, 2]
    calling _expect_eq_int with (calling xs.at_or with 99), 0, "method at_or default"
test "at_safe returns some for a valid index":
    let _a11 as list of int is [3, 1, 2]
    let m as maybe int is calling at_safe with _a11, 2
    calling _expect_eq_int with m.value, 2, "at_safe present"
test "at_safe returns none out of range":
    let _a12 as list of int is [3, 1, 2]
    let m as maybe int is calling at_safe with _a12, 9
    calling _expect_eq_bool with m.is_present, false, "at_safe none"
test "the at_safe method rejects negative indices":
    let xs as list of int is [3, 1, 2]
    let m as maybe int is calling xs.at_safe with -1
    calling _expect_eq_bool with m.is_present, false, "method at_safe negative"
test "the first and last methods work on int":
    let xs as list of int is [3, 1, 2]
    calling _expect_eq_int with (calling xs.first), 3, "method first"
    calling _expect_eq_int with (calling xs.last), 2, "method last"
test "the reverse method matches the module function":
    let xs as list of int is [3, 1, 2]
    let by_method as list of int is calling xs.reverse
    let by_func as list of int is calling reverse with xs
    calling _expect_eq_int with (by_method at 0), 2, "method reverse first"
    calling _expect_eq_int with (by_func at 0), 2, "func reverse first"
test "the flatten method returns an identity copy":
    let xs as list of int is [3, 1, 2]
    let out as list of int is calling xs.flatten
    calling _expect_eq_int with (calling out.len), 3, "method flatten len"
    calling _expect_eq_int with (out at 1), 1, "method flatten value"
test "the take method clips and uses its default":
    let xs as list of int is [3, 1, 4]
    let one as list of int is calling xs.take
    let two as list of int is calling xs.take with 2
    calling _expect_eq_int with (calling one.len), 1, "method take default"
    calling _expect_eq_int with (two at 1), 1, "method take second"
test "the drop method skips leading elements":
    let xs as list of int is [3, 1, 4]
    let out as list of int is calling xs.drop with 1
    calling _expect_eq_int with (calling out.len), 2, "method drop len"
    calling _expect_eq_int with (out at 0), 1, "method drop first"
test "the slice_list method cuts a generic range":
    let xs as list of float is [2.5, -1.5, 4.5]
    let out as list of float is calling xs.slice_list with 1, 3
    calling _expect_eq_int with (calling out.len), 2, "method slice len"
    calling _expect_eq_float with (out at 0), -1.5, "method slice first"
# --- Search ---
test "contains finds a present element":
