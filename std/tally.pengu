test "find_first_gt returns none when nothing beats it":
    let _a21 as list of int is [3, 1, 2]
    let m as maybe int is calling find_first_gt with _a21, 9
    calling _expect_eq_bool with m.is_present, false, "find_first_gt none"
test "find_first_lt returns the first smaller element":
    let _a22 as list of int is [3, 1, 4]
    let m as maybe int is calling find_first_lt with _a22, 2
    calling _expect_eq_int with m.value, 1, "find_first_lt"
test "the count_of method matches the function":
    let xs as list of int is [3, 1, 4, 1, 5]
    calling _expect_eq_int with (calling xs.count_of with 1), 2, "method count_of"
test "the last_index_of method matches the function":
    let xs as list of int is [3, 1, 4, 1, 5]
    calling _expect_eq_int with (calling xs.last_index_of with 1), 3, "method last_index_of"
test "the find_first methods return maybe":
    let xs as list of int is [3, 1, 4]
    let gt as maybe int is calling xs.find_first_gt with 3
    let lt as maybe int is calling xs.find_first_lt with 2
