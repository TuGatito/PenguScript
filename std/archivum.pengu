## std/archivum.pengu — file-system operations: reading, writing, copying,
## moving, deleting, listing, metadata and searching.
##
## Every operation delegates to a `declare`d C runtime primitive; the module
## itself adds the ergonomics (`maybe`/`bool` answers plus `result` variants that
## report *why* an operation failed) and the recursive helpers (`copy_tree`,
## `walk`, `list_files_recursive`, `dir_size`, `find_*`).
##
## ## Example
## ```pengu
## import std.archivum
## import std.spark
##
## weave main into int:
##     let path as string is "/tmp/archivum_demo.txt"
##     if calling archivum.write_file with path, "hello\nworld\n":
##         let text as maybe string is calling archivum.read_file with path
##         if text.is_present:
##             calling spark.println with text.value
##     calling archivum.delete_file with path
##     return 0
## ```
##
## ## Memory
## A `string` is a value: inputs are borrowed and never banished by this module.
## Every returned `string`, `list`, `map` and `result` payload is freshly
## allocated and owned by the caller, so release it with `banish` (and the
## elements of a returned `list of string` individually) when it is no longer
## needed. The `result` variants rebuild their container instead of returning a
## parameter: `calling ok_of with v` / `calling err_of with e`.
##
## ## Design notes
## - **Two answers per question.** The `maybe`/`bool` weaves answer "is it
##   there?" and stay the right tool for that. The `*_result` weaves answer "it
##   failed, and why", with `IoError` as the error type; they are built with
##   `calling ok_of` / `calling err_of`.
## - **No `+` on strings** (E0005): every composition uses `"{expr}"`
##   interpolation, including the byte-count loops.
## - **Directory entry names only.** `read_dir` mirrors the runtime primitive and
##   returns bare names; `read_dir_full` is the convenience weave that joins each
##   entry with the directory with `std.compass.join`.
## - **Recursion is explicit.** `copy_tree`, `walk`, `find_dirs`,
##   `list_files_recursive` and `dir_size` keep their own stack/list instead of
##   calling themselves, which keeps the generated C flat.
## - **Permissions are checked through `metadata`.** `is_readable`/`is_writable`
##   require `exists and is_file` and then inspect the POSIX mode bits reported by
##   `permissions` (read: `0400 | 0040 | 0004`, write: `0200 | 0020 | 0002`).
## - **External `enchanting`.** The optional `enchanting compass.Path` block adds
##   filesystem methods to `compass.Path`; it delegates through `self->raw` and
##   never touches `std/compass.pengu`.
## - **Internal tests without `std.ward`** (`ward` would create an import cycle):
##   the `# --- Tests ---` section uses a private harness on top of `spark.panic`.
##
## ## Migration
##
## `2.0.0` → `2.1.0` is additive: no symbol was removed, renamed or given new
## bounds/behaviour.
##
## | Added | Purpose |
## |---|---|
## | `read_text` / `write_text` | explicit aliases of `read_file` / `write_file` |
## | `read_last_n_lines` | tail of a file, complementing `read_first_n_lines` |
## | `read_dir_full` | `read_dir` entries already joined with the directory |
## | `is_readable` / `is_writable` | existence + regular file + mode check |
## | `read_lines_result`, `write_lines_result`, `read_dir_result`, `create_dir_result`, `remove_dir_result`, `copy_file_result`, `copy_tree_result`, `append_lines_result`, `touch_result`, `symlink_result`, `metadata_result` | `result of T to IoError` variants of the weaves above |
## | `enchanting compass.Path` | `read_text`, `write_text`, `read_lines`, `append_text`, `delete`, `mkdir`, `rmdir`, `iter_dir`, `stat` |

import std.spark
import std.oracle
import std.compass
import std.scrolls
import std.tally
import std.rites

# ----------------------------------------------------------------------------
# Version Constant
# ----------------------------------------------------------------------------

## Module version identifier for std.archivum.
const ARCHIVUM_VERSION as string is "2.13.0"

# ----------------------------------------------------------------------------
# External C Runtime Declarations
# ----------------------------------------------------------------------------

# Runtime primitive: reads the whole file at `path` as UTF-8 text.
declare pengu_c_archivum_read_file with path as string into maybe string
# Runtime primitive: writes `content` to `path`, truncating any existing file.
declare pengu_c_archivum_write_file with path as string, content as string into bool
# Runtime primitive: appends `content` to `path`, creating it when missing.
declare pengu_c_archivum_append_file with path as string, content as string into bool
# Runtime primitive: deletes the entry at `path`.
declare pengu_c_archivum_delete_file with path as string into bool
# Runtime primitive: true when an entry exists at `path`.
declare pengu_c_archivum_exists with path as string into bool
# Runtime primitive: true when `path` is a regular file.
declare pengu_c_archivum_is_file with path as string into bool
# Runtime primitive: true when `path` is a directory.
declare pengu_c_archivum_is_dir with path as string into bool
# Runtime primitive: true when `path` is a symbolic link.
declare pengu_c_archivum_is_symlink with path as string into bool
# Runtime primitive: creates the directory at `path`.
declare pengu_c_archivum_create_dir with path as string, parents as bool into bool
# Runtime primitive: removes the directory at `path`.
declare pengu_c_archivum_remove_dir with path as string, recursive as bool into bool
# Runtime primitive: lists the direct entry names of `path`.
declare pengu_c_archivum_read_dir with path as string into maybe list of string
# Runtime primitive: copies file `src` to `dst`.
declare pengu_c_archivum_copy_file with src as string, dst as string, overwrite as bool into bool
# Runtime primitive: moves file `src` to `dst`.
declare pengu_c_archivum_move_file with src as string, dst as string, overwrite as bool into bool
# Runtime primitive: renames entry `old` to `new`.
declare pengu_c_archivum_rename with old as string, new as string into bool
# Runtime primitive: stat()es `path` into an owned map of string to string.
declare pengu_c_archivum_metadata with path as string into maybe map of string to string
# Runtime primitive: globs `pattern` from the working directory.
declare pengu_c_archivum_glob with pattern as string into list of string
# Runtime primitive: walks `root` depth-first into an owned nested list.
declare pengu_c_archivum_walk with root as string into list of list of string
# Runtime primitive: updates modification time of `path`.
declare pengu_c_archivum_touch with path as string into bool
# Runtime primitive: creates symbolic link `link` pointing at `target`.
declare pengu_c_archivum_symlink with target as string, link as string into bool
# Runtime primitive: resolves the target of the symlink at `path`.
declare pengu_c_archivum_read_symlink with path as string into maybe string
# Runtime primitive: canonicalizes `path` to an absolute path.
declare pengu_c_archivum_realpath with path as string into maybe string

# The `insignia` prefixes every top-level C name of this module, so the weaves
# `rename`, `symlink` and `realpath` do not collide with the libc functions of
# the same name when `std/archivum.pengu` is the bundle entry. It sits after the
# `declare`s, which already carry their own `pengu_c_` prefix.
insignia archivum_

# ----------------------------------------------------------------------------
# Linear string bridges (`antiquus`)
#
# The line helpers below must not grow their result with
# `set out is "{out}{piece}"`: every such step copies the whole accumulator and
# leaks the previous buffer under the manual memory model (the compiler releases
# nothing automatically). These two bridges allocate once and copy once, exactly
# like the codecs of `std/cipher.pengu`.
# ----------------------------------------------------------------------------

## Returns a fresh owned copy of `s` (`pengu_string_copy` without a public symbol).
##
## ## Motivo
## `pengu_string_split` returns a list whose elements are *views* into the source
## buffer, so a split result cannot outlive the string it came from. The line
## readers need owned elements in order to release the file text they read; this
## bridge deep-copies one view without adding a public `declare` for the runtime
## primitive (which `std/filum.pengu` already owns).
##
## ## Memoria
## Allocates one owned buffer and returns it; the caller releases it with
## `banish`. The input `s` is borrowed and never freed.
antiquus _copy_string with s as string into string:
    r"""
return pengu_string_copy(s);
"""

## Joins `lines` with "\n" and appends one trailing "\n".
##
## ## Motivo
## The PenguScript spelling of a linear join (`for x in lines: out = "{out}{x}"`)
## is quadratic and leaks the accumulator on every step. This block sums the
## lengths, allocates the result once and `memcpy`s each piece, so the cost is
## linear and the copy is binary-exact (embedded NULs survive, matching
## `pengu_string_format_ex`).
##
## ## Memoria
## Allocates one owned buffer of exactly the joined length (plus the NUL) and
## returns it; the caller releases it with `banish`. The input list and its
## strings are only read, never retained.
antiquus _join_lines with lines as list of string into string:
    r"""
const PenguString *items = (const PenguString *)lines.data;
size_t total = 0;
for (int i = 0; i < lines.len; i++) {
  if (items[i].len > 0) total += (size_t)items[i].len;
}
/* One "\n" per element plus the trailing one; an empty list still yields "\n". */
total += (lines.len > 0) ? (size_t)lines.len : (size_t)1;
char *buf = (char *)malloc(total + 1);
if (!buf) return pengu_string_from_cstr("");
size_t off = 0;
for (int i = 0; i < lines.len; i++) {
  if (i > 0) buf[off++] = '\n';
  if (items[i].len > 0 && items[i].data) {
    memcpy(buf + off, items[i].data, (size_t)items[i].len);
    off += (size_t)items[i].len;
  }
}
buf[off++] = '\n';
buf[off] = '\0';
PenguString s;
s.data = buf;
s.len = (int)off;
s.is_owned = 1;
return s;
"""

# ----------------------------------------------------------------------------
# Core File Operations
# ----------------------------------------------------------------------------

## Reads the whole file at `path` as UTF-8 text.
##
## ## Parámetros
## - `path`: the file to read. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the owned file text, or `maybe none` when the file is missing or
## cannot be read. Release the text with `banish` when it is an owned copy.
##
## ## Ejemplo
## ```pengu
## let text as maybe string is calling archivum.read_file with "notes.txt"
## ```
weave read_file with path as string into maybe string:
    return calling pengu_c_archivum_read_file with path

## Reads the whole file at `path` as UTF-8 text (alias of `read_file`).
##
## ## Parámetros
## - `path`: the file to read. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the owned text, or `maybe none` on failure.
##
## ## Ejemplo
## ```pengu
## let text as maybe string is calling archivum.read_text with "notes.txt"
## ```
weave read_text with path as string into maybe string:
    return calling read_file with path

## Reads file bytes as an owned string buffer. Alias of read_file.
##
## ## Parámetros
## - `path`: the file to read. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the owned byte buffer, or `maybe none` on failure. No UTF-8
## decoding is performed; the buffer is the raw bytes.
##
## ## Ejemplo
## ```pengu
## let data as maybe string is calling archivum.read_bytes with "logo.png"
## ```
weave read_bytes with path as string into maybe string:
    return calling pengu_c_archivum_read_file with path

## Writes `content` verbatim to `path`, creating or truncating the file. Returns true on success.
##
## ## Parámetros
## - `path`: destination file. Missing parent directories are not created.
## - `content`: the exact text to store. It is borrowed.
##
## ## Retorno
## `true` when the runtime wrote the file, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling archivum.write_file with "notes.txt", "hello"
## ```
weave write_file with path as string, content as string into bool:
    return calling pengu_c_archivum_write_file with path, content

## Writes `content` verbatim to `path` (alias of `write_file`).
##
## ## Parámetros
## - `path`: destination file.
## - `content`: the exact text to store. It is borrowed.
##
## ## Retorno
## `true` on success, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling archivum.write_text with "notes.txt", "hello"
## ```
weave write_text with path as string, content as string into bool:
    return calling write_file with path, content

## Writes binary data buffer to `path`. Alias of write_file.
##
## ## Parámetros
## - `path`: destination file.
## - `data`: the raw bytes to store. It is borrowed.
##
## ## Retorno
## `true` on success, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling archivum.write_bytes with "blob.bin", payload
## ```
weave write_bytes with path as string, data as string into bool:
    return calling pengu_c_archivum_write_file with path, data

# ----------------------------------------------------------------------------
# Result-based I/O (roadmap 4.4 / decision D5)
#
# The `maybe`/`bool` APIs above are kept unchanged for backwards compatibility:
# `maybe` answers "is it there?" and stays the right tool for that question.
# These variants answer "it failed, and *why*", which `maybe`/`bool` cannot.
# ----------------------------------------------------------------------------

## Cause of an I/O failure, used as the error type of the `*_result` weaves.
omen IoError:
    NotFound
    IsADirectory
    NotAFile
    Permission
    Unknown

## Reads the whole file at `path` as UTF-8, reporting the failure cause.
##
## ## Parámetros
## - `path`: the file to read. It is borrowed, not consumed.
##
## ## Retorno
## `ok` with the owned text, or `err` with the `IoError` cause. The result owns
## its payload; release it with `banish` when it is a `string`.
##
## ## Efectos
## Returns `err(IoError.IsADirectory)` for a directory, `err(IoError.NotFound)`
## when the entry does not exist and `err(IoError.Unknown)` for any other
## failure.
##
## ## Ejemplo
## ```pengu
## let r as result of string to archivum.IoError is calling archivum.read_file_result with "notes.txt"
## ```
weave read_file_result with path as string into result of string to IoError:
    # Check the directory case first: opening a directory for reading succeeds
    # on POSIX but yields no bytes, which would otherwise be reported as an
    # empty (successful) file.
    if calling is_dir with path:
        return calling err_of with IoError.IsADirectory
    # The `or:` block moves the payload out of the `maybe` and frees only its
    # box, so the text stays owned by the returned `result` and no wrapper leaks.
    var content as string is (calling pengu_c_archivum_read_file with path) or:
        if not calling exists with path:
            return calling err_of with IoError.NotFound
        return calling err_of with IoError.Unknown
    return calling ok_of with content

## Writes `content` to `path`, reporting the failure cause. `result of int to
## IoError` succeeds with 0 (bytes written is not exposed by the runtime).
##
## ## Parámetros
## - `path`: destination file. It is borrowed, not consumed.
## - `content`: the exact text to store. It is borrowed.
##
## ## Retorno
## `ok(0)` on success, or `err` with the `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.IsADirectory)` when `path` names a directory and
## `err(IoError.Unknown)` for any other write failure.
##
## ## Ejemplo
## ```pengu
## let r as result of int to archivum.IoError is calling archivum.write_file_result with "notes.txt", "hi"
## ```
weave write_file_result with path as string, content as string into result of int to IoError:
    if calling is_dir with path:
        return calling err_of with IoError.IsADirectory
    var written as bool is calling pengu_c_archivum_write_file with path, content
    if written:
        return calling ok_of with 0
    return calling err_of with IoError.Unknown

## Deletes the entry at `path`, reporting the failure cause.
##
## ## Parámetros
## - `path`: the entry to delete. It is borrowed, not consumed.
##
## ## Retorno
## `ok(0)` on success, or `err` with the `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.NotFound)` when the entry does not exist,
## `err(IoError.IsADirectory)` for a directory and `err(IoError.Unknown)`
## otherwise.
##
## ## Ejemplo
## ```pengu
## let r as result of int to archivum.IoError is calling archivum.delete_file_result with "notes.txt"
## ```
weave delete_file_result with path as string into result of int to IoError:
    if not calling exists with path:
        return calling err_of with IoError.NotFound
    if calling is_dir with path:
        return calling err_of with IoError.IsADirectory
    var deleted as bool is calling pengu_c_archivum_delete_file with path
    if deleted:
        return calling ok_of with 0
    return calling err_of with IoError.Unknown

## Returns the human-readable message of an `IoError`.
##
## ## Parámetros
## - `e`: the error value to describe. It is a value type, copied in.
##
## ## Retorno
## An owned `string` with a short English message; release it with `banish`. The
## text is the same for every platform.
##
## ## Ejemplo
## ```pengu
## calling archivum.describe_error with archivum.IoError.NotFound     # "no such file or directory"
## ```
weave describe_error with e as IoError into string:
    judge e:
        when IoError.NotFound -> "no such file or directory"
        when IoError.IsADirectory -> "is a directory"
        when IoError.NotAFile -> "not a regular file"
        when IoError.Permission -> "permission denied"
        else -> "unknown I/O error"

# ----------------------------------------------------------------------------
# Extended File Operations
# ----------------------------------------------------------------------------

## Appends `content` to the end of `path`, creating it when missing. Returns true on success.
##
## ## Parámetros
## - `path`: destination file.
## - `content`: the exact text to append. It is borrowed.
##
## ## Retorno
## `true` when the runtime appended the text, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling archivum.append_file with "notes.txt", "more\n"
## ```
weave append_file with path as string, content as string into bool:
    return calling pengu_c_archivum_append_file with path, content

## Appends binary data buffer to `path`. Alias of append_file.
##
## ## Parámetros
## - `path`: destination file.
## - `data`: the raw bytes to append. It is borrowed.
##
## ## Retorno
## `true` on success, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling archivum.append_bytes with "blob.bin", extra
## ```
weave append_bytes with path as string, data as string into bool:
    return calling pengu_c_archivum_append_file with path, data

## Deletes the entry (file, empty dir or symlink) at `path`. Returns true on success.
##
## ## Parámetros
## - `path`: the entry to delete. It is borrowed, not consumed.
##
## ## Retorno
## `true` when the runtime removed the entry, `false` otherwise. Use `remove_dir`
## for a non-empty directory.
##
## ## Ejemplo
## ```pengu
## calling archivum.delete_file with "notes.txt"
## ```
weave delete_file with path as string into bool:
    return calling pengu_c_archivum_delete_file with path

## Returns true when any file system entry exists at `path`.
##
## ## Parámetros
## - `path`: the path to probe. It is borrowed, not consumed.
##
## ## Retorno
## `true` for a file, directory or symlink; `false` when nothing is there.
##
## ## Ejemplo
## ```pengu
## calling archivum.exists with "notes.txt"     # true
## ```
weave exists with path as string into bool:
    return calling pengu_c_archivum_exists with path

## Returns true when the entry at `path` is a regular file.
##
## ## Parámetros
## - `path`: the path to probe. It is borrowed, not consumed.
##
## ## Retorno
## `true` only for a regular file; `false` for a directory, a symlink to a
## directory or a missing path.
##
## ## Ejemplo
## ```pengu
## calling archivum.is_file with "notes.txt"     # true
## ```
weave is_file with path as string into bool:
    return calling pengu_c_archivum_is_file with path

## Returns true when the entry at `path` is a directory.
##
## ## Parámetros
## - `path`: the path to probe. It is borrowed, not consumed.
##
## ## Retorno
## `true` only for a directory; `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling archivum.is_dir with "/tmp"     # true
## ```
weave is_dir with path as string into bool:
    return calling pengu_c_archivum_is_dir with path

## Returns true when the entry at `path` is a symbolic link.
##
## ## Parámetros
## - `path`: the path to probe. It is borrowed, not consumed.
##
## ## Retorno
## `true` when the entry itself is a symlink (the link is not followed).
##
## ## Ejemplo
## ```pengu
## calling archivum.is_symlink with "latest"     # true
## ```
weave is_symlink with path as string into bool:
    return calling pengu_c_archivum_is_symlink with path

## Returns true when `path` exists, is a regular file and carries read permission.
##
## ## Parámetros
## - `path`: the file to probe. It is borrowed, not consumed.
##
## ## Retorno
## `true` when the entry exists, is a regular file and its POSIX mode has at
## least one read bit (`0400`, `0040` or `0004`); `false` otherwise.
##
## ## Efectos
## The check is advisory: it reads the mode bits reported by `metadata`, so an
## access-control list or a read-only mount can still deny the actual read.
##
## ## Ejemplo
## ```pengu
## calling archivum.is_readable with "notes.txt"     # true
## ```
weave is_readable with path as string into bool:
    return calling _has_mode_bit with path, 292

## Returns true when `path` exists, is a regular file and carries write permission.
##
## ## Parámetros
## - `path`: the file to probe. It is borrowed, not consumed.
##
## ## Retorno
## `true` when the entry exists, is a regular file and its POSIX mode has at
## least one write bit (`0200`, `0020` or `0002`); `false` otherwise.
##
## ## Efectos
## The check is advisory, like `is_readable`: a read-only mount can still deny
## the actual write.
##
## ## Ejemplo
## ```pengu
## calling archivum.is_writable with "notes.txt"     # true
## ```
weave is_writable with path as string into bool:
    return calling _has_mode_bit with path, 146

# ----------------------------------------------------------------------------
# Directories
# ----------------------------------------------------------------------------

## Creates the directory at `path`. When `parents` is true, creates missing ancestors.
##
## ## Parámetros
## - `path`: the directory to create. It is borrowed, not consumed.
## - `parents`: when `true`, missing ancestors are created as well (default
##   `false`).
##
## ## Retorno
## `true` when the directory exists after the call, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling archivum.create_dir with "/tmp/a/b", true
## ```
weave create_dir with path as string, parents as bool is false into bool:
    return calling pengu_c_archivum_create_dir with path, parents

## Removes directory at `path`. When `recursive` is true, deletes directory and its contents.
##
## ## Parámetros
## - `path`: the directory to remove. It is borrowed, not consumed.
## - `recursive`: when `true`, the directory is deleted with all of its contents
##   (default `false`).
##
## ## Retorno
## `true` when the runtime removed the directory, `false` otherwise.
##
## ## Efectos
## With `recursive` the deletion is immediate and irreversible; there is no
## trash can.
##
## ## Ejemplo
## ```pengu
## calling archivum.remove_dir with "/tmp/a", true
## ```
weave remove_dir with path as string, recursive as bool is false into bool:
    return calling pengu_c_archivum_remove_dir with path, recursive

## Lists the direct entry names inside `path` (excluding "." and "..").
##
## ## Parámetros
## - `path`: the directory to list. It is borrowed, not consumed.
##
## ## Retorno
## `some` with an owned `list of string` of bare entry names, or `maybe none`
## when `path` is not a readable directory. Release the list and its elements
## with `banish`.
##
## ## Ejemplo
## ```pengu
## let names as maybe list of string is calling archivum.read_dir with "/tmp"
## ```
weave read_dir with path as string into maybe list of string:
    return calling pengu_c_archivum_read_dir with path

## Lists the direct entries inside `path` with `path` joined to each name.
##
## ## Parámetros
## - `path`: the directory to list. It is borrowed, not consumed.
##
## ## Retorno
## A new owned `list of string`; it is empty when `path` is not a readable
## directory. Each element is `calling compass.join` of `path` and the entry
## name, so it can be passed straight back to `is_file`, `metadata`, etc.
## Release the list and its elements with `banish`.
##
## ## Memoria
## The list owns both its element buffer and the freshly joined strings.
##
## ## Ejemplo
## ```pengu
## let paths as list of string is calling archivum.read_dir_full with "/tmp"
## ```
weave read_dir_full with path as string into list of string:
    var out as list of string is list of string
    var entries as maybe list of string is calling read_dir with path
    if entries.is_present:
        var names as list of string is entries.value
        var i as int is 0
        while i < names.len:
            # `[path, names at i]` used to be rebuilt (and dropped) every
            # iteration; build one list, hand it to `join` and release it.
            var parts as list of string is list of string
            calling parts.push with path
            calling parts.push with (names at i)
            calling out.push with (calling compass.join with parts)
            banish parts
            set i is i + 1
        # The entry names are owned by the caller of `read_dir`; `out` keeps the
        # joined copies, so release every name and then the wrapper.
        var j as int is 0
        while j < names.len:
            banish (names at j)
            set j is j + 1
    banish entries
    return out

## Copies file `src` to `dst`. When `overwrite` is false, an existing `dst` makes copy fail.
##
## ## Parámetros
## - `src`: the source file. It is borrowed, not consumed.
## - `dst`: the destination file. It is borrowed, not consumed.
## - `overwrite`: when `true`, an existing `dst` is replaced (default `false`).
##
## ## Retorno
## `true` when the runtime copied the file, `false` otherwise. The directory tree
## is never created: the parent of `dst` must exist.
##
## ## Ejemplo
## ```pengu
## calling archivum.copy_file with "a.txt", "b.txt", true
## ```
weave copy_file with src as string, dst as string, overwrite as bool is false into bool:
    return calling pengu_c_archivum_copy_file with src, dst, overwrite

## Moves file `src` to `dst`. When `overwrite` is false, an existing `dst` makes move fail.
##
## ## Parámetros
## - `src`: the source file. It is borrowed, not consumed.
## - `dst`: the destination file. It is borrowed, not consumed.
## - `overwrite`: when `true`, an existing `dst` is replaced (default `false`).
##
## ## Retorno
## `true` when the runtime moved the file, `false` otherwise. A cross-device move
## is reported as a plain failure.
##
## ## Ejemplo
## ```pengu
## calling archivum.move_file with "a.txt", "b.txt", false
## ```
weave move_file with src as string, dst as string, overwrite as bool is false into bool:
    return calling pengu_c_archivum_move_file with src, dst, overwrite

## Renames entry `old` to `new` (an existing `new` is overwritten).
##
## ## Parámetros
## - `old`: the current path. It is borrowed, not consumed.
## - `new`: the new path. It is borrowed, not consumed.
##
## ## Retorno
## `true` when the runtime renamed the entry, `false` otherwise. Unlike
## `move_file`, an existing `new` is overwritten unconditionally.
##
## ## Ejemplo
## ```pengu
## calling archivum.rename with "a.txt", "b.txt"
## ```
weave rename with old as string, new as string into bool:
    return calling pengu_c_archivum_rename with old, new

## Reads metadata of entry `path` into an owned map of string to string.
##
## ## Parámetros
## - `path`: the entry to stat. It is borrowed, not consumed.
##
## ## Retorno
## `some` with an owned map of `string` to `string`, or `maybe none` when the
## entry does not exist or `stat` fails. Contract of the returned map keys:
## - "size": decimal string of file size in bytes (e.g. "1024").
## - "is_file": boolean string ("true" or "false").
## - "is_dir": boolean string ("true" or "false").
## - "is_symlink": boolean string ("true" or "false").
## - "modified": decimal string of Unix epoch timestamp in seconds (e.g. "1790346624").
## - "created": decimal string of Unix epoch timestamp in seconds.
## - "accessed": decimal string of Unix epoch timestamp in seconds.
## - "permissions": decimal string of POSIX permission mode bits (st_mode & 0777).
##
## ## Memoria
## The map and its key/value strings are owned by the caller. `banish` on the
## `maybe` frees the entry table only, so walk the map (`for k in md`), `banish`
## each key and its `md.get` value, and then `banish` the wrapper.
##
## ## Ejemplo
## ```pengu
## let md as maybe map of string to string is calling archivum.metadata with "notes.txt"
## ```
weave metadata with path as string into maybe map of string to string:
    return calling pengu_c_archivum_metadata with path

# ----------------------------------------------------------------------------
# Lines and Text Helpers
# ----------------------------------------------------------------------------

## Reads file and splits text on newline into an owned list of lines.
##
## ## Parámetros
## - `path`: the file to read. It is borrowed, not consumed.
##
## ## Retorno
## `some` with an owned `list of string`, or `maybe none` when the file cannot be
## read. The split is on "\n" only, so a trailing newline yields a final empty
## element and "\r\n" keeps the "\r". Release the list and its elements with
## `banish`.
##
## ## Ejemplo
## ```pengu
## let lines as maybe list of string is calling archivum.read_lines with "notes.txt"
## ```
weave read_lines with path as string into maybe list of string:
    var content as maybe string is calling read_file with path
    if content.is_present:
        var text as string is content.value
        var parts as list of string is calling text.split with "\n"
        # `split` hands back *views* into the file text, so every element is
        # deep-copied before the text is released: the returned list owns its
        # strings and `banish` on them is meaningful.
        var owned as list of string is list of string
        var i as int is 0
        while i < parts.len:
            calling owned.push with (calling _copy_string with (parts at i))
            set i is i + 1
        banish parts
        banish content
        return some owned
    banish content
    return maybe none

## Reads at most `n` lines from `path`.
##
## ## Parámetros
## - `path`: the file to read. It is borrowed, not consumed.
## - `n`: maximum number of lines to take. A non-positive `n` gives an empty
##   list.
##
## ## Retorno
## `some` with an owned `list of string` of up to `n` leading lines, or
## `maybe none` when the file cannot be read.
##
## ## Ejemplo
## ```pengu
## let head as maybe list of string is calling archivum.read_first_n_lines with "notes.txt", 3
## ```
weave read_first_n_lines with path as string, n as int into maybe list of string:
    var lines_opt as maybe list of string is calling read_lines with path
    if lines_opt.is_present:
        var all_l as list of string is lines_opt.value
        var out as list of string is list of string
        var count_v as int is 0
        while (count_v < n) and (count_v < all_l.len):
            # `push` copies the element struct, so `out` shares the buffer and
            # takes ownership of the elements it receives.
            calling out.push with (all_l at count_v)
            set count_v is count_v + 1
        # Release the elements that were not moved into `out`; banishing the
        # wrapper frees only the element buffer, never the strings it points at.
        var j as int is count_v
        while j < all_l.len:
            banish (all_l at j)
            set j is j + 1
        banish lines_opt
        return some out
    banish lines_opt
    return maybe none

## Reads the last `n` lines of `path`.
##
## ## Parámetros
## - `path`: the file to read. It is borrowed, not consumed.
## - `n`: maximum number of trailing lines to take. A non-positive `n` gives an
##   empty list; when the file has fewer than `n` lines, every line is returned.
##
## ## Retorno
## `some` with an owned `list of string` of at most `n` trailing elements, or
## `maybe none` when the file cannot be read. The semantics mirror `read_lines`:
## the split is on "\n" and a trailing newline counts as one more (empty) line.
##
## ## Ejemplo
## ```pengu
## let tail as maybe list of string is calling archivum.read_last_n_lines with "notes.txt", 2
## ```
weave read_last_n_lines with path as string, n as int into maybe list of string:
    var lines_opt as maybe list of string is calling read_lines with path
    if lines_opt.is_present:
        var all_l as list of string is lines_opt.value
        var out as list of string is list of string
        var start_at as int is all_l.len - n
        if start_at < 0:
            set start_at is 0
        if start_at > all_l.len:
            # A negative `n` makes `len - n` exceed the list; clamp it so the
            # release loop below never indexes past the end.
            set start_at is all_l.len
        var i as int is start_at
        while i < all_l.len:
            calling out.push with (all_l at i)
            set i is i + 1
        # Release the leading elements that were not moved into `out`.
        var j as int is 0
        while j < start_at:
            banish (all_l at j)
            set j is j + 1
        banish lines_opt
        return some out
    banish lines_opt
    return maybe none

## Returns the total number of lines in file `path`.
##
## ## Parámetros
## - `path`: the file to measure. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the number of "\n"-separated elements, or `maybe none` when the
## file cannot be read. A file ending in a newline therefore counts one extra
## empty line, matching `read_lines`.
##
## ## Ejemplo
## ```pengu
## let total as maybe int is calling archivum.count_lines with "notes.txt"
## ```
weave count_lines with path as string into maybe int:
    var lines_opt as maybe list of string is calling read_lines with path
    if lines_opt.is_present:
        var ll as list of string is lines_opt.value
        var total as int is ll.len
        var i as int is 0
        while i < ll.len:
            banish (ll at i)
            set i is i + 1
        banish lines_opt
        return some total
    banish lines_opt
    return maybe none

## Joins `lines` with "\n", appends a trailing "\n", and writes to `path`.
##
## ## Parámetros
## - `path`: destination file.
## - `lines`: the lines to store. The list is borrowed, not consumed.
##
## ## Retorno
## `true` on success, `false` otherwise. An empty list writes a single "\n".
##
## ## Ejemplo
## ```pengu
## calling archivum.write_lines with "notes.txt", ["a", "b"]
## ```
weave write_lines with path as string, lines as list of string into bool:
    var payload as string is calling _join_lines with lines
    var wrote as bool is calling write_file with path, payload
    banish payload
    return wrote

## Joins `lines` with "\n", appends a trailing "\n", and appends to `path`.
##
## ## Parámetros
## - `path`: destination file; it is created when missing.
## - `lines`: the lines to append. The list is borrowed, not consumed.
##
## ## Retorno
## `true` on success, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling archivum.append_lines with "notes.txt", ["c"]
## ```
weave append_lines with path as string, lines as list of string into bool:
    var payload as string is calling _join_lines with lines
    var wrote as bool is calling append_file with path, payload
    banish payload
    return wrote

# ----------------------------------------------------------------------------
# Result Variants of the Line and Directory Helpers
# ----------------------------------------------------------------------------

## Reads file and splits text on newline, reporting the failure cause.
##
## ## Parámetros
## - `path`: the file to read. It is borrowed, not consumed.
##
## ## Retorno
## `ok` with the owned `list of string`, or `err` with the `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.IsADirectory)` for a directory and
## `err(IoError.Unknown)` for any other read failure.
##
## ## Ejemplo
## ```pengu
## let r as result of list of string to archivum.IoError is calling archivum.read_lines_result with "notes.txt"
## ```
weave read_lines_result with path as string into result of list of string to IoError:
    if calling is_dir with path:
        return calling err_of with IoError.IsADirectory
    # `or:` moves the list payload into `lines` and frees only the `maybe` box.
    var lines as list of string is (calling read_lines with path) or:
        return calling err_of with IoError.Unknown
    return calling ok_of with lines

## Writes `lines` joined by "\n" with a trailing "\n", reporting the failure cause.
##
## ## Parámetros
## - `path`: destination file. It is borrowed, not consumed.
## - `lines`: the lines to store. The list is borrowed, not consumed.
##
## ## Retorno
## `ok(0)` on success, or `err` with the `IoError` cause.
##
## ## Efectos
## Inherits the cause reported by `write_file_result`
## (`err(IoError.IsADirectory)` for a directory, `err(IoError.Unknown)`
## otherwise).
##
## ## Ejemplo
## ```pengu
## let r as result of int to archivum.IoError is calling archivum.write_lines_result with "notes.txt", ["a"]
## ```
weave write_lines_result with path as string, lines as list of string into result of int to IoError:
    var payload as string is calling _join_lines with lines
    var outcome as result of int to IoError is calling write_file_result with path, payload
    banish payload
    return outcome

## Appends `lines` joined by "\n" with a trailing "\n", reporting the failure cause.
##
## ## Parámetros
## - `path`: destination file. It is borrowed, not consumed.
## - `lines`: the lines to append. The list is borrowed, not consumed.
##
## ## Retorno
## `ok(0)` on success, or `err` with the `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.IsADirectory)` when `path` is a directory and
## `err(IoError.Unknown)` for any other append failure.
##
## ## Ejemplo
## ```pengu
## let r as result of int to archivum.IoError is calling archivum.append_lines_result with "notes.txt", ["b"]
## ```
weave append_lines_result with path as string, lines as list of string into result of int to IoError:
    if calling is_dir with path:
        return calling err_of with IoError.IsADirectory
    var payload as string is calling _join_lines with lines
    var appended as bool is calling append_file with path, payload
    banish payload
    if appended:
        return calling ok_of with 0
    return calling err_of with IoError.Unknown

## Lists the direct entry names inside `path`, reporting the failure cause.
##
## ## Parámetros
## - `path`: the directory to list. It is borrowed, not consumed.
##
## ## Retorno
## `ok` with the owned `list of string` of bare entry names, or `err` with the
## `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.NotFound)` when `path` does not exist and
## `err(IoError.NotAFile)` when it exists but is not a directory.
##
## ## Ejemplo
## ```pengu
## let r as result of list of string to archivum.IoError is calling archivum.read_dir_result with "/tmp"
## ```
weave read_dir_result with path as string into result of list of string to IoError:
    if not (calling is_dir with path):
        return calling err_of with (calling _missing_dir_error with path)
    var entries as list of string is (calling read_dir with path) or:
        return calling err_of with IoError.Unknown
    return calling ok_of with entries

## Creates the directory at `path`, reporting the failure cause.
##
## ## Parámetros
## - `path`: the directory to create. It is borrowed, not consumed.
## - `parents`: when `true`, missing ancestors are created as well (default
##   `false`).
##
## ## Retorno
## `ok(true)` when the directory exists after the call, or `err` with the
## `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.IsADirectory)` when a regular file already occupies
## `path` and `err(IoError.Unknown)` for any other failure.
##
## ## Ejemplo
## ```pengu
## let r as result of bool to archivum.IoError is calling archivum.create_dir_result with "/tmp/a", true
## ```
weave create_dir_result with path as string, parents as bool is false into result of bool to IoError:
    if calling is_file with path:
        return calling err_of with IoError.IsADirectory
    var made as bool is calling create_dir with path, parents
    if made:
        return calling ok_of with true
    return calling err_of with IoError.Unknown

## Removes the directory at `path`, reporting the failure cause.
##
## ## Parámetros
## - `path`: the directory to remove. It is borrowed, not consumed.
## - `recursive`: when `true`, the contents are removed as well (default
##   `false`).
##
## ## Retorno
## `ok(true)` on success, or `err` with the `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.NotFound)` when `path` does not exist,
## `err(IoError.NotAFile)` when it exists but is not a directory and
## `err(IoError.Unknown)` for any other failure (for example a non-empty
## directory with `recursive` false).
##
## ## Ejemplo
## ```pengu
## let r as result of bool to archivum.IoError is calling archivum.remove_dir_result with "/tmp/a", true
## ```
weave remove_dir_result with path as string, recursive as bool is false into result of bool to IoError:
    if not calling exists with path:
        return calling err_of with IoError.NotFound
    if not (calling is_dir with path):
        return calling err_of with IoError.NotAFile
    var removed as bool is calling remove_dir with path, recursive
    if removed:
        return calling ok_of with true
    return calling err_of with IoError.Unknown

## Copies file `src` to `dst`, reporting the failure cause.
##
## ## Parámetros
## - `src`: the source file. It is borrowed, not consumed.
## - `dst`: the destination file. It is borrowed, not consumed.
## - `overwrite`: when `false`, an existing `dst` makes the copy fail (default
##   `false`).
##
## ## Retorno
## `ok(true)` on success, or `err` with the `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.NotFound)` when `src` does not exist,
## `err(IoError.IsADirectory)` when `src` is a directory and
## `err(IoError.Unknown)` otherwise.
##
## ## Ejemplo
## ```pengu
## let r as result of bool to archivum.IoError is calling archivum.copy_file_result with "a.txt", "b.txt"
## ```
weave copy_file_result with src as string, dst as string, overwrite as bool is false into result of bool to IoError:
    if not calling exists with src:
        return calling err_of with IoError.NotFound
    if calling is_dir with src:
        return calling err_of with IoError.IsADirectory
    var copied as bool is calling copy_file with src, dst, overwrite
    if copied:
        return calling ok_of with true
    return calling err_of with IoError.Unknown

## Recursively copies a directory tree from `src` to `dst`, reporting the failure
## cause.
##
## ## Parámetros
## - `src`: the source directory. It is borrowed, not consumed.
## - `dst`: the destination directory. It is borrowed, not consumed.
##
## ## Retorno
## `ok(true)` on success, or `err` with the `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.NotFound)` when `src` does not exist,
## `err(IoError.IsADirectory)` when `src` exists but is a regular file and
## `err(IoError.Unknown)` otherwise. The copy is non-transactional, exactly like
## `copy_tree`.
##
## ## Ejemplo
## ```pengu
## let r as result of bool to archivum.IoError is calling archivum.copy_tree_result with "src_dir", "dst_dir"
## ```
weave copy_tree_result with src as string, dst as string into result of bool to IoError:
    if not calling exists with src:
        return calling err_of with IoError.NotFound
    if calling is_file with src:
        return calling err_of with IoError.IsADirectory
    var copied as bool is calling copy_tree with src, dst
    if copied:
        return calling ok_of with true
    return calling err_of with IoError.Unknown

## Updates the modification time of `path` to now, reporting the failure cause.
##
## ## Parámetros
## - `path`: the entry to touch. It is borrowed, not consumed.
##
## ## Retorno
## `ok(true)` on success, or `err` with the `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.IsADirectory)` when `path` is a directory and
## `err(IoError.Unknown)` for any other failure.
##
## ## Ejemplo
## ```pengu
## let r as result of bool to archivum.IoError is calling archivum.touch_result with "notes.txt"
## ```
weave touch_result with path as string into result of bool to IoError:
    if calling is_dir with path:
        return calling err_of with IoError.IsADirectory
    var touched as bool is calling touch with path
    if touched:
        return calling ok_of with true
    return calling err_of with IoError.Unknown

## Creates symbolic link `link` pointing at `target`, reporting the failure cause.
##
## ## Parámetros
## - `target`: the link target. It is borrowed, not consumed and need not exist.
## - `link`: the link path to create. It is borrowed, not consumed.
##
## ## Retorno
## `ok(true)` on success, or `err` with the `IoError` cause.
##
## ## Efectos
## Returns `err(IoError.Unknown)` when the runtime cannot create the link (for
## example an existing `link`).
##
## ## Ejemplo
## ```pengu
## let r as result of bool to archivum.IoError is calling archivum.symlink_result with "a.txt", "latest"
## ```
weave symlink_result with target as string, link as string into result of bool to IoError:
    var linked as bool is calling symlink with target, link
    if linked:
        return calling ok_of with true
    return calling err_of with IoError.Unknown

## Reads metadata of entry `path`, reporting the failure cause.
##
## ## Parámetros
## - `path`: the entry to stat. It is borrowed, not consumed.
##
## ## Retorno
## `ok` with the owned map (same keys as `metadata`), or `err` with the
## `IoError` cause. The map and its strings are owned by the caller.
##
## ## Efectos
## Returns `err(IoError.NotFound)` when `path` does not exist and
## `err(IoError.Unknown)` for any other `stat` failure.
##
## ## Ejemplo
## ```pengu
## let r as result of map of string to string to archivum.IoError is calling archivum.metadata_result with "notes.txt"
## ```
weave metadata_result with path as string into result of map of string to string to IoError:
    if not calling exists with path:
        return calling err_of with IoError.NotFound
    var md as map of string to string is (calling metadata with path) or:
        return calling err_of with IoError.Unknown
    return calling ok_of with md

# ----------------------------------------------------------------------------
# Search Helpers
# ----------------------------------------------------------------------------

## Globs `pattern` starting from the working directory.
##
## Paths are collected from the working directory downwards and reported as
## `./<relative path>`, so an absolute `pattern` (one starting with `/`) never
## matches.
##
## ## Parámetros
## - `pattern`: the pattern to match. `*` or `**` alone matches every entry,
##   `*.ext` matches by extension, and any other text matches as a substring of
##   the `./<relative path>` or exactly the entry name. `?` is **not** a
##   wildcard.
##
## ## Retorno
## A new owned `list of string` of matching paths, empty when nothing matches.
## Release the list and its elements with `banish`.
##
## ## Ejemplo
## ```pengu
## let found as list of string is calling archivum.glob with "*.txt"
## ```
weave glob with pattern as string into list of string:
    return calling pengu_c_archivum_glob with pattern

## Walks `root` depth-first and returns an owned nested list.
##
## ## Parámetros
## - `root`: the directory to walk. It is borrowed, not consumed.
##
## ## Retorno
## A new owned `list of list of string`; each inner list starts with the
## directory it describes followed by that directory's direct entry names (no
## paths, only basenames). The first inner list describes `root`, and each
## subdirectory then contributes its own inner list in depth-first order, so
## `walk` is not a level-by-level traversal. The outer list is empty when `root`
## is not a directory. Release the nested buffers with `banish`.
##
## ## Ejemplo
## ```pengu
## let levels as list of list of string is calling archivum.walk with "/tmp"
## ```
weave walk with root as string into list of list of string:
    return calling pengu_c_archivum_walk with root

## Updates modification time of `path` to now, creating an empty file when missing.
##
## ## Parámetros
## - `path`: the entry to touch. It is borrowed, not consumed.
##
## ## Retorno
## `true` when the timestamp was updated, `false` otherwise.
##
## ## Ejemplo
## ```pengu
## calling archivum.touch with "notes.txt"
## ```
weave touch with path as string into bool:
    return calling pengu_c_archivum_touch with path

## Creates symbolic link `link` pointing at `target`.
##
## ## Parámetros
## - `target`: the link target. It is borrowed and need not exist.
## - `link`: the link path to create. It is borrowed.
##
## ## Retorno
## `true` when the link was created, `false` otherwise (for example an existing
## `link`).
##
## ## Ejemplo
## ```pengu
## calling archivum.symlink with "a.txt", "latest"
## ```
weave symlink with target as string, link as string into bool:
    return calling pengu_c_archivum_symlink with target, link

## Reads target of symbolic link at `path`.
##
## ## Parámetros
## - `path`: the symlink to read. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the owned link target (relative targets stay relative), or
## `maybe none` when `path` is not a symlink.
##
## ## Ejemplo
## ```pengu
## let target as maybe string is calling archivum.read_symlink with "latest"
## ```
weave read_symlink with path as string into maybe string:
    return calling pengu_c_archivum_read_symlink with path

## Resolves `path` to a canonical absolute path.
##
## ## Parámetros
## - `path`: the path to resolve. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the owned absolute path (symlinks and "." / ".." resolved), or
## `maybe none` when the entry does not exist.
##
## ## Ejemplo
## ```pengu
## let abs_path as maybe string is calling archivum.realpath with "notes.txt"
## ```
weave realpath with path as string into maybe string:
    return calling pengu_c_archivum_realpath with path

# ----------------------------------------------------------------------------
# Extended Size, Time & Permission Helpers
# ----------------------------------------------------------------------------

# Releases every key/value string of a metadata map, then the map and its
# `maybe` wrapper.
#
# `pengu_c_archivum_metadata` builds 8 owned keys and 8 owned values with
# `pengu_string_new` and stores them in a map that keeps only the *bytes* of the
# `PenguString` header.  `banish m` on the wrapper frees the entry cells but not
# the 16 payload buffers, so a consumer that only reads one key must walk the
# map and release every key and value explicitly.
weave _release_metadata with m as maybe map of string to string into void:
    if m.is_present:
        var md as map of string to string is m.value
        for k in md:
            var v as string is calling md.get with k
            banish v
            banish k
    banish m

# Returns the `int` stored under `key` in metadata `md`, or `maybe none`.
weave _metadata_int with path as string, key as string into maybe int:
    var m as maybe map of string to string is calling metadata with path
    if m.is_present:
        var md as map of string to string is m.value
        if calling md.contains with key:
            var val_str as string is calling md.get with key
            var parsed as maybe int is calling spark.parse_int with val_str
            calling _release_metadata with m
            return parsed
    calling _release_metadata with m
    return maybe none

# True when `path` is a regular file whose mode has any bit of `mask` set.
weave _has_mode_bit with path as string, mask as int into bool:
    if not (calling exists with path):
        return false
    if not (calling is_file with path):
        return false
    let perm_mode as maybe int is calling permissions with path
    if perm_mode.is_present:
        var mode as int is perm_mode.value
        banish perm_mode
        return (mode & mask) != 0
    banish perm_mode
    return false

# IoError for a path that should be a directory but is missing or not one.
weave _missing_dir_error with path as string into IoError:
    if not calling exists with path:
        return IoError.NotFound
    return IoError.NotAFile

## Returns the size of file `path` in bytes, or none if file does not exist.
##
## ## Parámetros
## - `path`: the file to measure. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the size from the "size" metadata key, or `maybe none` when the
## entry does not exist or the key is not a parseable integer.
##
## ## Ejemplo
## ```pengu
## let bytes as maybe int is calling archivum.file_size with "notes.txt"
## ```
weave file_size with path as string into maybe int:
    return calling _metadata_int with path, "size"

## Returns the total size in bytes of files in directory `path`.
##
## ## Parámetros
## - `path`: the directory to measure. It is borrowed, not consumed.
## - `recursive`: when `true`, subdirectories are summed too (default `false`).
##
## ## Retorno
## `some` with the summed byte size of the regular files, or `maybe none` when
## `path` is not a directory. Empty files contribute 0; unreadable entries are
## skipped.
##
## ## Ejemplo
## ```pengu
## let total as maybe int is calling archivum.dir_size with "/tmp/a", true
## ```
weave dir_size with path as string, recursive as bool is false into maybe int:
    if not (calling is_dir with path):
        return maybe none
    var total as int is 0
    if recursive:
        var files as list of string is calling list_files_recursive with path
        var i as int is 0
        while i < files.len:
            var sz as maybe int is calling file_size with (files at i)
            if sz.is_present:
                set total is total + sz.value
            banish sz
            set i is i + 1
        # Every path string is owned by this list; release them before the buffer.
        var j as int is 0
        while j < files.len:
            banish (files at j)
            set j is j + 1
        banish files
        return some total
    else:
        var entries as maybe list of string is calling read_dir with path
        if entries.is_present:
            var l as list of string is entries.value
            var i as int is 0
            while i < l.len:
                var fp as string is "{path}/{(l at i)}"
                if calling is_file with fp:
                    var sz as maybe int is calling file_size with fp
                    if sz.is_present:
                        set total is total + sz.value
                    banish sz
                banish fp
                set i is i + 1
            var j as int is 0
            while j < l.len:
                banish (l at j)
                set j is j + 1
            banish entries
            return some total
        banish entries
    return maybe none

## Returns the last modification time of `path` as a Unix timestamp float.
##
## ## Parámetros
## - `path`: the entry to inspect. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the "modified" epoch seconds converted to `float`, or
## `maybe none` when unavailable.
##
## ## Ejemplo
## ```pengu
## let t as maybe float is calling archivum.modified_time with "notes.txt"
## ```
weave modified_time with path as string into maybe float:
    var i_val as maybe int is calling _metadata_int with path, "modified"
    if i_val.is_present:
        var seconds as float is (i_val.value) to float
        banish i_val
        return some seconds
    banish i_val
    return maybe none

## Returns the creation time of `path` as a Unix timestamp float.
##
## ## Parámetros
## - `path`: the entry to inspect. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the "created" epoch seconds converted to `float`, or
## `maybe none` when unavailable (some file systems do not record it).
##
## ## Ejemplo
## ```pengu
## let t as maybe float is calling archivum.created_time with "notes.txt"
## ```
weave created_time with path as string into maybe float:
    var i_val as maybe int is calling _metadata_int with path, "created"
    if i_val.is_present:
        var seconds as float is (i_val.value) to float
        banish i_val
        return some seconds
    banish i_val
    return maybe none

## Returns the last access time of `path` as a Unix timestamp float.
##
## ## Parámetros
## - `path`: the entry to inspect. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the "accessed" epoch seconds converted to `float`, or
## `maybe none` when unavailable.
##
## ## Ejemplo
## ```pengu
## let t as maybe float is calling archivum.accessed_time with "notes.txt"
## ```
weave accessed_time with path as string into maybe float:
    var i_val as maybe int is calling _metadata_int with path, "accessed"
    if i_val.is_present:
        var seconds as float is (i_val.value) to float
        banish i_val
        return some seconds
    banish i_val
    return maybe none

## Returns the file mode/permissions of `path` as an octal integer mode.
##
## ## Parámetros
## - `path`: the entry to inspect. It is borrowed, not consumed.
##
## ## Retorno
## `some` with the decimal value of the POSIX mode bits (`st_mode & 0777`, so
## 0644 is reported as 420), or `maybe none` when unavailable.
##
## ## Ejemplo
## ```pengu
## let mode as maybe int is calling archivum.permissions with "notes.txt"
## ```
weave permissions with path as string into maybe int:
    return calling _metadata_int with path, "permissions"

## True when `path` exists, is a regular file, and has a size of 0 bytes.
##
## ## Parámetros
## - `path`: the entry to probe. It is borrowed, not consumed.
##
## ## Retorno
## `true` only for an existing regular file of size 0; `false` for a directory,
## a missing path or a non-empty file.
##
## ## Ejemplo
## ```pengu
## calling archivum.is_empty_file with "empty.txt"     # true
## ```
weave is_empty_file with path as string into bool:
    if not (calling is_file with path):
        return false
    var sz as maybe int is calling file_size with path
    if sz.is_present:
        var byte_count as int is sz.value
        banish sz
        return byte_count == 0
    banish sz
    return false

## True when `path` is an existing directory containing zero entries.
##
## ## Parámetros
## - `path`: the directory to probe. It is borrowed, not consumed.
##
## ## Retorno
## `true` only for an existing directory with no entries; `false` for a file, a
## missing path or a directory with at least one entry.
##
## ## Ejemplo
## ```pengu
## calling archivum.is_empty_dir with "/tmp/a"     # true
## ```
weave is_empty_dir with path as string into bool:
    if not (calling is_dir with path):
        return false
    var entries as maybe list of string is calling read_dir with path
    if entries.is_present:
        var l as list of string is entries.value
        var empty as bool is l.len == 0
        # The entry names are owned by this caller: release them before the box.
        var i as int is 0
        while i < l.len:
            banish (l at i)
            set i is i + 1
        banish entries
        return empty
    banish entries
    return false

# ----------------------------------------------------------------------------
# Search & Find Helpers
# ----------------------------------------------------------------------------

## Returns list of all regular files in directory `root`.
##
## ## Parámetros
## - `root`: the directory to search. It is borrowed, not consumed.
## - `recursive`: when `true`, subdirectories are searched too (default `true`).
##
## ## Retorno
## A new owned `list of string` of file paths; empty when `root` is not a
## directory. Release the list and its elements with `banish`.
##
## ## Ejemplo
## ```pengu
## let files as list of string is calling archivum.find_files with "/tmp/a", true
## ```
weave find_files with root as string, recursive as bool is true into list of string:
    if recursive:
        return calling list_files_recursive with root
    var out as list of string is list of string
    var entries as maybe list of string is calling read_dir with root
    if entries.is_present:
        var l as list of string is entries.value
        var i as int is 0
        while i < l.len:
            var fp as string is "{root}/{(l at i)}"
            if calling is_file with fp:
                # `push` copies the struct: `out` takes ownership of the buffer.
                calling out.push with fp
            else:
                banish fp
            set i is i + 1
        var j as int is 0
        while j < l.len:
            banish (l at j)
            set j is j + 1
    banish entries
    return out

## Returns list of all subdirectories in directory `root`.
##
## ## Parámetros
## - `root`: the directory to search. It is borrowed, not consumed.
## - `recursive`: when `true`, subdirectories of subdirectories are included
##   (default `true`). `root` itself is never included.
##
## ## Retorno
## A new owned `list of string` of directory paths; empty when there is none.
##
## ## Ejemplo
## ```pengu
## let dirs as list of string is calling archivum.find_dirs with "/tmp/a", true
## ```
weave find_dirs with root as string, recursive as bool is true into list of string:
    var out as list of string is list of string
    var stack as list of string is list of string
    calling stack.push with root
    while stack.len > 0:
        var cur as string is stack at (stack.len - 1)
        calling stack.pop
        var entries as maybe list of string is calling read_dir with cur
        if entries.is_present:
            var l as list of string is entries.value
            var i as int is 0
            while i < l.len:
                var dp as string is "{cur}/{(l at i)}"
                if calling is_dir with dp:
                    # `out` owns this path; the stack only aliases it, so it is
                    # never banished through `cur` (the root is a borrowed view).
                    calling out.push with dp
                    if recursive:
                        calling stack.push with dp
                else:
                    banish dp
                set i is i + 1
            var j as int is 0
            while j < l.len:
                banish (l at j)
                set j is j + 1
        banish entries
    banish stack
    return out

## Finds files under `root` whose basename exactly matches `target_name`.
##
## ## Parámetros
## - `root`: the directory to search. It is borrowed, not consumed.
## - `target_name`: the exact basename to match (case-sensitive).
## - `recursive`: when `true`, subdirectories are searched too (default `true`).
##
## ## Retorno
## A new owned `list of string` of matching file paths; empty when nothing
## matches. Release the list and its elements with `banish`.
##
## ## Ejemplo
## ```pengu
## let hits as list of string is calling archivum.find_by_name with "/tmp/a", "notes.txt"
## ```
weave find_by_name with root as string, target_name as string, recursive as bool is true into list of string:
    var files as list of string is calling find_files with root, recursive
    var out as list of string is list of string
    var i as int is 0
    while i < files.len:
        var f as string is files at i
        var base as string is calling compass.basename with f
        var match as bool is base == target_name
        banish base
        if match:
            # Ownership of the path buffer moves to `out`.
            calling out.push with f
        else:
            banish f
        set i is i + 1
    banish files
    return out

## Finds files under `root` whose extension matches `extension` (e.g. ".log" or "log").
##
## ## Parámetros
## - `root`: the directory to search. It is borrowed, not consumed.
## - `extension`: the extension to match, with or without the leading dot
##   (case-sensitive).
## - `recursive`: when `true`, subdirectories are searched too (default `true`).
##
## ## Retorno
## A new owned `list of string` of matching file paths; empty when nothing
## matches. Release the list and its elements with `banish`.
##
## ## Ejemplo
## ```pengu
## let logs as list of string is calling archivum.find_by_ext with "/tmp/a", ".log"
## ```
weave find_by_ext with root as string, extension as string, recursive as bool is true into list of string:
    var ext_target as string is extension
    var ext_owned as bool is false
    if (ext_target length) > 0:
        # `ext_target at 0` allocates a one-byte owned string: release it.
        var first as string is ext_target at 0
        var has_dot as bool is first == "."
        banish first
        if not has_dot:
            var dotted as string is ".{ext_target}"
            set ext_target is dotted
            set ext_owned is true
    var files as list of string is calling find_files with root, recursive
    var out as list of string is list of string
    var i as int is 0
    while i < files.len:
        var f as string is files at i
        var fext as string is calling compass.ext with f
        var match as bool is fext == ext_target
        banish fext
        if match:
            calling out.push with f
        else:
            banish f
        set i is i + 1
    banish files
    # Only release `ext_target` when this weave allocated the dotted form; the
    # plain form aliases the borrowed `extension`.
    if ext_owned:
        banish ext_target
    return out

# ----------------------------------------------------------------------------
# Temporary Directory & File Helpers
# ----------------------------------------------------------------------------

## Returns the system temporary directory path as a string.
##
## ## Retorno
## An owned `string` with the directory path: `$TEMP`/`$TMP` (or "C:\\Temp") on
## Windows, `$TMPDIR` (or "/tmp") elsewhere. The directory is not created here.
##
## ## Ejemplo
## ```pengu
## let tmp as string is calling archivum.temp_dir
## ```
weave temp_dir into string:
    when os == "windows":
        # `or:` frees the `maybe` box of `getenv` while moving the payload out.
        var t1 as string is (calling rites.getenv with "TEMP") or:
            var t2 as string is (calling rites.getenv with "TMP") or:
                return "C:\\Temp"
            return t2
        return t1
    else:
        var td as string is (calling rites.getenv with "TMPDIR") or:
            return "/tmp"
        return td

## Generates a unique temporary file path within the system temporary directory.
##
## ## Parámetros
## - `prefix`: the filename prefix (default `"pengu"`).
##
## ## Retorno
## An owned `string` with the path of a not-yet-existing file. The file is *not*
## created; the caller decides what to write.
##
## ## Efectos
## The candidate name embeds the process id and a counter; after 10000 occupied
## candidates it falls back to `"{temp_dir}/{prefix}.tmp"` without checking.
##
## ## Ejemplo
## ```pengu
## let tmp_path as string is calling archivum.temp_file with "notes"
## ```
weave temp_file with prefix as string is "pengu" into string:
    var tdir as string is calling temp_dir
    var pid as int is calling rites.getpid
    var pid_text as string is (pid to string)
    var i as int is 0
    while i < 10000:
        # Every `to string` and interpolation is an owned buffer that nothing
        # else releases: build, use and banish one candidate at a time.
        var i_text as string is (i to string)
        var name as string is "{prefix}_{pid_text}_{i_text}.tmp"
        banish i_text
        var parts as list of string is list of string
        calling parts.push with tdir
        calling parts.push with name
        var cand as string is calling compass.join with parts
        banish parts
        banish name
        if not (calling exists with cand):
            banish pid_text
            banish tdir
            return cand
        banish cand
        set i is i + 1
    var fallback as string is "{tdir}/{prefix}.tmp"
    banish pid_text
    banish tdir
    return fallback

# ----------------------------------------------------------------------------
# Recursive Directory Helpers
# ----------------------------------------------------------------------------

# Internal record used by copy_tree to queue directory pairs.
rune FsCopyTask:
    s as string
    d as string

## Recursively copies a directory tree from `src` to `dst`. Returns true on success.
##
## ## Parámetros
## - `src`: the source directory. It is borrowed, not consumed.
## - `dst`: the destination directory; it is created when missing.
##
## ## Retorno
## `true` when every entry was copied, `false` as soon as one step fails. An
## existing `dst` is merged into, and existing files are overwritten.
##
## ## Efectos
## Note: This operation is non-transactional; any partially created files or
## subdirectories remain on disk if a subsequent step encounters an error.
## Symlinks and special files are skipped.
##
## ## Ejemplo
## ```pengu
## calling archivum.copy_tree with "src_dir", "dst_dir"
## ```
weave copy_tree with src as string, dst as string into bool:
    var src_is_dir as bool is calling is_dir with src
    if not src_is_dir:
        return false
    var made_root as bool is calling create_dir with dst, true
    if not made_root:
        return false
    # A failure stops the traversal exactly where the old early `return false`
    # did; the flag only lets the loop release every buffer before leaving.
    var failed as bool is false
    var stack as list of FsCopyTask is list of FsCopyTask
    var first_task as bool is true
    var seed as FsCopyTask is with s is src, d is dst
    calling stack.push with seed
    while (stack.len > 0) and (not failed):
        var last_task as FsCopyTask is stack at (stack.len - 1)
        calling stack.pop
        var entries as maybe list of string is calling read_dir with last_task.s
        if entries.is_present:
            var list_e as list of string is entries.value
            var i as int is 0
            while (i < list_e.len) and (not failed):
                var name as string is list_e at i
                var sp as string is "{last_task.s}/{name}"
                var dp as string is "{last_task.d}/{name}"
                if calling is_dir with sp:
                    var made_sub as bool is calling create_dir with dp, true
                    if made_sub:
                        var task as FsCopyTask is with s is sp, d is dp
                        calling stack.push with task
                    else:
                        set failed is true
                        banish sp
                        banish dp
                else:
                    if calling is_file with sp:
                        var content as maybe string is calling read_file with sp
                        if content.is_present:
                            var wrote as bool is calling write_file with dp, content.value
                            if not wrote:
                                set failed is true
                        else:
                            set failed is true
                        banish content
                        banish sp
                        banish dp
                    else:
                        banish sp
                        banish dp
                set i is i + 1
            var j as int is 0
            while j < list_e.len:
                banish (list_e at j)
                set j is j + 1
        banish entries
        # The seed holds borrowed views of the parameters; every task queued
        # afterwards owns its two paths. Never release the seed's strings.
        if not first_task:
            banish last_task.s
            banish last_task.d
        set first_task is false
    # Release directory pairs still queued after a failure.
    var q as int is 0
    while q < stack.len:
        var pending as FsCopyTask is stack at q
        banish pending.s
        banish pending.d
        set q is q + 1
    banish stack
    if failed:
        return false
    return true

## Recursively lists every file below root.
##
## ## Parámetros
## - `root`: the directory to scan. It is borrowed, not consumed.
##
## ## Retorno
## A new owned `list of string` with every regular file below `root` (in
## depth-first order, unlike `walk`); empty when there is none. Release the list
## and its elements with `banish`.
##
## ## Ejemplo
## ```pengu
## let files as list of string is calling archivum.list_files_recursive with "/tmp/a"
## ```
weave list_files_recursive with root as string into list of string:
    var out as list of string is list of string
    var dirs as list of string is list of string
    var first_dir as bool is true
    calling dirs.push with root
    while dirs.len > 0:
        var last_d as string is dirs at (dirs.len - 1)
        calling dirs.pop
        var entries as maybe list of string is calling read_dir with last_d
        if entries.is_present:
            var list_d as list of string is entries.value
            var i as int is 0
            while i < list_d.len:
                var name as string is list_d at i
                var p as string is "{last_d}/{name}"
                if calling is_dir with p:
                    # The path becomes a queued directory; it is released when
                    # it is popped again (the root is a borrowed view).
                    calling dirs.push with p
                else:
                    if calling is_file with p:
                        calling out.push with p
                    else:
                        banish p
                set i is i + 1
            var j as int is 0
            while j < list_d.len:
                banish (list_d at j)
                set j is j + 1
        banish entries
        # The first entry is the borrowed `root`; queued directories own a path.
        if not first_dir:
            banish last_d
        set first_dir is false
    banish dirs
    return out

# ----------------------------------------------------------------------------
# Path Methods (external enchanting)
# ----------------------------------------------------------------------------
# Filesystem methods for `compass.Path`, the owned path rune of `std.compass`.
# They delegate to the module functions above through `self->raw`; `std/compass.pengu`
# is not modified.

enchanting compass.Path:
    ## Reads the whole file at this path as UTF-8 text.
    ##
    ## ## Retorno
    ## `some` with the owned file text, or `maybe none` on failure.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## let text as maybe string is calling p.read_text
    ## ```
    weave read_text into maybe string:
        return calling read_file with self->raw

    ## Writes `content` to this path, creating or truncating the file.
    ##
    ## ## Parámetros
    ## - `content`: the exact text to store. It is borrowed.
    ##
    ## ## Retorno
    ## `true` on success, `false` otherwise.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling p.write_text with "hello"
    ## ```
    weave write_text with content as string into bool:
        return calling write_file with self->raw, content

    ## Reads this file and splits it on "\n" into lines.
    ##
    ## ## Retorno
    ## `some` with the owned `list of string`, or `maybe none` on failure.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## let lines as maybe list of string is calling p.read_lines
    ## ```
    weave read_lines into maybe list of string:
        return calling read_lines with self->raw

    ## Appends `content` to this file, creating it when missing.
    ##
    ## ## Parámetros
    ## - `content`: the exact text to append. It is borrowed.
    ##
    ## ## Retorno
    ## `true` on success, `false` otherwise.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling p.append_text with "more\n"
    ## ```
    weave append_text with content as string into bool:
        return calling append_file with self->raw, content

    ## Deletes the file, empty directory or symlink at this path.
    ##
    ## ## Retorno
    ## `true` on success, `false` otherwise. Use `rmdir` for a directory.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling p.delete
    ## ```
    weave delete into bool:
        return calling delete_file with self->raw

    ## Creates this directory.
    ##
    ## ## Parámetros
    ## - `parents`: when `true`, missing ancestors are created too (default
    ##   `false`).
    ##
    ## ## Retorno
    ## `true` when the directory exists after the call, `false` otherwise.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling p.mkdir with true
    ## ```
    weave mkdir with parents as bool is false into bool:
        return calling create_dir with self->raw, parents

    ## Removes this directory.
    ##
    ## ## Parámetros
    ## - `recursive`: when `true`, the contents are removed too (default `false`).
    ##
    ## ## Retorno
    ## `true` on success, `false` otherwise.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## calling p.rmdir with true
    ## ```
    weave rmdir with recursive as bool is false into bool:
        return calling remove_dir with self->raw, recursive

    ## Lists this directory's direct entries joined with the directory.
    ##
    ## ## Retorno
    ## A new owned `list of string`; empty when the directory cannot be read.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## let entries as list of string is calling p.iter_dir
    ## ```
    weave iter_dir into list of string:
        return calling read_dir_full with self->raw

    ## Reads the metadata map of this path.
    ##
    ## ## Retorno
    ## `some` with the owned map (same keys as `archivum.metadata`), or
    ## `maybe none` when `stat` fails.
    ##
    ## ## Ejemplo
    ## ```pengu
    ## let md as maybe map of string to string is calling p.stat
    ## ```
    weave stat into maybe map of string to string:
        return calling metadata with self->raw

# --- Tests ---
# The harness is private and panics through `std.spark`; `std.ward` cannot be
# imported from a standard-library module without creating an import cycle.
# Every test builds a directory unique to its name under the system temporary
# directory and removes it again at the end of the block.

## Aborts the current test with `label` when `got != want`.
weave _arch_expect_int with got as int, want as int, label as string into void:
    if got != want:
        calling spark.println with "FAIL {label}: got {got}, want {want}"
        calling spark.panic with "archivum: test failed"

## Aborts the current test with `label` when `got != want`.
weave _arch_expect_str with got as string, want as string, label as string into void:
    if got != want:
        calling spark.println with "FAIL {label}: got [{got}], want [{want}]"
        calling spark.panic with "archivum: test failed"

## Aborts the current test with `label` when `cond` is false.
weave _arch_expect_true with cond as bool, label as string into void:
    if not cond:
        calling spark.println with "FAIL {label}"
        calling spark.panic with "archivum: test failed"

## Joins `base` and `name` into a test path with the module separator.
weave _arch_path with base as string, name as string into string:
    let parts as list of string is [base, name]
    var joined as string is calling compass.join with parts
    banish parts
    return joined

## Removes any leftover `base` and recreates it empty; returns `base`.
weave _arch_fresh_dir with base as string into string:
    if calling exists with base:
        calling remove_dir with base, true
    calling create_dir with base, true
    return base

## Removes the test directory `base` and everything below it.
weave _arch_cleanup with base as string into void:
    if calling exists with base:
        calling remove_dir with base, true

## Builds the unique test directory `/tmp/pengu_arch_test_<pid>_<name>`.
weave _arch_base with name as string into string:
    let pid as int is calling rites.getpid
    var pid_text as string is (pid to string)
    var base as string is "/tmp/pengu_arch_test_{pid_text}_{name}"
    banish pid_text
    return base

test "ARCHIVUM_VERSION is 2.1.0":
    calling _arch_expect_str with ARCHIVUM_VERSION, "2.1.0", "version"

test "write_file then read_file round-trips the content":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "roundtrip")
    let path as string is calling _arch_path with base, "a.txt"
    calling _arch_expect_true with (calling write_file with path, "hello world"), "write_file"
    let got as maybe string is calling read_file with path
    calling _arch_expect_true with (got.is_present), "read_file present"
    if got.is_present:
        calling _arch_expect_str with (got.value), "hello world", "round-trip text"
    calling _arch_cleanup with base

