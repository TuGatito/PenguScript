-- std/archivum.pengu — archivos tar.
--
-- S9b. Se implementa `tar` (ustar, sin compresión) en Rust puro: escribir y
-- leer no necesita dependencias. `zip` necesita deflate y queda pendiente
-- (S9c), igual que `tar.gz`.
scroll archivum
    unveil rune ArchivumError
        unveil message: String

    unveil ritual ArchivumError for Show
        show = (@) -> String
            format("ArchivumError(#{@.message})")

    foreign "pengu"
        archivum_create = (archive: Str, base: Str, paths: Vec[String]) -> Result[Unit, ArchivumError]
        archivum_extract = (archive: Str, dest: Str) -> Result[Vec[String], ArchivumError]
        archivum_entries = (archive: Str) -> Result[Vec[String], ArchivumError]
        archivum_pack = (archive: Str, base: Str) -> Result[Unit, ArchivumError]
        archivum_targz_create = (archive: Str, base: Str, paths: Vec[String]) -> Result[Unit, ArchivumError]
        archivum_targz_entries = (archive: Str) -> Result[Vec[String], ArchivumError]
        archivum_targz_extract = (archive: Str, dest: Str) -> Result[Vec[String], ArchivumError]
        zip_create = (archive: Str, base: Str, paths: Vec[String]) -> Result[Unit, ArchivumError]
        zip_entries = (archive: Str) -> Result[Vec[String], ArchivumError]
        zip_extract = (archive: Str, dest: Str) -> Result[Vec[String], ArchivumError]
        gz_compress = (data: Vec[U8]) -> Vec[U8]
        gz_decompress = (data: Vec[U8]) -> Result[Vec[U8], ArchivumError]

    -- Crea `archive` con `paths` (relativas a `base`, que se guarda como prefijo).
    unveil create = (archive: &Str, base: &Str, paths: Vec[String]) -> Result[Unit, ArchivumError]
        archivum_create(archive, base, paths)

    -- Extrae `archive` en `dest`; devuelve las rutas extraídas.
    unveil extract = (archive: &Str, dest: &Str) -> Result[Vec[String], ArchivumError]
        archivum_extract(archive, dest)

    -- Lista las entradas del archivo.
    unveil entries = (archive: &Str) -> Result[Vec[String], ArchivumError]
        archivum_entries(archive)

    -- Crea un tar con todo lo que hay bajo `base` (ficheros y directorios).
    unveil pack = (archive: &Str, base: &Str) -> Result[Unit, ArchivumError]
        archivum_pack(archive, base)

    -- Extrae y devuelve cuántas entradas había.
    unveil unpack_count = (archive: &Str, dest: &Str) -> Result[Usize, ArchivumError]
        match archivum_extract(archive, dest)
            when ok(paths) then ok(paths.len())
            when err(e) then err(e)

    -- --- Formatos comprimidos (S9c) -------------------------------------

    -- Crea un `tar.gz` (gzip + tar ustar).
    unveil create_targz = (archive: &Str, base: &Str, paths: Vec[String]) -> Result[Unit, ArchivumError]
        archivum_targz_create(archive, base, paths)

    unveil entries_targz = (archive: &Str) -> Result[Vec[String], ArchivumError]
        archivum_targz_entries(archive)

    unveil extract_targz = (archive: &Str, dest: &Str) -> Result[Vec[String], ArchivumError]
        archivum_targz_extract(archive, dest)

    -- Crea un `zip` (entradas almacenadas: sin compresión, formato válido).
    unveil create_zip = (archive: &Str, base: &Str, paths: Vec[String]) -> Result[Unit, ArchivumError]
        zip_create(archive, base, paths)

    unveil entries_zip = (archive: &Str) -> Result[Vec[String], ArchivumError]
        zip_entries(archive)

    -- Extrae un `zip` (acepta entradas almacenadas y deflate).
    unveil extract_zip = (archive: &Str, dest: &Str) -> Result[Vec[String], ArchivumError]
        zip_extract(archive, dest)

    -- Comprime bytes en formato gzip.
    unveil compress_gz = (data: Vec[U8]) -> Vec[U8]
        gz_compress(data)

    -- Descomprime bytes gzip (deflate completo: bloques fijos y dinámicos).
    unveil decompress_gz = (data: Vec[U8]) -> Result[Vec[U8], ArchivumError]
        gz_decompress(data)
