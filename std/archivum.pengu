    calling _arch_expect_true with (rr.is_ok), "read_lines_result ok"
    if rr.is_ok:
        calling _arch_expect_int with (rr.value.len), 3, "read_lines_result len"
    let ar as result of int to IoError is calling append_lines_result with path, lines
    calling _arch_expect_true with (ar.is_ok), "append_lines_result ok"
    let dr as result of list of string to IoError is calling read_dir_result with base
    calling _arch_expect_true with (dr.is_ok), "read_dir_result ok"
    let cr as result of bool to IoError is calling create_dir_result with (calling _arch_path with base, "sub"), true
    calling _arch_expect_true with (cr.is_ok), "create_dir_result ok"
    let tr as result of bool to IoError is calling touch_result with (calling _arch_path with base, "t.txt")
    calling _arch_expect_true with (tr.is_ok), "touch_result ok"
    let mr as result of map of string to string to IoError is calling metadata_result with path
    calling _arch_expect_true with (mr.is_ok), "metadata_result ok"
    let xr as result of bool to IoError is calling remove_dir_result with (calling _arch_path with base, "sub"), true
    calling _arch_expect_true with (xr.is_ok), "remove_dir_result ok"
    calling _arch_cleanup with base

test "the result variants report the error path":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "errpath")
    let missing as string is calling _arch_path with base, "missing.txt"
    let file_path as string is calling _arch_path with base, "f.txt"
    calling write_file with file_path, "x"
    let dir_bad as result of list of string to IoError is calling read_dir_result with missing
    calling _arch_expect_true with (not (dir_bad.is_ok)), "read_dir_result missing"
    calling _arch_expect_str with (calling describe_error with (dir_bad.error)), "no such file or directory", "dir error text"
    let file_bad as result of list of string to IoError is calling read_dir_result with file_path
    calling _arch_expect_true with (not (file_bad.is_ok)), "read_dir_result on file"
    let cf as result of bool to IoError is calling copy_file_result with missing, file_path, false
    calling _arch_expect_true with (not (cf.is_ok)), "copy_file_result missing"
    let ct as result of bool to IoError is calling copy_tree_result with missing, base
    calling _arch_expect_true with (not (ct.is_ok)), "copy_tree_result missing"
    let tl as result of list of string to IoError is calling read_lines_result with base
    calling _arch_expect_true with (not (tl.is_ok)), "read_lines_result on dir"
    calling _arch_expect_str with (calling describe_error with (tl.error)), "is a directory", "dir error"
    let md_bad as result of map of string to string to IoError is calling metadata_result with missing
    calling _arch_expect_true with (not (md_bad.is_ok)), "metadata_result missing"
    let dd as result of bool to IoError is calling create_dir_result with file_path, false
    calling _arch_expect_true with (not (dd.is_ok)), "create_dir_result on file"
    let rd as result of bool to IoError is calling remove_dir_result with missing, true
    calling _arch_expect_true with (not (rd.is_ok)), "remove_dir_result missing"
    let td as result of int to IoError is calling delete_file_result with missing
    calling _arch_expect_true with (not (td.is_ok)), "delete_file_result missing"
    calling _arch_cleanup with base

test "describe_error names every IoError variant":
    calling _arch_expect_str with (calling describe_error with IoError.NotFound), "no such file or directory", "NotFound"
    calling _arch_expect_str with (calling describe_error with IoError.IsADirectory), "is a directory", "IsADirectory"
    calling _arch_expect_str with (calling describe_error with IoError.NotAFile), "not a regular file", "NotAFile"
    calling _arch_expect_str with (calling describe_error with IoError.Permission), "permission denied", "Permission"
    calling _arch_expect_str with (calling describe_error with IoError.Unknown), "unknown I/O error", "Unknown"

test "read_dir lists entries and read_dir_full joins them":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "readdir")
    let path as string is calling _arch_path with base, "a.txt"
    calling write_file with path, "x"
