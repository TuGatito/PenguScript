    calling write_file with path, "x"
    calling _arch_expect_true with (calling remove_dir with base, true), "remove_dir"
    calling _arch_expect_true with (not (calling exists with base)), "tree gone"

test "copy_file duplicates a file and copy_tree duplicates a tree":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "copy")
    let src as string is calling _arch_path with base, "a.txt"
    let dst as string is calling _arch_path with base, "b.txt"
    calling write_file with src, "payload"
    calling _arch_expect_true with (calling copy_file with src, dst, false), "copy_file"
    let got as maybe string is calling read_file with dst
    if got.is_present:
        calling _arch_expect_str with (got.value), "payload", "copied text"
    let src_dir as string is calling _arch_path with base, "src_dir"
    let dst_dir as string is calling _arch_path with base, "dst_dir"
    calling create_dir with src_dir, true
    let nested as string is calling _arch_path with src_dir, "n.txt"
    calling write_file with nested, "nested"
    calling _arch_expect_true with (calling copy_tree with src_dir, dst_dir), "copy_tree"
    let copied as string is calling _arch_path with dst_dir, "n.txt"
    let got2 as maybe string is calling read_file with copied
    calling _arch_expect_true with (got2.is_present), "tree file copied"
    calling _arch_cleanup with base

test "move_file and rename relocate an entry":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "move")
    let a as string is calling _arch_path with base, "a.txt"
    let b as string is calling _arch_path with base, "b.txt"
    let c as string is calling _arch_path with base, "c.txt"
    calling write_file with a, "data"
    calling _arch_expect_true with (calling move_file with a, b, false), "move_file"
    calling _arch_expect_true with (not (calling exists with a)), "source gone"
    calling _arch_expect_true with (calling exists with b), "dest there"
    calling _arch_expect_true with (calling rename with b, c), "rename"
    calling _arch_expect_true with (calling exists with c), "renamed there"
    calling _arch_cleanup with base

test "metadata reports the file size":
