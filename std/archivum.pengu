        calling _arch_expect_int with (byte_count.value), 10, "file_size"
    let md_opt as maybe map of string to string is calling metadata with path
    calling _arch_expect_true with (md_opt.is_present), "metadata present"
    if md_opt.is_present:
        let md as map of string to string is md_opt.value
        calling _arch_expect_true with (calling md.contains with "size"), "size key"
        calling _arch_expect_str with (calling md.get with "size"), "10", "size value"
    calling _arch_cleanup with base

