test "read_lines splits the file on newline":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "readlines")
    let path as string is calling _arch_path with base, "a.txt"
    calling write_file with path, "a\nb\nc"
    let got as maybe list of string is calling read_lines with path
    calling _arch_expect_true with (got.is_present), "read_lines present"
    if got.is_present:
        let lines as list of string is got.value
        calling _arch_expect_int with (lines.len), 3, "read_lines len"
        if lines.len == 3:
            calling _arch_expect_str with (lines at 0), "a", "line 0"
            calling _arch_expect_str with (lines at 2), "c", "line 2"
    calling _arch_cleanup with base

test "read_first_n_lines takes the head":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "head")
    let path as string is calling _arch_path with base, "a.txt"
    calling write_file with path, "a\nb\nc\nd"
    let got as maybe list of string is calling read_first_n_lines with path, 2
    calling _arch_expect_true with (got.is_present), "head present"
    if got.is_present:
        let head as list of string is got.value
        calling _arch_expect_int with (head.len), 2, "head len"
        if head.len == 2:
            calling _arch_expect_str with (head at 0), "a", "head 0"
            calling _arch_expect_str with (head at 1), "b", "head 1"
    calling _arch_cleanup with base

test "read_last_n_lines takes the tail":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "tail")
    let path as string is calling _arch_path with base, "a.txt"
    calling write_file with path, "a\nb\nc\nd"
    let got as maybe list of string is calling read_last_n_lines with path, 2
    calling _arch_expect_true with (got.is_present), "tail present"
    if got.is_present:
        let tail as list of string is got.value
        calling _arch_expect_int with (tail.len), 2, "tail len"
        if tail.len == 2:
            calling _arch_expect_str with (tail at 0), "c", "tail 0"
            calling _arch_expect_str with (tail at 1), "d", "tail 1"
    let all_opt as maybe list of string is calling read_last_n_lines with path, 9
    if all_opt.is_present:
        calling _arch_expect_int with (all_opt.value.len), 4, "tail overflow"
    calling _arch_cleanup with base

test "count_lines counts the split elements":
