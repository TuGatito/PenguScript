        calling _arch_expect_str with (got.value), "one\ntwo\n", "write_lines text"
    let more as list of string is ["three"]
    calling _arch_expect_true with (calling append_lines with path, more), "append_lines"
    let got2 as maybe string is calling read_file with path
    if got2.is_present:
        calling _arch_expect_str with (got2.value), "one\ntwo\nthree\n", "append_lines text"
    calling _arch_cleanup with base

test "exists and is_file and is_dir classify the entries":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "classify")
    let path as string is calling _arch_path with base, "a.txt"
    calling write_file with path, "x"
    calling _arch_expect_true with (calling exists with path), "exists file"
    calling _arch_expect_true with (calling is_file with path), "is_file"
    calling _arch_expect_true with (not (calling is_dir with path)), "file not dir"
    calling _arch_expect_true with (calling is_dir with base), "is_dir base"
    let empty as string is calling _arch_path with base, "empty"
    calling _arch_expect_true with (calling create_dir with empty, false), "create_dir"
    calling _arch_expect_true with (calling exists with empty), "created dir exists"
    calling _arch_expect_true with (calling is_empty_dir with empty), "is_empty_dir"
    let inside as string is calling _arch_path with empty, "f.txt"
    calling write_file with inside, "x"
    calling _arch_expect_true with (not (calling is_empty_dir with empty)), "non-empty dir"
    calling _arch_cleanup with base

test "create_dir with parents builds nested directories":
