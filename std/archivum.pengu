test "read_file_result is err for a missing file and ok for a present one":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "rfr")
    let path as string is calling _arch_path with base, "a.txt"
    let missing as string is calling _arch_path with base, "missing.txt"
    calling write_file with path, "content"
    let bad as result of string to IoError is calling read_file_result with missing
    calling _arch_expect_true with (not (bad.is_ok)), "missing is err"
    let e as IoError is bad.error
    calling _arch_expect_str with (calling describe_error with e), "no such file or directory", "missing error"
    let good as result of string to IoError is calling read_file_result with path
    calling _arch_expect_true with (good.is_ok), "present is ok"
    if good.is_ok:
        calling _arch_expect_str with (good.value), "content", "result text"
    calling _arch_cleanup with base

test "the result variants report the ok path":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "okpath")
    let path as string is calling _arch_path with base, "a.txt"
