    calling _arch_expect_true with (names.is_present), "read_dir present"
    if names.is_present:
        calling _arch_expect_int with (names.value.len), 1, "read_dir len"
        if names.value.len == 1:
            calling _arch_expect_str with ((names.value) at 0), "a.txt", "read_dir name"
    let full as list of string is calling read_dir_full with base
    calling _arch_expect_int with (full.len), 1, "read_dir_full len"
    if full.len == 1:
        calling _arch_expect_str with (full at 0), path, "read_dir_full path"
    let no_dir as list of string is calling read_dir_full with (calling _arch_path with base, "nope")
    calling _arch_expect_int with (no_dir.len), 0, "read_dir_full missing"
    calling _arch_cleanup with base

