test "list_files_recursive and walk visit the tree":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "walk")
    let sub as string is calling _arch_path with base, "sub"
    calling create_dir with sub, true
    let f1 as string is calling _arch_path with base, "top.txt"
    let f2 as string is calling _arch_path with sub, "deep.txt"
    calling write_file with f1, "1"
    calling write_file with f2, "2"
    let all as list of string is calling list_files_recursive with base
    calling _arch_expect_int with (all.len), 2, "list_files_recursive"
    let levels as list of list of string is calling walk with base
    calling _arch_expect_true with (levels.len) >= 2, "walk levels"
    if levels.len >= 1:
        calling _arch_expect_true with ((levels at 0).len) >= 2, "walk root level"
    calling _arch_cleanup with base

test "glob finds the fixture inside its own directory":
    # `glob` always starts from the process working directory, so the test
    # changes into its unique directory, writes its own fixture there and
    # restores the original directory on every exit path.
    let here as maybe string is calling rites.getcwd
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "globtest")
    calling _arch_expect_true with (calling rites.chdir with base), "glob chdir"
    let pattern as string is "pengu_arch_glob_fixture"
    let path as string is calling _arch_path with base, "pengu_arch_glob_fixture.txt"
    calling _arch_expect_true with (calling write_file with path, "x"), "glob fixture write"
    let hits as list of string is calling glob with pattern
    calling _arch_expect_int with hits.len, 1, "glob hits"
    if hits.len == 1:
        calling _arch_expect_true with (calling compass.basename with (hits at 0)) == "pengu_arch_glob_fixture.txt", "glob name"
    calling _arch_expect_true with (calling delete_file with path), "glob fixture delete"
    calling _arch_cleanup with base
    if here.is_present:
        calling _arch_expect_true with (calling rites.chdir with here.value), "glob chdir back"
        banish here.value

test "dir_size sums the top-level files":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "dirsize")
    let f1 as string is calling _arch_path with base, "a.txt"
    let f2 as string is calling _arch_path with base, "b.txt"
    calling write_file with f1, "12345"
    calling write_file with f2, "123"
    let total as maybe int is calling dir_size with base, false
    calling _arch_expect_true with (total.is_present), "dir_size present"
    if total.is_present:
        calling _arch_expect_int with (total.value), 8, "dir_size value"
    let no_dir as maybe int is calling dir_size with f1, false
    calling _arch_expect_true with not (no_dir.is_present), "dir_size on file"
    calling _arch_cleanup with base

test "time helpers read the metadata timestamps":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "times")
    let path as string is calling _arch_path with base, "a.txt"
    calling write_file with path, "x"
    let mtime as maybe float is calling modified_time with path
    calling _arch_expect_true with (mtime.is_present), "modified_time present"
    let ctime as maybe float is calling created_time with path
    calling _arch_expect_true with (ctime.is_present), "created_time present"
    let atime as maybe float is calling accessed_time with path
    calling _arch_expect_true with (atime.is_present), "accessed_time present"
    let no_time as maybe float is calling modified_time with (calling _arch_path with base, "nope")
    calling _arch_expect_true with not (no_time.is_present), "missing time none"
    calling _arch_cleanup with base

test "symlink and read_symlink work and realpath resolves":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "link")
    let path as string is calling _arch_path with base, "a.txt"
    let link_path as string is calling _arch_path with base, "latest"
    calling write_file with path, "x"
    calling _arch_expect_true with (calling symlink with path, link_path), "symlink"
    calling _arch_expect_true with (calling is_symlink with link_path), "is_symlink"
    let target as maybe string is calling read_symlink with link_path
    calling _arch_expect_true with (target.is_present), "read_symlink present"
    if target.is_present:
        calling _arch_expect_str with (target.value), path, "link target"
    let abs_path as maybe string is calling realpath with path
    calling _arch_expect_true with (abs_path.is_present), "realpath present"
    if abs_path.is_present:
        calling _arch_expect_true with ((abs_path.value) length) > 0, "realpath text"
    let sr as result of bool to IoError is calling symlink_result with path, link_path
    calling _arch_expect_true with (not (sr.is_ok)), "second symlink is err"
    calling _arch_cleanup with base

test "temp_dir and temp_file name a usable location":
    let tmp as string is calling temp_dir
    calling _arch_expect_true with (calling is_dir with tmp), "temp_dir exists"
    let cand as string is calling temp_file with "archivum_test"
    calling _arch_expect_true with (cand length) > 0, "temp_file text"
    calling _arch_expect_true with not (calling exists with cand), "temp_file free"
    calling _arch_expect_true with (calling write_file with cand, "tmp"), "temp_file write"
    calling _arch_expect_true with (calling delete_file with cand), "temp_file delete"

test "Path enchanting exposes the filesystem methods":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "path")
    let p as compass.Path is with raw is (calling _arch_path with base, "p.txt")
    calling _arch_expect_true with (calling p.write_text with "path text"), "write_text"
    let got as maybe string is calling p.read_text
    calling _arch_expect_true with (got.is_present), "read_text present"
    if got.is_present:
        calling _arch_expect_str with (got.value), "path text", "path text"
    let lines as maybe list of string is calling p.read_lines
    calling _arch_expect_true with (lines.is_present), "path read_lines"
    let dir as compass.Path is with raw is base
    let entries as list of string is calling dir.iter_dir
    calling _arch_expect_int with (entries.len), 1, "path iter_dir"
    let md as maybe map of string to string is calling p.stat
    calling _arch_expect_true with (md.is_present), "path stat"
    let sub as compass.Path is with raw is (calling _arch_path with base, "psub")
    calling _arch_expect_true with (calling sub.mkdir with true), "path mkdir"
    let sub_file as compass.Path is with raw is (calling _arch_path with base, "psubfile.txt")
    calling _arch_expect_true with (calling sub_file.write_text with "x"), "path sub write"
    calling _arch_expect_true with (calling sub.rmdir with true), "path rmdir"
    calling _arch_expect_true with (calling p.delete), "path delete"
    calling _arch_expect_true with not (calling p.exists), "path deleted"
    calling _arch_cleanup with base
