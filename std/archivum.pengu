    calling _arch_expect_true with (calling is_writable with path), "is_writable"
    calling _arch_expect_true with (not (calling is_readable with missing)), "missing not readable"
    calling _arch_expect_true with (not (calling is_writable with missing)), "missing not writable"
    calling _arch_expect_true with (not (calling is_readable with base)), "dir not readable"
    calling _arch_cleanup with base

