    calling _arch_expect_true with (perm_mode.is_present), "permissions present"
    if perm_mode.is_present:
        calling _arch_expect_true with ((perm_mode.value) & 256) != 0, "owner read bit"
        calling _arch_expect_true with ((perm_mode.value) & 128) != 0, "owner write bit"
    calling _arch_cleanup with base

test "is_readable and is_writable answer for files and missing paths":
    let base as string is calling _arch_fresh_dir with (calling _arch_base with "rw")
    let path as string is calling _arch_path with base, "a.txt"
    let missing as string is calling _arch_path with base, "missing.txt"
