-- std/iason.pengu — JSON.
--
-- S8. `Json` es un árbol: un `rune` con la etiqueta del nodo y los campos que
-- cada etiqueta usa (`kind` dice cuál). La recursión pasa por `Vec`, que ya es
-- una indirección, así que el tipo se puede derivar (Clone/Show a mano).
--
--   null    → (sin campos)
--   bool    → `flag`
--   int     → `integer`
--   float   → `number`
--   string  → `text`
--   array   → `items`
--   object  → `items` (valores) + `keys` (claves, mismo orden)
scroll iason
    unveil rune IasonError
        unveil message: String
        unveil offset: Usize

    -- `items` guarda los hijos de un array y los valores de un objeto; `keys`
    -- guarda las claves del objeto en el mismo orden (vacío para arrays).
    unveil rune Json
        unveil kind: String
        unveil flag: Bool
        unveil integer: Int
        unveil number: Float
        unveil text: String
        unveil items: Vec[Json]
        unveil keys: Vec[String]

    unveil ritual IasonError for Show
        show = (@) -> String
            format("IasonError(#{@.message} en #{@.offset})")

    foreign "pengu"
        iason_parse = (text: Str) -> Result[Json, IasonError]
        iason_stringify = (value: &Json) -> String
        iason_pretty = (value: &Json, indent: Int) -> String
        iason_equals = (left: &Json, right: &Json) -> Bool
        iason_push = (value: &mut Json, item: &Json) -> Unit
        iason_insert = (value: &mut Json, key: String, item: &Json) -> Unit
        iason_set = (value: &mut Json, key: String, item: &Json) -> Unit
        iason_remove = (value: &mut Json, key: Str) -> Bool

    -- Constructores.
    unveil null_value = () -> Json
        Json(kind: "null", flag: false, integer: 0, number: 0.0, text: String.new(), items: Vec.new(), keys: Vec.new())

    unveil bool_value = (value: Bool) -> Json
        Json(kind: "bool", flag: value, integer: 0, number: 0.0, text: String.new(), items: Vec.new(), keys: Vec.new())

    unveil int_value = (value: Int) -> Json
        Json(kind: "int", flag: false, integer: value, number: 0.0, text: String.new(), items: Vec.new(), keys: Vec.new())

    unveil float_value = (value: Float) -> Json
        Json(kind: "float", flag: false, integer: 0, number: value, text: String.new(), items: Vec.new(), keys: Vec.new())

    unveil string_value = (value: &Str) -> Json
        Json(kind: "string", flag: false, integer: 0, number: 0.0, text: String.from(value), items: Vec.new(), keys: Vec.new())

    unveil array_value = (items: Vec[Json]) -> Json
        Json(kind: "array", flag: false, integer: 0, number: 0.0, text: String.new(), items: items, keys: Vec.new())

    unveil object_value = (keys: Vec[String], items: Vec[Json]) -> Json
        Json(kind: "object", flag: false, integer: 0, number: 0.0, text: String.new(), items: items, keys: keys)

    unveil parse = (text: &Str) -> Result[Json, IasonError]
        iason_parse(text)

    unveil to_string = (value: &Json) -> String
        iason_stringify(value)

    unveil pretty = (value: &Json, indent: Int) -> String
        iason_pretty(value, indent)

    unveil ritual Json
        kind_of = (@) -> String
            @.kind.to_string()

        is_null = (@) -> Bool
            @.kind.as_str() == "null"

        is_bool = (@) -> Bool
            @.kind.as_str() == "bool"

        is_number = (@) -> Bool
            @.kind.as_str() == "int" or @.kind.as_str() == "float"

        is_int = (@) -> Bool
            @.kind.as_str() == "int"

        is_float = (@) -> Bool
            @.kind.as_str() == "float"

        is_string = (@) -> Bool
            @.kind.as_str() == "string"

        is_array = (@) -> Bool
            @.kind.as_str() == "array"

        is_object = (@) -> Bool
            @.kind.as_str() == "object"

        as_bool = (@) -> Option[Bool]
            if @.kind.as_str() == "bool" then
                some(@.flag)
            else
                none

        as_int = (@) -> Option[Int]
            if @.kind.as_str() == "int" then
                some(@.integer)
            else
                none

        as_float = (@) -> Option[Float]
            if @.kind.as_str() == "float" then
                some(@.number)
            elseif @.kind.as_str() == "int" then
                some(@.integer.to_float())
            else
                none

        as_string = (@) -> Option[String]
            if @.kind.as_str() == "string" then
                some(@.text.to_string())
            else
                none

        len = (@) -> Usize
            if @.kind.as_str() == "array" then
                @.items.len()
            elseif @.kind.as_str() == "object" then
                @.items.len()
            elseif @.kind.as_str() == "string" then
                @.text.len()
            else
                0_usize

        at = (@, index: Usize) -> Option[Json]
            if @.kind.as_str() == "array" or @.kind.as_str() == "object" then
                morph out: Option[Json] = none
                morph i = 0_usize
                while i < @.items.len()
                    if i == index then
                        match @.items.get(i)
                            when some(item) then
                                out = some(item.copy())
                            when none then
                                out = none
                    i = i + 1_usize
                out
            else
                none

        get = (@, key: &Str) -> Option[Json]
            if @.kind.as_str() != "object" then
                none
            else
                morph found: Option[Json] = none
                morph i = 0_usize
                while i < @.keys.len()
                    match @.keys.get(i)
                        when some(k) then
                            if k.as_str() == key then
                                match @.items.get(i)
                                    when some(item) then
                                        found = some(item.copy())
                                    when none then
                                        found = none
                        when none then
                            found = none
                    i = i + 1_usize
                found

        has = (@, key: &Str) -> Bool
            match @.get(key)
                when some(_) then
                    true
                when none then
                    false

        keys_of = (@) -> Vec[String]
            @.keys.clone()

        items_of = (@) -> Vec[Json]
            @.items.clone()

        to_string = (@) -> String
            iason_stringify(@)

        pretty_string = (@, indent: Int) -> String
            iason_pretty(@, indent)

        equals = (@, other: &Json) -> Bool
            iason_equals(@, other)

        -- Acceso por ruta punteada: `get_path("a.b.0")` para arrays usa el
        -- índice como número.
        get_path = (@, path: &Str) -> Option[Json]
            morph current = @.copy()
            morph alive = true
            for part in path.split(".")
                if alive then
                    morph next: Option[Json] = none
                    match Int.from_str(part)
                        when some(index) then
                            next = current.at(index as Usize)
                        when none then
                            next = current.get(part)
                    match next
                        when some(value) then
                            current = value
                        when none then
                            alive = false
            if alive then some(current) else none

        push = (@mut, item: &Json) -> Unit
            iason_push(@, item)

        insert = (@mut, key: &Str, item: &Json) -> Unit
            iason_insert(@, String.from(key), item)

        set = (@mut, key: &Str, item: &Json) -> Unit
            iason_set(@, String.from(key), item)

        remove = (@mut, key: &Str) -> Bool
            iason_remove(@, key)

        -- Copia superficial del nodo (los `Vec` clonan a sus elementos).
        copy = (@) -> Json
            Json(kind: @.kind.to_string(), flag: @.flag, integer: @.integer, number: @.number, text: @.text.to_string(), items: @.items.clone(), keys: @.keys.clone())
