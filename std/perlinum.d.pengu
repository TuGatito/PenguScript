# std/perlinum.d.pengu - The Perlinum (3D Perlin noise generation)
# Pure C-binding declaration file: every declaration maps 1:1 to the native
# stb_perlin C API. This file cannot contain implementation bodies (.d.pengu rule).
# Memory ownership follows the native library contract: read the upstream docs
# next to each declaration; release any returned handle with the library's own
# cleanup routine before dropping the last reference.

## PenguScript declaration binding generated by 'pengu bind'.
## Source header: perlinum.h
include "perlinum.h"

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Functions (every name receives the insignia prefix)
# ------------------------------------------------------------------

insignia stb_

declare perlin_noise3 with x as f32, y as f32, z as f32, x_wrap as int, y_wrap as int, z_wrap as int into f32

declare perlin_noise3_seed with x as f32, y as f32, z as f32, x_wrap as int, y_wrap as int, z_wrap as int, seed as int into f32

declare perlin_ridge_noise3 with x as f32, y as f32, z as f32, lacunarity as f32, gain as f32, offset as f32, octaves as int into f32

declare perlin_fbm_noise3 with x as f32, y as f32, z as f32, lacunarity as f32, gain as f32, octaves as int into f32

declare perlin_turbulence_noise3 with x as f32, y as f32, z as f32, lacunarity as f32, gain as f32, octaves as int into f32

declare perlin_noise3_wrap_nonpow2 with x as f32, y as f32, z as f32, x_wrap as int, y_wrap as int, z_wrap as int, seed as byte into f32
