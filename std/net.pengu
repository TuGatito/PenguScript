## std.net.pengu — blocking TCP sockets for long-lived tools (LSP `--tcp`).
##
## The LSP transport needs a listening socket, accepted connections and
## byte-exact reads/writes.  This module exposes exactly that surface: a plain
## `Socket` rune holding the OS descriptor and free functions for the
## operations, so no heap object hides behind the handle.
##
## ## Example
## ```pengu
## import std.net
## ##
## weave main into int:
##     let server as result of net.Socket to string is calling net.listen with "127.0.0.1", 0
##     if server is ok:
##         let conn as result of net.Socket to string is calling net.accept with (sigil of server.value)
##         if conn is ok:
##             let frame as string is calling net.read with (sigil of conn.value), 4096
##             calling net.close with (sigil of conn.value)
##             banish frame
##         calling net.close with (sigil of server.value)
##     return 0
## ```
##
## ## Memory
## `listen`/`accept`/`connect` return a `result` whose payload is a value rune;
## a failed result owns its error string and must be released with `banish`
## (or matched with `or:`).  `read` returns an owned string; `write` borrows its
## argument.  A `Socket` is just an integer descriptor: `net.close` is the only
## resource release and is idempotent.
##
## ## Design notes
## - **POSIX first.** Linux/macOS use BSD sockets.  Windows builds expose the
##   same API but return an `err_of` “not available” result instead of failing
##   to compile; the LSP stdio transport is the portable path.
## - **Blocking by design.** The server loop is one connection per thread or one
##   blocking read; the LSP does not need non-blocking I/O for its framing.
## - **Explicit async.** `*_async` variants take a `std.reactor.EventLoop` and
##   suspend the current task on the loop's epoll/poll set. They require a
##   non-blocking socket (call `set_nonblocking` first) and panic otherwise.
## - **Descriptors are `i64`.** A Windows `SOCKET` is pointer-sized, so a 32-bit
##   `int` would truncate it.  `i64` keeps the ABI correct on every platform.
## - **Negative errno.** The C bridge returns `-errno`; the wrappers turn that
##   into a human-readable `err(...)` string with `strerror`.

const NET_VERSION as string is "3.2.0"

import std.reactor

rune ResolveJob:
    host as string
    port as int
    ip as string
    family as int
    rc as int

weave _net_resolve_worker with ctx as ref to void into void:
    var job as ref to ResolveJob is transmute ctx to ref to ResolveJob
    set job->rc is calling _net_resolve with job->host, job->port, (sigil of job->ip), (sigil of job->family)

weave _net_resolve_noop with box as ref to void into void:
    return


when os == "windows":
    include "io.h"
    include "winsock2.h"
    include "ws2tcpip.h"
else:
    include "sys/socket.h"
    include "netdb.h"
    include "arpa/inet.h"
    include "unistd.h"
    include "errno.h"
    include "fcntl.h"
    include "sys/ioctl.h"

# ----------------------------------------------------------------------------
# Socket handle
# ----------------------------------------------------------------------------

## A live TCP connection or listening socket.
##
## `fd` is a negative sentinel when closed.  Copying the rune copies the
## descriptor, so only one owner should call `close`.
rune Socket:
    fd as i64

## True when the handle has not been closed.
weave is_open with s as ref to Socket into bool:
    return s->fd >= 0

## Closes `s` and marks it closed.  Safe to call twice.
weave close with s as ref to Socket into void:
    if s->fd >= 0:
        calling _net_close with s->fd
        set s->fd is 0 - 1

# ----------------------------------------------------------------------------
# Error text
# ----------------------------------------------------------------------------

weave _net_error_text with code as int into string:
    return calling _net_strerror with code

antiquus _net_strerror with code as int into string:
    r"""
int e = code;
const char *msg = (e != 0) ? strerror(e) : "socket error";
return pengu_string_new(msg);
"""

# ----------------------------------------------------------------------------
# Listening / accepting / connecting
# ----------------------------------------------------------------------------

## Creates a TCP listening socket bound to `host`:`port`.
##
## `port` 0 asks the OS for an ephemeral port (useful in tests).  The result is
## a `result of Socket to string`: `ok(socket)` or `err(message)`.
weave listen with host as string, port as int into result of Socket to string:
    let fd as i64 is calling _net_listen with host , port
    if fd < 0:
        let msg as string is calling _net_error_text with (0 - fd to int)
        return calling err_of with msg
    return calling ok_of with (with fd is fd)

## Accepts one pending connection on `s`.
weave accept with s as ref to Socket into result of Socket to string:
    let fd as i64 is calling _net_accept with s->fd
    if fd < 0:
        let msg as string is calling _net_error_text with (0 - fd to int)
        return calling err_of with msg
    return calling ok_of with (with fd is fd)

## Connects to `host`:`port`.
weave connect with host as string, port as int into result of Socket to string:
    let fd as i64 is calling _net_connect with host , port
    if fd < 0:
        let msg as string is calling _net_error_text with (0 - fd to int)
        return calling err_of with msg
    return calling ok_of with (with fd is fd)

# ----------------------------------------------------------------------------
# Data transfer
# ----------------------------------------------------------------------------

## Reads up to `max_bytes` bytes from `s`.
##
## Returns an owned string; a closed connection or error yields an empty string
## (use `read_exact` when a short read must be reported).
weave read with s as ref to Socket, max_bytes as int into string:
    return calling _net_read with s->fd , max_bytes

## Reads exactly `n` bytes from `s`.
##
## Returns `some bytes` only when all requested bytes arrived before EOF.
weave read_exact with s as ref to Socket, n as int into maybe string:
    return calling _net_read_exact with s->fd , n

## Writes every byte of `data` to `s`.
##
## Returns the number of bytes written, or a negative value on error.
weave write with s as ref to Socket, data as string into int:
    return calling _net_write with s->fd , data

# ----------------------------------------------------------------------------
# Non-blocking mode and explicit async operations
# ----------------------------------------------------------------------------

## Puts `s` in non-blocking mode. Returns 0 or `-errno`.
weave set_nonblocking with s as ref to Socket into int:
    return calling _net_set_nonblocking with s->fd

## The platform's `EAGAIN`/`EWOULDBLOCK` value. Compare bridge results with
## `0 - net.would_block()` instead of hard-coding a number.
weave would_block into int:
    return calling _net_would_block

## Whether `s` is currently non-blocking.
weave is_nonblocking with s as ref to Socket into bool:
    return (calling _net_is_nonblocking with s->fd) == 1

## Local port of `s` (useful after binding port 0). Returns 0 on error.
weave local_port with s as ref to Socket into int:
    return calling _net_local_port with s->fd

## Accepts one connection without blocking the reactor task. The accepted
## socket is put in non-blocking mode.
weave accept_async with loop as ref to reactor.EventLoop, s as ref to Socket into result of Socket to string:
    if not calling is_nonblocking with s:
        calling spark.panic with "net.accept_async: listener must be non-blocking (call set_nonblocking)"
    var wb as int is 0 - calling _net_would_block
    while true:
        var fd as i64 is calling _net_accept_nb with s->fd
        if fd >= 0:
            return calling ok_of with (with fd is fd)
        if fd != wb:
            let msg as string is calling _net_error_text with (0 - fd to int)
            return calling err_of with msg
        calling loop.park_read with (s->fd to int)

## Connects without blocking the reactor task. The name is resolved on the
## loop's worker pool (no blocking DNS on the loop thread), then the socket is
## connected non-blockingly. The returned socket is non-blocking.
weave connect_async with loop as ref to reactor.EventLoop, host as string, port as int into result of Socket to string:
    var job as ResolveJob is with host is host, port is port, ip is "", family is 0, rc is 0
    var token as i64 is calling loop.offload with _net_resolve_worker, _net_resolve_noop, (sigil of job)
    calling loop.await_token with token
    if job.rc != 0:
        let rmsg as string is calling _net_error_text with (0 - job.rc)
        return calling err_of with rmsg
    var fd as i64 is 0
    var rc as int is calling _net_connect_addr with job.ip, port, job.family, (sigil of fd)
    banish job.ip
    if rc == 0:
        return calling ok_of with (with fd is fd)
    if rc != 1:
        let msg as string is calling _net_error_text with (0 - rc)
        return calling err_of with msg
    var s as Socket is with fd is fd
    calling loop.park_write with (fd to int)
    var err as int is calling _net_so_error with fd
    if err != 0:
        calling _net_close with fd
        let msg2 as string is calling _net_error_text with err
        return calling err_of with msg2
    return calling ok_of with s

## Reads up to `max_bytes` on the loop. Returns an owned string (empty on EOF).
weave read_async with loop as ref to reactor.EventLoop, s as ref to Socket, max_bytes as int into string:
    if not calling is_nonblocking with s:
        calling spark.panic with "net.read_async: socket must be non-blocking (call set_nonblocking)"
    var wb as int is 0 - calling _net_would_block
    while true:
        var out as string is ""
        var rc as int is calling _net_read_nb with s->fd, max_bytes, (sigil of out)
        if rc >= 0:
            return out
        if rc != wb:
            banish out
            return ""
        banish out
        calling loop.park_read with (s->fd to int)

## Reads exactly `n` bytes on the loop.
weave read_exact_async with loop as ref to reactor.EventLoop, s as ref to Socket, n as int into maybe string:
    if not calling is_nonblocking with s:
        calling spark.panic with "net.read_exact_async: socket must be non-blocking (call set_nonblocking)"
    var acc as string is ""
    while (acc.len < n):
        var wb as int is 0 - calling _net_would_block
        var out as string is ""
        var rc as int is calling _net_read_nb with s->fd, n - acc.len, (sigil of out)
        if rc == 0:
            banish acc
            banish out
            return maybe none
        if rc > 0:
            set acc is acc + out
            banish out
        else:
            banish out
            if rc != wb:
                banish acc
                return maybe none
            calling loop.park_read with (s->fd to int)
    return some acc

## Writes every byte of `data` on the loop. Returns bytes written or `-errno`.
weave write_async with loop as ref to reactor.EventLoop, s as ref to Socket, data as string into int:
    if not calling is_nonblocking with s:
        calling spark.panic with "net.write_async: socket must be non-blocking (call set_nonblocking)"
    var wb as int is 0 - calling _net_would_block
    var off as int is 0
    while off < data.len:
        var rc as int is calling _net_write_nb with s->fd, data, off
        if rc > 0:
            set off is off + rc
        else:
            if rc == wb:
                calling loop.park_write with (s->fd to int)
            else:
                return rc
    return off

# ----------------------------------------------------------------------------
# POSIX C bridges
# ----------------------------------------------------------------------------

antiquus _net_listen with host as string, port as int into i64:
    r"""
#if defined(_WIN32)
(void)host; (void)port;
return -1;
#else
char portbuf[16];
snprintf(portbuf, sizeof(portbuf), "%d", port);
char *hostbuf = (char *)malloc((size_t)host.len + 1);
if (!hostbuf)
return -1;
memcpy(hostbuf, host.data ? host.data : "", (size_t)host.len);
hostbuf[host.len] = '\0';
struct addrinfo hints;
struct addrinfo *res = NULL;
memset(&hints, 0, sizeof(hints));
hints.ai_family = AF_UNSPEC;
hints.ai_socktype = SOCK_STREAM;
hints.ai_flags = AI_PASSIVE;
int gai = getaddrinfo((host.len > 0) ? hostbuf : NULL, portbuf, &hints, &res);
free(hostbuf);
if (gai != 0)
return -1;
int64_t result = -1;
for (struct addrinfo *rp = res; rp != NULL; rp = rp->ai_next)
{
int fd = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
if (fd < 0)
continue;
int one = 1;
setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
if (bind(fd, rp->ai_addr, rp->ai_addrlen) == 0 && listen(fd, 16) == 0)
{
result = (int64_t)fd;
break;
}
close(fd);
}
freeaddrinfo(res);
return result;
#endif
"""

antiquus _net_accept with fd as i64 into i64:
    r"""
#if defined(_WIN32)
(void)fd;
return -1;
#else
if (fd < 0)
return -1;
int c = accept((int)fd, NULL, NULL);
if (c < 0)
return -(int64_t)errno;
return (int64_t)c;
#endif
"""

antiquus _net_connect with host as string, port as int into i64:
    r"""
#if defined(_WIN32)
(void)host; (void)port;
return -1;
#else
char portbuf[16];
snprintf(portbuf, sizeof(portbuf), "%d", port);
char *hostbuf = (char *)malloc((size_t)host.len + 1);
if (!hostbuf)
return -1;
memcpy(hostbuf, host.data ? host.data : "", (size_t)host.len);
hostbuf[host.len] = '\0';
struct addrinfo hints;
struct addrinfo *res = NULL;
memset(&hints, 0, sizeof(hints));
hints.ai_family = AF_UNSPEC;
hints.ai_socktype = SOCK_STREAM;
int gai = getaddrinfo(hostbuf, portbuf, &hints, &res);
free(hostbuf);
if (gai != 0)
return -1;
int64_t result = -1;
for (struct addrinfo *rp = res; rp != NULL; rp = rp->ai_next)
{
int fd = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
if (fd < 0)
continue;
if (connect(fd, rp->ai_addr, rp->ai_addrlen) == 0)
{
result = (int64_t)fd;
break;
}
close(fd);
}
freeaddrinfo(res);
return result;
#endif
"""

antiquus _net_read with fd as i64, max_bytes as int into string:
    r"""
#if defined(_WIN32)
(void)fd; (void)max_bytes;
return pengu_string_from_cstr("");
#else
if (fd < 0 || max_bytes <= 0)
return pengu_string_from_cstr("");
sds buf = sdsnewlen(NULL, (size_t)max_bytes);
if (!buf)
return pengu_string_from_cstr("");
ssize_t got;
do
{
got = recv((int)fd, buf, (size_t)max_bytes, 0);
} while (got < 0 && errno == EINTR);
if (got <= 0)
{
sdsfree(buf);
return pengu_string_from_cstr("");
}
return pengu_string_owned_from_sds_len(buf, (int)got);
#endif
"""

antiquus _net_read_exact with fd as i64, n as int into maybe string:
    r"""
#if defined(_WIN32)
(void)fd; (void)n;
return pengu_maybe_none();
#else
if (fd < 0 || n <= 0)
return pengu_maybe_none();
sds buf = sdsnewlen(NULL, (size_t)n);
if (!buf)
return pengu_maybe_none();
size_t got = 0;
while (got < (size_t)n)
{
ssize_t part = recv((int)fd, buf + got, (size_t)n - got, 0);
if (part < 0 && errno == EINTR)
continue;
if (part <= 0)
{
sdsfree(buf);
return pengu_maybe_none();
}
got += (size_t)part;
}
PenguString *boxed = (PenguString *)malloc(sizeof(PenguString));
if (!boxed)
{
sdsfree(buf);
return pengu_maybe_none();
}
*boxed = pengu_string_owned_from_sds_len(buf, n);
return pengu_maybe_some(boxed);
#endif
"""

antiquus _net_write with fd as i64, data as string into int:
    r"""
#if defined(_WIN32)
(void)fd; (void)data;
return -1;
#else
if (fd < 0 || !data.data || data.len <= 0)
return 0;
size_t sent = 0;
while (sent < (size_t)data.len)
{
ssize_t part = send((int)fd, data.data + sent, (size_t)data.len - sent, 0);
if (part < 0 && errno == EINTR)
continue;
if (part <= 0)
return -((int)errno);
sent += (size_t)part;
}
return (int)sent;
#endif
"""

antiquus _net_close with fd as i64 into void:
    r"""
#if defined(_WIN32)
(void)fd;
#else
if (fd >= 0)
close((int)fd);
#endif
"""

antiquus _net_set_nonblocking with fd as i64 into int:
    r"""
#if defined(_WIN32)
(void)fd;
return -1;
#else
int f = (int)fd;
int flags = fcntl(f, F_GETFL, 0);
if (flags < 0) return -errno;
if (fcntl(f, F_SETFL, flags | O_NONBLOCK) < 0) return -errno;
return 0;
#endif
"""

antiquus _net_is_nonblocking with fd as i64 into int:
    r"""
#if defined(_WIN32)
(void)fd;
return 0;
#else
int flags = fcntl((int)fd, F_GETFL, 0);
if (flags < 0) return 0;
return (flags & O_NONBLOCK) ? 1 : 0;
#endif
"""

antiquus _net_would_block into int:
    r"""
#if defined(_WIN32)
return WSAEWOULDBLOCK;
#else
return EAGAIN;
#endif
"""

antiquus _net_accept_nb with fd as i64 into i64:
    r"""
#if defined(_WIN32)
(void)fd;
return -1;
#else
int c = accept((int)fd, NULL, NULL);
if (c < 0) return (errno == EAGAIN || errno == EWOULDBLOCK) ? -EAGAIN : -errno;
int flags = fcntl(c, F_GETFL, 0);
if (flags >= 0) fcntl(c, F_SETFL, flags | O_NONBLOCK);
return (int64_t)c;
#endif
"""

antiquus _net_resolve with host as string, port as int, out_ip as ref to string, out_family as ref to int into int:
    r"""
#if defined(_WIN32)
(void)host; (void)port; (void)out_ip; (void)out_family;
return -1;
#else
char portbuf[16];
snprintf(portbuf, sizeof(portbuf), "%d", port);
char *hostbuf = (char *)malloc((size_t)host.len + 1);
if (!hostbuf) return -ENOMEM;
memcpy(hostbuf, host.data ? host.data : "", (size_t)host.len);
hostbuf[host.len] = '\0';
struct addrinfo hints;
struct addrinfo *res = NULL;
memset(&hints, 0, sizeof(hints));
hints.ai_family = AF_UNSPEC;
hints.ai_socktype = SOCK_STREAM;
int gai = getaddrinfo(hostbuf, portbuf, &hints, &res);
free(hostbuf);
if (gai != 0) return -EINVAL;
int ok = 0;
for (struct addrinfo *ai = res; ai; ai = ai->ai_next) {
    char buf[64];
    const void *addr = NULL;
    if (ai->ai_family == AF_INET) {
        addr = &((struct sockaddr_in *)ai->ai_addr)->sin_addr;
    } else if (ai->ai_family == AF_INET6) {
        addr = &((struct sockaddr_in6 *)ai->ai_addr)->sin6_addr;
    } else {
        continue;
    }
    if (!inet_ntop(ai->ai_family, addr, buf, sizeof(buf))) continue;
    *out_ip = pengu_string_new(buf);
    *out_family = ai->ai_family;
    ok = 1;
    break;
}
freeaddrinfo(res);
return ok ? 0 : -EINVAL;
#endif
"""

antiquus _net_connect_addr with ip as string, port as int, family as int, out_fd as ref to i64 into int:
    r"""
#if defined(_WIN32)
(void)ip; (void)port; (void)family; (void)out_fd;
return -1;
#else
struct sockaddr_storage ss;
socklen_t slen = 0;
memset(&ss, 0, sizeof(ss));
if (family == AF_INET) {
    struct sockaddr_in *sin = (struct sockaddr_in *)&ss;
    sin->sin_family = AF_INET;
    sin->sin_port = htons((uint16_t)port);
    if (inet_pton(AF_INET, ip.data ? ip.data : "", &sin->sin_addr) != 1) return -EINVAL;
    slen = sizeof(*sin);
} else if (family == AF_INET6) {
    struct sockaddr_in6 *sin6 = (struct sockaddr_in6 *)&ss;
    sin6->sin6_family = AF_INET6;
    sin6->sin6_port = htons((uint16_t)port);
    if (inet_pton(AF_INET6, ip.data ? ip.data : "", &sin6->sin6_addr) != 1) return -EINVAL;
    slen = sizeof(*sin6);
} else {
    return -EINVAL;
}
int fd = socket(family, SOCK_STREAM, 0);
if (fd < 0) return -errno;
int flags = fcntl(fd, F_GETFL, 0);
if (flags >= 0) fcntl(fd, F_SETFL, flags | O_NONBLOCK);
if (connect(fd, (struct sockaddr *)&ss, slen) == 0) {
    *out_fd = (int64_t)fd;
    return 0;
}
if (errno == EINPROGRESS) {
    *out_fd = (int64_t)fd;
    return 1;
}
int e = errno;
close(fd);
return -e;
#endif
"""

antiquus _net_connect_start with host as string, port as int, out_fd as ref to i64 into int:
    r"""
#if defined(_WIN32)
(void)host; (void)port; (void)out_fd;
return -1;
#else
char portbuf[16];
snprintf(portbuf, sizeof(portbuf), "%d", port);
char *hostbuf = (char *)malloc((size_t)host.len + 1);
if (!hostbuf) return -ENOMEM;
memcpy(hostbuf, host.data ? host.data : "", (size_t)host.len);
hostbuf[host.len] = '\0';
struct addrinfo hints;
struct addrinfo *res = NULL;
memset(&hints, 0, sizeof(hints));
hints.ai_family = AF_UNSPEC;
hints.ai_socktype = SOCK_STREAM;
int gai = getaddrinfo(hostbuf, portbuf, &hints, &res);
free(hostbuf);
if (gai != 0) return -EINVAL;
int fd = -1;
for (struct addrinfo *ai = res; ai; ai = ai->ai_next) {
    fd = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
    if (fd < 0) continue;
    int flags = fcntl(fd, F_GETFL, 0);
    if (flags >= 0) fcntl(fd, F_SETFL, flags | O_NONBLOCK);
    if (connect(fd, ai->ai_addr, ai->ai_addrlen) == 0) {
        freeaddrinfo(res);
        *out_fd = (int64_t)fd;
        return 0;
    }
    if (errno == EINPROGRESS) {
        freeaddrinfo(res);
        *out_fd = (int64_t)fd;
        return 1;
    }
    close(fd);
}
freeaddrinfo(res);
return -errno;
#endif
"""

antiquus _net_so_error with fd as i64 into int:
    r"""
#if defined(_WIN32)
(void)fd;
return -1;
#else
int err = 0;
socklen_t len = sizeof(err);
if (getsockopt((int)fd, SOL_SOCKET, SO_ERROR, &err, &len) < 0) return errno;
return err;
#endif
"""

antiquus _net_read_nb with fd as i64, max_bytes as int, out as ref to string into int:
    r"""
#if defined(_WIN32)
(void)fd; (void)max_bytes; (void)out;
return -1;
#else
char buf[65536];
int cap = max_bytes;
if (cap <= 0) cap = 1;
if (cap > (int)sizeof(buf)) cap = (int)sizeof(buf);
ssize_t n = recv((int)fd, buf, (size_t)cap, 0);
if (n < 0) return (errno == EAGAIN || errno == EWOULDBLOCK) ? -EAGAIN : -errno;
if (n == 0) return 0;
*out = pengu_string_from_cstr_len(buf, (int)n);
return 1;
#endif
"""

antiquus _net_write_nb with fd as i64, data as string, offset as int into int:
    r"""
#if defined(_WIN32)
(void)fd; (void)data; (void)offset;
return -1;
#else
int off = offset;
if (off < 0 || off >= data.len) return 0;
ssize_t n = send((int)fd, data.data + off, (size_t)(data.len - off), 0);
if (n < 0) return (errno == EAGAIN || errno == EWOULDBLOCK) ? -EAGAIN : -errno;
return (int)n;
#endif
"""

antiquus _net_local_port with fd as i64 into int:
    r"""
#if defined(_WIN32)
(void)fd;
return 0;
#else
struct sockaddr_storage ss;
socklen_t len = sizeof(ss);
if (getsockname((int)fd, (struct sockaddr *)&ss, &len) != 0) return 0;
if (ss.ss_family == AF_INET) return ntohs(((struct sockaddr_in *)&ss)->sin_port);
if (ss.ss_family == AF_INET6) return ntohs(((struct sockaddr_in6 *)&ss)->sin6_port);
return 0;
