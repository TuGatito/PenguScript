    var m as maybe int is calling b.ok
    calling _expect_eq_bool with (calling m.is_some), false, "ok err"
test "result.err expone el error como maybe":
    var b as result of int to string is calling err_of with "e"
    var m as maybe string is calling b.err
    calling _expect_eq_string with (calling m.unwrap_or with "-"), "e", "err some"
test "result.err de un ok queda vacío":
    var a as result of int to string is calling ok_of with 3
    var m as maybe string is calling a.err
    calling _expect_eq_bool with (calling m.is_some), false, "err ok"
test "result.to_maybe es un alias de ok":
    var a as result of int to string is calling ok_of with 8
    var m as maybe int is calling a.to_maybe
    calling _expect_eq_int with (calling m.unwrap_or with -1), 8, "to_maybe"
test "result.to_list tiene un elemento si es ok":
    var a as result of int to string is calling ok_of with 1
    var l as list of int is calling a.to_list
    calling _expect_eq_int with l.length, 1, "to_list ok"
test "result.to_list está vacía si es err":
    var b as result of int to string is calling err_of with "e"
    var l as list of int is calling b.to_list
    calling _expect_eq_int with l.length, 0, "to_list err"
test "result.describe formatea el éxito":
    var a as result of int to string is calling ok_of with 7
    calling _expect_eq_string with (calling a.describe), "ok(7)", "describe ok"
test "result.describe formatea el error":
    var b as result of int to string is calling err_of with "e"
    calling _expect_eq_string with (calling b.describe), "err(e)", "describe err"
test "some_of envuelve un entero":
    var m as maybe int is calling some_of with 12
    calling _expect_eq_int with (calling m.unwrap_or with 0), 12, "some_of"
test "some_of envuelve un string":
    var m as maybe string is calling some_of with "texto"
    calling _expect_eq_string with (calling m.unwrap_or with "-"), "texto", "some_of string"
test "none_of con tipo explícito construye un vacío":
    var m as maybe int is calling none_of of int
    calling _expect_eq_bool with (calling m.is_some), false, "none_of"
test "is_some_maybe detecta el valor presente":
    calling _expect_eq_bool with (calling is_some_maybe with (some 1)), true, "is_some_maybe"
test "is_some_maybe es false en un vacío":
    var n as maybe int is maybe none
    calling _expect_eq_bool with (calling is_some_maybe with n), false, "is_some_maybe none"
test "is_none_maybe detecta el vacío":
    var n as maybe int is maybe none
    calling _expect_eq_bool with (calling is_none_maybe with n), true, "is_none_maybe"
test "is_none_maybe es false con valor":
    calling _expect_eq_bool with (calling is_none_maybe with (some 2)), false, "is_none_maybe value"
test "unwrap_maybe devuelve la carga":
    calling _expect_eq_int with (calling unwrap_maybe with (some 21)), 21, "unwrap_maybe"
test "unwrap_or_maybe usa la carga presente":
    calling _expect_eq_int with (calling unwrap_or_maybe with (some 4), 0), 4, "unwrap_or_maybe"
test "unwrap_or_maybe usa el fallback en vacío":
    var n as maybe int is maybe none
    calling _expect_eq_int with (calling unwrap_or_maybe with n, 33), 33, "unwrap_or_maybe none"
test "expect_maybe devuelve la carga":
    calling _expect_eq_string with (calling expect_maybe with (some "y"), "falla"), "y", "expect_maybe"
test "value_or_maybe usa la carga presente":
    calling _expect_eq_string with (calling value_or_maybe with (some "a"), "z"), "a", "value_or_maybe"
test "value_or_maybe usa el fallback en vacío":
    var n as maybe string is maybe none
    calling _expect_eq_string with (calling value_or_maybe with n, "z"), "z", "value_or_maybe none"
test "or_else_maybe prefiere el primer valor":
    var alt as maybe int is some 9
    calling _expect_eq_int with (calling unwrap_or_maybe with (calling or_else_maybe with (some 1), alt), -1), 1, "or_else_maybe"
test "or_else_maybe usa el fallback en vacío":
    var n as maybe int is maybe none
    var alt as maybe int is some 9
    calling _expect_eq_int with (calling unwrap_or_maybe with (calling or_else_maybe with n, alt), -1), 9, "or_else_maybe alt"
test "and_maybe exige ambos valores":
    var other as maybe string is some "b"
    calling _expect_eq_string with (calling unwrap_or_maybe with (calling and_maybe with (some "a"), other), "-"), "b", "and_maybe"
test "and_maybe queda vacío si falta el segundo":
    var n as maybe string is maybe none
    calling _expect_eq_bool with (calling is_some_maybe with (calling and_maybe with (some "a"), n)), false, "and_maybe none"
test "or_maybe prefiere el primero":
    var other as maybe string is some "b"
    calling _expect_eq_string with (calling unwrap_or_maybe with (calling or_maybe with (some "a"), other), "-"), "a", "or_maybe first"
test "or_maybe usa el segundo si el primero falta":
    var other as maybe string is some "b"
    var empty as maybe string is maybe none
    calling _expect_eq_string with (calling unwrap_or_maybe with (calling or_maybe with empty, other), "-"), "b", "or_maybe second"
test "to_result_maybe produce ok con la carga":
    var r as result of int to string is calling to_result_maybe with (some 2), "no"
    calling _expect_eq_int with (calling r.unwrap), 2, "to_result_maybe"
test "to_result_maybe produce err en vacío":
    var n as maybe int is maybe none
    var r as result of int to string is calling to_result_maybe with n, "no"
    calling _expect_eq_string with (calling r.unwrap_err), "no", "to_result_maybe err"
test "to_list_maybe tiene un elemento si hay valor":
    var l as list of int is calling to_list_maybe with (some 1)
    calling _expect_eq_int with l.length, 1, "to_list_maybe one"
test "to_list_maybe está vacía sin valor":
    var n as maybe int is maybe none
    var l as list of int is calling to_list_maybe with n
    calling _expect_eq_int with l.length, 0, "to_list_maybe zero"
test "describe_optional formatea presente":
    calling _expect_eq_string with (calling describe_optional with (some 5)), "some(5)", "describe_optional"
test "describe_optional formatea vacío":
    var n as maybe int is maybe none
    calling _expect_eq_string with (calling describe_optional with n), "none", "describe_optional none"
test "iter_maybe es un alias de to_list_maybe":
    var l as list of int is calling iter_maybe with (some 1)
    calling _expect_eq_int with l.length, 1, "iter_maybe"
test "zip_maybe combina dos presentes":
    var p as maybe Pair of int and string is calling zip_maybe with (some 1), (some "u")
    if q as Pair of int and string is p:
        calling _expect_eq_int with q.first, 1, "zip_maybe first"
        calling _expect_eq_string with q.second, "u", "zip_maybe second"
test "zip_maybe queda vacío si falta alguno":
    var n as maybe string is maybe none
    calling _expect_eq_bool with (calling is_some_maybe with (calling zip_maybe with (some 1), n)), false, "zip_maybe none"
test "flatten_maybe repaqueta la carga":
    calling _expect_eq_string with (calling unwrap_or_maybe with (calling flatten_maybe with (some "k")), "-"), "k", "flatten_maybe"
test "flatten_maybe de un vacío queda vacío":
    var n as maybe string is maybe none
    calling _expect_eq_bool with (calling is_some_maybe with (calling flatten_maybe with n)), false, "flatten_maybe none"
test "is_ok_result clasifica el éxito":
    var a as result of int to string is calling ok_of with 1
    calling _expect_eq_bool with (calling is_ok_result with a), true, "is_ok_result"
test "is_ok_result es false en err":
    var b as result of int to string is calling err_of with "e"
    calling _expect_eq_bool with (calling is_ok_result with b), false, "is_ok_result err"
test "is_err_result clasifica el error":
    var b as result of int to string is calling err_of with "e"
    calling _expect_eq_bool with (calling is_err_result with b), true, "is_err_result"
test "is_err_result es false en ok":
    var a as result of int to string is calling ok_of with 1
    calling _expect_eq_bool with (calling is_err_result with a), false, "is_err_result ok"
test "unwrap_result devuelve la carga":
    var a as result of int to string is calling ok_of with 14
    calling _expect_eq_int with (calling unwrap_result with a), 14, "unwrap_result"
test "unwrap_err_result devuelve el error":
    var b as result of int to string is calling err_of with "z"
    calling _expect_eq_string with (calling unwrap_err_result with b), "z", "unwrap_err_result"
test "unwrap_or_result usa la carga en ok":
    var a as result of int to string is calling ok_of with 3
    calling _expect_eq_int with (calling unwrap_or_result with a, 0), 3, "unwrap_or_result"
test "unwrap_or_result usa el fallback en err":
    var b as result of int to string is calling err_of with "e"
    calling _expect_eq_int with (calling unwrap_or_result with b, 4), 4, "unwrap_or_result err"
test "expect_result devuelve la carga":
    var a as result of int to string is calling ok_of with 15
    calling _expect_eq_int with (calling expect_result with a, "falla"), 15, "expect_result"
test "expect_err_result devuelve el error":
    var b as result of int to string is calling err_of with "q"
    calling _expect_eq_string with (calling expect_err_result with b, "falla"), "q", "expect_err_result"
test "ok_result convierte el éxito en maybe":
    var a as result of int to string is calling ok_of with 6
    var m as maybe int is calling ok_result with a
    calling _expect_eq_int with (calling m.unwrap_or with -1), 6, "ok_result"
test "err_result convierte el error en maybe":
    var b as result of int to string is calling err_of with "w"
    var m as maybe string is calling err_result with b
    calling _expect_eq_string with (calling m.unwrap_or with "-"), "w", "err_result"
test "to_maybe_result es un alias de ok_result":
    var a as result of int to string is calling ok_of with 6
    var m as maybe int is calling to_maybe_result with a
    calling _expect_eq_int with (calling m.unwrap_or with -1), 6, "to_maybe_result"
test "to_list_result tiene un elemento si es ok":
    var a as result of int to string is calling ok_of with 1
    var l as list of int is calling to_list_result with a
    calling _expect_eq_int with l.length, 1, "to_list_result ok"
test "to_list_result está vacía si es err":
    var b as result of int to string is calling err_of with "e"
    var l as list of int is calling to_list_result with b
    calling _expect_eq_int with l.length, 0, "to_list_result err"
test "describe_result formatea ok":
    var a as result of int to string is calling ok_of with 3
    calling _expect_eq_string with (calling describe_result with a), "ok(3)", "describe_result"
test "describe_result formatea err":
    var b as result of int to string is calling err_of with "m"
    calling _expect_eq_string with (calling describe_result with b), "err(m)", "describe_result err"
test "all_present es true cuando todos tienen valor":
    var ms as list of maybe int is [some 1, some 2]
    calling _expect_eq_bool with (calling all_present with ms), true, "all_present"
test "all_present es false con un vacío":
    var ms as list of maybe int is [some 1, maybe none]
    calling _expect_eq_bool with (calling all_present with ms), false, "all_present false"
test "all_present de una lista vacía es true":
    var ms as list of maybe int is list of maybe int
    calling _expect_eq_bool with (calling all_present with ms), true, "all_present empty"
test "first_present devuelve la primera carga":
    var ms as list of maybe int is [maybe none, some 4, some 5]
    var f as maybe int is calling first_present with ms
    calling _expect_eq_int with (calling f.unwrap_or with -1), 4, "first_present"
test "first_present queda vacío sin cargas":
    var ms as list of maybe int is [maybe none, maybe none]
    var f as maybe int is calling first_present with ms
    calling _expect_eq_bool with (calling f.is_some), false, "first_present none"
test "any_present detecta al menos una carga":
    var ms as list of maybe int is [maybe none, some 1]
    calling _expect_eq_bool with (calling any_present with ms), true, "any_present"
test "any_present es false sin cargas":
    var ms as list of maybe int is [maybe none]
    calling _expect_eq_bool with (calling any_present with ms), false, "any_present false"
test "collect_ok reúne los éxitos en orden":
    var a as result of int to string is calling ok_of with 1
    var b as result of int to string is calling err_of with "e"
    var c as result of int to string is calling ok_of with 3
    var rs as list of result of int to string is [a, b, c]
    var oks as list of int is calling collect_ok with rs
    calling _expect_eq_int with oks.length, 2, "collect_ok len"
    calling _expect_eq_int with (oks at 1), 3, "collect_ok second"
test "collect_err reúne los errores en orden":
    var a as result of int to string is calling ok_of with 1
    var b as result of int to string is calling err_of with "e"
    var rs as list of result of int to string is [a, b]
    var errs as list of string is calling collect_err with rs
    calling _expect_eq_int with errs.length, 1, "collect_err len"
    calling _expect_eq_string with (errs at 0), "e", "collect_err first"
test "collect_ok y collect_err de una lista vacía":
    var rs as list of result of int to string is list of result of int to string
    var oks as list of int is calling collect_ok with rs
    var errs as list of string is calling collect_err with rs
    calling _expect_eq_int with oks.length, 0, "collect_ok empty"
    calling _expect_eq_int with errs.length, 0, "collect_err empty"
test "partition_results separa éxitos y errores":
    var a as result of int to string is calling ok_of with 1
    var b as result of int to string is calling err_of with "e"
    var c as result of int to string is calling ok_of with 3
    var rs as list of result of int to string is [a, b, c]
    var p as Pair of list of int and list of string is calling partition_results with rs
    var oks as list of int is p.first
    var errs as list of string is p.second
    calling _expect_eq_int with oks.length, 2, "partition oks"
    calling _expect_eq_int with errs.length, 1, "partition errs"
test "partition_results con sólo errores":
    var a as result of int to string is calling err_of with "a"
    var b as result of int to string is calling err_of with "b"
    var rs as list of result of int to string is [a, b]
    var p as Pair of list of int and list of string is calling partition_results with rs
    var oks as list of int is p.first
    var errs as list of string is p.second
    calling _expect_eq_int with oks.length, 0, "partition no oks"
    calling _expect_eq_int with errs.length, 2, "partition errs"
test "partition_results conserva los valores":
    var a as result of int to string is calling ok_of with 7
    var rs as list of result of int to string is [a]
    var p as Pair of list of int and list of string is calling partition_results with rs
    var oks as list of int is p.first
    calling _expect_eq_int with (oks at 0), 7, "partition value"
test "legacy MaybeInt conserva sus métodos":
    var m as MaybeInt is calling maybe_some_int with 5
    var n as MaybeInt is calling maybe_none_int
    calling _expect_eq_bool with (calling m.is_present), true, "is_present"
    calling _expect_eq_int with (calling n.unwrap_or with 2), 2, "unwrap_or"
test "legacy MaybeString conserva su unwrap":
    var s as MaybeString is calling maybe_some_string with "s"
    calling _expect_eq_string with (calling s.unwrap_or with "-"), "s", "unwrap_or string"
test "legacy ResultInt conserva sus métodos":
    var a as ResultInt is calling result_ok_int with 1
    var b as ResultInt is calling result_err_int with "bad"
    calling _expect_eq_bool with (calling a.is_ok), true, "is_ok"
    calling _expect_eq_string with (calling b.unwrap_err), "bad", "unwrap_err"
test "legacy ResultString conserva su unwrap_err":
    var d as ResultString is calling result_err_string with "no"
    calling _expect_eq_string with (calling d.unwrap_err), "no", "unwrap_err string"
test "legacy constructores nativos de maybe":
    var m as maybe int is calling some_int with 9
    var n as maybe int is calling none_int
    calling _expect_eq_int with (calling unwrap_int with m), 9, "unwrap_int"
    calling _expect_eq_int with (calling unwrap_or_int with n, 4), 4, "unwrap_or_int"
test "legacy constructores nativos de float y bool":
    var f as maybe float is calling some_float with 1.5
    var b as maybe bool is calling some_bool with true
    calling _expect_eq_bool with ((calling unwrap_float with f) > 1.0), true, "unwrap_float"
    calling _expect_eq_bool with (calling unwrap_bool with b), true, "unwrap_bool"
test "legacy none_bool y unwrap_or_bool":
    calling _expect_eq_bool with (calling unwrap_or_bool with (calling none_bool), true), true, "unwrap_or_bool"
test "legacy describe_maybe_int conserva su formato":
    var a as maybe int is calling some_int with 8
    calling _expect_eq_string with (calling describe_maybe_int with a), "some(8)", "describe_maybe_int"
test "legacy describe_maybe_string conserva su formato":
    var s as maybe string is calling some_string with "x"
    calling _expect_eq_string with (calling describe_maybe_string with s), "some(\"x\")", "describe_maybe_string"
test "legacy describe_maybe_int de un vacío":
    var n as maybe int is calling none_int
    calling _expect_eq_string with (calling describe_maybe_int with n), "none", "describe none"
test "legacy describe_int y describe_string conservan su formato":
    var a as MaybeInt is calling maybe_some_int with 3
    var b as MaybeString is calling maybe_some_string with "v"
    calling _expect_eq_string with (calling describe_int with a), "some(3)", "describe_int"
    calling _expect_eq_string with (calling describe_string with b), "some(\"v\")", "describe_string"
test "legacy describe_result_int y describe_result_string":
    var a as ResultInt is calling result_ok_int with 2
    var b as ResultString is calling result_err_string with "e"
    calling _expect_eq_string with (calling describe_result_int with a), "ok(2)", "describe_result_int"
    calling _expect_eq_string with (calling describe_result_string with b), "err(e)", "describe_result_string"
test "legacy puentes to_native_int y from_native_int":
    var m as MaybeInt is calling maybe_some_int with 6
    var nat as maybe int is calling to_native_int with m
    var back as MaybeInt is calling from_native_int with nat
    calling _expect_eq_int with (calling unwrap_int with nat), 6, "to_native_int"
    calling _expect_eq_int with (calling back.unwrap_or with 0), 6, "from_native_int"
test "legacy puentes to_native_string y from_native_string":
    var s as MaybeString is calling maybe_some_string with "puente"
    var nat as maybe string is calling to_native_string with s
    var back as MaybeString is calling from_native_string with nat
    calling _expect_eq_string with (calling back.unwrap_or with ""), "puente", "from_native_string"
test "legacy helpers de result nativo":
    var a as result of int to string is calling ok_of with 4
    var b as result of int to string is calling err_of with "e"
    calling _expect_eq_bool with (calling is_ok_int_result with a), true, "is_ok_int_result"
    calling _expect_eq_bool with (calling is_err_int_result with b), true, "is_err_int_result"
    calling _expect_eq_int with (calling unwrap_int_result with a), 4, "unwrap_int_result"
    calling _expect_eq_int with (calling unwrap_or_int_result with b, 6), 6, "unwrap_or_int_result"
test "legacy result_ok_string sigue expuesto":
    var r as ResultString is calling result_ok_string with "ok"
    calling _expect_eq_string with (calling r.unwrap_or with "-"), "ok", "result_ok_string"
