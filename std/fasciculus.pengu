-- std/fasciculus.pengu — Set[T]
--
-- S3. Paso directo a `HashSet` de Rust (clase T3). Requiere `T: Eq + Hash`.
-- Las operaciones de conjunto se implementan como ayudantes genéricos porque
-- `HashSet` de Rust las ofrece como operadores o como `*_update` aún inestables
-- en la versión mínima soportada (1.85).
--
-- Diferidos a S7 (necesitan `Iter[T]`): `iter`, `drain`.
scroll fasciculus
    ritual[T] Set[T]
        new = () -> Set[T]
            panic("passthrough")

        with_capacity = (n: Usize) -> Set[T]
            panic("passthrough")

        insert = (@mut, value: T) -> Bool
            panic("passthrough")

        contains = (@, value: &T) -> Bool
            panic("passthrough")

        get = (@, value: &T) -> Option[&T]
            panic("passthrough")

        take = (@mut, value: &T) -> Option[T]
            panic("passthrough")

        replace = (@mut, value: T) -> Option[T]
            panic("passthrough")

        remove = (@mut, value: &T) -> Bool
            panic("passthrough")

        len = (@) -> Usize
            panic("passthrough")

        is_empty = (@) -> Bool
            panic("passthrough")

        clear = (@mut) -> Unit
            panic("passthrough")

        retain = (@mut, f: (T) -> Bool) -> Unit
            panic("passthrough")

        extend = (@mut, other: Set[T]) -> Unit
            panic("passthrough")

        union = (@, other: &Set[T]) -> Set[T]
            panic("passthrough")

        intersection = (@, other: &Set[T]) -> Set[T]
            panic("passthrough")

        difference = (@, other: &Set[T]) -> Set[T]
            panic("passthrough")

        symmetric_difference = (@, other: &Set[T]) -> Set[T]
            panic("passthrough")

        is_subset = (@, other: &Set[T]) -> Bool
            panic("passthrough")

        is_superset = (@, other: &Set[T]) -> Bool
            panic("passthrough")

        is_disjoint = (@, other: &Set[T]) -> Bool
            panic("passthrough")

        difference_update = (@mut, other: &Set[T]) -> Unit
            panic("passthrough")

        intersection_update = (@mut, other: &Set[T]) -> Unit
            panic("passthrough")

        symmetric_difference_update = (@mut, other: &Set[T]) -> Unit
            panic("passthrough")

        clone = (@) -> Set[T]
            panic("passthrough")

        to_string = (@) -> String
            panic("passthrough")
