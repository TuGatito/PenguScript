{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PenguScript",
  "scopeName": "source.pengu",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.pengu",
          "begin": "--\\[\\[",
          "end": "\\]\\]"
        },
        {
          "name": "comment.line.pengu",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pengu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pengu",
              "match": "\\\\."
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.pengu",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pengu",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.pengu",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.hex.pengu",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.integer.pengu",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.type.annotation.pengu",
          "match": "@@[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "variable.parameter.receiver.pengu",
          "match": "@(?:mut|own)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pengu",
          "match": "\\b(if|then|else|elseif|when|match|while|for|in|loop|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.pengu",
          "match": "\\b(scroll|summon|rune|enchanting|pact|ritual|grimoire|sigil|bind|morph|foreign|curse|textus|unveil|is|isnt|as|and|or|not|do)\\b"
        },
        {
          "name": "constant.language.pengu",
          "match": "\\b(true|false|none|some|ok|err|self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.pengu",
          "match": "\\b(Int|Float|Bool|Char|Str|String|Unit|Never|U8|U16|U32|U64|Usize|I8|I16|I32|I64|Isize|F32|F64|Vec|Map|Set|Option|Result|Box|Rc|Arc|CStr|CString|Ptr|Iter|Range|Ordering)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "entity.name.function.pengu",
          "match": "^\\s*([a-z_][a-zA-Z0-9_]*)\\s*=\\s*\\("
        },
        {
          "name": "entity.name.type.pengu",
          "match": "(?<=\\b(?:rune|enchanting|pact|scroll)\\s+)([A-Z][a-zA-Z0-9_]*)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pengu",
          "match": "\\.\\.=|\\.\\.|==|!=|<=|>=|->|=>|[+\\-*/%<>=]"
        }
      ]
    },
    "interpolation": {
      "begin": "#\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.begin.pengu"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.end.pengu"
        }
      },
      "contentName": "meta.embedded.expression.pengu",
      "patterns": [
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#operators"
        },
        {
          "name": "support.function.builtin.pengu",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.pengu",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.accessor.pengu",
          "match": "\\."
        }
      ]
    }
  }
}
