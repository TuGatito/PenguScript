{
  "name": "PenguScript",
  "scopeName": "source.pengu",
  "fileTypes": ["pengu"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.double-dash.pengu", "match": "--.*$" }]
    },
    "declarations": {
      "patterns": [
        { "name": "keyword.control.realm.pengu", "match": "\\b(realm|invoke|from|as)\\b" },
        { "name": "storage.type.rune.pengu", "match": "\\b(rune|omen|echo|seal|enchanting|heir|flags|extern)\\b" },
        { "name": "entity.name.type.pengu", "match": "(?<=\\b(rune|omen|echo|seal|enchanting)\\s+)[A-Z][A-Za-z0-9_]*" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.pengu", "match": "\\b(if|unless|else|then|switch|when|match|do|while|until|repeat|for|in|break|continue|return|pass)\\b" },
        { "name": "keyword.other.pengu", "match": "\\b(mut|const|static|unsafe|needs|operator|constructor|destructor|parent|true|false|none|nullptr|and|or|not)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.pengu", "match": "\\b(void|bool|char|short|int|long|float|double|string|size_t|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|unsigned|signed)\\b" },
        { "name": "support.type.container.pengu", "match": "\\b(vector|array|map|set|optional|unique|shared|weak|ref|raw|function|tuple|pair|span|deque|list)\\b" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pengu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.pengu", "match": "\\\\." },
            { "name": "meta.interpolation.pengu", "begin": "#\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        },
        { "name": "string.quoted.single.pengu", "match": "'(?:\\\\.|[^'\\\\])'" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.pengu", "match": "\\b0[xX][0-9a-fA-F_]+\\b|\\b0[bB][01_]+\\b|\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9]+)?\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.pengu", "match": "<=>|\\.\\.<|\\.\\.|->|::|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=|\\+|-|\\*|/|%|&|\\||\\^|~|!|<|>|\\?|#|@" }
      ]
    }
  }
}
