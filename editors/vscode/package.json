{
  "name": "pengu-lsp",
  "displayName": "PenguScript",
  "description": "PenguScript: LSP completo, snippets, resaltado y ejecución del programa.",
  "version": "0.1.0",
  "publisher": "penguscript",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:pengu"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pengu",
        "aliases": [
          "PenguScript",
          "pengu"
        ],
        "extensions": [
          ".pengu",
          ".d.pengu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pengu",
        "scopeName": "source.pengu",
        "path": "./syntaxes/pengu.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pengu",
        "path": "./snippets/pengu.json"
      }
    ],
    "commands": [
      {
        "command": "pengu.run",
        "title": "Ejecutar el programa",
        "category": "PenguScript",
        "icon": "$(play)"
      },
      {
        "command": "pengu.test",
        "title": "Ejecutar las pruebas",
        "category": "PenguScript",
        "icon": "$(beaker)"
      },
      {
        "command": "pengu.check",
        "title": "Comprobar sin compilar",
        "category": "PenguScript",
        "icon": "$(check)"
      },
      {
        "command": "pengu.restartServer",
        "title": "Reiniciar el servidor LSP",
        "category": "PenguScript",
        "icon": "$(refresh)"
      },
      {
        "command": "pengu.showOutput",
        "title": "Mostrar el registro del servidor",
        "category": "PenguScript"
      }
    ],
    "keybindings": [
      {
        "command": "pengu.run",
        "key": "f5",
        "when": "editorLangId == pengu"
      },
      {
        "command": "pengu.test",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == pengu"
      },
      {
        "command": "pengu.check",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorLangId == pengu"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pengu.run",
          "when": "editorLangId == pengu",
          "group": "navigation@1"
        },
        {
          "command": "pengu.test",
          "when": "editorLangId == pengu",
          "group": "navigation@2"
        },
        {
          "command": "pengu.check",
          "when": "editorLangId == pengu",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "PenguScript",
      "properties": {
        "pengu.serverPath": {
          "type": "string",
          "default": "pengu",
          "description": "Ruta al ejecutable `pengu` (se ejecuta como `pengu lsp`)."
        },
        "pengu.logFile": {
          "type": "string",
          "default": "",
          "description": "Archivo de registro del servidor (variable PENGU_LSP_LOG)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TuGatito/PenguScript-Rust.git"
  },
  "keywords": [
    "pengu",
    "penguscript",
    "lenguaje",
    "lsp"
  ]
}
