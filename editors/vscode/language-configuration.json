{
  "comments": {
    "lineComment": "--",
    "blockComment": ["--[[", "]]"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:rune|enchanting|pact|ritual|scroll|grimoire|curse)\\b.*$|^.*(?:->\\s*\\S+\\s*|\\bthen\\b.*|\\belse\\b.*|\\bdo\\b.*|\\bmatch\\b.*)$",
    "decreaseIndentPattern": "^\\s*(?:else\\b|elseif\\b|when\\b|--\\]\\])"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:rune|enchanting|pact|ritual|scroll|grimoire|curse)\\b.*$|^\\s*(?:if|elseif)\\b.*\\bthen\\s*$|^\\s*else\\s*$|^\\s*(?:while|for)\\b.*\\bdo\\s*$|^\\s*loop\\s*$|^\\s*match\\b.*$|^\\s*when\\b.*\\bthen\\s*$|.*->\\s*\\S+\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
