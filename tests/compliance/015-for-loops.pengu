# LANGUAGE.md §7.3 — `for`
# Pins: range loops (incl. negative step), for-in over list/string/map, comprehensions.
import std.spark

weave sum_list with xs as list of int into int:
    var total as int is 0
    for x in xs:
        set total is total + x
    return total

weave main into int:
    var total as int is 0
    for i from 0 to 10:
        set total is total + i
    calling spark.assert with (total == 45)

    var back as int is 0
    for j from 3 to 0 step -1:
        set back is back * 10 + j
    calling spark.assert with (back == 321)

    var nums as list of int is [1, 2, 3, 4, 5]
    calling spark.assert with ((calling sum_list with nums) == 15)

    var idx_sum as int is 0
    for i, v in nums:
        set idx_sum is idx_sum + i * v
    calling spark.assert with (idx_sum == 40)

    # inline comprehensions produce a fresh `list of T`
    var squares is for x in nums then x * x
    calling spark.assert with ((calling squares.len) == 5)
    calling spark.assert with ((squares at 4) == 25)
    var evens is for x in nums when x % 2 == 0 then x
    calling spark.assert with ((calling evens.len) == 2)

    var chars as int is 0
    for ch in "pengu":
        set chars is chars + 1
    calling spark.assert with (chars == 5)

    var m as map of string to int is map of string to int
    with m:
        calling .put with "a", 1
        calling .put with "b", 2
    var ksum as int is 0
    for k in m:
        set ksum is ksum + (m at k)
    calling spark.assert with (ksum == 3)
    return 0
