# LANGUAGE.md §5.4 — The `borrowed` modifier
# Pins: `var borrowed` / `let borrowed` locals are non-owning (never auto-banished).
import std.spark

weave first_word_len with text as string into int:
    let borrowed view is text
    var n as int is 0
    for ch in view:
        if ch == " ":
            break
        set n is n + 1
    return n

weave main into int:
    # An owned dynamic string (heap buffer, auto-banished at scope exit).
    var owned as string is "hello {1 + 1} world"
    # A borrowed alias of the same buffer: the compiler must not free it twice.
    var borrowed alias_view is owned
    calling spark.assert with (alias_view == owned)
    let borrowed typed_view is owned
    calling spark.assert with ((calling spark.len_string with typed_view) == 13)
    var borrowed counter as int is 5
    calling spark.assert with (counter == 5)

    calling spark.assert with ((calling first_word_len with "alpha beta") == 5)
    return 0
