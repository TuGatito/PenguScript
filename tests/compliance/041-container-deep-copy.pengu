# LANGUAGE.md §13.5 — Container ownership & deep copy
# Pins: owning containers deep-copy into their slots; the source keeps its own buffer.
import std.spark

rune Doc derive Par, Imago:
    title as string
    tags as list of string

weave main into int:
    # list of list of string: nested ownership
    var rows as list of list of string is list of list of string
    var row as list of string is ["a", "b"]
    calling rows.push with row
    set row at 0 is "z"
    calling spark.assert with (((rows at 0) at 0) == "a")
    calling spark.assert with (((rows at 0) at 1) == "b")
    calling spark.assert with ((row at 0) == "z")

    # list of string: push copies the element
    var words as list of string is list of string
    var w as string is "hello {1 + 1}"
    calling words.push with w
    set w is "changed"
    calling spark.assert with ((words at 0) == "hello 2")

    # a rune with `derive Imago` registers the clone callback used on push
    var docs as list of Doc is list of Doc
    var d as Doc is with title is "spec", tags is ["x", "y"]
    calling docs.push with d
    set d.title is "renamed"
    calling spark.assert with (((docs at 0).title) == "spec")
    calling spark.assert with ((((docs at 0).tags) at 0) == "x")
    return 0
