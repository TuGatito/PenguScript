# LANGUAGE.md §4.1 — Primitive types
# Pins: every accepted spelling maps to its documented canonical C width (`size of`).
import std.spark

weave main into int:
    var a as int is 1
    var b as i32 is 2
    var c as i64 is 3
    var d as u32 is 4
    var e as u64 is 5
    var f as byte is 6
    var g as usize is 7
    var h as isize is 8
    var i as float is 1.5
    var j as f64 is 2.5
    var k as char is 'A'
    var l as bool is true
    var m as string is "s"

    calling spark.assert with (a + b + c + d + e + f + g + h == 36)
    calling spark.assert with (i + j == 4.0)
    calling spark.assert with (k == 'A')
    calling spark.assert with (l is true)
    calling spark.assert with ((calling spark.len_string with m) == 1)

    calling spark.assert with ((size of int) == 4)
    calling spark.assert with ((size of i32) == 4)
    calling spark.assert with ((size of i64) == 8)
    calling spark.assert with ((size of u32) == 4)
    calling spark.assert with ((size of u64) == 8)
    calling spark.assert with ((size of byte) == 1)
    calling spark.assert with ((size of usize) == (size of isize))
    calling spark.assert with ((size of float) == 4)
    calling spark.assert with ((size of f64) == 8)
    calling spark.assert with ((size of char) == 1)
    calling spark.assert with ((size of bool) == 1)
    return 0
