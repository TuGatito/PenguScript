# LANGUAGE.md §8.5 — `ritual` methods (static)
# Pins: `ritual` associated functions called on the type, instance methods via `self`.
import std.spark

rune Vec2:
    x as int
    y as int

enchanting Vec2:
    weave ritual origin into Vec2:
        return with x is 0, y is 0

    weave ritual with_xy with x as int, y as int into Vec2:
        return with x is x, y is y

    weave length_sq into int:
        return self->x * self->x + self->y * self->y

    weave shift with dx as int, dy as int into void:
        set self->x is self->x + dx
        set self->y is self->y + dy

weave main into int:
    var o as Vec2 is calling Vec2.origin
    calling spark.assert with (o.x == 0 and o.y == 0)

    var v as Vec2 is calling Vec2.with_xy with 3, 4
    calling spark.assert with ((calling v.length_sq) == 25)
    calling v.shift with 1, -1
    calling spark.assert with (v.x == 4 and v.y == 3)

    var r as ref to Vec2 is sigil of v
    calling r->shift with -1, 1
    calling spark.assert with ((calling r->length_sq) == 25)
    return 0
