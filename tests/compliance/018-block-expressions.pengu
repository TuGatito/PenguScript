# LANGUAGE.md §7.6 — Block expressions: `do:`, value-position `if` / `unless`, and loops
# Pins: `do:` values, value-position if/unless, and collecting value-position loops.
import std.spark

weave main into int:
    let x is do:
        var a is 10
        set a is a + 5
        a * 2
    calling spark.assert with (x == 30)

    var score as int is 120
    let status is if score >= 100:
        let msg is "winner"
        msg
    else:
        let msg is "loser"
        msg
    calling spark.assert with (status == "winner")

    let gate is unless score < 100:
        "open"
    else:
        "closed"
    calling spark.assert with (gate == "open")

    # a value-position range loop collects each iteration value
    let squares as list of int is for i from 0 to 5:
        i * i
    calling spark.assert with ((calling squares.len) == 5)
    calling spark.assert with ((squares at 4) == 16)

    # ... and so does a value-position while loop
    var n as int is 0
    let tens as list of int is while n < 3:
        set n is n + 1
        n * 10
    calling spark.assert with ((calling tens.len) == 3)
    calling spark.assert with ((tens at 2) == 30)
    return 0
