# LANGUAGE.md §19 — Standard library
# Pins: pure std modules (spark, scrolls, arithmancy, oracle) called from one program.
import std.spark
import std.scrolls
import std.arithmancy
import std.oracle

weave main into int:
    calling spark.println with "stdlib corpus check"

    var trimmed as string is calling scrolls.trim with "  pengu  "
    calling spark.assert with (trimmed == "pengu")
    var titled as string is calling scrolls.capitalize with trimmed
    calling spark.assert with (titled == "Pengu")
    var parts as list of string is ["x", "y"]
    var joined as string is calling scrolls.join with parts, "+"
    calling spark.assert with (joined == "x+y")

    var root as float is calling arithmancy.sqrt with 16.0
    calling spark.assert with (root == 4.0)
    var big as int is calling arithmancy.max_i with 3, 9
    calling spark.assert with (big == 9)

    var some_v as maybe int is calling oracle.some_int with 5
    calling spark.assert with (some_v is present)
    var val as int is calling oracle.unwrap_int with some_v
    calling spark.assert with (val == 5)

    var parsed as maybe int is calling spark.parse_int with "42"
    calling spark.assert with (parsed is present)
    calling spark.assert with (parsed.value == 42)

    calling spark.assert with ((calling spark.len_string with spark.SPARK_VERSION) > 0)
    return 0
