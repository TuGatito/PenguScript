# LANGUAGE.md §8.3 — Function pointers & callbacks
# Pins: function decay to `ref to weave`, calls through a pointer, fn-type alias.
import std.spark

alias IntBinOp as weave with a as int, b as int into int

weave add with a as int, b as int into int:
    return a + b

weave mul with a as int, b as int into int:
    return a * b

weave apply with op as ref to weave with a as int, b as int into int, a as int, b as int into int:
    return calling op with a, b

weave apply_alias with op as IntBinOp, a as int, b as int into int:
    return calling op with a, b

weave pick with which as int into ref to weave with a as int, b as int into int:
    if which == 0:
        return add
    return mul

weave main into int:
    var op as ref to weave with a as int, b as int into int is add
    calling spark.assert with ((calling op with 2, 3) == 5)
    set op is mul
    calling spark.assert with ((calling op with 2, 3) == 6)

    calling spark.assert with ((calling apply with add, 20, 22) == 42)
    calling spark.assert with ((calling apply with mul, 6, 7) == 42)
    calling spark.assert with ((calling apply_alias with add, 1, 2) == 3)

    var chosen as ref to weave with a as int, b as int into int is calling pick with 1
    calling spark.assert with ((calling chosen with 4, 5) == 20)
    return 0
