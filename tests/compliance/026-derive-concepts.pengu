# LANGUAGE.md §9.1.2 — `derive` — automatic concept implementations
# Pins: `derive Par, Ordo, Vinculum` enabling ==, <, and use as a map key.
import std.spark

rune Pt derive Par, Ordo, Vinculum:
    x as int
    y as int

weave main into int:
    var a as Pt is with x is 1, y is 2
    var b as Pt is with x is 1, y is 2
    var c as Pt is with x is 3, y is 0
    calling spark.assert with (a == b)
    calling spark.assert with (a != c)
    calling spark.assert with (a < c)
    calling spark.assert with (c > a)

    var m as map of Pt to string is map of Pt to string
    with m:
        calling .put with a, "origin"
    calling spark.assert with (calling m.contains with b)
    calling spark.assert with ((m at b) == "origin")
    return 0
