# LANGUAGE.md §13.5 — Containers: `memcpy` on Store, Explicit Release
# Pins: 'push'/'put' copy the element *bytes* and never clone a heap payload, so
# a stored element and its source alias the same buffer — you pick one owner; and
# releasing a container releases only the container's own buffer, never its
# elements.
import std.spark

rune Doc derive Par, Nexus:
    title as string
    tags as list of string

weave main into int:
    # list of string: the pushed header is a byte copy of 'w's, so both names
    # point at one buffer. It is released exactly once, here through the element.
    var words as list of string is list of string
    var w as string is "hello {1 + 1}"
    calling words.push with w
    calling spark.assert with ((words at 0) == "hello 2")
    banish (words at 0)
    # The element's own header is cleared in place; 'w' must not be banished too,
    # because its buffer is the very one just released.
    calling spark.assert with ((words at 0).len == 0)
    banish words

    # A rune field is stored the same way: the list slot aliases the rune's
    # fields, it does not deep-copy them.
    var docs as list of Doc is list of Doc
    var d as Doc with:
        set .title is "spec"
        set .tags is ["x", "y"]
    calling docs.push with d
    calling spark.assert with (((docs at 0).title) == "spec")
    calling spark.assert with ((((docs at 0).tags) at 0) == "x")

    # 'banish docs' frees the list's own buffer only. 'banish d' then runs the
    # generated destructor ('derive Nexus'), which releases the rune's fields
    # exactly once: the container slot is never released as an element.
    banish docs
    banish d
    return 0
