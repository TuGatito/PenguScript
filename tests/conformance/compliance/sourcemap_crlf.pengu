## CRLF source: `line_text` drops the CR, offsets stay exact.
import std.spark
import std.sourcemap

weave main into int:
    var sm as SourceMap is calling SourceMap.from_source with "first\r\nsecond\r\n"
    defer banish sm
    var one as string is calling sm.line_text with 1
    defer banish one
    var two as string is calling sm.line_text with 2
    defer banish two
    calling spark.println with one
    calling spark.println with two
    calling spark.println with "lines={(calling sm.line_count)} bytes={(calling sm.source_len)}"
    calling spark.println with "off={(calling sm.offset_of with 2, 1)}"
    calling spark.println with "OK sourcemap_crlf"
    return 0
