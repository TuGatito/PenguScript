# LANGUAGE.md §9.1 — `rune` — structs
# Pins: rune fields, `with`/block construction, pointer-arrow access, destructuring.
import std.spark

rune Player:
    name as string
    hp as int
    is_alive as bool
    _secret_id as int

enchanting Player:
    weave describe into string:
        return "{self->name}: {self->hp}"

test "compliance/s024_rune_structs":
    var p as Player is with name is "Hero", hp is 100, is_alive is true, _secret_id is 42
    calling spark.assert with (p.name == "Hero")
    calling spark.assert with (p.hp == 100)
    calling spark.assert with (p.is_alive is true)

    var q as Player with:
        set .name is "Villain"
        set .hp is 50
        set .is_alive is false
    calling spark.assert with (q.hp == 50)
    calling spark.assert with (q.name == "Villain")

    var r as ref to Player is sigil of p
    set r->hp is 80
    calling spark.assert with (p.hp == 80)
    calling spark.assert with ((calling r->describe) == "Hero: 80")

    # destructuring unpacks every field in declaration order
    let n, h, alive, sid is p
    calling spark.assert with (n == "Hero")
    calling spark.assert with (h == 80)
    calling spark.assert with (alive is true)
    calling spark.assert with (sid == 42)
    calling spark.assert with ((size of Player) > 0)
