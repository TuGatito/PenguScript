# LANGUAGE.md §10.9 — Built-in concepts
# Pins: Num / Integrum / Par / Ordo bounds decide which operators generic code may use.
import std.spark

weave clamp shard T where T: Num and T: Ordo with lo as T, hi as T, v as T into T:
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

weave same shard T where T: Par with a as T, b as T into bool:
    return a == b

weave modulo shard T where T: Integrum with a as T, b as T into T:
    return a % b

weave all_at_least shard T where T: Ordo with lo as T, xs as list of T into bool:
    for x in xs:
        if x < lo:
            return false
    return true

test "compliance/s033_builtin_concepts":
    calling spark.assert with ((calling clamp with 0, 10, 15) == 10)
    calling spark.assert with ((calling clamp with 0, 10, -3) == 0)
    calling spark.assert with ((calling clamp with 0.0, 1.0, 0.5) == 0.5)

    calling spark.assert with (calling same with 3, 3)
    calling spark.assert with (not (calling same with 3, 4))
    calling spark.assert with (calling same with "a", "a")

    calling spark.assert with ((calling modulo with 17, 5) == 2)

    var xs as list of int is [1, 2, 3]
    calling spark.assert with (calling all_at_least with 0, xs)
    calling spark.assert with (not (calling all_at_least with 2, xs))
