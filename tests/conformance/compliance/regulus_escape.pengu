## escape quotes every metacharacter so a literal matches itself.
import std.spark
import std.scrolls
import std.builder
import std.ward
import std.regulus

weave main into int:
    var quoted as string is calling regulus.escape with "a.b*c"
    calling ward.assert_eq_int with (calling scrolls.compare with quoted, r"a\.b\*c"), 0
    banish quoted

    var plain as string is calling regulus.escape with "abc"
    calling ward.assert_eq_int with (calling scrolls.compare with plain, "abc"), 0
    banish plain

    var meta as string is calling regulus.escape with r".^$*+?()[]{}|\-"
    var cr as result of Regex to RegexError is calling Regex.compile with meta
    calling ward.assert_true with cr.is_ok
    var rx as Regex is cr.value
    defer banish cr
    calling ward.assert_true with (calling rx.is_match with r".^$*+?()[]{}|\-")
    calling ward.assert_false with (calling rx.is_match with "x")
    banish meta

    var built as string is calling regulus.escape with "user.name+tag"
    var sb as StringBuilder is calling StringBuilder.new
    calling sb.append with built
    calling sb.append with r"@example\.com"
    var pattern as string is calling sb.finish
    banish sb
    var mail as result of Regex to RegexError is calling Regex.compile with pattern
    calling ward.assert_true with mail.is_ok
    var mx as Regex is mail.value
    defer banish mail
    calling ward.assert_true with (calling mx.is_match with "user.name+tag@example.com")
    banish pattern
    banish built

    calling spark.println with "OK regulus_escape"
    return 0
