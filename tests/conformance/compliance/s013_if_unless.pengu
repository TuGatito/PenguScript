# LANGUAGE.md §7.1 — `if` / `unless` (statements) and `if`-expressions
# Pins: statement if/unless, the value-position `then/else`, safe `if v as T is m`.
import std.spark

weave describe with score as int into string:
    if score >= 100:
        return "winner"
    unless score >= 50:
        return "beginner"
    return "contender"

test "compliance/s013_if_unless":
    calling spark.assert with ((calling describe with 120) == "winner")
    calling spark.assert with ((calling describe with 60) == "contender")
    calling spark.assert with ((calling describe with 10) == "beginner")

    var muted as bool is false
    var played as bool is false
    unless muted:
        set played is true
    calling spark.assert with (played)

    var x as int is 42
    let label as string is if x > 10 then "big" else "small"
    calling spark.assert with (label == "big")
    if x == 42: calling spark.assert with true

    # `if v as T is m` binds the payload of a `maybe` without an explicit unwrap.
    var m as maybe int is some 7
    var got as int is 0
    if v as int is m:
        set got is v
    else:
        set got is -1
    calling spark.assert with (got == 7)

    var none_m as maybe int is maybe none
    let label2 is if v as int is none_m:
        "present"
    else:
        "absent"
    calling spark.assert with (label2 == "absent")
