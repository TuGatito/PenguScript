# LANGUAGE.md §9.1.1 — `cyclus` — self-referential types
# Pins: a `cyclus` recursive rune whose cycle is broken by pointer indirection.
import std.spark

rune Node cyclus:
    value as int
    next as maybe ref to Node

weave sum_chain with head as ref to Node into int:
    var total as int is 0
    var cur as ref to Node is head
    while cur != null:
        set total is total + cur->value
        if nxt as ref to Node is cur->next:
            set cur is nxt
        else:
            set cur is null
    return total

test "compliance/s025_cyclus_recursion":
    var a as Node is with value is 1, next is maybe none
    var b as Node is with value is 2, next is some (sigil of a)
    var c as Node is with value is 3, next is some (sigil of b)
    calling spark.assert with (c.value == 3)
    calling spark.assert with ((calling sum_chain with (sigil of c)) == 6)
