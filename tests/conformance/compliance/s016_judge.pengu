# LANGUAGE.md §7.4 — `judge` — pattern matching
# Pins: omen/int/bool subjects, payload extraction (`with f`), guards, `else ->`.
import std.spark

omen Shape derive Par:
    Point
    Circle with r as int
    Rect with w as int, h as int

omen Number:
    Val with n as int

weave area with s as Shape into int:
    return judge s:
        when Shape.Point -> 0
        when Shape.Circle with r -> r * r * 3
        when Shape.Rect with w, h -> w * h

weave sign with x as Number into string:
    return judge x:
        when Number.Val with n if n > 0 -> "positive"
        when Number.Val with n if n < 0 -> "negative"
        when Number.Val with n -> "zero"

weave name_of with n as int into string:
    return judge n:
        when 1 -> "one"
        when 2 -> "two"
        else -> "many"

test "compliance/s016_judge":
    var c as Shape is with Circle is with r is 2
    var r as Shape is with Rect is with w is 3, h is 4
    var p as Shape is Point
    calling spark.assert with ((calling area with c) == 12)
    calling spark.assert with ((calling area with r) == 12)
    calling spark.assert with ((calling area with p) == 0)

    var pos as Number is with Val is with n is 5
    var zero as Number is with Val is with n is 0
    var neg as Number is with Val is with n is -3
    calling spark.assert with ((calling sign with pos) == "positive")
    calling spark.assert with ((calling sign with zero) == "zero")
    calling spark.assert with ((calling sign with neg) == "negative")

    calling spark.assert with ((calling name_of with 1) == "one")
    calling spark.assert with ((calling name_of with 7) == "many")

    let bflag is judge true:
        when true -> "yes"
        when false -> "no"
    calling spark.assert with (bflag == "yes")
