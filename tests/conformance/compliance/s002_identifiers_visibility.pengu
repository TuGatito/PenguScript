# LANGUAGE.md §3.3 — Identifiers & visibility
# Pins: leading-underscore module-privacy, the `_` discard binding, reserved `main`.
import std.spark

weave _scale with x as int into int:
    return x * 3

test "compliance/s002_identifiers_visibility":
    # `_scale` is private to this module, but this module may still call it.
    calling spark.assert with ((calling _scale with 14) == 42)

    var total as int is 0
    var values as list of int is [5, 6, 7]
    for _, v in values:
        set total is total + v
    calling spark.assert with (total == 18)
