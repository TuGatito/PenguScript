# LANGUAGE.md §5.1 — Declarations
# Pins: explicit/inferred bindings, zero-init arrays, destructuring, const and static var.
import std.spark

const MAX_USERS as int is 1024
const SCALE is 1.5

rune Point:
    x as int
    y as int

weave bump into int:
    static var calls as int is 0
    set calls is calls + 1
    return calls

test "compliance/s005_declarations":
    # 1. explicitly typed variable / binding
    var count as int is 0
    let name as string is "Ada"
    # 2. inferred variable / binding
    var total is 100
    let greeting is "Hello"
    # 3. zero-initialized variable with an explicit type constructor
    var buffer as array of byte with size 8 is array of byte with size 8
    # 4/5/6. destructuring (structure type optional)
    var p as Point is with x is 3, y is 4
    let px, py is p
    let px2, py2 as Point is p
    # 7. top-level compile-time constants
    calling spark.assert with (MAX_USERS == 1024)
    calling spark.assert with (SCALE == 1.5)

    calling spark.assert with (count == 0)
    calling spark.assert with (name == "Ada")
    set total is total + 1
    calling spark.assert with (total == 101)
    calling spark.assert with (greeting == "Hello")
    calling spark.assert with ((buffer at 7) == (0 to byte))
    set buffer at 0 is (65 to byte)
    calling spark.assert with ((buffer at 0) == (65 to byte))
    calling spark.assert with (px == 3)
    calling spark.assert with (py == 4)
    calling spark.assert with (px2 + py2 == 7)

    # 8. function-static variable: state survives across calls
    calling spark.assert with ((calling bump) == 1)
    calling spark.assert with ((calling bump) == 2)
    calling spark.assert with ((calling bump) == 3)
