## Métodos genéricos de contenedores (map y list) desde código genérico.
import std.spark
import std.atlas

## Cuenta cuántas claves cumplen `pred`.
weave count_matching shard K and V with m as map of K, V, pred as weave with v as V into bool into int:
    var n as int is 0
    var ks as vector of K is calling m.keys
    for k in ks:
        if calling pred with (calling m.get_or with k, (calling m.get with k)):
            set n is n + 1
    return n

weave positive with v as int into bool:
    return v > 0

weave main into int:
    var m as map of string, int is map of string, int
    calling m.put with "a", 1
    calling m.put with "b", -2
    calling m.put with "c", 5
    calling spark.assert with (calling m.size) == 3
    calling spark.assert with (calling m.has_key with "b")
    calling spark.assert with (calling m.get_or with "z", 42) == 42
    calling spark.assert with (calling count_matching of string and int with m, positive) == 2
    calling spark.assert with (calling m.remove with "b")
    calling spark.assert with (calling m.size) == 2
    calling m.clear
    calling spark.assert with (calling m.size) == 0
    calling spark.println with "generics_containers OK"
    return 0
