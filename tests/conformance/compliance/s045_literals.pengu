# LANGUAGE.md §15.1 — Numbers, characters, booleans, null
# Pins: decimal/hex/binary/underscored integers, float forms, char escapes, typed null.
import std.spark

test "compliance/s045_literals":
    var dec as int is 42
    var neg as int is -7
    var hex as int is 0xFF
    var bin as int is 0b101
    var sep as int is 1_000
    var fl as float is 1.5
    var nfl as float is -0.25
    var sci as float is 2e3
    var esc as char is '\n'
    var hexc as char is '\x41'
    var t as bool is true
    var f as bool is false
    var p as ref to int is null

    calling spark.assert with (dec == 42)
    calling spark.assert with (neg == -7)
    calling spark.assert with (hex == 255)
    calling spark.assert with (bin == 5)
    calling spark.assert with (sep == 1000)
    calling spark.assert with (fl == 1.5)
    calling spark.assert with (nfl == -0.25)
    calling spark.assert with (sci == 2000.0)
    calling spark.assert with (esc == '\n')
    calling spark.assert with (hexc == 'A')
    calling spark.assert with (t is true)
    calling spark.assert with (f is false)
    calling spark.assert with (p == null)
