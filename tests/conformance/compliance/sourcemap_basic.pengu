## Map byte offsets to positions in a multi-line source.
import std.spark
import std.sourcemap

weave main into int:
    var source as string is "weave main into int:\n    return 0\n"
    var sm as SourceMap is calling SourceMap.from_source with source
    defer banish sm
    calling spark.println with "lines={(calling sm.line_count)}"
    var p as Position is calling sm.position_at with 20
    calling spark.println with "line={p.line} col={p.col}"
    var line as string is calling sm.line_text with 1
    defer banish line
    calling spark.println with line
    var span as SourceSpan is calling sm.line_span with 2
    calling spark.println with "span={span.start.col}..{span.end.col}"
    calling spark.println with "OK sourcemap_basic"
    return 0
