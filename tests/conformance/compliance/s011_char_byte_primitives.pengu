# LANGUAGE.md §6.5 — Character & byte primitives
# Pins: `ord`, `chr`, and `bytes of` over both string and `array of byte`.
import std.spark

test "compliance/s011_char_byte_primitives":
    calling spark.assert with ((ord "A") == 65)
    calling spark.assert with (chr 66 == "B")
    calling spark.assert with ((ord (chr 97)) == 97)

    # read-only byte view over a string's storage
    var s as string is "hello"
    var sb as ref to frozen byte is bytes of s
    calling spark.assert with (((sb at 0) to int) == 104)
    calling spark.assert with (((sb at 4) to int) == 111)

    # writable byte view over a fixed array
    var buf as array of byte with size 4 is [1, 2, 3, 4]
    var bp as ref to byte is bytes of buf
    set bp at 1 is (9 to byte)
    calling spark.assert with ((buf at 1) == (9 to byte))
    calling spark.assert with ((buf at 0) == (1 to byte))
