# LANGUAGE.md §9.3 — `omen` — enums, string-valued omens & algebraic sum types
# Pins: numeric enum, `with string:` omen, and a tagged algebraic omen with payloads.
import std.spark

omen Direction:
    North is 0
    South is 1
    East is 2
    West is 3

omen Color with string:
    Red
    Green
    Blue

omen Event:
    Disconnected
    Connecting with attempt as int
    Connected with session_id as string, latency_ms as float

weave label with d as Direction into string:
    return judge d:
        when Direction.North -> "N"
        when Direction.South -> "S"
        when Direction.East -> "E"
        when Direction.West -> "W"

weave describe with e as Event into string:
    return judge e:
        when Event.Disconnected -> "offline"
        when Event.Connecting with attempt -> "connecting {attempt}"
        when Event.Connected with session_id, latency_ms -> "online {session_id} {latency_ms}"

test "compliance/s028_omen":
    var d as Direction is Direction.East
    calling spark.assert with ((calling label with d) == "E")
    calling spark.assert with ((calling label with Direction.North) == "N")
    calling spark.assert with ((calling label with West) == "W")

    # string-valued variants evaluate to their own name
    calling spark.assert with (Color.Red == "Red")
    calling spark.assert with (Color.Blue == "Blue")

    var off as Event is Disconnected
    calling spark.assert with ((calling describe with off) == "offline")
    var conn as Event is with Connecting is with attempt is 3
    calling spark.assert with ((calling describe with conn) == "connecting 3")
    var on as Event is with Connected is with session_id is "abc", latency_ms is 1.5
    calling spark.assert with ((calling describe with on) == "online abc 1.5")
