# LANGUAGE.md §9.5 — `frozen` — read-only qualification
# Pins: `frozen T` values, `ref to frozen T` pointees, and mutable-to-frozen flow.
import std.spark

weave first_byte with s as ref to frozen byte into int:
    return ((s at 0) to int)

test "compliance/s030_frozen":
    var x as int is 5
    var y as frozen int is x
    calling spark.assert with (y == 5)
    set x is 6
    calling spark.assert with (y == 5)

    var p as ref to frozen int is sigil of y
    calling spark.assert with ((essence of p) == 5)

    var q as ref to int is sigil of x
    set essence of q is 7
    calling spark.assert with (x == 7)

    # a string's byte storage is viewed read-only
    var s as string is "A"
    calling spark.assert with ((calling first_byte with (bytes of s)) == 65)

    # `frozen ref to T` normalises to `ref to frozen T`
    var local as frozen ref to int is sigil of x
    calling spark.assert with ((essence of local) == 7)
