# LANGUAGE.md §6.2 — Arithmetic & bitwise
# Pins: operator precedence, integer bitwise ops, short-circuit and/or, compound `set`.
import std.spark

test "compliance/s008_arithmetic_bitwise":
    var a as int is 7
    var b as int is 3

    calling spark.assert with (((a + b) * 2 % 7) == 6)
    calling spark.assert with ((a - b * 2) == 1)
    calling spark.assert with ((a << 2) == 28)
    calling spark.assert with ((a >> 1) == 3)
    calling spark.assert with ((a & 0x0F) == 7)
    calling spark.assert with ((a | 8) == 15)
    calling spark.assert with ((a ^ 1) == 6)
    calling spark.assert with ((~a) == -8)

    var acc as int is 10
    set acc += 5
    set acc -= 3
    set acc *= 2
    set acc /= 4
    set acc %= 4
    calling spark.assert with (acc == 2)

    var mask as int is 0
    set mask |= 4
    set mask <<= 1
    set mask >>= 1
    set mask &= 0x0F
    calling spark.assert with (mask == 4)

    var t as bool is true
    var f as bool is false
    calling spark.assert with (t and not f)
    calling spark.assert with (f or t)
