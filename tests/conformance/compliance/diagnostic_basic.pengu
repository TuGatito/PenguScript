## Render a single error with context, note and help.
import std.spark
import std.diagnostic as diag

weave eq_b with got as bool, name as string into void:
    if not got:
        calling spark.println with "FAIL {name}"


weave has_text with s as string, needle as string into bool:
    var n as int is s length
    var m as int is needle length
    if m == 0:
        return true
    if m > n:
        return false
    var hb as ref to frozen byte is bytes of s
    var nb as ref to frozen byte is bytes of needle
    var i as int is 0
    while i + m <= n:
        var same as bool is true
        var k as int is 0
        while k < m and same:
            if ((hb at (i + k)) to int) != ((nb at k) to int):
                set same is false
            set k is k + 1
        if same:
            return true
        set i is i + 1
    return false

weave main into int:
    var bag as DiagnosticBag is calling DiagnosticBag.new
    defer banish bag
    calling bag.add_source with "src/main.pengu", "var x as int is \"hello\"\n"
    var span as Span is calling diag.span_from_positions with "src/main.pengu", 1, 18, 1, 25, 17, 24
    var lb as Label is calling diag.label with span, "expected 'int' here", true
    var d as Diagnostic is calling diag.diagnostic with diag.Severity.Error, "E0005", "expected 'int', found 'string'", (calling diag.labels with lb), (some "use '(s to int)'"), (some "'string' is not assignable to 'int'"), (calling diag.no_related)
    calling bag.add with d
    var text as string is calling bag.render_plain
    defer banish text
    calling eq_b with (calling has_text with text, "error[E0005]: expected 'int', found 'string'"), "header"
    calling eq_b with (calling has_text with text, "--> src/main.pengu:1:18"), "arrow"
    calling eq_b with (calling has_text with text, "^^^^"), "carets"
    calling eq_b with (calling has_text with text, "= note:"), "note"
    calling eq_b with (calling has_text with text, "= help:"), "help"
    calling eq_b with (calling bag.has_errors), "has_errors"
    calling eq_b with (bag.error_count == 1), "error count"
    calling spark.println with "OK diagnostic_basic"
    return 0
