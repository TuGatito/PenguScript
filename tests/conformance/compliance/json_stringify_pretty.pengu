## Pretty output: indentation, sorted keys and ensure_ascii.
import std.spark
import std.json

weave eq_b with got as bool, name as string into void:
    if not got:
        calling spark.println with "FAIL {name}"


weave has_text with s as string, needle as string into bool:
    var n as int is s length
    var m as int is needle length
    if m == 0:
        return true
    if m > n:
        return false
    var hb as ref to frozen byte is bytes of s
    var nb as ref to frozen byte is bytes of needle
    var i as int is 0
    while i + m <= n:
        var same as bool is true
        var k as int is 0
        while k < m and same:
            if ((hb at (i + k)) to int) != ((nb at k) to int):
                set same is false
            set k is k + 1
        if same:
            return true
        set i is i + 1
    return false

weave main into int:
    var r as result of JsonValue to json.JsonError is calling json.parse with r"""{"b":2,"a":[1,2]}"""
    if not r.is_ok:
        calling spark.println with "FAIL parse"
        banish r
        return 1
    var root as JsonValue is r.value
    var pretty as string is calling json.stringify_pretty with root, 2
    calling eq_b with (calling has_text with pretty, "\n  \"b\": 2"), "indent key"
    calling eq_b with (calling has_text with pretty, "\n    1,"), "indent nested"
    banish pretty
    var opt as json.SerializeOptions is calling json.default_serialize_options
    set opt.sort_keys is true
    var sorted as string is calling json.stringify_with with root, opt
    var a_pos as int is calling a_index with sorted
    var b_pos as int is calling b_index with sorted
    calling eq_b with (a_pos < b_pos), "sorted keys"
    banish sorted
    var s as JsonValue is calling JsonValue.string_val with "ñ😀"
    set opt.sort_keys is false
    set opt.ensure_ascii is true
    var ascii as string is calling json.stringify_with with s, opt
    calling eq_b with (calling has_text with ascii, "\\u00f1"), "ascii n"
    calling eq_b with (calling has_text with ascii, "\\ud83d\\ude00"), "surrogate pair"
    banish ascii
    banish s
    banish r
    calling spark.println with "OK json_stringify_pretty"
    return 0

weave a_index with s as string into int:
    return calling find_char with s, 'a'

weave b_index with s as string into int:
    return calling find_char with s, 'b'

weave find_char with s as string, c as char into int:
    var raw as ref to frozen byte is bytes of s
    var target as int is ord c
    var i as int is 0
    while i < (s length):
        if ((raw at i) to int) == target:
            return i
        set i is i + 1
    return -1
