# LANGUAGE.md §15.2 — Strings
# Pins: `{expr}` interpolation, raw and triple-quoted literals, explicit conversions.
import std.spark

test "compliance/s046_strings":
    var x as int is 7
    var name as string is "Pengu"
    let plain as string is "plain"
    let interp as string is "value: {x} and {name}"
    calling spark.assert with (plain == "plain")
    calling spark.assert with (interp == "value: 7 and Pengu")

    # raw strings treat backslashes literally (no escapes, no interpolation)
    let raw as string is r"raw \n no escapes"
    calling spark.assert with ((calling spark.len_string with raw) == 17)

    # triple-quoted strings are dedented and may span lines
    let triple as string is """triple
        quoted
        string"""
    calling spark.assert with ((calling spark.len_string with triple) > 0)

    # explicit conversions use `to string`
    var f as float is 0.5
    calling spark.assert with ((f to string) == "0.5")
    calling spark.assert with ((42 to string) == "42")
    calling spark.assert with ((true to string) == "true")

    # composition is byte-exact: an embedded NUL survives interpolation
    # (NOTE: a NUL cannot be written as a bare literal escape -- a literal is
    # materialised from a C string and stops at the NUL -- so it is built with chr.)
    var nul as string is "{chr 0}"
    calling spark.assert with ((calling spark.len_string with nul) == 1)
    var wrapped as string is "[{nul}]"
    calling spark.assert with ((calling spark.len_string with wrapped) == 3)
