## Labels in two files produce two `-->` blocks.
import std.spark
import std.diagnostic as diag

weave eq_b with got as bool, name as string into void:
    if not got:
        calling spark.println with "FAIL {name}"


weave has_text with s as string, needle as string into bool:
    var n as int is s length
    var m as int is needle length
    if m == 0:
        return true
    if m > n:
        return false
    var hb as ref to frozen byte is bytes of s
    var nb as ref to frozen byte is bytes of needle
    var i as int is 0
    while i + m <= n:
        var same as bool is true
        var k as int is 0
        while k < m and same:
            if ((hb at (i + k)) to int) != ((nb at k) to int):
                set same is false
            set k is k + 1
        if same:
            return true
        set i is i + 1
    return false

weave main into int:
    var bag as DiagnosticBag is calling DiagnosticBag.new
    defer banish bag
    calling bag.add_source with "a.pengu", "alpha\n"
    calling bag.add_source with "b.pengu", "beta\n"
    var s1 as Span is calling diag.span_from_positions with "a.pengu", 1, 1, 1, 6, 0, 5
    var s2 as Span is calling diag.span_from_positions with "b.pengu", 1, 1, 1, 5, 0, 4
    var ls as list of Label is list of Label
    calling ls.push with (calling diag.label with s1, "alpha", true)
    calling ls.push with (calling diag.label with s2, "beta", false)
    calling bag.add with (calling diag.diagnostic with diag.Severity.Info, "I1", "two files", ls, (maybe none), (maybe none), (calling diag.no_related))
    var text as string is calling bag.render_plain
    defer banish text
    calling eq_b with (calling has_text with text, "--> a.pengu:1:1"), "first file"
    calling eq_b with (calling has_text with text, "--> b.pengu:1:1"), "second file"
    calling spark.println with "OK diagnostic_multi_file"
    return 0
