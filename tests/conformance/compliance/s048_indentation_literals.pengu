# LANGUAGE.md §15.4 — Indentation literals
# Pins: block-indented array, map and struct literals.
import std.spark

rune Player:
    name as string
    hp as int

test "compliance/s048_indentation_literals":
    var grid as array of array of int with size 2 with size 3 is:
        1, 2, 3
        4, 5, 6
    calling spark.assert with (((grid at 1) at 0) == 4)
    calling spark.assert with (((grid at 0) at 2) == 3)

    var lookup as map of string to int is:
        "one": 1
        "two": 2
    calling spark.assert with ((lookup at "two") == 2)
    calling spark.assert with ((calling lookup.len) == 2)

    var p as Player is:
        name is "Ada"
        hp is 100
    calling spark.assert with (p.name == "Ada")
    calling spark.assert with (p.hp == 100)
