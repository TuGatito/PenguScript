import std.compass
import std.spark
import std.scrolls

test "std_programs/test_compass_extended":
    calling spark.println with "=== Test Compass Extended ==="

    # --- Version ---
    calling spark.assert with compass.COMPASS_VERSION == "1.1.0"
    calling spark.println with "version: OK"

    # --- Core & Alias Functions ---
    calling spark.assert with (calling compass.basename with "foo/bar/baz.txt") == "baz.txt"
    calling spark.assert with (calling compass.filename with "foo/bar/baz.txt") == "baz.txt"
    calling spark.assert with (calling compass.dirname with "foo/bar/baz.txt") == "foo/bar"
    calling spark.assert with (calling compass.stem with "foo/bar/baz.txt") == "baz"
    calling spark.assert with (calling compass.file_stem with "foo/bar/baz.txt") == "baz"
    calling spark.assert with (calling compass.ext with "foo/bar/baz.txt") == ".txt"
    calling spark.println with "aliases and basenames: OK"

    # --- Extension manipulations ---
    calling spark.assert with (calling compass.with_extension with "document.txt", "pdf") == "document.pdf"
    calling spark.assert with (calling compass.with_extension with "document.txt", ".pdf") == "document.pdf"
    calling spark.assert with (calling compass.without_extension with "document.txt") == "document"
    calling spark.assert with (calling compass.without_extension with "archive.tar.gz") == "archive.tar"
    calling spark.assert with (calling compass.add_ext with "readme", "md") == "readme.md"
    calling spark.assert with (calling compass.add_ext with "readme.txt", "md") == "readme.txt"
    var sx as list of string is calling compass.suffixes with "archive.tar.gz"
    calling spark.assert with sx.len == 2
    calling spark.assert with (sx at 0) == "tar"
    calling spark.assert with (sx at 1) == "gz"
    var sx_dot as list of string is calling compass.suffixes with "file."
    calling spark.assert with sx_dot.len == 0
    calling spark.println with "extension manipulations: OK"

    # --- Filename replacement ---
    var with_fn as string is calling compass.with_filename with "project/src/main.c", "app.c"
    calling spark.assert with (calling compass.basename with with_fn) == "app.c"
    calling spark.println with "filename replacement: OK"

    # --- Hidden files ---
    calling spark.assert with calling compass.is_hidden with ".git"
    calling spark.assert with calling compass.is_hidden with ".gitignore"
    calling spark.assert with calling compass.is_hidden with "path/to/.env"
    calling spark.assert with (calling compass.is_hidden with "regular.txt") == false
    calling spark.assert with (calling compass.is_hidden with ".") == false
    calling spark.assert with (calling compass.is_hidden with "..") == false
    calling spark.println with "hidden files: OK"

    # --- UNC paths ---
    calling spark.assert with calling compass.is_unc with "\\\\server\\share\\data"
    calling spark.assert with calling compass.is_unc with "//server/share/data"
    calling spark.assert with (calling compass.is_unc with "/home/user/doc") == false
    calling spark.assert with (calling compass.is_unc with "relative/path") == false
    calling spark.println with "unc paths: OK"

    # --- Wildcards and Pattern Matching ---
    calling spark.assert with calling compass.has_wildcard with "*.txt"
    calling spark.assert with calling compass.has_wildcard with "data_??.csv"
    calling spark.assert with (calling compass.has_wildcard with "report_2026.pdf") == false

    calling spark.assert with calling compass.matches with "main.pengu", "*.pengu"
    calling spark.assert with (calling compass.matches with "main.c", "*.pengu") == false
    calling spark.assert with calling compass.matches with "test_01.py", "test_??.py"
    calling spark.assert with (calling compass.matches with "test_100.py", "test_??.py") == false
    calling spark.assert with (calling compass.matches with "image.png", "img*") == false
    calling spark.assert with calling compass.matches with "img_avatar.png", "img*"
    calling spark.println with "wildcards and glob: OK"

    # --- Components ---
    var comps as list of string is calling compass.components with "alpha/beta/gamma"
    calling spark.assert with comps.len == 3
    calling spark.assert with (comps at 0) == "alpha"
    calling spark.assert with (comps at 1) == "beta"
    calling spark.assert with (comps at 2) == "gamma"
    calling spark.assert with calling compass.has_component with "alpha/beta/gamma", "beta"
    calling spark.assert with (calling compass.has_component with "alpha/beta/gamma", "delta") == false
    calling spark.println with "components: OK"

    # --- CWD and Absolute Paths ---
    var cur_dir as string is calling compass.cwd
    calling spark.assert with cur_dir length > 0
    calling spark.assert with calling compass.is_absolute with cur_dir
    var abs_p as string is calling compass.absolute with "local_file.txt"
    calling spark.assert with calling compass.is_absolute with abs_p
    var exp_p as string is calling compass.expand_user with "~/workspace"
    calling spark.assert with exp_p length > 0
    calling spark.println with "cwd and absolute: OK"

    # --- Path Rune & Methods ---
    var p as compass.Path is calling compass.new_path with "src/modules/core.pengu"
    calling spark.assert with (calling p.name) == "core.pengu"
    calling spark.assert with (calling p.stem) == "core"
    calling spark.assert with (calling p.suffix) == ".pengu"
    calling spark.assert with calling p.is_relative
    calling spark.assert with (calling p.is_hidden) == false
    calling spark.assert with (calling p.matches with "*.pengu")

    var p_swapped as compass.Path is calling p.with_suffix with ".c"
    calling spark.assert with (calling p_swapped.suffix) == ".c"
    calling spark.assert with (calling p_swapped.name) == "core.c"

    var p_no_ext as compass.Path is calling p.without_suffix
    calling spark.assert with (calling p_no_ext.suffix) == ""
    calling spark.assert with (calling p_no_ext.name) == "core"

    var p_renamed as compass.Path is calling p.with_name with "entry.pengu"
    calling spark.assert with (calling p_renamed.name) == "entry.pengu"

    var uri as string is calling p.to_uri
    calling spark.assert with (calling uri.starts_with with "file://")

    var p_sp as compass.Path is calling compass.new_path with "my docs/test.txt"
    var uri_sp as string is calling p_sp.to_uri
    calling spark.assert with (calling uri_sp.contains with "%20")

    var abs_path as compass.Path is calling p.to_absolute
    calling spark.assert with calling abs_path.is_absolute
    calling spark.println with "path rune methods: OK"

    # --- Filesystem Path Methods (CWD) ---
    var cwd_path as compass.Path is calling compass.current_dir
    calling spark.assert with calling cwd_path.is_absolute
    calling spark.assert with calling cwd_path.exists
    calling spark.assert with calling cwd_path.is_dir
    calling spark.assert with (calling cwd_path.is_file) == false
    calling spark.println with "path filesystem methods: OK"

    calling spark.println with "compass extended: OK"
