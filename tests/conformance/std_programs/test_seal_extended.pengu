import std.spark
import std.seal

test "std_programs/test_seal_extended":
    calling spark.println with "=== Test Seal Extended ==="

    # 1. Version & constants
    calling spark.assert with (seal.SEAL_VERSION == "1.1.0")
    calling spark.assert with (seal.CRC32_POLYNOMIAL == 3988292384)
    calling spark.println with "constants: OK"

    # 2. Hash metadata & validation
    calling spark.assert with (calling seal.is_valid_hash_alg with "sha256")
    calling spark.assert with (calling seal.is_valid_hash_alg with "sha512")
    calling spark.assert with (calling seal.is_valid_hash_alg with "sha1")
    calling spark.assert with (calling seal.is_valid_hash_alg with "md5")
    calling spark.assert with (not (calling seal.is_valid_hash_alg with "unknown_alg"))

    calling spark.assert with ((calling seal.hash_length with "sha256") == 64)
    calling spark.assert with ((calling seal.hash_length with "sha512") == 128)
    calling spark.assert with ((calling seal.hash_length with "sha1") == 40)
    calling spark.assert with ((calling seal.hash_length with "md5") == 32)
    calling spark.println with "hash metadata: OK"

    # 3. Digest computation & verification
    var input as string is "hello world"
    var h256 as string is calling seal.sha256 with input
    calling spark.assert with (h256.len == 64)
    calling spark.assert with (calling seal.verify_sha256 with input, h256)
    calling spark.assert with (not (calling seal.verify_sha256 with "wrong input", h256))

    var h512 as string is calling seal.sha512 with input
    calling spark.assert with (h512.len == 128)
    calling spark.assert with (calling seal.verify_sha512 with input, h512)

    var h1 as string is calling seal.sha1 with input
    calling spark.assert with (h1.len == 40)
    calling spark.assert with (calling seal.verify_sha1 with input, h1)

    var hmd5 as string is calling seal.md5 with input
    calling spark.assert with (hmd5.len == 32)
    calling spark.assert with (calling seal.verify_md5 with input, hmd5)

    var c32 as int is calling seal.crc32 with input
    calling spark.assert with (c32 != 0)
    calling spark.println with "digests: OK"

    # 4. Constant-time equality
    calling spark.assert with (calling seal.const_time_eq with "secret_token_123", "secret_token_123")
    calling spark.assert with (not (calling seal.const_time_eq with "secret_token_123", "secret_token_456"))
    calling spark.assert with (not (calling seal.const_time_eq with "secret", "secret_longer"))
    calling spark.println with "const time eq: OK"

    # 5. RFC 2104 HMAC implementations
    var key as string is "key"
    var msg as string is "The quick brown fox jumps over the lazy dog"
    var exp_hmac as string is "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"

    var mac256 as string is calling seal.hmac_sha256 with key, msg
    calling spark.assert with (mac256 == exp_hmac)
    calling spark.assert with (calling seal.verify_hmac_sha256 with key, msg, exp_hmac)
    calling spark.assert with (not (calling seal.verify_hmac_sha256 with "wrong_key", msg, exp_hmac))

    var mac1 as string is calling seal.hmac_sha1 with key, "test message"
    calling spark.assert with (mac1.len == 40)

    var mac_md5 as string is calling seal.hmac_md5 with key, "test message"
    calling spark.assert with (mac_md5.len == 32)
    calling spark.println with "hmac: OK"

    # 6. In-memory gzip & zlib compression round-trip
    var orig as string is "PenguScript high-performance compression test payload 12345"
    var gz_opt as maybe string is calling seal.gzip with orig
    calling spark.assert with (gz_opt.is_present)
    if gz_opt.is_present:
        var gz_decomp as maybe string is calling seal.unzip with gz_opt.value
        calling spark.assert with (gz_decomp.is_present)
        if gz_decomp.is_present:
            calling spark.assert with (gz_decomp.value == orig)

    var zl_opt as maybe string is calling seal.zlib_compress with orig
    calling spark.assert with (zl_opt.is_present)
    if zl_opt.is_present:
        var zl_decomp as maybe string is calling seal.zlib_decompress with zl_opt.value
        calling spark.assert with (zl_decomp.is_present)
        if zl_decomp.is_present:
            calling spark.assert with (zl_decomp.value == orig)
    calling spark.println with "compression: OK"

    # 7. Enchanting string methods
    var sample as string is "pengu hash sample"
    var sample_sha as string is calling sample.to_sha256
    var expected_sha as string is calling seal.sha256 with sample
    calling spark.assert with (sample_sha == expected_sha)

    var sample_md5 as string is calling sample.to_md5
    var expected_md5 as string is calling seal.md5 with sample
    calling spark.assert with (sample_md5 == expected_md5)

    var sample_c32 as int is calling sample.to_crc32
    var expected_c32 as int is calling seal.crc32 with sample
    calling spark.assert with (sample_c32 == expected_c32)

    var gz_s as maybe string is calling sample.to_gzip
    calling spark.assert with (gz_s.is_present)
    if gz_s.is_present:
        var gz_val as string is gz_s.value
        var back_gz as maybe string is calling gz_val.from_gzip
        calling spark.assert with (back_gz.is_present)
        if back_gz.is_present:
            calling spark.assert with (back_gz.value == sample)
    calling spark.println with "string enchantments: OK"

    calling spark.println with "seal extended: OK"
