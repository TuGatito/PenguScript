import std.chronicle
import std.compass
import std.archivum
import std.scrolls
import std.spark

test "std_programs/backward_compat_system":
    calling spark.println with "=== Testing System Tier Backward Compatibility ==="

    # --- 1. Chronicle 0.14.x legacy API ---
    var now as float is calling chronicle.time
    calling spark.assert with now > 0.0
    var mono as float is calling chronicle.monotonic
    calling spark.assert with mono >= 0.0
    calling chronicle.sleep_ms with 5
    calling chronicle.sleep with 0.005

    var yr as int is calling chronicle.utc_year with now
    calling spark.assert with yr >= 2026
    var mo as int is calling chronicle.utc_month with now
    calling spark.assert with mo >= 1
    calling spark.assert with mo <= 12
    var da as int is calling chronicle.utc_day with now
    calling spark.assert with da >= 1
    calling spark.assert with da <= 31
    var hr as int is calling chronicle.utc_hour with now
    calling spark.assert with hr >= 0
    calling spark.assert with hr <= 23
    var mn as int is calling chronicle.utc_minute with now
    calling spark.assert with mn >= 0
    calling spark.assert with mn <= 59
    var sc as int is calling chronicle.utc_second with now
    calling spark.assert with sc >= 0
    calling spark.assert with sc <= 60

    var lyr as int is calling chronicle.local_year with now
    calling spark.assert with lyr >= 2026
    var lmo as int is calling chronicle.local_month with now
    calling spark.assert with lmo >= 1

    var fmt_str as string is calling chronicle.format with "%Y", now
    calling spark.assert with fmt_str == (yr to string)
    var fmt_now_str as string is calling chronicle.format_now with "%Y"
    calling spark.assert with fmt_now_str length == 4

    var parsed as maybe float is calling chronicle.parse with "2026-09-25", "%Y-%m-%d"
    calling spark.assert with parsed.is_present
    calling spark.println with "chronicle 0.14.x backward compat: OK"

    # --- 2. Compass 0.14.x legacy API ---
    var p_list as list of string is list of string
    calling p_list.push with "a"
    calling p_list.push with "b"
    calling p_list.push with "file.txt"
    var joined as string is calling compass.join with p_list
    var joined_all as string is calling compass.join_all with p_list
    calling spark.assert with joined == joined_all

    calling spark.assert with (calling compass.basename with joined) == "file.txt"
    calling spark.assert with (calling compass.dirname with "dir/sub/file.txt") == "dir/sub"
    calling spark.assert with (calling compass.ext with "dir/sub/file.txt") == ".txt"
    calling spark.assert with (calling compass.stem with "dir/sub/file.txt") == "file"
    calling spark.assert with (calling compass.is_relative with "dir/sub/file.txt")
    calling spark.assert with (calling compass.has_ext with "file.txt")
    calling spark.assert with (calling compass.has_ext with "file") == false

    var sep as string is calling compass.separator
    calling spark.assert with sep length == 1
    var alt_sep as maybe string is calling compass.alt_separator
    var is_win as bool is calling compass.is_windows
    var is_unx as bool is calling compass.is_unix
    calling spark.assert with (is_win != is_unx)

    var p_obj as compass.Path is calling compass.path with "src/main.pengu"
    calling spark.assert with (calling p_obj.to_string) == "src/main.pengu"
    calling spark.assert with (calling p_obj.name) == "main.pengu"
    calling spark.assert with (calling p_obj.stem) == "main"
    calling spark.assert with (calling p_obj.suffix) == ".pengu"
    calling spark.assert with (calling p_obj.is_relative)
    calling spark.assert with (calling p_obj.is_empty) == false
    var p_obj_joined as compass.Path is calling compass.path_join with p_list
    calling spark.assert with (calling p_obj_joined.name) == "file.txt"
    calling spark.println with "compass 0.14.x backward compat: OK"

    # --- 3. Archivum 0.14.x legacy API ---
    var test_f as string is "compat_test_legacy.txt"
    calling spark.assert with calling archivum.write_file with test_f, "legacy archivum line 1\nline 2"
    calling spark.assert with calling archivum.exists with test_f
    calling spark.assert with calling archivum.is_file with test_f
    calling spark.assert with (calling archivum.is_dir with test_f) == false
    calling spark.assert with (calling archivum.is_symlink with test_f) == false

    var read_res as maybe string is calling archivum.read_file with test_f
    calling spark.assert with read_res.is_present
    var r_txt as string is read_res.value
    calling spark.assert with (calling r_txt.starts_with with "legacy archivum")

    calling spark.assert with calling archivum.append_file with test_f, "\nline 3"
    var lines as maybe list of string is calling archivum.read_lines with test_f
    calling spark.assert with lines.is_present
    var l_val as list of string is lines.value
    calling spark.assert with l_val.len >= 3

    var meta as maybe map of string to string is calling archivum.metadata with test_f
    calling spark.assert with meta.is_present

    var copy_f as string is "compat_test_copy.txt"
    calling spark.assert with calling archivum.copy_file with test_f, copy_f, true
    calling spark.assert with calling archivum.exists with copy_f
    calling spark.assert with calling archivum.delete_file with copy_f

    var touched as bool is calling archivum.touch with test_f
    calling spark.assert with touched

    var del_ok as bool is calling archivum.delete_file with test_f
    calling spark.assert with del_ok
    calling spark.assert with (calling archivum.exists with test_f) == false
    calling spark.println with "archivum 0.14.x backward compat: OK"

    calling spark.println with "system backward compat: OK"
