# Clonar un rune Nexus con `_pengu_clone_T` deja búferes propios: ninguno de los
# dos destructores libera memoria ajena.
import std.filum

rune Blob derive Nexus:
    name as string
    values as list of int

antiquus clone_blob with b as Blob into Blob:
    r"""
Blob out;
memset(&out, 0, sizeof out);
_pengu_clone_Blob(&out, &b);
return out;
"""

weave by_clone into int:
    var a as Blob is with name is (calling filum.pengu_string_copy with "hola"), values is [1, 2, 3]
    var b as Blob is calling clone_blob with a
    banish b
    banish a
    return 0

weave main into int:
    var r as int is calling by_clone
    return r
