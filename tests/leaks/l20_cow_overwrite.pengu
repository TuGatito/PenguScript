# Reasignar valores owned (bug D) no debe filtrar el buffer anterior:
# `set x is y` libera el valor viejo tras asignar el nuevo.
# ASan/LSan.

weave by_string into int:
    var s as string is "hola" + " mundo"
    set s is "adios" + "!"
    banish s
    return 0

weave by_list into int:
    var l as list of int is [1, 2, 3]
    set l is [4, 5]
    banish l
    return 0

weave by_map into int:
    var m as map of string to int is map of string to int
    calling m.put with "a", 1
    set m is map of string to int
    banish m
    return 0

# `maybe`/`result` no se intercambian todavia: sus cajas se liberan con el
# modelo de propiedad de P7 (hoy `set v is some x` filtra la caja anterior).

weave main into int:
    if (calling by_string) != 0:
        return 1
    if (calling by_list) != 0:
        return 2
    if (calling by_map) != 0:
        return 3
    return 0
