## Compiles every web module against the current API.
##
## This test is built but not executed: it exists to catch signature drift in
## `std.web.*` on the wasm target.

import std.spark
import std.web.dom as dom
import std.web.canvas as canvas
import std.web.storage as storage
import std.web.websocket as ws
import std.web.http as http
import std.web.js as js

weave on_text with text as string into void:
    return

weave on_value with value as js.JsValue into void:
    return

weave drop_js_error with e as js.JsError into void:
    banish e.name
    banish e.message
    banish e.stack

weave main into int:
    var d as result of dom.Element to js.JsError is calling dom.document
    if d.is_ok:
        calling dom.free with (sigil of d.value)
    else:
        calling drop_js_error with d.error

    var q as result of maybe dom.Element to js.JsError is calling dom.query with "#app"
    if q.is_ok:
        if q.value is present:
            calling dom.set_text with q.value.value, "hello"
            calling dom.free with (sigil of q.value.value)
        banish q.value
    else:
        calling drop_js_error with q.error

    var c as result of canvas.Canvas to js.JsError is calling canvas.context2d with "#canvas"
    if c.is_ok:
        calling canvas.fill_rect with c.value, 0.0, 0.0, 10.0, 10.0
        calling canvas.free with (sigil of c.value)
    else:
        calling drop_js_error with c.error

    var s as result of maybe string to js.JsError is calling storage.local_get with "key"
    if s.is_ok:
        if s.value is present:
            banish s.value.value
        banish s.value
    else:
        calling drop_js_error with s.error

    var w as result of ws.Socket to js.JsError is calling ws.open with "ws://127.0.0.1:1", on_text, on_text, on_text, on_text
    if w.is_ok:
        calling ws.close with (sigil of w.value)
    else:
        calling drop_js_error with w.error

    var p as result of js.JsValue to js.JsError is calling js.eval with "Promise.resolve(1)"
    if p.is_ok:
        var pt as result of bool to js.JsError is calling js.promise_then with p.value, on_value, on_value
        if not pt.is_ok:
            calling drop_js_error with pt.error
        calling js.release with p.value
    else:
        calling drop_js_error with p.error

    var f as result of bool to js.JsError is calling http.get with "data:text/plain,ok", on_value, on_value
    if not f.is_ok:
        calling drop_js_error with f.error

    calling spark.println with "web modules compiled"
    return 0
