import std.rites
import std.spark

weave main into int:
    calling spark.println with "=== Test Rites Extended ==="

    # 1. Version
    calling spark.assert with rites.RITES_VERSION == "1.1.0"
    calling spark.println with "version: OK"

    # 2. Environment Accessors
    var ok_set as bool is calling rites.setenv with "PENGU_TEST_RITES" , "123" , true
    calling spark.assert with ok_set
    calling spark.assert with (calling rites.has_env with "PENGU_TEST_RITES")
    calling spark.assert with ((calling rites.has_env with "PENGU_DEFINITELY_NOT_EXISTING_XYZ") == false)

    var v_or as string is calling rites.getenv_or with "PENGU_TEST_RITES" , "fallback"
    calling spark.assert with v_or == "123"

    var fb as string is calling rites.getenv_or with "PENGU_DEFINITELY_NOT_EXISTING_XYZ" , "fallback"
    calling spark.assert with fb == "fallback"

    var int_opt as maybe int is calling rites.getenv_int with "PENGU_TEST_RITES"
    calling spark.assert with (int_opt is present)
    if int_opt is present:
        calling spark.assert with int_opt.value == 123

    var bad_int as maybe int is calling rites.getenv_int with "PENGU_DEFINITELY_NOT_EXISTING_XYZ"
    calling spark.assert with (bad_int is not present)

    calling rites.setenv with "PENGU_TEST_FLOAT" , "3.14" , true
    var flt_opt as maybe float is calling rites.getenv_float with "PENGU_TEST_FLOAT"
    calling spark.assert with (flt_opt is present)

    calling rites.setenv with "PENGU_TEST_BOOL" , "true" , true
    var b_opt1 as maybe bool is calling rites.getenv_bool with "PENGU_TEST_BOOL"
    calling spark.assert with (b_opt1 is present)
    if b_opt1 is present:
        calling spark.assert with b_opt1.value == true

    calling rites.setenv with "PENGU_TEST_BOOL" , "0" , true
    var b_opt2 as maybe bool is calling rites.getenv_bool with "PENGU_TEST_BOOL"
    calling spark.assert with (b_opt2 is present)
    if b_opt2 is present:
        calling spark.assert with b_opt2.value == false

    calling spark.println with "env accessors: OK"

    # 3. Bulk Environment
    var env_map as map of string to string is calling rites.get_env_map
    calling spark.assert with (calling env_map.contains with "PENGU_TEST_RITES")

    var update_m as map of string to string is map of string to string
    calling update_m.put with "PENGU_TEST_BULK1" , "alpha"
    calling update_m.put with "PENGU_TEST_BULK2" , "beta"
    var set_count as int is calling rites.set_env_map with update_m
    calling spark.assert with set_count == 2
    calling spark.assert with (calling rites.getenv_or with "PENGU_TEST_BULK1" , "") == "alpha"
    calling spark.assert with (calling rites.getenv_or with "PENGU_TEST_BULK2" , "") == "beta"

    calling rites.unsetenv with "PENGU_TEST_BULK1"
    calling rites.unsetenv with "PENGU_TEST_BULK2"
    calling spark.println with "bulk env: OK"

    # 4. Environment Expansion
    calling rites.setenv with "PENGU_USER_NAME" , "pengu" , true
    var exp1 as string is calling rites.expand_env with "hello $PENGU_USER_NAME!"
    calling spark.assert with exp1 == "hello pengu!"

    var braced_var as string is r"user: ${PENGU_USER_NAME}"
    var exp2 as string is calling rites.expand_env with braced_var
    calling spark.assert with exp2 == "user: pengu"

    var exp3 as string is calling rites.expand_env with "user: %PENGU_USER_NAME%"
    calling spark.assert with exp3 == "user: pengu"

    var exp4 as string is calling rites.expand_env with "price is $$50"
    calling spark.assert with exp4 == "price is $50"

    var exp4b as string is calling rites.expand_env with "100%% guaranteed"
    calling spark.assert with exp4b == "100% guaranteed"

    var exp5 as string is calling rites.env_substitute with "alias: $PENGU_USER_NAME"
    calling spark.assert with exp5 == "alias: pengu"

    calling rites.unsetenv with "PENGU_USER_NAME"
    calling spark.println with "expand env: OK"

    # 5. Program Arguments
    var argc as int is calling rites.get_argc
    calling spark.assert with argc >= 1

    var a0 as string is calling rites.get_argv with 0
    calling spark.assert with (a0 length) > 0

    var a0_or as string is calling rites.arg_at_or with 0 , "fallback"
    calling spark.assert with (a0_or length) > 0

    var a_out as string is calling rites.arg_at_or with 9999 , "fallback"
    calling spark.assert with a_out == "fallback"

    var flags as map of string to string is calling rites.parse_flags
    calling spark.assert with ((calling rites.has_flag with "nonexistent_flag") == false)
    calling spark.assert with ((calling rites.get_flag_value with "nonexistent_flag") is not present)
    calling spark.println with "arguments: OK"

    # 6. Process Identity & Directories
    var pid as int is calling rites.getpid
    calling spark.assert with pid > 0

    var cwd_opt as maybe string is calling rites.getcwd
    calling spark.assert with (cwd_opt is present)

    var tmp_opt as maybe string is calling rites.temp_dir
    calling spark.assert with (tmp_opt is present)

    var home_opt as maybe string is calling rites.home_dir
    # home_dir may be present or none depending on runner environment
    if home_opt is present:
        calling spark.assert with ((home_opt.value length) > 0)

    calling spark.println with "process & directories: OK"

    # 7. Platform Info
    var un as string is calling rites.uname
    calling spark.assert with (un length) > 0

    var hn as string is calling rites.hostname
    calling spark.assert with (hn length) > 0

    var arch_s as string is calling rites.os_arch
    calling spark.assert with (arch_s length) > 0

    var fam as string is calling rites.os_family
    calling spark.assert with fam == un

    var is_win as bool is calling rites.is_windows
    var is_unx as bool is calling rites.is_unix
    calling spark.assert with (is_win != is_unx)

    var is_mac as bool is calling rites.is_macos
    var is_lnx as bool is calling rites.is_linux
    if is_lnx:
        calling spark.assert with fam == "Linux"
    if is_mac:
        calling spark.assert with fam == "Darwin"

    calling spark.println with "platform info: OK"

    # 8. Executable Search (which / which_all)
    when os != "windows":
        var which_sh as maybe string is calling rites.which with "sh"
        calling spark.assert with (which_sh is present)
        var all_sh as list of string is calling rites.which_all with "sh"
        calling spark.assert with (calling all_sh.len) >= 1

    var bad_which as maybe string is calling rites.which with "definitely_not_a_binary_12345"
    calling spark.assert with (bad_which is not present)
    calling spark.println with "which search: OK"

    # 9. Shell Execution & Helpers
    var empty_args as list of string is list of string
    var ok_exec as bool is calling rites.exec_ok with "echo" , empty_args
    calling spark.assert with ok_exec

    var esc as string is calling rites.shell_escape with "hello world"
    calling spark.assert with (esc length) > 0

    var usr as maybe string is calling rites.current_user
    # current_user returns a maybe string
    if usr is present:
        calling spark.assert with ((usr.value length) > 0)

    # Cleanup
    calling rites.unsetenv with "PENGU_TEST_RITES"
    calling rites.unsetenv with "PENGU_TEST_FLOAT"
    calling rites.unsetenv with "PENGU_TEST_BOOL"

    calling spark.println with "rites extended: OK"
    return 0
