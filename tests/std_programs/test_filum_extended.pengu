import std.filum
import std.spark

weave _send_scoped_string with cs as ref to filum.ChanString into void:
    var pfx as string is "dynamic_"
    var sfx as string is "heap_string"
    var combined as string is "{pfx}{sfx}"
    calling cs.send with combined

weave main into int:
    calling spark.println with "=== Test Filum Extended ==="

    # 1. Version
    calling spark.assert with filum.FILUM_VERSION == "1.0.0-rc1"
    calling spark.println with "version: OK"

    # 2. Mutex
    var m as filum.Mutex is calling filum.mutex
    calling m.lock
    calling m.unlock
    var locked as bool is calling m.try_lock
    calling spark.assert with locked
    calling m.unlock
    calling m.free
    calling spark.println with "mutex: OK"

    # 3. WaitGroup
    var wg as filum.WaitGroup is calling filum.wait_group
    calling wg.add with 1
    calling wg.done
    calling wg.wait
    calling wg.free
    calling spark.println with "waitgroup: OK"

    # 4. Once & Cond
    var o as filum.Once is calling filum.once
    calling o.free

    var c as filum.Cond is calling filum.cond
    calling c.free
    calling spark.println with "once & cond: OK"

    # 5. AtomicInt Extended
    var a as filum.AtomicInt is calling filum.atomic_int with 0
    calling spark.assert with (calling a.load) == 0
    calling spark.assert with (calling a.is_zero)

    var v_inc as int is calling a.inc
    calling spark.assert with v_inc == 1
    calling spark.assert with (calling a.load) == 1

    var v_inc2 as int is calling a.inc_and_get
    calling spark.assert with v_inc2 == 2

    var v_dec as int is calling a.dec
    calling spark.assert with v_dec == 1

    var v_dec2 as int is calling a.dec_and_get
    calling spark.assert with v_dec2 == 0
    calling spark.assert with (calling a.is_zero)

    var prev_add as int is calling a.add with 10
    calling spark.assert with prev_add == 0
    calling spark.assert with (calling a.load) == 10

    var new_sub as int is calling a.sub with 3
    calling spark.assert with new_sub == 7
    calling spark.assert with (calling a.load) == 7

    var prev_swp as int is calling a.swap with 50
    calling spark.assert with prev_swp == 7
    calling spark.assert with (calling a.load) == 50

    var prev_gas as int is calling a.get_and_set with 100
    calling spark.assert with prev_gas == 50
    calling spark.assert with (calling a.load) == 100

    var cas_ok as bool is calling a.compare_swap with 100 , 200
    calling spark.assert with cas_ok
    calling spark.assert with (calling a.load) == 200

    calling a.reset
    calling spark.assert with (calling a.load) == 0
    calling spark.assert with (calling a.is_zero)
    calling a.free
    calling spark.println with "atomic_int: OK"

    # 6. Typed Channel: ChanInt
    var ci as filum.ChanInt is calling ChanInt.with_capacity with 5
    calling spark.assert with (calling ci.cap) == 5
    calling spark.assert with (calling ci.len) == 0

    var ok_ci as bool is calling ci.send with 42
    calling spark.assert with ok_ci
    calling spark.assert with (calling ci.len) == 1

    var r_ci as maybe int is calling ci.recv
    calling spark.assert with (r_ci is present)
    if r_ci is present:
        calling spark.assert with r_ci.value == 42
    calling spark.assert with (calling ci.len) == 0

    calling ci.close
    calling ci.free
    calling spark.println with "chan_int: OK"

    # 7. Typed Channel: ChanString
    var cs as filum.ChanString is calling ChanString.with_capacity with 5
    calling spark.assert with (calling cs.cap) == 5
    calling spark.assert with (calling cs.len) == 0

    var ok_cs as bool is calling cs.send with "hello filum"
    calling spark.assert with ok_cs
    calling spark.assert with (calling cs.len) == 1

    var r_cs as maybe string is calling cs.recv
    calling spark.assert with (r_cs is present)
    if r_cs is present:
        calling spark.assert with r_cs.value == "hello filum"

    # Deep copy test: sender exits scope before recv
    calling _send_scoped_string with (sigil of cs)
    var r_cs2 as maybe string is calling cs.recv
    calling spark.assert with (r_cs2 is present)
    if r_cs2 is present:
        calling spark.assert with r_cs2.value == "dynamic_heap_string"

    calling cs.close
    calling cs.free
    calling spark.println with "chan_string: OK"

    # 8. Typed Channel: ChanFloat
    var cf as filum.ChanFloat is calling ChanFloat.with_capacity with 5
    var ok_cf as bool is calling cf.send with 2.718
    calling spark.assert with ok_cf

    var r_cf as maybe float is calling cf.recv
    calling spark.assert with (r_cf is present)
    if r_cf is present:
        calling spark.assert with (r_cf.value > 2.71 and r_cf.value < 2.72)

    calling cf.close
    calling cf.free
    calling spark.println with "chan_float: OK"

    # 9. Typed Channel: ChanBool
    var cb as filum.ChanBool is calling ChanBool.with_capacity with 5
    var ok_cb as bool is calling cb.send with true
    calling spark.assert with ok_cb

    var r_cb as maybe bool is calling cb.recv
    calling spark.assert with (r_cb is present)
    if r_cb is present:
        calling spark.assert with r_cb.value == true

    calling cb.close
    calling cb.free
    calling spark.println with "chan_bool: OK"

    # 10. System Helpers
    var cpus as int is calling filum.num_cpu
    calling spark.assert with cpus > 0

    var gid as int is calling filum.goroutine_id
    calling spark.assert with gid >= 0

    calling filum.sleep_sec with 0.001
    calling spark.println with "system helpers: OK"

    calling spark.println with "filum extended: OK"
    return 0
