## Guards nest inside the variant's `case`; the unguarded clause is the fallback.
import std.spark

rune Shape:
    kind as ShapeKind
    width as int

omen ShapeKind:
    Square
    Rect

weave classify with s as Shape into int:
    judge s over kind:
        when Square with width if width > 10 -> 1
        when Square -> 2
        when Rect with width if width > 10 -> 3
        when Rect -> 4

weave main into int:
    var big as Shape is with kind is ShapeKind.Square, width is 20
    var small as Shape is with kind is ShapeKind.Square, width is 2
    var rbig as Shape is with kind is ShapeKind.Rect, width is 20
    var rsm as Shape is with kind is ShapeKind.Rect, width is 1
    calling spark.println with "{calling classify with big} {calling classify with small} {calling classify with rbig} {calling classify with rsm}"
    return 0
