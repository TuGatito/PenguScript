## `judge over` on a rune passed by value: every variant covered, no `else`.
import std.spark

rune Shape:
    kind as ShapeKind
    width as int
    height as int

omen ShapeKind:
    Square
    Rect

weave area with s as Shape into int:
    judge s over kind:
        when Square with width -> width * width
        when Rect with width, height -> width * height

weave main into int:
    var sq as Shape is with kind is ShapeKind.Square, width is 4, height is 0
    var rc as Shape is with kind is ShapeKind.Rect, width is 3, height is 5
    calling spark.println with "{calling area with sq} {calling area with rc}"
    return 0
