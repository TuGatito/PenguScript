enchanting Point
  operator + = (other: Point) -> Point
    Point(@x + other.x, @y + other.y)

  operator - = -> Point
    Point(-@x, -@y)

  mut operator += = (other: Point) -> void
    @x += other.x
    @y += other.y

  operator [] = (i: int) -> double
    @x

  operator () = (n: int) -> int
    n * 2
