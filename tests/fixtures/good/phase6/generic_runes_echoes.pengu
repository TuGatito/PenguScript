echo Pair<T> = tuple<T, T>
echo StringMap<T> = map<string, T>

seal Wrapper<T> = T

rune Box<T>
  value: T

  constructor(v: T)
    @value = v

enchanting Box<T>
  get = -> ref<T>
    ref(@value)

  mut set = (v: T) -> void
    @value = v

rune Animal<T>
  name: T

rune Dog<T> heir Animal<T>
  breed: string
