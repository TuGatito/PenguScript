-- Flags omen with bitwise operations

flags omen Permission: uint8_t
  None = 0
  Read = 1 << 0
  Write = 1 << 1
  Execute = 1 << 2
  All = Permission::Read | Permission::Write | Permission::Execute

mut perms = Permission::Read | Permission::Write
perms |= Permission::Execute
perms &= ~Permission::Write

has_read = perms.has(Permission::Read)
