realm geometry

invoke "std/io" as io

const PI = 3.141592653589793
const DEFAULT_SCALE = 1.0

echo Distance = double
seal Angle = double

omen Color
  Red,
  Green,
  Blue

flags omen RenderFlags
  Visible = 1,
  Shadow = 2,
  Reflective = 4

rune Point
  x: double
  y: double

  constructor(x: double, y: double)
    @x = x
    @y = y

enchanting Point
  distance = (other: Point) -> double
    0.0

  mut translate = (dx: double, dy: double) -> void
    @x += dx
    @y += dy

distance_squared = <T>(p1: T, p2: T) -> double
  0.0
