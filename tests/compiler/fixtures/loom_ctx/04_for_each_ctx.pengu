import std.loom
import std.spark

rune Collector:
    total as int
    items as list of int

weave collect with c as ref to Collector, x as int into void:
    set c->total is c->total + x
    calling c->items.push with x

weave main into int:
    var c as Collector is with total is 0
    var xs as list of int is [1, 2, 3]
    calling loom.for_each_ctx with xs, (sigil of c), collect
    calling spark.println with "{c.total} {calling c.items.len} {c.items at 2}"
    banish c.items
    banish xs
    return 0
