## Golden: reasignar un `string`/`list` local libera el valor anterior.
##
## `set x is y` emite `pengu_string_replace`/`pengu_list_replace`, que liberan el
## handle viejo solo si es distinto del nuevo.
import std.spark

weave main into int:
    var s as string is "hola" + " mundo"
    set s is "adios"
    calling spark.println with s
    banish s
    var l as list of int is [1, 2, 3]
    set l is [4, 5]
    calling spark.println with "{l at 0},{l at 1}"
    banish l
    return 0
