# Manual memory: a list never clones on push and never releases its elements, so
# each owner is banished by hand, exactly once.
weave test_list_string into int:
    var words as list of string is ["alpha", "beta", "gamma", "delta"]
    var count as int is calling words.len
    # The elements are literal .rodata views (is_owned == 0): nothing to release
    # per element, only the container's own buffer.
    banish words
    return count

weave test_nested_lists into int:
    var matrix as list of list of int is list of list of int
    var row1 as list of int is [1, 2, 3]
    var row2 as list of int is [4, 5, 6]
    calling matrix.push with row1
    calling matrix.push with row2
    var total as int is calling matrix.len
    # The pushed elements alias row1/row2's buffers, so the rows are the owners.
    banish row1
    banish row2
    banish matrix
    return total

weave main into int:
    var c1 as int is calling test_list_string
    var c2 as int is calling test_nested_lists
    if c1 == 4 and c2 == 2:
        return 0
    return 1
