# Gap 1: a local rune receiver ('bag.items.push') resolves through the chain.
#
# Manual memory: 'push' copies the PenguString header, so the list element
# aliases the buffer of 'local'.  Releasing each element before the container is
# what keeps the program leak-free; the compiler does neither for you.
rune Bag derive Nexus:
    items as list of string

weave fill with n as int into int:
    var bag as Bag with:
        set .items is list of string
    var local as string is n to string
    calling bag.items.push with local
    var count as int is calling bag.items.len
    var i as int is 0
    while i < count:
        banish (bag.items at i)
        set i is i + 1
    banish bag
    return count

weave main into int:
    var a as int is calling fill with 7
    var b as int is calling fill with 8
    if a == 1 and b == 1:
        return 0
    return 1
