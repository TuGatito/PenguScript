# Gap 1: longer chains ('outer->inner.items.push').
#
# Manual memory: 'derive Nexus' frees the containers ('inner', then its 'items'
# buffer) but never the strings they hold, so those are released element by
# element first.
rune Inner derive Nexus:
    items as list of string

rune Outer derive Nexus:
    inner as Inner

weave fill with o as ref to Outer, n as int into void:
    var local as string is n to string
    calling o->inner.items.push with local

weave main into int:
    var o as Outer with:
        set .inner is with:
            set .items is list of string
    calling fill with (sigil of o), 5
    var ok as bool is (calling o.inner.items.len == 1 and (o.inner.items at 0) == "5")
    var i as int is 0
    while i < calling o.inner.items.len:
        banish (o.inner.items at i)
        set i is i + 1
    banish o
    if ok:
        return 0
    return 1
