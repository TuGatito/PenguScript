# Gap 1 (regression): the 'with' form already carried the target type.
rune Bag derive Nexus:
    items as list of string

weave fill with bag as ref to Bag, n as int into void:
    var local as string is n to string
    with bag->items:
        calling .push with local

weave main into int:
    var b as Bag with:
        set .items is list of string
    defer banish b
    calling fill with (sigil of b), 4
    if calling b.items.len == 1 and (b.items at 0) == "4":
        return 0
    return 1
