## Regression for the CC-backed list/map and map iteration.
import std.spark

weave eq_i with got as int, want as int, what as string into int:
    if got != want:
        calling spark.println with "FAIL cc_containers: {what}: {got} != {want}"
        return 1
    return 0

weave main into int:
    var xs as list of int is list of int
    var i as int is 0
    while i < 100:
        calling xs.push with i
        set i is i + 1
    if (calling eq_i with (xs.len), 100, "push/len") != 0:
        return 1
    if (calling eq_i with ((xs at 50)), 50, "index") != 0:
        return 1
    var popped as int is calling xs.pop
    if (calling eq_i with popped, 99, "pop") != 0:
        return 1
    calling xs.clear
    if (calling eq_i with (xs.len), 0, "clear") != 0:
        return 1
    banish xs

    var m as map of string to int is map of string to int
    calling m.put with "a", 10
    calling m.put with "b", 20
    calling m.put with "c", 30
    if (calling eq_i with (m.len), 3, "map len") != 0:
        return 1
    var v as int is m at "b"
    if (calling eq_i with v, 20, "map get") != 0:
        return 1
    var seen as int is 0
    for k in m:
        set seen is seen + 1
    if (calling eq_i with seen, 3, "map iteration") != 0:
        return 1
    if not (calling m.has with "a"):
        return 1
    if not calling m.remove with "a":
        return 1
    if calling m.has with "a":
        return 1
    banish m

    calling spark.println with "OK cc_containers"
    return 0
