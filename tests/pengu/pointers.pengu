import std.ffi
import std.spark

weave bump with p as ref to int into void:
    set p is 42

weave inc with n as int into int:
    return n + 1

weave first with xs as list of int into ref to int:
    return sigil of (xs at 0)

weave static_ref into ref to int:
    static var value as int is 9
    return sigil of value

weave main into int:
    ## Auto-deref: `set ref is value` writes through the reference.
    var x as int is 1
    calling bump with (sigil of x)
    if x != 42:
        return 1

    ## A `let` reference is read-only as a binding, but its pointee is writable.
    var y as int is 5
    let py as ref to int is sigil of y
    set py is 6
    if y != 6:
        return 2

    ## Rebinding a pointer still works when the value is a pointer.
    var z as int is 7
    var pz as ref to int is sigil of z
    var other as ref to int is calling static_ref
    set pz is other
    if essence of pz != 9:
        return 3

    ## Null assignment and comparison.
    set pz is null
    if pz != null:
        return 4

    ## Pointer arithmetic, compound assignment and difference.
    var a as array of int is [1, 2, 3]
    var p as ref to int is sigil of (a at 0)
    var q as ref to int is p + 1
    if essence of q != 2:
        return 5
    if (q - p) != 1:
        return 6
    set q += 1
    if essence of q != 3:
        return 7
    set q -= 1
    if essence of q != 2:
        return 8
    if essence of (calling ffi.ptr_add with p, 2) != 3:
        return 9
    if not (p < q):
        return 10

    ## `p at i` is readable and writable.
    if (p at 1) != 2:
        return 11
    set p at 1 is 20
    if (a at 1) != 20:
        return 12

    ## A slice built from an array is writable.
    var s as slice of int is with data is sigil of (a at 0), len is 3, elem_size is size of int
    set s at 2 is 30
    if (a at 2) != 30:
        return 13

    ## Taking the address of a list element yields a real element pointer.
    var xs as list of int is list of int
    calling xs.push with 4
    calling xs.push with 5
    var lp as ref to int is sigil of (xs at 1)
    set lp is 50
    if (xs at 1) != 50:
        return 14

    ## Address of a `let` binding is read-only.
    let ro as int is 8
    var pr as ref to frozen int is sigil of ro
    if essence of pr != 8:
        return 15

    ## Function pointers.
    var f as ref to weave with int into int is sigil of inc
    if (calling f with 4) != 5:
        return 16

    ## A reference borrowed from a parameter is safe to return.
    var borrowed as ref to int is calling static_ref
    if essence of borrowed != 9:
        return 17

    ## Explicit pointer <-> integer casts preserve the address.
    var addr as usize is p to usize
    var round as ref to int is addr to ref to int
    if round != p:
        return 17
    if essence of round != 1:
        return 18

    ## Backwards pointer arithmetic stays inside the array (no OOB read).
    var mid as ref to int is sigil of (a at 1)
    if (mid - 1) != p:
        return 19

    ## Heap-owned list storage is safe to borrow from a parameter.
    var xs2 as list of int is list of int
    calling xs2.push with 77
    if essence of (calling first with xs2) != 77:
        return 20

    if size of (ref to int) != size of (ref to void):
        return 21
    calling spark.println with "OK pointers"
    return 0
