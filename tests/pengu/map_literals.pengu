## Regresión: literales de mapa `{"a": 1}` (0.42.0).
##
## El literal construye un mapa real: cada entrada se inserta con
## `pengu_map_put` y el valor resultante es un `PenguMap` con dueño.
weave size_of_map with m as map of string, int into int:
    return m.len

weave main into int:
    var empty as map of string, int is {}
    if empty.len != 0:
        return 1
    banish empty

    var one as map of string, int is {"a": 41}
    if one.len != 1:
        return 2
    if (one at "a") != 41:
        return 3
    banish one

    var m as map of string, int is {"a": 1, "b": 2, "c": 3}
    if m.len != 3:
        return 4
    if (m at "b") != 2:
        return 5
    if (m at "zz") != 0:
        return 6
    if (calling size_of_map with m) != 3:
        return 7

    # Iteración: las claves salen del mapa real.
    var seen as int is 0
    for k in m:
        if k.len != 1:
            return 8
        set seen is seen + 1
    if seen != 3:
        return 9
    banish m

    # Literal temporal en un argumento y mapa anidado.
    if (calling size_of_map with {"x": 7, "y": 8}) != 2:
        return 10
    var nested as map of string, map of string, int is {"inner": {"n": 5}}
    var inner as map of string, int is (nested at "inner")
    if (inner at "n") != 5:
        return 11
    banish inner
    banish nested

    # Claves no literales (expresión) y valores calculados.
    var base as int is 10
    var computed as map of string, int is {"k{base}": base * 2}
    if (computed at "k10") != 20:
        return 12
    banish computed
    return 0
