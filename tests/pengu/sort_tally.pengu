## Regression tests for the O(n log n) `std.tally` sort API.
import std.tally
import std.spark

weave check_int into void:
    var xs as vector of int is [3, 1, 2, 2]
    let up as vector of int is calling tally.sort_int_asc with xs
    let a as bool is (up at 0) == 1
    let b as bool is (up at 3) == 3
    calling spark.assert_msg with a, "int asc first"
    calling spark.assert_msg with b, "int asc last"
    let down as vector of int is calling tally.sort_int_desc with xs
    let c as bool is (down at 0) == 3
    let d as bool is (down at 3) == 1
    calling spark.assert_msg with c, "int desc first"
    calling spark.assert_msg with d, "int desc last"
    let intact as bool is (xs at 0) == 3
    calling spark.assert_msg with intact, "input intact"
    let sorted as bool is calling tally.is_sorted_int_asc with up
    calling spark.assert_msg with sorted, "is_sorted_int_asc"

weave check_float into void:
    var xs as vector of float is [3.5, -1.5, 4.5]
    let up as vector of float is calling tally.sort_float_asc with xs
    let a as bool is (up at 0) < -1.0
    calling spark.assert_msg with a, "float asc first"
    let down as vector of float is calling tally.sort_float_desc with xs
    let b as bool is (down at 0) > 4.0
    calling spark.assert_msg with b, "float desc first"

weave check_f64 into void:
    var xs as vector of f64 is [2.5, -1.5, 4.5]
    let up as vector of f64 is calling tally.sort_f64_asc with xs
    let a as bool is (up at 0) < -1.0
    calling spark.assert_msg with a, "f64 asc first"

weave check_string into void:
    var xs as vector of string is ["c", "a", "b"]
    let up as vector of string is calling tally.sort_string_asc with xs
    let a as bool is (up at 0) == "a"
    calling spark.assert_msg with a, "string asc first"
    let down as vector of string is calling tally.sort_string_desc with xs
    let b as bool is (down at 0) == "c"
    calling spark.assert_msg with b, "string desc first"
    let unsorted as bool is calling tally.is_sorted_string_asc with xs
    let c as bool is unsorted == false
    calling spark.assert_msg with c, "strings unsorted"
    let dsorted as bool is calling tally.is_sorted_string_desc with down
    calling spark.assert_msg with dsorted, "strings desc sorted"

weave check_large into void:
    var xs as vector of int is vector of int
    var i as int is 0
    while i < 5000:
        calling xs.push with ((i * 37) % 5000)
        set i is i + 1
    let up as vector of int is calling tally.sort_int_asc with xs
    let a as bool is calling tally.is_sorted_int_asc with up
    calling spark.assert_msg with a, "5000 sorted"
    let b as bool is (up at 0) == 0
    let c as bool is (up at 4999) == 4999
    calling spark.assert_msg with b, "5000 lower bound"
    calling spark.assert_msg with c, "5000 upper bound"

weave main into int:
    calling check_int
    calling check_float
    calling check_f64
    calling check_string
    calling check_large
    calling spark.println with "sort_tally OK"
    return 0
