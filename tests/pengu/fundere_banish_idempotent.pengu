# Liberar un campo del embed y despues el host es seguro: `banish` deja el
# handle a cero, asi que el cleanup compuesto no lo vuelve a liberar (R3).
import std.filum

rune GameObj:
    label as string

rune Enemy fundere GameObj:
    notes as string

weave main into int:
    var e as Enemy is with gameObj is (with label is (calling filum.pengu_string_copy with "slime")), notes is (calling filum.pengu_string_copy with "note")
    banish e.gameObj
    banish e
    return 0
