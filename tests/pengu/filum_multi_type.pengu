# Two thread instantiations with different argument types. Regression for the
# same box-layout bug in std.filum.start.
import std.filum
import std.spark

weave worker_str with s as string into void:
    calling spark.println with s

weave worker_int with n as int into void:
    var text as string is n to string
    calling spark.println with text
    banish text

weave main into int:
    var a as filum.Thread is calling filum.start with worker_str, "beta"
    var b as filum.Thread is calling filum.start with worker_int, 7
    var ra as result of void to filum.ThreadError is calling a.join
    var rb as result of void to filum.ThreadError is calling b.join
    if not ra.is_ok:
        return 1
    if not rb.is_ok:
        return 1
    return 0
