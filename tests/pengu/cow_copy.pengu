import std.spark

## Copy-on-write de `list`/`map` (fase 7 del plan de memoria):
## copiar un binding es O(1) y comparte el bufer; la primera mutacion clona
## solo para el que muta, y el original no cambia.

weave list_paths into int:
    var a as list of int is [1]
    var b as list of int is a
    if not (calling a.is_shared):
        return 1
    if (calling a.ref_count) != 2:
        return 2
    calling b.push with 2
    if (calling a.len) != 1:
        return 3
    if (calling b.len) != 2:
        return 4
    if calling a.is_shared:
        return 5
    if (a at 0) != 1:
        return 6
    if (b at 1) != 2:
        return 7
    banish a
    banish b
    return 0

weave list_make_unique into int:
    var a as list of int is [1]
    var b as list of int is a
    calling b.make_unique
    if calling b.is_shared:
        return 1
    calling a.push with 9
    if (calling b.len) != 1:
        return 2
    banish a
    banish b
    return 0

weave map_paths into int:
    var m as map of string to int is map of string to int
    calling m.put with "k", 1
    var n as map of string to int is m
    if (calling m.len) != 1:
        return 1
    calling n.put with "j", 2
    if (calling m.len) != 1:
        return 2
    if (calling n.len) != 2:
        return 3
    banish m
    banish n
    return 0

weave nested into int:
    var a as list of list of int is [[1, 2]]
    var b as list of list of int is a
    calling b.push with [3]
    if (calling a.len) != 1:
        return 1
    if (calling b.len) != 2:
        return 2
    banish a
    banish b
    return 0

weave main into int:
    var r as int is calling list_paths
    if r != 0:
        return r
    set r is calling list_make_unique
    if r != 0:
        return 10 + r
    set r is calling map_paths
    if r != 0:
        return 20 + r
    set r is calling nested
    if r != 0:
        return 30 + r
    calling spark.println with "ok"
    return 0
