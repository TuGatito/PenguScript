## Regresión: parámetros variádicos `many T` (0.40.0).
##
## El parámetro viaja como `PenguSlice`: se empaqueta en el sitio de llamada,
## se reenvía tal cual un slice/array y se indexa como un slice.
weave sum with xs as many int into int:
    var t as int is 0
    var i as int is 0
    while i < xs.len:
        set t is t + (xs at i)
        set i is i + 1
    return t

weave twice with xs as many int into int:
    return (calling sum with xs) * 2

weave join with sep as string, parts as many string into string:
    var out as string is ""
    var i as int is 0
    while i < parts.len:
        if i > 0:
            set out is out + sep
        set out is out + (parts at i)
        set i is i + 1
    return out

weave first shard T with xs as many T into T:
    return xs at 0

rune Bag:
    total as int

enchanting Bag:
    weave add with xs as many int into void:
        var i as int is 0
        while i < xs.len:
            set self->total is self->total + (xs at i)
            set i is i + 1

weave main into int:
    if (calling sum) != 0:
        return 1
    if (calling sum with 1, 2, 3) != 6:
        return 2
    if (calling twice with 1, 2, 3) != 12:
        return 3
    var arr as array of int with size 3 is array of int with size 3
    set arr at 0 is 1
    set arr at 1 is 2
    set arr at 2 is 3
    if (calling sum with arr) != 6:
        return 4
    var sl as span of int is arr at 0 to 3
    if (calling sum with sl) != 6:
        return 5
    if (calling join with ",") != "":
        return 6
    if (calling join with "-", "a", "b", "c") != "a-b-c":
        return 7
    if (calling first with 7, 8, 9) != 7:
        return 8
    var names as vector of string is vector of string
    calling names.push with "x"
    calling names.push with "y"
    if (calling join with "+", names at 0 to 2) != "x+y":
        return 9
    var b as Bag is with total is 0
    calling b.add with 2, 3, 4
    if b.total != 9:
        return 10
    return 0
