## Regresión: argumentos por defecto (0.22.x, ampliado en 0.39.0).
##
## Los defaults se pliegan en el sema: no dependen del AST del módulo que
## declara, no se reevalúan por llamada y encajan con el tipo del parámetro.
const BASE as int is 40
const GREETING as string is "hi"

weave add with a as int, b as int is 1 into int:
    return a + b

weave scale with value as float, factor as float is 2.0 into float:
    return value * factor

weave describe with n as int is BASE + 2, loud as bool is true, tag as string is GREETING into string:
    if loud:
        return "{tag}:{n}!"
    return "{tag}:{n}"

weave offset with x as int, dy as int is -3 into int:
    return x + dy

weave flag with on as bool is false into bool:
    return on

rune Point:
    x as int
    y as int

enchanting Point:
    weave shifted with dx as int is 1, dy as int is 2 into Point:
        return with x is self->x + dx, y is self->y + dy

weave pick shard T with a as T, b as T is 9 into T:
    return b

weave main into int:
    if (calling add with 2) != 3:
        return 1
    if (calling add with 2, 10) != 12:
        return 1
    var s as string is "{calling add with 2}"
    if not (s == "3"):
        return 1
    if (calling scale with 1.5) != 3.0:
        return 1
    if (calling describe) != "hi:42!":
        return 1
    if (calling describe with 5, false) != "hi:5":
        return 1
    if (calling describe with tag is "yo", n is 1) != "yo:1!":
        return 1
    if (calling offset with 10) != 7:
        return 1
    if calling flag:
        return 1
    var p as Point is with x is 1, y is 2
    var q as Point is calling p.shifted
    if q.x != 2 or q.y != 4:
        return 1
    if (calling pick with 1) != 9:
        return 1
    return 0
