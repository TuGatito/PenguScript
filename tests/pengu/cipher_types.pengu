import std.cipher
import std.spark

## Regresión S1: `CipherJsonValue` referencia por valor a `JsonArrayNode` y
## `JsonObjectNode`; el codegen debe emitir los runes antes del omen.
weave main into int:
    var b as string is calling cipher.encode_base64 with "hello"
    if b != "aGVsbG8=":
        banish b
        return 1
    banish b
    var parsed as maybe map of string, string is calling cipher.parse_json with "{\"a\":1}"
    banish parsed
    calling spark.println with "OK cipher_types"
    return 0
