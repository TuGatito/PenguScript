import std.coro

weave consume with s as string into void:
    var n as int is 0
    for c in s:
        set n is n + 1
    banish s
    if n != 5:
        return

weave main into int:
    var co as coro.Coroutine is calling coro.start with consume, "hello"
    var first as coro.CoroutineState is calling co.resume
    calling co.free
    if first != coro.CoroutineState.finished:
        return 1
    return 0
