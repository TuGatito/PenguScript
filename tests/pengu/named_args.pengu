## Regresión: argumentos nombrados y aridad (0.38.0).
weave greet with name as string, times as int is 2, loud as bool is false into string:
    var s as string is name
    var i as int is 0
    while i < times:
        if loud:
            set s is "{s}!"
        else:
            set s is "{s}."
        set i is i + 1
    return s

weave sub with a as int, b as int into int:
    return a - b

weave pick with a as int is 1, b as int is 2, c as int is 3 into int:
    return a * 100 + b * 10 + c

rune Point:
    x as int
    y as int

enchanting Point:
    weave shift with dy as int into int:
        set self->y is self->y + dy
        return self->y

weave first_of shard T with a as T, b as T into T:
    return a

weave main into int:
    if (calling sub with b is 5, a is 12) != 7:
        return 1
    if (calling greet with times is 2, name is "hi") != "hi..":
        return 1
    if (calling greet with loud is true, name is "yo") != "yo!!":
        return 1
    if (calling greet with "z") != "z..":
        return 1
    if (calling pick with c is 9, a is 2) != 229:
        return 1
    var p as Point is with x is 1, y is 2
    if (calling p.shift with dy is 5) != 7:
        return 1
    if p.y != 7:
        return 1
    if (calling first_of with b is 8, a is 4) != 4:
        return 1
    return 0
