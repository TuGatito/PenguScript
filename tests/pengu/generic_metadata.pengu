# Una instancia generica conserva los atributos de layout del template y sus
# campos apuntan al `decl_node` original (hover/definicion del LSP).

@packed
rune Pac shard T:
    a as T
    b as int

@align(16)
rune Ali shard T:
    a as T

weave main into int:
    var p as Pac of int is with a is 1, b is 2
    var q as Ali of int is with a is 3
    if p.a != 1 or p.b != 2 or q.a != 3:
        return 1
    return 0
