grimoire
    bind count: Int = 42
    bind mask: UInt = 0xFF
    bind ratio: Float = 1.5
    bind letter: Char = 'P'
    bind name: &Str = "pengu"

    bind total = count + 1
    bind wrapped = mask.wrapping_add(1)
    bind checked = count.checked_add(1)

    print(total)
    print(wrapped)
    print(checked.unwrap_or(0))
    print(ratio)
    print(letter)
    print(name)
