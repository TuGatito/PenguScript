rune Point
    x: Float
    y: Float

enchanting Shape
    Circle(Float)
    Rectangle(Float, Float)

pact Area
    area = (@) -> Float

essence Meters = Float

area_of = (shape: &Shape) -> Float
    match shape
        when Circle(r) then 3.141592653589793 * r * r
        when Rectangle(w, h) then w * h
