grimoire
    bind counter = Arc.new(Mutex.new(0))
    morph handles = Vec.new()

    for _ in 0..4
        bind c = Arc.clone(&counter)
        handles.push(std.thread.spawn(move () =>
            morph guard = c.lock().unwrap()
            *guard += 1
        ))

    for handle in handles
        handle.join().unwrap()

    print(*counter.lock().unwrap())
