-- fragmento didáctico: se asume dentro de un `grimoire`; no es un módulo completo.
pact Container
    essence Item
    first = (@) -> ?&Item

rune Numbers
    values: Vec[Int]

ritual Numbers for Container
    essence Item = Int
    first = (@) -> ?&Int
        @.values.first()

bind n = Numbers(values: [10, 20])
print(n.first().unwrap_or(&0))
