rune Point
    x: Float
    y: Float

ritual Point
    length = (@) -> Float
        (@.x * @.x + @.y * @.y).sqrt()

    translate = (@mut, dx: Float, dy: Float) -> Unit
        @.x += dx
        @.y += dy

    origin = () -> Point
        Point(x: 0.0, y: 0.0)

sum = (x: Int, y: Int) -> Int
    x + y

grimoire
    morph p = Point(x: 3.0, y: 4.0)
    print(p.length())
    p.translate(1.0, 2.0)
    print(p.length())

    bind q = Point.origin()
    print(q.length())
    print(sum(2, 3))
