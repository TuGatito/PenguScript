scroll geometry
    unveil rune Point
        unveil x: Float
        unveil y: Float

    unveil distance = (a: &Point, b: &Point) -> Float
        bind dx = a.x - b.x
        bind dy = a.y - b.y
        (dx * dx + dy * dy).sqrt()

grimoire
    bind a = geometry.Point(x: 0.0, y: 0.0)
    bind b = geometry.Point(x: 3.0, y: 4.0)
    print(geometry.distance(&a, &b))
