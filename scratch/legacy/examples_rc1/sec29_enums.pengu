-- fragmento didáctico: se asume dentro de un `grimoire`; no es un módulo completo.
enchanting Shape
    Circle(Float)
    Rectangle(Float, Float)

area = (shape: &Shape) -> Float
    match shape
        when Circle(r) then 3.141592653589793 * r * r
        when Rectangle(w, h) then w * h

bind s = Circle(2.0)
print(area(&s))
