rune Node
    value: Int
    next: ?Box[Node]

grimoire
    bind list = Box.new(Node(
        value: 1,
        next: some(Box.new(Node(value: 2, next: none)))
    ))
    print(list.value)

    bind a = Rc.new(String.from("pengu"))
    bind b = Rc.clone(&a)
    print(Rc.strong_count(&a))

    bind cell = RefCell.new(1)
    *cell.borrow_mut() += 1
    print(*cell.borrow())
