-- fragmento didáctico: se asume dentro de un `grimoire`; no es un módulo completo.
pact Shape
    area = (@) -> Float
    name = (@) -> Str
        "shape"

rune Circle
    radius: Float

ritual Circle for Shape
    area = (@) -> Float
        3.14159 * @.radius * @.radius
    name = (@) -> Str
        "circle"

bind s: &dyn Shape = &Circle(radius: 2.0)
print(s.name())
print(s.area())
