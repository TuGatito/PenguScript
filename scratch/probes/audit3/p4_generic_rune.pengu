unveil rune Pila[T]
    unveil items: Vec[T]

unveil ritual[T] Pila[T]
    new = () -> Pila[T]
        Pila(items: Vec.new())
    push = (@mut, value: T) -> Unit
        @.items.push(value)
    len = (@) -> Usize
        @.items.len()

grimoire
    morph p: Pila[Int] = Pila.new()
    p.push(1)
    p.push(2)
    print(p.len())
