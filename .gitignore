# ==============================================================================
# PenguScript Git Ignore Configuration
# ==============================================================================

# External C libraries (downloaded automatically by make_release.py / extern_manifest.py)
extern/

prompt.md

# Legacy location of the generated distribution guide. make_release.py used to
# write it to the repository root; it now writes docs/README_RELEASE.md. Kept
# anchored to the root so it cannot also match docs/README_RELEASE.md.
/README_RELEASE.md

# Build & Release Directories
build/
dist/
pengucc_build/
scratch/
pyinstaller_work/

# Generated project artefacts
compile_commands.json
pengu_doc_out/
# NOTE: `docs/api/` used to be ignored here as a `pengu doc` output directory.
# It is now a *tracked*, generated artefact (roadmap item 7.13): the reference is
# committed so it can be browsed, and `tests/test_api_docs.py` fails when it
# drifts from the compiler. Regenerate with `python tools/gen_api_docs.py --write`.

