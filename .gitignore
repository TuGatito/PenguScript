# Build and release output
/build/
/dist/
/scratch/
/dist-*/
/pengucc_build/
/pyinstaller_work/
*.spec
*.o
*.a
*.obj
*.exe
*.dll
*.so
*.dylib
*.out
*.gch

# Editor / local tooling
.vscode/
.idea/
*.swp
.DS_Store
compile_commands.json

# Dev-only Python helper caches (not part of the compiler)
__pycache__/
*.py[cod]
.venv/
node_modules/

# VS Code extension build output
/vscode-extension/dist/

# Local CI job logs
*-job-logs.txt

# TypeScript intermediate output (the extension ships the esbuild bundle)
/vscode-extension/out/pscPath.js
/vscode-extension/out/pscPath.js.map

# Packaged VSIX artifacts
/vscode-extension/*.vsix
