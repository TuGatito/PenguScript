# ==============================================================================
# PenguScript Git Ignore Configuration
# ==============================================================================

# External C libraries (downloaded automatically by make_release.py / extern_manifest.py)
extern/

# Build & Release Directories
build/
dist/
pengucc_build/
scratch/
pyinstaller_work/

# Compiled Binaries & Object Files
*.exe
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib
*.bundle
*.out

# PyInstaller temporary files
*.spec
*.manifest

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/
.env

# Node.js & VS Code Extension Artifacts
node_modules/
vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/*.vsix
*.vsix
.vscode-test/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.gemini/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini