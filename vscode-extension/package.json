{
    "name": "pengus",
    "displayName": "PenguScript",
    "description": "Language support, LSP intelligence, and cargo-like project management for PenguScript.",
    "publisher": "pengus-lang",
    "version": "4.1.0",
    "icon": "./icons/pengu_icon.png",
    "keywords": [
        "pengus",
        "penguscript",
        "pengu",
        "systems-programming",
        "compiler",
        "lsp",
        "concepts",
        "generics",
        "omens",
        "runes"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TuGatito/PenguScript"
    },
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters",
        "Programming Language Features"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:pengus",
        "workspaceContains:**/pengu.toml",
        "workspaceContains:**/*.pengu"
    ],
    "contributes": {
        "languages": [
            {
                "id": "pengus",
                "aliases": [
                    "PenguScript",
                    "pengus",
                    "pengu"
                ],
                "extensions": [
                    ".pengu",
                    ".pengus",
                    ".d.pengu"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/pengu_icon.png",
                    "dark": "./icons/pengu_icon_white.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "pengus",
                "scopeName": "source.pengus",
                "path": "./syntaxes/pengus.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "pengus",
                "path": "./snippets/pengus.json"
            }
        ],
        "commands": [
            {
                "command": "pengus.build",
                "title": "PenguScript: Build Project",
                "category": "PenguScript"
            },
            {
                "command": "pengus.run",
                "title": "PenguScript: Run Project",
                "category": "PenguScript"
            },
            {
                "command": "pengus.test",
                "title": "PenguScript: Run Tests",
                "category": "PenguScript"
            },
            {
                "command": "pengus.doc",
                "title": "PenguScript: Generate Documentation",
                "category": "PenguScript"
            },
            {
                "command": "pengus.clean",
                "title": "PenguScript: Clean Project",
                "category": "PenguScript"
            },
            {
                "command": "pengus.init",
                "title": "PenguScript: Initialize New Project",
                "category": "PenguScript"
            },
            {
                "command": "pengus.selectExecutable",
                "title": "PenguScript: Select psc Executable",
                "category": "PenguScript"
            },
            {
                "command": "pengus.restartLsp",
                "title": "PenguScript: Restart Language Server",
                "category": "PenguScript"
            },
            {
                "command": "pengus.showMenu",
                "title": "PenguScript: Show Menu",
                "category": "PenguScript"
            },
            {
                "command": "pengus.runFile",
                "title": "PenguScript: Run Current File",
                "category": "PenguScript"
            },
            {
                "command": "pengus.testFile",
                "title": "PenguScript: Test Current File",
                "category": "PenguScript"
            },
            {
                "command": "pengus.check",
                "title": "PenguScript: Check File",
                "category": "PenguScript"
            },
            {
                "command": "pengus.format",
                "title": "PenguScript: Format Document",
                "category": "PenguScript"
            },
            {
                "command": "pengus.openOutput",
                "title": "PenguScript: Show Output",
                "category": "PenguScript"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "PenguScript",
            "properties": {
                "pengus.executablePath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Path to the `psc` executable. When empty the extension checks `$PENGU_PSC`, `~/.config/pengu/env.json` (written by `tools/build.sh`), `$PENGU_HOME/build/psc`, `$PSC_BIN_PATH` (legacy `$PENGU_BIN_PATH`), `PATH`, and the usual locations (`./psc`, `./bin/psc`, `./build/psc`, `~/psc/psc`, `~/.local/bin/psc`, `/usr/local/bin/psc`)."
                },
                "pengus.defaultProfile": {
                    "type": "string",
                    "enum": [
                        "debug",
                        "release",
                        "small"
                    ],
                    "default": "debug",
                    "description": "Default build profile ('debug' or 'release') used for build and run commands."
                },
                "pengus.stdDir": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Directorio de la stdlib. Si est\u00e1 vac\u00edo se usa `$PSC_STD_DIR`, `$PENGU_STD_DIR`, `<proyecto>/std` o `<psc>/../std`."
                },
                "pengus.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Nivel de traza del cliente LSP."
                },
                "pengus.inlayHints.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Mostrar hints de tipo inferido."
                },
                "pengus.semanticHighlighting.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Usar semantic tokens del LSP."
                },
                "pengus.statusBar.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Mostrar el estado de PenguScript en la barra inferior."
                }
            }
        },
        "semanticTokenScopes": [
            {
                "language": "pengus",
                "scopes": {
                    "type": [
                        "entity.name.type.pengus",
                        "support.type.pengus"
                    ],
                    "namespace": [
                        "entity.name.namespace.pengus"
                    ],
                    "parameter": [
                        "variable.parameter.pengus"
                    ],
                    "property": [
                        "variable.other.property.pengus"
                    ],
                    "enumMember": [
                        "variable.other.enummember.pengus"
                    ],
                    "operator": [
                        "keyword.operator.pengus"
                    ]
                }
            }
        ],
        "configurationDefaults": {
            "[pengus]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.detectIndentation": false
            }
        },
        "menus": {
            "editor/title": [
                {
                    "command": "pengus.run",
                    "when": "resourceLangId == pengus",
                    "group": "navigation@1"
                }
            ],
            "explorer/context": [
                {
                    "command": "pengus.runFile",
                    "when": "resourceExtname == .pengu",
                    "group": "navigation@1"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run bundle",
        "compile": "tsc -p ./",
        "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
        "watch": "tsc -watch -p ./",
        "package": "npx @vscode/vsce package",
        "test": "npm run compile && node test/psc_path_check.js \"$PWD/out\" && node test/grammar.test.js",
        "test:grammar": "node test/grammar.test.js"
    },
    "devDependencies": {
        "@types/node": "^18.14.6",
        "@types/vscode": "^1.82.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.20.0",
        "typescript": "^5.1.6",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "restrictedConfigurations": [
                "pengus.executablePath"
            ]
        },
        "virtualWorkspaces": true
    }
}
