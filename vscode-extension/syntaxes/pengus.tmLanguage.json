{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PenguScript",
  "scopeName": "source.pengus",
  "fileTypes": [
    "pengu",
    "pengus"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#function_definition"
    },
    {
      "include": "#type_definition"
    },
    {
      "include": "#test_definition"
    },
    {
      "include": "#builtin_concepts"
    },
    {
      "include": "#builtin_types"
    },
    {
      "include": "#type_use"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.pengus",
          "begin": "^\\s*##\\s*$",
          "end": "^\\s*##\\s*$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.pengus"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.pengus"
            }
          }
        },
        {
          "name": "comment.line.documentation.pengus",
          "match": "^\\s*##.*$",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.pengus"
            }
          }
        },
        {
          "name": "comment.line.number-sign.pengus",
          "match": "^\\s*#.*$"
        },
        {
          "name": "comment.line.double-slash.pengus",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.triple.pengus",
          "begin": "r\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.triple.pengus",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#string_escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.raw.pengus",
          "begin": "r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.pengus",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string_escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "string_escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.pengus",
          "match": "\\\\u\\{[0-9A-Fa-f]+\\}|\\\\x[0-9A-Fa-f]{2}|\\\\[0-7]{1,3}|\\\\."
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.line.pengus",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.pengus"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.pengus"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.pengus",
          "match": "'(?:[^'\\\\]|\\\\x[0-9A-Fa-f]{2}|\\\\[0-7]{1,3}|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.binary.pengus",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.pengus",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.hex.pengus",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.float.pengus",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9_]+\\b"
        },
        {
          "name": "constant.numeric.integer.pengus",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.pengus",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.pengus",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.none.pengus",
          "match": "\\bmaybe\\s+none\\b"
        },
        {
          "name": "constant.language.error.pengus",
          "match": "\\berror\\b"
        },
        {
          "name": "constant.language.variant.pengus",
          "match": "\\b(ok|err|some)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.pengus",
          "match": "@[A-Za-z_][A-Za-z0-9_]*",
          "captures": {
            "0": {
              "name": "entity.name.function.decorator.pengus"
            }
          }
        }
      ]
    },
    "function_definition": {
      "patterns": [
        {
          "match": "\\b((?:(?:inline|ritual)\\s+)*)(weave|antiquus)(?:\\s+((?:inline|ritual)\\s*))*\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.function.pengus"
            },
            "2": {
              "name": "keyword.declaration.function.pengus"
            },
            "3": {
              "name": "storage.modifier.function.pengus"
            },
            "4": {
              "name": "entity.name.function.pengus"
            }
          }
        },
        {
          "match": "\\b(declare)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.pengus"
            },
            "2": {
              "name": "entity.name.function.declare.pengus"
            }
          }
        },
        {
          "match": "\\b(calling)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.calling.pengus"
            },
            "2": {
              "name": "entity.name.function.call.pengus"
            }
          }
        }
      ]
    },
    "type_definition": {
      "patterns": [
        {
          "match": "\\b(rune|echo|omen|alias|seal|concept)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.pengus"
            },
            "2": {
              "name": "entity.name.type.pengus"
            }
          }
        },
        {
          "match": "\\b(enchanting|bind)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+with\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.pengus"
            },
            "2": {
              "name": "entity.name.type.pengus"
            },
            "3": {
              "name": "entity.name.type.concept.pengus"
            }
          }
        }
      ]
    },
    "test_definition": {
      "patterns": [
        {
          "match": "\\b(test)\\s+(\"[^\"]*\"|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.pengus"
            },
            "2": {
              "name": "entity.name.function.test.pengus"
            }
          }
        }
      ]
    },
    "type_use": {
      "patterns": [
        {
          "match": "\\b(as|of|to|into|shard|where|many|maybe|frozen)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.type.pengus"
            },
            "2": {
              "name": "entity.name.type.pengus"
            }
          }
        },
        {
          "match": "\\b(ref\\s+to|list\\s+of|map\\s+of|result\\s+of)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.pengus"
            },
            "2": {
              "name": "entity.name.type.pengus"
            }
          }
        }
      ]
    },
    "builtin_concepts": {
      "patterns": [
        {
          "name": "support.class.concept.pengus",
          "match": "\\b(Num Integrum Real Par Ordo Vinculum Imago Nexus Forma Iterabilis Donum)\\b"
        }
      ]
    },
    "builtin_types": {
      "patterns": [
        {
          "name": "storage.type.primitive.pengus",
          "match": "\\b(int i8 i16 i32 i64 u8 u16 u32 u64 usize isize byte char float f32 f64 double bool string void opaque any int8 int16 int32 int64 uint uint8 uint16 uint32 uint64 size_t intptr_t uintptr_t ptrdiff_t short ushort long ulong)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.pengus",
          "match": "\\b(import include link ldflag insignia const var let set static weave antiquus declare enchanting rune echo omen alias seal concept bind shard where when test if unless else while for in from to step judge calling with into as is many return break continue defer errdefer banish some ord chr bytes essence sigil transmute size type try defined not and or lambda null true false maybe none error derive cyclus donum inline ritual frozen self)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.accessor.arrow.pengus",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.pengus",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.pengus",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.pengus",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.pengus",
          "match": "\\+|-|\\*|/|%|\\|\\||&&|\\||&|\\^|<<|>>|~|!"
        },
        {
          "name": "punctuation.separator.pengus",
          "match": "[:,]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.pengus",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
