{
  "comments": {
    "lineComment": "#",
    "blockComment": ["##", "##"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "wordPattern": "([A-Za-z_][A-Za-z0-9_]*)|(->)|(\\$[A-Za-z_][A-Za-z0-9_]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(weave|antiquus|enchanting|rune|echo|omen|alias|seal|concept|bind|if|else|unless|while|for|with|judge|when|or|defer|errdefer|test|do)\\b.*:\\s*$",
    "decreaseIndentPattern": "^\\s*(else|when|or)\\b.*:\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*##\\s*$",
      "action": { "indent": "indentOutdent", "appendText": "## " }
    },
    {
      "beforeText": "^\\s*#\\s.*$",
      "action": { "indent": "none", "appendText": "# " }
    },
    {
      "beforeText": ".*:\\s*$",
      "action": { "indent": "indent" }
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*##region\\b",
      "end": "^\\s*##endregion\\b"
    }
  }
}
