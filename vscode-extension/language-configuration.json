{
  "comments": {
    "lineComment": "#",
    "blockComment": ["##", "##"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(weave|enchanting|rune|echo|omen|if|else|unless|while|for|with|judge|when|or).*:\\s*$",
    "decreaseIndentPattern": "^\\s*(else|when).*:\\s*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*##region\\b",
      "end": "^\\s*##endregion\\b"
    }
  }
}
