    ],
    "description": "Import a PenguScript module"
  },
  "Include C Header": {
    "prefix": "include",
    "body": [
      "include \"${1:stdio.h}\"",
      "${0}"
    ],
    "description": "Include an external C header file"
  },
  "Link C Library": {
    "prefix": "link",
    "body": [
      "link \"${1:m}\"",
      "${0}"
    ],
    "description": "Link an external C library"
  },
