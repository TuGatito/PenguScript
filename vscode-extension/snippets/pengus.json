    ],
    "description": "Wrap a value into a present maybe"
  },
  "Do Block Expression": {
    "prefix": "do",
    "description": "Statement block expression (returns the last expression)",
    "body": [
      "do:",
      "    $1",
      "    $0"
    ]
  },
  "If Block Expression": {
    "prefix": "ifx",
    "description": "If/else block expression (each branch must end in a value of a common type)",
    "body": [
      "if ${1:condition}:",
      "    ${2:value}",
      "else:",
      "    ${3:other}",
      "    $0"
    ]
  },
  "Logical and/or": {
    "prefix": "and-or",
    "description": "Boolean condition with and/or (short-circuit)",
    "body": [
      "if ${1:cond_a} ${2|and,or|} ${3:cond_b}:",
      "    ${0}"
    ]
  },
  "Compound assignment": {
    "prefix": "setc",
    "description": "Compound assignment (set x OP value)",
    "body": [
      "set ${1:x} ${2|+=,-=,*=,/=,%=,&=,|=,^=,<<=,>>=|} ${3:value}"
    ]
  },
  "Lambda": {
    "prefix": [
      "lambda",
      "lam"
    ],
    "description": "Lambda expression with one typed parameter",
    "body": [
      "lambda ${1:x as int} into ${2:x * 2}"
    ]
  },
  "Lambda (multi-param)": {
    "prefix": "lambda2",
    "description": "Lambda expression with several typed parameters",
    "body": [
      "lambda ${1:a as int}, ${2:b as int} into ${3:a + b}"
    ]
  },
  "Lambda (typed var)": {
    "prefix": "lambda-var",
    "description": "Bind a lambda to a variable with an explicit fn type",
    "body": [
      "var ${1:f} as weave with ${2:x as int} into ${3:int} is lambda ${2:x as int} into ${4:x * 2}"
    ]
  },
  "If Maybe Binding": {
    "prefix": [
      "ifbind",
      "iflet"
    ],
    "description": "Bind the present value of a maybe inside an if",
    "body": [
      "if ${1:v} as ${2:T} is ${3:opt}:",
      "    ${0}"
    ]
  },
  "Is Present Check": {
    "prefix": "present",
    "description": "Presence test on a maybe value",
    "body": [
      "if ${1:m} is present:",
      "    ${0}"
    ]
  },
  "Owned var": {
    "prefix": "owned",
    "body": [
      "var ${1:name} is ${2:value}"
    ],
    "description": "Owned local (release it with 'banish' or 'defer banish')"
  },
  "Defer banish": {
    "prefix": "deferbanish",
    "body": [
      "defer banish ${1:name}"
    ],
    "description": "Explicit LIFO cleanup of a heap local"
  },
