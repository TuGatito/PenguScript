    ],
    "description": "Declare a variadic function with 'many' parameter"
  },
  "Compile-time when block": {
    "prefix": "when",
    "body": [
      "when ${1:os} == \"${2:windows}\":",
      "    ${3:// active branch}",
      "else:",
      "    ${4:// inactive branch}",
      "    ${0}"
    ],
    "description": "Compile-time conditional statement (when)"
  },
  "Compile-time when expression": {
    "prefix": "when_expr",
    "body": [
      "when ${1:os} == \"${2:windows}\" then ${3:value_a} else ${4:value_b}",
      "${0}"
    ],
    "description": "Compile-time conditional expression"
  },
  "Unit test (string name)": {
    "prefix": "test",
    "body": [
      "test \"${1:does something}\":",
      "    ${2:let result is calling add with 1, 2}",
      "    ${0}"
    ],
    "description": "Integrated unit test block"
  },
  "Unit test (identifier name)": {
    "prefix": "test_name",
    "body": [
      "test ${1:my_test}:",
      "    ${2:calling print with \"test\"}",
      "    ${0}"
    ],
