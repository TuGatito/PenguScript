    ],
    "description": "Raw bitwise memory reinterpretation"
  },
  "Size Of Expression": {
    "prefix": "sizeof",
    "body": [
      "size of ${1:type}"
    ],
    "description": "Get size of a type in bytes (sizeof)"
  },
  "Import Module": {
    "prefix": "import",
    "body": [
