## No asigna.
weave print_lex_help into void:
    calling spark.println with "Usage: psc lex <file> [options]"
    calling spark.println with "  --stdin                 read source from stdin"
    calling spark.println with "  --check                 only diagnostics, no token dump"
    calling spark.println with "  --comments              include comment trivia in the dump"
    calling spark.println with "  --no-indent             omit INDENT/DEDENT tokens"
    calling spark.println with "  --diagnostics=plain|json|json-utf16"
    calling spark.println with "  --color / --no-color"
    calling spark.println with "  --quiet                 suppress the banner (none by default)"
    calling spark.println with "  --help"
