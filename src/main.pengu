## Ayuda de `check`.
##
## ## Memoria
## No asigna.
weave print_check_help into void:
    calling spark.println with "Usage: psc check <file> [options]"
    calling spark.println with "  --stdin                 read source from stdin"
    calling spark.println with "  --diagnostics=plain|json|json-utf16"
    calling spark.println with "  --color / --no-color"
    calling spark.println with "  --max-errors=N          stop after N errors (default 100)"
    calling spark.println with "  --stop-after-first      stop at the first semantic error"
    calling spark.println with "  --base-dir=DIR          project root (default '.')"
    calling spark.println with "  --src-dir=DIR           source directory (default 'src')"
    calling spark.println with "  --lib-dir=DIR           bindings directory (default 'lib')"
    calling spark.println with "  --deny-deprecated       treat W0006 as a failure"
    calling spark.println with "  --help"

