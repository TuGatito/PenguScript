## psc/driver/build.pengu — driver mínimo: F3 + F4 + cc + link.
##
## F5 no cachea, no resuelve dependencias y sólo soporta `pengu.toml` TOML.

import std.archivum
import std.builder
import std.compass
import std.diagnostic as diag
import std.digest
import std.rites
import std.spark

import psc.sema.names as npool
import psc.sema.options as sopts
import psc.sema.api as sema_api
import psc.codegen.api as cgapi
import psc.codegen.options as cgopt
import psc.cache.cache as cache
import psc.driver.manifest as manifest
import psc.os.proc as proc
import psc.driver.paths as paths
import psc.driver.toolchain as toolchain
import psc.pkg.manifest as pman
import psc.pkg.resolve as presolve
import psc.pkg.lock as plock
import psc.pkg.source as psource

insignia psc_driver_build_

## Opciones de build.
##
## ## Memoria
## Strings owned; liberar con `free_options`.
rune BuildOptions:
    target as string
    profile as string
    cc as string
    out_path as string
    verbose as bool
    strict_c99 as bool
    release_unsafe as bool
    is_library as bool
    is_test as bool
    test_json as bool
    bundle_only as bool
    check_only as bool
    no_dce as bool
    prune_types as bool
    no_line_markers as bool
    prune_native as bool
    dce_scope_user as bool
    pch as bool
    compiler_path as string
    no_cache as bool
    clear_cache as bool
    ephemeral as bool
    locked as bool
    frozen as bool
    defines as list of string

## Resultado de un build.
##
## ## Memoria
## Strings owned; liberar con `free_result`.
rune BuildResult:
    ok as bool
    error as string
    artifact as string
    bundle_path as string

## Copia un string.
##
## ## Memoria
## Devuelve string owned.
weave copy with s as string into string:
    return calling npool.copy_string with s

## Libera una lista de strings owned.
##
## ## Memoria
## Libera elementos y lista.
weave free_strings with xs as list of string into void:
    var i as int is 0
    while i < xs.len:
        banish xs at i
        set i is i + 1
    banish xs

## `true` si `s` termina en `suffix`.
##
## ## Memoria
## O(suffix); no asigna.
weave ends_with with s as string, suffix as string into bool:
    var n as int is s length
    var m as int is suffix length
    if m > n:
        return false
    var sb as ref to frozen byte is bytes of s
    var pb as ref to frozen byte is bytes of suffix
    var i as int is 0
    while i < m:
        if ((sb at (n - m + i)) to int) != ((pb at i) to int):
            return false
        set i is i + 1
    return true

## Directorio actual.
##
## ## Memoria
## Devuelve string owned.
weave current_dir into string:
    var d as maybe string is calling rites.getcwd
    if d.is_present:
        return d.value
    banish d
    return "."

## Busca el directorio con `pengu.toml` subiendo desde `start`.
##
## ## Memoria
## Devuelve string owned o `""`.
weave find_manifest_root with start as string into string:
    var normalized as string is calling compass.cp_normalize with start
    var nb as ref to frozen byte is bytes of normalized
    if normalized length == 0 or ((nb at 0) to int) != 47:
        var cw as maybe string is calling rites.getcwd
        if cw.is_present:
            var cws as string is calling npool.copy_string with cw.value
            var full as string is "{cws}/{start}"
            banish cws
            banish cw.value
            banish cw
            banish normalized
            set normalized is full
        else:
            banish cw
    var d as string is calling copy with normalized
    var i as int is 0
    while i < 8:
        var f as string is "{d}/pengu.toml"
        if calling archivum.is_file with f:
            banish f
            return calling npool.copy_string with d
        banish f
        var parent as string is calling compass.cp_dirname with d
        if parent == d:
            banish parent
            banish d
            return ""
        set d is parent
        set i is i + 1
    return ""

## Opciones por defecto.
##
## ## Memoria
## Strings owned; liberar con `free_options`.
weave default_options into BuildOptions:
    return with target is "", profile is (calling copy with "debug"), cc is "", out_path is "", verbose is false, strict_c99 is false, release_unsafe is false, is_library is false, is_test is false, test_json is false, bundle_only is false, check_only is false, no_dce is false, prune_types is false, no_line_markers is false, prune_native is false, dce_scope_user is false, pch is false, compiler_path is "", no_cache is false, clear_cache is false, ephemeral is false, locked is false, frozen is false, defines is list of string

## Libera opciones.
##
## ## Memoria
## Libera strings.
weave free_options with o as ref to BuildOptions into void:
    banish o->target
    banish o->profile
    banish o->cc
    banish o->out_path
    banish o->compiler_path
    var oi as int is 0
    while oi < o->defines.len:
        banish o->defines at oi
        set oi is oi + 1
    banish o->defines

## Libera un resultado.
##
## ## Memoria
## Libera strings.
weave free_result with r as ref to BuildResult into void:
    banish r->error
    banish r->artifact
    banish r->bundle_path

## Construye un proyecto o un archivo.
##
## ## Memoria
## Devuelve BuildResult owned; liberar con `free_result`.
weave build with o as BuildOptions into BuildResult:
    var cwd as string is calling current_dir
    var is_project as bool is false
    if o.clear_cache:
        var cache_ignored as int is calling cache.clear
    var target as string is calling copy with o.target
    var start as string is calling copy with cwd
    var is_file as bool is false
    if target length > 0:
        if (calling ends_with with target, ".pengu") or (calling archivum.is_file with target):
            set is_file is true
            var tabs as string is calling compass.cp_absolute with target
            var td as string is calling compass.cp_dirname with tabs
            banish tabs
            banish start
            set start is td
        else:
            var ts as string is calling copy with target
            banish start
            set start is ts
    var root as string is calling find_manifest_root with start
    set is_project is calling archivum.is_dir with target
    var base as string is root
    var man as manifest.Manifest is calling manifest.default_manifest with start, "main.pengu"
    if root length == 0:
        set base is start
    if root length > 0:
        calling manifest.free_manifest with (sigil of man)
        set man is calling manifest.load_manifest with root, o.profile
        set base is man.base_dir
    else if not is_file:
        var leg as string is calling pman.legacy_manifest with start
        if leg length > 0:
            var lm2 as string is "only pengu.toml is supported; found {leg}. YAML/JSON manifests are no longer accepted."
            banish leg
            banish cwd
            banish target
            banish start
            banish root
            return with ok is false, error is lm2, artifact is "", bundle_path is ""
        banish leg
        banish cwd
        banish target
        banish start
        banish root
        return with ok is false, error is (calling copy with "no pengu.toml found; pass a file or a project directory"), artifact is "", bundle_path is ""
    if not man.ok:
        var emsg as string is man.error
        banish cwd
        banish target
        banish start
        banish root
        return with ok is false, error is emsg, artifact is "", bundle_path is ""
    var entry as string is ""
    if is_file:
        set entry is calling compass.cp_absolute with target
    else:
        var e0 as string is "{base}/{man.entry}"
        set entry is calling compass.cp_absolute with e0
        banish e0
    if not calling archivum.is_file with entry:
        var emsg2 as string is "entry file not found: {entry}"
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling manifest.free_manifest with (sigil of man)
        return with ok is false, error is emsg2, artifact is "", bundle_path is ""
    var p as paths.Paths is calling paths.find_paths with base
    if not p.ok and not o.check_only:
        var perr as string is p.error
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        return with ok is false, error is perr, artifact is "", bundle_path is ""
    var tc as toolchain.Toolchain is calling toolchain.resolve with (sigil of man), (sigil of p), o.cc, o.profile, o.strict_c99, o.release_unsafe
    if o.verbose:
        var pdbg as string is "paths: archive={p.runtime_archive} include={p.runtime_include} stds={p.std_dirs.len} incs={tc.include_dirs.len} libs={tc.lib_dirs.len}"
        calling spark.eprintln with pdbg
        banish pdbg
    if not tc.ok and not o.check_only:
        var terr as string is tc.error
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is false, error is terr, artifact is "", bundle_path is ""
    # F3: opciones propias, sin compartir ownership con Manifest/Paths.
    var so as sopts.SemaOptions is calling sopts.default_options with (calling copy with man.base_dir)
    banish so.src_dir
    set so.src_dir is (calling copy with man.src_dir)
    banish so.lib_dir
    set so.lib_dir is (calling copy with man.lib_dir)
    var si as int is 0
    while si < p.std_dirs.len:
        calling so.std_dirs.push with (calling copy with (p.std_dirs at si))
        set si is si + 1
    var di as int is 0
    while di < man.defines.len:
        calling so.defines.push with (calling copy with (man.defines at di))
        set di is di + 1
    var doi as int is 0
    while doi < o.defines.len:
        calling so.defines.push with (calling copy with (o.defines at doi))
        set doi is doi + 1
    var dep_ds as list of pman.Dependency is calling pman.load with base
    if dep_ds.len > 0:
        if o.frozen:
            for vd in dep_ds:
                var vt as string is "{base}/{man.lib_dir}/{vd.name}"
                if not calling archivum.is_dir with vt:
                    var vv as string is "{base}/vendor/{vd.name}"
                    if calling archivum.is_dir with vv:
                        var vr as bool is calling psource.copy_local with vv, vt
                    banish vv
                if not calling archivum.is_dir with vt:
                    banish vt
                    banish dep_ds
                    calling manifest.free_manifest with (sigil of man)
                    calling paths.free_paths with (sigil of p)
                    calling toolchain.free_toolchain with (sigil of tc)
                    return with ok is false, error is "E0061: dependency missing and --frozen forbids network/install", artifact is "", bundle_path is ""
                banish vt
        var g as presolve.Graph is calling presolve.resolve with base, man.lib_dir, dep_ds
        if not g.ok:
            var ge as string is g.error
            calling spark.eprintln with ge
            banish ge
            banish dep_ds
            calling manifest.free_manifest with (sigil of man)
            calling paths.free_paths with (sigil of p)
            calling toolchain.free_toolchain with (sigil of tc)
            return with ok is false, error is "dependencies", artifact is "", bundle_path is ""
        if o.locked or o.frozen:
            var lm as maybe plock.Lock is calling plock.read with base
            if not lm.is_present:
                banish lm
                banish dep_ds
                calling manifest.free_manifest with (sigil of man)
                calling paths.free_paths with (sigil of p)
                calling toolchain.free_toolchain with (sigil of tc)
                return with ok is false, error is "E0061: pengu.lock missing (--locked/--frozen)", artifact is "", bundle_path is ""
            var bad as bool is false
            for gp in g.packages:
                var found as bool is false
                for lp in lm.value.packages:
                    if lp.name == gp.name:
                        set found is true
                        if lp.version != gp.version or lp.commit != gp.commit or lp.sha256 != gp.sha256:
                            set bad is true
                if not found:
                    set bad is true
            if bad:
                banish lm
                banish dep_ds
                calling manifest.free_manifest with (sigil of man)
                calling paths.free_paths with (sigil of p)
                calling toolchain.free_toolchain with (sigil of tc)
                return with ok is false, error is "E0061: pengu.lock is out of date (--locked/--frozen)", artifact is "", bundle_path is ""
            banish lm
        else:
            var lk as plock.Lock is with target is "x86_64-unknown-linux-gnu", packages is list of plock.Package
            for gp2 in g.packages:
                calling lk.packages.push with gp2
            var lw as bool is calling plock.write with base, lk
        for gp in g.packages:
            var dsrc as string is "{base}/{man.lib_dir}/{gp.name}/src"
            var dsd as bool is calling archivum.is_dir with dsrc
            if dsd:
                calling so.dep_dirs.push with (calling copy with dsrc)
            var dinc as string is "{base}/{man.lib_dir}/{gp.name}/include"
            if calling archivum.is_dir with dinc:
                calling tc.include_dirs.push with (calling copy with dinc)
            banish dsrc
            banish dinc
    var ccn as string is calling compass.cp_basename with tc.cc
    banish so.compiler
    set so.compiler is (calling copy with ccn)
    banish ccn
    var sr as sema_api.SemaResult is calling sema_api.check_file with entry, so
    # Los módulos pueden declarar `link "name"` (p. ej. std.dynlib → dl,
    # std.ffi_call → ffi). Se añaden al toolchain antes de enlazar, sin exigir
    # que el manifiesto del proyecto los repita.
    for ml in sr.program->symbols.links:
        var already as bool is false
        for tl in tc.links:
            if tl == ml:
                set already is true
        if not already:
            calling tc.links.push with (calling copy with ml)
    var bag_ref as ref to diag.DiagnosticBag is (sigil of sr.program->diagnostics)
    var bag_v as diag.DiagnosticBag is sr.program->diagnostics
    if not sr.ok or bag_ref->error_count > 0:
        var rendered as string is calling bag_v.render_plain
        calling spark.eprint with rendered
        banish rendered
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling sema_api.free_result with (sigil of sr)
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is false, error is (calling copy with "semantic errors"), artifact is "", bundle_path is ""
    if o.check_only:
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling sema_api.free_result with (sigil of sr)
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is true, error is "", artifact is "", bundle_path is ""
    var cgo as cgopt.CgOptions is calling cgopt.default_options with (calling copy with base)
    set cgo.entry_file is (calling copy with entry)
    set cgo.is_library is o.is_library or (man.output != "exe" and man.output != "c")
    set cgo.is_test is o.is_test
    set cgo.test_json is o.test_json
    set cgo.line_markers is not o.no_line_markers
    set cgo.dce is not o.no_dce
    set cgo.prune_types is o.prune_types
    set cgo.prune_native is o.prune_native
    set cgo.dce_scope_user is o.dce_scope_user
    set cgo.strict_c99 is o.strict_c99
    set cgo.release_unsafe is o.release_unsafe
    set cgo.os_name is so.os_name
    set cgo.arch is so.arch
    set cgo.target_compiler is (calling copy with (calling compass.cp_basename with tc.cc))
    var all_defs as list of string is list of string
    var adi as int is 0
    while adi < man.defines.len:
        calling all_defs.push with (calling copy with (man.defines at adi))
        set adi is adi + 1
    var ado as int is 0
    while ado < o.defines.len:
        calling all_defs.push with (calling copy with (o.defines at ado))
        set ado is ado + 1
    set cgo.defines is all_defs
    var cr is calling cgapi.generate_c with sr.program, cgo
    if not cr.ok:
        calling spark.eprintln with "code generation failed"
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling cgapi.free_result with (sigil of cr)
        calling sema_api.free_result with (sigil of sr)
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is false, error is (calling copy with "code generation failed"), artifact is "", bundle_path is ""
    var build_dir as string is "{base}/{man.build_dir}"
    if not calling archivum.create_dir with build_dir, true:
        var bderr as string is "cannot create build directory: {build_dir}"
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        banish build_dir
        calling cgapi.free_result with (sigil of cr)
        calling sema_api.free_result with (sigil of sr)
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is false, error is bderr, artifact is "", bundle_path is ""
    var bundle as string is "{build_dir}/bundle.c"
    if not calling archivum.write_text with bundle, cr.bundle:
        var wberr as string is "cannot write bundle: {bundle}"
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        banish build_dir
        banish bundle
        calling cgapi.free_result with (sigil of cr)
        calling sema_api.free_result with (sigil of sr)
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is false, error is wberr, artifact is "", bundle_path is ""
    if o.bundle_only or man.output == "c":
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        banish build_dir
        calling cgapi.free_result with (sigil of cr)
        calling sema_api.free_result with (sigil of sr)
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is true, error is "", artifact is bundle, bundle_path is (calling copy with bundle)
    var artifact as string is ""
    var out_kind as string is man.output
    var out_name as string is man.output_name
    if is_file:
        var stem as string is calling compass.cp_stem with entry
        set out_name is stem
    if o.is_test:
        set out_name is "{out_name}_test"
    if o.out_path length > 0:
        set artifact is calling compass.cp_absolute with o.out_path
    else:
        if out_kind == "obj":
            set artifact is "{build_dir}/{out_name}.o"
        else if out_kind == "static":
            set artifact is "{build_dir}/lib{out_name}.a"
        else if out_kind == "shared":
            set artifact is "{build_dir}/lib{out_name}.so"
        else:
            set artifact is "{build_dir}/{out_name}"
    var adir as string is calling compass.cp_dirname with artifact
    if adir length > 0:
        calling archivum.create_dir with adir, true
    banish adir
    var ck as string is ""
    var cparts as list of string is list of string
    if (not o.no_cache) and (not o.ephemeral) and (not o.check_only) and (not o.bundle_only) and man.output != "c":
        var cbytes as maybe string is calling archivum.read_bytes with o.compiler_path
        if cbytes.is_present:
            var chash as string is calling digest.sha256_raw with cbytes.value
            calling cparts.push with chash
        else:
            calling cparts.push with (calling copy with o.compiler_path)
        banish cbytes
        calling cparts.push with "psc-0.8.0"
        calling cparts.push with (calling copy with o.profile)
        calling cparts.push with (calling copy with o.cc)
        calling cparts.push with (calling copy with man.output)
        calling cparts.push with "test"
        if o.is_test:
            calling cparts.push with "1"
        else:
            calling cparts.push with "0"
        if o.test_json:
            calling cparts.push with "json"
        else:
            calling cparts.push with "plain"
        if o.strict_c99:
            calling cparts.push with "strict"
        if o.release_unsafe:
            calling cparts.push with "unsafe"
        if o.no_dce:
            calling cparts.push with "nodce"
        if o.dce_scope_user:
            calling cparts.push with "userdce"
        if o.prune_types:
            calling cparts.push with "prunetypes"
        if o.prune_native:
            calling cparts.push with "prunenative"
        if o.no_line_markers:
            calling cparts.push with "nolines"
        var mdi as int is 0
        while mdi < man.defines.len:
            calling cparts.push with (calling copy with (man.defines at mdi))
            set mdi is mdi + 1
        var dfi as int is 0
        while dfi < o.defines.len:
            calling cparts.push with (calling copy with (o.defines at dfi))
            set dfi is dfi + 1
        var mi as int is 0
        while mi < sr.program->modules.len:
            var mm as loader.SemaModule is (sr.program->modules at mi)
            calling cparts.push with (calling copy with mm.source.path)
            calling cparts.push with (calling copy with mm.source.text)
            set mi is mi + 1
        set ck is calling cache.key with cparts
        var hit as string is calling cache.get with ck
        if hit length > 0:
            var cok as bool is calling archivum.copy_file with hit, artifact, true
            if cok:
                var cargsx as list of string is list of string
                calling cargsx.push with "chmod"
                calling cargsx.push with "+x"
                calling cargsx.push with (calling copy with artifact)
                var chx as int is calling proc.run_argv with cargsx
                calling free_strings with cargsx
                banish hit
                banish ck
                var hci2 as int is 0
                while hci2 < cparts.len:
                    banish cparts at hci2
                    set hci2 is hci2 + 1
                banish cparts
                banish cwd
                banish target
                banish start
                banish root
                banish entry
                banish build_dir
                banish bundle
                calling cgapi.free_result with (sigil of cr)
                calling sema_api.free_result with (sigil of sr)
                calling manifest.free_manifest with (sigil of man)
                calling paths.free_paths with (sigil of p)
                calling toolchain.free_toolchain with (sigil of tc)
                return with ok is true, error is "", artifact is artifact, bundle_path is bundle
            banish hit
    var objpath as string is calling copy with artifact
    if out_kind == "static":
        banish objpath
        set objpath is "{build_dir}/{out_name}.o"
    var args as list of string is list of string
    for f in tc.cflags:
        calling args.push with (calling copy with f)
    for inc in tc.include_dirs:
        calling args.push with "-I{inc}"
    calling args.push with (calling copy with bundle)
    var glue as list of string is list of string
    if is_project:
        var cdir as string is "{base}/{man.c_dir}"
        var cfiles as list of string is calling archivum.find_files with cdir, false
        for cf in cfiles:
            if (calling ends_with with cf, ".c"):
                calling glue.push with (calling copy with cf)
            banish cf
        banish cfiles
        var bfiles as list of string is calling archivum.find_files with build_dir, false
        for bf in bfiles:
            if calling ends_with with bf, "_assets.c":
                calling glue.push with (calling copy with bf)
            banish bf
        banish bfiles
    if out_kind != "obj" and out_kind != "static":
        for gf in glue:
            calling args.push with (calling copy with gf)
    if out_kind == "obj" or out_kind == "static":
        calling args.push with "-c"
        calling args.push with "-fPIC"
    if out_kind == "shared":
        calling args.push with "-shared"
        calling args.push with "-fPIC"
    if out_kind == "exe":
        for ld in tc.lib_dirs:
            calling args.push with "-L{ld}"
        for lk in tc.links:
            if lk == "pengu_runtime" or lk == "libpengu_runtime":
                calling args.push with "-lpengu_runtime"
            else:
                calling args.push with "-l{lk}"
        if so.os_name == "windows":
            calling args.push with "-lm"
            calling args.push with "-lws2_32"
            calling args.push with "-lwinpthread"
        else:
            calling args.push with "-lm"
            calling args.push with "-pthread"
            calling args.push with "-ldl"
    calling args.push with "-o"
    calling args.push with (calling copy with objpath)
    if o.verbose:
        var cmdline as string is tc.cc
        for a in args:
            set cmdline is "{cmdline} {a}"
        var vmsg as string is "cc: {cmdline}"
        calling spark.eprintln with vmsg
        banish vmsg
        banish cmdline
    var cc_argv as list of string is list of string
    calling cc_argv.push with (calling copy with tc.cc)
    for ca in args:
        calling cc_argv.push with ca
    var cc_code as int is calling proc.run_argv with cc_argv
    banish cc_argv
    if cc_code != 0:
        calling spark.eprintln with "C compiler failed"
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        banish build_dir
        banish bundle
        banish artifact
        calling free_strings with glue
        calling free_strings with args
        calling cgapi.free_result with (sigil of cr)
        calling sema_api.free_result with (sigil of sr)
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is false, error is (calling copy with "C compilation failed"), artifact is "", bundle_path is ""
    if out_kind == "static":
        var ar_args as list of string is list of string
        calling ar_args.push with "ar"
        calling ar_args.push with "rcs"
        calling ar_args.push with (calling copy with artifact)
        calling ar_args.push with (calling copy with objpath)
        var ar_code as int is calling proc.run_argv with ar_args
        calling free_strings with ar_args
        if ar_code != 0:
            calling spark.eprintln with "ar failed"
            banish objpath
            banish cwd
            banish target
            banish start
            banish root
            banish entry
            banish build_dir
            banish bundle
            banish artifact
            calling free_strings with glue
            calling free_strings with args
            calling cgapi.free_result with (sigil of cr)
            calling sema_api.free_result with (sigil of sr)
            calling manifest.free_manifest with (sigil of man)
            calling paths.free_paths with (sigil of p)
            calling toolchain.free_toolchain with (sigil of tc)
            return with ok is false, error is (calling copy with "ar failed"), artifact is "", bundle_path is ""
    if ck length > 0:
        var storedx as bool is calling cache.put with ck, artifact
    banish ck
    var cpi as int is 0
    while cpi < cparts.len:
        banish cparts at cpi
        set cpi is cpi + 1
    banish cparts
    banish cwd
    banish target
    banish start
    banish root
    banish entry
    banish build_dir
    banish objpath
    calling free_strings with glue
    calling free_strings with args
    calling cgapi.free_result with (sigil of cr)
    calling sema_api.free_result with (sigil of sr)
    calling manifest.free_manifest with (sigil of man)
    calling paths.free_paths with (sigil of p)
    calling toolchain.free_toolchain with (sigil of tc)
    return with ok is true, error is "", artifact is artifact, bundle_path is bundle
