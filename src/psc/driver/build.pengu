## psc/driver/build.pengu — driver mínimo: F3 + F4 + cc + link.
##
## F5 no cachea, no resuelve dependencias y sólo soporta `pengu.toml` TOML.

import std.archivum
import std.builder
import std.chronicle
import std.compass
import std.diagnostic as diag
import std.digest
import std.rites
import std.spark

import psc.sema.names as npool
import psc.sema.options as sopts
import psc.sema.api as sema_api
import psc.sema.modules.program as program
import psc.sema.modules.loader as loader
import psc.codegen.api as cgapi
import psc.codegen.options as cgopt
import psc.cache.cache as cache
import psc.driver.manifest as manifest
import psc.os.proc as proc
import psc.driver.paths as paths
import psc.driver.target as targetmod
import psc.driver.toolchain as toolchain
import psc.pkg.manifest as pman
import psc.pkg.resolve as presolve
import psc.pkg.lock as plock
import psc.pkg.source as psource
import psc.pkg.install as pinstall

insignia psc_driver_build_

## Opciones de build.
##
## ## Memoria
## Strings owned; liberar con `free_options`.
rune BuildOptions:
    target as string
    ## Plataforma de compilación (host o wasm).
    platform as targetmod.Target
    ## `true` si `--target` vino explícito (el manifiesto no debe pisarlo).
    target_explicit as bool
    profile as string
    cc as string
    out_path as string
    verbose as bool
    strict_c99 as bool
    ## `psc check --lint=cow`: activa `W0008` durante la comprobación.
    lint_cow as bool
    lint_shadow as bool
    ## `true` deja los contenedores con la copia de handle de 0.51 (escape).
    legacy_copy as bool
    release_unsafe as bool
    is_library as bool
    is_test as bool
    test_json as bool
    bundle_only as bool
    check_only as bool
    no_dce as bool
    prune_types as bool
    no_line_markers as bool
    prune_native as bool
    dce_scope_user as bool
    pch as bool
    compiler_path as string
    no_cache as bool
    clear_cache as bool
    ephemeral as bool
    locked as bool
    frozen as bool
    ## `psc run`/`psc test` sobre un proyecto de librería: fuerza `exe`.
    force_exe as bool
    ## Instrumenta con `--coverage` (gcov) y conserva `.gcno/.gcda`.
    coverage as bool
    ## Perfil de sanitizer: 0=none, 1=address, 2=undefined, 3=thread.
    sanitize_kind as int
    ## Emite una unidad C por módulo y las compila por separado (F7).
    split as bool
    ## Número máximo de compilaciones C en paralelo (0 = secuencial).
    jobs as int
    defines as list of string

## Resultado de un build.
##
## ## Memoria
## Strings owned; liberar con `free_result`.
rune BuildResult:
    ok as bool
    error as string
    artifact as string
    bundle_path as string
    ## Target resuelto (manifiesto o CLI): `psc run`/`psc test` lo necesitan
    ## para ejecutar un artefacto wasm como wasm aunque el host sea nativo.
    is_wasm as bool

## Copia un string.
##
## ## Memoria
## Devuelve string owned.
weave copy with s as string into string:
    return calling npool.copy_string with s

## Libera una lista de strings owned.
##
## ## Memoria
## Libera elementos y lista.
weave free_strings with xs as list of string into void:
    var i as int is 0
    while i < xs.len:
        banish xs at i
        set i is i + 1
    banish xs

## `true` si `s` termina en `suffix`.
##
## ## Memoria
## O(suffix); no asigna.
weave ends_with with s as string, suffix as string into bool:
    var n as int is s length
    var m as int is suffix length
    if m > n:
        return false
    var sb as ref to frozen byte is bytes of s
    var pb as ref to frozen byte is bytes of suffix
    var i as int is 0
    while i < m:
        if ((sb at (n - m + i)) to int) != ((pb at i) to int):
            return false
        set i is i + 1
    return true

## Compara dos strings por bytes (orden lexicográfico sin locale).
##
## ## Memoria
## No asigna.
weave str_cmp with a as string, b as string into int:
    var ab as ref to frozen byte is bytes of a
    var bb as ref to frozen byte is bytes of b
    var n as int is a length
    if (b length) < n:
        set n is b length
    var i as int is 0
    while i < n:
        var ca as int is (ab at i) to int
        var cb as int is (bb at i) to int
        if ca < cb:
            return -1
        if ca > cb:
            return 1
        set i is i + 1
    if (a length) < (b length):
        return -1
    if (a length) > (b length):
        return 1
    return 0

## `true` si `s` empieza por `prefix`.
##
## ## Memoria
## No asigna.
weave str_starts with s as string, prefix as string into bool:
    var m as int is prefix length
    if m > (s length):
        return false
    var sb as ref to frozen byte is bytes of s
    var pb as ref to frozen byte is bytes of prefix
    var i as int is 0
    while i < m:
        if ((sb at i) to int) != ((pb at i) to int):
            return false
        set i is i + 1
    return true

## `true` si `s` contiene `needle`.
##
## ## Memoria
## No asigna.
weave str_contains with s as string, needle as string into bool:
    var n as int is s length
    var m as int is needle length
    if m == 0:
        return true
    if m > n:
        return false
    var sb as ref to frozen byte is bytes of s
    var nb as ref to frozen byte is bytes of needle
    var i as int is 0
    while i <= n - m:
        var j as int is 0
        var same as bool is true
        while j < m:
            if ((sb at (i + j)) to int) != ((nb at j) to int):
                set same is false
                break
            set j is j + 1
        if same:
            return true
        set i is i + 1
    return false

## Ordena una lista de strings in place (inserción estable).
##
## La clave de caché debe ser determinista: `find_files` devuelve el orden del
## sistema de archivos, que cambia entre ejecuciones y plataformas.
##
## ## Memoria
## No copia ni libera strings; mueve las celdas de la lista.
weave sort_strings_in_place with xs as list of string into void:
    var i as int is 1
    while i < xs.len:
        var cur as string is (xs at i)
        var j as int is i - 1
        while j >= 0:
            if (calling str_cmp with (xs at j), cur) <= 0:
                break
            set xs at (j + 1) is (xs at j)
            set j is j - 1
        set xs at (j + 1) is cur
        set i is i + 1

## `true` si la extensión de `path` está en la familia `mode`.
##
## Modos: `pengu` (.pengu), `c` (.c/.h/.hpp/.inc), `h` (.h/.hpp/.inc),
## `all` (cualquier archivo).
##
## ## Memoria
## Libera la extensión temporal.
weave ext_allowed with path as string, mode as string into bool:
    if mode == "all":
        return true
    var ex as string is calling compass.cp_ext with path
    var ok as bool is false
    if mode == "pengu":
        set ok is ex == ".pengu"
    else if mode == "c":
        set ok is ex == ".c" or ex == ".h" or ex == ".hpp" or ex == ".inc"
    else if mode == "h":
        set ok is ex == ".h" or ex == ".hpp" or ex == ".inc"
    banish ex
    return ok

## `true` si `dir` ya se hasheó (dedup de std/include dirs).
##
## ## Memoria
## No asigna.
weave seen_has with seen as ref to list of string, dir as string into bool:
    var i as int is 0
    while i < seen->len:
        if (seen at i) == dir:
            return true
        set i is i + 1
    return false

## Añade a `cparts` el path y el hash de cada archivo de `dir`.
##
## `mode` filtra por extensión; `skip` es el directorio de build del proyecto
## (nunca entra en la clave). Los archivos se ordenan para que la clave sea
## determinista. `seen` deduplica directorios ya hasheados en la misma clave.
##
## ## Memoria
## Libera la lista de archivos y los hashes temporales.
weave push_tree_hashes with cparts as ref to list of string, dir as string, mode as string, skip as string, seen as ref to list of string into void:
    if dir length == 0:
        return
    if not (calling archivum.is_dir with dir):
        return
    if calling seen_has with seen, dir:
        return
    calling seen.push with (calling copy with dir)
    var files as list of string is calling archivum.find_files with dir, true
    calling sort_strings_in_place with files
    var i as int is 0
    while i < files.len:
        var f as string is (files at i)
        var excluded as bool is false
        if skip length > 0:
            if calling str_starts with f, skip:
                set excluded is true
        if (not excluded) and (calling str_contains with f, "/.git/"):
            set excluded is true
        if (not excluded) and (calling str_contains with f, "/node_modules/"):
            set excluded is true
        if (not excluded) and (calling str_contains with f, "/.cache/"):
            set excluded is true
        if excluded or (not (calling ext_allowed with f, mode)):
            set i is i + 1
            continue
        calling cparts.push with (calling copy with f)
        var h as maybe string is calling digest.sha256_file with f
        if h.is_present:
            calling cparts.push with h.value
        banish h
        set i is i + 1
    banish files

## Añade a la clave el hash de un archivo suelto (manifest, lock, runtime).
##
## ## Memoria
## Libera el hash temporal.
weave push_file_hash with cparts as ref to list of string, path as string into void:
    if not (calling archivum.is_file with path):
        return
    calling cparts.push with (calling copy with path)
    var h as maybe string is calling digest.sha256_file with path
    if h.is_present:
        calling cparts.push with h.value
    banish h

## `true` si dos archivos tienen el mismo contenido.
##
## Se usa cuando copiar la entrada de caché falla porque el destino es el
## binario que se está ejecutando (`ETXTBSY`): en ese caso el artefacto ya es
## el deseado y el build es un no-op.
##
## ## Memoria
## Libera las lecturas temporales.
weave same_file_content with a as string, b as string into bool:
    var ab as maybe string is calling archivum.read_bytes with a
    var bb as maybe string is calling archivum.read_bytes with b
    var same as bool is false
    if ab.is_present and bb.is_present:
        var ah as string is calling digest.sha256_raw with ab.value
        var bh as string is calling digest.sha256_raw with bb.value
        set same is ah == bh
        banish ah
        banish bh
    banish ab
    banish bb
    return same

## Construye la clave de caché ANTES de sema/codegen.
##
## La clave incluye todo lo que puede cambiar el artefacto: compilador, target,
## flags del manifiesto y del CLI (incluidos `cflags`, `links`, `lib_dirs`), el
## runtime, el manifiesto, el lock y el contenido de todos los árboles de
## fuentes (proyecto, dependencias y stdlib). El directorio de build queda
## excluido: sus artefactos no son entradas.
##
## ## Memoria
## Devuelve string owned; libera todas las partes temporales.
weave compute_cache_key with o as ref to BuildOptions, man as ref to Manifest, p as ref to paths.Paths, tc as ref to toolchain.Toolchain, eff as ref to target.Target, base as string, entry as string, is_project as bool, is_file as bool, eff_output as string, out_name as string, dep_dirs as list of string into string:
    var parts as list of string is list of string
    var cbytes as maybe string is calling archivum.read_bytes with o->compiler_path
    if cbytes.is_present:
        var ch as string is calling digest.sha256_hex with cbytes.value
        calling parts.push with ch
    else:
        calling parts.push with (calling copy with o->compiler_path)
    banish cbytes
    calling parts.push with "psc-cache-2"
    calling parts.push with (calling copy with eff->triple)
    calling parts.push with (calling copy with eff->wasm_target)
    calling parts.push with (calling copy with eff->os)
    calling parts.push with (calling copy with eff->arch)
    calling parts.push with (calling copy with tc->cc)
    calling parts.push with (calling copy with o->profile)
    calling parts.push with (calling copy with o->cc)
    calling parts.push with (calling copy with eff_output)
    calling parts.push with (calling copy with out_name)
    calling parts.push with (calling copy with man->output)
    calling parts.push with (calling copy with man->target)
    calling parts.push with (calling copy with man->name)
    if o->is_test:
        calling parts.push with "test"
    else:
        calling parts.push with "app"
    if o->test_json:
        calling parts.push with "json"
    else:
        calling parts.push with "plain"
    if o->strict_c99:
        calling parts.push with "strict"
    if o->release_unsafe:
        calling parts.push with "unsafe"
    if o->no_dce:
        calling parts.push with "nodce"
    if o->dce_scope_user:
        calling parts.push with "userdce"
    if o->prune_types:
        calling parts.push with "prunetypes"
    if o->prune_native:
        calling parts.push with "prunenative"
    if o->no_line_markers:
        calling parts.push with "nolines"
    if o->force_exe:
        calling parts.push with "forceexe"
    if o->coverage:
        calling parts.push with "coverage"
    if o->split:
        calling parts.push with "split"
    if o->sanitize_kind == 1:
        calling parts.push with "san1"
    else if o->sanitize_kind == 2:
        calling parts.push with "san2"
    else if o->sanitize_kind == 3:
        calling parts.push with "san3"
    if is_file:
        calling parts.push with "file"
    if man->assets_embed:
        calling parts.push with "assets-embed"
    # Flags del toolchain: antes faltaban y un `-D` nuevo reutilizaba el
    # binario viejo (bug de caché observado en --frozen/sanitizers).
    for f in tc->cflags:
        calling parts.push with (calling copy with f)
    for d in tc->links:
        calling parts.push with (calling copy with d)
    for d in tc->lib_dirs:
        calling parts.push with (calling copy with d)
    for d in man->ldflags:
        calling parts.push with (calling copy with d)
    var skip as string is "{base}/{man->build_dir}"
    calling push_file_hash with (sigil of parts), "{base}/pengu.toml"
    calling push_file_hash with (sigil of parts), "{base}/pengu.lock"
    calling push_file_hash with (sigil of parts), entry
    var seen as list of string is list of string
    if is_project:
        calling push_tree_hashes with (sigil of parts), "{base}/{man->src_dir}", "pengu", skip, (sigil of seen)
        calling push_tree_hashes with (sigil of parts), "{base}/{man->lib_dir}", "pengu", skip, (sigil of seen)
        calling push_tree_hashes with (sigil of parts), "{base}/{man->c_dir}", "c", skip, (sigil of seen)
        calling push_tree_hashes with (sigil of parts), "{base}/{man->include_dir}", "c", skip, (sigil of seen)
        calling push_tree_hashes with (sigil of parts), "{base}/{man->assets_dir}", "all", skip, (sigil of seen)
    else:
        var fdir as string is calling compass.cp_dirname with entry
        calling push_tree_hashes with (sigil of parts), fdir, "pengu", skip, (sigil of seen)
        banish fdir
    var di as int is 0
    while di < dep_dirs.len:
        calling push_tree_hashes with (sigil of parts), (dep_dirs at di), "pengu", skip, (sigil of seen)
        set di is di + 1
    var si as int is 0
    while si < p->std_dirs.len:
        calling push_tree_hashes with (sigil of parts), (p->std_dirs at si), "pengu", skip, (sigil of seen)
        set si is si + 1
    # Includes: path (orden de búsqueda) + headers. El build dir se excluye
    # por completo: existe o no según la fase en que se consulte la caché y su
    # contenido es salida, no entrada.
    var bskip as bool is false
    var ii as int is 0
    while ii < tc->include_dirs.len:
        var inc as string is (tc->include_dirs at ii)
        set bskip is inc == skip
        if (not bskip) and (skip length > 0) and (inc length > skip length) and (calling str_starts with inc, skip):
            set bskip is true
        if not bskip:
            calling parts.push with (calling copy with inc)
            calling push_tree_hashes with (sigil of parts), inc, "h", skip, (sigil of seen)
        set ii is ii + 1
    banish bskip
    calling push_file_hash with (sigil of parts), p->runtime_archive
    calling push_file_hash with (sigil of parts), p->wasm_shell
    calling push_file_hash with (sigil of parts), p->js_library
    calling push_file_hash with (sigil of parts), p->js_pre
    var ck as string is calling cache.key with parts
    var ci as int is 0
    while ci < parts.len:
        banish parts at ci
        set ci is ci + 1
    banish parts
    var se as int is 0
    while se < seen.len:
        banish seen at se
        set se is se + 1
    banish seen
    banish skip
    return ck

## Fingerprints `ruta\tsha256` de los módulos semánticos.
##
## Se guardan en el build dir para explicar, con `--verbose`, qué módulo
## invalidó la caché entre dos builds. No forman parte de la clave: la clave
## ya hashea cada fuente; esto solo mejora el diagnóstico.
##
## ## Memoria
## Devuelve una lista owned.
weave module_fingerprints with sr as ref to sema_api.SemaResult into list of string:
    var out as list of string is list of string
    for mm in sr->program->modules:
        var h as string is calling digest.sha256_hex with mm.source.text
        var line as string is "{mm.source.path}\t{h}"
        calling out.push with line
        banish h
    return out

## Ruta de una línea `ruta\tsha`.
##
## ## Memoria
## Devuelve string owned.
weave fingerprint_path with line as string into string:
    var i as int is 0
    var b as ref to frozen byte is bytes of line
    while i < line length:
        if ((b at i) to int) == 9:
            return line at 0 to i
        set i is i + 1
    return line at 0 to (line length)

## Hash de una línea `ruta\tsha`.
##
## ## Memoria
## Devuelve string owned (`""` si no hay tabulador).
weave fingerprint_hash with line as string into string:
    var i as int is 0
    var b as ref to frozen byte is bytes of line
    while i < line length:
        if ((b at i) to int) == 9:
            return line at (i + 1) to (line length)
        set i is i + 1
    return ""

## `true` si `lines` contiene una fingerprint para `path`.
##
## ## Memoria
## No retiene nada.
weave fingerprint_has with lines as list of string, path as string into bool:
    for line in lines:
        var p as string is calling fingerprint_path with line
        var eq as bool is p == path
        banish p
        if eq:
            return true
    return false

## Hash guardado para `path`.
##
## ## Memoria
## Devuelve string owned (`""` si no existe).
weave fingerprint_of with lines as list of string, path as string into string:
    for line in lines:
        var p as string is calling fingerprint_path with line
        if p == path:
            banish p
            return calling fingerprint_hash with line
        banish p
    return ""

## Imprime módulos añadidos, cambiados y eliminados.
##
## ## Memoria
## No retiene nada.
weave report_fingerprint_changes with old_lines as list of string, cur_lines as list of string into void:
    for line in cur_lines:
        var p as string is calling fingerprint_path with line
        var h as string is calling fingerprint_hash with line
        if not calling fingerprint_has with old_lines, p:
            var m as string is "cache: module added {p}"
            calling spark.eprintln with m
            banish m
        else:
            var oh as string is calling fingerprint_of with old_lines, p
            if oh != h:
                var mc as string is "cache: module changed {p}"
                calling spark.eprintln with mc
                banish mc
            banish oh
        banish h
        banish p
    for line in old_lines:
        var p as string is calling fingerprint_path with line
        if (p length > 0) and not (calling fingerprint_has with cur_lines, p):
            var mr as string is "cache: module removed {p}"
            calling spark.eprintln with mr
            banish mr
        banish p

## Directorio actual.
##
## ## Memoria
## Devuelve string owned.
weave current_dir into string:
    var d as maybe string is calling rites.getcwd
    if d.is_present:
        return d.value
    banish d
    return "."

## Busca el directorio con `pengu.toml` subiendo desde `start`.
##
## ## Memoria
## Devuelve string owned o `""`.
weave find_manifest_root with start as string into string:
    var normalized as string is calling compass.cp_normalize with start
    var nb as ref to frozen byte is bytes of normalized
    if normalized length == 0 or ((nb at 0) to int) != 47:
        var cw as maybe string is calling rites.getcwd
        if cw.is_present:
            var cws as string is calling npool.copy_string with cw.value
            var full as string is "{cws}/{start}"
            banish cws
            banish cw.value
            banish cw
            banish normalized
            set normalized is full
        else:
            banish cw
    var d as string is calling copy with normalized
    var i as int is 0
    while i < 8:
        var f as string is "{d}/pengu.toml"
        if calling archivum.is_file with f:
            banish f
            return calling npool.copy_string with d
        banish f
        var parent as string is calling compass.cp_dirname with d
        if parent == d:
            banish parent
            banish d
            return ""
        set d is parent
        set i is i + 1
    return ""

## Opciones por defecto.
##
## ## Memoria
## Strings owned; liberar con `free_options`.
weave default_options into BuildOptions:
    return with target is "", platform is (calling targetmod.host), target_explicit is false, profile is (calling copy with "debug"), cc is "", out_path is "", verbose is false, strict_c99 is false, lint_cow is false, lint_shadow is false, legacy_copy is false, release_unsafe is false, is_library is false, is_test is false, test_json is false, bundle_only is false, check_only is false, no_dce is false, prune_types is false, no_line_markers is false, prune_native is false, dce_scope_user is false, pch is false, compiler_path is "", no_cache is false, clear_cache is false, ephemeral is false, locked is false, frozen is false, force_exe is false, coverage is false, sanitize_kind is 0, split is false, jobs is 0, defines is list of string

## Libera opciones.
##
## ## Memoria
## Libera strings.
weave free_options with o as ref to BuildOptions into void:
    banish o->target
    banish o->profile
    banish o->cc
    banish o->out_path
    banish o->compiler_path
    calling targetmod.free with (sigil of o->platform)
    var oi as int is 0
    while oi < o->defines.len:
        banish o->defines at oi
        set oi is oi + 1
    banish o->defines

## Libera un resultado.
##
## ## Memoria
## Libera strings.
weave free_result with r as ref to BuildResult into void:
    banish r->error
    banish r->artifact
    banish r->bundle_path

## `true` si el programa importa `std.filum`.
##
## Es la misma condición que decide `-pthread`/`PENGU_ENABLE_THREADS`; si
## divergen, el runtime y el bundle no enlazan.
weave needs_threads with p as ref to program.SemaProgram into bool:
    var i as int is 0
    while i < p->modules.len:
        var m as loader.SemaModule is (p->modules at i)
        var path as string is m.source.path
        if (calling ends_with with path, "/std/filum.pengu") or (calling ends_with with path, "\\std\\filum.pengu") or (calling ends_with with path, "std/filum.pengu"):
            return true
        set i is i + 1
    return false

## `true` si el programa usa la capa JS (`std.web.js`).
##
## Todos los módulos web importan `std.web.js`, así que comprobar su path es
## suficiente. Los programas sin JS no pagan `--js-library` ni exports extra.
weave needs_js with p as ref to program.SemaProgram into bool:
    var i as int is 0
    while i < p->modules.len:
        var m as loader.SemaModule is (p->modules at i)
        var path as string is m.source.path
        if (calling ends_with with path, "/std/web/js.pengu") or (calling ends_with with path, "std/web/js.pengu"):
            return true
        set i is i + 1
    return false

## Archivero para wasm: `emar` del mismo emsdk que `emcc`, o `emar` del PATH.
##
## ## Memoria
## Devuelve string owned.
weave emar_for with cc as string into string:
    var d as string is calling compass.cp_dirname with cc
    if d length > 0:
        var cand as string is "{d}/emar"
        if calling archivum.is_file with cand:
            banish d
            return cand
        banish cand
    banish d
    var w as maybe string is calling rites.which with "emar"
    if w.is_present:
        return w.value
    banish w
    return calling copy with "emar"

## Módulo std no disponible en wasm: mensaje accionable, o `""`.
##
## `std.net` usa sockets BSD (no existen en el navegador; Node necesita `ws`);
## dynlib/ffi/secrets/petitio dependen de librerías nativas que no están en el
## sysroot wasm. Se rechazan antes de llegar a un error de linker.
## Clave de caché de un objeto de unidad: cabecera + fuente + flags + cc.
weave unit_object_key with header_hash as string, src as string, cc as string, flags as list of string into string:
    var parts as list of string is list of string
    calling parts.push with (calling copy with "unit-object-v1")
    calling parts.push with (calling copy with header_hash)
    var sm as maybe string is calling digest.sha256_file with src
    if sm.is_present:
        calling parts.push with (calling copy with sm.value)
    else:
        calling parts.push with (calling copy with "")
    banish sm
    calling parts.push with (calling copy with cc)
    for f in flags:
        calling parts.push with (calling copy with f)
    var k as string is calling cache.key with parts
    for x in parts:
        banish x
    banish parts
    return k

## Compila `srcs` a `objs` en paralelo (máximo `jobs` procesos).
##
## Devuelve 0 si todos los objetos se generaron. Windows usa `spawn_argv`,
## que no implementa fork: allí cae a ejecución secuencial.
##
## ## Memoria
## Los argv temporales se liberan tras cada spawn.
weave compile_units with cc as string, flags as list of string, srcs as list of string, objs as list of string, jobs as int into int:
    var limit as int is jobs
    if limit < 1:
        set limit is 1
    var running as list of int is list of int
    var failed as bool is false
    var i as int is 0
    while i < srcs.len and not failed:
        var src as string is (srcs at i)
        var obj as string is (objs at i)
        var argv as list of string is list of string
        calling argv.push with (calling copy with cc)
        for f in flags:
            calling argv.push with (calling copy with f)
        calling argv.push with "-c"
        calling argv.push with (calling copy with src)
        calling argv.push with "-o"
        calling argv.push with (calling copy with obj)
        var pid as int is calling proc.spawn_argv with argv
        if pid <= 0:
            var code as int is calling proc.run_argv with argv
            if code != 0:
                set failed is true
        else:
            calling running.push with pid
        for a in argv:
            banish a
        banish argv
        if running.len >= limit:
            var w as int is 0
            while w < running.len:
                var rp as int is (running at w)
                var rc as int is calling proc.wait_pid with rp
                if rc != 0:
                    set failed is true
                set w is w + 1
            banish running
            set running is list of int
        set i is i + 1
    var w2 as int is 0
    while w2 < running.len:
        var rp2 as int is (running at w2)
        var rc2 as int is calling proc.wait_pid with rp2
        if rc2 != 0:
            set failed is true
        set w2 is w2 + 1
    banish running
    if failed:
        return 1
    return 0

weave wasm_unsupported with p as ref to program.SemaProgram into string:
    var i as int is 0
    while i < p->modules.len:
        var m as loader.SemaModule is (p->modules at i)
        var path as string is m.source.path
        if calling ends_with with path, "/std/net.pengu":
            return "std.net is not available on wasm: browser sockets do not exist; use std.web.http or std.web.websocket"
        if calling ends_with with path, "/std/dynlib.pengu":
            return "std.dynlib is not available on wasm: there is no dlopen; keep this module in native builds"
        if calling ends_with with path, "/std/ffi_call.pengu":
            return "std.ffi_call is not available on wasm: libffi is not built for the wasm sysroot"
        if calling ends_with with path, "/std/secrets.pengu":
            return "std.secrets is not available on wasm: libsodium is not built for the wasm sysroot"
        if calling ends_with with path, "/std/petitio.pengu":
            return "std.petitio is not available on wasm: libcurl is not built for the wasm sysroot; use std.web.http"
        if calling ends_with with path, "std/coro.pengu":
            return "std.coro is not available on wasm: stackful coroutines need Emscripten fibers/Asyncify, not enabled in this toolchain"
        set i is i + 1
    return ""

## Construye un proyecto o un archivo.
##
## ## Memoria
## Devuelve BuildResult owned; liberar con `free_result`.
weave build with o as BuildOptions into BuildResult:
    var cwd as string is calling current_dir
    var is_project as bool is false
    if o.clear_cache:
        var cache_ignored as int is calling cache.clear
    var target as string is calling copy with o.target
    var start as string is calling copy with cwd
    var is_file as bool is false
    if target length > 0:
        if (calling ends_with with target, ".pengu") or (calling archivum.is_file with target):
            set is_file is true
            var tabs as string is calling compass.cp_absolute with target
            var td as string is calling compass.cp_dirname with tabs
            banish tabs
            banish start
            set start is td
        else:
            var ts as string is calling copy with target
            banish start
            set start is ts
    var root as string is calling find_manifest_root with start
    # Un archivo dentro de un proyecto sigue siendo parte del proyecto: sus
    # `c/` glue files y assets deben compilarse/incrustarse.
    set is_project is root length > 0
    var base as string is root
    var man as manifest.Manifest is calling manifest.default_manifest with start, "main.pengu"
    if root length == 0:
        set base is start
    if root length > 0:
        calling manifest.free_manifest with (sigil of man)
        set man is calling manifest.load_manifest with root, o.profile
        set base is man.base_dir
    else if not is_file:
        var leg as string is calling pman.legacy_manifest with start
        if leg length > 0:
            var lm2 as string is "only pengu.toml is supported; found {leg}. YAML/JSON manifests are no longer accepted."
            banish leg
            banish cwd
            banish target
            banish start
            banish root
            return with ok is false, error is lm2, artifact is "", bundle_path is "", is_wasm is false
        banish leg
        banish cwd
        banish target
        banish start
        banish root
        return with ok is false, error is (calling copy with "no pengu.toml found; pass a file or a project directory"), artifact is "", bundle_path is "", is_wasm is false
    if not man.ok:
        var emsg as string is man.error
        banish cwd
        banish target
        banish start
        banish root
        return with ok is false, error is emsg, artifact is "", bundle_path is "", is_wasm is false
    # Target efectivo: `--target` explícito manda; si no, `[build] target`.
    var eff as targetmod.Target is calling targetmod.clone with o.platform
    defer calling targetmod.free with (sigil of eff)
    if man.legacy_copy:
        set o.legacy_copy is true
    if (not o.target_explicit) and man.target length > 0:
        var parsed as targetmod.Target is calling targetmod.parse with man.target
        if not parsed.ok:
            var terr as string is calling copy with parsed.error
            calling targetmod.free with (sigil of parsed)
            banish cwd
            banish target
            banish start
            banish root
            calling manifest.free_manifest with (sigil of man)
            return with ok is false, error is terr, artifact is "", bundle_path is "", is_wasm is false
        calling targetmod.free with (sigil of eff)
        set eff is parsed
    if eff.wasm_target == "wasi":
        banish cwd
        banish target
        banish start
        banish root
        calling manifest.free_manifest with (sigil of man)
        return with ok is false, error is (calling copy with "WASI is not supported; use --target wasm32-unknown-emscripten"), artifact is "", bundle_path is "", is_wasm is false
    var entry as string is ""
    if is_file:
        set entry is calling compass.cp_absolute with target
    else:
        var e0 as string is "{base}/{man.entry}"
        set entry is calling compass.cp_absolute with e0
        banish e0
    if not calling archivum.is_file with entry:
        var emsg2 as string is "entry file not found: {entry}"
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling manifest.free_manifest with (sigil of man)
        return with ok is false, error is emsg2, artifact is "", bundle_path is "", is_wasm is false
    var p as paths.Paths is calling paths.find_paths with base, eff
    if not p.ok and not o.check_only:
        var perr as string is p.error
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        return with ok is false, error is perr, artifact is "", bundle_path is "", is_wasm is false
    if (not eff.is_host) and (not eff.is_wasm):
        var xarch as string is "{p.repo_root}/build/lib/{eff.triple}/libpengu_runtime.a"
        if calling archivum.exists with xarch:
            banish p.runtime_archive
            set p.runtime_archive is calling copy with xarch
        else:
            var xerr as string is "cross runtime missing: {xarch}; build it with: CC=<cross-gcc> AR=<cross-ar> RUNTIME_OUT=build/lib/{eff.triple} bash tools/build_runtime.sh"
            banish xarch
            banish cwd
            banish target
            banish start
            banish root
            banish entry
            calling manifest.free_manifest with (sigil of man)
            calling paths.free_paths with (sigil of p)
            return with ok is false, error is xerr, artifact is "", bundle_path is "", is_wasm is false
        banish xarch
    var tc as toolchain.Toolchain is calling toolchain.resolve with (sigil of man), (sigil of p), eff, o.cc, o.profile, o.strict_c99, o.release_unsafe
    if o.verbose:
        var pdbg as string is "paths: base={man.base_dir} incdir={man.include_dir} libdir={man.lib_dir} archive={p.runtime_archive} include={p.runtime_include} stds={p.std_dirs.len} incs={tc.include_dirs.len} libs={tc.lib_dirs.len}"
        calling spark.eprintln with pdbg
        banish pdbg
    if not tc.ok and not o.check_only:
        var terr as string is tc.error
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is false, error is terr, artifact is "", bundle_path is "", is_wasm is false
    # F3: opciones propias, sin compartir ownership con Manifest/Paths.
    var so as sopts.SemaOptions is calling sopts.default_options with (calling copy with man.base_dir)
    calling targetmod.apply_sema with eff, (sigil of so)
    set so.is_debug is o.profile == "debug"
    set so.lint_cow is o.lint_cow
    set so.lint_shadow is o.lint_shadow
    banish so.src_dir
    set so.src_dir is (calling copy with man.src_dir)
    banish so.lib_dir
    set so.lib_dir is (calling copy with man.lib_dir)
    var si as int is 0
    while si < p.std_dirs.len:
        calling so.std_dirs.push with (calling copy with (p.std_dirs at si))
        set si is si + 1
    var di as int is 0
    while di < man.defines.len:
        calling so.defines.push with (calling copy with (man.defines at di))
        set di is di + 1
    var doi as int is 0
    while doi < o.defines.len:
        calling so.defines.push with (calling copy with (o.defines at doi))
        set doi is doi + 1
    var dep_ds as list of pman.Dependency is calling pman.load with base
    if dep_ds.len > 0:
        if o.frozen:
            for vd in dep_ds:
                var vt as string is "{base}/{man.lib_dir}/{vd.name}"
                if not calling archivum.is_dir with vt:
                    var vv as string is "{base}/vendor/{vd.name}"
                    if calling archivum.is_dir with vv:
                        var vr as bool is calling psource.copy_local with vv, vt, true
                    banish vv
                if not calling archivum.is_dir with vt:
                    banish vt
                    banish dep_ds
                    calling manifest.free_manifest with (sigil of man)
                    calling paths.free_paths with (sigil of p)
                    calling toolchain.free_toolchain with (sigil of tc)
                    return with ok is false, error is "E0061: dependency missing and --frozen forbids network/install", artifact is "", bundle_path is "", is_wasm is false
                banish vt
        var lkd as bool is o.locked
        if o.frozen:
            set lkd is true
        var g as presolve.Graph is calling presolve.resolve with base, man.lib_dir, dep_ds, false, lkd
        if not g.ok:
            var ge as string is g.error
            if lkd:
                banish ge
                set ge is "E0061: pengu.lock is out of date (--locked/--frozen)"
            calling spark.eprintln with ge
            banish ge
            banish dep_ds
            calling manifest.free_manifest with (sigil of man)
            calling paths.free_paths with (sigil of p)
            calling toolchain.free_toolchain with (sigil of tc)
            return with ok is false, error is "dependencies", artifact is "", bundle_path is "", is_wasm is false
        if o.locked or o.frozen:
            var lm as maybe plock.Lock is calling plock.read with base
            if not lm.is_present:
                banish lm
                banish dep_ds
                calling manifest.free_manifest with (sigil of man)
                calling paths.free_paths with (sigil of p)
                calling toolchain.free_toolchain with (sigil of tc)
                return with ok is false, error is "E0061: pengu.lock missing (--locked/--frozen)", artifact is "", bundle_path is "", is_wasm is false
            var bad as bool is false
            for gp in g.packages:
                var found as bool is false
                for lp in lm.value.packages:
                    if lp.name == gp.name:
                        set found is true
                        if lp.version != gp.version or lp.commit != gp.commit or lp.sha256 != gp.sha256:
                            set bad is true
                        if not calling pinstall.satisfies_text with gp.version, lp.constraint:
                            set bad is true
                        if not calling pinstall.satisfies_text with gp.version, gp.constraint:
                            set bad is true
                if not found:
                    set bad is true
            for lp2 in lm.value.packages:
                var seen as bool is false
                for gp2 in g.packages:
                    if lp2.name == gp2.name:
                        set seen is true
                if not seen:
                    set bad is true
            if bad:
                banish lm
                banish dep_ds
                calling manifest.free_manifest with (sigil of man)
                calling paths.free_paths with (sigil of p)
                calling toolchain.free_toolchain with (sigil of tc)
                return with ok is false, error is "E0061: pengu.lock is out of date (--locked/--frozen)", artifact is "", bundle_path is "", is_wasm is false
            banish lm
        else:
            var lk as plock.Lock is with target is "x86_64-unknown-linux-gnu", packages is list of plock.Package
            for gp2 in g.packages:
                calling lk.packages.push with gp2
            var lw as bool is calling plock.write with base, lk
        for gp in g.packages:
            var ddir as string is "{base}/{man.lib_dir}/{gp.name}"
            var lay as pman.Layout is calling pman.load_layout with ddir
            # Layout declarado por el paquete: src_dir/include_dir/lib_dir.
            var dsrc as string is "{ddir}/{lay.src_dir}"
            if calling archivum.is_dir with dsrc:
                calling so.dep_dirs.push with (calling copy with dsrc)
            var dinc as string is "{ddir}/{lay.include_dir}"
            if calling archivum.is_dir with dinc:
                calling tc.include_dirs.push with (calling copy with dinc)
            var dlib as string is "{ddir}/{lay.lib_dir}"
            if calling archivum.is_dir with dlib:
                calling tc.lib_dirs.push with (calling copy with dlib)
            banish dlib
            banish dinc
            banish dsrc
            calling pman.free_layout with (sigil of lay)
            banish ddir
    var ccn as string is calling compass.cp_basename with tc.cc
    banish so.compiler
    set so.compiler is (calling copy with ccn)
    banish ccn
    # --- Fast path: clave y acierto ANTES de sema/codegen ------------------
    # El artefacto depende solo de entradas que ya conocemos aquí (manifiesto,
    # toolchain, fuentes y runtime). Consultar la caché antes de sema convierte
    # un no-op de ~25 s en una copia de milisegundos.
    var eff_output as string is man.output
    if o.force_exe:
        set eff_output is "exe"
    var out_kind as string is eff_output
    var out_name as string is man.output_name
    if is_file:
        var stem as string is calling compass.cp_stem with entry
        set out_name is stem
    if o.is_test:
        set out_name is "{out_name}_test"
    var build_dir as string is ""
    var bundle as string is ""
    var artifact as string is ""
    var ck as string is ""
    var cache_ok as bool is (not o.no_cache) and (not o.ephemeral) and (not o.check_only) and (not o.bundle_only) and (man.output != "c" or o.force_exe) and not (eff.is_wasm and out_kind == "exe")
    if not o.check_only:
        set build_dir is "{base}/{man.build_dir}"
        if not calling archivum.create_dir with build_dir, true:
            var bderr as string is "cannot create build directory: {build_dir}"
            banish cwd
            banish target
            banish start
            banish root
            banish entry
            banish build_dir
            banish bundle
            banish artifact
            banish ck
            banish dep_ds
            calling sopts.free_options with (sigil of so)
            calling manifest.free_manifest with (sigil of man)
            calling paths.free_paths with (sigil of p)
            calling toolchain.free_toolchain with (sigil of tc)
            return with ok is false, error is bderr, artifact is "", bundle_path is "", is_wasm is false
        set bundle is "{build_dir}/bundle.c"
        if o.out_path length > 0:
            set artifact is calling compass.cp_absolute with o.out_path
            if eff.is_wasm and out_kind == "exe" and not (calling ends_with with artifact, ".html") and not (calling ends_with with artifact, ".js") and not (calling ends_with with artifact, ".mjs"):
                set artifact is "{artifact}.html"
        else:
            if out_kind == "obj":
                set artifact is "{build_dir}/{out_name}.o"
            else if out_kind == "static":
                set artifact is "{build_dir}/lib{out_name}.a"
            else if out_kind == "shared":
                set artifact is "{build_dir}/lib{out_name}.so"
            else if out_kind == "exe" and eff.is_wasm:
                set artifact is "{build_dir}/{out_name}.html"
            else if out_kind == "exe" and so.os_name == "windows":
                set artifact is "{build_dir}/{out_name}.exe"
            else:
                set artifact is "{build_dir}/{out_name}"
        var adir as string is calling compass.cp_dirname with artifact
        if adir length > 0:
            calling archivum.create_dir with adir, true
        banish adir
        if cache_ok:
            set ck is calling compute_cache_key with (sigil of o), (sigil of man), (sigil of p), (sigil of tc), (sigil of eff), base, entry, is_project, is_file, eff_output, out_name, so.dep_dirs
            var hit as string is calling cache.get with ck
            if hit length > 0:
                var cok as bool is calling archivum.copy_file with hit, artifact, true
                if (not cok) and (calling same_file_content with hit, artifact):
                    set cok is true
                if cok:
                    var cargsx as list of string is list of string
                    calling cargsx.push with "chmod"
                    calling cargsx.push with "+x"
                    calling cargsx.push with (calling copy with artifact)
                    var chx as int is calling proc.run_argv with cargsx
                    calling free_strings with cargsx
                    banish hit
                    banish ck
                    banish cwd
                    banish target
                    banish start
                    banish root
                    banish entry
                    banish build_dir
                    banish dep_ds
                    calling sopts.free_options with (sigil of so)
                    calling manifest.free_manifest with (sigil of man)
                    calling paths.free_paths with (sigil of p)
                    calling toolchain.free_toolchain with (sigil of tc)
                    return with ok is true, error is "", artifact is artifact, bundle_path is bundle, is_wasm is eff.is_wasm
                banish hit
    # --- Fast path de `psc check`: un proyecto ya verificado no vuelve a
    # ejecutar sema. La clave cubre fuentes, flags, toolchain y runtime, así que
    # cualquier cambio real la invalida.
    var check_ck as string is ""
    if o.check_only and not o.no_cache and not o.ephemeral and p.ok and tc.ok:
        set check_ck is calling compute_cache_key with (sigil of o), (sigil of man), (sigil of p), (sigil of tc), (sigil of eff), base, entry, is_project, is_file, "check", "", so.dep_dirs
        if calling cache.has with check_ck:
            banish check_ck
            banish cwd
            banish target
            banish start
            banish root
            banish entry
            banish dep_ds
            calling sopts.free_options with (sigil of so)
            calling manifest.free_manifest with (sigil of man)
            calling paths.free_paths with (sigil of p)
            calling toolchain.free_toolchain with (sigil of tc)
            return with ok is true, error is "", artifact is "", bundle_path is "", is_wasm is eff.is_wasm
    if o.verbose and check_ck length > 0:
        var cm as string is "cache: check key={check_ck}"
        calling spark.eprintln with cm
        banish cm
    if o.verbose and ck length > 0:
        var km as string is "cache: key={ck}"
        calling spark.eprintln with km
        banish km
    var ptime as bool is false
    var te as maybe string is calling rites.getenv with "PSC_TIME"
    if te.is_present:
        set ptime is true
    banish te
    var t_sema as int is 0
    var t_cg as int is 0
    if ptime:
        set t_sema is calling chronicle.monotonic_ms
    var sr as sema_api.SemaResult is calling sema_api.check_file with entry, so
    if ptime:
        var dt as int is (calling chronicle.monotonic_ms) - t_sema
        var m as string is "psc: sema {dt} ms"
        calling spark.eprintln with m
        banish m
    var bag_ref as ref to diag.DiagnosticBag is (sigil of sr.program->diagnostics)
    var bag_v as diag.DiagnosticBag is sr.program->diagnostics
    if not sr.ok or bag_ref->error_count > 0:
        var rendered as string is calling bag_v.render_plain
        calling spark.eprint with rendered
        banish rendered
        banish cwd
        banish target
        banish start
        banish root
        banish entry
        calling sema_api.free_result with (sigil of sr)
        calling manifest.free_manifest with (sigil of man)
        calling paths.free_paths with (sigil of p)
        calling toolchain.free_toolchain with (sigil of tc)
        return with ok is false, error is (calling copy with "semantic errors"), artifact is "", bundle_path is "", is_wasm is false
    if eff.is_wasm:
        var uns as string is calling wasm_unsupported with sr.program
        if uns length > 0:
            banish cwd
            banish target
            banish start
            banish root
            banish entry
            calling sema_api.free_result with (sigil of sr)
            calling manifest.free_manifest with (sigil of man)
            calling paths.free_paths with (sigil of p)
            calling toolchain.free_toolchain with (sigil of tc)
            return with ok is false, error is uns, artifact is "", bundle_path is "", is_wasm is false
    # Diagnóstico incremental: compara las huellas de los módulos con las del
    # build anterior. La caché sigue siendo por programa completo; esto solo
    # explica qué fuente invalidó la clave (visible con --verbose).
    if build_dir length > 0:
        var oldp as string is "{build_dir}/.psc-modules"
        var olds as list of string is list of string
        if o.verbose and calling archivum.is_file with oldp:
            var om as maybe string is calling archivum.read_text with oldp
            if om.is_present:
