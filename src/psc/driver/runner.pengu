## psc/driver/runner.pengu — ejecutar el artefacto de un build.
##
## Nativo: exec directo. Wasm: `node <artifact>.js` (Emscripten escribe
## `app.html`, `app.js` y `app.wasm`; el HTML no es ejecutable).
##
## ## Memoria
## Construye argv owned y libera todo antes de volver.

import std.archivum
import std.chronicle
import std.compass
import std.rites
import std.spark

import psc.driver.target as target
import psc.os.proc as proc
import psc.sema.names as npool

insignia psc_driver_runner_

## Copia owned.
##
## ## Memoria
## Devuelve string owned.
weave copy with s as string into string:
    return calling npool.copy_string with s

## `true` si `s` termina en `suffix`.
##
## ## Memoria
## O(suffix); no asigna.
weave ends_with with s as string, suffix as string into bool:
    var n as int is s length
    var m as int is suffix length
    if m > n:
        return false
    var sb as ref to frozen byte is bytes of s
    var pb as ref to frozen byte is bytes of suffix
    var i as int is 0
    while i < m:
        if ((sb at (n - m + i)) to int) != ((pb at i) to int):
            return false
        set i is i + 1
    return true

## Normaliza el código de retorno de un proceso.
##
## `proc.run_argv` devuelve el estado crudo de `wait` en algunas plataformas.
##
## ## Memoria
## O(1).
weave normalize with raw as int into int:
    var code as int is raw
    if raw > 255:
        set code is (raw / 256) % 256
    if code < 0:
        set code is 1
    return code

## Ruta del loader JS de un artefacto wasm.
##
## ## Memoria
## Devuelve string owned.
weave js_path with artifact as string into string:
    if (calling ends_with with artifact, ".js") or (calling ends_with with artifact, ".mjs"):
        return calling copy with artifact
    if calling ends_with with artifact, ".html":
        var stem as string is calling compass.cp_stem with artifact
        var dir as string is calling compass.cp_dirname with artifact
        if dir length > 0 and dir != ".":
            var out as string is "{dir}/{stem}.js"
            banish dir
            banish stem
            return out
        banish dir
        var out2 as string is "{stem}.js"
        banish stem
        return out2
    return "{artifact}.js"

## Busca un navegador Chromium/Chrome para wasm headless.
##
## ## Memoria
## Devuelve un string owned o `maybe none`.
weave chromium_path into maybe string:
    var names as list of string is list of string
    calling names.push with "chromium"
    calling names.push with "chromium-browser"
    calling names.push with "google-chrome"
    calling names.push with "google-chrome-stable"
    var i as int is 0
    while i < names.len:
        var hit as maybe string is calling rites.which with (names at i)
        if hit.is_present:
            var out as string is hit.value
            banish names
            return some out
        banish hit
        set i is i + 1
    banish names
    return maybe none

## Ejecuta un HTML wasm en Chromium headless con un servidor HTTP local.
##
## ## Memoria
## Libera temporales; el servidor se termina al acabar.
weave run_browser with artifact as string into int:
    var py as maybe string is calling rites.which with "python3"
    if not py.is_present:
        calling spark.eprintln with "psc: python3 not found; cannot serve the wasm page"
        banish py
        return 2
    var chrome as maybe string is calling chromium_path
    if not chrome.is_present:
        calling spark.eprintln with "psc: Chromium/Chrome not found; build with --target wasm and open the HTML manually"
        banish py
        banish chrome
        return 2
    var dir as string is calling compass.cp_dirname with artifact
    if dir length == 0:
        banish dir
        set dir is calling copy with "."
    var base as string is calling compass.cp_basename with artifact
    var port as int is 18765
    var sargs as list of string is list of string
    calling sargs.push with py.value
    calling sargs.push with "-m"
    calling sargs.push with "http.server"
    calling sargs.push with "{port}"
    calling sargs.push with "--bind"
    calling sargs.push with "127.0.0.1"
    calling sargs.push with "--directory"
    calling sargs.push with (calling copy with dir)
    var pid as int is calling proc.spawn_argv with sargs
    banish py
    banish sargs
    if pid <= 0:
        calling spark.eprintln with "psc: could not start the wasm HTTP server"
        banish dir
        banish base
        banish chrome
        return 2
    calling chronicle.sleep_ms with 600
    var url as string is "http://127.0.0.1:{port}/{base}"
    var shot as string is "{dir}/psc-wasm.png"
    var cargs as list of string is list of string
    calling cargs.push with chrome.value
    calling cargs.push with "--headless=new"
    calling cargs.push with "--no-sandbox"
    calling cargs.push with "--disable-gpu"
    calling cargs.push with "--disable-dev-shm-usage"
    calling cargs.push with "--enable-unsafe-swiftshader"
    calling cargs.push with "--hide-scrollbars"
    calling cargs.push with "--virtual-time-budget=6000"
    calling cargs.push with "--screenshot={shot}"
    calling cargs.push with url
    var code as int is calling proc.run_argv_quiet with cargs
    banish cargs
    var alive as bool is calling proc.pid_alive with pid
    if alive:
        var ignored as bool is calling proc.terminate with pid
        var ignored2 as int is calling proc.wait_pid with pid
    banish url
    banish shot
    banish dir
    banish base
    banish chrome
    return calling normalize with code

## Ejecuta `artifact` con los argumentos del programa.
##
## ## Memoria
## Libera argv y temporales.
weave run with t as target.Target, artifact as string, argv as list of string, browser as bool into int:
    var args as list of string is list of string
    if t.is_wasm:
        if browser:
            var bcode as int is calling run_browser with artifact
            banish args
            return bcode
        var js as string is calling js_path with artifact
        defer banish js
        if not calling archivum.is_file with js:
            var msg as string is "psc: wasm output not found: {js} (build with --target wasm)"
            calling spark.eprintln with msg
            banish msg
            banish args
            return 1
        var node as maybe string is calling rites.which with "node"
        if not node.is_present:
            var hint as string is "psc: Node.js not found; open {artifact} in a browser (or install node and re-run)"
            calling spark.eprintln with hint
            banish hint
            banish node
            banish args
            return 2
        calling args.push with node.value
        calling args.push with (calling copy with js)
    else:
        calling args.push with (calling copy with artifact)
    for a in argv:
        calling args.push with (calling copy with a)
    var raw as int is calling proc.run_argv with args
    banish args
    var code as int is calling normalize with raw
    # raylib web necesita DOM/WebGL: si Node falla, intenta el navegador.
    if t.is_wasm and code != 0 and not browser:
        var chrome as maybe string is calling chromium_path
        if chrome.is_present:
            banish chrome
            return calling run_browser with artifact
        banish chrome
    return code
