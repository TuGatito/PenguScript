## psc/driver/toolchain.pengu — cc, flags e includes/links.

import std.archivum
import std.compass
import std.rites

import psc.sema.names as npool
import psc.driver.manifest as manifest
import psc.driver.paths as paths
import psc.driver.target as target

insignia psc_driver_toolchain_

## Toolchain resuelto.
##
## ## Memoria
## Strings/listas owned; liberar con `free_toolchain`.
rune Toolchain:
    ok as bool
    error as string
    cc as string
    cflags as vector of string
    include_dirs as vector of string
    lib_dirs as vector of string
    links as vector of string

## Copia un string.
##
## ## Memoria
## Devuelve string owned.
weave copy with s as string into string:
    return calling npool.copy_string with s

## Libera una lista de strings owned.
##
## ## Memoria
## Libera elementos y lista.
weave free_strings with xs as vector of string into void:
    var i as int is 0
    while i < xs.len:
        banish xs at i
        set i is i + 1
    banish xs

## Compilador de C++ equivalente a uno de C.
##
## ## Memoria
## Devuelve string owned o `""` si no hay equivalente razonable.
weave cxx_for with cc as string into string:
    if cc length == 0:
        return ""
    var base as string is cc
    var slash as int is base length - 1
    while slash >= 0:
        if (base at slash) == "/":
            set base is base at (slash + 1) to (base length)
            set slash is -1
        else:
            set slash is slash - 1
    if base == "gcc" or base == "cc":
        var g as maybe string is calling rites.which with "g++"
        if g.is_present:
            return g.value
        banish g
        return calling copy with "g++"
    if base == "clang":
        var c as maybe string is calling rites.which with "clang++"
        if c.is_present:
            return c.value
        banish c
        return calling copy with "clang++"
    if base == "tcc":
        # tcc no tiene frontend de C++: se cae al g++/clang++ del sistema.
        var g2 as maybe string is calling rites.which with "g++"
        if g2.is_present:
            return g2.value
        banish g2
        var c2 as maybe string is calling rites.which with "clang++"
        if c2.is_present:
            return c2.value
        banish c2
        return ""
    # Cross/prefijados: `aarch64-linux-gnu-gcc` -> `aarch64-linux-gnu-g++`.
    if (base length) > 3 and (base at ((base length) - 3) to (base length)) == "gcc":
        var cand as string is "{base at 0 to ((base length) - 3)}++"
        var g3 as maybe string is calling rites.which with cand
        if g3.is_present:
            banish cand
            return g3.value
        banish g3
        banish cand
        return ""
    var plus as string is "{cc}++"
    return plus

## Elige un compilador.
##
## ## Memoria
## Devuelve string owned o `""`.
weave choose_cc with override as string, configured as string, t as target.Target into string:
    if override length > 0:
        return calling copy with override
    if (not t.is_wasm) and (not t.is_host):
        # Cross nativo: se prefieren las herramientas con prefijo del triple.
        var tools as vector of string is vector of string
        if t.os == "linux" and t.arch == "arm64":
            calling tools.push with "aarch64-linux-gnu-gcc"
        else if t.os == "linux" and t.arch == "x64":
            calling tools.push with "x86_64-linux-gnu-gcc"
        else if t.os == "windows":
            calling tools.push with "x86_64-w64-mingw32-gcc"
        else if t.os == "macos":
            calling tools.push with "clang"
        for name in tools:
            var w as maybe string is calling rites.which with name
            if w.is_present:
                banish tools
                return w.value
            banish w
        banish tools
        if configured length > 0:
            return calling copy with configured
        var cl as maybe string is calling rites.which with "clang"
        if cl.is_present:
            return cl.value
        banish cl
        return ""
    if t.is_wasm:
        var we as maybe string is calling rites.getenv with "PSC_CC"
        if we.is_present:
            return we.value
        banish we
        var we2 as maybe string is calling rites.getenv with "PENGU_CC"
        if we2.is_present:
            return we2.value
        banish we2
        var em as maybe string is calling rites.which with "emcc"
        if em.is_present:
            return em.value
        banish em
        return ""
    if configured length > 0:
        return calling copy with configured
    var e as maybe string is calling rites.getenv with "PSC_CC"
    if e.is_present:
        return e.value
    banish e
    var e2 as maybe string is calling rites.getenv with "PENGU_CC"
    if e2.is_present:
        return e2.value
    banish e2
    var g as maybe string is calling rites.which with "gcc"
    if g.is_present:
        return g.value
    banish g
    var c as maybe string is calling rites.which with "clang"
    if c.is_present:
        return c.value
    banish c
    var tcc as maybe string is calling rites.which with "tcc"
    if tcc.is_present:
        return tcc.value
    banish tcc
    return calling copy with "gcc"

## Añade un directorio de include si existe.
##
## ## Memoria
## Añade una copia owned a la lista.
weave add_inc with xs as ref to vector of string, dir as string into void:
    if dir length == 0 or not (calling archivum.is_dir with dir):
        return
    var i as int is 0
    while i < xs->len:
        if (xs at i) == dir:
            return
        set i is i + 1
    calling xs.push with (calling copy with dir)

## Añade una flag si no está ya (manifiesto + perfil pueden repetir `-Wall`).
##
## ## Memoria
## Añade una copia owned a la lista.
weave add_flag with xs as ref to vector of string, flag as string into void:
    if flag length == 0:
        return
    var i as int is 0
    while i < xs->len:
        if (xs at i) == flag:
            return
        set i is i + 1
    calling xs.push with (calling copy with flag)

## Añade un directorio de librerías si existe.
##
## ## Memoria
## Añade una copia owned a la lista.
weave add_lib with xs as ref to vector of string, dir as string into void:
    if dir length > 0 and calling archivum.is_dir with dir:
        calling xs.push with (calling copy with dir)

## Resuelve cc/flags.
##
## ## Memoria
## Resultado owned; liberar con `free_toolchain`.
weave resolve with m as ref to manifest.Manifest, p as ref to paths.Paths, t as target.Target, cc_override as string, profile as string, strict as bool, release_unsafe as bool, family as string into Toolchain:
    var is_cpp as bool is family == "cpp"
    var cc as string is calling choose_cc with cc_override, m->cc, t
    if is_cpp and cc length > 0:
        var cxx as string is calling cxx_for with cc
        if cxx length == 0:
            banish cc
            return with ok is false, error is "no C++ compiler found for --backend=cpp (install g++/clang++)", cc is "", cflags is vector of string, include_dirs is vector of string, lib_dirs is vector of string, links is vector of string
        banish cc
        set cc is cxx
    if cc length == 0:
        if t.is_wasm:
            return with ok is false, error is "emcc not found in PATH; install/activate the Emscripten SDK and re-run (or pass --cc /path/to/emcc)", cc is "", cflags is vector of string, include_dirs is vector of string, lib_dirs is vector of string, links is vector of string
        return with ok is false, error is "no C compiler found (use --cc or PSC_CC)", cc is "", cflags is vector of string, include_dirs is vector of string, lib_dirs is vector of string, links is vector of string
    var cflags as vector of string is vector of string
    if is_cpp:
        calling cflags.push with "-std=c++20"
    else:
        calling cflags.push with "-std=c11"
    calling cflags.push with "-Wall"
    ## El C generado es estricto (`-std=c11`) pero una biblioteca puede necesitar
    ## POSIX (sockets, `clock_gettime`, `getaddrinfo`). Estas macros tienen que
    ## ir en la línea de compilación: definir­las desde el bundle llegaría tarde.
    calling cflags.push with "-D_POSIX_C_SOURCE=200809L"
    calling cflags.push with "-D_DEFAULT_SOURCE"
    # Clang necesita el triple para cross; los gcc con prefijo ya lo implican.
    if (not t.is_host) and (not t.is_wasm) and t.triple length > 0:
        var tflag as string is "--target={t.triple}"
        calling add_flag with (sigil of cflags), tflag
        banish tflag
    for f in m->cflags:
        # `-std=` es del lenguaje elegido: un manifiesto con `-std=c11` no debe
        # pisar el `-std=c++20` de `--backend=cpp` (gcc lo rechaza).
        if is_cpp and (f length) >= 5 and (f at 0 to 5) == "-std=":
            continue
        calling add_flag with (sigil of cflags), f
    for d in m->defines:
        var df as string is "-D{d}"
        calling add_flag with (sigil of cflags), df
        banish df
    if strict:
        calling cflags.push with "-pedantic"
    if release_unsafe:
        calling cflags.push with "-DPENGU_BOUNDS_CHECK=0"
        calling cflags.push with "-DPENGU_OVERFLOW_CHECK=0"
    var incs as vector of string is vector of string
    var inc0 as string is "{m->base_dir}/{m->include_dir}"
    calling add_inc with (sigil of incs), inc0
    banish inc0
    var inc1 as string is "{m->base_dir}/include"
    calling add_inc with (sigil of incs), inc1
    banish inc1
    var incc as string is "{m->base_dir}/{m->c_dir}"
    calling add_inc with (sigil of incs), incc
    banish incc
    calling add_inc with (sigil of incs), p->runtime_include
    calling add_inc with (sigil of incs), p->std_c_dir
    # Vendored SDS lives in `std_c/sds`; `build/include` already gets a copy,
    # but a source checkout that has not run build_runtime yet still resolves
    # `#include "sds.h"` through this path.
    if p->std_c_dir length > 0:
        var stdfsds as string is "{p->std_c_dir}/sds"
        calling add_inc with (sigil of incs), stdfsds
        banish stdfsds
    for d in m->include_dirs:
        var di as string is "{m->base_dir}/{d}"
        calling add_inc with (sigil of incs), di
        banish di
    # El build dir del proyecto va al final: puede contener copias antiguas de
    # `pengu_runtime.h` de builds anteriores y no debe tapar el runtime actual.
    var incb as string is "{m->base_dir}/{m->build_dir}"
    calling add_inc with (sigil of incs), incb
    banish incb
    var libs as vector of string is vector of string
    var rdir as string is calling compass.cp_dirname with p->runtime_archive
    calling add_lib with (sigil of libs), rdir
    banish rdir
    var lib0 as string is "{m->base_dir}/lib"
    if t.is_wasm:
        var libw as string is "{m->base_dir}/lib/wasm"
        calling add_lib with (sigil of libs), libw
        banish libw
    calling add_lib with (sigil of libs), lib0
    banish lib0
    for d in m->lib_dirs:
        var li as string is "{m->base_dir}/{d}"
        calling add_lib with (sigil of libs), li
        banish li
    var links as vector of string is vector of string
    for l in m->links:
        calling links.push with (calling copy with l)
    var has_runtime as bool is false
    for l in links:
        if l == "pengu_runtime" or l == "libpengu_runtime":
            set has_runtime is true
    if not has_runtime:
        calling links.push with (calling copy with "pengu_runtime")
    return with ok is true, error is "", cc is cc, cflags is cflags, include_dirs is incs, lib_dirs is libs, links is links

## Libera un toolchain.
##
## ## Memoria
## Libera strings/listas.
weave free_toolchain with t as ref to Toolchain into void:
    banish t->error
    banish t->cc
    calling free_strings with t->cflags
    calling free_strings with t->include_dirs
    calling free_strings with t->lib_dirs
    calling free_strings with t->links
