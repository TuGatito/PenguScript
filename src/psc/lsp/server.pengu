## psc/lsp/server.pengu — servidor LSP mínimo (lifecycle + diagnósticos).

import std.builder
import std.rites
import std.chronicle
import std.archivum
import std.diagnostic as diag
import std.json as json
import std.jsonrpc as rpc
import std.memoria
import std.scrolls
import std.spark

import psc.ast.kind as pskind
import psc.lexer_state as psstate
import psc.lsp.positions as lpos
import psc.lsp.query as query
import psc.lsp.transport as transport
import psc.lsp.uri as luri
import psc.sema.api as sema_api
import psc.sema.ast as astutil
import psc.sema.modules.loader as loader
import psc.sema.names as npool
import psc.sema.options as sopts
import psc.sema.symbols.symbol as sym
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.token as pstoken

insignia psc_lsp_server_

## Documento abierto.
rune Document:
    text as string
    version as int
    ## Resultado semántico owned; `free_doc` lo libera.
    sema as ref to sema_api.SemaResult

## Estado del servidor.
rune State:
    tr as transport.Transport
    docs as map of string to Document
    root as string
    exe as string
    std_dir as string
    inlay_enabled as bool
    semantic_enabled as bool
    ws_cache as JsonValue
    ws_ready as bool
    initialized as bool
    shutdown as bool

## `true` si `s` empieza por `p`.
weave starts_with with s as string, p as string into bool:
    var n as int is s length
    var m as int is p length
    if m > n:
        return false
    return (s at 0 to m) == p

## Copia owned.
weave copy with s as string into string:
    return calling npool.copy_string with s

## Copia un id JSON-RPC.
weave copy_id with id as rpc.JsonRpcId into rpc.JsonRpcId:
    var out as rpc.JsonRpcId is with Number is 0
    judge id:
        when Number with value ->
            set out is with Number is value
        when String with value ->
            set out is with String is (calling copy with value)
    return out

## Envía un mensaje.
weave send_msg with st as ref to State, msg as rpc.JsonRpcMessage into bool:
    var wire as string is calling rpc.encode_message with msg
    defer banish wire
    return calling transport.write_frame with (sigil of st->tr), wire

## Envía error de método.
weave send_method_error with st as ref to State, id as rpc.JsonRpcId, method as string into void:
    var err as rpc.JsonRpcError is calling rpc.error_method_not_found with method
    var out as rpc.JsonRpcMessage is calling rpc.response_error with (calling copy_id with id), err
    var ok as bool is calling send_msg with st, out
    banish out

## Número de severidad LSP.
weave severity_num with sev as diag.Severity into int:
    if sev == diag.Severity.Error:
        return 1
    if sev == diag.Severity.Warning:
        return 2
    if sev == diag.Severity.Info:
        return 3
    return 4

## Primer span de un diagnóstico.
weave main_span with d as diag.Diagnostic into maybe diag.Span:
    for lb in d.labels:
        if lb.primary:
            return some lb.span
    if d.labels.len > 0:
        return some ((d.labels at 0).span)
    return (maybe none)

## Construye un diagnóstico LSP.
weave diag_json with text as string, d as diag.Diagnostic into JsonValue:
    var o as JsonValue is calling JsonValue.empty_object
    var msp as maybe diag.Span is calling main_span with d
    var start as int is 0
    var end as int is 0
    if msp.is_present:
        set start is msp.value.start_byte
        set end is msp.value.end_byte
    calling o.put_json with "range", (calling lpos.range_json with text, start, end)
    calling o.put_json with "severity", (calling JsonValue.int_val with ((calling severity_num with d.severity) to i64))
    if d.code length > 0:
        calling o.put_json with "code", (calling JsonValue.string_val with (calling copy with d.code))
    calling o.put_json with "source", (calling JsonValue.string_val with (calling copy with "psc"))
    calling o.put_json with "message", (calling JsonValue.string_val with (calling copy with d.message))
    return o

## Publica diagnósticos para un documento.
## Extrae un int de un objeto.
weave jint with v as JsonValue, key as string, dflt as int into int:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv as JsonValue is f.value
        var i as maybe i64 is calling fv.as_int
        banish f
        if i.is_present:
            return (i.value to int)
        banish i
    banish f
    return dflt

## Extrae un string de un objeto.
weave jstr with v as JsonValue, key as string into string:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv as JsonValue is f.value
        var s as maybe string is calling fv.as_string
        banish f
        if s.is_present:
            var out as string is calling copy with s.value
            banish s
            return out
        banish s
    banish f
    return ""

## Convierte un diagnóstico de `psc check --diagnostics=json` a LSP.
weave subprocess_diag with text as string, o as JsonValue into JsonValue:
    var rng as maybe JsonValue is calling o.get with "range"
    var out as JsonValue is calling JsonValue.empty_object
    if rng.is_present:
        var rv as JsonValue is rng.value
        var st as maybe JsonValue is calling rv.get with "start"
        var en as maybe JsonValue is calling rv.get with "end"
        var sl as int is 0
        var sc as int is 0
        var el as int is 0
        var ec as int is 0
        if st.is_present:
            set sl is calling jint with st.value, "line", 0
            set sc is calling jint with st.value, "character", 0
        if en.is_present:
            set el is calling jint with en.value, "line", sl
            set ec is calling jint with en.value, "character", sc
        banish en
        banish st
        var so as int is (calling lpos.line_start with text, sl) + sc
        var eo as int is (calling lpos.line_start with text, el) + ec
        calling out.put_json with "range", (calling lpos.range_json with text, so, eo)
        banish rng
    else:
        banish rng
        calling out.put_json with "range", (calling lpos.range_json with text, 0, 0)
    calling out.put_json with "severity", (calling JsonValue.int_val with ((calling jint with o, "severity", 1) to i64))
    var code as string is calling jstr with o, "code"
    if code length > 0:
        calling out.put_json with "code", (calling JsonValue.string_val with (calling copy with code))
    banish code
    calling out.put_json with "source", (calling JsonValue.string_val with (calling copy with "psc"))
    var msg as string is calling jstr with o, "message"
    calling out.put_json with "message", (calling JsonValue.string_val with (calling copy with msg))
    banish msg
    return out

## Libera el estado owned de un documento.
##
## ## Memoria
## Libera el `SemaResult` y el texto.
weave free_doc with d as ref to Document into void:
    calling sema_api.free_result with d->sema
    banish d->sema
    banish d->text

## Chequea el texto y devuelve un `SemaResult` owned en heap.
##
## ## Memoria
## El llamador debe liberarlo con `free_doc`/`free_result`.
weave check_document with st as ref to State, document_uri as string, text as string into ref to sema_api.SemaResult:
    var base as string is calling copy with st->root
    if base length == 0:
        banish base
        set base is "."
    var opts as sopts.SemaOptions is calling sopts.default_options with (calling copy with base)
    banish base
    if st->std_dir length > 0:
        calling opts.std_dirs.push with (calling npool.copy_string with st->std_dir)
    var path as string is calling luri.uri_to_path with document_uri
    var sr as sema_api.SemaResult is calling sema_api.check_text with path, text, opts
    banish path
    var sp as ref to sema_api.SemaResult is calling memoria.alloc of sema_api.SemaResult
    set essence of sp is sr
    return sp

## Rango LSP de un span, leyendo el fuente si el span es de otro archivo.
##
## ## Memoria
## Devuelve un `JsonValue` owned.
weave span_range with path as string, text as string, span as diag.Span into JsonValue:
    if span.file length > 0 and span.file != path:
        var other as maybe string is calling archivum.read_text with span.file
        if other.is_present:
            var ot as string is other.value
            var r as JsonValue is calling lpos.range_json with ot, span.start_byte, span.end_byte
            banish ot
            banish other
            return r
        banish other
    return calling lpos.range_json with text, span.start_byte, span.end_byte

## Construye un `Diagnostic` LSP con help/note y relatedInformation.
##
## ## Memoria
## Devuelve owned.
weave diag_to_lsp with path as string, text as string, d as diag.Diagnostic into JsonValue:
    var o as JsonValue is calling JsonValue.empty_object
    var msp as maybe diag.Span is calling main_span with d
    if msp.is_present:
        calling o.put_json with "range", (calling span_range with path, text, msp.value)
    else:
        calling o.put_json with "range", (calling lpos.range_json with text, 0, 0)
    banish msp
    calling o.put_json with "severity", (calling JsonValue.int_val with ((calling severity_num with d.severity) to i64))
    if d.code length > 0:
        calling o.put_json with "code", (calling JsonValue.string_val with (calling copy with d.code))
    calling o.put_json with "source", (calling JsonValue.string_val with (calling copy with "psc"))
    var msgb as StringBuilder is calling StringBuilder.new
    calling msgb.append with d.message
    if d.help.is_present:
        var hv as string is d.help.value
        if hv length > 0:
            calling msgb.append with "\n\nhelp: "
            calling msgb.append with hv
    if d.note.is_present:
        var nv as string is d.note.value
        if nv length > 0:
            calling msgb.append with "\n\nnote: "
            calling msgb.append with nv
    var msg as string is calling msgb.finish
    banish msgb
    calling o.put_json with "message", (calling JsonValue.string_val with (calling npool.copy_string with msg))
    banish msg
    var related as JsonValue is calling JsonValue.empty_array
    for lb in d.labels:
        if not lb.primary:
            var uri2 as string is calling luri.path_to_uri with lb.span.file
            var loc as JsonValue is calling JsonValue.empty_object
            calling loc.put_json with "uri", (calling JsonValue.string_val with (calling copy with uri2))
            calling loc.put_json with "range", (calling span_range with path, text, lb.span)
            banish uri2
            var ri as JsonValue is calling JsonValue.empty_object
            calling ri.put_json with "location", loc
            calling ri.put_json with "message", (calling JsonValue.string_val with (calling copy with lb.message))
            calling related.push_json with ri
    for rd in d.related:
        var rmsp as maybe diag.Span is calling main_span with rd
        if rmsp.is_present:
            var ri2 as JsonValue is calling JsonValue.empty_object
            var uri3 as string is calling luri.path_to_uri with rmsp.value.file
            var loc2 as JsonValue is calling JsonValue.empty_object
            calling loc2.put_json with "uri", (calling JsonValue.string_val with (calling copy with uri3))
            calling loc2.put_json with "range", (calling span_range with path, text, rmsp.value)
            calling ri2.put_json with "location", loc2
            calling ri2.put_json with "message", (calling JsonValue.string_val with (calling copy with rd.message))
            calling related.push_json with ri2
            banish uri3
        banish rmsp
    if calling related.array_len > 0:
        calling o.put_json with "relatedInformation", related
    else:
        banish related
    return o

## Publica los diagnósticos de un resultado ya chequeado.
##
## ## Memoria
## `sr` sigue siendo propiedad del documento.
weave publish with st as ref to State, document_uri as string, version as int, sr as ref to sema_api.SemaResult into void:
    var path as string is calling luri.uri_to_path with document_uri
    defer banish path
    var text as string is calling doc_text with st, document_uri
    defer banish text
    var diagnostics as JsonValue is calling JsonValue.empty_array
    var i as int is 0
    while i < sr->program->diagnostics.items.len:
        var d as diag.Diagnostic is (sr->program->diagnostics.items at i)
        var msp as maybe diag.Span is calling main_span with d
        var same as bool is true
        if msp.is_present:
            if msp.value.file length > 0 and msp.value.file != path:
                set same is false
        banish msp
        if same:
            calling diagnostics.push_json with (calling diag_to_lsp with path, text, d)
        set i is i + 1
    var params as JsonValue is calling JsonValue.empty_object
    calling params.put_json with "uri", (calling JsonValue.string_val with (calling copy with document_uri))
    calling params.put_json with "version", (calling JsonValue.int_val with (version to i64))
    calling params.put_json with "diagnostics", diagnostics
    var note as rpc.JsonRpcMessage is calling rpc.notification with "textDocument/publishDiagnostics", (some params)
    var ok as bool is calling send_msg with st, note
    banish note

## Respuesta initialize.
weave initialize_result into JsonValue:
    var cap as JsonValue is calling JsonValue.empty_object
    calling cap.put_json with "textDocumentSync", (calling JsonValue.int_val with 1)
    calling cap.put_json with "hoverProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "definitionProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "documentSymbolProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "referencesProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "documentHighlightProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "foldingRangeProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "documentFormattingProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "implementationProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "workspaceSymbolProvider", (calling JsonValue.bool_val with true)
    var cl as JsonValue is calling JsonValue.empty_object
    calling cap.put_json with "codeLensProvider", cl
    var stp as JsonValue is calling JsonValue.empty_object
    var legend as JsonValue is calling JsonValue.empty_object
    var ttypes as JsonValue is calling JsonValue.empty_array
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "keyword"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "type"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "function"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "variable"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "string"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "number"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "comment"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "namespace"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "parameter"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "property"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "enumMember"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "operator"))
    var mods as JsonValue is calling JsonValue.empty_array
    calling legend.put_json with "tokenTypes", ttypes
    calling legend.put_json with "tokenModifiers", mods
    calling stp.put_json with "legend", legend
    calling stp.put_json with "full", (calling JsonValue.bool_val with true)
    calling cap.put_json with "semanticTokensProvider", stp
    calling cap.put_json with "inlayHintProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "codeActionProvider", (calling JsonValue.bool_val with true)
    var ot as JsonValue is calling JsonValue.empty_object
    calling ot.put_json with "firstTriggerCharacter", (calling JsonValue.string_val with (calling copy with ":"))
    var otm as JsonValue is calling JsonValue.empty_array
    calling ot.put_json with "moreTriggerCharacters", otm
    calling cap.put_json with "documentOnTypeFormattingProvider", ot
    var sh as JsonValue is calling JsonValue.empty_object
    var shc as JsonValue is calling JsonValue.empty_array
    calling shc.push_json with (calling JsonValue.string_val with (calling copy with "("))
    calling shc.push_json with (calling JsonValue.string_val with (calling copy with ","))
    calling sh.put_json with "triggerCharacters", shc
    calling cap.put_json with "signatureHelpProvider", sh
    var comp as JsonValue is calling JsonValue.empty_object
    var ctrig as JsonValue is calling JsonValue.empty_array
    calling ctrig.push_json with (calling JsonValue.string_val with (calling copy with "."))
    calling ctrig.push_json with (calling JsonValue.string_val with (calling copy with ":"))
    calling comp.put_json with "triggerCharacters", ctrig
    calling cap.put_json with "completionProvider", comp
    var out as JsonValue is calling JsonValue.empty_object
    calling out.put_json with "capabilities", cap
    var info as JsonValue is calling JsonValue.empty_object
    calling info.put_json with "name", (calling JsonValue.string_val with (calling copy with "psc"))
    calling info.put_json with "version", (calling JsonValue.string_val with (calling copy with "0.16.1"))
    calling out.put_json with "serverInfo", info
    return out

## Responde initialize.
weave handle_initialize with st as ref to State, id as rpc.JsonRpcId, params as maybe JsonValue into void:
    if params.is_present:
        var rp as string is calling field_string with params.value, "rootUri"
        if rp length > 0:
            var rpath as string is calling luri.uri_to_path with rp
            banish rp
            set st->root is rpath
        else:
            banish rp
        var pv as JsonValue is params.value
        var io as maybe JsonValue is calling pv.get with "initializationOptions"
        if io.is_present:
            var sd as string is calling field_string with io.value, "stdDir"
            if sd length > 0:
                banish st->std_dir
                set st->std_dir is sd
            else:
                banish sd
            set st->inlay_enabled is calling field_bool with io.value, "inlayHints", true
            set st->semantic_enabled is calling field_bool with io.value, "semanticHighlighting", true
        banish io
    var res as JsonValue is calling initialize_result
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out
    set st->initialized is true

## Responde shutdown.
weave handle_shutdown with st as ref to State, id as rpc.JsonRpcId into void:
    set st->shutdown is true
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), (calling JsonValue.null_value)
    var ok as bool is calling send_msg with st, out
    banish out

## Obtiene un string de un objeto.
weave field_string with v as JsonValue, key as string into string:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv as JsonValue is f.value
        var s as maybe string is calling fv.as_string
        banish f
        if s.is_present:
            var out as string is calling copy with s.value
            banish s
            return out
        banish s
    banish f
    return ""

## Obtiene un bool de un objeto.
weave field_bool with v as JsonValue, key as string, dflt as bool into bool:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv as JsonValue is f.value
        var b as maybe bool is calling fv.as_bool
        banish f
        if b.is_present:
            return b.value
        banish b
    banish f
    return dflt

## Obtiene un int de un objeto.
weave field_int with v as JsonValue, key as string, dflt as int into int:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv2 as JsonValue is f.value
        var i as maybe i64 is calling fv2.as_int
        banish f
        if i.is_present:
            return (i.value to int)
        banish i
    banish f
    return dflt

## didOpen.
weave did_open with st as ref to State, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    if not td.is_present:
        banish td
        return
    var u as string is calling field_string with td.value, "uri"
    var text as string is calling field_string with td.value, "text"
    var ver as int is calling field_int with td.value, "version", 0
    banish td
    var sp as ref to sema_api.SemaResult is calling check_document with st, u, text
    var doc as Document is with text is (calling copy with text), version is ver, sema is sp
    calling st->docs.put with (calling copy with u), doc
    set st->ws_ready is false
    calling publish with st, u, ver, sp
    banish text
    banish u

## didChange (full sync).
weave did_change with st as ref to State, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    if not td.is_present:
        banish td
        return
    var u as string is calling field_string with td.value, "uri"
    var ver as int is calling field_int with td.value, "version", 0
    banish td
    var cget as maybe JsonValue is calling params.get with "contentChanges"
    if not cget.is_present:
        banish cget
        banish u
        return
    var cgv as JsonValue is cget.value
    var changes as maybe list of JsonValue is calling cgv.as_array
    banish cget
    if changes.is_present:
        if changes.value.len > 0:
            var text as string is calling field_string with (changes.value at 0), "text"
            var changed as bool is true
            var have_old as bool is calling st->docs.has with u
            if have_old:
                var old_doc as Document is (st->docs at u)
                if old_doc.text == text:
                    set changed is false
                else:
                    calling free_doc with (sigil of old_doc)
            if changed:
                var sp as ref to sema_api.SemaResult is calling check_document with st, u, text
                var doc as Document is with text is (calling copy with text), version is ver, sema is sp
                calling st->docs.put with (calling copy with u), doc
                set st->ws_ready is false
                calling publish with st, u, ver, sp
            banish text
        calling json.free_values with changes.value
    banish u

## didClose.
weave did_close with st as ref to State, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    if not td.is_present:
        banish td
        return
    var u as string is calling field_string with td.value, "uri"
    banish td
    if calling st->docs.has with u:
        var old as Document is (st->docs at u)
        calling free_doc with (sigil of old)
    var ignr as bool is calling st->docs.remove with u
    var arr as JsonValue is calling JsonValue.empty_array
    var p2 as JsonValue is calling JsonValue.empty_object
    calling p2.put_json with "uri", (calling JsonValue.string_val with (calling copy with u))
    calling p2.put_json with "diagnostics", arr
    var note as rpc.JsonRpcMessage is calling rpc.notification with "textDocument/publishDiagnostics", (some p2)
    var ok as bool is calling send_msg with st, note
    banish note
    banish u

## ¿Carácter de identificador?
weave is_word with c as int into bool:
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

## Texto del documento abierto.
weave doc_text with st as ref to State, u as string into string:
    if calling st->docs.has with u:
        var d as Document is (st->docs at u)
        return calling copy with d.text
    var path as string is calling luri.uri_to_path with u
    var t as maybe string is calling archivum.read_text with path
    banish path
    if t.is_present:
        var out as string is calling copy with t.value
        banish t
        return out
    banish t
    return ""

## Palabra bajo un offset.
weave word_at with text as string, off as int into string:
    var b as ref to frozen byte is bytes of text
    var start as int is off
    while start > 0 and calling is_word with ((b at (start - 1)) to int):
        set start is start - 1
    var end as int is off
    while end < text length and calling is_word with ((b at end) to int):
        set end is end + 1
    return text at start to end

## `SemaResult` de un documento abierto (`-1` no aplica; el llamador comprueba).
weave doc_sema with st as ref to State, u as string into ref to sema_api.SemaResult:
    var d as Document is (st->docs at u)
    return d.sema

## Módulo semántico de un documento abierto (`-1` si no).
weave doc_module with st as ref to State, u as string into int:
    if not calling st->docs.has with u:
        return -1
    var d as Document is (st->docs at u)
    var path as string is calling luri.uri_to_path with u
    defer banish path
    return calling query.module_for_uri_path with d.sema->program, path

## `true` si el símbolo es de tipo nominal/estructura.
weave is_type_symbol with sid_kind as sym.SemaSymbolKind into bool:
    return sid_kind == sym.SemaSymbolKind.SkRune or sid_kind == sym.SemaSymbolKind.SkEcho or sid_kind == sym.SemaSymbolKind.SkOmen or sid_kind == sym.SemaSymbolKind.SkAlias or sid_kind == sym.SemaSymbolKind.SkSeal or sid_kind == sym.SemaSymbolKind.SkConcept or sid_kind == sym.SemaSymbolKind.SkType

## Añade campos/variantes de un tipo nominal a un hover.
##
## ## Memoria
## No retiene; libera los strings auxiliares.
weave hover_type_details with p as ref to sema_api.SemaResult, sb as ref to StringBuilder, type_id as int into void:
    var ty as tk.SemaType is calling types.at with (sigil of p->program->types), type_id
    if ty.a < 0 or ty.a >= p->program->types.nominal_infos.len:
        return
    var info as types.SemaNominalInfo is (p->program->types.nominal_infos at ty.a)
    if (ty.kind == tk.SemaTypeKind.TkRune or ty.kind == tk.SemaTypeKind.TkEcho) and info.fields_count > 0:
        calling sb.append with "```pengu
"
        var fi as int is 0
        while fi < info.fields_count:
            var f as types.SemaField is (p->program->types.fields at (info.fields_first + fi))
            var fn as string is calling npool.text with (sigil of p->program->names), f.name
            var ft as string is calling query.type_text with p->program, f.type
            calling sb.append with "    {fn} as {ft}
"
            banish ft
            set fi is fi + 1
        calling sb.append with "```

"
    else if ty.kind == tk.SemaTypeKind.TkOmen and info.variants_count > 0:
        calling sb.append with "```pengu
"
        var vi as int is 0
        while vi < info.variants_count:
            var v as types.SemaVariant is (p->program->types.variants at (info.variants_first + vi))
            var vn as string is calling npool.text with (sigil of p->program->names), v.name
            calling sb.append with "    {vn}
"
            set vi is vi + 1
        calling sb.append with "```

"

## Markdown de hover para un símbolo.
##
## ## Memoria
## Devuelve string owned.
weave symbol_hover with p as ref to sema_api.SemaResult, sid as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var si as sym.SemaSymbol is calling query.symbol_at with p->program, sid
    var nm as string is calling query.symbol_name with p->program, sid
    var kn as string is calling sym.symbol_kind_name with si.kind
    var ty as string is calling query.type_text with p->program, si.type
    if si.kind == sym.SemaSymbolKind.SkImport:
        calling sb.append with "```pengu
import {nm}
```

"
        var mscope as int is si.module_scope
        var mid2 as int is calling query.module_for_scope with p->program, mscope
        if mid2 >= 0:
            var exports as list of int is calling query.module_exports with p->program, mid2
            calling sb.append with "**Exported symbols**: "
            var ei as int is 0
            var first as bool is true
            while ei < exports.len and ei < 40:
                if not first:
                    calling sb.append with ", "
                var en as string is calling query.symbol_name with p->program, (exports at ei)
                calling sb.append with "`{en}`"
                set first is false
                set ei is ei + 1
            calling sb.append with "

"
            banish exports
        banish ty
        return calling sb.finish
    if si.kind == sym.SemaSymbolKind.SkWeave or si.kind == sym.SemaSymbolKind.SkDeclare or si.kind == sym.SemaSymbolKind.SkConst:
        var sig as string is calling query.signature_for with p->program, sid
        if sig length > 0:
            calling sb.append with "```pengu
{sig}
```

"
            banish sig
        else:
            banish sig
            calling sb.append with "```pengu
{kn} {nm}: {ty}
```

"
    else:
        calling sb.append with "```pengu
{kn} {nm}: {ty}
```

"
    var size as int is calling query.type_size with p->program, si.type
    if size > 0:
        calling sb.append with "**Size:** ≈ {size} bytes

"
    if calling is_type_symbol with si.kind:
        calling hover_type_details with p, (sigil of sb), si.type
    var doc as string is calling query.symbol_doc with p->program, sid
    if doc length > 0:
        calling sb.append with "---

"
        calling sb.append with doc
        calling sb.append with "
"
    banish ty
    return calling sb.finish

## Documentación breve de keywords para hover.
##
## ## Memoria
## Devuelve literal prestado o `""`.
weave keyword_doc with w as string into string:
    if w == "weave":
        return "**weave**: declara una función o método."
    if w == "rune":
        return "**rune**: declara una estructura de campos tipados."
    if w == "echo":
        return "**echo**: declara una unión etiquetada compatible con C."
    if w == "omen":
        return "**omen**: declara un tipo algebraico (enum con payloads)."
    if w == "set":
        return "**set**: asigna un valor a una variable o campo mutable."
    if w == "with":
        return "**with**: abre un bloque de inicialización/acceso implícito a campos."
    if w == "judge":
        return "**judge**: pattern matching sobre un valor."
    if w == "when":
        return "**when**: rama de `judge` o condición de compilación."
    if w == "calling":
        return "**calling**: invoca una función o método."
    if w == "let":
        return "**let**: binding inmutable."
    if w == "var":
        return "**var**: variable mutable."
    return ""

## Línea de una declaración que contiene `word`, o `""`.
weave decl_line with text as string, word as string into string:
    var b as ref to frozen byte is bytes of text
    var start as int is 0
    while start <= text length:
        var end as int is start
        while end < text length and ((b at end) to int) != 10:
            set end is end + 1
        var line as string is text at start to end
        var keys as list of string is list of string
        calling keys.push with "weave "
        calling keys.push with "rune "
        calling keys.push with "echo "
        calling keys.push with "omen "
        calling keys.push with "const "
        var hit as bool is false
        for k in keys:
            var needle as string is "{k}{word}"
            if calling scrolls.contains with line, needle:
                set hit is true
            banish needle
        for k in keys:
            banish k
        banish keys
        if hit:
            return line
        banish line
        if end >= text length:
            break
        set start is end + 1
    return ""

## Hover básico.
weave handle_hover with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var res as JsonValue is calling JsonValue.null_value
    var value as string is ""
    if calling st->docs.has with u:
        var mid as int is calling doc_module with st, u
        if mid >= 0:
            var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
            var sid as int is calling query.symbol_at_offset with sp->program, mid, text, off
            if sid >= 0:
                set value is calling symbol_hover with sp, sid
            else:
                var w as string is calling word_at with text, off
                defer banish w
                set value is calling keyword_doc with w
    else:
        var w2 as string is calling word_at with text, off
        defer banish w2
        set value is calling keyword_doc with w2
    if value length > 0:
        var contents as JsonValue is calling JsonValue.empty_object
        calling contents.put_json with "kind", (calling JsonValue.string_val with (calling copy with "markdown"))
        calling contents.put_json with "value", (calling JsonValue.string_val with (calling copy with value))
        var hov as JsonValue is calling JsonValue.empty_object
        calling hov.put_json with "contents", contents
        set res is hov
        banish value
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Definition semántica (local, misma archivo o std/módulo importado).
weave handle_definition with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var res as JsonValue is calling JsonValue.null_value
    if calling st->docs.has with u:
        var mid as int is calling doc_module with st, u
        if mid >= 0:
            var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
            var sid as int is calling query.symbol_at_offset with sp->program, mid, text, off
            if sid >= 0:
                var si as sym.SemaSymbol is calling query.symbol_at with sp->program, sid
                var target_mid as int is si.module
                var target_start as int is si.start
                var target_end as int is si.end
                if si.kind == sym.SemaSymbolKind.SkImport and si.module_scope >= 0:
                    set target_mid is calling query.module_for_scope with sp->program, si.module_scope
                    if target_mid >= 0:
                        set target_start is 0
                        set target_end is 0
                if target_mid >= 0 and target_mid < sp->program->modules.len:
                    var tm as loader.SemaModule is (sp->program->modules at target_mid)
                    var uri2 as string is calling luri.path_to_uri with tm.path
                    var loc as JsonValue is calling JsonValue.empty_object
                    calling loc.put_json with "uri", (calling JsonValue.string_val with (calling copy with uri2))
                    if target_start < 0:
                        calling loc.put_json with "range", (calling lpos.range_json with text, 0, 0)
                    else:
                        var ttext as string is calling copy with tm.source.text
                        calling loc.put_json with "range", (calling lpos.range_json with ttext, target_start, target_end)
                        banish ttext
                    set res is loc
                    banish uri2
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Nombre declarado en una línea, o `""`.
weave decl_name_line with line as string into string:
    var b as ref to frozen byte is bytes of line
    var i as int is 0
    while i < line length and (((b at i) to int) == 32 or ((b at i) to int) == 9):
        set i is i + 1
    var rest as string is line at i to (line length)
    var kw as int is 0
    if calling starts_with with rest, "weave ":
        set kw is 6
    else if calling starts_with with rest, "rune ":
        set kw is 5
    else if calling starts_with with rest, "echo ":
        set kw is 5
    else if calling starts_with with rest, "omen ":
        set kw is 5
    else if calling starts_with with rest, "const ":
        set kw is 6
    if kw == 0:
        banish rest
        return ""
    var rb as ref to frozen byte is bytes of rest
    var j as int is kw
    while j < rest length and calling is_word with ((rb at j) to int):
        set j is j + 1
    var nm as string is rest at kw to j
    banish rest
    return nm

## Kind LSP de un símbolo para el outline.
weave symbol_kind_lsp with k as sym.SemaSymbolKind into int:
    if k == sym.SemaSymbolKind.SkRune or k == sym.SemaSymbolKind.SkEcho:
        return 23
    if k == sym.SemaSymbolKind.SkOmen:
        return 10
    if k == sym.SemaSymbolKind.SkConcept:
        return 11
    if k == sym.SemaSymbolKind.SkConst:
        return 14
    if k == sym.SemaSymbolKind.SkImport:
        return 2
    if k == sym.SemaSymbolKind.SkParam or k == sym.SemaSymbolKind.SkLet or k == sym.SemaSymbolKind.SkVar:
        return 13
    return 12

## Document symbols desde la tabla de símbolos.
weave handle_document_symbols with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    var mid as int is calling doc_module with st, u
    if mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var ids as list of int is calling query.module_symbols with sp->program, mid
        var i as int is 0
        while i < ids.len:
            var sid as int is (ids at i)
            var si as sym.SemaSymbol is calling query.symbol_at with sp->program, sid
            if si.start >= 0:
                var item as JsonValue is calling JsonValue.empty_object
                var nm as string is calling query.symbol_name with sp->program, sid
                calling item.put_json with "name", (calling JsonValue.string_val with (calling copy with nm))
                calling item.put_json with "kind", (calling JsonValue.int_val with ((calling symbol_kind_lsp with si.kind) to i64))
                var ty as string is calling query.type_text with sp->program, si.type
                if ty length > 0:
                    calling item.put_json with "detail", (calling JsonValue.string_val with (calling copy with ty))
                banish ty
                calling item.put_json with "range", (calling lpos.range_json with text, si.start, si.end)
                calling item.put_json with "selectionRange", (calling lpos.range_json with text, si.start, si.end)
                calling arr.push_json with item
            set i is i + 1
        banish ids
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## `true` si `s` termina en `suffix`.
weave ends_with with s as string, suffix as string into bool:
    var n as int is s length
    var m as int is suffix length
    if m > n:
        return false
    return (s at (n - m) to n) == suffix

## Añade una completion si no existe.
##
## ## Memoria
## Copia label/detail/insert/doc; no retiene los parámetros.
weave add_completion with arr as ref to JsonValue, seen as ref to map of string to bool, label as string, kind as int, detail as string, insert as string, doc as string into void:
    if label length == 0 or calling seen->has with label:
        return
    calling seen->put with (calling copy with label), true
    var item as JsonValue is calling JsonValue.empty_object
    calling item.put_json with "label", (calling JsonValue.string_val with (calling copy with label))
    calling item.put_json with "kind", (calling JsonValue.int_val with (kind to i64))
    if detail length > 0:
        calling item.put_json with "detail", (calling JsonValue.string_val with (calling copy with detail))
    if insert length > 0:
        calling item.put_json with "insertText", (calling JsonValue.string_val with (calling copy with insert))
    if doc length > 0:
        var d as JsonValue is calling JsonValue.empty_object
        calling d.put_json with "kind", (calling JsonValue.string_val with (calling copy with "markdown"))
        calling d.put_json with "value", (calling JsonValue.string_val with (calling copy with doc))
        calling item.put_json with "documentation", d
    calling arr.push_json with item

## Kind LSP de un símbolo.
weave completion_kind with k as sym.SemaSymbolKind into int:
    if k == sym.SemaSymbolKind.SkWeave or k == sym.SemaSymbolKind.SkDeclare or k == sym.SemaSymbolKind.SkTest:
        return 3
    if k == sym.SemaSymbolKind.SkRune or k == sym.SemaSymbolKind.SkEcho or k == sym.SemaSymbolKind.SkOmen or k == sym.SemaSymbolKind.SkType:
        return 7
    if k == sym.SemaSymbolKind.SkConcept:
        return 8
    if k == sym.SemaSymbolKind.SkImport:
        return 9
    if k == sym.SemaSymbolKind.SkConst:
        return 21
    return 6

## Añade un símbolo semántico a la lista.
##
## ## Memoria
## Libera el texto de tipo.
weave add_symbol_completion with p as ref to sema_api.SemaResult, arr as ref to JsonValue, seen as ref to map of string to bool, sid as int, prefix as string into void:
    var nm as string is calling query.symbol_name with p->program, sid
    if nm length == 0:
        return
    if prefix length > 0 and not (calling starts_with with nm, prefix):
        return
    var si as sym.SemaSymbol is calling query.symbol_at with p->program, sid
    var ty as string is calling query.type_text with p->program, si.type
    var doc as string is calling query.symbol_doc with p->program, sid
    calling add_completion with arr, seen, nm, (calling completion_kind with si.kind), ty, "", doc
    banish ty

## Stem de un archivo de módulo (`spark.pengu` -> `spark`).
weave module_stem with name as string into string:
    if calling ends_with with name, ".d.pengu":
        return name at 0 to (name length - 8)
    if calling ends_with with name, ".pengu":
        return name at 0 to (name length - 6)
    return ""

## Añade los módulos `std.*` de los directorios configurados.
##
## ## Memoria
## Libera las listas de `read_dir`.
weave add_std_modules with p as ref to sema_api.SemaResult, arr as ref to JsonValue, seen as ref to map of string to bool, prefix as string into void:
    var dirs as list of string is calling query.std_dirs with p->program
    var di as int is 0
    while di < dirs.len:
        var dir as string is (dirs at di)
        var ents as maybe list of string is calling archivum.read_dir with dir
        if ents.is_present:
            var names as list of string is ents.value
            var i as int is 0
            while i < names.len:
                var name as string is (names at i)
                var st as string is calling module_stem with name
                if st length > 0 and st != "__init__":
                    var label as string is "std.{st}"
                    if prefix length == 0 or calling starts_with with st, prefix:
                        var ins as string is calling copy with st
                        calling add_completion with arr, seen, label, 9, "stdlib module", ins, ""
                        banish ins
                banish names at i
                set i is i + 1
            banish names
        banish ents
        set di is di + 1

## Añade exports de un módulo importado.
##
## ## Memoria
## Libera la lista de exports.
weave add_module_exports with p as ref to sema_api.SemaResult, arr as ref to JsonValue, seen as ref to map of string to bool, mid as int, prefix as string into void:
    var exps as list of int is calling query.module_exports with p->program, mid
    var i as int is 0
    while i < exps.len:
        calling add_symbol_completion with p, arr, seen, (exps at i), prefix
        set i is i + 1
    banish exps

## Completion semántica.
weave handle_completion with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var ls as int is calling lpos.line_start with text, line
    var before as string is text at ls to off
    defer banish before
    var pstart as int is off
    var pb as ref to frozen byte is bytes of text
    while pstart > 0 and calling is_word with ((pb at (pstart - 1)) to int):
        set pstart is pstart - 1
    var prefix as string is text at pstart to off
    defer banish prefix
    var arr as JsonValue is calling JsonValue.empty_array
    var seen as map of string to bool is map of string to bool
    var mid as int is calling doc_module with st, u
    var handled_member as bool is false
    if mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var dot as int is calling scrolls.rfind with before, "."
        if dot >= 0:
            var left as string is before at 0 to dot
            defer banish left
            var alias_full as string is calling scrolls.trim with left
            defer banish alias_full
            var spc as int is calling scrolls.rfind with alias_full, " "
            var alias as string is alias_full at (spc + 1) to (alias_full length)
            defer banish alias
            if alias == "std":
                calling add_std_modules with sp, (sigil of arr), (sigil of seen), prefix
                set handled_member is true
            else:
                var imp as int is calling query.imported_module with sp->program, mid, alias
                if imp >= 0:
                    calling add_module_exports with sp, (sigil of arr), (sigil of seen), imp, prefix
                    set handled_member is true
    if not handled_member:
        var kt as pstoken.KeywordTable is calling pstoken.keyword_table_new
        defer banish kt
        var ki as int is 0
        while ki < kt.entries.len:
            var kw as pstoken.KeywordEntry is (kt.entries at ki)
            if prefix length == 0 or calling starts_with with kw.word, prefix:
                calling add_completion with (sigil of arr), (sigil of seen), kw.word, 14, "keyword", "", ""
            set ki is ki + 1
        var soft as list of string is list of string
        calling soft.push with "self"
        calling soft.push with "frozen"
        calling soft.push with "inline"
        calling soft.push with "ritual"
        calling soft.push with "present"
        calling soft.push with "main"
        calling soft.push with "ok"
        calling soft.push with "err"
        calling soft.push with "unsafe"
        calling soft.push with "over"
        calling soft.push with "do"
        var sfi as int is 0
        while sfi < soft.len:
            var w as string is (soft at sfi)
            if prefix length == 0 or calling starts_with with w, prefix:
                calling add_completion with (sigil of arr), (sigil of seen), w, 14, "keyword", "", ""
            banish soft at sfi
            set sfi is sfi + 1
        banish soft
        if mid >= 0:
            var sp2 as ref to sema_api.SemaResult is calling doc_sema with st, u
            var i as int is 0
            while i < sp2->program->symbols.symbols.len:
                var si as sym.SemaSymbol is (sp2->program->symbols.symbols at i)
                if si.name >= 0 and (si.module == mid or si.module == -1):
                    if si.kind != sym.SemaSymbolKind.SkImport:
                        calling add_symbol_completion with sp2, (sigil of arr), (sigil of seen), i, prefix
                set i is i + 1
            var aliases as list of string is calling query.import_aliases with sp2->program, mid
            var ai as int is 0
            while ai < aliases.len:
                var a as string is (aliases at ai)
                if prefix length == 0 or calling starts_with with a, prefix:
                    calling add_completion with (sigil of arr), (sigil of seen), a, 9, "imported module", "", ""
                banish aliases at ai
                set ai is ai + 1
            banish aliases
    banish seen
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Añade una Location de una ocurrencia.
weave add_occurrence with arr as ref to JsonValue, text as string, u as string, start as int, end as int into void:
    var loc as JsonValue is calling JsonValue.empty_object
    calling loc.put_json with "uri", (calling JsonValue.string_val with (calling copy with u))
    calling loc.put_json with "range", (calling lpos.range_json with text, start, end)
    calling arr.push_json with loc

## References.
weave handle_references with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var word as string is calling word_at with text, off
    var arr as JsonValue is calling JsonValue.empty_array
    if word length > 0:
        var b as ref to frozen byte is bytes of text
        var i as int is 0
        while i < text length:
            if calling is_word with ((b at i) to int):
                var s0 as int is i
                while i < text length and calling is_word with ((b at i) to int):
                    set i is i + 1
                var w as string is text at s0 to i
                if w == word:
                    calling add_occurrence with (sigil of arr), text, u, s0, i
                banish w
            else:
                set i is i + 1
    banish word
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Highlight.
