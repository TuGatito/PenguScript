## Indentación de una línea.
weave indent_len with line as string into int:
    var b as ref to frozen byte is bytes of line
    var i as int is 0
    while i < line length and (((b at i) to int) == 32 or ((b at i) to int) == 9):
        set i is i + 1
    return i

## Folding por bloques con `:` e indentación.
weave handle_folding with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    var lines as list of string is calling text.split with "\n"
    var i as int is 0
    while i < lines.len:
        var line as string is (lines at i)
        var t as string is line
        var b as ref to frozen byte is bytes of t
        var e as int is t length
        while e > 0 and (((b at (e - 1)) to int) == 32 or ((b at (e - 1)) to int) == 9):
            set e is e - 1
        if e > 0:
            var base as int is calling indent_len with t
            var next_indent as int is 0
            if i + 1 < lines.len:
                var nxt as string is (lines at (i + 1))
                set next_indent is calling indent_len with nxt
                banish nxt
            if i + 1 < lines.len and next_indent > base:
                var j as int is i + 1
                var jind as int is 0
                while j < lines.len:
                    var jl as string is (lines at j)
                    set jind is calling indent_len with jl
                    banish jl
                    if jind <= base:
                        break
                    set j is j + 1
                var item as JsonValue is calling JsonValue.empty_object
                calling item.put_json with "startLine", (calling JsonValue.int_val with (i to i64))
                calling item.put_json with "endLine", (calling JsonValue.int_val with ((j - 1) to i64))
                calling arr.push_json with item
        banish t
        banish line
        set i is i + 1
    banish lines
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Formatea con el `psc fmt` de F7.
weave handle_formatting with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var stamp as string is "{calling chronicle.now_ms}-{calling rites.getpid}"
    var tmp as string is "/tmp/psc-lsp-fmt-{stamp}.pengu"
    var out as string is "/tmp/psc-lsp-fmt-{stamp}.out"
    var res as JsonValue is calling JsonValue.null_value
    if calling archivum.write_text with tmp, text:
        var cmd as string is "{st->exe} fmt --stdin < {tmp} > {out}"
        var code as int is calling rites.exec with cmd, list of string
        banish cmd
        if code == 0:
            var ot as maybe string is calling archivum.read_text with out
            if ot.is_present:
                if ot.value != text:
                    var edits as JsonValue is calling JsonValue.empty_array
                    var edit as JsonValue is calling JsonValue.empty_object
                    calling edit.put_json with "range", (calling lpos.range_json with text, 0, text length)
                    calling edit.put_json with "newText", (calling JsonValue.string_val with (calling copy with ot.value))
                    calling edits.push_json with edit
                    set res is edits
                banish ot
        var d1 as bool is calling archivum.delete_file with tmp
        var d2 as bool is calling archivum.delete_file with out
    banish tmp
    banish out
    banish text
    banish u
    var outmsg as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, outmsg
    banish outmsg

## Rename: recoge ocurrencias y produce TextEdits.
weave handle_rename with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    var newname as string is calling field_string with params, "newName"
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var word as string is calling word_at with text, off
    var res as JsonValue is calling JsonValue.null_value
    if word length > 0 and newname length > 0:
        var edits as JsonValue is calling JsonValue.empty_array
        var b as ref to frozen byte is bytes of text
        var i as int is 0
        while i < text length:
            if calling is_word with ((b at i) to int):
                var s0 as int is i
                while i < text length and calling is_word with ((b at i) to int):
                    set i is i + 1
                var w as string is text at s0 to i
                if w == word:
                    var edit as JsonValue is calling JsonValue.empty_object
                    calling edit.put_json with "range", (calling lpos.range_json with text, s0, i)
                    calling edit.put_json with "newText", (calling JsonValue.string_val with (calling copy with newname))
                    calling edits.push_json with edit
                banish w
            else:
                set i is i + 1
        var changes as JsonValue is calling JsonValue.empty_object
        calling changes.put_json with u, edits
        var wr as JsonValue is calling JsonValue.empty_object
        calling wr.put_json with "changes", changes
        set res is wr
    banish newname
    banish word
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Prepare rename.
weave handle_prepare_rename with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
