## psc/lsp/server.pengu — servidor LSP mínimo (lifecycle + diagnósticos).

import std.builder
import std.rites
import std.chronicle
import std.archivum
import std.diagnostic as diag
import std.json as json
import std.jsonrpc as rpc
import std.memoria
import std.scrolls
import std.spark

import psc.ast.kind as pskind
import psc.lexer_state as psstate
import psc.lsp.docs as docs
import psc.lsp.layout as layout
import psc.lsp.positions as lpos
import psc.lsp.query as query
import psc.lsp.transport as transport
import psc.lsp.uri as luri
import psc.sema.api as sema_api
import psc.sema.ast as astutil
import psc.sema.modules.loader as loader
import psc.sema.modules.program as program
import psc.sema.names as npool
import psc.sema.options as sopts
import psc.sema.symbols.symbol as sym
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.token as pstoken

insignia psc_lsp_server_

## Documento abierto.
rune Document:
    text as string
    version as int
    ## Resultado semántico owned; `free_doc` lo libera.
    sema as ref to sema_api.SemaResult

## Estado del servidor.
rune State:
    tr as transport.Transport
    docs as map of string to Document
    uris as list of string
    root as string
    exe as string
    std_dir as string
    inlay_enabled as bool
    inlay_sizes as bool
    inlay_types as bool
    semantic_enabled as bool
    ws_cache as JsonValue
    ws_ready as bool
    initialized as bool
    shutdown as bool

## `true` si `s` empieza por `p`.
weave starts_with with s as string, p as string into bool:
    var n as int is s length
    var m as int is p length
    if m > n:
        return false
    return (s at 0 to m) == p

## Copia owned.
weave copy with s as string into string:
    return calling npool.copy_string with s

## Añade a `out` las etiquetas de parámetro de `inner` (`a: int, b: int`).
##
## ## Memoria
## Cada etiqueta es un string owned (el llamador lo banea); `inner` se presta.
weave collect_param_labels with inner as string, out as ref to list of string into void:
    if inner length == 0:
        return
    var raw as list of string is calling inner.split with ","
    for part in raw:
        var lab as string is calling scrolls.trim with part
        if lab length > 0:
            calling out->push with (calling copy with lab)
        banish lab
        banish part
    banish raw

## Copia un id JSON-RPC.
weave copy_id with id as rpc.JsonRpcId into rpc.JsonRpcId:
    var out as rpc.JsonRpcId is with Number is 0
    judge id:
        when Number with value ->
            set out is with Number is value
        when String with value ->
            set out is with String is (calling copy with value)
    return out

## Envía un mensaje.
weave send_msg with st as ref to State, msg as rpc.JsonRpcMessage into bool:
    var wire as string is calling rpc.encode_message with msg
    defer banish wire
    return calling transport.write_frame with (sigil of st->tr), wire

## Envía error de método.
weave send_method_error with st as ref to State, id as rpc.JsonRpcId, method as string into void:
    var err as rpc.JsonRpcError is calling rpc.error_method_not_found with method
    var out as rpc.JsonRpcMessage is calling rpc.response_error with (calling copy_id with id), err
    var ok as bool is calling send_msg with st, out
    banish out

## Número de severidad LSP.
weave severity_num with sev as diag.Severity into int:
    if sev == diag.Severity.Error:
        return 1
    if sev == diag.Severity.Warning:
        return 2
    if sev == diag.Severity.Info:
        return 3
    return 4

## Primer span de un diagnóstico.
weave main_span with d as diag.Diagnostic into maybe diag.Span:
    for lb in d.labels:
        if lb.primary:
            return some lb.span
    if d.labels.len > 0:
        return some ((d.labels at 0).span)
    return (maybe none)

## Construye un diagnóstico LSP.
weave diag_json with text as string, d as diag.Diagnostic into JsonValue:
    var o as JsonValue is calling JsonValue.empty_object
    var msp as maybe diag.Span is calling main_span with d
    var start as int is 0
    var end as int is 0
    if msp.is_present:
        set start is msp.value.start_byte
        set end is msp.value.end_byte
    calling o.put_json with "range", (calling lpos.range_json with text, start, end)
    calling o.put_json with "severity", (calling JsonValue.int_val with ((calling severity_num with d.severity) to i64))
    if d.code length > 0:
        calling o.put_json with "code", (calling JsonValue.string_val with (calling copy with d.code))
    calling o.put_json with "source", (calling JsonValue.string_val with (calling copy with "psc"))
    calling o.put_json with "message", (calling JsonValue.string_val with (calling copy with d.message))
    return o

## Publica diagnósticos para un documento.
## Extrae un int de un objeto.
weave jint with v as JsonValue, key as string, dflt as int into int:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv as JsonValue is f.value
        var i as maybe i64 is calling fv.as_int
        banish f
        if i.is_present:
            return (i.value to int)
        banish i
    banish f
    return dflt

## Extrae un string de un objeto.
weave jstr with v as JsonValue, key as string into string:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv as JsonValue is f.value
        var s as maybe string is calling fv.as_string
        banish f
        if s.is_present:
            var out as string is calling copy with s.value
            banish s
            return out
        banish s
    banish f
    return ""

## Convierte un diagnóstico de `psc check --diagnostics=json` a LSP.
weave subprocess_diag with text as string, o as JsonValue into JsonValue:
    var rng as maybe JsonValue is calling o.get with "range"
    var out as JsonValue is calling JsonValue.empty_object
    if rng.is_present:
        var rv as JsonValue is rng.value
        var st as maybe JsonValue is calling rv.get with "start"
        var en as maybe JsonValue is calling rv.get with "end"
        var sl as int is 0
        var sc as int is 0
        var el as int is 0
        var ec as int is 0
        if st.is_present:
            set sl is calling jint with st.value, "line", 0
            set sc is calling jint with st.value, "character", 0
        if en.is_present:
            set el is calling jint with en.value, "line", sl
            set ec is calling jint with en.value, "character", sc
        banish en
        banish st
        var so as int is (calling lpos.line_start with text, sl) + sc
        var eo as int is (calling lpos.line_start with text, el) + ec
        calling out.put_json with "range", (calling lpos.range_json with text, so, eo)
        banish rng
    else:
        banish rng
        calling out.put_json with "range", (calling lpos.range_json with text, 0, 0)
    calling out.put_json with "severity", (calling JsonValue.int_val with ((calling jint with o, "severity", 1) to i64))
    var code as string is calling jstr with o, "code"
    if code length > 0:
        calling out.put_json with "code", (calling JsonValue.string_val with (calling copy with code))
    banish code
    calling out.put_json with "source", (calling JsonValue.string_val with (calling copy with "psc"))
    var msg as string is calling jstr with o, "message"
    calling out.put_json with "message", (calling JsonValue.string_val with (calling copy with msg))
    banish msg
    return out

## Libera el estado owned de un documento.
##
## ## Memoria
## Libera el `SemaResult` y el texto.
weave free_doc with d as ref to Document into void:
    calling sema_api.free_result with d->sema
    banish d->sema
    banish d->text

## Chequea el texto y devuelve un `SemaResult` owned en heap.
##
## ## Memoria
## El llamador debe liberarlo con `free_doc`/`free_result`.
weave check_document with st as ref to State, document_uri as string, text as string into ref to sema_api.SemaResult:
    var base as string is calling copy with st->root
    if base length == 0:
        banish base
        set base is "."
    var opts as sopts.SemaOptions is calling sopts.default_options with (calling copy with base)
    banish base
    if st->std_dir length > 0:
        calling opts.std_dirs.push with (calling npool.copy_string with st->std_dir)
    var path as string is calling luri.uri_to_path with document_uri
    var sr as sema_api.SemaResult is calling sema_api.check_text with path, text, opts
    banish path
    var sp as ref to sema_api.SemaResult is calling memoria.alloc of sema_api.SemaResult
    set essence of sp is sr
    return sp

## Rango LSP de un span, leyendo el fuente si el span es de otro archivo.
##
## ## Memoria
## Devuelve un `JsonValue` owned.
weave span_range with path as string, text as string, span as diag.Span into JsonValue:
    if span.file length > 0 and span.file != path:
        var other as maybe string is calling archivum.read_text with span.file
        if other.is_present:
            var ot as string is other.value
            var r as JsonValue is calling lpos.range_json with ot, span.start_byte, span.end_byte
            banish ot
            banish other
            return r
        banish other
    return calling lpos.range_json with text, span.start_byte, span.end_byte

## Construye un `Diagnostic` LSP con help/note y relatedInformation.
##
## ## Memoria
## Devuelve owned.
weave diag_to_lsp with path as string, text as string, d as diag.Diagnostic into JsonValue:
    var o as JsonValue is calling JsonValue.empty_object
    var msp as maybe diag.Span is calling main_span with d
    if msp.is_present:
        calling o.put_json with "range", (calling span_range with path, text, msp.value)
    else:
        calling o.put_json with "range", (calling lpos.range_json with text, 0, 0)
    banish msp
    calling o.put_json with "severity", (calling JsonValue.int_val with ((calling severity_num with d.severity) to i64))
    if d.code length > 0:
        calling o.put_json with "code", (calling JsonValue.string_val with (calling copy with d.code))
    calling o.put_json with "source", (calling JsonValue.string_val with (calling copy with "psc"))
    var msgb as StringBuilder is calling StringBuilder.new
    calling msgb.append with d.message
    if d.help.is_present:
        var hv as string is d.help.value
        if hv length > 0:
            calling msgb.append with "\n\nhelp: "
            calling msgb.append with hv
    if d.note.is_present:
        var nv as string is d.note.value
        if nv length > 0:
            calling msgb.append with "\n\nnote: "
            calling msgb.append with nv
    var msg as string is calling msgb.finish
    banish msgb
    calling o.put_json with "message", (calling JsonValue.string_val with (calling npool.copy_string with msg))
    banish msg
    var related as JsonValue is calling JsonValue.empty_array
    for lb in d.labels:
        if not lb.primary:
            var uri2 as string is calling luri.path_to_uri with lb.span.file
            var loc as JsonValue is calling JsonValue.empty_object
            calling loc.put_json with "uri", (calling JsonValue.string_val with (calling copy with uri2))
            calling loc.put_json with "range", (calling span_range with path, text, lb.span)
            banish uri2
            var ri as JsonValue is calling JsonValue.empty_object
            calling ri.put_json with "location", loc
            calling ri.put_json with "message", (calling JsonValue.string_val with (calling copy with lb.message))
            calling related.push_json with ri
    for rd in d.related:
        var rmsp as maybe diag.Span is calling main_span with rd
        if rmsp.is_present:
            var ri2 as JsonValue is calling JsonValue.empty_object
            var uri3 as string is calling luri.path_to_uri with rmsp.value.file
            var loc2 as JsonValue is calling JsonValue.empty_object
            calling loc2.put_json with "uri", (calling JsonValue.string_val with (calling copy with uri3))
            calling loc2.put_json with "range", (calling span_range with path, text, rmsp.value)
            calling ri2.put_json with "location", loc2
            calling ri2.put_json with "message", (calling JsonValue.string_val with (calling copy with rd.message))
            calling related.push_json with ri2
            banish uri3
        banish rmsp
    if calling related.array_len > 0:
        calling o.put_json with "relatedInformation", related
    else:
        banish related
    return o

## Publica los diagnósticos de un resultado ya chequeado.
##
## ## Memoria
## `sr` sigue siendo propiedad del documento.
weave publish with st as ref to State, document_uri as string, version as int, sr as ref to sema_api.SemaResult into void:
    var path as string is calling luri.uri_to_path with document_uri
    defer banish path
    var text as string is calling doc_text with st, document_uri
    defer banish text
    var diagnostics as JsonValue is calling JsonValue.empty_array
    var i as int is 0
    while i < sr->program->diagnostics.items.len:
        var d as diag.Diagnostic is (sr->program->diagnostics.items at i)
        var msp as maybe diag.Span is calling main_span with d
        var same as bool is true
        if msp.is_present:
            if msp.value.file length > 0 and msp.value.file != path:
                set same is false
        banish msp
        if same:
            calling diagnostics.push_json with (calling diag_to_lsp with path, text, d)
        set i is i + 1
    var params as JsonValue is calling JsonValue.empty_object
    calling params.put_json with "uri", (calling JsonValue.string_val with (calling copy with document_uri))
    calling params.put_json with "version", (calling JsonValue.int_val with (version to i64))
    calling params.put_json with "diagnostics", diagnostics
    var note as rpc.JsonRpcMessage is calling rpc.notification with "textDocument/publishDiagnostics", (some params)
    var ok as bool is calling send_msg with st, note
    banish note

## Respuesta initialize.
weave initialize_result into JsonValue:
    var cap as JsonValue is calling JsonValue.empty_object
    var sync as JsonValue is calling JsonValue.empty_object
    calling sync.put_json with "openClose", (calling JsonValue.bool_val with true)
    calling sync.put_json with "change", (calling JsonValue.int_val with 2)
    calling cap.put_json with "textDocumentSync", sync
    calling cap.put_json with "hoverProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "definitionProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "documentSymbolProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "referencesProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "documentHighlightProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "foldingRangeProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "documentFormattingProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "implementationProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "workspaceSymbolProvider", (calling JsonValue.bool_val with true)
    var cl as JsonValue is calling JsonValue.empty_object
    calling cap.put_json with "codeLensProvider", cl
    var stp as JsonValue is calling JsonValue.empty_object
    var legend as JsonValue is calling JsonValue.empty_object
    var ttypes as JsonValue is calling JsonValue.empty_array
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "keyword"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "type"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "function"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "variable"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "string"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "number"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "comment"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "namespace"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "parameter"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "property"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "enumMember"))
    calling ttypes.push_json with (calling JsonValue.string_val with (calling copy with "operator"))
    var mods as JsonValue is calling JsonValue.empty_array
    calling legend.put_json with "tokenTypes", ttypes
    calling legend.put_json with "tokenModifiers", mods
    calling stp.put_json with "legend", legend
    calling stp.put_json with "full", (calling JsonValue.bool_val with true)
    calling cap.put_json with "semanticTokensProvider", stp
    calling cap.put_json with "inlayHintProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "codeActionProvider", (calling JsonValue.bool_val with true)
    var rn as JsonValue is calling JsonValue.empty_object
    calling rn.put_json with "prepareProvider", (calling JsonValue.bool_val with true)
    calling cap.put_json with "renameProvider", rn
    var sh as JsonValue is calling JsonValue.empty_object
    var shc as JsonValue is calling JsonValue.empty_array
    calling shc.push_json with (calling JsonValue.string_val with (calling copy with " "))
    calling shc.push_json with (calling JsonValue.string_val with (calling copy with ","))
    calling sh.put_json with "triggerCharacters", shc
    calling cap.put_json with "signatureHelpProvider", sh
    var comp as JsonValue is calling JsonValue.empty_object
    var ctrig as JsonValue is calling JsonValue.empty_array
    calling ctrig.push_json with (calling JsonValue.string_val with (calling copy with "."))
    calling ctrig.push_json with (calling JsonValue.string_val with (calling copy with ":"))
    calling comp.put_json with "triggerCharacters", ctrig
    calling cap.put_json with "completionProvider", comp
    calling cap.put_json with "positionEncoding", (calling JsonValue.string_val with (calling copy with "utf-16"))
    var out as JsonValue is calling JsonValue.empty_object
    calling out.put_json with "capabilities", cap
    var info as JsonValue is calling JsonValue.empty_object
    calling info.put_json with "name", (calling JsonValue.string_val with (calling copy with "psc"))
    calling info.put_json with "version", (calling JsonValue.string_val with (calling copy with "0.48.0"))
    calling out.put_json with "serverInfo", info
    return out

## Responde initialize.
weave handle_initialize with st as ref to State, id as rpc.JsonRpcId, params as maybe JsonValue into void:
    if params.is_present:
        var rp as string is calling field_string with params.value, "rootUri"
        if rp length > 0:
            var rpath as string is calling luri.uri_to_path with rp
            banish rp
            set st->root is rpath
        else:
            banish rp
        var pv as JsonValue is params.value
        var io as maybe JsonValue is calling pv.get with "initializationOptions"
        if io.is_present:
            var sd as string is calling field_string with io.value, "stdDir"
            if sd length > 0:
                banish st->std_dir
                set st->std_dir is sd
            else:
                banish sd
            set st->inlay_enabled is calling field_bool with io.value, "inlayHints", true
            set st->semantic_enabled is calling field_bool with io.value, "semanticHighlighting", true
            var iov as JsonValue is io.value
            var iho as maybe JsonValue is calling iov.get with "inlayHintOptions"
            if iho.is_present:
                set st->inlay_sizes is calling field_bool with iho.value, "sizes", true
                set st->inlay_types is calling field_bool with iho.value, "types", true
            banish iho
            banish iov
        banish io
    var res as JsonValue is calling initialize_result
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out
    set st->initialized is true

## Responde shutdown.
weave handle_shutdown with st as ref to State, id as rpc.JsonRpcId into void:
    set st->shutdown is true
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), (calling JsonValue.null_value)
    var ok as bool is calling send_msg with st, out
    banish out

## Obtiene un string de un objeto.
weave field_string with v as JsonValue, key as string into string:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv as JsonValue is f.value
        var s as maybe string is calling fv.as_string
        banish f
        if s.is_present:
            var out as string is calling copy with s.value
            banish s
            return out
        banish s
    banish f
    return ""

## Obtiene un bool de un objeto.
weave field_bool with v as JsonValue, key as string, dflt as bool into bool:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv as JsonValue is f.value
        var b as maybe bool is calling fv.as_bool
        banish f
        if b.is_present:
            return b.value
        banish b
    banish f
    return dflt

## Obtiene un int de un objeto.
weave field_int with v as JsonValue, key as string, dflt as int into int:
    var f as maybe JsonValue is calling v.get with key
    if f.is_present:
        var fv2 as JsonValue is f.value
        var i as maybe i64 is calling fv2.as_int
        banish f
        if i.is_present:
            return (i.value to int)
        banish i
    banish f
    return dflt

## didOpen.
weave did_open with st as ref to State, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    if not td.is_present:
        banish td
        return
    var u as string is calling field_string with td.value, "uri"
    var text as string is calling field_string with td.value, "text"
    var ver as int is calling field_int with td.value, "version", 0
    banish td
    var sp as ref to sema_api.SemaResult is calling check_document with st, u, text
    var doc as Document is with text is (calling copy with text), version is ver, sema is sp
    calling st->docs.put with (calling copy with u), doc
    calling remember_uri with st, u
    set st->ws_ready is false
    calling publish with st, u, ver, sp
    banish text
    banish u

## didChange (incremental: `textDocumentSync.change = 2`).
weave did_change with st as ref to State, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    if not td.is_present:
        banish td
        return
    var u as string is calling field_string with td.value, "uri"
    var ver as int is calling field_int with td.value, "version", 0
    banish td
    var cget as maybe JsonValue is calling params.get with "contentChanges"
    if not cget.is_present:
        banish cget
        banish u
        return
    var cgv as JsonValue is cget.value
    var changes as maybe list of JsonValue is calling cgv.as_array
    banish cget
    if changes.is_present:
        if changes.value.len > 0:
            var text as string is calling copy with ""
            var have_old as bool is calling st->docs.has with u
            if have_old:
                var old0 as Document is (st->docs at u)
                banish text
                set text is calling copy with old0.text
            var ci as int is 0
            while ci < changes.value.len:
                var ch as JsonValue is (changes.value at ci)
                var ct as string is calling field_string with ch, "text"
                var rng as maybe JsonValue is calling ch.get with "range"
                if rng.is_present:
                    var rv as JsonValue is rng.value
                    var stj as maybe JsonValue is calling rv.get with "start"
                    var enj as maybe JsonValue is calling rv.get with "end"
                    var sl as int is 0
                    var sc as int is 0
                    var el as int is 0
                    var ec as int is 0
                    if stj.is_present:
                        set sl is calling field_int with stj.value, "line", 0
                        set sc is calling field_int with stj.value, "character", 0
                    if enj.is_present:
                        set el is calling field_int with enj.value, "line", sl
                        set ec is calling field_int with enj.value, "character", sc
                    banish enj
                    banish stj
                    var so as int is calling lpos.offset_at with text, sl, sc
                    var eo as int is calling lpos.offset_at with text, el, ec
                    if so < 0:
                        set so is 0
                    if eo < so:
                        set eo is so
                    if eo > text length:
                        set eo is text length
                    var before as string is text at 0 to so
                    var after as string is text at eo to (text length)
                    var nb as string is "{before}{ct}{after}"
                    banish before
                    banish after
                    banish ct
                    banish text
                    set text is nb
                    banish rv
                else:
                    banish text
                    set text is calling copy with ct
                    banish ct
                banish rng
                set ci is ci + 1
            var changed as bool is true
            if calling st->docs.has with u:
                var old_doc as Document is (st->docs at u)
                if old_doc.text == text:
                    set changed is false
                else:
                    calling free_doc with (sigil of old_doc)
            if changed:
                var sp as ref to sema_api.SemaResult is calling check_document with st, u, text
                var doc as Document is with text is (calling copy with text), version is ver, sema is sp
                calling st->docs.put with (calling copy with u), doc
                calling remember_uri with st, u
                set st->ws_ready is false
                calling publish with st, u, ver, sp
            banish text
        calling json.free_values with changes.value
    banish u

## didClose.
weave did_close with st as ref to State, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    if not td.is_present:
        banish td
        return
    var u as string is calling field_string with td.value, "uri"
    banish td
    if calling st->docs.has with u:
        var old as Document is (st->docs at u)
        calling free_doc with (sigil of old)
    var ignr as bool is calling st->docs.remove with u
    var nuris as list of string is list of string
    for ou in st->uris:
        if ou != u:
            calling nuris.push with ou
    banish st->uris
    set st->uris is nuris
    var arr as JsonValue is calling JsonValue.empty_array
    var p2 as JsonValue is calling JsonValue.empty_object
    calling p2.put_json with "uri", (calling JsonValue.string_val with (calling copy with u))
    calling p2.put_json with "diagnostics", arr
    var note as rpc.JsonRpcMessage is calling rpc.notification with "textDocument/publishDiagnostics", (some p2)
    var ok as bool is calling send_msg with st, note
    banish note
    banish u

## ¿Carácter de identificador?
weave is_word with c as int into bool:
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

## Registra una URI abierta una sola vez.
weave remember_uri with st as ref to State, u as string into void:
    var i as int is 0
    while i < st->uris.len:
        if (st->uris at i) == u:
            return
        set i is i + 1
    calling st->uris.push with (calling copy with u)

## Texto del documento abierto.
weave doc_text with st as ref to State, u as string into string:
    if calling st->docs.has with u:
        var d as Document is (st->docs at u)
        return calling copy with d.text
    var path as string is calling luri.uri_to_path with u
    var t as maybe string is calling archivum.read_text with path
    banish path
    if t.is_present:
        var out as string is calling copy with t.value
        banish t
        return out
    banish t
    return ""

## Palabra bajo un offset.
weave word_at with text as string, off as int into string:
    var b as ref to frozen byte is bytes of text
    var start as int is off
    while start > 0 and calling is_word with ((b at (start - 1)) to int):
        set start is start - 1
    var end as int is off
    while end < text length and calling is_word with ((b at end) to int):
        set end is end + 1
    return text at start to end

## `SemaResult` de un documento abierto (`-1` no aplica; el llamador comprueba).
weave doc_sema with st as ref to State, u as string into ref to sema_api.SemaResult:
    var d as Document is (st->docs at u)
    return d.sema

## Módulo semántico de un documento abierto (`-1` si no).
weave doc_module with st as ref to State, u as string into int:
    if not calling st->docs.has with u:
        return -1
    var d as Document is (st->docs at u)
    var path as string is calling luri.uri_to_path with u
    defer banish path
    return calling query.module_for_uri_path with d.sema->program, path

## `true` si el símbolo es de tipo nominal/estructura.
weave is_type_symbol with sid_kind as sym.SemaSymbolKind into bool:
    return sid_kind == sym.SemaSymbolKind.SkRune or sid_kind == sym.SemaSymbolKind.SkEcho or sid_kind == sym.SemaSymbolKind.SkOmen or sid_kind == sym.SemaSymbolKind.SkAlias or sid_kind == sym.SemaSymbolKind.SkSeal or sid_kind == sym.SemaSymbolKind.SkConcept or sid_kind == sym.SemaSymbolKind.SkType

## Añade campos/variantes de un tipo nominal a un hover.
##
## ## Memoria
## No retiene; libera los strings auxiliares.
weave hover_type_details with p as ref to sema_api.SemaResult, sb as ref to StringBuilder, type_id as int into void:
    var ty as tk.SemaType is calling types.at with (sigil of p->program->types), type_id
    if ty.a < 0 or ty.a >= p->program->types.nominal_infos.len:
        return
    var info as types.SemaNominalInfo is (p->program->types.nominal_infos at ty.a)
    if (ty.kind == tk.SemaTypeKind.TkRune or ty.kind == tk.SemaTypeKind.TkEcho) and info.fields_count > 0:
        calling sb.append with "```pengu
"
        var fi as int is 0
        while fi < info.fields_count:
            var f as types.SemaField is (p->program->types.fields at (info.fields_first + fi))
            var fn as string is calling npool.text with (sigil of p->program->names), f.name
            var ft as string is calling query.type_text with p->program, f.type
            calling sb.append with "    {fn} as {ft}
"
            banish ft
            set fi is fi + 1
        calling sb.append with "```

"
    else if ty.kind == tk.SemaTypeKind.TkOmen and info.variants_count > 0:
        calling sb.append with "```pengu
"
        var vi as int is 0
        while vi < info.variants_count:
            var v as types.SemaVariant is (p->program->types.variants at (info.variants_first + vi))
            var vn as string is calling npool.text with (sigil of p->program->names), v.name
            calling sb.append with "    {vn}
"
            set vi is vi + 1
        calling sb.append with "```

"

## Markdown de hover para un símbolo.
##
## ## Memoria
## Devuelve string owned.
weave symbol_hover with p as ref to sema_api.SemaResult, sid as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var si as sym.SemaSymbol is calling query.symbol_at with p->program, sid
    var nm as string is calling query.symbol_name with p->program, sid
    var kn as string is calling sym.symbol_kind_name with si.kind
    var ty as string is calling query.type_text with p->program, si.type
    if si.kind == sym.SemaSymbolKind.SkType and si.start < 0:
        calling sb.append with "```pengu
type {nm}
```

"
        var bd as string is calling docs.lookup with nm
        if bd length > 0:
            calling sb.append with bd
            calling sb.append with "
"
        banish ty
        return calling sb.finish
    if si.kind == sym.SemaSymbolKind.SkImport:
        calling sb.append with "```pengu
import {nm}
```

"
        var mscope as int is si.module_scope
        var mid2 as int is calling query.module_for_scope with p->program, mscope
        if mid2 >= 0:
            var exports as list of int is calling query.module_exports with p->program, mid2
            calling sb.append with "**Exported symbols**: "
            var ei as int is 0
            var first as bool is true
            while ei < exports.len and ei < 40:
                if not first:
                    calling sb.append with ", "
                var en as string is calling query.symbol_name with p->program, (exports at ei)
                calling sb.append with "`{en}`"
                set first is false
                set ei is ei + 1
            calling sb.append with "

"
            banish exports
        banish ty
        return calling sb.finish
    if si.kind == sym.SemaSymbolKind.SkWeave or si.kind == sym.SemaSymbolKind.SkDeclare or si.kind == sym.SemaSymbolKind.SkConst:
        var sig as string is calling query.signature_for with p->program, sid
        if sig length > 0:
            calling sb.append with "```pengu
{sig}
```

"
            banish sig
        else:
            banish sig
            calling sb.append with "```pengu
{kn} {nm}: {ty}
```

"
    else:
        if calling is_type_symbol with si.kind and si.start >= 0:
            calling sb.append with "```pengu
{kn} {nm}
```

"
        else:
            calling sb.append with "```pengu
{kn} {nm}: {ty}
```

"
    var size as int is calling query.type_size with p->program, si.type
    if size > 0:
        calling sb.append with "**Size:** ≈ {size} bytes

"
    if calling is_type_symbol with si.kind:
        calling hover_type_details with p, (sigil of sb), si.type
    var doc as string is calling query.symbol_doc with p->program, sid
    if doc length > 0:
        calling sb.append with "---

"
        calling sb.append with doc
        calling sb.append with "
"
    banish ty
    return calling sb.finish

## Documentación breve de keywords/tipos/operadores para hover.
weave keyword_doc with w as string into string:
    return calling docs.lookup with w

## `true` si el offset cae dentro de un string, char o comentario.
weave in_literal with m as loader.SemaModule, off as int into bool:
    var ci as int is 0
    while ci < m.lex.comments.len:
        var c as psstate.Comment is (m.lex.comments at ci)
        if off >= c.start and off < c.end:
            return true
        set ci is ci + 1
    var i as int is 0
    while i < m.lex.tokens.len:
        var t as pstoken.Token is (m.lex.tokens at i)
        if t.kind == pstoken.TokenKind.TokStringLit or t.kind == pstoken.TokenKind.TokCharLit:
            if off >= t.start and off < t.end:
                return true
            if t.start > off:
                break
        set i is i + 1
    return false

## Offset del punto/arrow antes del miembro bajo `off` (`-1` si no).
weave member_dot_before with text as string, off as int into int:
    var b as ref to frozen byte is bytes of text
    var p as int is off
    while p > 0 and calling is_word with ((b at (p - 1)) to int):
        set p is p - 1
    var q as int is p
    while q > 0 and (((b at (q - 1)) to int) == 32 or ((b at (q - 1)) to int) == 9):
        set q is q - 1
    if q >= 2 and ((b at (q - 1)) to int) == 62 and ((b at (q - 2)) to int) == 45:
        return q - 2
    if q >= 1 and ((b at (q - 1)) to int) == 46:
        return q - 1
    return -1

## Markdown de hover para un miembro (`receptor.miembro`).
##
## ## Memoria
## Devuelve string owned; `""` si no hay nada que mostrar.
weave member_hover with p as ref to sema_api.SemaResult, mid as int, text as string, dot as int, name as string into string:
    var sb as StringBuilder is calling StringBuilder.new
    var rt as int is calling query.receiver_type_at with p->program, mid, text, dot
    if rt <= 0:
        banish sb
        return ""
    var rty as string is calling query.type_text with p->program, rt
    var ids as list of int is calling query.methods_for_type with p->program, rt
    var i as int is 0
    while i < ids.len:
        var sid as int is (ids at i)
        var nm as string is calling query.symbol_name with p->program, sid
        if nm == name:
            var sig as string is calling query.signature_for with p->program, sid
            calling sb.append with "```pengu
{sig}
```

"
            banish sig
            var doc as string is calling query.symbol_doc with p->program, sid
            if doc length > 0:
                calling sb.append with doc
            banish ids
            banish rty
            return calling sb.finish
        set i is i + 1
    banish ids
    var ft as int is calling query.field_type_at with p->program, rt, name
    if ft > 0:
        var fty as string is calling query.type_text with p->program, ft
        calling sb.append with "```pengu
field {name}: {fty}
```

"
        var fsz as int is calling layout.type_size with p->program, ft
        if fsz > 0:
            calling sb.append with "**Size:** ≈ {fsz} bytes

"
        banish fty
        banish rty
        return calling sb.finish
    var vp as int is calling query.variant_payload_type with p->program, rt, name
    if vp > 0:
        var vty as string is calling query.type_text with p->program, vp
        calling sb.append with "```pengu
variant {name}({vty})
```

"
        banish vty
        banish rty
        return calling sb.finish
    banish rty
    banish sb
    return ""

## Línea de una declaración que contiene `word`, o `""`.
weave decl_line with text as string, word as string into string:
    var b as ref to frozen byte is bytes of text
    var start as int is 0
    while start <= text length:
        var end as int is start
        while end < text length and ((b at end) to int) != 10:
            set end is end + 1
        var line as string is text at start to end
        var keys as list of string is list of string
        calling keys.push with "weave "
        calling keys.push with "rune "
        calling keys.push with "echo "
        calling keys.push with "omen "
        calling keys.push with "const "
        var hit as bool is false
        for k in keys:
            var needle as string is "{k}{word}"
            if calling scrolls.contains with line, needle:
                set hit is true
            banish needle
        for k in keys:
            banish k
        banish keys
        if hit:
            return line
        banish line
        if end >= text length:
            break
        set start is end + 1
    return ""

## Hover básico.
weave handle_hover with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var res as JsonValue is calling JsonValue.null_value
    var value as string is ""
    if calling st->docs.has with u:
        var mid as int is calling doc_module with st, u
        if mid >= 0:
            var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
            var w as string is calling word_at with text, off
            var dotm as int is calling member_dot_before with text, off
            if dotm >= 0 and w length > 0:
                set value is calling member_hover with sp, mid, text, dotm, w
            if value length == 0:
                var m as loader.SemaModule is (sp->program->modules at mid)
                if not calling in_literal with m, off:
                    var sid as int is calling query.symbol_at_offset with sp->program, mid, text, off
                    if sid >= 0:
                        set value is calling symbol_hover with sp, sid
                    else:
                        set value is calling keyword_doc with w
            banish w
    else:
        var w2 as string is calling word_at with text, off
        defer banish w2
        set value is calling keyword_doc with w2
    if value length > 0:
        var contents as JsonValue is calling JsonValue.empty_object
        calling contents.put_json with "kind", (calling JsonValue.string_val with (calling copy with "markdown"))
        calling contents.put_json with "value", (calling JsonValue.string_val with (calling copy with value))
        var hov as JsonValue is calling JsonValue.empty_object
        calling hov.put_json with "contents", contents
        set res is hov
        banish value
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Definition semántica (local, misma archivo o std/módulo importado).
weave handle_definition with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var res as JsonValue is calling JsonValue.null_value
    if calling st->docs.has with u:
        var mid as int is calling doc_module with st, u
        if mid >= 0:
            var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
            var sid as int is -1
            var w as string is calling word_at with text, off
            var dotm as int is calling member_dot_before with text, off
            if dotm >= 0 and w length > 0:
                var rt as int is calling query.receiver_type_at with sp->program, mid, text, dotm
                if rt > 0:
                    var mids as list of int is calling query.methods_for_type with sp->program, rt
                    var mi as int is 0
                    while mi < mids.len:
                        var msid as int is (mids at mi)
                        var mnm as string is calling query.symbol_name with sp->program, msid
                        if mnm == w:
                            set sid is msid
                        set mi is mi + 1
                    banish mids
            banish w
            if sid < 0:
                set sid is calling query.symbol_at_offset with sp->program, mid, text, off
            if sid >= 0:
                var si as sym.SemaSymbol is calling query.symbol_at with sp->program, sid
                var target_mid as int is si.module
                var target_start as int is si.start
                var target_end as int is si.end
                var symname as string is calling query.symbol_name with sp->program, sid
                var nstart as int is calling query.symbol_name_start with sp->program, target_mid, sid
                if nstart >= 0:
                    set target_start is nstart
                    set target_end is nstart + (symname length)
                if si.kind == sym.SemaSymbolKind.SkImport and si.module_scope >= 0:
                    set target_mid is calling query.module_for_scope with sp->program, si.module_scope
                    if target_mid >= 0:
                        set target_start is 0
                        set target_end is 0
                if target_mid >= 0 and target_mid < sp->program->modules.len:
                    var tm as loader.SemaModule is (sp->program->modules at target_mid)
                    var uri2 as string is calling luri.path_to_uri with tm.canonical_path
                    var loc as JsonValue is calling JsonValue.empty_object
                    calling loc.put_json with "uri", (calling JsonValue.string_val with (calling copy with uri2))
                    if target_start < 0:
                        calling loc.put_json with "range", (calling lpos.range_json with text, 0, 0)
                    else:
                        var ttext as string is calling copy with tm.source.text
                        calling loc.put_json with "range", (calling lpos.range_json with ttext, target_start, target_end)
                        banish ttext
                    set res is loc
                    banish uri2
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Nombre declarado en una línea, o `""`.
weave decl_name_line with line as string into string:
    var b as ref to frozen byte is bytes of line
    var i as int is 0
    while i < line length and (((b at i) to int) == 32 or ((b at i) to int) == 9):
        set i is i + 1
    var rest as string is line at i to (line length)
    var kw as int is 0
    if calling starts_with with rest, "weave ":
        set kw is 6
    else if calling starts_with with rest, "ritual weave ":
        set kw is 13
    else if calling starts_with with rest, "inline weave ":
        set kw is 13
    else if calling starts_with with rest, "rune ":
        set kw is 5
    else if calling starts_with with rest, "echo ":
        set kw is 5
    else if calling starts_with with rest, "omen ":
        set kw is 5
    else if calling starts_with with rest, "concept ":
        set kw is 8
    else if calling starts_with with rest, "alias ":
        set kw is 6
    else if calling starts_with with rest, "seal ":
        set kw is 5
    else if calling starts_with with rest, "enchanting ":
        set kw is 11
    else if calling starts_with with rest, "bind ":
        set kw is 5
    else if calling starts_with with rest, "declare ":
        set kw is 8
    else if calling starts_with with rest, "const ":
        set kw is 6
    if kw == 0:
        banish rest
        return ""
    var rb as ref to frozen byte is bytes of rest
    var j as int is kw
    while j < rest length and calling is_word with ((rb at j) to int):
        set j is j + 1
    var nm as string is rest at kw to j
    banish rest
    return nm

## Kind LSP aproximado de una línea de declaración.
weave decl_kind_line with line as string into int:
    var b as ref to frozen byte is bytes of line
    var i as int is 0
    while i < line length and (((b at i) to int) == 32 or ((b at i) to int) == 9):
        set i is i + 1
    var indented as bool is i > 0
    var rest as string is line at i to (line length)
    var kind as int is 12
    if calling starts_with with rest, "rune " or calling starts_with with rest, "echo " or calling starts_with with rest, "seal ":
        set kind is 23
    else if calling starts_with with rest, "omen ":
        set kind is 10
    else if calling starts_with with rest, "concept ":
        set kind is 11
    else if calling starts_with with rest, "alias ":
        set kind is 26
    else if calling starts_with with rest, "const ":
        set kind is 14
    else if indented and calling starts_with with rest, "weave ":
        set kind is 6
    banish rest
    return kind

## Kind LSP de un símbolo para el outline.
weave symbol_kind_lsp with k as sym.SemaSymbolKind into int:
    if k == sym.SemaSymbolKind.SkRune or k == sym.SemaSymbolKind.SkEcho:
        return 23
    if k == sym.SemaSymbolKind.SkOmen:
        return 10
    if k == sym.SemaSymbolKind.SkConcept:
        return 11
    if k == sym.SemaSymbolKind.SkConst:
        return 14
    if k == sym.SemaSymbolKind.SkImport:
        return 2
    if k == sym.SemaSymbolKind.SkParam or k == sym.SemaSymbolKind.SkLet or k == sym.SemaSymbolKind.SkVar:
        return 13
    return 12

## Document symbols desde la tabla de símbolos.
weave handle_document_symbols with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    var mid as int is calling doc_module with st, u
    if mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var ids as list of int is calling query.module_symbols with sp->program, mid
        var seen as map of string to bool is map of string to bool
        var i as int is 0
        while i < ids.len:
            var sid as int is (ids at i)
            var si as sym.SemaSymbol is calling query.symbol_at with sp->program, sid
            if si.start >= 0:
                var nm as string is calling query.symbol_name with sp->program, sid
                var key as string is "{nm}@{si.start}"
                if not calling seen.has with key:
                    calling seen.put with key, true
                    var item as JsonValue is calling JsonValue.empty_object
                    calling item.put_json with "name", (calling JsonValue.string_val with (calling copy with nm))
                    calling item.put_json with "kind", (calling JsonValue.int_val with ((calling symbol_kind_lsp with si.kind) to i64))
                    var ty as string is calling query.type_text with sp->program, si.type
                    if ty length > 0:
                        calling item.put_json with "detail", (calling JsonValue.string_val with (calling copy with ty))
                    banish ty
                    var ns as int is calling query.symbol_name_start with sp->program, mid, sid
                    if ns < 0:
                        set ns is si.start
                    calling item.put_json with "range", (calling lpos.range_json with text, si.start, si.end)
                    calling item.put_json with "selectionRange", (calling lpos.range_json with text, ns, (ns + (nm length)))
                    calling arr.push_json with item
                banish key
            set i is i + 1
        banish seen
        banish ids
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## `true` si `s` termina en `suffix`.
weave ends_with with s as string, suffix as string into bool:
    var n as int is s length
    var m as int is suffix length
    if m > n:
        return false
    return (s at (n - m) to n) == suffix

## Añade una completion si no existe.
##
## ## Memoria
## Copia label/detail/insert/doc; no retiene los parámetros.
weave add_completion with arr as ref to JsonValue, seen as ref to map of string to bool, label as string, kind as int, detail as string, insert as string, doc as string into void:
    if label length == 0 or calling seen->has with label:
        return
    calling seen->put with (calling copy with label), true
    var item as JsonValue is calling JsonValue.empty_object
    calling item.put_json with "label", (calling JsonValue.string_val with (calling copy with label))
    calling item.put_json with "kind", (calling JsonValue.int_val with (kind to i64))
    if detail length > 0:
        calling item.put_json with "detail", (calling JsonValue.string_val with (calling copy with detail))
    if insert length > 0:
        calling item.put_json with "insertText", (calling JsonValue.string_val with (calling copy with insert))
    if doc length > 0:
        var d as JsonValue is calling JsonValue.empty_object
        calling d.put_json with "kind", (calling JsonValue.string_val with (calling copy with "markdown"))
        calling d.put_json with "value", (calling JsonValue.string_val with (calling copy with doc))
        calling item.put_json with "documentation", d
    calling arr.push_json with item

## Kind LSP de un símbolo.
weave completion_kind with k as sym.SemaSymbolKind into int:
    if k == sym.SemaSymbolKind.SkWeave or k == sym.SemaSymbolKind.SkDeclare or k == sym.SemaSymbolKind.SkTest:
        return 3
    if k == sym.SemaSymbolKind.SkRune or k == sym.SemaSymbolKind.SkEcho or k == sym.SemaSymbolKind.SkOmen or k == sym.SemaSymbolKind.SkType:
        return 7
    if k == sym.SemaSymbolKind.SkConcept:
        return 8
    if k == sym.SemaSymbolKind.SkImport:
        return 9
    if k == sym.SemaSymbolKind.SkConst:
        return 21
    return 6

## Añade un símbolo semántico a la lista.
##
## ## Memoria
## Libera el texto de tipo.
weave add_symbol_completion with p as ref to sema_api.SemaResult, arr as ref to JsonValue, seen as ref to map of string to bool, sid as int, prefix as string into void:
    var nm as string is calling query.symbol_name with p->program, sid
    if nm length == 0:
        return
    if prefix length > 0 and not (calling starts_with with nm, prefix):
        return
    var si as sym.SemaSymbol is calling query.symbol_at with p->program, sid
    var ty as string is calling query.type_text with p->program, si.type
    var doc as string is calling query.symbol_doc with p->program, sid
    calling add_completion with arr, seen, nm, (calling completion_kind with si.kind), ty, "", doc
    banish ty

## Stem de un archivo de módulo (`spark.pengu` -> `spark`).
weave module_stem with name as string into string:
    if calling ends_with with name, ".d.pengu":
        return name at 0 to (name length - 8)
    if calling ends_with with name, ".pengu":
        return name at 0 to (name length - 6)
    return ""

## Añade los módulos `std.*` de los directorios configurados.
##
## ## Memoria
## Libera las listas de `read_dir`.
weave add_std_modules with p as ref to sema_api.SemaResult, arr as ref to JsonValue, seen as ref to map of string to bool, prefix as string into void:
    var dirs as list of string is calling query.std_dirs with p->program
    var di as int is 0
    while di < dirs.len:
        var dir as string is (dirs at di)
        var ents as maybe list of string is calling archivum.read_dir with dir
        if ents.is_present:
            var names as list of string is ents.value
            var i as int is 0
            while i < names.len:
                var name as string is (names at i)
                var st as string is calling module_stem with name
                if st length > 0 and st != "__init__":
                    var label as string is "std.{st}"
                    if prefix length == 0 or calling starts_with with st, prefix:
                        var ins as string is calling copy with st
                        calling add_completion with arr, seen, label, 9, "stdlib module", ins, ""
                        banish ins
                banish names at i
                set i is i + 1
            banish names
        banish ents
        set di is di + 1

## Añade exports de un módulo importado.
##
## ## Memoria
## Libera la lista de exports.
weave add_module_exports with p as ref to sema_api.SemaResult, arr as ref to JsonValue, seen as ref to map of string to bool, mid as int, prefix as string into void:
    var exps as list of int is calling query.module_exports with p->program, mid
    var i as int is 0
    while i < exps.len:
        calling add_symbol_completion with p, arr, seen, (exps at i), prefix
        set i is i + 1
    banish exps

## Añade los métodos de encantamiento de un tipo.
##
## ## Memoria
## Libera la lista de ids y los textos auxiliares.
weave add_method_completions with p as ref to sema_api.SemaResult, arr as ref to JsonValue, seen as ref to map of string to bool, type_id as int, prefix as string into void:
    var ids as list of int is calling query.methods_for_type with p->program, type_id
    var i as int is 0
    while i < ids.len:
        var sid as int is (ids at i)
        var nm as string is calling query.symbol_name with p->program, sid
        if nm length > 0 and (prefix length == 0 or calling starts_with with nm, prefix):
            var sig as string is calling query.signature_for with p->program, sid
            var doc as string is calling query.symbol_doc with p->program, sid
            calling add_completion with arr, seen, nm, 2, sig, "", doc
            banish sig
        set i is i + 1
    banish ids

## Añade los campos de un `rune`/`echo`.
##
## ## Memoria
## Libera los nombres de campo ya copiados.
weave add_field_completions with p as ref to sema_api.SemaResult, arr as ref to JsonValue, seen as ref to map of string to bool, type_id as int, prefix as string into void:
    var ty as tk.SemaType is calling types.at with (sigil of p->program->types), type_id
    if ty.kind != tk.SemaTypeKind.TkRune and ty.kind != tk.SemaTypeKind.TkEcho:
        return
    if ty.a < 0 or ty.a >= p->program->types.nominal_infos.len:
        return
    var info as types.SemaNominalInfo is (p->program->types.nominal_infos at ty.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (p->program->types.fields at (info.fields_first + i))
        var nm as string is calling npool.text with (sigil of p->program->names), f.name
        if nm length > 0 and (prefix length == 0 or calling starts_with with nm, prefix):
            var ft as string is calling query.type_text with p->program, f.type
            calling add_completion with arr, seen, nm, 5, ft, "", ""
            banish ft
        set i is i + 1

## Añade las variantes de un `omen`.
weave add_variant_completions with p as ref to sema_api.SemaResult, arr as ref to JsonValue, seen as ref to map of string to bool, type_id as int, prefix as string into void:
    var ty as tk.SemaType is calling types.at with (sigil of p->program->types), type_id
    if ty.kind != tk.SemaTypeKind.TkOmen:
        return
    if ty.a < 0 or ty.a >= p->program->types.nominal_infos.len:
        return
    var info as types.SemaNominalInfo is (p->program->types.nominal_infos at ty.a)
    var i as int is 0
    while i < info.variants_count:
        var v as types.SemaVariant is (p->program->types.variants at (info.variants_first + i))
        var nm as string is calling npool.text with (sigil of p->program->names), v.name
        if nm length > 0 and (prefix length == 0 or calling starts_with with nm, prefix):
            calling add_completion with arr, seen, nm, 20, "variant", "", ""
        set i is i + 1

## Completion semántica.
weave handle_completion with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var ls as int is calling lpos.line_start with text, line
    var before as string is text at ls to off
    defer banish before
    var pstart as int is off
    var pb as ref to frozen byte is bytes of text
    while pstart > 0 and calling is_word with ((pb at (pstart - 1)) to int):
        set pstart is pstart - 1
    var prefix as string is text at pstart to off
    defer banish prefix
    var arr as JsonValue is calling JsonValue.empty_array
    var seen as map of string to bool is map of string to bool
    var mid as int is calling doc_module with st, u
    var handled_member as bool is false
    if mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var dot as int is calling scrolls.rfind with before, "."
        if dot >= 0:
            set handled_member is true
            var left as string is before at 0 to dot
            var alias_full as string is calling scrolls.trim with left
            banish left
            var wstart as int is alias_full length
            var lb as ref to frozen byte is bytes of alias_full
            while wstart > 0 and calling is_word with ((lb at (wstart - 1)) to int):
                set wstart is wstart - 1
            var alias as string is alias_full at wstart to (alias_full length)
            banish alias_full
            if alias == "std":
                calling add_std_modules with sp, (sigil of arr), (sigil of seen), prefix
            else:
                var imp as int is calling query.imported_module with sp->program, mid, alias
                if imp >= 0:
                    calling add_module_exports with sp, (sigil of arr), (sigil of seen), imp, prefix
                else:
                    var rt as int is calling query.receiver_type_at with sp->program, mid, text, (ls + dot)
                    if rt > 0:
                        calling add_method_completions with sp, (sigil of arr), (sigil of seen), rt, prefix
                        calling add_field_completions with sp, (sigil of arr), (sigil of seen), rt, prefix
                        calling add_variant_completions with sp, (sigil of arr), (sigil of seen), rt, prefix
            banish alias
    if not handled_member:
        var kt as pstoken.KeywordTable is calling pstoken.keyword_table_new
        defer banish kt
        var ki as int is 0
        while ki < kt.entries.len:
            var kw as pstoken.KeywordEntry is (kt.entries at ki)
            if prefix length == 0 or calling starts_with with kw.word, prefix:
                calling add_completion with (sigil of arr), (sigil of seen), kw.word, 14, "keyword", "", ""
            set ki is ki + 1
        var soft as list of string is list of string
        calling soft.push with "self"
        calling soft.push with "frozen"
        calling soft.push with "inline"
        calling soft.push with "ritual"
        calling soft.push with "present"
        calling soft.push with "main"
        calling soft.push with "ok"
        calling soft.push with "err"
        calling soft.push with "unsafe"
        calling soft.push with "over"
        calling soft.push with "do"
        var sfi as int is 0
        while sfi < soft.len:
            var w as string is (soft at sfi)
            if prefix length == 0 or calling starts_with with w, prefix:
                calling add_completion with (sigil of arr), (sigil of seen), w, 14, "keyword", "", ""
            banish soft at sfi
            set sfi is sfi + 1
        banish soft
        if mid >= 0:
            var sp2 as ref to sema_api.SemaResult is calling doc_sema with st, u
            var i as int is 0
            while i < sp2->program->symbols.symbols.len:
                var si as sym.SemaSymbol is (sp2->program->symbols.symbols at i)
                if si.name >= 0 and (si.module == mid or si.module == -1):
                    if si.kind != sym.SemaSymbolKind.SkImport:
                        calling add_symbol_completion with sp2, (sigil of arr), (sigil of seen), i, prefix
                set i is i + 1
            var aliases as list of string is calling query.import_aliases with sp2->program, mid
            var ai as int is 0
            while ai < aliases.len:
                var a as string is (aliases at ai)
                if prefix length == 0 or calling starts_with with a, prefix:
                    calling add_completion with (sigil of arr), (sigil of seen), a, 9, "imported module", "", ""
                banish aliases at ai
                set ai is ai + 1
            banish aliases
    banish seen
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Añade una Location de una ocurrencia.
weave add_occurrence with arr as ref to JsonValue, text as string, u as string, start as int, end as int into void:
    var loc as JsonValue is calling JsonValue.empty_object
    calling loc.put_json with "uri", (calling JsonValue.string_val with (calling copy with u))
    calling loc.put_json with "range", (calling lpos.range_json with text, start, end)
    calling arr.push_json with loc

## References basadas en símbolos (mismo `sid`, no texto plano).
weave handle_references with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    var inc as bool is true
    var ctx as maybe JsonValue is calling params.get with "context"
    if ctx.is_present:
        set inc is calling field_bool with ctx.value, "includeDeclaration", true
    banish ctx
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var mid as int is calling doc_module with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    if mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var sid as int is calling resolve_symbol_id with sp->program, mid, text, off
        if sid >= 0:
            var old as string is calling query.symbol_name with sp->program, sid
            var oid as string is calling symbol_identity with sp->program, sid
            var ns as int is calling query.symbol_name_start with sp->program, mid, sid
            for du in st->uris:
                var dmid as int is calling doc_module with st, du
                if dmid >= 0:
                    var dtext as string is calling doc_text with st, du
                    var dsp as ref to sema_api.SemaResult is calling doc_sema with st, du
                    var dm as loader.SemaModule is (dsp->program->modules at dmid)
                    var ti as int is 0
                    while ti < dm.lex.tokens.len:
                        var t as pstoken.Token is (dm.lex.tokens at ti)
                        if t.kind == pstoken.TokenKind.TokIdentifier:
                            var nm as string is calling astutil.token_text with (sigil of dm.source), (sigil of dm.lex), ti
                            if nm == old:
                                var is_decl as bool is (du == u and t.start == ns)
                                if inc or not is_decl:
                                    var s2 as int is calling resolve_symbol_id with dsp->program, dmid, dtext, t.start
                                    if s2 >= 0 and (calling identity_equal with (calling symbol_identity with dsp->program, s2), oid):
                                        calling add_occurrence with (sigil of arr), dtext, du, t.start, t.end
                            banish nm
                        set ti is ti + 1
                    banish dtext
            banish oid
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Highlight del símbolo bajo el cursor (declaración vs lecturas).
weave handle_highlight with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var mid as int is calling doc_module with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    if mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var sid as int is calling query.symbol_at_offset with sp->program, mid, text, off
        if sid >= 0:
            var old as string is calling query.symbol_name with sp->program, sid
            var ns as int is calling query.symbol_name_start with sp->program, mid, sid
            var dm as loader.SemaModule is (sp->program->modules at mid)
            var ti as int is 0
            while ti < dm.lex.tokens.len:
                var t as pstoken.Token is (dm.lex.tokens at ti)
                if t.kind == pstoken.TokenKind.TokIdentifier:
                    var nm as string is calling astutil.token_text with (sigil of dm.source), (sigil of dm.lex), ti
                    if nm == old:
                        var s2 as int is calling query.symbol_at_offset with sp->program, mid, text, t.start
                        if s2 == sid:
                            var item as JsonValue is calling JsonValue.empty_object
                            calling item.put_json with "range", (calling lpos.range_json with text, t.start, t.end)
                            var hk as int is 2
                            if t.start == ns:
                                set hk is 3
                            calling item.put_json with "kind", (calling JsonValue.int_val with (hk to i64))
                            calling arr.push_json with item
                    banish nm
                set ti is ti + 1
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Indentación de una línea.
weave indent_len with line as string into int:
    var b as ref to frozen byte is bytes of line
    var i as int is 0
    while i < line length and (((b at i) to int) == 32 or ((b at i) to int) == 9):
        set i is i + 1
    return i

## Folding por bloques con `:` e indentación.
weave handle_folding with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    var lines as list of string is calling text.split with "\n"
    var i as int is 0
    while i < lines.len:
        var line as string is (lines at i)
        var t as string is line
        var b as ref to frozen byte is bytes of t
        var e as int is t length
        while e > 0 and (((b at (e - 1)) to int) == 32 or ((b at (e - 1)) to int) == 9):
            set e is e - 1
        if e > 0:
            var base as int is calling indent_len with t
            var next_indent as int is 0
            if i + 1 < lines.len:
                var nxt as string is (lines at (i + 1))
                set next_indent is calling indent_len with nxt
                banish nxt
            if i + 1 < lines.len and next_indent > base:
                var j as int is i + 1
                var jind as int is 0
                while j < lines.len:
                    var jl as string is (lines at j)
                    set jind is calling indent_len with jl
                    banish jl
                    if jind <= base:
                        break
                    set j is j + 1
                var item as JsonValue is calling JsonValue.empty_object
                calling item.put_json with "startLine", (calling JsonValue.int_val with (i to i64))
                calling item.put_json with "endLine", (calling JsonValue.int_val with ((j - 1) to i64))
                calling item.put_json with "kind", (calling JsonValue.string_val with (calling copy with "region"))
                calling arr.push_json with item
        banish t
        banish line
        set i is i + 1
    banish lines
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Formatea con el `psc fmt` de F7.
weave handle_formatting with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var stamp as string is "{calling chronicle.now_ms}-{calling rites.getpid}"
    var tmp as string is "/tmp/psc-lsp-fmt-{stamp}.pengu"
    var out as string is "/tmp/psc-lsp-fmt-{stamp}.out"
    var res as JsonValue is calling JsonValue.null_value
    if calling archivum.write_text with tmp, text:
        var cmd as string is "{st->exe} fmt --stdin < {tmp} > {out}"
        var code as int is calling rites.exec with cmd, list of string
        banish cmd
        if code == 0:
            var ot as maybe string is calling archivum.read_text with out
            if ot.is_present:
                if ot.value != text:
                    var edits as JsonValue is calling JsonValue.empty_array
                    var edit as JsonValue is calling JsonValue.empty_object
                    calling edit.put_json with "range", (calling lpos.range_json with text, 0, text length)
                    calling edit.put_json with "newText", (calling JsonValue.string_val with (calling copy with ot.value))
                    calling edits.push_json with edit
                    set res is edits
                banish ot
        var d1 as bool is calling archivum.delete_file with tmp
        var d2 as bool is calling archivum.delete_file with out
    banish tmp
    banish out
    banish text
    banish u
    var outmsg as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, outmsg
    banish outmsg

## Identidad estable de un símbolo entre programas: módulo + declaración.
##
## Los `sid` son índices por `SemaProgram`; comparar ids entre documentos era
## el bug de rename cross-file (el id 12 de un documento no es el 12 de otro).
weave symbol_identity with p as ref to program.SemaProgram, sid as int into string:
    var s as sym.SemaSymbol is calling query.symbol_at with p, sid
    if s.name < 0:
        return ""
    var mp as string is "?"
    if s.module >= 0 and s.module < p->modules.len:
        var mm as loader.SemaModule is (p->modules at s.module)
        set mp is mm.source.path
    var kn as string is calling sym.symbol_kind_name with s.kind
    var id as string is "{mp}:{s.line}:{s.col}:{kn}"
    banish kn
    return id

## Igualdad de identidades tolerando rutas relativas vs absolutas: el mismo
## módulo puede aparecer como `src/lib.pengu` en un programa y como
## `/proyecto/src/lib.pengu` en otro.
weave identity_equal with a as string, b as string into bool:
    if a == b:
        return true
    if a length == 0 or b length == 0:
        return false
    if a length > b length + 1:
        var suf as string is "/{b}"
        var r as bool is calling ends_with with a, suf
        banish suf
        if r:
            return true
    if b length > a length + 1:
        var suf2 as string is "/{a}"
        var r2 as bool is calling ends_with with b, suf2
        banish suf2
        return r2
    return false

## Resuelve el símbolo bajo `off`, con fallback a la declaración léxica.
##
## `query.symbol_at_offset` no anota el identificador de una definición en
## todos los casos; para rename en la definición buscamos el token y su
## símbolo por offset de declaración.
weave resolve_symbol_id with p as ref to program.SemaProgram, mid as int, text as string, off as int into int:
    var sid as int is calling query.symbol_at_offset with p, mid, text, off
    if sid >= 0:
        return sid
    if mid < 0 or mid >= p->modules.len:
        return -1
    var dm as loader.SemaModule is (p->modules at mid)
    var ti as int is 0
    while ti < dm.lex.tokens.len:
        var t as pstoken.Token is (dm.lex.tokens at ti)
        if t.kind == pstoken.TokenKind.TokIdentifier and t.start <= off and off < t.end:
            var si as int is 0
            while si < p->symbols.symbols.len:
                var s as sym.SemaSymbol is (p->symbols.symbols at si)
                if s.start == t.start and (s.module == mid or s.module < 0):
                    return si
                set si is si + 1
            # Sin anotación de nodo (p. ej. el callee de `calling f`): resolver
            # por nombre, prefiriendo el scope del documento y nunca un import.
            var w as string is calling astutil.token_text with (sigil of dm.source), (sigil of dm.lex), ti
            var fallback as int is -1
            set si is 0
            while si < p->symbols.symbols.len and w length > 0:
                var s2 as sym.SemaSymbol is (p->symbols.symbols at si)
                if s2.name >= 0 and s2.kind != sym.SemaSymbolKind.SkImport and (calling query.symbol_name with p, si) == w:
                    if s2.module == mid:
                        banish w
                        return si
                    if fallback < 0:
                        set fallback is si
                set si is si + 1
            banish w
            if fallback >= 0:
                return fallback
            return -1
        set ti is ti + 1
    return -1

## Rename basado en símbolos: sólo edita identificadores que resuelven al
## mismo `sid` (no toca strings, comentarios ni homónimos de otro scope).
weave handle_rename with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    var newname as string is calling field_string with params, "newName"
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var mid as int is calling doc_module with st, u
    var res as JsonValue is calling JsonValue.null_value
    if mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var sid as int is calling resolve_symbol_id with sp->program, mid, text, off
        if sid >= 0 and newname length > 0:
            var old as string is calling query.symbol_name with sp->program, sid
            var oid as string is calling symbol_identity with sp->program, sid
            if old length > 0 and oid length > 0 and old != newname:
                var changes as JsonValue is calling JsonValue.empty_object
                for du in st->uris:
                    var dmid as int is calling doc_module with st, du
                    if dmid >= 0:
                        var dtext as string is calling doc_text with st, du
                        var dsp as ref to sema_api.SemaResult is calling doc_sema with st, du
                        var dm as loader.SemaModule is (dsp->program->modules at dmid)
                        var edits as JsonValue is calling JsonValue.empty_array
                        var ti as int is 0
                        while ti < dm.lex.tokens.len:
                            var t as pstoken.Token is (dm.lex.tokens at ti)
                            if t.kind == pstoken.TokenKind.TokIdentifier:
                                var nm as string is calling astutil.token_text with (sigil of dm.source), (sigil of dm.lex), ti
                                if nm == old:
                                    var s2 as int is calling resolve_symbol_id with dsp->program, dmid, dtext, t.start
                                    if s2 >= 0 and (calling identity_equal with (calling symbol_identity with dsp->program, s2), oid):
                                        var edit as JsonValue is calling JsonValue.empty_object
                                        calling edit.put_json with "range", (calling lpos.range_json with dtext, t.start, t.end)
                                        calling edit.put_json with "newText", (calling JsonValue.string_val with (calling copy with newname))
                                        calling edits.push_json with edit
                                banish nm
                            set ti is ti + 1
                        if calling edits.array_len > 0:
                            calling changes.put_json with du, edits
                        else:
                            banish edits
                        banish dtext
                banish oid
                var wr as JsonValue is calling JsonValue.empty_object
                calling wr.put_json with "changes", changes
                set res is wr
    banish text
    banish u
    banish newname
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Prepare rename: valida que el cursor esté sobre un símbolo renombrable.
weave handle_prepare_rename with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var mid as int is calling doc_module with st, u
    var res as JsonValue is calling JsonValue.null_value
    if mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var sid as int is calling query.symbol_at_offset with sp->program, mid, text, off
        if sid >= 0:
            var nm as string is calling query.symbol_name with sp->program, sid
            var ns as int is calling query.symbol_name_start with sp->program, mid, sid
            if nm length > 0 and ns >= 0:
                var obj as JsonValue is calling JsonValue.empty_object
                calling obj.put_json with "range", (calling lpos.range_json with text, ns, (ns + (nm length)))
                calling obj.put_json with "placeholder", (calling JsonValue.string_val with (calling copy with nm))
                set res is obj
            banish nm
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Implementation: reutiliza definition (métodos/tipos en F8.1).
weave handle_implementation with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    calling handle_definition with st, id, params

## Signature help: resuelve la llamada `calling f with a, b` bajo el cursor.
##
## Usa el símbolo semántico (no la línea de declaración) y cuenta las comas
## para calcular `activeParameter`.
weave handle_signature with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var line as int is 0
    var ch as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set ch is calling field_int with po.value, "character", 0
    banish po
    banish td
    var text as string is calling doc_text with st, u
    var off as int is calling lpos.offset_at with text, line, ch
    var ls as int is calling lpos.line_start with text, line
    var before as string is text at ls to off
    var res as JsonValue is calling JsonValue.null_value
    var mid as int is calling doc_module with st, u
    var ci as int is calling scrolls.rfind with before, "calling "
    if ci >= 0 and mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var tb as ref to frozen byte is bytes of text
        var le as int is ls
        while le < text length:
            if ((tb at le) to int) == 10:
                break
            set le is le + 1
        var rest as string is text at (ls + ci + 8) to le
        var rb as ref to frozen byte is bytes of rest
        var p0 as int is 0
        while p0 < rest length and (((rb at p0) to int) == 32 or ((rb at p0) to int) == 9):
            set p0 is p0 + 1
        var p1 as int is p0
        while p1 < rest length and calling is_word with ((rb at p1) to int):
            set p1 is p1 + 1
        while p1 < rest length:
            var c1 as int is (rb at p1) to int
            if c1 == 46 or c1 == 58:
                set p1 is p1 + 1
                while p1 < rest length and calling is_word with ((rb at p1) to int):
                    set p1 is p1 + 1
            else:
                break
        var fname as string is rest at p0 to p1
        banish rest
        if fname length > 0:
            var sid as int is -1
            var lastdot as int is calling scrolls.rfind with fname, "."
            if lastdot >= 0:
                var base as string is fname at 0 to lastdot
                var mname as string is fname at (lastdot + 1) to (fname length)
                var dotoff as int is ls + ci + 8 + p0 + lastdot
                var rt as int is calling query.receiver_type_at with sp->program, mid, text, dotoff
                if rt > 0:
                    var mids as list of int is calling query.methods_for_type with sp->program, rt
                    var mi as int is 0
                    while mi < mids.len:
                        var msid as int is (mids at mi)
                        var mnm as string is calling query.symbol_name with sp->program, msid
                        if mnm == mname:
                            set sid is msid
                        set mi is mi + 1
                    banish mids
                if sid < 0:
                    set sid is calling query.symbol_by_name with sp->program, mid, mname, off
                banish mname
                banish base
            if sid < 0:
                set sid is calling query.symbol_by_name with sp->program, mid, fname, off
            var sig as string is ""
            if sid >= 0:
                set sig is calling query.signature_for with sp->program, sid
            if sig length == 0:
                banish sig
                set sig is calling decl_line with text, fname
            if sig length > 0:
                var commas as int is 0
                var wpos as int is calling scrolls.find with before, " with "
                var i as int is off
                if wpos >= 0:
                    set i is ls + wpos + 6
                var sb as ref to frozen byte is bytes of text
                while i < off:
                    if ((sb at i) to int) == 44:
                        set commas is commas + 1
                    set i is i + 1
                # La firma canónica (`**f**(a: int, b: int) -> R`) y la línea de
                # declaración (`weave f with a as int, ... into R:`) comparten la
                # forma "param, param"; se extraen entre los delimitadores.
                var labels as list of string is list of string
                var lp as int is calling scrolls.find with sig, "("
                var rp as int is calling scrolls.find with sig, ")"
                if lp >= 0 and rp > lp:
                    calling collect_param_labels with sig at (lp + 1) to rp, (sigil of labels)
                if labels.len == 0:
                    var pi as int is calling scrolls.find with sig, " with "
                    var ii as int is calling scrolls.find with sig, " into "
                    if pi >= 0 and ii > pi:
                        calling collect_param_labels with (sig at (pi + 6) to ii), (sigil of labels)
                var sigobj as JsonValue is calling JsonValue.empty_object
                calling sigobj.put_json with "label", (calling JsonValue.string_val with (calling copy with sig))
                var pars as JsonValue is calling JsonValue.empty_array
                for lab in labels:
                    var pj as JsonValue is calling JsonValue.empty_object
                    calling pj.put_json with "label", (calling JsonValue.string_val with (calling copy with lab))
                    calling pars.push_json with pj
                    banish lab
                banish labels
                calling sigobj.put_json with "parameters", pars
                if sid >= 0:
                    var sdoc as string is calling query.symbol_doc with sp->program, sid
                    if sdoc length > 0:
                        calling sigobj.put_json with "documentation", (calling JsonValue.string_val with (calling copy with sdoc))
                    # `symbol_doc` devuelve un préstamo del pool de nombres: no se banea.
                var sigs as JsonValue is calling JsonValue.empty_array
                calling sigs.push_json with sigobj
                var outv as JsonValue is calling JsonValue.empty_object
                calling outv.put_json with "signatures", sigs
                calling outv.put_json with "activeSignature", (calling JsonValue.int_val with 0)
                var pcount as int is calling pars.array_len
                if commas >= pcount and pcount > 0:
                    set commas is pcount - 1
                calling outv.put_json with "activeParameter", (calling JsonValue.int_val with (commas to i64))
                set res is outv
                banish sig
        banish fname
    banish before
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Workspace symbols por escaneo de texto.
weave handle_workspace_symbols with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var query as string is calling field_string with params, "query"
    if not st->ws_ready:
        banish st->ws_cache
        var all as JsonValue is calling JsonValue.empty_array
        var files as list of string is calling archivum.find_files with st->root, true
        var count as int is 0
        for f in files:
            if count < 500 and calling scrolls.contains with f, ".pengu":
                var t as maybe string is calling archivum.read_text with f
                if t.is_present:
                    var text as string is calling copy with t.value
                    banish t
                    var b as ref to frozen byte is bytes of text
                    var start as int is 0
                    while start <= text length and count < 500:
                        var end as int is start
                        while end < text length and ((b at end) to int) != 10:
                            set end is end + 1
                        var line as string is text at start to end
                        var nm as string is calling decl_name_line with line
                        if nm length > 0:
                            var loc as JsonValue is calling JsonValue.empty_object
                            calling loc.put_json with "uri", (calling JsonValue.string_val with (calling luri.path_to_uri with f))
                            calling loc.put_json with "range", (calling lpos.range_json with text, start, start)
                            var item as JsonValue is calling JsonValue.empty_object
                            calling item.put_json with "name", (calling JsonValue.string_val with (calling copy with nm))
                            calling item.put_json with "kind", (calling JsonValue.int_val with (calling decl_kind_line with line))
                            calling item.put_json with "location", loc
                            calling all.push_json with item
                            set count is count + 1
                            banish nm
                        banish line
                        if end >= text length:
                            break
                        set start is end + 1
                    banish text
            banish f
        banish files
        set st->ws_cache is all
        set st->ws_ready is true
    var items as maybe list of JsonValue is calling st->ws_cache.as_array
    var arr as JsonValue is calling JsonValue.empty_array
    if items.is_present:
        for item in items.value:
            var nm2 as string is calling jstr with item, "name"
            if query length == 0 or calling scrolls.contains with nm2, query:
                calling arr.push_json with item
            else:
                banish item
            banish nm2
        banish items.value
    banish items
    banish query
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Code lens para `main` y tests.
weave handle_code_lens with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    var b as ref to frozen byte is bytes of text
    var start as int is 0
    while start <= text length:
        var end as int is start
        while end < text length and ((b at end) to int) != 10:
            set end is end + 1
        var line as string is text at start to end
        var lb as ref to frozen byte is bytes of line
        var ind as int is 0
        while ind < line length and (((lb at ind) to int) == 32 or ((lb at ind) to int) == 9):
            set ind is ind + 1
        var rest as string is line at ind to (line length)
        var title as string is ""
        var cmdname as string is ""
        if calling starts_with with rest, "weave main" and (rest length == 10 or (rest at 10 to 11) == " " or (rest at 10 to 11) == ":"):
            set title is "Run"
            set cmdname is "pengus.run"
        else if calling starts_with with rest, "test " or calling starts_with with rest, "test \"":
            set title is "Run test"
            set cmdname is "pengus.test"
        if title length > 0:
            var command as JsonValue is calling JsonValue.empty_object
            calling command.put_json with "title", (calling JsonValue.string_val with (calling copy with title))
            calling command.put_json with "command", (calling JsonValue.string_val with (calling copy with cmdname))
            var args as JsonValue is calling JsonValue.empty_array
            calling args.push_json with (calling JsonValue.string_val with (calling copy with u))
            calling args.push_json with (calling JsonValue.int_val with (start to i64))
            calling command.put_json with "arguments", args
            var item as JsonValue is calling JsonValue.empty_object
            calling item.put_json with "range", (calling lpos.range_json with text, start, end)
            calling item.put_json with "command", command
            calling arr.push_json with item
        banish rest
        banish cmdname
        banish title
        banish line
        if end >= text length:
            break
        set start is end + 1
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Token semántico pendiente de ordenar.
rune SemToken:
    start as int
    end as int
    ty as int

## Añade un token semántico si tiene longitud.
weave add_sem with xs as ref to list of SemToken, start as int, end as int, ty as int into void:
    if end <= start:
        return
    var t as SemToken is with start is start, end is end, ty is ty
    calling xs->push with t

## Kind semántico de un símbolo.
weave sem_symbol_kind with si as sym.SemaSymbol into int:
    if si.kind == sym.SemaSymbolKind.SkRune or si.kind == sym.SemaSymbolKind.SkEcho or si.kind == sym.SemaSymbolKind.SkOmen or si.kind == sym.SemaSymbolKind.SkAlias or si.kind == sym.SemaSymbolKind.SkSeal or si.kind == sym.SemaSymbolKind.SkConcept or si.kind == sym.SemaSymbolKind.SkType:
        return 1
    if si.kind == sym.SemaSymbolKind.SkWeave or si.kind == sym.SemaSymbolKind.SkDeclare or si.kind == sym.SemaSymbolKind.SkTest:
        return 2
    if si.kind == sym.SemaSymbolKind.SkImport:
        return 7
    if si.kind == sym.SemaSymbolKind.SkParam:
        return 8
    return 3

## `true` si el token es un operador.
weave is_operator_token with k as pstoken.TokenKind into bool:
    if k == pstoken.TokenKind.TokPlus or k == pstoken.TokenKind.TokMinus or k == pstoken.TokenKind.TokStar or k == pstoken.TokenKind.TokSlash or k == pstoken.TokenKind.TokPercent:
        return true
    if k == pstoken.TokenKind.TokAmpersand or k == pstoken.TokenKind.TokVerticalBar or k == pstoken.TokenKind.TokCaret or k == pstoken.TokenKind.TokTilde or k == pstoken.TokenKind.TokBang:
        return true
    if k == pstoken.TokenKind.TokAssign or k == pstoken.TokenKind.TokEqual or k == pstoken.TokenKind.TokNotEqual:
        return true
    if k == pstoken.TokenKind.TokLess or k == pstoken.TokenKind.TokLessOrEqual or k == pstoken.TokenKind.TokGreater or k == pstoken.TokenKind.TokGreaterOrEqual:
        return true
    if k == pstoken.TokenKind.TokShiftLeft or k == pstoken.TokenKind.TokShiftRight:
        return true
    if k == pstoken.TokenKind.TokPlusAssign or k == pstoken.TokenKind.TokMinusAssign or k == pstoken.TokenKind.TokStarAssign or k == pstoken.TokenKind.TokSlashAssign:
        return true
    if k == pstoken.TokenKind.TokPercentAssign or k == pstoken.TokenKind.TokAmpersandAssign or k == pstoken.TokenKind.TokVerticalBarAssign or k == pstoken.TokenKind.TokCaretAssign:
        return true
    if k == pstoken.TokenKind.TokShiftLeftAssign or k == pstoken.TokenKind.TokShiftRightAssign:
        return true
    return false

## Semantic tokens desde el lexer/AST (UTF-16, sin adivinar).
weave handle_semantic with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var data as JsonValue is calling JsonValue.empty_array
    var mid as int is calling doc_module with st, u
    if st->semantic_enabled and mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var m as loader.SemaModule is (sp->program->modules at mid)
        var toks as list of SemToken is list of SemToken
        var prev_kind as pstoken.TokenKind is pstoken.TokenKind.TokEof
        var prev_kw as pstoken.KeywordKind is pstoken.KeywordKind.KwNotKeyword
        var last_dot as int is -1
        var i as int is 0
        while i < m.lex.tokens.len:
            var t as pstoken.Token is (m.lex.tokens at i)
            if t.end > t.start:
                if t.kind == pstoken.TokenKind.TokKeyword:
                    calling add_sem with (sigil of toks), t.start, t.end, 0
                else if t.kind == pstoken.TokenKind.TokIdentifier:
                    var nm as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), i
                    var sid as int is calling query.symbol_by_name with sp->program, mid, nm, t.start
                    if sid >= 0:
                        var si as sym.SemaSymbol is calling query.symbol_at with sp->program, sid
                        calling add_sem with (sigil of toks), t.start, t.end, (calling sem_symbol_kind with si)
                    else if prev_kind == pstoken.TokenKind.TokDot:
                        var ty as int is 9
                        if last_dot >= 0:
                            var rt as int is calling query.receiver_type_at with sp->program, mid, text, last_dot
                            if rt > 0:
                                var mids as list of int is calling query.methods_for_type with sp->program, rt
                                var mi as int is 0
                                while mi < mids.len:
                                    var msid as int is (mids at mi)
                                    var mnm as string is calling query.symbol_name with sp->program, msid
                                    if mnm == nm:
                                        set ty is 2
                                    set mi is mi + 1
                                banish mids
                                if ty == 9:
                                    var ft as int is calling query.field_type_at with sp->program, rt, nm
                                    if ft >= 0:
                                        set ty is 9
                                    else:
                                        var vt as int is calling query.variant_payload_type with sp->program, rt, nm
                                        if vt >= 0:
                                            set ty is 10
                                        else:
                                            set ty is 9
                        calling add_sem with (sigil of toks), t.start, t.end, ty
                    else if prev_kw == pstoken.KeywordKind.KwCalling:
                        calling add_sem with (sigil of toks), t.start, t.end, 2
                    else:
                        calling add_sem with (sigil of toks), t.start, t.end, 3
                    banish nm
                else if t.kind == pstoken.TokenKind.TokStringLit or t.kind == pstoken.TokenKind.TokCharLit or t.kind == pstoken.TokenKind.TokAntiquusBody:
                    calling add_sem with (sigil of toks), t.start, t.end, 4
                else if t.kind == pstoken.TokenKind.TokIntLit or t.kind == pstoken.TokenKind.TokFloatLit:
                    calling add_sem with (sigil of toks), t.start, t.end, 5
                else if calling is_operator_token with t.kind:
                    calling add_sem with (sigil of toks), t.start, t.end, 11
            if t.kind == pstoken.TokenKind.TokDot:
                set last_dot is t.start
            if t.kind != pstoken.TokenKind.TokNewline and t.kind != pstoken.TokenKind.TokIndent and t.kind != pstoken.TokenKind.TokDedent:
                set prev_kind is t.kind
                set prev_kw is t.kw
            set i is i + 1
        # Comentarios de una sola línea (los bloques multilínea se omiten para
        # no emitir tokens que crucen líneas).
        var ci as int is 0
        while ci < m.lex.comments.len:
            var c as psstate.Comment is (m.lex.comments at ci)
            var has_nl as bool is false
            var cb as ref to frozen byte is bytes of text
            var q as int is c.start
            while q < c.end and q < text length:
                if ((cb at q) to int) == 10:
                    set has_nl is true
                set q is q + 1
            if not has_nl:
                calling add_sem with (sigil of toks), c.start, c.end, 6
            set ci is ci + 1
        # Orden por offset.
        var a as int is 0
        while a < toks.len:
            var b as int is 0
            while b + 1 < toks.len - a:
                if (toks at b).start > (toks at (b + 1)).start:
                    var tmp as SemToken is (toks at b)
                    set toks at b is (toks at (b + 1))
                    set toks at (b + 1) is tmp
                set b is b + 1
            set a is a + 1
        var last_line as int is 0
        var last_ch as int is 0
        var k as int is 0
        while k < toks.len:
            var tk as SemToken is (toks at k)
            var ps as JsonValue is calling lpos.position_json with text, tk.start
            var pe as JsonValue is calling lpos.position_json with text, tk.end
            var sl as int is calling jint with ps, "line", 0
            var sc as int is calling jint with ps, "character", 0
            var el as int is calling jint with pe, "line", sl
            var ec as int is calling jint with pe, "character", sc
            banish pe
            banish ps
            if el == sl:
                var dl as int is sl - last_line
                var ds as int is sc
                if dl == 0:
                    set ds is sc - last_ch
                var lit as string is text at tk.start to tk.end
                var ln as int is calling lpos.utf16_len with lit
                banish lit
                calling data.push_json with (calling JsonValue.int_val with (dl to i64))
                calling data.push_json with (calling JsonValue.int_val with (ds to i64))
                calling data.push_json with (calling JsonValue.int_val with (ln to i64))
                calling data.push_json with (calling JsonValue.int_val with (tk.ty to i64))
                calling data.push_json with (calling JsonValue.int_val with 0)
                set last_line is sl
                set last_ch is sc
            set k is k + 1
        banish toks
    banish text
    banish u
    var res as JsonValue is calling JsonValue.empty_object
    calling res.put_json with "data", data
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Línea (0-based) de un offset.
weave line_of with text as string, off as int into int:
    var b as ref to frozen byte is bytes of text
    var i as int is 0
    var line as int is 0
    while i < off and i < text length:
        if ((b at i) to int) == 10:
            set line is line + 1
        set i is i + 1
    return line

## Añade un inlay hint.
weave add_hint with arr as ref to JsonValue, text as string, pos as int, label as string, kind as int, tooltip as string into void:
    var hint as JsonValue is calling JsonValue.empty_object
    calling hint.put_json with "position", (calling lpos.position_json with text, pos)
    calling hint.put_json with "label", (calling JsonValue.string_val with (calling copy with label))
    calling hint.put_json with "kind", (calling JsonValue.int_val with (kind to i64))
    if tooltip length > 0:
        calling hint.put_json with "tooltip", (calling JsonValue.string_val with (calling copy with tooltip))
    calling arr.push_json with hint

## Inlay hints: tipos inferidos en variables y tamaño de tipos nominales.
##
## Las variables no muestran tamaño (basta el hover); las declaraciones de
## tipo muestran `≈ N B` para que el layout sea visible sin abrir el hover.
weave handle_inlay with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var rlo as int is 0
    var rhi as int is 1073741824
    var rng as maybe JsonValue is calling params.get with "range"
    if rng.is_present:
        var rv as JsonValue is rng.value
        var rs as maybe JsonValue is calling rv.get with "start"
        var re as maybe JsonValue is calling rv.get with "end"
        if rs.is_present:
            set rlo is calling field_int with rs.value, "line", 0
        if re.is_present:
            set rhi is calling field_int with re.value, "line", rlo
        banish re
        banish rs
        banish rv
    banish rng
    var text as string is calling doc_text with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    var mid as int is calling doc_module with st, u
    if st->inlay_enabled and mid >= 0:
        var sp as ref to sema_api.SemaResult is calling doc_sema with st, u
        var m as loader.SemaModule is (sp->program->modules at mid)
        if st->inlay_sizes:
            var tids as list of int is calling query.module_symbols with sp->program, mid
            var tseen as map of string to bool is map of string to bool
            var ti as int is 0
            while ti < tids.len:
                var tsid as int is (tids at ti)
                var tsi as sym.SemaSymbol is calling query.symbol_at with sp->program, tsid
                if calling is_type_symbol with tsi.kind and tsi.start >= 0:
                    var tnm as string is calling query.symbol_name with sp->program, tsid
                    var tstart as int is calling query.symbol_name_start with sp->program, mid, tsid
                    if tstart >= 0:
                        var tkey as string is "{mid}:{tstart}"
                        var tend as int is tstart + (tnm length)
                        var tline as int is calling line_of with text, tend
                        if tline >= rlo and tline <= rhi and not calling tseen.has with tkey:
                            calling tseen.put with tkey, true
                            var sz as int is calling layout.type_size with sp->program, tsi.type
                            if sz > 0:
                                var al as int is calling layout.type_align with sp->program, tsi.type
                                var lbl as string is "≈ {sz} B"
                                var tip as string is "{tnm}: {sz} bytes, alignment {al} (ABI v3, 64-bit)"
                                calling add_hint with (sigil of arr), text, tend, lbl, 1, tip
                                banish lbl
                                banish tip
                        banish tkey
                set ti is ti + 1
            banish tseen
            banish tids
        if st->inlay_types:
            var base as int is 0
            var tb as ref to frozen byte is bytes of text
            while base <= text length:
                var le as int is base
                while le < text length and ((tb at le) to int) != 10:
                    set le is le + 1
                var line as string is text at base to le
                var lb as ref to frozen byte is bytes of line
                var ind as int is 0
                while ind < line length and (((lb at ind) to int) == 32 or ((lb at ind) to int) == 9):
                    set ind is ind + 1
                var probe as int is base + ind + 1
                if probe < base + line length:
                    var node as int is calling query.node_at with sp->program, mid, probe
                    if node >= 0 and (calling astutil.kind_of with (sigil of m.parse.ast), node) == pskind.NodeKind.NdStmt:
                        set node is calling astutil.node_child with (sigil of m.parse.ast), node, 0
                    if node >= 0:
                        var nk as pskind.NodeKind is calling astutil.kind_of with (sigil of m.parse.ast), node
                        if nk == pskind.NodeKind.NdVarDecl or nk == pskind.NodeKind.NdLetDecl or nk == pskind.NodeKind.NdStaticVarDecl:
                            var cn as int is calling astutil.child_count with (sigil of m.parse.ast), node
                            var explicit as bool is false
                            if cn > 1:
                                if (calling astutil.node_child with (sigil of m.parse.ast), node, 1) >= 0:
                                    set explicit is true
                            var tslot as int is calling astutil.token_child with (sigil of m.parse.ast), node, 0
                            var names_node as int is calling astutil.node_child with (sigil of m.parse.ast), node, 0
                            if (not explicit) and tslot < 0 and names_node >= 0:
                                set tslot is calling astutil.token_child with (sigil of m.parse.ast), names_node, 0
                            if (not explicit) and tslot >= 0:
                                var name as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), tslot
                                var sid as int is calling query.symbol_by_name with sp->program, mid, name, base + ind + 8
                                banish name
                                if sid >= 0:
                                    var t as int is calling query.symbol_type with sp->program, sid
                                    var ty as string is calling query.type_text with sp->program, t
                                    if ty length > 0:
                                        var tok as pstoken.Token is calling astutil.token_at with (sigil of m.lex), tslot
                                        var hline as int is calling line_of with text, tok.end
                                        if hline >= rlo and hline <= rhi:
                                            var lbl as string is ": {ty}"
                                            var tip as string is "inferred type: {ty}"
                                            calling add_hint with (sigil of arr), text, tok.end, lbl, 1, tip
                                            banish lbl
                                            banish tip
                                    banish ty
                banish line
                if le >= text length:
                    break
                set base is le + 1
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Code actions: por ahora "Format document".
weave handle_code_action with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var arr as JsonValue is calling JsonValue.empty_array
    var action as JsonValue is calling JsonValue.empty_object
    calling action.put_json with "title", (calling JsonValue.string_val with (calling copy with "Format document"))
    calling action.put_json with "kind", (calling JsonValue.string_val with (calling copy with "source.fixAll"))
    var cmd as JsonValue is calling JsonValue.empty_object
    calling cmd.put_json with "title", (calling JsonValue.string_val with (calling copy with "Format document"))
    calling cmd.put_json with "command", (calling JsonValue.string_val with (calling copy with "editor.action.formatDocument"))
    calling action.put_json with "command", cmd
    calling arr.push_json with action
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var u as string is ""
    var ln as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set ln is calling field_int with po.value, "line", 0
    banish po
    banish td
    if u length > 0:
        var txt as string is calling doc_text with st, u
        var lines as list of string is calling txt.split with "\n"
        if ln >= 0 and ln < lines.len:
            var cur as string is (lines at ln)
            var cb as ref to frozen byte is bytes of cur
            var q as int is 0
            while q < cur length and (((cb at q) to int) == 32 or ((cb at q) to int) == 9):
                set q is q + 1
            var rest as string is cur at q to (cur length)
            var is_decl as bool is false
            if calling scrolls.starts_with with rest, "weave ":
                set is_decl is true
            if calling scrolls.starts_with with rest, "rune ":
                set is_decl is true
            if calling scrolls.starts_with with rest, "echo ":
                set is_decl is true
            if calling scrolls.starts_with with rest, "omen ":
                set is_decl is true
            if calling scrolls.starts_with with rest, "enchanting ":
                set is_decl is true
            banish rest
            if is_decl:
                var lstart as int is calling lpos.line_start with txt, ln
                var pos as JsonValue is calling lpos.position_json with txt, lstart
                var pos2 as JsonValue is calling lpos.position_json with txt, lstart
                var range as JsonValue is calling JsonValue.empty_object
                calling range.put_json with "start", pos
                calling range.put_json with "end", pos2
                var edit as JsonValue is calling JsonValue.empty_object
                var changes as JsonValue is calling JsonValue.empty_object
                var edits as JsonValue is calling JsonValue.empty_array
                var te as JsonValue is calling JsonValue.empty_object
                calling te.put_json with "range", range
                calling te.put_json with "newText", (calling JsonValue.string_val with (calling copy with "## TODO: describe this declaration.\n"))
                calling edits.push_json with te
                calling changes.put_json with u, edits
                calling edit.put_json with "changes", changes
                var act2 as JsonValue is calling JsonValue.empty_object
                calling act2.put_json with "title", (calling JsonValue.string_val with (calling copy with "Add documentation comment"))
                calling act2.put_json with "kind", (calling JsonValue.string_val with (calling copy with "refactor.rewrite"))
                calling act2.put_json with "edit", edit
                calling arr.push_json with act2
        banish lines
        banish txt
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Dispatch de request.
weave handle_request with st as ref to State, id as rpc.JsonRpcId, method as string, params as maybe JsonValue into void:
    if method == "initialize":
        calling handle_initialize with st, id, params
    else if method == "shutdown":
        calling handle_shutdown with st, id
    else if method == "textDocument/hover":
        if params.is_present:
            calling handle_hover with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/definition":
        if params.is_present:
            calling handle_definition with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/documentSymbol":
        if params.is_present:
            calling handle_document_symbols with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/completion":
        if params.is_present:
            calling handle_completion with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/references":
        if params.is_present:
            calling handle_references with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/documentHighlight":
        if params.is_present:
            calling handle_highlight with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/foldingRange":
        if params.is_present:
            calling handle_folding with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/formatting":
        if params.is_present:
            calling handle_formatting with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/rename":
        if params.is_present:
            calling handle_rename with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/prepareRename":
        if params.is_present:
            calling handle_prepare_rename with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/implementation":
        if params.is_present:
            calling handle_implementation with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/signatureHelp":
        if params.is_present:
            calling handle_signature with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "workspace/symbol":
        if params.is_present:
            calling handle_workspace_symbols with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/codeLens":
        if params.is_present:
            calling handle_code_lens with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/semanticTokens/full":
        if params.is_present:
            calling handle_semantic with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/inlayHint":
        if params.is_present:
            calling handle_inlay with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/codeAction":
        if params.is_present:
            calling handle_code_action with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else:
        calling send_method_error with st, id, method

## Dispatch de notification.
## Aplica settings en caliente (`workspace/didChangeConfiguration`).
weave apply_configuration with st as ref to State, params as JsonValue into void:
    var s as maybe JsonValue is calling params.get with "settings"
    if not s.is_present:
        banish s
        return
    var root as JsonValue is s.value
    var pg as maybe JsonValue is calling root.get with "pengus"
    if pg.is_present:
        var pv as JsonValue is pg.value
        var ih as maybe JsonValue is calling pv.get with "inlayHints"
        if ih.is_present:
            var ihv as JsonValue is ih.value
            if calling ihv.is_bool:
                var mb as maybe bool is calling ihv.as_bool
                if mb.is_present:
                    set st->inlay_enabled is mb.value
                banish mb
            else:
                set st->inlay_enabled is calling field_bool with ihv, "enabled", true
                set st->inlay_sizes is calling field_bool with ihv, "sizes", true
                set st->inlay_types is calling field_bool with ihv, "types", true
            banish ihv
        banish ih
        var sh as maybe JsonValue is calling pv.get with "semanticHighlighting"
        if sh.is_present:
            var shv as JsonValue is sh.value
            if calling shv.is_bool:
                var msb as maybe bool is calling shv.as_bool
                if msb.is_present:
                    set st->semantic_enabled is msb.value
                banish msb
            banish shv
        banish sh
        banish pv
    banish pg
    banish root

weave handle_notification with st as ref to State, method as string, params as maybe JsonValue into void:
    if method == "initialized":
        return
    if method == "exit":
        set st->shutdown is true
        return
    if method == "workspace/didChangeWatchedFiles":
        set st->ws_ready is false
        return
    if method == "workspace/didChangeConfiguration":
        if params.is_present:
            calling apply_configuration with st, params.value
        return
    if method == "$/cancelRequest":
        return
    if method == "textDocument/didSave":
        return
    if params.is_present:
        if method == "textDocument/didOpen":
            calling did_open with st, params.value
        else if method == "textDocument/didChange":
            calling did_change with st, params.value
        else if method == "textDocument/didClose":
            calling did_close with st, params.value

## Bucle principal.
weave run_with with tr as transport.Transport, root as string, exe as string into int:
    var st as State is with tr is tr, docs is map of string to Document, uris is (list of string), root is root, exe is exe, std_dir is "", inlay_enabled is true, inlay_sizes is true, inlay_types is true, semantic_enabled is true, ws_cache is (calling JsonValue.empty_array), ws_ready is false, initialized is false, shutdown is false
    while true:
        var body as maybe string is calling transport.read_frame with (sigil of st.tr)
        if not body.is_present:
            banish body
            break
        var fixed as string is calling scrolls.replace_all with body.value, r""""params":null""", r""""params":{}"""
        var fixed2 as string is calling scrolls.replace_all with fixed, r""""params": null""", r""""params":{}"""
        banish fixed
        var pr as result of rpc.JsonRpcMessage to rpc.JsonRpcParseError is calling rpc.parse_message with fixed2
        banish fixed2
        banish body
        if not pr.is_ok:
            var pid as rpc.JsonRpcId is with Number is 0
            var out as rpc.JsonRpcMessage is calling rpc.response_error with pid, (calling rpc.error_parse)
            var okp as bool is calling send_msg with (sigil of st), out
            banish out
            banish pr
            continue
        var msg as rpc.JsonRpcMessage is pr.value
        var ignored as int is judge msg:
            when RpcRequest with id, method, params ->
                calling handle_request with (sigil of st), id, method, params
                0
            when Notification with method, params ->
                calling handle_notification with (sigil of st), method, params
                0
            when ResponseOk with id, result ->
                0
            when ResponseError with id, err ->
                0
        banish msg
    var code as int is 1
    if st.shutdown:
        set code is 0
    calling transport.close with (sigil of st.tr)
    return code
