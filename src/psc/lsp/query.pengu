## psc/lsp/query.pengu — consultas semánticas para el servidor LSP.
##
## El LSP no debe reimplementar el parser ni adivinar tipos desde el texto.
## Este módulo expone las consultas mínimas sobre `SemaProgram`: símbolo bajo
## una posición, tipo, documentación, exports, módulos y tamaño aproximado.

import std.builder

import psc.ast.node as psast
import psc.sema.annotate as ann
import psc.sema.ast as astutil
import psc.sema.modules.loader as loader
import psc.sema.modules.program as program
import psc.sema.names as npool
import psc.sema.symbols.symbol as sym
import psc.sema.symbols.table as symbols
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.docgen.sig as sig
import psc.lsp.layout as layout
import psc.token as pstoken

insignia psc_lsp_query_

## Módulo cargado para un path (`-1` si no).
weave module_at with p as ref to program.SemaProgram, path as string into int:
    return calling program.module_id with p, path

## Módulo cargado para el path absoluto de un documento.
weave module_for_uri_path with p as ref to program.SemaProgram, path as string into int:
    var abs as string is calling program.canonical_path with p, path
    defer banish abs
    if calling p->by_path.has with abs:
        return calling p->by_path.get with abs
    return -1

## Número de símbolos del programa.
weave symbol_count with p as ref to program.SemaProgram into int:
    return p->symbols.symbols.len

## Símbolo por id (`-1` si no).
weave symbol_at with p as ref to program.SemaProgram, sid as int into sym.SemaSymbol:
    if sid < 0 or sid >= p->symbols.symbols.len:
        return with name is -1, type is 0, kind is sym.SemaSymbolKind.SkVar, flags is 0, c_name is -1, module is -1, line is 0, col is 0, start is -1, end is -1, attrs_node is -1, doc is -1, const_id is -1, bounds_first is 0, bounds_count is 0, module_scope is -1
    return (p->symbols.symbols at sid)

## `NameId` de un símbolo.
weave symbol_name_id with p as ref to program.SemaProgram, sid as int into int:
    if sid < 0 or sid >= p->symbols.symbols.len:
        return -1
    return (p->symbols.symbols at sid).name

## Texto del nombre de un símbolo (prestado).
weave symbol_name with p as ref to program.SemaProgram, sid as int into string:
    var nid as int is calling symbol_name_id with p, sid
    if nid < 0:
        return ""
    return calling npool.text with (sigil of p->names), nid

## Tipo de un símbolo.
weave symbol_type with p as ref to program.SemaProgram, sid as int into int:
    if sid < 0 or sid >= p->symbols.symbols.len:
        return 0
    return (p->symbols.symbols at sid).type

## Doc de un símbolo (`""` si no).
weave symbol_doc with p as ref to program.SemaProgram, sid as int into string:
    if sid < 0 or sid >= p->symbols.symbols.len:
        return ""
    var d as int is (p->symbols.symbols at sid).doc
    if d < 0:
        return ""
    return calling npool.text with (sigil of p->names), d

## Texto canónico de un tipo.
weave type_text with p as ref to program.SemaProgram, type_id as int into string:
    return calling sig.type_text with p, type_id

## Firma de un símbolo (`""` si no aplica).
weave signature_for with p as ref to program.SemaProgram, sid as int into string:
    return calling sig.signature_for_symbol with p, sid

## Tipo de un nodo anotado (`-1` si no).
weave node_type with p as ref to program.SemaProgram, mid as int, node as int into int:
    if mid < 0 or mid >= p->modules.len or node < 0:
        return -1
    var m as loader.SemaModule is (p->modules at mid)
    return calling ann.type_of with (sigil of m.annotations), node

## Símbolo de un nodo anotado (`-1` si no).
weave node_symbol with p as ref to program.SemaProgram, mid as int, node as int into int:
    if mid < 0 or mid >= p->modules.len or node < 0:
        return -1
    var m as loader.SemaModule is (p->modules at mid)
    return calling ann.symbol_of with (sigil of m.annotations), node

## Nodo AST más pequeño que contiene `offset` (`-1` si no).
weave node_at with p as ref to program.SemaProgram, mid as int, offset as int into int:
    if mid < 0 or mid >= p->modules.len:
        return -1
    var m as loader.SemaModule is (p->modules at mid)
    var best as int is -1
    var best_len as int is 1 << 30
    var i as int is 0
    while i < m.parse.ast.nodes.len:
        var st as int is calling astutil.start_of with (sigil of m.parse.ast), i
        var en as int is calling astutil.end_of with (sigil of m.parse.ast), i
        var ln as int is en - st
        if st <= offset and offset < en and ln > 0 and ln < best_len:
            set best is i
            set best_len is ln
        set i is i + 1
    return best

## `true` si `c` es carácter de identificador.
weave is_word_char with c as int into bool:
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

## Palabra (identificador) bajo un offset.
weave word_at with text as string, offset as int into string:
    var b as ref to frozen byte is bytes of text
    var st as int is offset
    while st > 0 and calling is_word_char with ((b at (st - 1)) to int):
        set st is st - 1
    var en as int is offset
    while en < text length and calling is_word_char with ((b at en) to int):
        set en is en + 1
    return text at st to en

## `true` si el símbolo es público/documentable.
weave is_public with p as ref to program.SemaProgram, sid as int into bool:
    var nm as string is calling symbol_name with p, sid
    if nm length == 0:
        return false
    var first as string is nm at 0 to 1
    defer banish first
    return first != "_"

## Símbolo que declara `name` en el módulo, el más cercano antes de `offset`.
weave symbol_by_name with p as ref to program.SemaProgram, mid as int, name as string, offset as int into int:
    var best as int is -1
    var best_start as int is -1
    var builtin as int is -1
    var i as int is 0
    while i < p->symbols.symbols.len:
        var si as sym.SemaSymbol is (p->symbols.symbols at i)
        if si.name >= 0:
            var nm as string is calling npool.text with (sigil of p->names), si.name
            if nm == name and (si.module == mid or si.module == -1):
                if si.start >= 0 and si.start <= offset and si.start > best_start:
                    set best is i
                    set best_start is si.start
                if si.start < 0 and builtin < 0:
                    set builtin is i
        set i is i + 1
    if best >= 0:
        return best
    return builtin

## Símbolo bajo un offset (declaración o uso anotado).
weave symbol_at_offset with p as ref to program.SemaProgram, mid as int, text as string, offset as int into int:
    var n as int is calling node_at with p, mid, offset
    if n >= 0:
        var ns as int is calling node_symbol with p, mid, n
        if ns >= 0:
            return ns
    var w as string is calling word_at with text, offset
    defer banish w
    if w length == 0:
        return -1
    var by_name as int is calling symbol_by_name with p, mid, w, offset
    if by_name >= 0:
        return by_name
    # Símbolos de módulos importados: `spark.println` no está en el scope del
    # documento, pero `spark` sí es un `SkImport`.
    var i as int is 0
    while i < p->symbols.symbols.len:
        var si as sym.SemaSymbol is (p->symbols.symbols at i)
        if si.kind == sym.SemaSymbolKind.SkImport and si.name >= 0:
            var nm as string is calling npool.text with (sigil of p->names), si.name
            if nm == w:
                return i
        set i is i + 1
    return -1

## Tipo bajo un offset (`-1` si no).
weave type_at_offset with p as ref to program.SemaProgram, mid as int, text as string, offset as int into int:
    var n as int is calling node_at with p, mid, offset
    if n >= 0:
        var t as int is calling node_type with p, mid, n
        if t > 0:
            return t
    var sid as int is calling symbol_at_offset with p, mid, text, offset
    if sid >= 0:
        return calling symbol_type with p, sid
    return -1

## Ids de símbolos declarados por un módulo.
weave module_symbols with p as ref to program.SemaProgram, mid as int into list of int:
    var out as list of int is list of int
    var i as int is 0
    while i < p->symbols.symbols.len:
        var si as sym.SemaSymbol is (p->symbols.symbols at i)
        if si.module == mid and si.name >= 0 and calling is_public with p, i:
            calling out.push with i
        set i is i + 1
    return out

## Módulo cuyo scope global es `scope_id` (`-1` si no).
weave module_for_scope with p as ref to program.SemaProgram, scope_id as int into int:
    if scope_id < 0:
        return -1
    var i as int is 0
    while i < p->modules.len:
        var m as loader.SemaModule is (p->modules at i)
        if m.scope == scope_id:
            return i
        set i is i + 1
    return -1

## Exports de un módulo importado.
weave module_exports with p as ref to program.SemaProgram, mid as int into list of int:
    return calling module_symbols with p, mid

## Alias de imports del módulo.
weave import_aliases with p as ref to program.SemaProgram, mid as int into list of string:
    var out as list of string is list of string
    var i as int is 0
    while i < p->symbols.symbols.len:
        var si as sym.SemaSymbol is (p->symbols.symbols at i)
        if si.kind == sym.SemaSymbolKind.SkImport and si.module == mid and si.name >= 0:
            var nm as string is calling npool.text with (sigil of p->names), si.name
            calling out.push with (calling npool.copy_string with nm)
        set i is i + 1
    return out

## Módulo importado por un alias (`-1` si no).
weave imported_module with p as ref to program.SemaProgram, mid as int, alias as string into int:
    var i as int is 0
    while i < p->symbols.symbols.len:
        var si as sym.SemaSymbol is (p->symbols.symbols at i)
        if si.kind == sym.SemaSymbolKind.SkImport and si.module == mid and si.name >= 0:
            var nm as string is calling npool.text with (sigil of p->names), si.name
            if nm == alias:
                return calling module_for_scope with p, si.module_scope
        set i is i + 1
    return -1

## Directorios de stdlib configurados.
weave std_dirs with p as ref to program.SemaProgram into list of string:
    return p->options.std_dirs

## Tamaño en bytes de un tipo con el layout C del ABI v3 (64-bit, con padding).
##
## El cálculo vive en `layout.pengu`; aquí sólo se conserva la firma histórica
## que usa el resto del LSP.
weave type_size with p as ref to program.SemaProgram, type_id as int into int:
    return calling layout.type_size with p, type_id

## Implementación recursiva de `type_size` (compatibilidad).
weave type_size_at with p as ref to program.SemaProgram, type_id as int, depth as int into int:
    return calling layout.size_of with p, type_id, depth

## `true` si `nm` es el nombre de un tipo incorporado.
weave is_builtin_type_name with nm as string into bool:
    if nm == "int" or nm == "i8" or nm == "i16" or nm == "i32" or nm == "i64":
        return true
    if nm == "u8" or nm == "u16" or nm == "u32" or nm == "u64" or nm == "usize" or nm == "isize":
        return true
    if nm == "byte" or nm == "char" or nm == "bool" or nm == "float" or nm == "f32" or nm == "f64" or nm == "double":
        return true
    if nm == "string" or nm == "void" or nm == "any" or nm == "opaque" or nm == "ref" or nm == "frozen":
        return true
    if nm == "array" or nm == "list" or nm == "slice" or nm == "map" or nm == "maybe" or nm == "result" or nm == "range" or nm == "fn":
        return true
    if nm == "size_t" or nm == "intptr_t" or nm == "uintptr_t" or nm == "ptrdiff_t" or nm == "short" or nm == "ushort" or nm == "long" or nm == "ulong":
        return true
    return false

## Tipo del receptor de `receptor.miembro` a partir del offset del punto.
##
## Usa el nodo AST que termina justo antes del punto; si no tiene anotación,
## cae al símbolo de la palabra. Devuelve `-1` si no se puede resolver.
weave receiver_type_at with p as ref to program.SemaProgram, mid as int, text as string, dot as int into int:
    var probe as int is dot - 1
    var b as ref to frozen byte is bytes of text
    while probe >= 0:
        var c as int is (b at probe) to int
        if c == 32 or c == 9:
            set probe is probe - 1
        else:
            break
    if probe < 0:
        return -1
    var n as int is calling node_at with p, mid, probe
    if n >= 0:
        var t as int is calling node_type with p, mid, n
        if t > 0:
            return t
    return calling type_at_offset with p, mid, text, probe

## Métodos de encantamiento aplicables a un tipo.
##
## Incluye los métodos exactos del receptor y los métodos genéricos (aquellos
## cuyo receptor es un `shard T`), que se resuelven en la llamada.
weave methods_for_type with p as ref to program.SemaProgram, type_id as int into list of int:
    var out as list of int is list of int
    if type_id <= 0:
        return out
    var i as int is 0
    while i < p->symbols.symbols.len:
        var si as sym.SemaSymbol is (p->symbols.symbols at i)
        if si.kind == sym.SemaSymbolKind.SkWeave:
            if calling p->symbols.method_receiver.has with i:
                var recv as int is calling p->symbols.method_receiver.get with i
                if recv == type_id:
                    calling out.push with i
                else:
                    var rt as tk.SemaType is calling types.at with (sigil of p->types), recv
                    if rt.kind == tk.SemaTypeKind.TkTypeParam:
                        calling out.push with i
        set i is i + 1
    return out

## Tipo de un campo de `rune`/`echo` (`-1` si no existe).
weave field_type_at with p as ref to program.SemaProgram, type_id as int, name as string into int:
    if type_id <= 0:
        return -1
    var ty as tk.SemaType is calling types.at with (sigil of p->types), type_id
    if ty.kind != tk.SemaTypeKind.TkRune and ty.kind != tk.SemaTypeKind.TkEcho:
        return -1
    if ty.a < 0 or ty.a >= p->types.nominal_infos.len:
        return -1
    var info as types.SemaNominalInfo is (p->types.nominal_infos at ty.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (p->types.fields at (info.fields_first + i))
        var fnm as string is calling npool.text with (sigil of p->names), f.name
        if fnm == name:
            return f.type
        set i is i + 1
    return -1

## Tipo del payload de una variante de `omen` (`-1` si no existe o no lleva payload).
weave variant_payload_type with p as ref to program.SemaProgram, type_id as int, name as string into int:
    if type_id <= 0:
        return -1
    var ty as tk.SemaType is calling types.at with (sigil of p->types), type_id
    if ty.kind != tk.SemaTypeKind.TkOmen:
        return -1
    if ty.a < 0 or ty.a >= p->types.nominal_infos.len:
        return -1
    var info as types.SemaNominalInfo is (p->types.nominal_infos at ty.a)
    var i as int is 0
    while i < info.variants_count:
        var v as types.SemaVariant is (p->types.variants at (info.variants_first + i))
        var vnm as string is calling npool.text with (sigil of p->names), v.name
        if vnm == name:
            if v.payload_count == 0:
                return -1
            var f as types.SemaField is (p->types.fields at v.payload_first)
            return f.type
        set i is i + 1
    return -1

## Offset del nombre de un símbolo dentro de su declaración.
##
## `si.start` apunta al inicio de la declaración; para hover/rename se necesita
## el identificador. Devuelve `-1` si no se encuentra.
weave symbol_name_start with p as ref to program.SemaProgram, mid as int, sid as int into int:
    if mid < 0 or mid >= p->modules.len:
        return -1
    var si as sym.SemaSymbol is (p->symbols.symbols at sid)
    var nm as string is calling npool.text with (sigil of p->names), si.name
    var m as loader.SemaModule is (p->modules at mid)
    var text as string is m.source.text
    var i as int is 0
    while i < m.lex.tokens.len:
        var tok as pstoken.Token is (m.lex.tokens at i)
        if tok.start >= si.start and tok.end <= si.end:
            if tok.kind == pstoken.TokenKind.TokIdentifier:
                var lex as string is text at tok.start to tok.end
                var same as bool is lex == nm
                banish lex
                if same:
                    return tok.start
        set i is i + 1
    return -1
