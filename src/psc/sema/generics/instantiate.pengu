## psc/sema/generics/instantiate.pengu — materialización de tipos genéricos.
##
## Convierte una plantilla nominal (`Box`, `Node`, `Option`, ...) y sus
## argumentos de tipo en una `SemaNominalInfo` concreta.  La instancia se
## cachea por `(plantilla, args)` y se registra antes de sustituir sus campos
## para que los tipos recursivos (`Node of T` dentro de `Node of T`) terminen.
##
## El compilador sigue siendo explícito: no hay sustitución perezosa en F4.

import std.builder

import psc.sema.names as npool
import psc.sema.symbols.symbol as sym
import psc.sema.symbols.table as symbols
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.types.canonical as canonical

insignia sema_generic_instantiate_

## Clave textual de una instancia (plantilla + args).
##
## ## Memoria
## Devuelve string owned.
weave instance_key with template as int, args as list of int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append_int with template
    var i as int is 0
    while i < args.len:
        calling sb.append with ":"
        calling sb.append_int with (args at i)
        set i is i + 1
    return calling sb.finish

## Nombre C estable de una instancia.
##
## ## Memoria
## Devuelve string owned.
weave instance_c_name with t as ref to types.SemaTypeTable, template as int, args as list of int into string:
    var tinfo as types.SemaNominalInfo is (t->nominal_infos at (calling types.at with t, template).a)
    var base as string is calling npool.text with t->names, tinfo.c_name
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with base
    var i as int is 0
    while i < args.len:
        calling sb.append with "__"
        var an as int is calling canonical.mangled_name with t, (args at i)
        calling sb.append with (calling npool.text with t->names, an)
        set i is i + 1
    return calling sb.finish

## Sustituye un tipo formal por sus argumentos reales.
##
## ## Memoria
## Puede crear nuevos `TypeId` internados; no posee strings.
weave subst_type with t as ref to types.SemaTypeTable, id as int, subst as ref to map of int to int into int:
    if id <= 0:
        return id
    var ty as tk.SemaType is calling types.at with t, id
    if ty.kind == tk.SemaTypeKind.TkTypeParam:
        if calling subst.has with ty.name:
            return calling subst.get with ty.name
        return id
    if ty.kind == tk.SemaTypeKind.TkRef:
        return calling types.ref_to with t, (calling subst_type with t, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkFrozen:
        return calling types.frozen with t, (calling subst_type with t, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkArray:
        return calling types.array_of with t, (calling subst_type with t, ty.a, subst), ty.b
    if ty.kind == tk.SemaTypeKind.TkSlice:
        return calling types.slice_of with t, (calling subst_type with t, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkMany:
        return calling types.many_of with t, (calling subst_type with t, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkList:
        return calling types.list_of with t, (calling subst_type with t, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkMaybe:
        return calling types.maybe_of with t, (calling subst_type with t, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkRange:
        return calling types.range_of with t, (calling subst_type with t, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkMap:
        return calling types.map_of with t, (calling subst_type with t, ty.a, subst), (calling subst_type with t, ty.b, subst)
    if ty.kind == tk.SemaTypeKind.TkResult:
        return calling types.result_of with t, (calling subst_type with t, ty.a, subst), (calling subst_type with t, ty.b, subst)
    if ty.kind == tk.SemaTypeKind.TkTuple:
        var ids as list of int is list of int
        var i as int is 0
        while i < ty.count:
            calling ids.push with (calling subst_type with t, (t->type_children at (ty.first + i)), subst)
            set i is i + 1
        var out as int is calling types.tuple_of with t, ids
        banish ids
        return out
    if ty.kind == tk.SemaTypeKind.TkFn:
        var fi as types.SemaFnInfo is (t->fn_infos at ty.a)
        var first as int is 0
        var count as int is 0
        var j as int is 0
        while j < fi.params_count:
            var p as types.SemaFnParam is (t->fn_params at (fi.params_first + j))
            var np as types.SemaFnParam is with name is p.name, type is (calling subst_type with t, p.type, subst), flags is p.flags, default_node is p.default_node, default_module is p.default_module, default_text is p.default_text
            var idx as int is calling types.add_fn_param with t, np
            if count == 0:
                set first is idx
            set count is count + 1
            set j is j + 1
        var ni as types.SemaFnInfo is with params_first is first, params_count is count, return_type is (calling subst_type with t, fi.return_type, subst), tparams_first is 0, tparams_count is 0, flags is fi.flags, attrs_node is fi.attrs_node
        return calling types.fn_type with t, ni
    # Nominales ya instanciados, primitivos y tipos sintéticos.
    return id

## `true` si el tipo contiene un `TkTypeParam` (versión local para no importar
## `convert`, que ya importa este módulo).
##
## ## Memoria
## O(profundidad).
weave has_param with t as ref to types.SemaTypeTable, id as int into bool:
    if id <= 0:
        return false
    var ty as tk.SemaType is calling types.at with t, id
    if ty.kind == tk.SemaTypeKind.TkTypeParam:
        return true
    if ty.kind == tk.SemaTypeKind.TkRef or ty.kind == tk.SemaTypeKind.TkFrozen or ty.kind == tk.SemaTypeKind.TkArray or ty.kind == tk.SemaTypeKind.TkList or ty.kind == tk.SemaTypeKind.TkSlice or ty.kind == tk.SemaTypeKind.TkMany or ty.kind == tk.SemaTypeKind.TkMaybe or ty.kind == tk.SemaTypeKind.TkRange:
        return calling has_param with t, ty.a
    if ty.kind == tk.SemaTypeKind.TkMap or ty.kind == tk.SemaTypeKind.TkResult:
        return (calling has_param with t, ty.a) or (calling has_param with t, ty.b)
    if ty.kind == tk.SemaTypeKind.TkFn:
        var fi as types.SemaFnInfo is (t->fn_infos at ty.a)
        var pi as int is 0
        while pi < fi.params_count:
            var fp as types.SemaFnParam is (t->fn_params at (fi.params_first + pi))
            if calling has_param with t, fp.type:
                return true
            set pi is pi + 1
        return calling has_param with t, fi.return_type
    if ty.kind == tk.SemaTypeKind.TkTuple:
        var i as int is 0
        while i < ty.count:
            if calling has_param with t, (t->type_children at (ty.first + i)):
                return true
            set i is i + 1
    return false

## Sustituye en profundidad y re-instancia nominales cuyos argumentos cambian.
##
## A diferencia de `subst_type`, `Box of T` pasa a `Box of int` cuando `T` está
## en `subst`; el resultado es el `TypeId` de la instancia concreta.
##
## ## Memoria
## Puede crear tipos/instancias internados; no posee strings.
weave subst_deep with s as ref to symbols.SemaSymbols, id as int, subst as map of int to int into int:
    if id <= 0 or subst.len == 0:
        return id
    var t as ref to types.SemaTypeTable is s->types
    var ty as tk.SemaType is calling types.at with t, id
    if ty.kind == tk.SemaTypeKind.TkTypeParam:
        if calling subst.has with ty.name:
            return calling subst.get with ty.name
        return id
    var ii as int is calling symbols.instance_for_type with s, id
    if ii >= 0:
        var inst as sym.SemaInstance is (s->instances at ii)
        var nargs as list of int is list of int
        defer banish nargs
        var changed as bool is false
        var ai as int is 0
        while ai < inst.args_count:
            var oa as int is (s->instance_args at (inst.args_first + ai))
            var na as int is calling subst_deep with s, oa, subst
            if na != oa:
                set changed is true
            calling nargs.push with na
            set ai is ai + 1
        if changed and inst.template_type > 0:
            var nid as int is calling instantiate_nominal with s, inst.template_type, nargs
            if nid > 0:
                return nid
        return id
    if ty.kind == tk.SemaTypeKind.TkRef:
        return calling types.ref_to with t, (calling subst_deep with s, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkFrozen:
        return calling types.frozen with t, (calling subst_deep with s, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkArray:
        return calling types.array_of with t, (calling subst_deep with s, ty.a, subst), ty.b
    if ty.kind == tk.SemaTypeKind.TkSlice:
        return calling types.slice_of with t, (calling subst_deep with s, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkMany:
        return calling types.many_of with t, (calling subst_deep with s, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkList:
        return calling types.list_of with t, (calling subst_deep with s, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkMaybe:
        return calling types.maybe_of with t, (calling subst_deep with s, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkRange:
        return calling types.range_of with t, (calling subst_deep with s, ty.a, subst)
    if ty.kind == tk.SemaTypeKind.TkMap:
        return calling types.map_of with t, (calling subst_deep with s, ty.a, subst), (calling subst_deep with s, ty.b, subst)
    if ty.kind == tk.SemaTypeKind.TkResult:
        return calling types.result_of with t, (calling subst_deep with s, ty.a, subst), (calling subst_deep with s, ty.b, subst)
    if ty.kind == tk.SemaTypeKind.TkTuple:
        var ids as list of int is list of int
        defer banish ids
        var i as int is 0
        while i < ty.count:
            calling ids.push with (calling subst_deep with s, (t->type_children at (ty.first + i)), subst)
            set i is i + 1
        return calling types.tuple_of with t, ids
    return calling subst_type with t, id, (sigil of subst)

## Whether `id` mentions the type parameter `name` anywhere inside it.
##
## This guards inference against self-referential bindings such as `A := Job of A`,
## which happens when a generic worker value is unified before its argument.
weave type_mentions_param with s as ref to symbols.SemaSymbols, id as int, name as int into bool:
    if id <= 0:
        return false
    var t as ref to types.SemaTypeTable is s->types
    var ty as tk.SemaType is calling types.at with t, id
    if ty.kind == tk.SemaTypeKind.TkTypeParam:
        return ty.name == name
    if ty.kind == tk.SemaTypeKind.TkRef or ty.kind == tk.SemaTypeKind.TkFrozen or ty.kind == tk.SemaTypeKind.TkArray or ty.kind == tk.SemaTypeKind.TkList or ty.kind == tk.SemaTypeKind.TkSlice or ty.kind == tk.SemaTypeKind.TkMany or ty.kind == tk.SemaTypeKind.TkMaybe or ty.kind == tk.SemaTypeKind.TkRange:
        return calling type_mentions_param with s, ty.a, name
    if ty.kind == tk.SemaTypeKind.TkMap or ty.kind == tk.SemaTypeKind.TkResult:
        return (calling type_mentions_param with s, ty.a, name) or (calling type_mentions_param with s, ty.b, name)
    if ty.kind == tk.SemaTypeKind.TkTuple:
        var i as int is 0
        while i < ty.count:
            if calling type_mentions_param with s, (t->type_children at (ty.first + i)), name:
                return true
            set i is i + 1
        return false
    if ty.kind == tk.SemaTypeKind.TkFn:
        var fi as types.SemaFnInfo is (t->fn_infos at ty.a)
        var pi as int is 0
        while pi < fi.params_count:
            var fp as types.SemaFnParam is (t->fn_params at (fi.params_first + pi))
            if calling type_mentions_param with s, fp.type, name:
                return true
            set pi is pi + 1
        return calling type_mentions_param with s, fi.return_type, name
    var ii as int is calling symbols.instance_for_type with s, id
    if ii >= 0:
        var inst as sym.SemaInstance is (s->instances at ii)
        var ai as int is 0
        while ai < inst.args_count:
            if calling type_mentions_param with s, (s->instance_args at (inst.args_first + ai)), name:
                return true
            set ai is ai + 1
    return false

## Unifica un tipo formal con uno actual y anota los type params por nombre.
##
## Es la mitad "inferencia" de la instanciación: dado `list of T` y `list of
## int`, deja `T -> int` en `subst`. Los tipos sintéticos (any/void/error) y
## los nominales ya instanciados no se unifican.
##
## ## Memoria
## Escribe en `subst` (prestado); no posee strings.
weave unify_param with s as ref to symbols.SemaSymbols, formal as int, actual as int, subst as ref to map of int to int into void:
    if formal <= 0 or actual <= 0:
        return
    if formal == actual:
        return
    var t as ref to types.SemaTypeTable is s->types
    var ft as tk.SemaType is calling types.at with t, formal
    var at as tk.SemaType is calling types.at with t, actual
    if ft.kind == tk.SemaTypeKind.TkTypeParam:
        if not (calling subst.has with ft.name):
            if not (calling type_mentions_param with s, actual, ft.name):
                calling subst.put with ft.name, actual
        return
    if at.kind == tk.SemaTypeKind.TkAny or at.kind == tk.SemaTypeKind.TkError:
        return
    if ft.kind == tk.SemaTypeKind.TkRef or ft.kind == tk.SemaTypeKind.TkFrozen or ft.kind == tk.SemaTypeKind.TkArray or ft.kind == tk.SemaTypeKind.TkList or ft.kind == tk.SemaTypeKind.TkSlice or ft.kind == tk.SemaTypeKind.TkMany or ft.kind == tk.SemaTypeKind.TkMaybe or ft.kind == tk.SemaTypeKind.TkRange:
        if at.kind == ft.kind:
            calling unify_param with s, ft.a, at.a, subst
        return
    if ft.kind == tk.SemaTypeKind.TkMap or ft.kind == tk.SemaTypeKind.TkResult:
        if at.kind == ft.kind:
            calling unify_param with s, ft.a, at.a, subst
            calling unify_param with s, ft.b, at.b, subst
        return
    if ft.kind == tk.SemaTypeKind.TkRune or ft.kind == tk.SemaTypeKind.TkEcho or ft.kind == tk.SemaTypeKind.TkOmen or ft.kind == tk.SemaTypeKind.TkAlias or ft.kind == tk.SemaTypeKind.TkSeal or ft.kind == tk.SemaTypeKind.TkConcept:
        var fii as int is calling symbols.instance_for_type with s, formal
        var aii as int is calling symbols.instance_for_type with s, actual
        if fii >= 0 and aii >= 0:
            var finst as sym.SemaInstance is (s->instances at fii)
            var ainst as sym.SemaInstance is (s->instances at aii)
            if finst.template_type == ainst.template_type and finst.args_count == ainst.args_count:
                var qi as int is 0
                while qi < finst.args_count:
                    calling unify_param with s, (s->instance_args at (finst.args_first + qi)), (s->instance_args at (ainst.args_first + qi)), subst
                    set qi is qi + 1
        return
    if ft.kind == tk.SemaTypeKind.TkFn:
        if at.kind == tk.SemaTypeKind.TkFn:
            var fi as types.SemaFnInfo is (t->fn_infos at ft.a)
            var ai as types.SemaFnInfo is (t->fn_infos at at.a)
            var pi as int is 0
            while pi < fi.params_count and pi < ai.params_count:
                var fp as types.SemaFnParam is (t->fn_params at (fi.params_first + pi))
                var ap as types.SemaFnParam is (t->fn_params at (ai.params_first + pi))
                calling unify_param with s, fp.type, ap.type, subst
                set pi is pi + 1
            calling unify_param with s, fi.return_type, ai.return_type, subst
        return
    if ft.kind == tk.SemaTypeKind.TkTuple:
        if at.kind == tk.SemaTypeKind.TkTuple and ft.count == at.count:
            var i as int is 0
            while i < ft.count:
                calling unify_param with s, (t->type_children at (ft.first + i)), (t->type_children at (at.first + i)), subst
                set i is i + 1

## Resuelve el retorno de una firma genérica con los tipos reales.
##
## ## Memoria
## Puede crear tipos internados; devuelve el retorno sustituido.
weave instantiate_return with s as ref to symbols.SemaSymbols, info as types.SemaFnInfo, recv_template as int, recv_actual as int, arg_types as list of int into int:
    var t as ref to types.SemaTypeTable is s->types
    var hasp as bool is calling has_param with t, info.return_type
    var pi as int is 0
    while pi < info.params_count:
        var p as types.SemaFnParam is (t->fn_params at (info.params_first + pi))
        if calling has_param with t, p.type:
            set hasp is true
        set pi is pi + 1
    if not hasp:
        return info.return_type
    var subst as map of int to int is map of int to int
    if recv_template > 0 and recv_actual > 0:
        calling unify_param with s, recv_template, recv_actual, (sigil of subst)
    var ai as int is 0
    while ai < arg_types.len and ai < info.params_count:
        var p2 as types.SemaFnParam is (t->fn_params at (info.params_first + ai))
        calling unify_param with s, p2.type, (arg_types at ai), (sigil of subst)
        set ai is ai + 1
    var ret as int is info.return_type
    if subst.len > 0:
        var rt2 as int is calling subst_deep with s, info.return_type, subst
        if rt2 > 0:
            set ret is rt2
    banish subst
    return ret

## Mapea una clase nominal al `SemaSymbolKind` de su plantilla.
##
## ## Memoria
## No asigna.
weave instance_symbol_kind with k as tk.SemaNominalKind into sym.SemaSymbolKind:
    if k == tk.SemaNominalKind.NkEcho:
        return sym.SemaSymbolKind.SkEcho
    if k == tk.SemaNominalKind.NkOmen:
        return sym.SemaSymbolKind.SkOmen
    if k == tk.SemaNominalKind.NkAlias:
        return sym.SemaSymbolKind.SkAlias
    if k == tk.SemaNominalKind.NkSeal:
        return sym.SemaSymbolKind.SkSeal
    if k == tk.SemaNominalKind.NkConcept:
        return sym.SemaSymbolKind.SkConcept
    return sym.SemaSymbolKind.SkRune

## Materializa una instancia nominal.
##
## `template` es el `TypeId` de la plantilla; `args` son sus argumentos ya
## convertidos. Devuelve el `TypeId` de la instancia o `-1` si la aridad no
## coincide.
##
## ## Memoria
## Añade `SemaNominalInfo`, campos, variantes, `SemaInstance` y args.
weave instantiate_nominal with s as ref to symbols.SemaSymbols, template as int, args as list of int into int:
    if template <= 0:
        return -1
    var t as ref to types.SemaTypeTable is s->types
    var tt as tk.SemaType is calling types.at with t, template
    if tt.kind != tk.SemaTypeKind.TkRune and tt.kind != tk.SemaTypeKind.TkEcho and tt.kind != tk.SemaTypeKind.TkOmen and tt.kind != tk.SemaTypeKind.TkAlias and tt.kind != tk.SemaTypeKind.TkSeal and tt.kind != tk.SemaTypeKind.TkConcept:
        return -1
    var tinfo as types.SemaNominalInfo is (t->nominal_infos at tt.a)
    if args.len != tinfo.tparams_count:
        return -1
    var keytxt as string is calling instance_key with template, args
    var key as int is calling npool.intern with s->names, keytxt
    banish keytxt
    if calling s->instance_keys.has with key:
        var old as int is calling s->instance_keys.get with key
        var oi as sym.SemaInstance is (s->instances at old)
        return oi.type

    var cname_txt as string is calling instance_c_name with t, template, args
    var cname as int is calling npool.intern with s->names, cname_txt
    banish cname_txt

    var info as types.SemaNominalInfo is with kind is tinfo.kind, base_name is cname, c_name is cname, module is tinfo.module, flags is tinfo.flags, fields_first is 0, fields_count is 0, variants_first is 0, variants_count is 0, tparams_first is 0, tparams_count is 0, derived_first is 0, derived_count is 0, template_info is tt.a, attrs_node is tinfo.attrs_node, is_packed is tinfo.is_packed, align_override is tinfo.align_override
    var info_idx as int is t->nominal_infos.len
    calling t->nominal_infos.push with info

    # Sustitución T -> args (necesaria para el target de alias/seal).
    var subst as map of int to int is map of int to int
    var ti as int is 0
    while ti < args.len and ti < tinfo.tparams_count:
        var tp as types.SemaTypeParamInfo is (t->tparams at (tinfo.tparams_first + ti))
        calling subst.put with tp.name, (args at ti)
        set ti is ti + 1
    var bval as int is template
    if (tt.kind == tk.SemaTypeKind.TkAlias or tt.kind == tk.SemaTypeKind.TkSeal) and tt.b > 0:
        set bval is calling subst_type with t, tt.b, (sigil of subst)
    var ity as tk.SemaType is with kind is tt.kind, name is cname, a is info_idx, b is bval, c is 0, first is 0, count is 0
    var iid as int is calling types.intern_type with t, ity

    # Registrar la instancia antes de poblar campos (recursión).
    var args_first as int is s->instance_args.len
    var ai as int is 0
    while ai < args.len:
        calling s->instance_args.push with (args at ai)
        set ai is ai + 1
    var inst as sym.SemaInstance is with kind is (calling instance_symbol_kind with tinfo.kind), template_node is -1, template_symbol is -1, template_type is template, args_first is args_first, args_count is args.len, receiver is -1, type is iid, flags is 0
    var inst_idx as int is s->instances.len
    calling s->instances.push with inst
    calling s->instance_keys.put with key, inst_idx
    calling s->instance_by_type.put with iid, inst_idx

    # Campos concretos. `subst_deep` (no `subst_type`) sustituye también los
    # argumentos anidados de un nominal genérico (`Inner of A`), y se usa una
    # lista temporal para que las instancias anidadas no contaminen el rango.
    var pending_fields as list of types.SemaField is list of types.SemaField
    var pending_variants as list of types.SemaVariant is list of types.SemaVariant
    var pending_payloads as list of types.SemaField is list of types.SemaField
    defer banish pending_fields
    defer banish pending_variants
    defer banish pending_payloads
    var fi as int is 0
    while fi < tinfo.fields_count:
        var f as types.SemaField is (t->fields at (tinfo.fields_first + fi))
        var nf as types.SemaField is with name is f.name, type is (calling subst_deep with s, f.type, subst), flags is f.flags, attrs_node is f.attrs_node, align_override is f.align_override, decl_node is f.decl_node
        calling pending_fields.push with nf
        set fi is fi + 1
    var fields_first as int is t->fields.len
    var fc as int is 0
    while fc < pending_fields.len:
        var pfld as types.SemaField is (pending_fields at fc)
        var ignored as int is calling types.add_field with t, pfld
        set fc is fc + 1
    calling types.set_nominal_fields with t, info_idx, fields_first, fc

    # Variantes de un omen (payloads sustituidos).
    var vi as int is 0
    while vi < tinfo.variants_count:
        var v as types.SemaVariant is (t->variants at (tinfo.variants_first + vi))
        var pstart as int is pending_payloads.len
        var pc as int is 0
        var pi as int is 0
        while pi < v.payload_count:
            var pf as types.SemaField is (t->fields at (v.payload_first + pi))
            var npf as types.SemaField is with name is pf.name, type is (calling subst_deep with s, pf.type, subst), flags is pf.flags, attrs_node is pf.attrs_node, align_override is pf.align_override, decl_node is pf.decl_node
            calling pending_payloads.push with npf
            set pc is pc + 1
            set pi is pi + 1
        var nv0 as types.SemaVariant is with name is v.name, value_i is v.value_i, value_s is v.value_s, payload_first is pstart, payload_count is pc, flags is v.flags
        calling pending_variants.push with nv0
        set vi is vi + 1
    var vfirst as int is t->variants.len
    var vc as int is 0
    var pvi as int is 0
    while pvi < pending_variants.len:
        var pv as types.SemaVariant is (pending_variants at pvi)
        var pfirst as int is t->fields.len
        var pki as int is 0
        while pki < pv.payload_count:
            var ppf as types.SemaField is (pending_payloads at (pv.payload_first + pki))
            var ignored2 as int is calling types.add_field with t, ppf
            set pki is pki + 1
        var nv as types.SemaVariant is with name is pv.name, value_i is pv.value_i, value_s is pv.value_s, payload_first is pfirst, payload_count is pv.payload_count, flags is pv.flags
        var ignored3 as int is calling types.add_variant with t, nv
        set vc is vc + 1
        set pvi is pvi + 1
    calling types.set_nominal_variants with t, info_idx, vfirst, vc

    # Derivaciones: las conservamos; F4 las usa para emitir clone/cleanup.
    var dfirst as int is t->derived.len
    var dc as int is 0
    var di as int is 0
    while di < tinfo.derived_count:
        var d as int is (t->derived at (tinfo.derived_first + di))
        var ignored4 as int is calling types.add_derived with t, d
        set dc is dc + 1
        set di is di + 1
    calling types.set_nominal_derived with t, info_idx, dfirst, dc

    banish subst
    return iid
