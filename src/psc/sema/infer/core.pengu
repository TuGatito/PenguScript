## psc/sema/infer/core.pengu — inferencia de expresiones (núcleo).
##
## Cubre literales, referencias, operadores, accesos, llamadas simples y
## constructores de contenedores. Las construcciones que necesitan el checker
## (`if`/`do`/`with`/`judge`/lambda) se delegan a `SemaHooks`; así el módulo no
## importa `check` y no hay ciclos.
##
## ## Memoria
## Todo es de solo lectura sobre la tabla de tipos/símbolos. Los strings
## temporales se liberan en la misma función.

import std.diagnostic as diag
import std.spark
import std.scrolls as scrolls

import psc.ast.kind as pskind
import psc.ast.node as psast
import psc.source as psource
import psc.lexer_state as psstate
import psc.lexer_decode as psdecode

import psc.sema.names as npool
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.types.compat as compat
import psc.sema.types.convert as convert
import psc.sema.types.embeds as embeds
import psc.sema.types.canonical as canon
import psc.sema.generics.instantiate as ginst
import psc.sema.symbols.table as symbols
import psc.sema.symbols.symbol as sym
import psc.sema.modules.loader as loader
import psc.sema.symbols.scope as scope
import psc.sema.ast as astutil
import psc.sema.state as state
import psc.sema.annotate as ann
import psc.sema.diagnostics as sdiag
import psc.sema.check.moves as moves
import psc.parse.api as parse_api
import psc.diag_compat as diag_compat
import psc.span as pspan

insignia sema_infer_

## Infiere una expresión y la anota.
##
## `expected` es `-1` si no hay contexto. Devuelve `0` (`TkError`) en error.
##
## ## Memoria
## Puede emitir diagnósticos; no posee recursos.
weave infer with s as ref to state.SemaState, node as int, expected as int into int:
    if node < 0:
        return 0
    var kind as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    var t as int is 0
    if kind == pskind.NodeKind.NdIntLit:
        set t is calling infer_int with s, node
    else if kind == pskind.NodeKind.NdFloatLit:
        set t is calling types.base with s->types, "float"
    else if kind == pskind.NodeKind.NdStringLit:
        # Los bindings C esperan `const char*`; en ese contexto el literal es
        # directamente un puntero y no un `PenguString`.
        if expected > 0 and (calling compat.is_cstr with s->types, expected) and not (calling string_literal_has_interp with s, node):
            set t is expected
        else:
            calling check_string_literal with s, node
            set t is calling types.base with s->types, "string"
    else if kind == pskind.NodeKind.NdCharLit:
        set t is calling types.base with s->types, "char"
    else if kind == pskind.NodeKind.NdTrueLit or kind == pskind.NodeKind.NdFalseLit:
        set t is calling types.base with s->types, "bool"
    else if kind == pskind.NodeKind.NdNullLit:
        set t is 2
    else if kind == pskind.NodeKind.NdErrorLit:
        set t is calling infer_error_lit with s, node
    else if kind == pskind.NodeKind.NdMaybeNone:
        set t is calling infer_none with s, node, expected
    else if kind == pskind.NodeKind.NdVarRef:
        set t is calling infer_var with s, node
    else if kind == pskind.NodeKind.NdSelfRef:
        set t is calling infer_name with s, node, "self", node
    else if kind == pskind.NodeKind.NdParenExpr:
        set t is calling infer with s, (calling astutil.node_child with s->ast, node, 0), expected
    else if kind == pskind.NodeKind.NdSomeExpr:
        var inner as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), -1
        set t is calling types.maybe_of with s->types, inner
    else if kind == pskind.NodeKind.NdDonumExpr:
        set t is calling infer_donum with s, node, expected
    else if kind == pskind.NodeKind.NdDefinedExpr:
        set t is calling types.base with s->types, "bool"
    else if kind == pskind.NodeKind.NdCallingExpr:
        set t is calling infer_call with s, node, expected
    else if kind == pskind.NodeKind.NdGenericRef:
        set t is calling infer_generic_ref with s, node
    else if kind == pskind.NodeKind.NdChainExpr:
        set t is calling infer_chain with s, node
    else if kind == pskind.NodeKind.NdFieldAccess:
        set t is calling infer_field with s, node
    else if kind == pskind.NodeKind.NdArrowAccess:
        set t is calling infer_arrow with s, node
    else if kind == pskind.NodeKind.NdAtExpr:
        set t is calling infer_at with s, node
    else if kind == pskind.NodeKind.NdSliceAtExpr:
        var sbase as int is calling astutil.node_child with s->ast, node, 0
        if sbase >= 0:
            var bty as int is calling infer with s, sbase, -1
            var bsty as tk.SemaType is calling types.at with s->types, bty
            if bsty.kind == tk.SemaTypeKind.TkBase and (calling compat.is_string with s->types, bty):
                set t is bty
            else:
                var elem as int is calling compat.element_type with s->types, bty
                if bsty.kind == tk.SemaTypeKind.TkMap:
                    set elem is bsty.b
                set t is calling types.slice_of with s->types, elem
        else:
            set t is 0
    else if kind == pskind.NodeKind.NdLengthExpr:
        set t is calling types.base with s->types, "int"
    else if kind == pskind.NodeKind.NdToExpr:
        set t is calling infer_to with s, node
    else if kind == pskind.NodeKind.NdTransmute:
        # El operando se infiere siempre, aunque el tipo resultante sea el del
        # destino: sus hijos necesitan anotación para el codegen. Una lambda es
        # el caso crítico, porque sin tipo `signature` devuelve "" y no se
        # emiten ni el prototipo ni el cuerpo de la función C.
        var tv as int is calling astutil.node_child with s->ast, node, 0
        var tvty as int is -1
        if tv >= 0:
            set tvty is calling infer with s, tv, -1
        var tn as int is calling astutil.node_child with s->ast, node, 1
        if tn >= 0:
            var ctx as convert.TypeCtx is with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast
            set t is calling convert.convert with (sigil of ctx), tn
        if t <= 0:
            set t is tvty
    else if kind == pskind.NodeKind.NdListInitExpr:
        set t is calling infer_list_init with s, node, expected
    else if kind == pskind.NodeKind.NdMapInitExpr:
        set t is calling infer_map_init with s, node, expected
    else if kind == pskind.NodeKind.NdArrayInitExpr:
        set t is calling infer_array_init with s, node, expected
    else if kind == pskind.NodeKind.NdArrayLit:
        set t is calling infer_list_lit with s, node, expected
    else if kind == pskind.NodeKind.NdMapLit:
        set t is calling infer_map_lit with s, node, expected
    else if kind == pskind.NodeKind.NdWithTarget:
        set t is calling infer_with_field with s, node
        if expected > 0:
            set t is expected
    else if kind == pskind.NodeKind.NdStructInit:
        set t is calling infer_struct_init with s, node
        if t <= 0 and expected > 0:
            set t is expected
        calling infer_field_inits with s, node, t
    else if kind == pskind.NodeKind.NdBoolOr or kind == pskind.NodeKind.NdBoolAnd:
        set t is calling infer_bool with s, node
    else if kind == pskind.NodeKind.NdIsPresent or kind == pskind.NodeKind.NdIsNotPresent or kind == pskind.NodeKind.NdIsTrue or kind == pskind.NodeKind.NdIsFalse or kind == pskind.NodeKind.NdInExpr or kind == pskind.NodeKind.NdNotInExpr:
        var il as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), -1
        if kind == pskind.NodeKind.NdInExpr or kind == pskind.NodeKind.NdNotInExpr:
            var ir as int is calling infer with s, (calling astutil.node_child with s->ast, node, 1), -1
        set t is calling types.base with s->types, "bool"
    else if kind == pskind.NodeKind.NdEq or kind == pskind.NodeKind.NdNe or kind == pskind.NodeKind.NdLt or kind == pskind.NodeKind.NdLe or kind == pskind.NodeKind.NdGt or kind == pskind.NodeKind.NdGe:
        set t is calling infer_compare with s, node
    else if kind == pskind.NodeKind.NdAdd or kind == pskind.NodeKind.NdSub or kind == pskind.NodeKind.NdMul or kind == pskind.NodeKind.NdDiv or kind == pskind.NodeKind.NdMod:
        set t is calling infer_arith with s, node
    else if kind == pskind.NodeKind.NdBitwiseOr or kind == pskind.NodeKind.NdBitwiseAnd or kind == pskind.NodeKind.NdBitwiseXor or kind == pskind.NodeKind.NdShl or kind == pskind.NodeKind.NdShr:
        set t is calling infer_bit with s, node
    else if kind == pskind.NodeKind.NdNeg or kind == pskind.NodeKind.NdBitNot or kind == pskind.NodeKind.NdLogNot:
        set t is calling infer_unary with s, node
    else if kind == pskind.NodeKind.NdRangeDotdot:
        set t is calling infer_range with s, node
    else if kind == pskind.NodeKind.NdSigilOf:
        var schild as int is calling astutil.node_child with s->ast, node, 0
        var sinner as int is calling infer with s, schild, -1
        var sstatus as int is calling sigil_status with s, schild
        if sstatus == 3:
            calling sigil_const_error with s, node
            set t is 0
        else if sstatus == 0:
            calling sigil_lvalue_error with s, node
            set t is 0
        else:
            var sbase as int is sinner
            if sstatus == 2 and not (calling types.is_frozen with s->types, sinner):
                set sbase is calling types.frozen with s->types, sinner
            set t is calling types.ref_to with s->types, sbase
    else if kind == pskind.NodeKind.NdEssenceOf:
        var echild as int is calling astutil.node_child with s->ast, node, 0
        var einner as int is calling infer with s, echild, -1
        var euid as int is calling types.underlying with s->types, einner
        var ety as tk.SemaType is calling types.at with s->types, euid
        if ety.kind == tk.SemaTypeKind.TkRef:
            set t is calling types.strip_frozen with s->types, ety.a
        else if calling is_self_value with s, echild:
            # En un receptor por valor, `self` ya es el valor: `essence of self`
            # es una identidad histórica y el codegen la emite como tal.
            set t is einner
        else:
            calling essence_error with s, node, einner
            set t is 0
    else if kind == pskind.NodeKind.NdChrExpr:
        set t is calling types.base with s->types, "string"
    else if kind == pskind.NodeKind.NdOrdExpr:
        var ordn as int is calling astutil.node_child with s->ast, node, 0
        if ordn >= 0:
            var ogot as int is calling infer with s, ordn, -1
            var oty as tk.SemaType is calling types.at with s->types, ogot
            var chid as int is calling types.base with s->types, "char"
            var okord as bool is false
            if oty.kind == tk.SemaTypeKind.TkBase:
                var oname as string is calling npool.text with s->names, oty.name
                if oname == "char" or oname == "string":
                    set okord is true
            if not okord:
                calling type_mismatch with s, ordn, chid, ogot
        set t is calling types.base with s->types, "int"
    else if kind == pskind.NodeKind.NdBytesExpr:
        var frozen_byte as int is calling types.frozen with s->types, (calling types.base with s->types, "byte")
        set t is calling types.ref_to with s->types, frozen_byte
    else if kind == pskind.NodeKind.NdSizeOf or kind == pskind.NodeKind.NdAlignOf:
        # El tipo del `size of` debe quedar instanciado en F3: si solo lo
        # resuelve el codegen, el catálogo de tipos ya está cerrado y la
        # especialización (`Pair of string`) no se emite.
        var szn as int is calling astutil.node_child with s->ast, node, 0
        if szn >= 0:
            var sztc as convert.TypeCtx is with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast
            var ignored_sz as int is calling convert.convert with (sigil of sztc), szn
        set t is calling types.base with s->types, "usize"
    else if kind == pskind.NodeKind.NdTypeOf:
        var tof as int is calling astutil.node_child with s->ast, node, 0
        if tof >= 0:
            var ignored_tof as int is calling infer with s, tof, -1
        set t is calling types.base with s->types, "string"
    else if kind == pskind.NodeKind.NdOrElse or kind == pskind.NodeKind.NdOrReturn or kind == pskind.NodeKind.NdOrBlock:
        set t is calling infer_or with s, node, expected
    else if kind == pskind.NodeKind.NdTryExpr:
        var inner_try as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), expected
        var it as tk.SemaType is calling types.at with s->types, inner_try
        if it.kind == tk.SemaTypeKind.TkMaybe or it.kind == tk.SemaTypeKind.TkResult:
            set t is it.a
        else:
            set t is inner_try
    else if kind == pskind.NodeKind.NdForComp:
        set t is calling infer_for_comp with s, node
    else if kind == pskind.NodeKind.NdIfExpr or kind == pskind.NodeKind.NdWhenExpr:
        set t is calling infer_if_expr with s, node, expected
    else if kind == pskind.NodeKind.NdJudgeExpr or kind == pskind.NodeKind.NdJudgeOverExpr:
        set t is calling state.call_judge with s, node, expected
    else if kind == pskind.NodeKind.NdLambdaExpr or kind == pskind.NodeKind.NdLambdaNoParams:
        set t is calling state.call_lambda with s, node
    else if kind == pskind.NodeKind.NdWithInitExpr:
        set t is calling state.call_with with s, node, expected
    else if kind == pskind.NodeKind.NdDoExpr:
        set t is calling infer_do with s, node, expected
    else if kind == pskind.NodeKind.NdBanishExpr:
        set t is 3
    else:
        # Constructo fuera del subconjunto modelado: conservar el tipo esperado
        # para no rechazar código válido ni encadenar errores. La política y sus
        # límites están documentados en `psc/docs/PARITY.md`.
        if expected >= 0:
            set t is expected
        else:
            set t is 1
    calling ann.set_type with s->annotations, node, t
    return t

## ¿El literal string de `node` contiene interpolación `{...}`?
##
## Los literales que se emiten como `const char*` no pueden interpolar: el
## resultado sería un `PenguString`, no un puntero C.
##
## ## Memoria
## O(n); no asigna.
weave string_literal_has_interp with s as ref to state.SemaState, node as int into bool:
    if s->lex->strings.len == 0:
        return false
    var ns as int is calling astutil.start_of with s->ast, node
    var ne as int is calling astutil.end_of with s->ast, node
    var i as int is 0
    while i < s->lex->strings.len:
        var si as psstate.StringInfo is (s->lex->strings at i)
        if si.has_interp and si.content_start >= ns and si.content_end <= ne:
            return true
        set i is i + 1
    return false

## Índice del `:` de un especificador de formato `{expr:spec}`, o `-1`.
##
## Ignora los `:` dentro de paréntesis, corchetes y literales de cadena, para
## que `{f with "a:b"}` siga siendo válido.
##
## ## Memoria
## O(n).
weave format_spec_colon with text as string into int:
    var b as ref to frozen byte is bytes of text
    var i as int is 0
    var n as int is text length
    var depth as int is 0
    var quote as int is 0
    while i < n:
        var code as int is ((b at i) to int)
        if quote != 0:
            if code == 92:
                set i is i + 1
            else if code == quote:
                set quote is 0
        else if code == 34 or code == 39:
            set quote is code
        else if code == 40 or code == 91:
            set depth is depth + 1
        else if code == 41 or code == 93:
            if depth > 0:
                set depth is depth - 1
        else if code == 58 and depth == 0:
            return i
        set i is i + 1
    return -1

## `true` si `spec` es un especificador printf soportado.
##
## Gramática: banderas `-+ 0#`, ancho, precisión y una conversión de
## `diouxXeEfFgGsc`. El codegen lo usa tal cual tras el `%`.
##
## ## Memoria
## O(n).
weave format_spec_ok with spec as string into bool:
    var n as int is spec length
    if n == 0:
        return false
    var b as ref to frozen byte is bytes of spec
    var last as int is ((b at (n - 1)) to int)
    var conv_ok as bool is false
    if last == 100 or last == 105 or last == 111 or last == 117 or last == 120 or last == 88:
        set conv_ok is true
    if last == 101 or last == 69 or last == 102 or last == 70 or last == 103 or last == 71:
        set conv_ok is true
    if last == 115 or last == 99:
        set conv_ok is true
    if not conv_ok:
        return false
    var i as int is 0
    var dots as int is 0
    while i < n - 1:
        var code as int is ((b at i) to int)
        var okc as bool is false
        if code == 45 or code == 43 or code == 32 or code == 48 or code == 35:
            set okc is true
        if code >= 48 and code <= 57:
            set okc is true
        if code == 46:
            set okc is true
            set dots is dots + 1
        if not okc:
            return false
        set i is i + 1
    if dots > 1:
        return false
    return true

## Comprueba las interpolaciones de un literal string en el scope actual.
##
## ## Memoria
## Parsea/infiere AST temporal; libera bundle, bag y anotaciones.
weave check_string_literal with s as ref to state.SemaState, node as int into void:
    if s->lex->strings.len == 0:
        return
    var ns as int is calling astutil.start_of with s->ast, node
    var ne as int is calling astutil.end_of with s->ast, node
    var i as int is 0
    while i < s->lex->strings.len:
        var si as psstate.StringInfo is (s->lex->strings at i)
        if si.has_interp and si.content_start >= ns and si.content_end <= ne:
            var j as int is 0
            while j < si.part_count:
                var part as psstate.StringPart is (s->lex->parts at (si.part_start + j))
                if part.kind == SegInterp:
                    var sp as pspan.ByteSpan is with start is part.start, end is part.end
                    var raw as string is calling s->src.slice with sp
                    defer banish raw
                    # Los escapes del string externo (`\"`) ya están resueltos
                    # cuando el parser ve la expresión (bug 16).
                    var txt as string is calling psdecode.decode_text with raw, false
                    defer banish txt
                    var expr_txt as string is txt
                    var spec as string is ""
                    var cpos as int is calling format_spec_colon with txt
                    if cpos >= 0:
                        var tlen as int is txt length
                        set expr_txt is txt at 0 to cpos
                        set spec is txt at (cpos + 1) to tlen
                        if not (calling format_spec_ok with spec):
                            var smsg as string is "invalid format spec ':{spec}'"
                            defer banish smsg
                            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_INTERP_PARSE, part.start, part.end, smsg, "Use a printf-style spec such as :.2f, :08d, :x or :10s.", ""
                            banish spec
                            set spec is ""
                    var r as parse_api.InterpParseResult is calling parse_api.ps_parse_interpolation_expr with expr_txt
                    if (not r.ok) or r.diagnostics.error_count > 0:
                        if r.diagnostics.error_count > 0:
                            var d as diag.Diagnostic is (r.diagnostics.items at 0)
                            var msg as string is "invalid interpolation expression: {d.message}"
                            defer banish msg
                            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_INTERP_PARSE, part.start, part.end, msg, "Fix the expression inside the braces.", ""
                        banish r
                        banish spec
                    else:
                        var tmp_bag as diag.DiagnosticBag is calling diag_compat.new_diagnostic_bag
                        var tmp_ann as ann.SemaAnnotations is calling ann.new_annotations with (sigil of r.ast)
                        var old_src as ref to psource.SourceFile is s->src
                        var old_lex as ref to psstate.LexResult is s->lex
                        var old_ast as ref to psast.PsAst is s->ast
                        var old_bag as ref to diag.DiagnosticBag is s->bag
                        var old_ann as ref to ann.SemaAnnotations is s->annotations
                        set s->src is (sigil of r.source)
                        set s->lex is (sigil of r.lex)
                        set s->ast is (sigil of r.ast)
                        set s->bag is (sigil of tmp_bag)
                        set s->annotations is (sigil of tmp_ann)
                        var ignored as int is calling infer with s, r.root, -1
                        set s->src is old_src
                        set s->lex is old_lex
                        set s->ast is old_ast
                        set s->bag is old_bag
                        set s->annotations is old_ann
                        if tmp_bag.error_count > 0:
                            var d2 as diag.Diagnostic is (tmp_bag.items at 0)
                            var msg as string is "invalid interpolation expression: {d2.message}"
                            defer banish msg
                            var icode as string is sdiag.CODE_INTERP_PARSE
                            if d2.code == sdiag.CODE_MUTATES_EXPR:
                                set icode is sdiag.CODE_MUTATES_EXPR
                            calling sdiag.node_error with s->bag, s->src, icode, part.start, part.end, msg, "Fix the expression inside the braces.", ""
                            calling ann.free_annotations with (sigil of tmp_ann)
                            banish tmp_bag
                            banish r
                            banish spec
                        else:
                            banish tmp_bag
                            calling s->module->interps.push with with node is node, part_start is part.start, part_end is part.end, spec is spec, parse is r, annotations is tmp_ann
                set j is j + 1
        set i is i + 1

## `int` o `i64` según el literal.
##
## ## Memoria
## Puede liberar el texto temporal.
weave infer_int with s as ref to state.SemaState, node as int into int:
    var txt as string is calling astutil.child_token_text with s->src, s->lex, s->ast, node, 0
    defer banish txt
    var v as maybe int is calling spark.parse_int with txt
    if v.is_present:
        banish v
        return calling types.base with s->types, "int"
    return calling types.base with s->types, "i64"

## `none` necesita un `maybe` esperado.
##
## ## Memoria
## Puede emitir un error.
weave infer_none with s as ref to state.SemaState, node as int, expected as int into int:
    if expected >= 0:
        var e as tk.SemaType is calling types.at with s->types, expected
        if e.kind == tk.SemaTypeKind.TkMaybe:
            return expected
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "'none' needs an explicit 'maybe T' context", "Annotate the variable or add a 'maybe T' return type.", ""
    return 0

## Resuelve un valor de función genérico (`f of T`).
##
## ## Memoria
## Puede crear tipos y mapas temporales.
weave infer_generic_ref with s as ref to state.SemaState, node as int into int:
    var target as int is calling astutil.node_child with s->ast, node, 0
    var gargs as int is calling astutil.node_child with s->ast, node, 1
    if target < 0 or gargs < 0:
        return 0
    var tt as int is calling infer_var with s, target
    if tt <= 0:
        return 0
    var sid as int is calling ann.symbol_of with s->annotations, target
    if sid < 0:
        return 0
    var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
    if sv.kind != sym.SemaSymbolKind.SkWeave and sv.kind != sym.SemaSymbolKind.SkDeclare:
        var est as int is calling astutil.start_of with s->ast, node
        var een as int is calling astutil.end_of with s->ast, node
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, est, een, "of needs a generic function name", "Write nombre of T where nombre is a weave or declare.", ""
        return 0
    var fty as tk.SemaType is calling types.at with s->types, tt
    if fty.kind != tk.SemaTypeKind.TkFn:
        var est as int is calling astutil.start_of with s->ast, node
        var een as int is calling astutil.end_of with s->ast, node
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, est, een, "of needs a generic function name", "Write nombre of T where nombre is a generic function.", ""
        return 0
    var info as types.SemaFnInfo is (s->types->fn_infos at fty.a)
    if info.tparams_count <= 0:
        var est as int is calling astutil.start_of with s->ast, node
        var een as int is calling astutil.end_of with s->ast, node
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, est, een, "function is not generic", "Remove of T or declare the function with shard T.", ""
        return 0
    var acount as int is calling astutil.child_count with s->ast, gargs
    if acount != info.tparams_count:
        var est as int is calling astutil.start_of with s->ast, node
        var een as int is calling astutil.end_of with s->ast, node
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, est, een, "generic arity mismatch", "Pass exactly one type per shard.", ""
        return 0
    var subst as map of int to int is map of int to int
    defer banish subst
    var ti as int is 0
    while ti < info.tparams_count:
        var tn as int is calling astutil.node_child with s->ast, gargs, ti
        var ctx as convert.TypeCtx is with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast
        var aty as int is calling convert.convert with (sigil of ctx), tn
        if aty <= 0:
            return 0
        var tpid as int is (s->types->tparams at (info.tparams_first + ti)).name
        calling subst.put with tpid, aty
        set ti is ti + 1
    var params_first as int is s->types->fn_params.len
    var pi as int is 0
    while pi < info.params_count:
        var fp as types.SemaFnParam is (s->types->fn_params at (info.params_first + pi))
        var nty as int is calling ginst.subst_deep with s->symbols, fp.type, subst
        var np as types.SemaFnParam is with name is fp.name, type is nty, flags is fp.flags, default_node is fp.default_node, default_module is fp.default_module, default_text is fp.default_text
        var ignored as int is calling types.add_fn_param with s->types, np
        set pi is pi + 1
    var nr as int is calling ginst.subst_deep with s->symbols, info.return_type, subst
    var ni as types.SemaFnInfo is with params_first is params_first, params_count is info.params_count, return_type is nr, tparams_first is info.tparams_first, tparams_count is 0, flags is info.flags, attrs_node is info.attrs_node
    var nt as int is calling types.fn_type with s->types, ni
    calling ann.ann_set_symbol with s->annotations, node, sid
    return nt

## Referencia a un nombre.
##
## ## Memoria
## O(1) promedio; puede emitir E0004.
weave infer_var with s as ref to state.SemaState, node as int into int:
    var txt as string is calling astutil.child_token_text with s->src, s->lex, s->ast, node, 0
    defer banish txt
    return calling infer_name with s, node, txt, node

## Resuelve un nombre y anota el símbolo.
##
## ## Memoria
## O(1) promedio.
weave infer_name with s as ref to state.SemaState, node as int, name as string, at_node as int into int:
    var sid as int is calling symbols.lookup_name with s->symbols, name
    if sid >= 0:
        var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
        if (sv.flags & sym.SYM_MOVED) != 0:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, at_node), (calling astutil.end_of with s->ast, at_node), "value was moved into a thread", "The worker owns it now; do not use it here. Reassign it first if you need a new value.", ""
            return 0
        if (sv.flags & sym.SYM_MOVED_CORO) != 0:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, at_node), (calling astutil.end_of with s->ast, at_node), "value was moved into a coroutine", "The coroutine owns it now; do not use it here. Reassign it first if you need a new value.", ""
            return 0
        if calling moves.check_moved_use with s, sv, at_node, name:
            return 0
        calling ann.ann_set_symbol with s->annotations, node, sid
        return sv.type
    var tyid as int is calling symbols.lookup_type_name with s->symbols, name
    if tyid >= 0:
        return tyid
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, at_node), (calling astutil.end_of with s->ast, at_node), "undefined identifier '{name}'", "Check the spelling or declare it before use.", ""
    return 0

## `donum T` o `donum (T)`.
##
## ## Memoria
## Puede emitir error.
weave infer_donum with s as ref to state.SemaState, node as int, expected as int into int:
    var child as int is calling astutil.node_child with s->ast, node, 0
    if child >= 0:
        var ctx as convert.TypeCtx is with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast
        var dt as int is calling convert.convert with (sigil of ctx), child
        var dty as tk.SemaType is calling types.at with s->types, dt
        var dunum_ok as bool is true
        if dty.kind == tk.SemaTypeKind.TkResult or dty.kind == tk.SemaTypeKind.TkTuple:
            set dunum_ok is false
        if dty.kind == tk.SemaTypeKind.TkRune:
            var rinfo as types.SemaNominalInfo is (s->types->nominal_infos at dty.a)
            var rname as string is calling npool.text with s->names, rinfo.base_name
            if rinfo.tparams_count > 0 and not (calling scope_has_donum with s) and not (calling starts_with_fn with rname):
                set dunum_ok is false
        if not dunum_ok:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CONCEPT_OPERATOR, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "type has no default 'donum' value", "Add a 'Donum' bound or use a ritual constructor.", ""
            return 0
        return dt
    if expected >= 0:
        return expected
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "'donum' needs a type or an expected type", "Write 'donum T' or annotate the variable.", ""
    return 0

## ¿El nombre parece un tipo de función (`Fn1`, `Fn2`, ...)?
##
## ## Memoria
## O(1).
weave starts_with_fn with s as string into bool:
    if s length < 2:
        return false
    var fb as ref to frozen byte is bytes of s
    if ((fb at 0) to int) != 70:
        return false
    return ((fb at 1) to int) == 110

## ¿El scope actual tiene un bound `Donum`?
##
## ## Memoria
## O(profundidad * bounds).
weave scope_has_donum with s as ref to state.SemaState into bool:
    var cur as int is s->symbols->current
    while cur >= 0:
        var sc as scope.SemaScope is (s->symbols->scopes at cur)
        var i as int is 0
        while i < sc.bounds_count:
            var cid as int is (s->types->bounds at (sc.bounds_first + i))
            var cty as tk.SemaType is calling types.at with s->types, cid
            var cnid as int is cty.name
            var ctext as string is calling npool.text with s->names, cnid
            if ctext == "Donum":
                return true
            set i is i + 1
        set cur is sc.parent
    return false

## Nombre lógico (`a.b.c`) de un módulo, derivado de su ruta.
##
## Permite reconocer `calling modulo.hijo.fn` cuando `modulo` es el propio
## módulo actual (bug 8), sin depender de un símbolo de import del consumidor.
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave module_dotted_name with s as ref to state.SemaState, mid as int into string:
    var m as loader.SemaModule is (s->program->modules at mid)
    var p as string is m.path
    var end as int is p length
    if calling scrolls.ends_with with p, ".d.pengu":
        set end is end - 8
    else if calling scrolls.ends_with with p, ".pengu":
        set end is end - 6
    var stem as string is calling scrolls.substring with p, 0, end
    if calling scrolls.ends_with with stem, "/__init__":
        var shorter as string is calling scrolls.substring with stem, 0, (stem length - 9)
        banish stem
        set stem is shorter
    defer banish stem
    var start as int is 0
    var pre as string is "{s->opts->base_dir}/{s->opts->src_dir}/"
    defer banish pre
    if calling scrolls.starts_with with stem, pre:
        set start is pre length
    else:
        var i as int is 0
        var n as int is stem length
        while i + 5 <= n:
            if (stem at i) == "/" and (stem at (i + 1)) == "s" and (stem at (i + 2)) == "r" and (stem at (i + 3)) == "c" and (stem at (i + 4)) == "/":
                set start is i + 5
            set i is i + 1
        if start == 0 and calling scrolls.starts_with with stem, "src/":
            set start is 4
    var rel as string is calling scrolls.substring with stem, start, (stem length)
    defer banish rel
    return calling scrolls.replace_all with rel, "/", "."

## Busca un módulo por su nombre lógico.
##
## ## Memoria
## Devuelve un índice; no asigna.
weave module_by_dotted with s as ref to state.SemaState, dotted as string into int:
    var i as int is 0
    while i < s->program->modules.len:
        var dn as string is calling module_dotted_name with s, i
        if dn == dotted:
            banish dn
            return i
        banish dn
        set i is i + 1
    return -1

## ¿El tipo posee campos que se mueven con el valor?
weave type_is_owning with s as ref to state.SemaState, id as int into bool:
    var t as tk.SemaType is calling types.at with s->types, id
    if calling compat.is_string with s->types, id:
        return true
    if t.kind == tk.SemaTypeKind.TkList or t.kind == tk.SemaTypeKind.TkMap or t.kind == tk.SemaTypeKind.TkMaybe or t.kind == tk.SemaTypeKind.TkResult or t.kind == tk.SemaTypeKind.TkArray:
        return true
    if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho or t.kind == tk.SemaTypeKind.TkOmen:
        return true
    return false

## Comprueba que un `ref to T` apunte a un tipo `@shared`.
weave check_spawn_ref with s as ref to state.SemaState, node as int, ty as int into void:
    var t as tk.SemaType is calling types.at with s->types, ty
    var inner as int is t.a
    var it as tk.SemaType is calling types.at with s->types, inner
    if it.kind == tk.SemaTypeKind.TkRune or it.kind == tk.SemaTypeKind.TkEcho or it.kind == tk.SemaTypeKind.TkOmen:
        var ni as types.SemaNominalInfo is (s->types->nominal_infos at it.a)
        if (ni.flags & types.NIF_SHARED) != 0:
            return
        var nm as string is calling npool.text with s->names, ni.base_name
        defer banish nm
        var msg as string is "'{nm}' is not @shared"
        defer banish msg
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), msg, "Mark the rune with @shared, or pass an owned value and let the worker own it.", ""
        return
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "threads only accept refs to @shared runes", "Pass a value, or mark the referenced rune with @shared.", ""

## ¿El tipo contiene algún `ref to T` cuyo destino no sea `@shared`?
##
## Los `ref` anidados dentro de runas/colecciones no los ve `check_spawn_ref`;
## sin este chequeo un rune con un campo `ref to T` cruza un hilo y produce una
## carrera de datos. Un `slice`/`opaque`/`many` también se considera préstamo.
weave type_has_unshared_ref with s as ref to state.SemaState, id as int, depth as int into bool:
    if depth > 8:
        return true
    var t as tk.SemaType is calling types.at with s->types, id
    if t.kind == tk.SemaTypeKind.TkRef:
        var it as tk.SemaType is calling types.at with s->types, t.a
        if it.kind == tk.SemaTypeKind.TkRune or it.kind == tk.SemaTypeKind.TkEcho or it.kind == tk.SemaTypeKind.TkOmen:
            var ni as types.SemaNominalInfo is (s->types->nominal_infos at it.a)
            if (ni.flags & types.NIF_SHARED) != 0:
                return false
            return true
        return true
    if t.kind == tk.SemaTypeKind.TkSlice or t.kind == tk.SemaTypeKind.TkOpaque or t.kind == tk.SemaTypeKind.TkMany:
        return true
    if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho:
        # Los handles de `std.consortium` ocultan su puntero interno: la
        # seguridad del cruce la decide `check_spawn_arg` (`E0082`/`E0083`).
        if (calling moves.consortium_kind with s, (calling types.intern_type with s->types, t)) != 0:
            return false
        var ni as types.SemaNominalInfo is (s->types->nominal_infos at t.a)
        var i as int is 0
        while i < ni.fields_count:
            var f as types.SemaField is (s->types->fields at (ni.fields_first + i))
            if calling type_has_unshared_ref with s, f.type, depth + 1:
                return true
            set i is i + 1
        return false
    if t.kind == tk.SemaTypeKind.TkOmen:
        var ni as types.SemaNominalInfo is (s->types->nominal_infos at t.a)
        var vi as int is 0
        while vi < ni.variants_count:
            var v as types.SemaVariant is (s->types->variants at (ni.variants_first + vi))
            var pi as int is 0
            while pi < v.payload_count:
                var f as types.SemaField is (s->types->fields at (v.payload_first + pi))
                if calling type_has_unshared_ref with s, f.type, depth + 1:
                    return true
                set pi is pi + 1
            set vi is vi + 1
        return false
    if t.kind == tk.SemaTypeKind.TkArray or t.kind == tk.SemaTypeKind.TkList or t.kind == tk.SemaTypeKind.TkMaybe or t.kind == tk.SemaTypeKind.TkFrozen:
        return calling type_has_unshared_ref with s, t.a, depth + 1
    if t.kind == tk.SemaTypeKind.TkMap or t.kind == tk.SemaTypeKind.TkResult:
        if calling type_has_unshared_ref with s, t.a, depth + 1:
            return true
        return calling type_has_unshared_ref with s, t.b, depth + 1
    if t.kind == tk.SemaTypeKind.TkTuple:
        var i as int is 0
        while i < t.count:
            var child as int is (s->types->type_children at (t.first + i))
            if calling type_has_unshared_ref with s, child, depth + 1:
                return true
            set i is i + 1
        return false
    if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
        return calling type_has_unshared_ref with s, t.b, depth + 1
    return false

## Valida la propiedad de un argumento transferido (hilo o corrutina).
##
## Un valor con dueño debe venir de un binding local (`var`/`let`), no de un
## parámetro prestado ni de una expresión compuesta. Los literales de string
## son frescos (`is_owned = 0`) y se pueden pasar directamente.
weave check_arg_ownership with s as ref to state.SemaState, anode as int, aty as int, move_flag as int into void:
    if not (calling type_is_owning with s, aty):
        return
    var ak as pskind.NodeKind is calling astutil.kind_of with s->ast, anode
    if ak == pskind.NodeKind.NdStringLit:
        return
    if ak != pskind.NodeKind.NdVarRef:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, anode), (calling astutil.end_of with s->ast, anode), "owning values must be passed by local name", "Bind the value to a local first: var v is ...; then pass v.", ""
        return
    var atok as int is calling astutil.token_child with s->ast, anode, 0
    if atok < 0:
        return
    var aname as string is calling astutil.token_text with s->src, s->lex, atok
    defer banish aname
    var asid as int is calling symbols.lookup_name with s->symbols, aname
    if asid < 0:
        return
    var asym as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, asid
    if asym.kind != sym.SemaSymbolKind.SkVar and asym.kind != sym.SemaSymbolKind.SkLet:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, anode), (calling astutil.end_of with s->ast, anode), "owning values must be local bindings", "Move it from the scope that owns it, or pass a ref to a value that outlives the task.", ""
        return
    set asym.flags is asym.flags | move_flag
    calling symbols.symbol_set with s->symbols, asid, asym

## Valida los argumentos de `filum.start`.
## Valida un argumento transferido a un hilo.
weave check_spawn_arg with s as ref to state.SemaState, anode as int, aty as int into void:
    var at as tk.SemaType is calling types.at with s->types, aty
    if at.kind == tk.SemaTypeKind.TkRef:
        calling check_spawn_ref with s, anode, aty
        return
    var ck as int is calling moves.consortium_kind with s, aty
    if ck == 1 or ck == 2:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_RC_CROSS_THREAD, (calling astutil.start_of with s->ast, anode), (calling astutil.end_of with s->ast, anode), "an 'Rc' cannot cross a thread boundary", "Use 'Arc of T' for shared ownership across threads, or keep the 'Rc' in one thread.", ""
        return
    if ck == 3 or ck == 4:
        if not calling moves.arc_payload_shared with s, aty:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_ARC_NOT_SHARED, (calling astutil.start_of with s->ast, anode), (calling astutil.end_of with s->ast, anode), "an 'Arc of T' crossing a thread boundary requires 'T' to be @shared", "Mark the payload rune with @shared, or send an owned value instead.", ""
            return
    if at.kind == tk.SemaTypeKind.TkSlice or at.kind == tk.SemaTypeKind.TkOpaque or at.kind == tk.SemaTypeKind.TkFn or at.kind == tk.SemaTypeKind.TkMany:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, anode), (calling astutil.end_of with s->ast, anode), "value cannot cross a thread boundary", "Pass an owning value by local name, or a ref to an @shared rune.", ""
        return
    if calling type_is_owning with s, aty:
        if calling type_has_unshared_ref with s, aty, 0:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, anode), (calling astutil.end_of with s->ast, anode), "value contains a ref to a type that is not @shared", "Mark the referenced rune with @shared, or pass an owned value without refs.", ""
            return
    # `filum.start` construye un `SpawnBox of A` en su cuerpo genérico. Si A es
    # a su vez una instancia genérica (`Arc of T`), la instanciación debe
    # ocurrir en F3: el catálogo de tipos se cierra antes del codegen.
    var boxid as int is calling symbols.lookup_type_name with s->symbols, "SpawnBox"
    if boxid > 0:
        var boxargs as list of int is list of int
        defer banish boxargs
        calling boxargs.push with aty
        var ignored_box as int is calling ginst.instantiate_nominal with s->symbols, boxid, boxargs
    calling check_arg_ownership with s, anode, aty, sym.SYM_MOVED

weave infer_spawn with s as ref to state.SemaState, node as int, args as int, arg_types as list of int into void:
    if args < 0:
        return
    var nargs as int is calling astutil.child_count with s->ast, args
    if nargs < 1:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "start needs a worker", "Write calling filum.start with worker, value.", ""
        return
    var wraw as int is calling astutil.node_child with s->ast, args, 0
    var wnode as int is wraw
    if wraw >= 0:
        var wk as pskind.NodeKind is calling astutil.kind_of with s->ast, wraw
        if wk == pskind.NodeKind.NdPosArg or wk == pskind.NodeKind.NdNamedArg:
            set wnode is calling astutil.node_child with s->ast, wraw, 0
    if wnode < 0 or (calling astutil.kind_of with s->ast, wnode) != pskind.NodeKind.NdVarRef:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "worker must be a named weave", "Declare the worker with 'weave name ...' and pass its name.", ""
        return
    var wtok as int is calling astutil.token_child with s->ast, wnode, 0
    if wtok < 0:
        return
    var wname as string is calling astutil.token_text with s->src, s->lex, wtok
    defer banish wname
    var wsid as int is calling symbols.lookup_name with s->symbols, wname
    if wsid < 0:
        return
    var wsym as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, wsid
    if wsym.kind != sym.SemaSymbolKind.SkWeave and wsym.kind != sym.SemaSymbolKind.SkDeclare:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker must be a weave or declare", "Declare the worker with 'weave name ...'.", ""
        return
    if (calling s->symbols->method_receiver.has with wsid):
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker cannot be a method", "Use a free weave as the worker.", ""
        return
    var wft as tk.SemaType is calling types.at with s->types, (calling resolve_callable with s->types, wsym.type)
    if wft.kind != tk.SemaTypeKind.TkFn:
        return
    var winfo as types.SemaFnInfo is (s->types->fn_infos at wft.a)
    if (winfo.flags & types.FN_GENERIC) != 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker cannot be generic in this version", "Use a concrete worker; generic workers are not supported yet.", ""
        return
    if winfo.return_type != calling types.base with s->types, "void":
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker must return void", "Threads return no value; store results in shared state or a channel.", ""
        return
    if winfo.params_count != nargs - 1:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker arity does not match the arguments", "The worker must take exactly the values passed to start.", ""
        return
    var ai as int is 1
    while ai < nargs:
        if ai < arg_types.len:
            var araw as int is calling astutil.node_child with s->ast, args, ai
            var anode as int is araw
            if araw >= 0:
                var ak as pskind.NodeKind is calling astutil.kind_of with s->ast, araw
                if ak == pskind.NodeKind.NdPosArg or ak == pskind.NodeKind.NdNamedArg:
                    set anode is calling astutil.node_child with s->ast, araw, 0
            if anode >= 0:
                calling check_spawn_arg with s, anode, (arg_types at ai)
        set ai is ai + 1

## Valida los argumentos de `std.coro.start`.
##
## Una corrutina vive en el mismo hilo que su creador, así que `ref to T`,
## slices, opaque y punteros a función son legales. Los valores con dueño se
## mueven igual que en un hilo, pero con un flag distinto para que el
## diagnóstico diga "coroutine".
weave check_coro_arg with s as ref to state.SemaState, anode as int, aty as int into void:
    var at as tk.SemaType is calling types.at with s->types, aty
    var cck as int is calling moves.consortium_kind with s, aty
    if cck == 1 or cck == 2:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_RC_CROSS_THREAD, (calling astutil.start_of with s->ast, anode), (calling astutil.end_of with s->ast, anode), "an 'Rc' cannot cross a coroutine boundary", "Use 'Arc of T' if the value must be shared, or keep the 'Rc' in one task.", ""
        return
    if at.kind == tk.SemaTypeKind.TkMany:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, anode), (calling astutil.end_of with s->ast, anode), "value cannot cross a coroutine boundary", "Pass one value: use a tuple or a rune to carry several.", ""
        return
    calling check_arg_ownership with s, anode, aty, sym.SYM_MOVED_CORO

## Comprueba `std.coro.start` / `start0`.
##
## Replica las reglas de worker de `infer_spawn`, pero no exige `@shared`:
## la corrutina nunca cambia de hilo.
weave infer_coro with s as ref to state.SemaState, node as int, args as int, arg_types as list of int into void:
    if args < 0:
        return
    var nargs as int is calling astutil.child_count with s->ast, args
    if nargs < 1:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "coro.start needs a worker", "Write calling coro.start with worker, value.", ""
        return
    var wraw as int is calling astutil.node_child with s->ast, args, 0
    var wnode as int is wraw
    if wraw >= 0:
        var wk as pskind.NodeKind is calling astutil.kind_of with s->ast, wraw
        if wk == pskind.NodeKind.NdPosArg or wk == pskind.NodeKind.NdNamedArg:
            set wnode is calling astutil.node_child with s->ast, wraw, 0
    if wnode < 0 or (calling astutil.kind_of with s->ast, wnode) != pskind.NodeKind.NdVarRef:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "worker must be a named weave", "Declare the worker with 'weave name ...' and pass its name.", ""
        return
    var wtok as int is calling astutil.token_child with s->ast, wnode, 0
    if wtok < 0:
        return
    var wname as string is calling astutil.token_text with s->src, s->lex, wtok
    defer banish wname
    var wsid as int is calling symbols.lookup_name with s->symbols, wname
    if wsid < 0:
        return
    var wsym as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, wsid
    if wsym.kind != sym.SemaSymbolKind.SkWeave and wsym.kind != sym.SemaSymbolKind.SkDeclare:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker must be a weave or declare", "Declare the worker with 'weave name ...'.", ""
        return
    if (calling s->symbols->method_receiver.has with wsid):
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker cannot be a method", "Use a free weave as the worker.", ""
        return
    var wft as tk.SemaType is calling types.at with s->types, (calling resolve_callable with s->types, wsym.type)
    if wft.kind != tk.SemaTypeKind.TkFn:
        return
    var winfo as types.SemaFnInfo is (s->types->fn_infos at wft.a)
    if (winfo.flags & types.FN_GENERIC) != 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker cannot be generic in this version", "Use a concrete worker; generic workers are not supported yet.", ""
        return
    if winfo.return_type != calling types.base with s->types, "void":
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker must return void", "Coroutines return no value; store results in shared state or a channel.", ""
        return
    if winfo.params_count != nargs - 1:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, wnode), (calling astutil.end_of with s->ast, wnode), "worker arity does not match the arguments", "The worker must take exactly the values passed to start.", ""
        return
    var ai as int is 1
    while ai < nargs:
        if ai < arg_types.len:
            var araw as int is calling astutil.node_child with s->ast, args, ai
            var anode as int is araw
            if araw >= 0:
                var ak as pskind.NodeKind is calling astutil.kind_of with s->ast, araw
                if ak == pskind.NodeKind.NdPosArg or ak == pskind.NodeKind.NdNamedArg:
                    set anode is calling astutil.node_child with s->ast, araw, 0
            if anode >= 0:
                calling check_coro_arg with s, anode, (arg_types at ai)
        set ai is ai + 1

## Llamada.
##
## ## Memoria
## Infiere target/args; no posee listas.
weave infer_call with s as ref to state.SemaState, node as int, expected as int into int:
    var target as int is calling astutil.node_child with s->ast, node, 0
    var args as int is calling astutil.node_child with s->ast, node, 2
    var sid as int is -1
    var recv_bounds as int is -1
    var inst_recv as int is -1
    var arg_types as list of int is list of int
    defer banish arg_types
    var chain_last as int is -1
    var tname as string is ""
    defer banish tname
    var method_text as string is ""
    defer banish method_text
    if target < 0:
        return 0
    var tk2 as pskind.NodeKind is calling astutil.kind_of with s->ast, target
    if tk2 == pskind.NodeKind.NdWithTarget:
        return calling infer_with_call with s, node, target, expected
    if tk2 != pskind.NodeKind.NdNormalTarget:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "invalid call target", "Use 'calling name', 'calling receiver.method' or 'calling .method'.", ""
        return 0
    var nm as int is calling astutil.token_child with s->ast, target, 0
    if nm < 0:
        return 0
    set tname is calling astutil.token_text with s->src, s->lex, nm
    var base_sid as int is calling symbols.lookup_name with s->symbols, tname
    var base_type as int is -1
    if base_sid >= 0:
        var bsv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, base_sid
        set base_type is bsv.type
    else:
        set base_type is calling symbols.lookup_type_name with s->symbols, tname
    var n as int is calling astutil.child_count with s->ast, target
    if n <= 1:
        # Función/module directo: `calling f`.
        if base_sid < 0 and (tname == "ok_of" or tname == "err_of"):
            return calling infer_result_ctor with s, node, tname, expected
        if base_sid < 0 and s->symbols->has_includes:
            calling infer_args_only with s, args
            return 1
        if base_sid < 0:
            calling undefined_call with s, node, tname
            return 0
        set sid is base_sid
    else:
        # Cadena de accesos. El último es el nombre del método/llamada; los
        # anteriores se aplican al receptor.
        var last as int is calling astutil.node_child with s->ast, target, n - 1
        if last < 0:
            return 0
        var lk as pskind.NodeKind is calling astutil.kind_of with s->ast, last
        if lk != pskind.NodeKind.NdDotAccess and lk != pskind.NodeKind.NdArrowAccess:
            return 0
        var mtok as int is calling astutil.token_child with s->ast, last, 0
        if mtok < 0:
            return 0
        var mname as string is calling astutil.token_text with s->src, s->lex, mtok
        defer banish mname
        set method_text is calling npool.copy_string with mname
        var rcp as int is base_type
        var base_import as int is -1
        if base_sid >= 0:
            var base_sym as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, base_sid
            set rcp is base_sym.type
            if base_sym.kind == sym.SemaSymbolKind.SkImport:
                set base_import is base_sym.module_scope
        else:
            # `calling modulo.hijo.fn` desde el propio `modulo`: el nombre
            # base es el módulo actual, no un import del consumidor (bug 8).
            var self_mid as int is calling module_by_dotted with s, tname
            if self_mid >= 0:
                var self_mod as loader.SemaModule is (s->program->modules at self_mid)
                set base_import is self_mod.scope
        var ai as int is 1
        while ai < n - 1:
            var op as int is calling astutil.node_child with s->ast, target, ai
            if op >= 0:
                if base_import >= 0 and rcp <= 0:
                    # `mod.Type.method`: el primer acceso es un tipo del módulo.
                    var ot as int is calling astutil.token_child with s->ast, op, 0
                    if ot >= 0:
                        var otxt as string is calling astutil.token_text with s->src, s->lex, ot
                        defer banish otxt
                        var oid as int is calling npool.intern with s->names, otxt
                        var mobj as int is calling symbols.lookup_in_scope with s->symbols, base_import, oid
                        if mobj >= 0:
                            var msym as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, mobj
                            if msym.kind == sym.SemaSymbolKind.SkImport:
                                # `mod.submod.fn`: el módulo intermedio redefine
                                # el ámbito de resolución (bug 14).
                                set base_import is msym.module_scope
                                set rcp is -1
                            else if msym.kind == sym.SemaSymbolKind.SkType or msym.kind == sym.SemaSymbolKind.SkRune or msym.kind == sym.SemaSymbolKind.SkEcho or msym.kind == sym.SemaSymbolKind.SkOmen or msym.kind == sym.SemaSymbolKind.SkAlias or msym.kind == sym.SemaSymbolKind.SkSeal:
                                set rcp is msym.type
                    set ai is ai + 1
                    continue
                var next as int is calling access_op_type with s, rcp, op
                if next <= 0:
                    var opt as int is calling astutil.token_child with s->ast, op, 0
                    if opt >= 0:
                        var optxt as string is calling astutil.token_text with s->src, s->lex, opt
                        defer banish optxt
                        var rt_base as int is calling underlying_type with s, rcp
                        var rtb as tk.SemaType is calling types.at with s->types, rt_base
                        if rtb.kind == tk.SemaTypeKind.TkRef:
                            set rt_base is rtb.a
                        var oid2 as int is calling npool.intern with s->names, optxt
                        var osid as int is calling symbols.lookup_method with s->symbols, rt_base, oid2
                        if osid >= 0:
                            var osym as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, osid
                            var ofty as tk.SemaType is calling types.at with s->types, osym.type
                            if ofty.kind == tk.SemaTypeKind.TkFn:
                                var oinfo as types.SemaFnInfo is (s->types->fn_infos at ofty.a)
                                set next is oinfo.return_type
                            calling ann.ann_set_symbol with s->annotations, op, osid
                            if next > 0:
                                calling ann.set_type with s->annotations, op, next
                            if ai < n - 1:
                                if (osym.flags & sym.SYM_MUTATING) != 0:
                                    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CHAIN, (calling astutil.start_of with s->ast, op), (calling astutil.end_of with s->ast, op), "mutating method used in the middle of a chain", "Only the last step may mutate; move it to the end or split the chain.", ""
                                    return 0
                                if next == calling types.base with s->types, "void":
                                    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CHAIN, (calling astutil.start_of with s->ast, op), (calling astutil.end_of with s->ast, op), "chain step returns void", "Only the last step may return void; intermediate steps must produce a value.", ""
                                    return 0
                        if next <= 0:
                            set next is calling builtin_method with s, rcp, optxt, -1
                set rcp is next
            set ai is ai + 1
        if base_import >= 0:
            var mid0 as int is calling npool.intern with s->names, mname
            set sid is calling symbols.lookup_in_scope with s->symbols, base_import, mid0
            if base_import >= 0:
                # El scope del módulo no contiene todos los `weave` de un
                # `.pengu`; resolver por módulo antes del fallback global
                # (evita que `rayguix.label` caiga en `std.diagnostic.label`).
                var mmi as int is 0
                while mmi < s->program->modules.len and sid < 0:
                    var mm as loader.SemaModule is (s->program->modules at mmi)
                    if mm.scope == base_import:
                        var msi as int is 0
                        while msi < s->symbols->symbols.len and sid < 0:
                            var msv as sym.SemaSymbol is (s->symbols->symbols at msi)
                            if msv.module == mmi and msv.name == mid0 and (msv.kind == sym.SemaSymbolKind.SkWeave or msv.kind == sym.SemaSymbolKind.SkDeclare or msv.kind == sym.SemaSymbolKind.SkConst):
                                set sid is msi
                            set msi is msi + 1
                    set mmi is mmi + 1
        if rcp >= 0 and sid < 0:
            var rty_pre as tk.SemaType is calling types.at with s->types, rcp
            if rty_pre.kind == tk.SemaTypeKind.TkMaybe or rty_pre.kind == tk.SemaTypeKind.TkResult:
                var bm0 as int is calling builtin_method with s, rcp, mname, expected
                if bm0 > 0:
                    calling infer_args_only with s, args
                    return bm0
            # `calling receptor.campo with ...` donde el campo guarda un
            # puntero a función: la llamada es al valor del campo, no a un
            # método. Se prueba antes de buscar métodos.
            var fldret as int is calling call_fn_field with s, rcp, mname, args
            if fldret != -1:
                return fldret
            set recv_bounds is rcp
            set inst_recv is rcp
            var recv_lookup as int is calling underlying_type with s, rcp
            var rty as tk.SemaType is calling types.at with s->types, recv_lookup
            if rty.kind == tk.SemaTypeKind.TkRef:
                # Un `ref to X` donde X es un alias debe resolver los métodos
                # del tipo aliaseado: `underlying_type` no atraviesa punteros.
                set recv_lookup is calling underlying_type with s, rty.a
            var mid as int is calling npool.intern with s->names, mname
            set chain_last is rcp
            set sid is calling symbols.lookup_method with s->symbols, recv_lookup, mid
            if sid < 0:
                var rbase as tk.SemaType is calling types.at with s->types, recv_lookup
                if rbase.kind == tk.SemaTypeKind.TkBase:
                    var rname as string is calling npool.text with s->names, rbase.name
                    var alt as string is ""
                    if rname == "f32":
                        set alt is "float"
                    else if rname == "i32":
                        set alt is "int"
                    if alt != "":
                        var altid as int is calling types.base with s->types, alt
                        set sid is calling symbols.lookup_method with s->symbols, altid, mid
            if sid < 0:
                var bm as int is calling builtin_method with s, rcp, mname, expected
                if bm > 0:
                    calling infer_args_only with s, args
                    return bm
        if sid < 0:
            var ambty as int is calling underlying_type with s, rcp
            var ambty_t as tk.SemaType is calling types.at with s->types, ambty
            if ambty_t.kind == tk.SemaTypeKind.TkRef:
                set ambty is ambty_t.a
            var ambmid as int is calling npool.intern with s->names, mname
            if calling report_ambiguous_method with s, node, ambty, ambmid, mname:
                return 0
            if calling report_ritual_not_promoted with s, node, ambty, ambmid, mname:
                return 0
            # Una llamada `receptor.metodo` sólo puede resolver métodos (o
            # builtins de contenedor); no cae al registro global de funciones.
            if n > 1 and base_import < 0 and base_sid >= 0:
                var gfid as int is calling npool.find with s->names, method_text
                if gfid >= 0:
                    var gfi2 as int is 0
                    while gfi2 < s->symbols->symbols.len:
                        var gfs2 as sym.SemaSymbol is (s->symbols->symbols at gfi2)
                        if gfs2.name == gfid and (gfs2.kind == sym.SemaSymbolKind.SkWeave or gfs2.kind == sym.SemaSymbolKind.SkDeclare) and not (calling s->symbols->method_receiver.has with gfi2):
                            var gmsg as string is "'{method_text}' is a module function, not a method"
                            defer banish gmsg
                            var ghelp as string is "Call it from the module that declares it, or pass the receiver as the first argument."
                            defer banish ghelp
                            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), gmsg, ghelp, ""
                            return 0
                        set gfi2 is gfi2 + 1
                var mnid as int is calling npool.find with s->names, method_text
                if mnid >= 0:
                    var mi as int is 0
                    while mi < s->symbols->symbols.len:
                        if calling s->symbols->method_receiver.has with mi:
                            var ms as sym.SemaSymbol is (s->symbols->symbols at mi)
                            if ms.name == mnid:
                                var mr as int is calling s->symbols->method_receiver.get with mi
                                if not (calling compat.has_type_param with s->types, mr):
                                    var mrt as tk.SemaType is calling types.at with s->types, (calling underlying_type with s, mr)
                                    var crt as tk.SemaType is calling types.at with s->types, (calling underlying_type with s, rcp)
                                    if crt.kind == tk.SemaTypeKind.TkRef:
                                        set crt is calling types.at with s->types, crt.a
                                    if crt.kind == tk.SemaTypeKind.TkList and mrt.kind == tk.SemaTypeKind.TkList and not (calling compat.compatible with s->types, crt.a, mrt.a):
                                        var msg as string is "method '{method_text}' is not defined for this receiver type"
                                        defer banish msg
                                        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), msg, "This method belongs to a list with a different element type.", ""
                                        return 0
                        set mi is mi + 1
                calling undefined_call with s, node, method_text
                return 0
            if sid < 0:
                var ufid as int is calling npool.find with s->names, mname
                if ufid >= 0:
                    var ufi as int is 0
                    var ucount as int is 0
                    var ulast as int is -1
                    while ufi < s->symbols->symbols.len:
                        var ufs as sym.SemaSymbol is (s->symbols->symbols at ufi)
                        if ufs.name == ufid and (ufs.kind == sym.SemaSymbolKind.SkWeave or ufs.kind == sym.SemaSymbolKind.SkDeclare):
                            set ulast is ufi
                            set ucount is ucount + 1
                        set ufi is ufi + 1
                    if ucount == 1:
                        set sid is ulast
            # Fallback global para módulos cualificados (`mod.fn`).
            if sid < 0:
                set sid is calling symbols.lookup_name with s->symbols, mname
            if sid < 0:
                var mfid as int is calling npool.find with s->names, mname
                if mfid >= 0:
                    var gfi as int is 0
                    var gcount as int is 0
                    while gfi < s->symbols->symbols.len:
                        var gfs as sym.SemaSymbol is (s->symbols->symbols at gfi)
                        if gfs.name == mfid and (gfs.kind == sym.SemaSymbolKind.SkWeave or gfs.kind == sym.SemaSymbolKind.SkDeclare):
                            set sid is gfi
                            set gcount is gcount + 1
                        set gfi is gfi + 1
                    if gcount > 1:
                        set sid is -1
        if sid < 0:
            calling undefined_call with s, node, tname
            return 0
    var fsv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
    if (fsv.flags & sym.SYM_MUTATING) != 0 and not s->allow_mutating:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MUTATES_EXPR, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "mutating method used as an expression", "Call it as a statement, or use the pure get_* form.", ""
        return 0
    if recv_bounds >= 0 and fsv.bounds_count > 0:
        var bi as int is 0
        var ok_bounds as bool is true
        while bi < fsv.bounds_count:
            if not (calling compat.concept_satisfied with s->types, recv_bounds, (s->types->bounds at (fsv.bounds_first + bi))):
                set ok_bounds is false
            set bi is bi + 1
        if not ok_bounds:
            var is_get as bool is false
            if method_text length >= 4:
                var gb as ref to frozen byte is bytes of method_text
                if ((gb at 0) to int) == 103 and ((gb at 1) to int) == 101 and ((gb at 2) to int) == 116 and ((gb at 3) to int) == 95:
                    set is_get is true
            if (fsv.flags & sym.SYM_MUTATING) != 0 or is_get:
                calling undefined_call with s, node, method_text
            else:
                calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "method receiver does not satisfy its concept bound", "Use a receiver that implements the concept.", ""
            return 0
    calling ann.ann_set_symbol with s->annotations, node, sid
    var ft as tk.SemaType is calling types.at with s->types, (calling resolve_callable with s->types, fsv.type)
    if ft.kind != tk.SemaTypeKind.TkFn:
        return fsv.type
    # Infiere argumentos y comprueba contra los parámetros.
    var info as types.SemaFnInfo is (s->types->fn_infos at ft.a)
    # Sustitución T -> tipo real: se siembra con el receptor (métodos) y se
    # amplía con cada argumento ya inferido, para que los argumentos
    # posteriores vean el tipo concreto y no `void*`.
    var subst as map of int to int is map of int to int
    defer banish subst
    var gargs as int is calling astutil.node_child with s->ast, node, 1
    if gargs >= 0 and (calling astutil.kind_of with s->ast, gargs) == pskind.NodeKind.NdGenericArgs and info.tparams_count > 0:
        var gctx as convert.TypeCtx is with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast
        var gi as int is 0
        var gn as int is calling astutil.child_count with s->ast, gargs
        while gi < gn and gi < info.tparams_count:
            var gt as int is calling astutil.node_child with s->ast, gargs, gi
            if gt >= 0:
                var gid as int is calling convert.convert with (sigil of gctx), gt
                if gid > 0:
                    var tp as types.SemaTypeParamInfo is (s->types->tparams at (info.tparams_first + gi))
                    calling subst.put with tp.name, gid
            set gi is gi + 1
    var rtemplate as int is -1
    if calling s->symbols->method_receiver.has with sid:
        set rtemplate is calling s->symbols->method_receiver.get with sid
        if rtemplate > 0 and inst_recv > 0:
            calling ginst.unify_param with s->symbols, rtemplate, inst_recv, (sigil of subst)
    var i as int is 0
    var nargs as int is 0
    var first_arg_type as int is -1
    if args >= 0:
        set nargs is calling astutil.child_count with s->ast, args
    # Ranuras de la llamada: los posicionales ocupan 0, 1, ... y los nombrados
    # reclaman su parámetro por nombre. Validar aquí deja que el codegen emita
    # en orden de declaración y rellene los defaults en su ranura.
    var fixed as int is info.params_count
    var has_va as bool is false
    var has_many as bool is false
    var many_elem as int is 0
    if info.params_count > 0:
        var plast as types.SemaFnParam is (s->types->fn_params at (info.params_first + info.params_count - 1))
        if plast.type == types.TYPE_ID_CVARARGS:
            set has_va is true
            set fixed is info.params_count - 1
        else if plast.type > 0:
            var plty as tk.SemaType is calling types.at with s->types, plast.type
            if plty.kind == tk.SemaTypeKind.TkMany:
                set has_many is true
                set many_elem is plty.a
                set fixed is info.params_count - 1
    var named as list of int is list of int
    defer banish named
    var pos_next as int is 0
    var seen_named as bool is false
    var arity_reported as bool is false
    var ai as int is 0
    while ai < nargs:
        var arg as int is calling astutil.node_child with s->ast, args, ai
        if arg >= 0:
            if (calling astutil.kind_of with s->ast, arg) == pskind.NodeKind.NdNamedArg:
                set seen_named is true
                var ntxt as string is calling astutil.child_token_text with s->src, s->lex, s->ast, arg, 0
                defer banish ntxt
                var pindex as int is calling param_index with s, info, ntxt
                var dup as bool is false
                var nj as int is 0
                while nj < named.len:
                    if (named at nj) == pindex:
                        set dup is true
                    set nj is nj + 1
                if pindex < 0 or pindex >= fixed:
                    var umsg as string is "'{ntxt}' is not a parameter of this function"
                    defer banish umsg
                    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_NAMED_ARG, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), umsg, "Check the parameter name; a named argument must match a parameter.", ""
                else:
                    if dup or pindex < pos_next:
                        var dmsg as string is "argument for parameter '{ntxt}' is given twice"
                        defer banish dmsg
                        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_NAMED_ARG, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), dmsg, "Pass each parameter once, either positionally or by name.", ""
                    else:
                        calling named.push with pindex
            else:
                if seen_named:
                    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_NAMED_ARG, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "positional argument after a named argument", "Put positional arguments first, or name every argument.", ""
                else:
                    if pos_next < fixed:
                        set pos_next is pos_next + 1
                    else:
                        if not has_va and not has_many and not arity_reported:
                            set arity_reported is true
                            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "too many arguments in call", "Remove the extra arguments or add parameters for them.", ""
        set ai is ai + 1
    var missing as bool is false
    var mj as int is 0
    while mj < fixed:
        var covered as bool is mj < pos_next
        var nj2 as int is 0
        while nj2 < named.len:
            if (named at nj2) == mj:
                set covered is true
            set nj2 is nj2 + 1
        if not covered:
            var mp as types.SemaFnParam is (s->types->fn_params at (info.params_first + mj))
            if mp.default_node < 0:
                set missing is true
        set mj is mj + 1
    if missing:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "too few arguments in call", "Add the missing arguments or declare defaults for them.", ""
    # Tipado: en orden de fuente (los genéricos infieren con cada argumento).
    set pos_next is 0
    while i < nargs:
        var arg as int is calling astutil.node_child with s->ast, args, i
        if arg >= 0:
            var ak as pskind.NodeKind is calling astutil.kind_of with s->ast, arg
            var vnode as int is -1
            var pindex as int is -1
            if ak == pskind.NodeKind.NdNamedArg:
                set vnode is calling astutil.node_child with s->ast, arg, 1
                var ntxt2 as string is calling astutil.child_token_text with s->src, s->lex, s->ast, arg, 0
                defer banish ntxt2
                set pindex is calling param_index with s, info, ntxt2
            else:
                set vnode is calling astutil.node_child with s->ast, arg, 0
                if pos_next < fixed:
                    set pindex is pos_next
                set pos_next is pos_next + 1
            if pindex >= 0 and pindex < fixed:
                var p as types.SemaFnParam is (s->types->fn_params at (info.params_first + pindex))
                var pexp as int is p.type
                if subst.len > 0:
                    var psub as int is calling ginst.subst_deep with s->symbols, p.type, subst
                    if psub > 0:
                        set pexp is psub
                var got as int is calling infer with s, vnode, pexp
                if not calling compat.compatible with s->types, got, pexp:
                    # Las firmas C de `declare` se validan en el binding; el
                    # checker no debe reinterpretar sus tipos ABI (function
                    # pointers, `void *`, ...).
                    if fsv.kind != sym.SemaSymbolKind.SkDeclare:
                        calling type_mismatch with s, vnode, pexp, got
                calling ginst.unify_param with s->symbols, p.type, got, (sigil of subst)
                calling arg_types.push with got
                if i == 0:
                    set first_arg_type is got
            else if has_many and pindex < 0 and ak != pskind.NodeKind.NdNamedArg:
                # El `many` final absorbe los argumentos que sobran. Un reenvío
                # (`calling sum with xs`) aporta su elemento; N valores sueltos
                # se tipan uno a uno contra el tipo del elemento.
                if vnode >= 0:
                    var gotm as int is calling infer with s, vnode, -1
                    var elem as int is gotm
                    if nargs - fixed == 1 and gotm > 0:
                        var gt as tk.SemaType is calling types.at with s->types, gotm
                        if gt.kind == tk.SemaTypeKind.TkSlice or gt.kind == tk.SemaTypeKind.TkMany or gt.kind == tk.SemaTypeKind.TkArray:
                            set elem is gt.a
                    if many_elem > 0 and not calling compat.compatible with s->types, elem, many_elem:
                        if fsv.kind != sym.SemaSymbolKind.SkDeclare:
                            calling type_mismatch with s, vnode, many_elem, elem
                    calling ginst.unify_param with s->symbols, many_elem, elem, (sigil of subst)
                    calling arg_types.push with gotm
                    if i == 0:
                        set first_arg_type is gotm
            else:
                if vnode >= 0:
                    var gotv as int is calling infer with s, vnode, -1
                    if i == 0:
                        set first_arg_type is gotv
        set i is i + 1
    # En una instancia genérica el default debe encajar con el tipo sustituido:
    # el C sólo lo descubriría al compilar (y con un error ilegible).
    if subst.len > 0:
        var dj as int is 0
        while dj < fixed:
            var cov as bool is dj < pos_next
            var nj3 as int is 0
            while nj3 < named.len:
                if (named at nj3) == dj:
                    set cov is true
                set nj3 is nj3 + 1
            if not cov:
                var dp as types.SemaFnParam is (s->types->fn_params at (info.params_first + dj))
                if dp.default_kind != types.DEF_NONE and dp.type > 0:
                    var dsub as int is calling ginst.subst_deep with s->symbols, dp.type, subst
                    if dsub > 0 and not (calling types.default_fits with s->types, dsub, dp.default_kind):
                        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_DEFAULT_VALUE, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "default value does not match the instantiated type", "Pass the argument explicitly or change the default.", ""
            set dj is dj + 1
    if recv_bounds < 0 and fsv.bounds_count > 0 and first_arg_type > 0:
        var bj as int is 0
        while bj < fsv.bounds_count:
            if not (calling compat.concept_satisfied with s->types, first_arg_type, (s->types->bounds at (fsv.bounds_first + bj))):
                var bmsg as string is "type does not satisfy concept bound"
                defer banish bmsg
                calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CONCEPT_BOUND, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), bmsg, "Add the required concept implementation or change the bound.", ""
            set bj is bj + 1
    if (info.flags & types.FN_SPAWN) != 0:
        calling infer_spawn with s, node, args, arg_types
    if (info.flags & types.FN_CORO) != 0:
        calling infer_coro with s, node, args, arg_types
    var ret as int is info.return_type
    set ret is calling ginst.instantiate_return with s->symbols, info, rtemplate, inst_recv, arg_types
    if ret != info.return_type:
        calling ann.set_type with s->annotations, node, ret
    if ret == calling types.base with s->types, "void":
        if (calling astutil.child_count with s->ast, target) > 2:
            return chain_last
    return ret

## Resuelve un paso de método de `NdChainExpr`.
##
## ## Memoria
## Infiere argumentos; no posee listas.
weave infer_chain_method with s as ref to state.SemaState, recv as int, step as int, is_last as bool into int:
    var mtok as int is calling astutil.token_child with s->ast, step, 0
    if mtok < 0:
        return 0
    var mname as string is calling astutil.token_text with s->src, s->lex, mtok
    defer banish mname
    var rbase as int is calling underlying_type with s, recv
    var rty as tk.SemaType is calling types.at with s->types, rbase
    if rty.kind == tk.SemaTypeKind.TkRef:
        set rbase is rty.a
    var mid as int is calling npool.intern with s->names, mname
    var sid as int is calling symbols.lookup_method with s->symbols, rbase, mid
    if sid < 0:
        if calling report_ambiguous_method with s, step, rbase, mid, mname:
            return 0
        var msg as string is "'{mname}' is not a method of this receiver"
        defer banish msg
        var help as string is "Declare it in an 'enchanting' block for the receiver type, or use 'pipe' for a free function."
        defer banish help
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CHAIN, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), msg, help, ""
        return 0
    var fsv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
    var ft as tk.SemaType is calling types.at with s->types, (calling resolve_callable with s->types, fsv.type)
    if ft.kind != tk.SemaTypeKind.TkFn:
        return fsv.type
    var info as types.SemaFnInfo is (s->types->fn_infos at ft.a)
    if (fsv.flags & sym.SYM_MUTATING) != 0 and not is_last:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MUTATES_EXPR, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), "mutating method used in the middle of a chain", "Only the last step may mutate; it must return a value or edit through a reference.", ""
        return 0
    if info.return_type == calling types.base with s->types, "void":
        if not is_last:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CHAIN, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), "chain step returns void", "Only the last step may return void; intermediate steps must produce a value.", ""
            return 0
        calling ann.ann_set_symbol with s->annotations, step, sid
        return recv
    var args as int is calling astutil.node_child with s->ast, step, 1
    var nargs as int is 0
    if args >= 0:
        set nargs is calling astutil.child_count with s->ast, args
    var ai as int is 0
    while ai < nargs:
        var arg as int is calling astutil.node_child with s->ast, args, ai
        if arg >= 0:
            var pindex as int is ai
            var vnode as int is arg
            var is_named as bool is (calling astutil.kind_of with s->ast, arg) == pskind.NodeKind.NdNamedArg
            if is_named:
                set vnode is calling astutil.node_child with s->ast, arg, 1
                calling sdiag.node_error with s->bag, s->src, sdiag.CODE_NAMED_ARG, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), "named arguments are not supported in chained calls", "Use 'calling recv.method with name is value' instead.", ""
            if pindex < info.params_count and not is_named:
                var p as types.SemaFnParam is (s->types->fn_params at (info.params_first + pindex))
                var got as int is calling infer with s, vnode, p.type
                if not calling compat.compatible with s->types, got, p.type:
                    calling type_mismatch with s, vnode, p.type, got
        set ai is ai + 1
    calling ann.ann_set_symbol with s->annotations, step, sid
    return info.return_type

## Resuelve un paso `pipe` de `NdChainExpr`.
##
## ## Memoria
## Infiere argumentos; no posee listas.
weave infer_chain_pipe with s as ref to state.SemaState, recv as int, step as int, is_last as bool into int:
    var target as int is calling astutil.node_child with s->ast, step, 0
    if target < 0:
        return 0
    var nm as int is calling astutil.token_child with s->ast, target, 0
    if nm < 0:
        return 0
    var fname as string is calling astutil.token_text with s->src, s->lex, nm
    defer banish fname
    var sid as int is calling symbols.lookup_name with s->symbols, fname
    # `pipe mod.fn`: el primer nombre es un import y el segundo la función.
    if sid >= 0 and (calling astutil.child_count with s->ast, target) > 1:
        var bs as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
        if bs.kind == sym.SemaSymbolKind.SkImport and bs.module_scope >= 0:
            var op as int is calling astutil.node_child with s->ast, target, 1
            if op >= 0:
                var ot as int is calling astutil.token_child with s->ast, op, 0
                if ot >= 0:
                    var otxt as string is calling astutil.token_text with s->src, s->lex, ot
                    var oid as int is calling npool.intern with s->names, otxt
                    var mfn as int is calling symbols.lookup_in_scope with s->symbols, bs.module_scope, oid
                    if mfn >= 0:
                        set sid is mfn
                    else:
                        var gid as int is calling symbols.lookup_name with s->symbols, otxt
                        if gid >= 0 and (calling s->symbols->method_receiver.has with gid):
                            set sid is gid
                    banish fname
                    set fname is calling npool.copy_string with (calling npool.text with s->names, oid)
                    banish otxt
    if sid < 0:
        var msg as string is "'{fname}' is not a free function"
        defer banish msg
        var help as string is "Use a weave/declare function, or use '.' for a method."
        defer banish help
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CHAIN, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), msg, help, ""
        return 0
    if calling s->symbols->method_receiver.has with sid:
        var mmsg as string is "'{fname}' is a method, not a free function"
        defer banish mmsg
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CHAIN, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), mmsg, "Use '.' for methods and 'pipe' for free functions.", ""
        return 0
    var fsv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
    if fsv.kind != sym.SemaSymbolKind.SkWeave and fsv.kind != sym.SemaSymbolKind.SkDeclare:
        var msg2 as string is "'{fname}' is not a free function"
        defer banish msg2
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CHAIN, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), msg2, "Use a weave/declare function, or use '.' for a method.", ""
        return 0
    var ft as tk.SemaType is calling types.at with s->types, (calling resolve_callable with s->types, fsv.type)
    if ft.kind != tk.SemaTypeKind.TkFn:
        return fsv.type
    var info as types.SemaFnInfo is (s->types->fn_infos at ft.a)
    if info.params_count > 0:
        var p0 as types.SemaFnParam is (s->types->fn_params at info.params_first)
        if not calling compat.compatible with s->types, recv, p0.type:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), "pipe value does not match the first parameter", "The previous value is passed as the first argument.", ""
            return 0
    var args as int is calling astutil.node_child with s->ast, step, 1
    var nargs as int is 0
    if args >= 0:
        set nargs is calling astutil.child_count with s->ast, args
    var ai as int is 0
    while ai < nargs:
        var arg as int is calling astutil.node_child with s->ast, args, ai
        if arg >= 0:
            var pindex as int is ai + 1
            var vnode as int is arg
            var is_named as bool is (calling astutil.kind_of with s->ast, arg) == pskind.NodeKind.NdNamedArg
            if is_named:
                set vnode is calling astutil.node_child with s->ast, arg, 1
                calling sdiag.node_error with s->bag, s->src, sdiag.CODE_NAMED_ARG, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), "named arguments are not supported in chained calls", "Use 'calling recv.method with name is value' instead.", ""
            if pindex < info.params_count and not is_named:
                var p as types.SemaFnParam is (s->types->fn_params at (info.params_first + pindex))
                var got as int is calling infer with s, vnode, p.type
                if not calling compat.compatible with s->types, got, p.type:
                    calling type_mismatch with s, vnode, p.type, got
        set ai is ai + 1
    calling ann.ann_set_symbol with s->annotations, step, sid
    if info.return_type == calling types.base with s->types, "void":
        if not is_last:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CHAIN, (calling astutil.start_of with s->ast, step), (calling astutil.end_of with s->ast, step), "pipe step returns void", "Only the last step may return void; intermediate steps must produce a value.", ""
            return 0
        return recv
    return info.return_type

## Infiere una cadena de métodos (`aux == 0`) o de pipes (`aux == 1`).
##
## ## Memoria
## Infiere la base y cada paso; no posee listas.
weave infer_chain with s as ref to state.SemaState, node as int into int:
    var base as int is calling astutil.node_child with s->ast, node, 0
    if base < 0:
        return 0
    var cur as int is calling infer with s, base, -1
    if cur <= 0:
        return 0
    var mode as int is (s->ast->nodes at node).aux
    var n as int is calling astutil.child_count with s->ast, node
    var i as int is 1
    while i < n:
        var step as int is calling astutil.node_child with s->ast, node, i
        if step >= 0:
            var is_last as bool is i == n - 1
            if mode == 1:
                set cur is calling infer_chain_pipe with s, cur, step, is_last
            else:
                set cur is calling infer_chain_method with s, cur, step, is_last
            if cur <= 0:
                return 0
            calling ann.set_type with s->annotations, step, cur
        set i is i + 1
    return cur

## Tipo de un método nativo de una colección/string.
##
## Devuelve `-1` si no es un método conocido. Se usa para no rechazar
## `list.push`, `map.put`, etc. antes de que el registro de métodos builtin
## esté completo.
##
## ## Memoria
## O(1).
weave builtin_method with s as ref to state.SemaState, recv as int, name as string, expected as int into int:
    var rt as tk.SemaType is calling types.at with s->types, recv
    if rt.kind == tk.SemaTypeKind.TkAlias or rt.kind == tk.SemaTypeKind.TkSeal:
        return calling builtin_method with s, (calling underlying_type with s, recv), name, expected
    var kind as tk.SemaTypeKind is rt.kind
    if kind == tk.SemaTypeKind.TkRef:
        return calling builtin_method with s, rt.a, name, expected
    if kind == tk.SemaTypeKind.TkTypeParam:
        return calling types.base with s->types, "int"
    if kind == tk.SemaTypeKind.TkList:
        if name == "is_shared":
            return calling types.base with s->types, "bool"
        if name == "ref_count":
            return calling types.base with s->types, "int"
        if name == "make_unique":
            return 3
        if name == "push" or name == "append" or name == "clear" or name == "insert":
            return 3
        if name == "pop" or name == "at" or name == "last" or name == "first":
            return rt.a
        if name == "length" or name == "len" or name == "count":
            return calling types.base with s->types, "int"
        if name == "contains" or name == "is_empty":
            return calling types.base with s->types, "bool"
        if name == "size" or name == "len" or name == "length":
            return calling types.base with s->types, "int"
        var pnid as int is calling npool.find with s->names, name
        var pok as bool is false
        if pnid >= 0:
            var pi as int is 0
            while pi < s->symbols->symbols.len:
                if calling s->symbols->method_receiver.has with pi:
                    var ps as sym.SemaSymbol is (s->symbols->symbols at pi)
                    if ps.name == pnid:
                        var pr as int is calling s->symbols->method_receiver.get with pi
                        if calling compat.has_type_param with s->types, pr:
                            set pok is true
                        else:
                            var prt as tk.SemaType is calling types.at with s->types, (calling underlying_type with s, pr)
                            if prt.kind == tk.SemaTypeKind.TkList and calling compat.compatible with s->types, rt.a, prt.a:
                                set pok is true
                set pi is pi + 1
        if not pok:
            return -1
        if expected >= 0:
            return expected
        return 3
    if kind == tk.SemaTypeKind.TkMap:
        if name == "is_shared":
            return calling types.base with s->types, "bool"
        if name == "ref_count":
            return calling types.base with s->types, "int"
        if name == "make_unique":
            return 3
        if name == "put" or name == "clear" or name == "insert" or name == "set":
            return 3
        if name == "remove" or name == "has_key" or name == "contains" or name == "has":
            return calling types.base with s->types, "bool"
        if name == "get_safe":
            return calling types.maybe_of with s->types, rt.b
        if name == "get" or name == "at" or name == "get_or":
            return rt.b
        if name == "keys":
            return calling types.list_of with s->types, rt.a
        if name == "values":
            return calling types.list_of with s->types, rt.b
        if name == "has" or name == "contains":
            return calling types.base with s->types, "bool"
        if name == "length" or name == "len" or name == "size":
            return calling types.base with s->types, "int"
        if name == "is_empty":
            return calling types.base with s->types, "bool"
        if expected >= 0:
            return expected
        return 3
    if kind == tk.SemaTypeKind.TkMaybe:
        if expected >= 0:
            return expected
        if name == "is_some" or name == "is_none":
            return calling types.base with s->types, "bool"
        if name == "unwrap" or name == "unwrap_or" or name == "unwrap_or_else" or name == "value_or" or name == "expect":
            return rt.a
        if name == "map" or name == "filter" or name == "and" or name == "or":
            return recv
        return rt.a
    if kind == tk.SemaTypeKind.TkResult:
        if expected >= 0:
            return expected
        if name == "is_ok" or name == "is_err":
            return calling types.base with s->types, "bool"
        if name == "unwrap" or name == "expect" or name == "value_or" or name == "unwrap_or" or name == "unwrap_or_else":
            return rt.a
        if name == "unwrap_err" or name == "expect_err":
            return rt.b
        if name == "map" or name == "map_err" or name == "and" or name == "or":
            return recv
        return rt.a
    if kind == tk.SemaTypeKind.TkArray or kind == tk.SemaTypeKind.TkSlice:
        if name == "length" or name == "len":
            return calling types.base with s->types, "int"
        if name == "at":
            return rt.a
        if expected >= 0:
            return expected
        return 3
    if rt.kind == tk.SemaTypeKind.TkBase and calling compat.is_string with s->types, recv:
        if name == "is_shared":
            return calling types.base with s->types, "bool"
        if name == "ref_count":
            return calling types.base with s->types, "int"
        if name == "make_unique":
            return 3
        if name == "length" or name == "len":
            return calling types.base with s->types, "int"
        if name == "at":
            return calling types.base with s->types, "char"
        if name == "contains" or name == "is_empty":
            return calling types.base with s->types, "bool"
        if name == "starts_with" or name == "ends_with":
            return calling types.base with s->types, "bool"
        if name == "size" or name == "length" or name == "len":
            return calling types.base with s->types, "int"
        if expected >= 0:
            return expected
        return 3
    return -1

## Tipo activo de `with` desde el scope actual.
##
## ## Memoria
## O(profundidad).
weave active_with_type with s as ref to state.SemaState into int:
    var cur as int is s->symbols->current
    while cur >= 0:
        var sc as scope.SemaScope is (s->symbols->scopes at cur)
        if sc.with_type >= 0:
            return sc.with_type
        set cur is sc.parent
    return -1

## Tipo del campo `.campo` leído dentro de un `with`.
##
## ## Memoria
## No asigna.
weave infer_with_field with s as ref to state.SemaState, node as int into int:
    var recv as int is calling active_with_type with s
    var nm as int is calling astutil.token_child with s->ast, node, 0
    if recv < 0 or nm < 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "'.field' needs an enclosing 'with'", "Write it inside 'with value:' or name the receiver.", ""
        return 0
    var txt as string is calling astutil.token_text with s->src, s->lex, nm
    defer banish txt
    var nid as int is calling npool.intern with s->names, txt
    var fi as int is calling nominal_field_index with s, recv, nid
    var out as int is 0
    if fi >= 0:
        var t2 as int is calling underlying_type with s, recv
        var tyy as tk.SemaType is calling types.at with s->types, t2
        var info as types.SemaNominalInfo is (s->types->nominal_infos at tyy.a)
        var f as types.SemaField is (s->types->fields at (info.fields_first + fi))
        set out is f.type
    else:
        # Campos promovidos por `fundere`.
        var p as int is calling promoted_field_type with s, recv, nid, node
        if p > 0:
            set out is p
        else if p < 0:
            return 0
        else:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "the 'with' target has no field '{txt}'", "Check the field name or the type of the target.", ""
            return 0
    # Accesos encadenados: `.inner.y` apunta al campo `y` de `inner`, no a
    # `inner`. El codegen ya recorre la cadena; la sema debe hacer lo mismo.
    var n as int is calling astutil.child_count with s->ast, node
    var ai as int is 1
    while ai < n:
        var ch as int is calling astutil.node_child with s->ast, node, ai
        if ch >= 0:
            var ck as pskind.NodeKind is calling astutil.kind_of with s->ast, ch
            if ck == pskind.NodeKind.NdDotAccess or ck == pskind.NodeKind.NdArrowAccess:
                var atok as int is calling astutil.token_child with s->ast, ch, 0
                if atok >= 0:
                    var atxt as string is calling astutil.token_text with s->src, s->lex, atok
                    var anid as int is calling npool.intern with s->names, atxt
                    var sub as int is calling field_type with s, out, atxt
                    if sub == 0:
                        var prom as int is calling promoted_field_type with s, out, anid, ch
                        if prom > 0:
                            set sub is prom
                    banish atxt
                    set out is sub
        set ai is ai + 1
    return out

## Llamada con target `.method` dentro de `with`.
##
## ## Memoria
## Infiere args; no asigna.
weave infer_with_call with s as ref to state.SemaState, node as int, target as int, expected as int into int:
    var recv_orig as int is calling active_with_type with s
    var recv as int is recv_orig
    var nm as int is calling astutil.token_child with s->ast, target, 0
    if recv < 0 or nm < 0:
        return 0
    var txt as string is calling astutil.token_text with s->src, s->lex, nm
    defer banish txt
    var rty as tk.SemaType is calling types.at with s->types, recv
    if rty.kind == tk.SemaTypeKind.TkRef:
        set recv is rty.a
    var mid as int is calling npool.intern with s->names, txt
    var sid as int is calling symbols.lookup_method with s->symbols, recv, mid
    if sid < 0:
        if calling report_ambiguous_method with s, node, recv, mid, txt:
            return 0
    var args as int is calling astutil.node_child with s->ast, node, 2
    if sid >= 0:
        var fsv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
        var ft as tk.SemaType is calling types.at with s->types, fsv.type
        if ft.kind == tk.SemaTypeKind.TkFn:
            var info as types.SemaFnInfo is (s->types->fn_infos at ft.a)
            calling ann.ann_set_symbol with s->annotations, node, sid
            var arg_types as list of int is list of int
            var ai as int is 0
            var nargs as int is 0
            if args >= 0:
                set nargs is calling astutil.child_count with s->ast, args
            while ai < nargs:
                var arg as int is calling astutil.node_child with s->ast, args, ai
                if arg >= 0:
                    var vnode as int is arg
                    if (calling astutil.kind_of with s->ast, arg) == pskind.NodeKind.NdNamedArg:
                        set vnode is calling astutil.node_child with s->ast, arg, 1
                    var pty as int is 0
                    if ai < info.params_count:
                        var p as types.SemaFnParam is (s->types->fn_params at (info.params_first + ai))
                        set pty is p.type
                    var got as int is calling infer with s, vnode, pty
                    calling arg_types.push with got
                set ai is ai + 1
            var rtemplate as int is -1
            if calling s->symbols->method_receiver.has with sid:
                set rtemplate is calling s->symbols->method_receiver.get with sid
            var ret as int is calling ginst.instantiate_return with s->symbols, info, rtemplate, recv_orig, arg_types
            banish arg_types
            if ret > 0:
                calling ann.set_type with s->annotations, node, ret
            return ret
    var bm as int is calling builtin_method with s, recv, txt, expected
    if bm > 0:
        calling infer_args_only with s, args
        return bm
    return 0

## ¿El concepto `c` concede `op`?
##
## ## Memoria
## O(1).
weave concept_grants with c as string, op as string into bool:
    if op == "add" or op == "sub" or op == "mul" or op == "div" or op == "neg":
        return c == "Num" or c == "Integrum" or c == "Real"
    if op == "mod" or op == "band" or op == "bor" or op == "bxor" or op == "shl" or op == "shr" or op == "bnot":
        return c == "Integrum"
    if op == "eq" or op == "ne":
        return c == "Num" or c == "Integrum" or c == "Real" or c == "Par"
    if op == "lt" or op == "le" or op == "gt" or op == "ge":
        return c == "Integrum" or c == "Real" or c == "Ordo"
    return true

## ¿El scope actual concede `op` a un `TypeParam`?
##
## Devuelve `true` si no hay bounds (no se puede decidir aquí).
##
## ## Memoria
## O(profundidad * bounds).
weave bound_operator_ok with s as ref to state.SemaState, op as string into bool:
    var cur as int is s->symbols->current
    while cur >= 0:
        var sc as scope.SemaScope is (s->symbols->scopes at cur)
        if sc.bounds_count > 0:
            var i as int is 0
            while i < sc.bounds_count:
                var cid as int is (s->types->bounds at (sc.bounds_first + i))
                var cty as tk.SemaType is calling types.at with s->types, cid
                var cnid as int is cty.name
                if cnid < 0 and cty.a >= 0 and cty.a < s->types->nominal_infos.len:
                    var cinfo as types.SemaNominalInfo is (s->types->nominal_infos at cty.a)
                    set cnid is cinfo.base_name
                var ctext as string is calling npool.text with s->names, cnid
                if calling concept_grants with ctext, op:
                    return true
                set i is i + 1
            return false
        set cur is sc.parent
    return true

## Reporta un operador no concedido por el bound actual.
##
## ## Memoria
## O(1).
weave operator_bound_error with s as ref to state.SemaState, node as int, op as string into void:
    var msg as string is "operator '{op}' is not granted by the concept bound"
    defer banish msg
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_CONCEPT_OPERATOR, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), msg, "Use a concept that grants this operator or avoid it in the generic body.", ""

## Aplica un acceso intermedio a un tipo.
##
## ## Memoria
## O(1)/campos.
## Desenvuelve alias/seal hasta el tipo real.
##
## ## Memoria
## O(profundidad); no asigna.
weave underlying_type with s as ref to state.SemaState, id as int into int:
    var cur as int is id
    var ty as tk.SemaType is calling types.at with s->types, cur
    while ty.kind == tk.SemaTypeKind.TkAlias or ty.kind == tk.SemaTypeKind.TkSeal:
        set cur is ty.b
        set ty is calling types.at with s->types, cur
    return cur

## Aplica un acceso intermedio a un tipo.
weave access_op_type with s as ref to state.SemaState, base as int, op as int into int:
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, op
    if k == pskind.NodeKind.NdAtAccess:
        return calling compat.element_type with s->types, base
    var nm as int is calling astutil.token_child with s->ast, op, 0
    if nm < 0:
        return 0
    var txt as string is calling astutil.token_text with s->src, s->lex, nm
    defer banish txt
    var bt as int is base
    if k == pskind.NodeKind.NdArrowAccess:
        var bty as tk.SemaType is calling types.at with s->types, bt
        if bty.kind == tk.SemaTypeKind.TkRef:
            set bt is bty.a
    return calling field_type with s, bt, txt

## Infiere argumentos sin comprobar contra una firma.
##
## ## Memoria
## O(n).
weave infer_args_only with s as ref to state.SemaState, args as int into void:
    if args < 0:
        return
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, args
    while i < n:
        var arg as int is calling astutil.node_child with s->ast, args, i
        if arg >= 0:
            var v as int is -1
            if (calling astutil.kind_of with s->ast, arg) == pskind.NodeKind.NdNamedArg:
                set v is calling astutil.node_child with s->ast, arg, 1
            else:
                set v is calling astutil.node_child with s->ast, arg, 0
            if v >= 0:
                var ignored as int is calling infer with s, v, -1
        set i is i + 1

## Constructores `ok_of`/`err_of`.
##
## ## Memoria
## O(1).
weave infer_result_ctor with s as ref to state.SemaState, node as int, which as string, expected as int into int:
    var args as int is calling astutil.node_child with s->ast, node, 2
    var val as int is 3
    if args >= 0:
        var a0 as int is calling astutil.node_child with s->ast, args, 0
        if a0 >= 0:
            var vn as int is calling astutil.node_child with s->ast, a0, 0
            if vn < 0:
                set vn is a0
            set val is calling infer with s, vn, -1
    var err as int is 3
    var ok as int is val
    if expected >= 0:
        var ex as tk.SemaType is calling types.at with s->types, expected
        if ex.kind == tk.SemaTypeKind.TkResult:
            set err is ex.b
            if which == "err_of":
                set ok is ex.a
            if which == "ok_of" and ex.a == 3:
                return expected
            if which == "ok_of":
                if not (calling compat.compatible with s->types, val, ex.a):
                    calling type_mismatch with s, node, ex.a, val
                    return expected
            if which == "err_of":
                if not (calling compat.compatible with s->types, val, ex.b):
                    calling type_mismatch with s, node, ex.b, val
                    return expected
    if which == "ok_of":
        return calling types.result_of with s->types, val, err
    return calling types.result_of with s->types, ok, val

## Emite el error de una llamada inexistente.
##
## ## Memoria
## Construye un mensaje temporal.
weave undefined_call with s as ref to state.SemaState, node as int, name as string into void:
    var msg as string is "undefined function '{name}'"
    defer banish msg
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), msg, "Check the name or import the module that defines it.", ""

## Índice de un parámetro por nombre.
##
## ## Memoria
## O(n).
weave param_index with s as ref to state.SemaState, info as types.SemaFnInfo, name as string into int:
    var nid as int is calling npool.find with s->names, name
    if nid < 0:
        return -1
    var i as int is 0
    while i < info.params_count:
        var p as types.SemaFnParam is (s->types->fn_params at (info.params_first + i))
        if p.name == nid:
            return i
        set i is i + 1
    return -1

## Acceso `.field`.
##
## ## Memoria
## O(campos).
weave infer_field with s as ref to state.SemaState, node as int into int:
    var base as int is calling astutil.node_child with s->ast, node, 0
    var bt as int is 0
    if base >= 0:
        set bt is calling infer with s, base, -1
    var nm as int is calling astutil.token_child with s->ast, node, 1
    if nm < 0:
        return 0
    var txt as string is calling astutil.token_text with s->src, s->lex, nm
    defer banish txt
    if bt <= 0 and base >= 0:
        # `import` member: `spark.PI`, `types.NIF_...`.
        var bkind as pskind.NodeKind is calling astutil.kind_of with s->ast, base
        if bkind == pskind.NodeKind.NdNormalTarget or bkind == pskind.NodeKind.NdVarRef:
            var btok as int is calling astutil.token_child with s->ast, base, 0
            if btok >= 0:
                var btxt as string is calling astutil.token_text with s->src, s->lex, btok
                defer banish btxt
                var bid as int is calling symbols.lookup_name with s->symbols, btxt
                if bid >= 0:
                    var bsv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, bid
                    if bsv.kind == sym.SemaSymbolKind.SkImport:
                        var mid as int is calling npool.intern with s->names, txt
                        var member as int is calling symbols.lookup_in_scope with s->symbols, bsv.module_scope, mid
                        if member >= 0:
                            var mv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, member
                            return mv.type
    if bt <= 0:
        return 0
    var bnid as int is calling npool.find with s->names, txt
    if bnid >= 0:
        var pt as int is calling promoted_field_type with s, bt, bnid, node
        if pt > 0:
            return pt
        if pt < 0:
            # E0087 ya emitido.
            return 0
    var ftx as int is calling field_type with s, bt, txt
    if ftx == 0:
        calling report_unknown_field with s, node, bt, txt
    return ftx

## Diagnostica un campo inexistente en un rune/echo concreto.
##
## Antes el acceso se resolvía a "tipo 0" sin error y el fallo aparecía en el
## compilador de C (`'A' no tiene un miembro llamado 'nope'`).
##
## ## Memoria
## No asigna aparte del nombre consultado.
weave report_unknown_field with s as ref to state.SemaState, node as int, ty as int, txt as string into void:
    var t2 as int is calling underlying_type with s, ty
    var ty2 as tk.SemaType is calling types.at with s->types, t2
    if ty2.kind != tk.SemaTypeKind.TkRune and ty2.kind != tk.SemaTypeKind.TkEcho:
        return
    var info as types.SemaNominalInfo is (s->types->nominal_infos at ty2.a)
    # `r.get->value` encadena un método sin `calling`: el nombre no es un campo.
    var mnid as int is calling npool.intern with s->names, txt
    if (calling symbols.lookup_method with s->symbols, ty, mnid) >= 0:
        return
    var rn as string is calling npool.copy_string with (calling npool.text with s->names, info.base_name)
    defer banish rn
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "rune '{rn}' has no field '{txt}'", "Check the field name. Composition via 'fundere' promotes fields, so also check the embed types.", ""

## Acceso `->field`.
##
## ## Memoria
## O(campos).
weave infer_arrow with s as ref to state.SemaState, node as int into int:
    var base as int is calling astutil.node_child with s->ast, node, 0
    var bt as int is 0
    if base >= 0:
        set bt is calling infer with s, base, -1
    var ty as tk.SemaType is calling types.at with s->types, bt
    var base_kind as pskind.NodeKind is calling astutil.kind_of with s->ast, base
    if base_kind == pskind.NodeKind.NdSelfRef and (ty.kind == tk.SemaTypeKind.TkBase or ty.kind == tk.SemaTypeKind.TkTypeParam):
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_SELF_DOT, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "'self' of a primitive is a value, not a reference", "Use `self.field` only on a rune/echo or a ref.", ""
    var target as int is bt
    if ty.kind == tk.SemaTypeKind.TkRef:
        set target is ty.a
    var nm as int is calling astutil.token_child with s->ast, node, 1
    if nm < 0 or target <= 0:
        return 0
    var txt as string is calling astutil.token_text with s->src, s->lex, nm
    defer banish txt
    var nid2 as int is calling npool.find with s->names, txt
    if nid2 >= 0:
        var pt2 as int is calling promoted_field_type with s, target, nid2, node
        if pt2 > 0:
            return pt2
        if pt2 < 0:
            return 0
    var fta as int is calling field_type with s, target, txt
    if fta == 0:
        calling report_unknown_field with s, node, target, txt
    return fta

## Nombres de los embeds de primer nivel que contienen el campo `nid`.
##
## Para el mensaje de E0087: "promoted from 'gameObj', 'physics'". Se libera
## con `banish`.
##
## ## Memoria
## Asigna un `StringBuilder` y los textos consultados.
weave embed_sources_text with s as ref to state.SemaState, ty as int, nid as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var u as int is calling embeds.unwrap with s->types, ty
    if u <= 0:
        return calling sb.finish
    var st as tk.SemaType is calling types.at with s->types, u
    if st.kind != tk.SemaTypeKind.TkRune and st.kind != tk.SemaTypeKind.TkEcho:
        return calling sb.finish
    var info as types.SemaNominalInfo is (s->types->nominal_infos at st.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (s->types->fields at (info.fields_first + i))
        if (f.flags & types.FIELD_EMBED) != 0:
            var path as list of int is list of int
            var r as int is calling embeds.route_into with s->types, f.type, nid, (sigil of path), 1
            banish path
            if r == embeds.ROUTE_FOUND:
                var ftxt as string is calling npool.text with s->names, f.name
                if (calling sb.len) > 0:
                    calling sb.append with ", "
                calling sb.append with "'{ftxt}'"
                banish ftxt
        set i is i + 1
    return calling sb.finish

## Nombres de los embeds que exponen el método `mid` (para E0088).
##
## ## Memoria
## Devuelve string owned.
weave embed_method_sources_text with s as ref to state.SemaState, ty as int, mid as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var u as int is calling embeds.unwrap with s->types, ty
    if u <= 0:
        return calling sb.finish
    var st as tk.SemaType is calling types.at with s->types, u
    if st.kind != tk.SemaTypeKind.TkRune and st.kind != tk.SemaTypeKind.TkEcho:
        return calling sb.finish
    var info as types.SemaNominalInfo is (s->types->nominal_infos at st.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (s->types->fields at (info.fields_first + i))
        if (f.flags & types.FIELD_EMBED) != 0:
            var here as int is calling symbols.lookup_method_exact with s->symbols, f.type, mid
            var has as bool is false
            if calling symbols.method_promotable with s->symbols, here:
                set has is true
            else if (calling symbols.count_promoted_method with s->symbols, f.type, mid, 1) > 0:
                set has is true
            if has:
                var ftxt as string is calling npool.text with s->names, f.name
                if (calling sb.len) > 0:
                    calling sb.append with ", "
                calling sb.append with "'{ftxt}'"
                banish ftxt
        set i is i + 1
    return calling sb.finish

## Si `mid` está promovido desde más de un embed, emite E0088 y devuelve
## `true`. El llamador no añade entonces un «método inexistente».
##
## ## Memoria
## Asigna el diagnóstico y strings temporales.
weave report_ambiguous_method with s as ref to state.SemaState, node as int, ty as int, mid as int, mtext as string into bool:
    if ty <= 0:
        return false
    var cnt as int is calling symbols.count_promoted_method with s->symbols, ty, mid, 0
    if cnt < 2:
        return false
    var src as string is calling embed_method_sources_text with s, ty, mid
    defer banish src
    var msg as string is "ambiguous method '{mtext}' promoted from {src}"
    defer banish msg
    var help as string is "Use the explicit embed field: write it before the method (for example 'host.{src}.{mtext}')."
    defer banish help
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_EMBED_AMBIGUOUS_METHOD, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), msg, help, ""
    return true

## Busca un método `ritual` con el nombre `mid` en los embeds de `ty`.
##
## Los rituales no se promueven (construyen el embed, no el host); cuando el
## usuario escribe `calling host.new()` conviene decírselo en vez de «undefined
## function».
##
## ## Memoria
## No asigna.
weave find_embedded_ritual with s as ref to state.SemaState, ty as int, mid as int, depth as int into int:
    if depth > 32:
        return -1
    var u as int is calling embeds.unwrap with s->types, ty
    if u <= 0:
        return -1
    var st as tk.SemaType is calling types.at with s->types, u
    if st.kind != tk.SemaTypeKind.TkRune and st.kind != tk.SemaTypeKind.TkEcho:
        return -1
    var info as types.SemaNominalInfo is (s->types->nominal_infos at st.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (s->types->fields at (info.fields_first + i))
        if (f.flags & types.FIELD_EMBED) != 0:
            var sid as int is calling symbols.lookup_method_exact with s->symbols, f.type, mid
            if sid >= 0:
                var sy as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
                if (sy.flags & sym.SYM_RITUAL) != 0:
                    return f.name
            var deeper as int is calling find_embedded_ritual with s, f.type, mid, depth + 1
            if deeper >= 0:
                return deeper
        set i is i + 1
    return -1

## Si el nombre es un ritual de un embed, explica que no se promueve.
##
## ## Memoria
## Asigna el diagnóstico y strings temporales.
weave report_ritual_not_promoted with s as ref to state.SemaState, node as int, ty as int, mid as int, mtext as string into bool:
    if ty <= 0:
        return false
    var fname as int is calling find_embedded_ritual with s, ty, mid, 0
    if fname < 0:
        return false
    var etxt as string is calling npool.text with s->names, fname
    defer banish etxt
    var msg as string is "ritual '{mtext}' is not promoted by 'fundere'"
    defer banish msg
    var help as string is "Call it on the embed's own type ('Type.{mtext}'), or declare a ritual on the host."
    defer banish help
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), msg, help, ""
    return true

## Tipo del campo `nid` con promoción, emitiendo E0087 si es ambiguo.
##
## Devuelve `0` si el campo no existe (el llamador decide el diagnóstico) o si
## es ambiguo (ya se emitió E0087).
##
## ## Memoria
## Asigna una ruta temporal y el mensaje del diagnóstico.
weave promoted_field_type with s as ref to state.SemaState, ty as int, nid as int, node as int into int:
    var path as list of int is list of int
    defer banish path
    var r as int is calling embeds.route_into with s->types, ty, nid, (sigil of path), 0
    if r == embeds.ROUTE_AMBIGUOUS:
        var txt as string is calling npool.text with s->names, nid
        defer banish txt
        var src as string is calling embed_sources_text with s, ty, nid
        defer banish src
        var msg as string is "ambiguous field '{txt}' promoted from {src}"
        defer banish msg
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_EMBED_AMBIGUOUS_FIELD, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), msg, "Use the explicit path: write the embed field first (for example 'value.gameObj.{txt}').", ""
        # `-1`: ya se diagnosticó; el llamador no debe emitir E0004 encima.
        return -1
    if r != embeds.ROUTE_FOUND:
        return 0
    return calling embeds.field_type_via with s->types, ty, nid, (sigil of path)

## Tipo de un campo de una runa/echo; error si no existe.
##
## ## Memoria
## O(campos).
weave field_type with s as ref to state.SemaState, type_id as int, name as string into int:
    var type_id2 as int is calling underlying_type with s, type_id
    var ty as tk.SemaType is calling types.at with s->types, type_id2
    if name == "len" or name == "length":
        if ty.kind == tk.SemaTypeKind.TkList or ty.kind == tk.SemaTypeKind.TkMap or ty.kind == tk.SemaTypeKind.TkArray or ty.kind == tk.SemaTypeKind.TkSlice or ty.kind == tk.SemaTypeKind.TkMaybe or ty.kind == tk.SemaTypeKind.TkResult:
            return calling types.base with s->types, "int"
        if ty.kind == tk.SemaTypeKind.TkBase and (calling compat.is_string with s->types, type_id):
            return calling types.base with s->types, "int"
    if ty.kind == tk.SemaTypeKind.TkAny:
        return 1
    if ty.kind == tk.SemaTypeKind.TkOmen:
        var oi as types.SemaNominalInfo is (s->types->nominal_infos at ty.a)
        var onid as int is calling npool.find with s->names, name
        if onid >= 0:
            var vi as int is 0
            while vi < oi.variants_count:
                var vv as types.SemaVariant is (s->types->variants at (oi.variants_first + vi))
                if vv.name == onid:
                    return type_id
                set vi is vi + 1
        return 0
    if ty.kind == tk.SemaTypeKind.TkMaybe:
        if name == "is_present":
            return calling types.base with s->types, "bool"
        if name == "value":
            return ty.a
        return 0
    if ty.kind == tk.SemaTypeKind.TkResult:
        if name == "is_ok" or name == "is_err":
            return calling types.base with s->types, "bool"
        if name == "value":
            return ty.a
        if name == "error":
            return ty.b
        return 0
    if ty.kind != tk.SemaTypeKind.TkRune and ty.kind != tk.SemaTypeKind.TkEcho:
        return 0
    var info as types.SemaNominalInfo is (s->types->nominal_infos at ty.a)
    var nid as int is calling npool.find with s->names, name
    if nid < 0:
        return 0
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (s->types->fields at (info.fields_first + i))
        if f.name == nid:
            return f.type
        set i is i + 1
    return 0

## Acceso `at`.
##
## ## Memoria
## O(1).
weave infer_at with s as ref to state.SemaState, node as int into int:
    var base as int is calling astutil.node_child with s->ast, node, 0
    var bt as int is calling infer with s, base, -1
    var bty as tk.SemaType is calling types.at with s->types, bt
    if bty.kind == tk.SemaTypeKind.TkAlias or bty.kind == tk.SemaTypeKind.TkSeal:
        set bt is calling underlying_type with s, bt
        set bty is calling types.at with s->types, bt
    if bty.kind == tk.SemaTypeKind.TkRef:
        var pointee as int is bty.a
        var pty as tk.SemaType is calling types.at with s->types, pointee
        if pty.kind == tk.SemaTypeKind.TkList or pty.kind == tk.SemaTypeKind.TkArray or pty.kind == tk.SemaTypeKind.TkSlice or pty.kind == tk.SemaTypeKind.TkMap:
            set bt is pointee
        else:
            if pty.kind == tk.SemaTypeKind.TkFrozen:
                return pty.a
            return pointee
    var btk as tk.SemaType is calling types.at with s->types, bt
    var et as int is calling compat.element_type with s->types, bt
    if btk.kind == tk.SemaTypeKind.TkMap:
        set et is btk.b
    if et < 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "type is not indexable", "Use a list, map, slice, array or string.", ""
        return 0
    return et

## Cast `(expr to T)`.
##
## ## Memoria
## Convierte el nodo tipo.
weave infer_to with s as ref to state.SemaState, node as int into int:
    var left as int is calling astutil.node_child with s->ast, node, 0
    var rt as int is calling astutil.node_child with s->ast, node, 1
    var ctx as convert.TypeCtx is with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast
    var target as int is calling convert.convert with (sigil of ctx), rt
    var got as int is calling infer with s, left, target
    if not calling compat.can_cast with s->types, got, target:
        calling type_mismatch with s, left, target, got
    return target

## Lista vacía o de tipo homogéneo.
##
## ## Memoria
## O(n).
weave infer_list_lit with s as ref to state.SemaState, node as int, expected as int into int:
    var elem as int is 0
    if expected >= 0:
        var e as tk.SemaType is calling types.at with s->types, expected
        if e.kind == tk.SemaTypeKind.TkList:
            set elem is e.a
        else if e.kind == tk.SemaTypeKind.TkSlice:
            set elem is e.a
        else if e.kind == tk.SemaTypeKind.TkArray:
            set elem is e.a
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var c as int is calling astutil.node_child with s->ast, node, i
        if c >= 0:
            var got as int is calling infer with s, c, elem
            if elem <= 0:
                set elem is got
        set i is i + 1
    if elem <= 0:
        set elem is calling types.base with s->types, "int"
    if expected >= 0:
        var e2 as tk.SemaType is calling types.at with s->types, expected
        if e2.kind == tk.SemaTypeKind.TkArray:
            return expected
    return calling types.list_of with s->types, elem

## Constructor `list of T`.
##
## ## Memoria
## Convierte el tipo y devuelve `list of T`.
weave infer_list_init with s as ref to state.SemaState, node as int, expected as int into int:
    var tnode as int is calling astutil.node_child with s->ast, node, 0
    var ctx as convert.TypeCtx is with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast
    var elem as int is calling convert.convert with (sigil of ctx), tnode
    return calling types.list_of with s->types, elem

## Constructor `map of K to V`.
##
## ## Memoria
## Convierte ambos tipos.
weave infer_map_init with s as ref to state.SemaState, node as int, expected as int into int:
    var ctx as convert.TypeCtx is with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast
    var k as int is calling convert.convert with (sigil of ctx), (calling astutil.node_child with s->ast, node, 0)
    var v as int is calling convert.convert with (sigil of ctx), (calling astutil.node_child with s->ast, node, 1)
    return calling types.map_of with s->types, k, v

## Constructor `array of T with size N`.
##
## ## Memoria
## Convierte el tipo y el tamaño constante.
weave infer_array_init with s as ref to state.SemaState, node as int, expected as int into int:
    var ctx as convert.TypeCtx is with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast
    var elem as int is calling convert.convert with (sigil of ctx), (calling astutil.node_child with s->ast, node, 0)
    return calling types.array_of with s->types, elem, -1

## Literal de mapa.
##
## ## Memoria
## Infiere claves/valores; vacío usa el expected.
weave infer_map_lit with s as ref to state.SemaState, node as int, expected as int into int:
    var kt as int is 0
    var vt as int is 0
    if expected <= 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MAP_LITERAL_TYPE, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "map literal needs a type annotation", "Write 'var m as map of string to int is {{ … }}'.", ""
        return 0
    var e as tk.SemaType is calling types.at with s->types, expected
    if e.kind == tk.SemaTypeKind.TkMap:
        set kt is e.a
        set vt is e.b
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var entry as int is calling astutil.node_child with s->ast, node, i
        if entry >= 0:
            var k as int is calling infer with s, (calling astutil.node_child with s->ast, entry, 0), kt
            var v as int is calling infer with s, (calling astutil.node_child with s->ast, entry, 1), vt
            if kt <= 0:
                set kt is k
            if vt <= 0:
                set vt is v
        set i is i + 1
    if kt <= 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MAP_LITERAL_TYPE, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "map literal needs a type annotation", "Write 'var m as map of string to int is {{ … }}'.", ""
        return 0
    if vt <= 0:
        set vt is calling types.base with s->types, "int"
    return calling types.map_of with s->types, kt, vt

## Inicialización de runa `Point with x is 1`.
##
## ## Memoria
## O(campos).
weave infer_struct_init with s as ref to state.SemaState, node as int into int:
    var nm as int is calling astutil.token_child with s->ast, node, 0
    if nm < 0:
        return 0
    var txt as string is calling astutil.token_text with s->src, s->lex, nm
    defer banish txt
    var ty as int is calling symbols.lookup_type_name with s->symbols, txt
    if ty < 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "undefined type '{txt}'", "Check the rune name.", ""
        return 0
    return ty

## Índice del campo `nid` en un rune/echo (0-based), o `-1`.
##
## ## Memoria
## No asigna.
weave nominal_field_index with s as ref to state.SemaState, ty as int, nid as int into int:
    var t2 as int is calling underlying_type with s, ty
    var tyy as tk.SemaType is calling types.at with s->types, t2
    if tyy.kind != tk.SemaTypeKind.TkRune and tyy.kind != tk.SemaTypeKind.TkEcho:
        return -1
    var info as types.SemaNominalInfo is (s->types->nominal_infos at tyy.a)
    var j as int is 0
    while j < info.fields_count:
        var f as types.SemaField is (s->types->fields at (info.fields_first + j))
        if f.name == nid:
            return j
        set j is j + 1
    return -1

## `true` si `ty` es un rune/echo con campos declarados (no omen, genérico,
## alias, seal ni primitivo).
##
## ## Memoria
## No asigna.
weave has_nominal_fields with s as ref to state.SemaState, ty as int into bool:
    var t2 as int is calling underlying_type with s, ty
    var tyy as tk.SemaType is calling types.at with s->types, t2
    if tyy.kind != tk.SemaTypeKind.TkRune and tyy.kind != tk.SemaTypeKind.TkEcho:
        return false
    var info as types.SemaNominalInfo is (s->types->nominal_infos at tyy.a)
    return info.fields_count > 0

## Infiere los valores de `with campo is expr, ...`.
##
## `infer_struct_init` solo resuelve el tipo nominal; sin esto el valor de cada
## campo queda sin anotar y una lambda dentro de un `with` no recibe firma. El
## tipo del campo se pasa como tipo esperado para conservar el contexto de
## `maybe`/`result` (`with data is maybe none`).
##
## ## Memoria
## O(campos); reutiliza el estado de inferencia.
weave infer_field_inits with s as ref to state.SemaState, node as int, ty as int into void:
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    var check_fields as bool is false
    var rune_name as string is ""
    var seen as map of int to bool is map of int to bool
    defer banish seen
    if ty > 0 and (calling has_nominal_fields with s, ty):
        set check_fields is true
        var t3 as int is calling underlying_type with s, ty
        var ty3 as tk.SemaType is calling types.at with s->types, t3
        var inf3 as types.SemaNominalInfo is (s->types->nominal_infos at ty3.a)
        set rune_name is calling npool.copy_string with (calling npool.text with s->names, inf3.base_name)
    defer banish rune_name
    while i < n:
        var fi as int is calling astutil.node_child with s->ast, node, i
        if fi >= 0 and (calling astutil.kind_of with s->ast, fi) == pskind.NodeKind.NdFieldInit:
            var expected as int is -1
            var nm as int is calling astutil.token_child with s->ast, fi, 0
            if nm >= 0 and ty > 0:
                var txt as string is calling astutil.token_text with s->src, s->lex, nm
                var txt_owned as bool is true
                var ft as int is calling field_type with s, ty, txt
                if ft > 0:
                    set expected is ft
                if check_fields:
                    # Campo: debe existir en el rune y no repetirse. La coma de un
                    # `with` anidado liga al `with` más interno, así que un campo
                    # que "falta" suele ser el síntoma de ese anidamiento.
                    var nid as int is calling npool.find with s->names, txt
                    if nid < 0 or (calling nominal_field_index with s, ty, nid) < 0:
                        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, fi), (calling astutil.end_of with s->ast, fi), "rune '{rune_name}' has no field '{txt}'", "Check the field name. Nested `with` initializers must be parenthesized: `field is (with ...)`.", ""
                        banish txt
                        set txt_owned is false
                    else if (calling seen.has with nid):
                        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, fi), (calling astutil.end_of with s->ast, fi), "field '{txt}' is initialized twice in this `with`", "Remove one of the two initializers.", ""
                        banish txt
                        set txt_owned is false
                    else:
                        calling seen.put with nid, true
                if txt_owned:
                    banish txt
            var ci as int is 0
            var cn as int is calling astutil.child_count with s->ast, fi
            var val as int is -1
            while ci < cn:
                var c as int is calling astutil.node_child with s->ast, fi, ci
                if c >= 0:
                    set val is c
                set ci is ci + 1
            if val >= 0:
                var ignored as int is calling infer with s, val, expected
        set i is i + 1

## `do:` como expresión de bloque.
##
## ## Memoria
## Recorre statements; devuelve el tipo del último valor.
weave infer_do with s as ref to state.SemaState, node as int, expected as int into int:
    var n as int is calling astutil.child_count with s->ast, node
    var i as int is 0
    var last as int is -1
    while i < n:
        var c as int is calling astutil.node_child with s->ast, node, i
        if c >= 0:
            set last is c
            if i < n - 1:
                calling state.call_stmt with s, c
        set i is i + 1
    if last < 0:
        return expected
    var lk as pskind.NodeKind is calling astutil.kind_of with s->ast, last
    if lk == pskind.NodeKind.NdStmt:
        var inner as int is calling astutil.node_child with s->ast, last, 0
        if inner >= 0 and (calling astutil.kind_of with s->ast, inner) == pskind.NodeKind.NdExprStmt:
            return calling infer with s, (calling astutil.node_child with s->ast, inner, 0), expected
        calling state.call_stmt with s, last
        return expected
    return calling infer with s, last, expected

## Literal `error` dentro de un bloque `or:`.
##
## El símbolo lo define `infer_or` al entrar en el bloque; fuera de él no
## existe y se diagnostica. Para `maybe T` el payload es `string`; para
## `result of T to E` es `E`.
##
## ## Memoria
## O(profundidad de scopes); puede emitir E0015.
weave infer_error_lit with s as ref to state.SemaState, node as int into int:
    var sid as int is calling symbols.lookup_name with s->symbols, "error"
    if sid >= 0:
        var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
        if sv.kind == sym.SemaSymbolKind.SkLet:
            calling ann.ann_set_symbol with s->annotations, node, sid
            return sv.type
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_ARRAY_UNKNOWN, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "'error' is only available inside an 'or:' block", "Bind the maybe/result with an 'or:' block to inspect the failure payload.", ""
    return 0

## `or else`/`or return`/`or:`.
##
## ## Memoria
## Infiere el lado izquierdo y, si es maybe/result, devuelve su valor. Los
## cuerpos de `or:` se comprueban statement a statement con `error` en scope.
weave infer_or with s as ref to state.SemaState, node as int, expected as int into int:
    var left as int is calling astutil.node_child with s->ast, node, 0
    var lt as int is calling infer with s, left, -1
    var lty as tk.SemaType is calling types.at with s->types, lt
    var inner as int is lt
    if lty.kind == tk.SemaTypeKind.TkMaybe:
        set inner is lty.a
    else if lty.kind == tk.SemaTypeKind.TkResult:
        set inner is lty.a
    if (calling astutil.kind_of with s->ast, node) == pskind.NodeKind.NdOrBlock:
        # `or:` guarda los statements como hijos hermanos: [left, stmt, stmt, …].
        var start as int is calling astutil.start_of with s->ast, node
        var end as int is calling astutil.end_of with s->ast, node
        var sc as int is calling symbols.push_scope with s->symbols, scope.SemaScopeKind.SgOrBlock, start, end
        calling symbols.mark_or_block with s->symbols, sc
        var et as int is calling types.base with s->types, "string"
        if lty.kind == tk.SemaTypeKind.TkResult and lty.b > 0:
            set et is lty.b
        var nid as int is calling npool.intern with s->names, "error"
        var sv as sym.SemaSymbol is calling symbols.make_symbol with s->names, "", et, sym.SemaSymbolKind.SkLet
        set sv.name is nid
        set sv.c_name is nid
        calling symbols.symbol_define with s->symbols, sv
        var n as int is calling astutil.child_count with s->ast, node
        var i as int is 1
        while i < n:
            var c as int is calling astutil.node_child with s->ast, node, i
            if c >= 0:
                calling state.call_stmt with s, c
            set i is i + 1
        calling symbols.pop_scope with s->symbols, end
        return inner
    var right as int is calling astutil.node_child with s->ast, node, 1
    if right >= 0:
        var rt as int is calling infer with s, right, inner
        if not calling compat.compatible with s->types, rt, inner:
            calling type_mismatch with s, right, inner, rt
        return rt
    return inner

## `for x in col then expr` como expresión de lista.
##
## ## Memoria
## Entra/sale de un scope; devuelve `list of T`.
weave infer_for_comp with s as ref to state.SemaState, node as int into int:
    var nm as int is calling astutil.token_child with s->ast, node, 0
    var coll as int is calling astutil.node_child with s->ast, node, 1
    var body as int is calling astutil.node_child with s->ast, node, 3
    var ct as int is calling infer with s, coll, -1
    var et as int is calling compat.element_type with s->types, ct
    var start as int is calling astutil.start_of with s->ast, node
    var end as int is calling astutil.end_of with s->ast, node
    calling symbols.push_scope with s->symbols, scope.SemaScopeKind.SgFor, start, end
    if nm >= 0:
        var txt as string is calling astutil.token_text with s->src, s->lex, nm
        defer banish txt
        var nid as int is calling npool.intern with s->names, txt
        var sv as sym.SemaSymbol is calling symbols.make_symbol with s->names, "", et, sym.SemaSymbolKind.SkLet
        set sv.name is nid
        set sv.c_name is nid
        calling symbols.symbol_define with s->symbols, sv
    var bt as int is calling infer with s, body, -1
    calling symbols.pop_scope with s->symbols, end
    return calling types.list_of with s->types, bt

## `if`/`when` como expresión.
##
## ## Memoria
## Infiere condición y ramas; no asigna.
weave infer_if_expr with s as ref to state.SemaState, node as int, expected as int into int:
    var cond as int is calling astutil.node_child with s->ast, node, 0
    var then_node as int is calling astutil.node_child with s->ast, node, 1
    var else_node as int is calling astutil.node_child with s->ast, node, 2
    if cond >= 0:
        var c as int is calling infer with s, cond, -1
        if (calling astutil.kind_of with s->ast, node) == pskind.NodeKind.NdIfExpr and not (calling compat.is_bool with s->types, c):
            calling type_mismatch with s, cond, 3, c
    var t1 as int is calling infer with s, then_node, expected
    var t2 as int is 0
    if else_node >= 0:
        set t2 is calling infer with s, else_node, expected
    if t2 <= 0:
        return t1
    if calling compat.compatible with s->types, t1, t2:
        return t1
    if calling compat.compatible with s->types, t2, t1:
        return t2
    calling type_mismatch with s, else_node, t1, t2
    return t1

## Operadores booleanos.
##
## ## Memoria
## O(1).
weave infer_bool with s as ref to state.SemaState, node as int into int:
    var l as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), -1
    var r as int is calling infer with s, (calling astutil.node_child with s->ast, node, 1), -1
    if not (calling compat.is_bool with s->types, l):
        calling type_mismatch with s, (calling astutil.node_child with s->ast, node, 0), 3, l
    if not (calling compat.is_bool with s->types, r):
        calling type_mismatch with s, (calling astutil.node_child with s->ast, node, 1), 3, r
    return calling types.base with s->types, "bool"

## Comparaciones.
##
## ## Memoria
## O(1).
weave infer_compare with s as ref to state.SemaState, node as int into int:
    var l as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), -1
    var r as int is calling infer with s, (calling astutil.node_child with s->ast, node, 1), -1
    var lt as tk.SemaType is calling types.at with s->types, l
    var rt as tk.SemaType is calling types.at with s->types, r
    if lt.kind == tk.SemaTypeKind.TkTypeParam or rt.kind == tk.SemaTypeKind.TkTypeParam:
        var cop as string is "eq"
        var ck as pskind.NodeKind is calling astutil.kind_of with s->ast, node
        if ck == pskind.NodeKind.NdNe:
            set cop is "ne"
        else if ck == pskind.NodeKind.NdLt:
            set cop is "lt"
        else if ck == pskind.NodeKind.NdLe:
            set cop is "le"
        else if ck == pskind.NodeKind.NdGt:
            set cop is "gt"
        else if ck == pskind.NodeKind.NdGe:
            set cop is "ge"
        if not (calling bound_operator_ok with s, cop):
            calling operator_bound_error with s, node, cop
    if (not (calling compat.compatible with s->types, l, r)) and (not (calling compat.compatible with s->types, r, l)):
        calling type_mismatch with s, node, l, r
    return calling types.base with s->types, "bool"

## `true` si el nodo es `self` en un método con receptor por valor.
##
## ## Memoria
## O(1).
weave is_self_value with s as ref to state.SemaState, node as int into bool:
    if node < 0:
        return false
    var nk as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    if nk != pskind.NodeKind.NdVarRef and nk != pskind.NodeKind.NdSelfRef:
        return false
    var txt as string is "self"
    if nk == pskind.NodeKind.NdVarRef:
        set txt is calling astutil.first_token_text with s->src, s->lex, s->ast, node
    defer banish txt
    if txt != "self":
        return false
    var sid as int is calling symbols.lookup_name with s->symbols, txt
    if sid < 0:
        return false
    var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
    return (sv.flags & sym.SYM_SELF_VALUE) != 0

## Clasifica la addressability de una expresión para `sigil of`.
##
## Devuelve 0 si no es lvalue, 1 si es mutable, 2 si es de solo lectura
## (`let`) y 3 si es una constante (error E0008).
##
## ## Memoria
## O(profundidad del acceso).
weave sigil_status with s as ref to state.SemaState, node as int into int:
    if node < 0:
        return 0
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    if k == pskind.NodeKind.NdSelfRef:
        var ssid as int is calling symbols.lookup_name with s->symbols, "self"
        if ssid < 0:
            return 0
        var ssv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, ssid
        if (ssv.flags & sym.SYM_SELF_VALUE) != 0:
            return 2
        return 1
    if k == pskind.NodeKind.NdVarRef:
        var txt as string is calling astutil.first_token_text with s->src, s->lex, s->ast, node
        defer banish txt
        var sid as int is calling symbols.lookup_name with s->symbols, txt
        if sid < 0:
            return 0
        var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
        if sv.kind == sym.SemaSymbolKind.SkConst:
            return 3
        if sv.kind == sym.SemaSymbolKind.SkWeave or sv.kind == sym.SemaSymbolKind.SkDeclare:
            return 1
        if (sv.flags & sym.SYM_SELF_VALUE) != 0:
            return 2
        if sv.kind == sym.SemaSymbolKind.SkLet:
            return 2
        if sv.kind == sym.SemaSymbolKind.SkParam:
            return 1
        if sv.kind == sym.SemaSymbolKind.SkVar or sv.kind == sym.SemaSymbolKind.SkStaticVar:
            if (sv.flags & sym.SYM_MUTABLE) != 0:
                return 1
            return 2
        return 0
    if k == pskind.NodeKind.NdParenExpr:
        return calling sigil_status with s, (calling astutil.node_child with s->ast, node, 0)
    if k == pskind.NodeKind.NdFieldAccess:
        var fty as int is calling infer with s, node, -1
        if fty > 0:
            if calling types.is_frozen with s->types, fty:
                return 2
            var fuid as int is calling types.underlying with s->types, fty
            var ft as tk.SemaType is calling types.at with s->types, fuid
            if ft.kind == tk.SemaTypeKind.TkFn:
                return 1
        return 1
    if k == pskind.NodeKind.NdArrowAccess:
        return 1
    if k == pskind.NodeKind.NdAtExpr:
        var bnode as int is calling astutil.node_child with s->ast, node, 0
        if bnode < 0:
            return 0
        var bty as int is calling infer with s, bnode, -1
        var buid as int is calling types.underlying with s->types, bty
        var bt as tk.SemaType is calling types.at with s->types, buid
        if bt.kind != tk.SemaTypeKind.TkArray and bt.kind != tk.SemaTypeKind.TkRef and bt.kind != tk.SemaTypeKind.TkList and bt.kind != tk.SemaTypeKind.TkSlice:
            return 0
        var ety as int is calling infer with s, node, -1
        if calling types.is_frozen with s->types, ety:
            return 2
        return 1
    if k == pskind.NodeKind.NdEssenceOf:
        return 1
    return 0

## Error E0008: `sigil of` sobre algo que no es un lvalue.
##
## ## Memoria
## O(1).
weave sigil_lvalue_error with s as ref to state.SemaState, node as int into void:
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "cannot take the address of this expression", "Take a ref of a variable, field, array element or dereferenced pointer.", "'sigil of' needs an addressable location."

## Error E0008: `sigil of` sobre una constante.
##
## ## Memoria
## O(1).
weave sigil_const_error with s as ref to state.SemaState, node as int into void:
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MEMORY_OP, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "cannot take the address of a constant", "Copy it into a local 'var' first.", "Constants are immutable and may not live in memory."

## Error E0005: `essence of` sobre un valor que no es `ref to T`.
##
## ## Memoria
## O(1).
weave essence_error with s as ref to state.SemaState, node as int, got as int into void:
    var gid as int is calling canon.canonical_name with s->types, got
    var gn as string is calling npool.text with s->names, gid
    var msg as string is "cannot dereference value of type '{gn}'; 'essence of' requires a ref"
    defer banish msg
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), msg, "Take a ref with 'sigil of' or use a pointer parameter.", ""

## ¿El pointee es `void` (no permite aritmética escalada)?
##
## ## Memoria
## O(1).
weave void_pointee with s as ref to state.SemaState, tid as int into bool:
    if tid <= 0:
        return false
    var uid as int is calling types.underlying with s->types, tid
    var t as tk.SemaType is calling types.at with s->types, uid
    if t.kind == tk.SemaTypeKind.TkVoid or t.kind == tk.SemaTypeKind.TkOpaque:
        return true
    if t.kind != tk.SemaTypeKind.TkBase:
        return false
    var ntxt as string is calling npool.text with s->names, t.name
    return ntxt == "void"

## Aritmética.
##
## ## Memoria
## O(1).
weave infer_arith with s as ref to state.SemaState, node as int into int:
    var l as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), -1
    var r as int is calling infer with s, (calling astutil.node_child with s->ast, node, 1), -1
    var lt as tk.SemaType is calling types.at with s->types, l
    var rt as tk.SemaType is calling types.at with s->types, r
    if lt.kind == tk.SemaTypeKind.TkTypeParam or rt.kind == tk.SemaTypeKind.TkTypeParam:
        var op as string is "add"
        var ak as pskind.NodeKind is calling astutil.kind_of with s->ast, node
        if ak == pskind.NodeKind.NdSub:
            set op is "sub"
        else if ak == pskind.NodeKind.NdMul:
            set op is "mul"
        else if ak == pskind.NodeKind.NdDiv:
            set op is "div"
        else if ak == pskind.NodeKind.NdMod:
            set op is "mod"
        if not (calling bound_operator_ok with s, op):
            calling operator_bound_error with s, node, op
        return l
    var ak2 as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    var luid as int is calling types.underlying with s->types, l
    var ruid as int is calling types.underlying with s->types, r
    var lty2 as tk.SemaType is calling types.at with s->types, luid
    var rty2 as tk.SemaType is calling types.at with s->types, ruid
    if lty2.kind == tk.SemaTypeKind.TkRef or rty2.kind == tk.SemaTypeKind.TkRef:
        if ak2 == pskind.NodeKind.NdAdd or ak2 == pskind.NodeKind.NdSub:
            if lty2.kind == tk.SemaTypeKind.TkRef and calling compat.is_int with s->types, r:
                if calling void_pointee with s, lty2.a:
                    calling type_mismatch with s, node, l, r
                    return 0
                return l
            if ak2 == pskind.NodeKind.NdAdd and rty2.kind == tk.SemaTypeKind.TkRef and calling compat.is_int with s->types, l:
                if calling void_pointee with s, rty2.a:
                    calling type_mismatch with s, node, l, r
                    return 0
                return r
            if ak2 == pskind.NodeKind.NdSub and lty2.kind == tk.SemaTypeKind.TkRef and rty2.kind == tk.SemaTypeKind.TkRef:
                if calling compat.compatible with s->types, lty2.a, rty2.a:
                    return calling types.base with s->types, "isize"
        calling type_mismatch with s, node, l, r
        return 0
    if l == r or lt.kind == tk.SemaTypeKind.TkAny or rt.kind == tk.SemaTypeKind.TkAny or lt.kind == tk.SemaTypeKind.TkOpaque or rt.kind == tk.SemaTypeKind.TkOpaque:
        return l
    if (not (calling compat.is_numeric with s->types, l)) or (not (calling compat.is_numeric with s->types, r)):
        calling type_mismatch with s, node, l, r
        return 0
    if (calling compat.is_float with s->types, l) or (calling compat.is_float with s->types, r):
        return calling types.base with s->types, "float"
    return l

## Bitwise/shifts.
##
## ## Memoria
## O(1).
weave infer_bit with s as ref to state.SemaState, node as int into int:
    var l as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), -1
    var r as int is calling infer with s, (calling astutil.node_child with s->ast, node, 1), -1
    var lt2 as tk.SemaType is calling types.at with s->types, l
    var rt2 as tk.SemaType is calling types.at with s->types, r
    if lt2.kind == tk.SemaTypeKind.TkTypeParam or rt2.kind == tk.SemaTypeKind.TkTypeParam:
        var bop as string is "band"
        var bk as pskind.NodeKind is calling astutil.kind_of with s->ast, node
        if bk == pskind.NodeKind.NdBitwiseOr:
            set bop is "bor"
        else if bk == pskind.NodeKind.NdBitwiseXor:
            set bop is "bxor"
        else if bk == pskind.NodeKind.NdShl:
            set bop is "shl"
        else if bk == pskind.NodeKind.NdShr:
            set bop is "shr"
        if not (calling bound_operator_ok with s, bop):
            calling operator_bound_error with s, node, bop
        return l
    if (not (calling compat.is_int with s->types, l)) or (not (calling compat.is_int with s->types, r)):
        calling type_mismatch with s, node, l, r
        return 0
    return l

## Unarios.
##
## ## Memoria
## O(1).
weave infer_unary with s as ref to state.SemaState, node as int into int:
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    var inner as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), -1
    if k == pskind.NodeKind.NdLogNot:
        return calling types.base with s->types, "bool"
    if k == pskind.NodeKind.NdBitNot:
        return inner
    return inner

## Rangos.
##
## ## Memoria
## O(1).
weave infer_range with s as ref to state.SemaState, node as int into int:
    var l as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), -1
    var r as int is calling infer with s, (calling astutil.node_child with s->ast, node, 1), -1
    return calling types.range_of with s->types, l

## `sigil of`/`essence of`.
##
## ## Memoria
## O(1).
weave infer_pointer with s as ref to state.SemaState, node as int into int:
    var inner as int is calling infer with s, (calling astutil.node_child with s->ast, node, 0), -1
    return calling types.ref_to with s->types, inner

## Emite un mismatch con tipos canónicos.
##
## ## Memoria
## Construye dos strings temporales y los libera.
weave type_mismatch with s as ref to state.SemaState, node as int, expected as int, got as int into void:
    if expected <= 0 or got <= 0:
        return
    var et0 as tk.SemaType is calling types.at with s->types, expected
    var gt0 as tk.SemaType is calling types.at with s->types, got
    if et0.kind == tk.SemaTypeKind.TkFn or gt0.kind == tk.SemaTypeKind.TkFn or et0.kind == tk.SemaTypeKind.TkAny or gt0.kind == tk.SemaTypeKind.TkAny or et0.kind == tk.SemaTypeKind.TkTypeParam or gt0.kind == tk.SemaTypeKind.TkTypeParam:
        return
    var eid as int is calling canon.canonical_name with s->types, expected
    var gid as int is calling canon.canonical_name with s->types, got
    var en as string is calling npool.text with s->names, eid
    var gn as string is calling npool.text with s->names, gid
    var msg as string is "type mismatch: expected '{en}', got '{gn}'"
    defer banish msg
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), msg, "Ensure the value type matches the expected type or use an explicit 'to' cast.", "PenguScript requires type safety and explicit conversions."

## Resuelve una referencia o un alias hasta el tipo subyacente (máx. 32
## saltos). Se usa para llamar funciones guardadas en un alias, p. ej.
## `alias Handler as weave with context as ref to Context into result of void to HttpError`.
##
## ## Memoria
## O(1); no asigna.
weave resolve_callable with t as ref to types.SemaTypeTable, id as int into int:
    var cur as int is id
    var guard as int is 0
    while guard < 32:
        var ty as tk.SemaType is calling types.at with t, cur
        if ty.kind == tk.SemaTypeKind.TkRef:
            set cur is ty.a
        else if ty.kind == tk.SemaTypeKind.TkAlias:
            set cur is ty.b
        else:
            return cur
        set guard is guard + 1
    return cur

## Llama al puntero a función guardado en el campo `name` del receptor.
##
## Devuelve el tipo de retorno, o `-1` si el campo no existe o no es una
## función (`calling route.handler with context`).
##
## ## Memoria
## O(1); no asigna.
weave call_fn_field with s as ref to state.SemaState, recv_ty as int, name as string, args as int into int:
    var rcur as int is calling underlying_type with s, recv_ty
    var rty as tk.SemaType is calling types.at with s->types, rcur
    var rguard as int is 0
    while rguard < 8 and (rty.kind == tk.SemaTypeKind.TkRef or rty.kind == tk.SemaTypeKind.TkFrozen):
        set rcur is rty.a
        set rty is calling types.at with s->types, rcur
        set rguard is rguard + 1
    var fty as int is calling field_type with s, rcur, name
    if fty <= 0:
        return -1
    var fcur as int is calling underlying_type with s, fty
    var fty0 as tk.SemaType is calling types.at with s->types, fcur
    var fguard as int is 0
    while fguard < 8 and (fty0.kind == tk.SemaTypeKind.TkRef or fty0.kind == tk.SemaTypeKind.TkFrozen):
        set fcur is fty0.a
        set fty0 is calling types.at with s->types, fcur
        set fguard is fguard + 1
    if fty0.kind != tk.SemaTypeKind.TkFn:
        return -1
    var info as types.SemaFnInfo is (s->types->fn_infos at fty0.a)
    if args >= 0:
        var n as int is calling astutil.child_count with s->ast, args
        var i as int is 0
        while i < n:
            var arg as int is calling astutil.node_child with s->ast, args, i
            if arg >= 0:
                var vnode as int is arg
                if (calling astutil.kind_of with s->ast, arg) == pskind.NodeKind.NdNamedArg:
                    set vnode is calling astutil.node_child with s->ast, arg, 1
                if vnode >= 0:
                    if i < info.params_count:
                        var p as types.SemaFnParam is (s->types->fn_params at (info.params_first + i))
                        var got as int is calling infer with s, vnode, p.type
                        if not calling compat.compatible with s->types, got, p.type:
                            calling type_mismatch with s, vnode, p.type, got
                    else:
                        var ignored as int is calling infer with s, vnode, -1
            set i is i + 1
    return info.return_type
