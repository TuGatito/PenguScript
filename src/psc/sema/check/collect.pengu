## psc/sema/check/collect.pengu — recolección de declaraciones top-level.
##
## Pass 1 de F3: registra imports/insignia/includes, tipos, firmas, consts y
## tests. Los cuerpos se validan en `body.pengu`. El collector no infiere
## expresiones salvo los valores de `const` y los tipos declarados.
##
## ## Memoria
## Presta `SemaState`; los símbolos/tipos viven en las tablas del programa.

import std.builder

import psc.ast.kind as pskind
import psc.ast.node as psast
import psc.token as pstoken

import psc.sema.names as npool
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.types.convert as convert
import psc.sema.symbols.symbol as sym
import psc.sema.symbols.scope as scope
import psc.sema.state as state
import psc.sema.modules.program as program
import psc.sema.modules.loader as loader
import psc.sema.ast as astutil
import psc.sema.infer.core as infer
import psc.sema.check.body as body
import psc.sema.diagnostics as sdiag
import psc.sema.modules.resolver as resolver
import std.compass

insignia sema_collect_

## Rango de parámetros recién añadidos.
##
## ## Memoria
## POD.
rune ParamRange:
    ## Primer índice en `fn_params`.
    first as int
    ## Número de parámetros.
    count as int

## Recorre el archivo y recolecta las declaraciones.
##
## ## Memoria
## Puede emitir diagnósticos; no posee listas.
weave collect_module with s as ref to state.SemaState into void:
    calling predeclare_types with s
    # El root de F2 es `start`; su hijo 0 es `file`.
    var file as int is calling astutil.node_child with s->ast, s->module->parse.root, 0
    if file < 0:
        set file is 0
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, file
    while i < n:
        var top as int is calling astutil.node_child with s->ast, file, i
        if top >= 0:
            calling collect_top with s, top
        set i is i + 1

## Predeclara nombres de tipos para permitir referencias hacia delante.
##
## ## Memoria
## Añade tipos al registro y `module->type_ids`.
weave predeclare_types with s as ref to state.SemaState into void:
    var file as int is calling astutil.node_child with s->ast, s->module->parse.root, 0
    if file < 0:
        return
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, file
    while i < n:
        var top as int is calling astutil.node_child with s->ast, file, i
        if top >= 0:
            var stmt as int is top
            if (calling astutil.kind_of with s->ast, stmt) == pskind.NodeKind.NdTopStmt:
                set stmt is calling astutil.node_child with s->ast, stmt, 0
            if stmt >= 0:
                var k as pskind.NodeKind is calling astutil.kind_of with s->ast, stmt
                if k == pskind.NodeKind.NdRuneDecl or k == pskind.NodeKind.NdEchoDecl or k == pskind.NodeKind.NdOmenDecl or k == pskind.NodeKind.NdConceptDecl:
                    var nm as int is calling decl_name with s, stmt
                    var nk as tk.SemaNominalKind is tk.SemaNominalKind.NkRune
                    var sk as sym.SemaSymbolKind is sym.SemaSymbolKind.SkRune
                    if k == pskind.NodeKind.NdEchoDecl:
                        set nk is tk.SemaNominalKind.NkEcho
                        set sk is sym.SemaSymbolKind.SkEcho
                    else if k == pskind.NodeKind.NdOmenDecl:
                        set nk is tk.SemaNominalKind.NkOmen
                        set sk is sym.SemaSymbolKind.SkOmen
                    else if k == pskind.NodeKind.NdConceptDecl:
                        set nk is tk.SemaNominalKind.NkConcept
                        set sk is sym.SemaSymbolKind.SkConcept
                    if nm >= 0 and not (calling s->module->type_ids.has with stmt):
                        var ty as int is calling new_nominal with s, nk, nm, nm, true
                        calling register_type with s, sk, nm, ty, stmt
                        calling s->module->type_ids.put with stmt, ty
        set i is i + 1

## Recolecta un `top_stmt` (o un `stmt`/declaración directa).
##
## ## Memoria
## Puede emitir diagnósticos.
weave collect_top with s as ref to state.SemaState, node as int into void:
    var n as int is node
    var guard as int is 0
    while guard < 8:
        var k as pskind.NodeKind is calling astutil.kind_of with s->ast, n
        if k == pskind.NodeKind.NdTopStmt or k == pskind.NodeKind.NdStmt:
            var c as int is calling astutil.node_child with s->ast, n, 0
            if c < 0:
                return
            set n is c
            set guard is guard + 1
        else:
            set guard is 8
    var kind as pskind.NodeKind is calling astutil.kind_of with s->ast, n
    if kind == pskind.NodeKind.NdImportStmt:
        calling collect_import with s, n
        return
    if kind == pskind.NodeKind.NdIncludeStmt or kind == pskind.NodeKind.NdLinkStmt or kind == pskind.NodeKind.NdLdflagStmt:
        calling collect_link with s, n, kind
        return
    if kind == pskind.NodeKind.NdInsigniaStmt:
        calling collect_insignia with s, n
        return
    if kind == pskind.NodeKind.NdConstDecl:
        calling collect_const with s, n
        return
    if kind == pskind.NodeKind.NdVarDecl or kind == pskind.NodeKind.NdLetDecl or kind == pskind.NodeKind.NdStaticVarDecl:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_VAR_TOP_LEVEL, (calling astutil.start_of with s->ast, n), (calling astutil.end_of with s->ast, n), "top-level 'var'/'let' is not allowed", "Use 'const', or move the declaration inside a function.", "PenguScript forbids mutable global state."
        return
    if kind == pskind.NodeKind.NdRuneDecl:
        calling collect_record with s, n, sym.SemaSymbolKind.SkRune
        return
    if kind == pskind.NodeKind.NdEchoDecl:
        calling collect_record with s, n, sym.SemaSymbolKind.SkEcho
        return
    if kind == pskind.NodeKind.NdOmenDecl:
        calling collect_omen with s, n
        return
    if kind == pskind.NodeKind.NdAliasDecl:
        calling collect_alias with s, n, false
        return
    if kind == pskind.NodeKind.NdSealDecl:
        calling collect_alias with s, n, true
        return
    if kind == pskind.NodeKind.NdConceptDecl:
        calling collect_concept with s, n
        return
    if kind == pskind.NodeKind.NdBindDecl:
        calling collect_bind with s, n
        return
    if kind == pskind.NodeKind.NdWeaveDecl:
        calling collect_weave with s, n, false
        return
    if kind == pskind.NodeKind.NdDeclareStmt:
        calling collect_weave with s, n, true
        return
    if kind == pskind.NodeKind.NdAntiquusDecl:
        calling collect_weave with s, n, true
        return
    if kind == pskind.NodeKind.NdEnchantingDecl:
        calling collect_enchanting with s, n
        return
    if kind == pskind.NodeKind.NdTestDecl:
        calling collect_test with s, n
        return
    if kind == pskind.NodeKind.NdWhenTopDecl:
        calling collect_when_top with s, n
        return

## Registra un `import` en el módulo actual.
##
## ## Memoria
## Puede emitir diagnósticos; no posee el módulo destino.
weave collect_import with s as ref to state.SemaState, node as int into void:
    var path_node as int is calling astutil.node_child with s->ast, node, 0
    if path_node < 0:
        return
    var dot as string is calling collect_dotted_text with s, path_node
    defer banish dot
    var from_dir as string is calling compass.cp_dirname with s->module->path
    defer banish from_dir
    var hit as string is calling resolver.find_module with s->opts, dot, from_dir
    if hit == "":
        banish hit
        return
    var target_id as int is calling program.module_id with s->program, hit
    banish hit
    if target_id < 0:
        return
    var target as loader.SemaModule is (s->program->modules at target_id)
    var alias as int is calling import_alias with s, node, dot
    if alias < 0:
        return
    var sv as sym.SemaSymbol is calling symbols.make_symbol with s->names, "", 0, sym.SemaSymbolKind.SkImport
    set sv.name is alias
    set sv.c_name is alias
    set sv.module is s->module->id
    set sv.module_scope is target.scope
    set sv.start is calling astutil.start_of with s->ast, node
    set sv.end is calling astutil.end_of with s->ast, node
    var ipos as sourcemap.Position is calling s->src->position_at with sv.start
    set sv.line is ipos.line
    set sv.col is ipos.col
    calling symbols.symbol_define with s->symbols, sv

## Alias de un import (explícito o último componente).
##
## ## Memoria
## Devuelve un `NameId`.
weave import_alias with s as ref to state.SemaState, node as int, dot as string into int:
    var at as int is calling astutil.token_child with s->ast, node, 1
    if at >= 0:
        var txt as string is calling astutil.token_text with s->src, s->lex, at
        defer banish txt
        return calling npool.intern with s->names, txt
    var last as int is 0
    var i as int is 0
    var n as int is dot length
    while i < n:
        var ch as string is dot at i
        if ch == ".":
            set last is i + 1
        banish ch
        set i is i + 1
    var txt2 as string is calling collect_substring with dot, last, n
    defer banish txt2
    return calling npool.intern with s->names, txt2

## Texto de un `dotted_path`.
##
## ## Memoria
## Devuelve un string owned.
weave collect_dotted_text with s as ref to state.SemaState, node as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        if i > 0:
            calling sb.append with "."
        var txt as string is calling astutil.child_token_text with s->src, s->lex, s->ast, node, i
        calling sb.append with txt
        banish txt
        set i is i + 1
    return calling sb.finish

## Substring con copia owned.
##
## ## Memoria
## Devuelve un string owned.
weave collect_substring with s as string, start as int, end as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var i as int is start
    while i < end:
        var ch as string is s at i
        calling sb.append with ch
        banish ch
        set i is i + 1
    return calling sb.finish

## Valor textual de un operando de `when` (`os`, `arch`, `compiler`,
## `wasm_target`, booleanos comptime o un literal).
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave when_value with s as ref to state.SemaState, node as int into string:
    if node < 0:
        return ""
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    if k == pskind.NodeKind.NdStringLit:
        var txt as string is calling astutil.first_token_text with s->src, s->lex, s->ast, node
        defer banish txt
        return calling unquote with txt
    if k == pskind.NodeKind.NdTrueLit:
        return calling npool.copy_string with "true"
    if k == pskind.NodeKind.NdFalseLit:
        return calling npool.copy_string with "false"
    if k == pskind.NodeKind.NdVarRef:
        var txt as string is calling astutil.first_token_text with s->src, s->lex, s->ast, node
        defer banish txt
        if txt == "os":
            return calling npool.copy_string with s->opts->os_name
        if txt == "arch":
            return calling npool.copy_string with s->opts->arch
        if txt == "compiler":
            return calling npool.copy_string with s->opts->compiler
        if txt == "wasm_target":
            return calling npool.copy_string with s->opts->wasm_target
        if txt == "wasm":
            if s->opts->wasm_target != "" or calling define_has with s, "wasm":
                return calling npool.copy_string with "true"
            return calling npool.copy_string with "false"
        if txt == "main":
            if s->module->is_entry:
                return calling npool.copy_string with "true"
            return calling npool.copy_string with "false"
        if txt == "debug":
            if s->opts->is_debug:
                return calling npool.copy_string with "true"
            return calling npool.copy_string with "false"
        return calling npool.copy_string with txt
    return ""

## `true` si el operando de un `when` es una constante comptime conocida.
##
## Un identificador desconocido no es "falso": es E0039. Sólo `-D NAME` lo
## convierte en definido.
##
## ## Memoria
## O(1); no asigna.
weave when_known with s as ref to state.SemaState, node as int into bool:
    if node < 0:
        return false
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    if k == pskind.NodeKind.NdStringLit or k == pskind.NodeKind.NdTrueLit or k == pskind.NodeKind.NdFalseLit:
        return true
    if k == pskind.NodeKind.NdDefinedExpr:
        return true
    if k == pskind.NodeKind.NdVarRef:
        var txt as string is calling astutil.first_token_text with s->src, s->lex, s->ast, node
        defer banish txt
        if txt == "os" or txt == "arch" or txt == "compiler" or txt == "wasm_target" or txt == "wasm" or txt == "main" or txt == "debug":
            return true
        return calling define_has with s, txt
    return false

## Error E0039 para una condición `when` no resoluble.
##
## ## Memoria
## Emite el diagnóstico; no retiene strings.
weave when_error with s as ref to state.SemaState, node as int into void:
    var start as int is calling astutil.start_of with s->ast, node
    var end as int is calling astutil.end_of with s->ast, node
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_C_NAME_FIELD, start, end, "unresolvable compile-time condition", "Use os, arch, compiler, wasm, wasm_target, main, debug, or -D NAME.", ""

## Evalúa una condición `when` top-level sencilla.
##
## ## Memoria
## O(1); no asigna.
weave when_truth with s as ref to state.SemaState, node as int into bool:
    if node < 0:
        return true
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    if k == pskind.NodeKind.NdEq or k == pskind.NodeKind.NdNe:
        var lc as int is calling astutil.node_child with s->ast, node, 0
        var rc as int is calling astutil.node_child with s->ast, node, 1
        if not (calling when_known with s, lc) or not (calling when_known with s, rc):
            calling when_error with s, node
            return false
        var lv as string is calling when_value with s, lc
        var rv as string is calling when_value with s, rc
        var same as bool is lv == rv
        banish lv
        banish rv
        if k == pskind.NodeKind.NdEq:
            return same
        return not same
    if k == pskind.NodeKind.NdTrueLit:
        return true
    if k == pskind.NodeKind.NdFalseLit:
        return false
    if k == pskind.NodeKind.NdLogNot:
        var c as int is calling astutil.node_child with s->ast, node, 0
        return not (calling when_truth with s, c)
    if k == pskind.NodeKind.NdVarRef:
        var txt as string is calling astutil.first_token_text with s->src, s->lex, s->ast, node
        defer banish txt
        if txt == "wasm":
            return s->opts->wasm_target != "" or calling define_has with s, "wasm"
        if txt == "main":
            return s->module->is_entry
        if txt == "debug":
            return s->opts->is_debug
        if txt == "compiler":
            return s->opts->compiler length > 0
        if txt == "wasm_target":
            return s->opts->wasm_target length > 0
        if txt == "os":
            return true
        if txt == "arch":
            return true
        if calling define_has with s, txt:
            return true
        calling when_error with s, node
        return false
    if k == pskind.NodeKind.NdDefinedExpr:
        var dtxt as string is calling astutil.first_token_text with s->src, s->lex, s->ast, node
        defer banish dtxt
        return calling define_has with s, dtxt
    return true

## ¿`-D name` está definido?
##
## ## Memoria
## O(defines).
weave define_has with s as ref to state.SemaState, name as string into bool:
    var i as int is 0
    while i < s->opts->defines.len:
        var d as string is (s->opts->defines at i)
        if d == name:
            return true
        set i is i + 1
    return false

## Recolecta la rama activa de un `when` top-level.
##
## ## Memoria
## Recorre top_stmts; no asigna.
weave collect_when_top with s as ref to state.SemaState, node as int into void:
    # `else when` envuelve el siguiente `when_top_decl` en un nodo contenedor.
    if (calling astutil.kind_of with s->ast, node) == pskind.NodeKind.NdWhenTopElseWhen:
        var nested as int is calling astutil.node_child with s->ast, node, 0
        if nested >= 0:
            calling collect_when_top with s, nested
        return
    var cond as int is calling astutil.node_child with s->ast, node, 0
    var active as bool is calling when_truth with s, cond
    var i as int is 1
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var c as int is calling astutil.node_child with s->ast, node, i
        if c >= 0:
            var ck as pskind.NodeKind is calling astutil.kind_of with s->ast, c
            if ck == pskind.NodeKind.NdTopStmt or ck == pskind.NodeKind.NdStmt:
                if active:
                    calling collect_top with s, c
            else if ck == pskind.NodeKind.NdWhenTopElsePlain:
                if not active:
                    var j as int is 0
                    var en as int is calling astutil.child_count with s->ast, c
                    while j < en:
                        var e as int is calling astutil.node_child with s->ast, c, j
                        if e >= 0:
                            calling collect_top with s, e
                        set j is j + 1
            else if ck == pskind.NodeKind.NdWhenTopElseWhen:
                if not active:
                    calling collect_when_top with s, c
        set i is i + 1

## `include`, `link`, `ldflag`.
##
## ## Memoria
## Copia el string del token a la lista del programa.
weave collect_link with s as ref to state.SemaState, node as int, kind as pskind.NodeKind into void:
    var txt as string is calling astutil.first_token_text with s->src, s->lex, s->ast, node
    # El token incluye comillas; se quitan.
    var val as string is calling unquote with txt
    banish txt
    defer banish val
    if val == "":
        return
    if kind == pskind.NodeKind.NdIncludeStmt:
        calling s->symbols->includes.push with (calling npool.copy_string with val)
        set s->symbols->has_includes is true
    else if kind == pskind.NodeKind.NdLinkStmt:
        calling s->symbols->links.push with (calling npool.copy_string with val)
    else:
        calling s->symbols->ldflags.push with (calling npool.copy_string with val)

## Quita comillas dobles de un string.
##
## ## Memoria
## Devuelve un string owned.
weave unquote with s as string into string:
    var n as int is s length
    if n >= 2:
        var q0 as string is s at 0
        var q1 as string is s at (n - 1)
        var quoted as bool is q0 == "\"" and q1 == "\""
        banish q0
        banish q1
        if quoted:
            var i as int is 1
            var sb as StringBuilder is calling StringBuilder.new
            defer banish sb
            while i < n - 1:
                var ch as string is s at i
                calling sb.append with ch
                banish ch
                set i is i + 1
            return calling sb.finish
    return "{s}"

## `insignia NAME`.
##
## ## Memoria
## Interna el nombre y lo guarda.
weave collect_insignia with s as ref to state.SemaState, node as int into void:
    var txt as string is calling astutil.first_token_text with s->src, s->lex, s->ast, node
    defer banish txt
    var nid as int is calling npool.intern with s->names, txt
    if s->module->insignia >= 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MULTIPLE_INSIGNIA, (calling astutil.start_of with s->ast, node), (calling astutil.end_of with s->ast, node), "multiple 'insignia' directives not allowed", "Only one 'insignia' per module.", ""
        return
    set s->module->insignia is nid
    set s->module->insignia_pos is calling astutil.start_of with s->ast, node
    set s->symbols->insignia is nid

## Busca el primer token hijo (el nombre de la declaración).
##
## ## Memoria
## O(n hijos), no asigna.
weave collect_name_slot with s as ref to state.SemaState, node as int into int:
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        if (calling astutil.token_child with s->ast, node, i) >= 0:
            return i
        set i is i + 1
    return -1

## Nombre de la declaración como `NameId` (`-1` si falta).
##
## ## Memoria
## Interna el texto.
weave decl_name with s as ref to state.SemaState, node as int into int:
    var slot as int is calling collect_name_slot with s, node
    if slot < 0:
        return -1
    var txt as string is calling astutil.child_token_text with s->src, s->lex, s->ast, node, slot
    defer banish txt
    return calling npool.intern with s->names, txt

## Nombre de la declaración como string.
##
## ## Memoria
## Devuelve un string owned.
weave decl_name_text with s as ref to state.SemaState, node as int into string:
    var slot as int is calling collect_name_slot with s, node
    if slot < 0:
        return ""
    return calling astutil.child_token_text with s->src, s->lex, s->ast, node, slot

## Contexto de conversión de tipos.
##
## ## Memoria
## Valor puro de referencias.
weave collect_type_ctx with s as ref to state.SemaState into convert.TypeCtx:
    return with types is s->types, symbols is s->symbols, names is s->names, bag is s->bag, src is s->src, lex is s->lex, ast is s->ast

## Crea una info nominal y su `TypeId`.
##
## ## Memoria
## Añade a la tabla y al registro.
weave new_nominal with s as ref to state.SemaState, kind as tk.SemaNominalKind, name as int, cname as int, public as bool into int:
    var flags as int is 0
    if public:
        set flags is flags | types.NIF_PUBLIC
    var info as types.SemaNominalInfo is with kind is kind, base_name is name, c_name is cname, module is s->module->id, flags is flags, fields_first is 0, fields_count is 0, variants_first is 0, variants_count is 0, tparams_first is 0, tparams_count is 0, derived_first is 0, derived_count is 0, template_info is -1, attrs_node is -1
    return calling types.named_type with s->types, info

## Recorta espacios de una línea.
weave trim_text with s as string into string:
    var b as ref to frozen byte is bytes of s
    var a as int is 0
    var e as int is s length
    while a < e and (((b at a) to int) == 32 or ((b at a) to int) == 9):
        set a is a + 1
    while e > a and (((b at (e - 1)) to int) == 32 or ((b at (e - 1)) to int) == 9):
        set e is e - 1
    return s at a to e

## Asigna módulo, línea, columna, span y doc a un símbolo top-level.
weave tag_decl with s as ref to state.SemaState, id as int, node as int into void:
    if id < 0:
        return
    var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, id
    var off as int is calling astutil.start_of with s->ast, node
    var ps as sourcemap.Position is calling s->src->position_at with off
    set sv.line is ps.line
    set sv.col is ps.col
    set sv.start is off
    set sv.end is calling astutil.end_of with s->ast, node
    set sv.module is s->module->id
    # Doc comments inmediatamente encima: `#`, `##` y bloques `## ... ##`.
    var lines as list of string is calling s->src->text.split with "\n"
    var li as int is ps.line - 2
    var docs as list of string is list of string
    while li >= 0:
        var line as string is (lines at li)
        var tr as string is calling trim_text with line
        var d as string is ""
        if calling starts_with_text with tr, "##":
            set d is tr at 2 to (tr length)
        else if calling starts_with_text with tr, "#":
            set d is tr at 1 to (tr length)
        else:
            banish d
            banish tr
            break
        # Copia owned: `d` es una vista sobre `line`/`tr`.
        calling docs.push with (calling npool.copy_string with d)
        banish d
        banish tr
        banish line
        set li is li - 1
    if docs.len > 0:
        var sb as StringBuilder is calling StringBuilder.new
        var di as int is docs.len - 1
        while di >= 0:
            calling sb.append with (docs at di)
            if di > 0:
                calling sb.append with "\n"
            set di is di - 1
        var dtxt as string is calling sb.finish
        var nid as int is calling npool.intern with s->names, dtxt
        set sv.doc is nid
        banish dtxt
        banish sb
    var di2 as int is 0
    while di2 < docs.len:
        banish docs at di2
        set di2 is di2 + 1
    banish docs
    banish lines
    calling symbols.symbol_set with s->symbols, id, sv

## Registra un tipo en los mapas y el scope.
##
## ## Memoria
## Añade símbolo.
weave register_type with s as ref to state.SemaState, kind as sym.SemaSymbolKind, name as int, type_id as int, node as int into void:
    var sid as int is calling symbols.symbol_define_type with s->symbols, kind, name, type_id
    calling tag_decl with s, sid, node

## `rune`/`echo`.
##
## ## Memoria
## Añade tipo, campos y símbolo.
weave collect_record with s as ref to state.SemaState, node as int, sk as sym.SemaSymbolKind into void:
    var name as int is calling decl_name with s, node
    var name_txt as string is calling astutil.child_token_text with s->src, s->lex, s->ast, node, (calling collect_name_slot with s, node)
    defer banish name_txt
    var nk as tk.SemaNominalKind is tk.SemaNominalKind.NkRune
    if sk == sym.SemaSymbolKind.SkEcho:
        set nk is tk.SemaNominalKind.NkEcho
    var ty as int is -1
    if calling s->module->type_ids.has with node:
        set ty is calling s->module->type_ids.get with node
    else:
        set ty is calling new_nominal with s, nk, name, name, true
        calling s->module->type_ids.put with node, ty
    var info_idx as int is (calling types.at with s->types, ty).a
    var skind0 as sym.SemaSymbolKind is sym.SemaSymbolKind.SkRune
    if sk == sym.SemaSymbolKind.SkEcho:
        set skind0 is sym.SemaSymbolKind.SkEcho
    # El tipo debe ser visible antes de convertir sus campos (recursión).
    calling register_type with s, skind0, name, ty, node
    var fields_first as int is s->types->fields.len
    var field_count as int is 0
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var c as int is calling astutil.node_child with s->ast, node, i
        if c >= 0 and (calling astutil.kind_of with s->ast, c) == pskind.NodeKind.NdFieldDecl:
            var fname_slot as int is calling first_token_slot_after_attrs with s, c
            if fname_slot >= 0:
                var fname_txt as string is calling astutil.child_token_text with s->src, s->lex, s->ast, c, fname_slot
                defer banish fname_txt
                var fname as int is calling npool.intern with s->names, fname_txt
                var ftype as int is 0
                var fty_slot as int is fname_slot + 1
                if fty_slot < calling astutil.child_count with s->ast, c:
                    var ftn as int is calling astutil.node_child with s->ast, c, fty_slot
                    if ftn >= 0:
                        var ctx as convert.TypeCtx is calling collect_type_ctx with s
                        set ftype is calling convert.convert with (sigil of ctx), ftn
                var fld as types.SemaField is with name is fname, type is ftype, flags is 0, attrs_node is -1
                calling types.add_field with s->types, fld
                set field_count is field_count + 1
        set i is i + 1
    calling types.set_nominal_fields with s->types, info_idx, fields_first, field_count
    # Conceptos derivados (`derive Nexus, Par`).
    var dfirst as int is s->types->derived.len
    var dcount as int is 0
    var di as int is 0
    while di < n:
        var dc as int is calling astutil.node_child with s->ast, node, di
        if dc >= 0 and (calling astutil.kind_of with s->ast, dc) == pskind.NodeKind.NdDeriveClause:
            var dj as int is 0
            var dn as int is calling astutil.child_count with s->ast, dc
            while dj < dn:
                var dt as int is calling astutil.node_child with s->ast, dc, dj
                if dt >= 0:
                    var dctx as convert.TypeCtx is calling collect_type_ctx with s
                    var did as int is calling convert.convert with (sigil of dctx), dt
                    if did > 0:
                        var dty2 as tk.SemaType is calling types.at with s->types, did
                        var dname as string is calling npool.text with s->names, dty2.name
                        if dname == "Real":
                            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_TYPE_MISMATCH, (calling astutil.start_of with s->ast, dt), (calling astutil.end_of with s->ast, dt), "concept 'Real' cannot be derived", "Implement Real explicitly or derive Nexus/Par/Ordo.", ""
                        else:
                            calling types.add_derived with s->types, did
                            set dcount is dcount + 1
                set dj is dj + 1
        set di is di + 1
    var dinfo as types.SemaNominalInfo is (s->types->nominal_infos at info_idx)
    set dinfo.derived_first is dfirst
    set dinfo.derived_count is dcount
    var tpc as int is 0
    var tpfirst as int is s->types->tparams.len
    var ti as int is 0
    while ti < n:
        var tc as int is calling astutil.node_child with s->ast, node, ti
        if tc >= 0 and (calling astutil.kind_of with s->ast, tc) == pskind.NodeKind.NdShardParams:
            # `child_count` incluye el marcador ausente `_`; registra sólo los
            # tokens de parámetro reales (`T`, `A`, `B`, ...).
            var sci as int is 0
            var scn as int is calling astutil.child_count with s->ast, tc
            while sci < scn:
                var tptok as int is calling astutil.token_child with s->ast, tc, sci
                if tptok >= 0:
                    var tptxt as string is calling astutil.token_text with s->src, s->lex, tptok
                    var tpnid as int is calling npool.intern with s->names, tptxt
                    banish tptxt
                    var tpi as types.SemaTypeParamInfo is with name is tpnid, bounds_first is 0, bounds_count is 0, flags is 0
                    var ignored_tp as int is calling types.add_tparam with s->types, tpi
                    set tpc is tpc + 1
                set sci is sci + 1
        set ti is ti + 1
    set dinfo.tparams_first is tpfirst
    set dinfo.tparams_count is tpc
    set s->types->nominal_infos at (info_idx) is dinfo
    var skind as sym.SemaSymbolKind is sym.SemaSymbolKind.SkRune
    if sk == sym.SemaSymbolKind.SkEcho:
        set skind is sym.SemaSymbolKind.SkEcho
    if not (calling s->module->type_ids.has with node):
        calling register_type with s, skind, name, ty, node

## Primer token tras los atributos de un `field_decl`.
##
## ## Memoria
## O(n).
weave first_token_slot_after_attrs with s as ref to state.SemaState, node as int into int:
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var c as int is calling astutil.node_child with s->ast, node, i
        if c >= 0:
            var k as pskind.NodeKind is calling astutil.kind_of with s->ast, c
            if k == pskind.NodeKind.NdAttributes:
                set i is i + 1
                continue
        if (calling astutil.token_child with s->ast, node, i) >= 0:
            return i
        set i is i + 1
    return -1

## `omen`.
##
## ## Memoria
## Añade tipo/variantes.
weave collect_omen with s as ref to state.SemaState, node as int into void:
    var name as int is calling decl_name with s, node
    var ty as int is -1
    if calling s->module->type_ids.has with node:
        set ty is calling s->module->type_ids.get with node
    else:
        set ty is calling new_nominal with s, tk.SemaNominalKind.NkOmen, name, name, true
        calling s->module->type_ids.put with node, ty
        calling register_type with s, sym.SemaSymbolKind.SkOmen, name, ty, node
    var info_idx as int is (calling types.at with s->types, ty).a
    var first as int is s->types->variants.len
    var count as int is 0
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var c as int is calling astutil.node_child with s->ast, node, i
        if c >= 0 and (calling astutil.kind_of with s->ast, c) == pskind.NodeKind.NdOmenVariant:
            var vs as int is calling astutil.token_child with s->ast, c, 0
            if vs >= 0:
                var vtxt as string is calling astutil.token_text with s->src, s->lex, vs
                defer banish vtxt
                var vname as int is calling npool.intern with s->names, vtxt
                var pfirst as int is s->types->fields.len
                var pcount as int is 0
                var ci as int is 2
                var cn as int is calling astutil.child_count with s->ast, c
                while ci < cn:
                    var of as int is calling astutil.node_child with s->ast, c, ci
                    if of >= 0 and (calling astutil.kind_of with s->ast, of) == pskind.NodeKind.NdOmenField:
                        var oft as int is calling astutil.token_child with s->ast, of, 0
                        var ofty as int is 0
                        var oftn as int is calling astutil.node_child with s->ast, of, 1
                        if oftn >= 0:
                            var ofctx as convert.TypeCtx is calling collect_type_ctx with s
                            set ofty is calling convert.convert with (sigil of ofctx), oftn
                        if oft >= 0:
                            var oftxt as string is calling astutil.token_text with s->src, s->lex, oft
                            defer banish oftxt
                            var ofnid as int is calling npool.intern with s->names, oftxt
                            var ofld as types.SemaField is with name is ofnid, type is ofty, flags is 0, attrs_node is -1
                            calling types.add_field with s->types, ofld
                            set pcount is pcount + 1
                    set ci is ci + 1
                var varnt as types.SemaVariant is with name is vname, value_i is 0, value_s is -1, payload_first is pfirst, payload_count is pcount, flags is 0
                calling types.add_variant with s->types, varnt
                # Las variantes son valores del omen y se usan como identificadores
                # (`KwAlias`, `JsonValue.Null`, ...). Se registran en el scope.
                var vsym as sym.SemaSymbol is calling symbols.make_symbol with s->names, "", ty, sym.SemaSymbolKind.SkConst
                set vsym.name is vname
                set vsym.c_name is vname
                calling symbols.symbol_define_in with s->symbols, 0, vsym
                set count is count + 1
        set i is i + 1
    calling types.set_nominal_variants with s->types, info_idx, first, count
    # Parámetros `shard` del omen (para instanciar `Val of int`).
    var tpc as int is 0
    var tpfirst as int is s->types->tparams.len
    var ti as int is 0
    while ti < n:
        var tc as int is calling astutil.node_child with s->ast, node, ti
        if tc >= 0 and (calling astutil.kind_of with s->ast, tc) == pskind.NodeKind.NdShardParams:
            var sci as int is 0
            var scn as int is calling astutil.child_count with s->ast, tc
            while sci < scn:
                var tptok as int is calling astutil.token_child with s->ast, tc, sci
                if tptok >= 0:
                    var tptxt as string is calling astutil.token_text with s->src, s->lex, tptok
                    var tpnid as int is calling npool.intern with s->names, tptxt
                    banish tptxt
                    var tpi as types.SemaTypeParamInfo is with name is tpnid, bounds_first is 0, bounds_count is 0, flags is 0
                    var ignored_tp as int is calling types.add_tparam with s->types, tpi
                    set tpc is tpc + 1
                set sci is sci + 1
        set ti is ti + 1
    var dinfo as types.SemaNominalInfo is (s->types->nominal_infos at info_idx)
    set dinfo.tparams_first is tpfirst
    set dinfo.tparams_count is tpc
    set s->types->nominal_infos at (info_idx) is dinfo

## `alias`/`seal`.
##
## ## Memoria
## Añade tipo/símbolo.
weave collect_alias with s as ref to state.SemaState, node as int, is_seal as bool into void:
    var name as int is calling decl_name with s, node
    var ty_node as int is -1
    var n as int is calling astutil.child_count with s->ast, node
    if is_seal:
        set ty_node is calling astutil.node_child with s->ast, node, 1
    else:
        set ty_node is calling astutil.node_child with s->ast, node, n - 1
    var ctx as convert.TypeCtx is calling collect_type_ctx with s
    var target as int is calling convert.convert with (sigil of ctx), ty_node
    var nk as tk.SemaNominalKind is tk.SemaNominalKind.NkAlias
    if is_seal:
        set nk is tk.SemaNominalKind.NkSeal
    var info as types.SemaNominalInfo is with kind is nk, base_name is name, c_name is name, module is s->module->id, flags is types.NIF_PUBLIC, fields_first is 0, fields_count is 0, variants_first is 0, variants_count is 0, tparams_first is 0, tparams_count is 0, derived_first is 0, derived_count is 0, template_info is -1, attrs_node is -1
    var ty as int is calling types.named_with_target with s->types, info, target
    var sk as sym.SemaSymbolKind is sym.SemaSymbolKind.SkAlias
    if is_seal:
        set sk is sym.SemaSymbolKind.SkSeal
    calling register_type with s, sk, name, ty, node

## `concept`.
##
## ## Memoria
## Añade tipo/símbolo y métodos.
weave collect_concept with s as ref to state.SemaState, node as int into void:
    var name as int is calling decl_name with s, node
    var ty as int is -1
    if calling s->module->type_ids.has with node:
        set ty is calling s->module->type_ids.get with node
    else:
        set ty is calling new_nominal with s, tk.SemaNominalKind.NkConcept, name, name, true
        calling s->module->type_ids.put with node, ty
        calling register_type with s, sym.SemaSymbolKind.SkConcept, name, ty, node
    var info_idx as int is (calling types.at with s->types, ty).a
    var first as int is s->types->concept_methods.len
    var count as int is 0
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var c as int is calling astutil.node_child with s->ast, node, i
        if c >= 0 and (calling astutil.kind_of with s->ast, c) == pskind.NodeKind.NdConceptMethod:
            var mslot as int is calling astutil.token_child with s->ast, c, 0
            if mslot >= 0:
                var mtxt as string is calling astutil.token_text with s->src, s->lex, mslot
                defer banish mtxt
                var mname as int is calling npool.intern with s->names, mtxt
                var cm as types.SemaConceptMethod is with name is mname, fn_type is 0, flags is types.CM_REQUIRED
                calling types.add_concept_method with s->types, cm
                set count is count + 1
        set i is i + 1
    # Los métodos de concepto no tienen rango propio; se guardan en la tabla.

## `const NAME [as T] is value`.
##
## ## Memoria
## Evalúa un literal constante simple.
##
## F3 sólo necesita valores para `const` de módulo; las expresiones complejas
## se dejan en `CkNone` y las resolverá el codegen/inferencia cuando exista el
## plegado completo. Aquí se cubren enteros (decimal/hex), bool, string y char,
## que son la mayoría de constantes de std.
##
## ## Memoria
## El string se interna en el pool; no asigna listas.
weave const_literal with s as ref to state.SemaState, node as int into sym.SemaConst:
    var cv as sym.SemaConst is with kind is sym.SemaConstKind.CkNone, i is 0, f is 0.0, b is false, name is -1
    if node < 0:
        return cv
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    if k == pskind.NodeKind.NdTrueLit:
        set cv.kind is sym.SemaConstKind.CkBool
        set cv.b is true
        return cv
    if k == pskind.NodeKind.NdFalseLit:
        set cv.kind is sym.SemaConstKind.CkBool
        return cv
    if k == pskind.NodeKind.NdStringLit:
        var raw as string is calling astutil.child_token_text with s->src, s->lex, s->ast, node, 0
        if raw length >= 2:
            var content as string is raw at 1 to (raw length - 1)
            set cv.kind is sym.SemaConstKind.CkString
            set cv.name is calling npool.intern with s->names, content
            banish content
        banish raw
        return cv
    if k == pskind.NodeKind.NdCharLit:
        var rawc as string is calling astutil.child_token_text with s->src, s->lex, s->ast, node, 0
        if rawc length >= 3:
            var ch as string is rawc at 1 to 2
            var b as ref to frozen byte is bytes of ch
            set cv.kind is sym.SemaConstKind.CkChar
            set cv.i is ((b at 0) to i64)
            banish ch
        banish rawc
        return cv
    if k == pskind.NodeKind.NdFloatLit:
        # El codegen emite el token original (precisión completa); `f` no hace
        # falta para un literal.
        set cv.kind is sym.SemaConstKind.CkFloat
        return cv
    if k == pskind.NodeKind.NdParenExpr:
        return calling const_literal with s, (calling astutil.node_child with s->ast, node, 0)
    if k == pskind.NodeKind.NdNeg:
        var negv as sym.SemaConst is calling const_literal with s, (calling astutil.node_child with s->ast, node, 0)
        if negv.kind == sym.SemaConstKind.CkInt:
            set negv.i is 0 - negv.i
        return negv
    if k == pskind.NodeKind.NdBitNot:
        var bnv as sym.SemaConst is calling const_literal with s, (calling astutil.node_child with s->ast, node, 0)
        if bnv.kind == sym.SemaConstKind.CkInt:
            set bnv.i is ~bnv.i
        return bnv
    if k == pskind.NodeKind.NdVarRef:
        var rtxt as string is calling astutil.first_token_text with s->src, s->lex, s->ast, node
        var rsid as int is calling symbols.lookup_name with s->symbols, rtxt
        banish rtxt
        if rsid >= 0:
            var rsv as sym.SemaSymbol is (s->symbols->symbols at rsid)
            if rsv.kind == sym.SemaSymbolKind.SkConst and rsv.const_id >= 0:
                return (s->symbols->const_values at rsv.const_id)
        return cv
    if k == pskind.NodeKind.NdShl or k == pskind.NodeKind.NdShr or k == pskind.NodeKind.NdBitwiseAnd or k == pskind.NodeKind.NdBitwiseOr or k == pskind.NodeKind.NdBitwiseXor or k == pskind.NodeKind.NdAdd or k == pskind.NodeKind.NdSub or k == pskind.NodeKind.NdMul or k == pskind.NodeKind.NdDiv or k == pskind.NodeKind.NdMod:
        var lv as sym.SemaConst is calling const_literal with s, (calling astutil.node_child with s->ast, node, 0)
        var rv as sym.SemaConst is calling const_literal with s, (calling astutil.node_child with s->ast, node, 1)
        if lv.kind == sym.SemaConstKind.CkInt and rv.kind == sym.SemaConstKind.CkInt:
            set cv.kind is sym.SemaConstKind.CkInt
            if k == pskind.NodeKind.NdShl:
                var mul2 as i64 is 1
                var shl as i64 is 0
                while shl < rv.i:
                    set mul2 is mul2 * 2
                    set shl is shl + 1
                if rv.i >= 0:
                    set cv.i is lv.i * mul2
            else if k == pskind.NodeKind.NdShr:
                var div2 as i64 is 2
                var sh as i64 is 0
                while sh < rv.i:
                    set div2 is div2 * 2
                    set sh is sh + 1
                if rv.i >= 0:
                    set cv.i is lv.i / div2
            else if k == pskind.NodeKind.NdBitwiseAnd:
                set cv.i is lv.i & rv.i
            else if k == pskind.NodeKind.NdBitwiseOr:
                set cv.i is lv.i | rv.i
            else if k == pskind.NodeKind.NdBitwiseXor:
                set cv.i is lv.i ^ rv.i
            else if k == pskind.NodeKind.NdAdd:
                set cv.i is lv.i + rv.i
            else if k == pskind.NodeKind.NdSub:
                set cv.i is lv.i - rv.i
            else if k == pskind.NodeKind.NdMul:
                set cv.i is lv.i * rv.i
            else if k == pskind.NodeKind.NdDiv and rv.i != 0:
                set cv.i is lv.i / rv.i
            else if k == pskind.NodeKind.NdMod and rv.i != 0:
                set cv.i is lv.i % rv.i
        return cv
    if k != pskind.NodeKind.NdIntLit:
        return cv
    var text as string is calling astutil.child_token_text with s->src, s->lex, s->ast, node, 0
    var b2 as ref to frozen byte is bytes of text
    var i as int is 0
    var neg as bool is false
    if text length > 0 and ((b2 at 0) to int) == 45:
        set neg is true
        set i is 1
    var base as i64 is 10
    if i + 1 < text length and ((b2 at i) to int) == 48 and (((b2 at (i + 1)) to int) == 120 or ((b2 at (i + 1)) to int) == 88):
        set base is 16
        set i is i + 2
    var v as i64 is 0
    while i < text length:
        var code as int is ((b2 at i) to int)
        if code == 95:
            set i is i + 1
            continue
        var d as int is -1
        if code >= 48 and code <= 57:
            set d is code - 48
        else if code >= 97 and code <= 102:
            set d is code - 87
        else if code >= 65 and code <= 70:
            set d is code - 55
        if d >= 0:
            set v is v * base + (d to i64)
        set i is i + 1
    if neg:
        set v is -v
    set cv.kind is sym.SemaConstKind.CkInt
    set cv.i is v
    banish text
    return cv

## Añade un símbolo y un valor constante POD.
weave collect_const with s as ref to state.SemaState, node as int into void:
    var name as int is calling decl_name with s, node
    var type_node as int is calling astutil.node_child with s->ast, node, 1
    var value_node as int is calling astutil.node_child with s->ast, node, 2
    var ty as int is 0
    if type_node >= 0:
        var ctx as convert.TypeCtx is calling collect_type_ctx with s
        set ty is calling convert.convert with (sigil of ctx), type_node
    if ty <= 0:
        set ty is calling infer.infer with s, value_node, -1
    var cv as sym.SemaConst is calling const_literal with s, value_node
    var cid as int is calling symbols.symbol_define_const with s->symbols, name, ty, cv
    calling tag_decl with s, cid, node

## `true` si `s` empieza por `prefix`.
##
## ## Memoria
## O(prefix); no asigna.
weave starts_with_text with s as string, prefix as string into bool:
    var n as int is s length
    var m as int is prefix length
    if m > n:
        return false
    var sb as ref to frozen byte is bytes of s
    var pb as ref to frozen byte is bytes of prefix
    var i as int is 0
    while i < m:
        if ((sb at i) to int) != ((pb at i) to int):
            return false
        set i is i + 1
    return true

## ¿Un nodo `attributes` contiene `name`?
##
## ## Memoria
## O(n); strings temporales liberados.
weave has_attribute with s as ref to state.SemaState, attrs as int, name as string into bool:
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, attrs
    while i < n:
        var a as int is calling astutil.node_child with s->ast, attrs, i
        if a >= 0:
            var t as int is calling astutil.token_child with s->ast, a, 0
            if t >= 0:
                var txt as string is calling astutil.token_text with s->src, s->lex, t
                defer banish txt
                if txt == "@{name}" or txt == name:
                    return true
        set i is i + 1
    return false

## `weave`/`declare`/`antiquus`.
##
## ## Memoria
## Añade FnType/símbolo; `check` valida el cuerpo.
weave collect_weave with s as ref to state.SemaState, node as int, no_body as bool into void:
    var name as int is calling decl_name with s, node
    calling reject_free_mutates with s, node
    var slot as int is calling collect_name_slot with s, node
    var params_slot as int is slot + 2
    var ret_slot as int is slot + 3
    var pr as ParamRange is with first is 0, count is 0
    if params_slot < calling astutil.child_count with s->ast, node:
        var pnode as int is calling astutil.node_child with s->ast, node, params_slot
        if pnode >= 0:
            calling collect_params with s, pnode, (sigil of pr)
    var ret as int is 3
    if ret_slot < calling astutil.child_count with s->ast, node:
        var rnode as int is calling astutil.node_child with s->ast, node, ret_slot
        if rnode >= 0:
            var ctx as convert.TypeCtx is calling collect_type_ctx with s
            set ret is calling convert.convert with (sigil of ctx), rnode
    var br as ParamRange is with first is 0, count is 0
    var shard_node as int is calling astutil.node_child with s->ast, node, 2
    if shard_node >= 0:
        var shi as int is 0
        var shn as int is calling astutil.child_count with s->ast, shard_node
        while shi < shn:
            var shc as int is calling astutil.node_child with s->ast, shard_node, shi
            if shc >= 0 and (calling astutil.kind_of with s->ast, shc) == pskind.NodeKind.NdWhereClause:
                set br is calling collect_bounds with s, shc
            set shi is shi + 1
    var info as types.SemaFnInfo is with params_first is pr.first, params_count is pr.count, return_type is ret, tparams_first is 0, tparams_count is 0, flags is 0, attrs_node is -1
    var ft as int is calling types.fn_type with s->types, info
    var sid as int is calling symbols.symbol_define_function with s->symbols, name, ft
    calling apply_bounds with s, sid, br
    var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
    if no_body:
        set sv.kind is sym.SemaSymbolKind.SkDeclare
    else:
        set sv.kind is sym.SemaSymbolKind.SkWeave
    calling symbols.symbol_set with s->symbols, sid, sv
    calling tag_decl with s, sid, node

## Recolecta params de una lista.
##
## ## Memoria
## Añade `SemaFnParam` y actualiza `first/count` por referencia.
weave collect_params with s as ref to state.SemaState, pnode as int, out as ref to ParamRange into void:
    set out->first is s->types->fn_params.len
    set out->count is 0
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, pnode
    while i < n:
        var p as int is calling astutil.node_child with s->ast, pnode, i
        if p >= 0 and (calling astutil.kind_of with s->ast, p) == pskind.NodeKind.NdParam:
            var pname as int is -1
            var ps as int is calling astutil.token_child with s->ast, p, 0
            if ps >= 0:
                var ptxt as string is calling astutil.token_text with s->src, s->lex, ps
                defer banish ptxt
                set pname is calling npool.intern with s->names, ptxt
            var pty as int is 0
            var ptn as int is calling astutil.node_child with s->ast, p, 1
            if ptn >= 0:
                var ctx as convert.TypeCtx is calling collect_type_ctx with s
                set pty is calling convert.convert with (sigil of ctx), ptn
            var fp as types.SemaFnParam is with name is pname, type is pty, flags is 0, default_node is -1
            calling types.add_fn_param with s->types, fp
            set out->count is out->count + 1
        else:
            # `...` es un token hijo, no un `NdParam`: registra el singleton
            # CVarArgs para que la firma C conserve la variadicidad.
            var et as pstoken.TokenKind is calling astutil.child_token_kind with s->lex, s->ast, pnode, i
            if et == pstoken.TokenKind.TokEllipsis:
                var fpe as types.SemaFnParam is with name is -1, type is types.TYPE_ID_CVARARGS, flags is 0, default_node is -1
                calling types.add_fn_param with s->types, fpe
                set out->count is out->count + 1
        set i is i + 1

## Nodo `attribute` llamado `name`, o `-1`.
##
## ## Memoria
## O(attrs).
weave find_attribute with s as ref to state.SemaState, attrs as int, name as string into int:
    if attrs < 0:
        return -1
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, attrs
    while i < n:
        var a as int is calling astutil.node_child with s->ast, attrs, i
        if a >= 0:
            var t as int is calling astutil.token_child with s->ast, a, 0
            if t >= 0:
                var txt as string is calling astutil.token_text with s->src, s->lex, t
                defer banish txt
                if txt == name:
                    return a
        set i is i + 1
    return -1

## Valida `@mutates` en un método.
##
## Reglas stage0: sin argumentos; retorno `void` o el tipo receptor.
##
## ## Memoria
## Puede emitir diagnósticos; no posee recursos.
weave check_mutates_method with s as ref to state.SemaState, m as int, recv as int, ft as int into void:
    var attrs as int is calling astutil.node_child with s->ast, m, 0
    var a as int is calling find_attribute with s, attrs, "mutates"
    if a < 0:
        return
    var start as int is calling astutil.start_of with s->ast, a
    var end as int is calling astutil.end_of with s->ast, a
    var args as int is calling astutil.node_child with s->ast, a, 1
    if args >= 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MUTATES_ATTR, start, end, "@mutates does not take arguments", "Write @mutates.", ""
        return
    var fy as tk.SemaType is calling types.at with s->types, ft
    if fy.kind == tk.SemaTypeKind.TkFn:
        var info as types.SemaFnInfo is (s->types->fn_infos at fy.a)
        if info.return_type != 3 and info.return_type != recv:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MUTATES_ATTR, start, end, "@mutates must return void or the receiver type", "Return void or the mutated value.", ""
        # Una mutación en sitio ('set self/...') debe ser un procedimiento void.
        if info.return_type != 3:
            var fun_found as bool is calling tree_has_set with s, m
            if fun_found:
                calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MUTATES_ATTR, start, end, "@mutates with an in-place set must return void", "Return void when mutating in place.", ""

## Rechaza `@mutates` en una función libre/declare.
##
## ## Memoria
## O(attrs).
weave reject_free_mutates with s as ref to state.SemaState, m as int into void:
    var attrs as int is calling astutil.node_child with s->ast, m, 0
    var a as int is calling find_attribute with s, attrs, "mutates"
    if a >= 0:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MUTATES_ATTR, (calling astutil.start_of with s->ast, a), (calling astutil.end_of with s->ast, a), "@mutates is only valid on enchanting/bind methods", "Move the method into an enchanting block.", ""

## Firma de un método de `enchanting`/`bind` (params y retorno).
##
## ## Memoria
## Añade fn_params y fn_info; devuelve el `TypeId`.
weave collect_method_sig with s as ref to state.SemaState, m as int into int:
    var slot as int is calling collect_name_slot with s, m
    var params_slot as int is slot + 2
    var ret_slot as int is slot + 3
    var pr2 as ParamRange is with first is 0, count is 0
    if params_slot < calling astutil.child_count with s->ast, m:
        var pn as int is calling astutil.node_child with s->ast, m, params_slot
        if pn >= 0:
            calling collect_params with s, pn, (sigil of pr2)
    var ret as int is 3
    if ret_slot < calling astutil.child_count with s->ast, m:
        var rn as int is calling astutil.node_child with s->ast, m, ret_slot
        if rn >= 0:
            var ctx as convert.TypeCtx is calling collect_type_ctx with s
            set ret is calling convert.convert with (sigil of ctx), rn
    var info as types.SemaFnInfo is with params_first is pr2.first, params_count is pr2.count, return_type is ret, tparams_first is 0, tparams_count is 0, flags is types.FN_METHOD, attrs_node is -1
    return calling types.fn_type with s->types, info

## Recoge los bounds de un `where_clause` en `types.bounds`.
##
## ## Memoria
## Añade TypeIds de concepto; devuelve `first/count`.
weave collect_bounds with s as ref to state.SemaState, where_node as int into ParamRange:
    var out as ParamRange is with first is s->types->bounds.len, count is 0
    if where_node < 0:
        return out
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, where_node
    while i < n:
        var wb as int is calling astutil.node_child with s->ast, where_node, i
        if wb >= 0 and (calling astutil.kind_of with s->ast, wb) == pskind.NodeKind.NdWhereBound:
            var cnode as int is calling astutil.node_child with s->ast, wb, 1
            if cnode >= 0:
                var ctx as convert.TypeCtx is calling collect_type_ctx with s
                var cid as int is calling convert.convert with (sigil of ctx), cnode
                if cid > 0:
                    calling types.add_bound with s->types, cid
                    set out.count is out.count + 1
        set i is i + 1
    return out

## Aplica bounds a un símbolo ya definido.
##
## ## Memoria
## O(1).
weave apply_bounds with s as ref to state.SemaState, sid as int, br as ParamRange into void:
    if br.count <= 0 or sid < 0:
        return
    var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
    set sv.bounds_first is br.first
    set sv.bounds_count is br.count
    calling symbols.symbol_set with s->symbols, sid, sv

## Rechaza métodos duplicados sobre un primitivo (coherencia).
##
## ## Memoria
## O(1); puede emitir diagnósticos.
weave reject_duplicate_primitive with s as ref to state.SemaState, recv as int, mname as int, m as int into void:
    var rt as tk.SemaType is calling types.at with s->types, recv
    if rt.kind != tk.SemaTypeKind.TkBase:
        return
    if (calling symbols.lookup_method_exact with s->symbols, recv, mname) >= 0:
        var mtext as string is calling npool.text with s->names, mname
        var msg as string is "duplicate method '{mtext}' on primitive type"
        defer banish msg
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_PRIMITIVE_METHOD, (calling astutil.start_of with s->ast, m), (calling astutil.end_of with s->ast, m), msg, "Remove or rename the duplicate implementation.", ""

## Marca un método como `@mutates` en el símbolo.
##
## ## Memoria
## O(1).
weave mark_mutating with s as ref to state.SemaState, m as int, sid as int into void:
    var attrs as int is calling astutil.node_child with s->ast, m, 0
    if (calling find_attribute with s, attrs, "mutates") >= 0:
        var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
        set sv.flags is sv.flags | sym.SYM_MUTATING
        calling symbols.symbol_set with s->symbols, sid, sv

## ¿El subárbol contiene `self`?
##
## ## Memoria
## O(nodos).
weave tree_has_self with s as ref to state.SemaState, node as int into bool:
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    if k == pskind.NodeKind.NdSelfRef:
        return true
    if k == pskind.NodeKind.NdNormalTarget:
        var t as int is calling astutil.token_child with s->ast, node, 0
        if t >= 0:
            var txt as string is calling astutil.token_text with s->src, s->lex, t
            defer banish txt
            if txt == "self":
                return true
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var c as int is calling astutil.node_child with s->ast, node, i
        if c >= 0 and calling tree_has_self with s, c:
            return true
        set i is i + 1
    return false

## ¿Hay un `set` sobre `self`/sus campos en el subárbol?
##
## Los `set` de locales no cuentan para `@mutates`.
##
## ## Memoria
## O(nodos).
weave tree_has_set with s as ref to state.SemaState, node as int into bool:
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, node
    if k == pskind.NodeKind.NdSetStmt or k == pskind.NodeKind.NdCompoundSetStmt:
        var tgt as int is calling astutil.node_child with s->ast, node, 0
        if tgt >= 0 and calling tree_has_self with s, tgt:
            return true
    var i as int is 0
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var c as int is calling astutil.node_child with s->ast, node, i
        if c >= 0 and calling tree_has_set with s, c:
            return true
        set i is i + 1
    return false

## ¿Existe un método de concepto con ese nombre?
##
## ## Memoria
## O(métodos de concepto).
weave concept_method_exists with s as ref to state.SemaState, name as int into bool:
    var i as int is 0
    while i < s->types->concept_methods.len:
        var m as types.SemaConceptMethod is (s->types->concept_methods at i)
        if m.name == name:
            return true
        set i is i + 1
    return false

## Registra el alias puro `get_<metodo>` si no existe.
##
## ## Memoria
## O(1); no asigna el nombre si ya existe.
weave define_get_alias with s as ref to state.SemaState, recv as int, mname as int, ft as int, br as ParamRange, base_sid as int into void:
    var mtext as string is calling npool.text with s->names, mname
    if calling starts_with_text with mtext, "get_":
        return
    var gtext as string is "get_{mtext}"
    defer banish gtext
    var gid as int is calling npool.intern with s->names, gtext
    if (calling symbols.lookup_method_exact with s->symbols, recv, gid) < 0:
        var gsid as int is calling symbols.symbol_define_method with s->symbols, recv, gid, ft
        var gsym as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, gsid
        set gsym.flags is gsym.flags | sym.SYM_GET_ALIAS
        set gsym.alias_of is base_sid
        calling symbols.symbol_set with s->symbols, gsid, gsym
        calling apply_bounds with s, gsid, br

## `enchanting`.
##
## ## Memoria
## Añade métodos al registro.
weave collect_enchanting with s as ref to state.SemaState, node as int into void:
    var recv_node as int is calling astutil.node_child with s->ast, node, 0
    var ctx as convert.TypeCtx is calling collect_type_ctx with s
    var recv as int is 0
    if recv_node >= 0:
        set recv is calling convert.convert with (sigil of ctx), recv_node
    var recv_under as int is calling infer.underlying_type with s, recv
    var br as ParamRange is with first is 0, count is 0
    var wi as int is 1
    var wn as int is calling astutil.child_count with s->ast, node
    while wi < wn:
        var wc as int is calling astutil.node_child with s->ast, node, wi
        if wc >= 0 and (calling astutil.kind_of with s->ast, wc) == pskind.NodeKind.NdWhereClause:
            set br is calling collect_bounds with s, wc
        set wi is wi + 1
    var i as int is 1
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var m as int is calling astutil.node_child with s->ast, node, i
        if m >= 0 and (calling astutil.kind_of with s->ast, m) == pskind.NodeKind.NdWeaveDecl:
            var mname as int is calling decl_name with s, m
            var ft as int is calling collect_method_sig with s, m
            calling check_mutates_method with s, m, recv, ft
            calling reject_duplicate_primitive with s, recv_under, mname, m
            # `Quaternion` es alias de `Vector4`: ambos comparten tabla de métodos.
            var msid as int is calling symbols.symbol_define_method with s->symbols, recv_under, mname, ft
            calling mark_mutating with s, m, msid
            calling apply_bounds with s, msid, br
            calling tag_decl with s, msid, m
            calling define_get_alias with s, recv_under, mname, ft, br, msid
        set i is i + 1

## `bind Tipo with Concepto:`: registra las implementaciones de método.
##
## ## Memoria
## Añade métodos al registro del tipo receptor.
weave collect_bind with s as ref to state.SemaState, node as int into void:
    var recv_node as int is calling astutil.node_child with s->ast, node, 0
    var ctx as convert.TypeCtx is calling collect_type_ctx with s
    var recv as int is 0
    if recv_node >= 0:
        set recv is calling convert.convert with (sigil of ctx), recv_node
    var recv_under as int is calling infer.underlying_type with s, recv
    var i as int is 2
    var n as int is calling astutil.child_count with s->ast, node
    while i < n:
        var m as int is calling astutil.node_child with s->ast, node, i
        if m >= 0 and (calling astutil.kind_of with s->ast, m) == pskind.NodeKind.NdWeaveDecl:
            var mname as int is calling decl_name with s, m
            if not (calling concept_method_exists with s, mname):
                var bmsg as string is "method is not declared by the bound concept"
                defer banish bmsg
                calling sdiag.node_error with s->bag, s->src, sdiag.CODE_UNDEFINED, (calling astutil.start_of with s->ast, m), (calling astutil.end_of with s->ast, m), bmsg, "Implement only the concept's methods.", ""
            var battrs as int is calling astutil.node_child with s->ast, m, 0
            if (calling find_attribute with s, battrs, "mutates") >= 0:
                calling sdiag.node_error with s->bag, s->src, sdiag.CODE_MUTATES_ATTR, (calling astutil.start_of with s->ast, m), (calling astutil.end_of with s->ast, m), "@mutates is not allowed in bind", "Use a pure method.", ""
            var ft as int is calling collect_method_sig with s, m
            calling check_mutates_method with s, m, recv, ft
            calling reject_duplicate_primitive with s, recv_under, mname, m
            var bsid2 as int is calling symbols.symbol_define_method with s->symbols, recv_under, mname, ft
            calling mark_mutating with s, m, bsid2
            calling tag_decl with s, bsid2, m
            var empty_br as ParamRange is with first is 0, count is 0
            calling define_get_alias with s, recv_under, mname, ft, empty_br, bsid2
        set i is i + 1

## `test "nombre":`.
##
## ## Memoria
## Añade un símbolo de test.
weave collect_test with s as ref to state.SemaState, node as int into void:
    var name as int is calling decl_name with s, node
    var symv as sym.SemaSymbol is calling symbols.make_symbol with s->names, "", 3, sym.SemaSymbolKind.SkTest
    set symv.name is name
    set symv.c_name is name
    var sid as int is calling symbols.symbol_define with s->symbols, symv
    calling tag_decl with s, sid, node
