## psc/sema/check/moves.pengu — move-by-default para tipos con destructor.
##
## Un valor de un rune `derive Drop` tiene un dueño y se mueve: al enlazarlo,
## asignarlo o devolverlo, el binding de origen deja de ser válido. El checker
## marca el símbolo movido (`SYM_DROP_MOVED`) y cualquier lectura posterior es
## `E0080`; mover desde un sitio prestado (un parámetro, un campo de otro
## valor, un `ref`) es `E0081`.
##
## Es un análisis intra-procedural y conservador: no hay lifetimes ni préstamos
## que sobrevivan al scope. Lo que no se puede mover se copia con `.clone()`.
##
## ## Memoria
## Sin destructor; sólo toca la tabla de símbolos y el bag.
import std.diagnostic as diag

import psc.ast.kind as pskind
import psc.sema.ast as astutil
import psc.sema.diagnostics as sdiag
import psc.sema.names as npool
import psc.sema.state as state
import psc.sema.symbols.symbol as sym
import psc.sema.symbols.table as symbols
import psc.sema.types.kind as tk
import psc.sema.types.table as types

insignia sema_moves_

## `true` si el tipo declara `derive Drop` (siguiendo alias y seal).
##
## ## Memoria
## O(1).
weave type_is_drop with s as ref to state.SemaState, ty as int into bool:
    if ty <= 0 or ty >= s->types->types.len:
        return false
    var t as tk.SemaType is calling types.at with s->types, ty
    var guard as int is 0
    while (t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal) and guard < 32:
        if t.b <= 0:
            return false
        set t is calling types.at with s->types, t.b
        set guard is guard + 1
    if t.kind != tk.SemaTypeKind.TkRune:
        return false
    if t.a < 0 or t.a >= s->types->nominal_infos.len:
        return false
    var info as types.SemaNominalInfo is (s->types->nominal_infos at t.a)
    return (info.flags & types.NIF_DROP) != 0

## Marca el símbolo como movido (si aún no lo estaba).
##
## ## Memoria
## Sin asignaciones.
weave mark_moved with s as ref to state.SemaState, sid as int into void:
    var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
    if (sv.flags & sym.SYM_DROP_MOVED) != 0:
        return
    set sv.flags is sv.flags | sym.SYM_DROP_MOVED
    calling symbols.symbol_set with s->symbols, sid, sv

## Consume un valor `Drop` en un contexto de movimiento.
##
## `vnode` es la expresión que se enlaza, asigna o devuelve. Si es un binding
## local, queda movido; si vive en un sitio prestado, es `E0081`.
##
## ## Memoria
## Puede emitir un diagnóstico.
weave consume_value with s as ref to state.SemaState, vnode as int into void:
    if vnode < 0:
        return
    var v as int is vnode
    var guard as int is 0
    while (calling astutil.kind_of with s->ast, v) == pskind.NodeKind.NdParenExpr and guard < 8:
        var inner as int is calling astutil.node_child with s->ast, v, 0
        if inner < 0:
            return
        set v is inner
        set guard is guard + 1
    var k as pskind.NodeKind is calling astutil.kind_of with s->ast, v
    if k == pskind.NodeKind.NdVarRef:
        var tok as int is calling astutil.token_child with s->ast, v, 0
        if tok < 0:
            return
        var txt as string is calling astutil.token_text with s->src, s->lex, tok
        defer banish txt
        var sid as int is calling symbols.lookup_name with s->symbols, txt
        if sid < 0:
            return
        var sv as sym.SemaSymbol is calling symbols.symbol_at with s->symbols, sid
        if sv.kind == sym.SemaSymbolKind.SkParam:
            calling sdiag.node_error with s->bag, s->src, sdiag.CODE_IMPLICIT_COPY, (calling astutil.start_of with s->ast, v), (calling astutil.end_of with s->ast, v), "cannot move out of the borrowed parameter '{txt}'", "A parameter is a borrow: call '.clone()' to get an owned value, or return a 'ref to T'.", ""
            return
        if sv.kind == sym.SemaSymbolKind.SkStaticVar:
            return
        calling mark_moved with s, sid
        return
    if k == pskind.NodeKind.NdFieldAccess or k == pskind.NodeKind.NdArrowAccess or k == pskind.NodeKind.NdAtExpr or k == pskind.NodeKind.NdAtAccess or k == pskind.NodeKind.NdDotAccess:
        calling sdiag.node_error with s->bag, s->src, sdiag.CODE_IMPLICIT_COPY, (calling astutil.start_of with s->ast, v), (calling astutil.end_of with s->ast, v), "cannot move a field out of a borrowed place", "Move the whole value, or call '.clone()' on the field to get an owned copy.", ""

## Comprueba que un valor `Drop` no se use después de moverse.
##
## ## Memoria
## Puede emitir un diagnóstico.
weave check_moved_use with s as ref to state.SemaState, sv as sym.SemaSymbol, at_node as int, name as string into bool:
    if (sv.flags & sym.SYM_DROP_MOVED) == 0:
        return false
    calling sdiag.node_error with s->bag, s->src, sdiag.CODE_USE_AFTER_MOVE, (calling astutil.start_of with s->ast, at_node), (calling astutil.end_of with s->ast, at_node), "value '{name}' was moved and cannot be used again", "Clone it before the move with '.clone()', or bind a new value.", ""
    return true

## Nombres base de los handles de `std.consortium` que se copian compartiendo
## (la copia retiene; no es un movimiento).
const SHARE_NAMES as string is "Rc|WeakRc|WeakArc"

## `true` si `ty` es un handle `Rc`/`WeakRc`/`WeakArc`.
##
## ## Memoria
## Compara nombres; no asigna.
weave type_is_share with s as ref to state.SemaState, ty as int into bool:
    if ty <= 0 or ty >= s->types->types.len:
        return false
    var t as tk.SemaType is calling types.at with s->types, ty
    var steps as int is 0
    while steps < 32 and (t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal):
        if t.b <= 0:
            return false
        set t is calling types.at with s->types, t.b
        set steps is steps + 1
    if t.kind != tk.SemaTypeKind.TkRune or t.a < 0 or t.a >= s->types->nominal_infos.len:
        return false
    var info as types.SemaNominalInfo is (s->types->nominal_infos at t.a)
    if info.template_info >= 0 and info.template_info < s->types->nominal_infos.len:
        set info is (s->types->nominal_infos at info.template_info)
    var bn as string is calling npool.text with s->names, info.base_name
    return bn == "Rc" or bn == "WeakRc" or bn == "WeakArc"
