## psc/sema/symbols/table.pengu — tabla de símbolos, scopes y registros.
##
## Es el equivalente de `SymbolTable` de stage0, pero con IDs enteros y mapas
## indexados por `NameId`. El checker entra y sale de scopes; el colector
## registra tipos, funciones, métodos, consts, genéricos e imports.
##
## ## Memoria
## `SemaSymbols` es dueño de `symbols`, `scopes`, `templates`, `instances`,
## `const_values`, sus mapas y sus listas de strings. `free_symbols` lo libera
## todo. El `NamePool` y la tabla de tipos son prestados y viven más.


import std.builder

import psc.sema.names as npool
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.symbols.symbol as sym
import psc.sema.symbols.scope as scope

insignia sema_symbols_

## Tabla de símbolos completa.
##
## ## Memoria
## Sin `derive Nexus`: los mapas de cada scope y las listas de strings se
## liberan explícitamente en `free_symbols`.
rune SemaSymbols:
    ## Pool prestado.
    names as ref to npool.NamePool
    ## Tabla de tipos prestada.
    types as ref to types.SemaTypeTable
    ## Símbolos en orden de creación.
    symbols as vector of sym.SemaSymbol
    ## Scopes en orden de creación; el 0 es el global.
    scopes as vector of scope.SemaScope
    ## Scope actual.
    current as int
    ## Registros por `NameId`.
    runes as map of int, int
    echos as map of int, int
    omens as map of int, int
    aliases as map of int, int
    seals as map of int, int
    concepts as map of int, int
    functions as map of int, int
    consts as map of int, int
    methods as map of int, int
    ## `SymbolId` de método -> TypeId del receptor declarado.
    method_receiver as map of int, int
    mutating_methods as map of int, int
    generic_runes as map of int, int
    generic_echos as map of int, int
    generic_omens as map of int, int
    generic_aliases as map of int, int
    generic_concepts as map of int, int
    generic_functions as map of int, int
    generic_methods as map of int, int
    container_methods as map of int, int
    generic_owner as map of int, int
    bind_owner as map of int, int
    primitive_owner as map of int, int
    shard_bounds as map of int, int
    ## Plantillas genéricas.
    templates as vector of sym.SemaTemplate
    ## Instancias monomorfizadas.
    instances as vector of sym.SemaInstance
    ## Claves de instancias (NameId compuesto).
    instance_keys as map of int, int
    ## `TypeId` de instancia -> índice en `instances`.
    instance_by_type as map of int, int
    ## Args de instancia, aplanados.
    instance_args as vector of int
    ## Valores constantes.
    const_values as vector of sym.SemaConst
    ## Bounds de símbolos, aplanados (`NameId`).
    symbol_bounds as vector of int
    ## Tipos registrados por módulo: clave compuesta -> TypeId.
    module_type_keys as map of int, int
    ## `NameId -> TypeId` para `module_type_keys`.
    module_types as map of int, int
    ## Includes/links/ldflags/imports en orden.
    includes as vector of string
    links as vector of string
    ## Módulo que declaró cada `link`, en paralelo a `links`.
    link_modules as vector of int
    ldflags as vector of string
    imports as vector of string
    ## Orden topológico de módulos (IDs de módulo).
    import_order as vector of int
    ## Grafo de imports: `module id -> lista de destinos` (índice en listas).
    import_graph as vector of int
    ## `true` si el módulo usa `include`.
    has_includes as bool
    ## `insignia` del módulo actual.
    insignia as int
    ## Módulo actual (`-1` fuera de módulo).
    current_module as int
    ## `scope -> module id`, para resolver nombres visibles.
    module_of_scope as map of int, int
    ## `module id -> scope` del módulo.
    scope_of_module as map of int, int
    ## Primer índice de `import_edges` por módulo.
    import_first as map of int, int
    ## Número de imports directos por módulo.
    import_count as map of int, int
    ## Destinos de import, aplanados y contiguos por módulo.
    import_edges as vector of int
    ## `NameId` del alias -> índice del último `SkImport` con ese nombre.
    ## Acelera el fallback de `lookup_name` (antes recorría todos los símbolos).
    import_by_name as map of int, int

## Crea la tabla y registra builtins.
##
## ## Memoria
## Asigna listas/mapas; `free_symbols` los libera.
weave new_symbols with t as ref to types.SemaTypeTable, pool as ref to npool.NamePool into SemaSymbols:
    var s as SemaSymbols is with names is pool, types is t, symbols is vector of sym.SemaSymbol, scopes is vector of scope.SemaScope, current is -1, runes is map of int, int, echos is map of int, int, omens is map of int, int, aliases is map of int, int, seals is map of int, int, concepts is map of int, int, functions is map of int, int, consts is map of int, int, methods is map of int, int, method_receiver is map of int, int, mutating_methods is map of int, int, generic_runes is map of int, int, generic_echos is map of int, int, generic_omens is map of int, int, generic_aliases is map of int, int, generic_concepts is map of int, int, generic_functions is map of int, int, generic_methods is map of int, int, container_methods is map of int, int, generic_owner is map of int, int, bind_owner is map of int, int, primitive_owner is map of int, int, shard_bounds is map of int, int, templates is vector of sym.SemaTemplate, instances is vector of sym.SemaInstance, instance_keys is map of int, int, instance_by_type is map of int, int, instance_args is vector of int, const_values is vector of sym.SemaConst, symbol_bounds is vector of int, module_type_keys is map of int, int, module_types is map of int, int, includes is vector of string, links is vector of string, link_modules is vector of int, ldflags is vector of string, imports is vector of string, import_order is vector of int, import_graph is vector of int, has_includes is false, insignia is -1, current_module is -1, module_of_scope is map of int, int, scope_of_module is map of int, int, import_first is map of int, int, import_count is map of int, int, import_edges is vector of int, import_by_name is map of int, int
    calling new_global_scope with (sigil of s)
    calling init_builtins with (sigil of s)
    return s

## Libera la tabla completa.
##
## ## Memoria
## Libera mapas de scopes, listas y strings; no libera el pool ni los tipos.
weave free_symbols with s as ref to SemaSymbols into void:
    var i as int is 0
    while i < s->scopes.len:
        var sc as scope.SemaScope is (s->scopes at i)
        calling scope.free_scope with (sigil of sc)
        set i is i + 1
    banish s->scopes
    banish s->symbols
    banish s->runes
    banish s->echos
    banish s->omens
    banish s->aliases
    banish s->seals
    banish s->concepts
    banish s->functions
    banish s->consts
    banish s->methods
    banish s->method_receiver
    banish s->mutating_methods
    banish s->generic_runes
    banish s->generic_echos
    banish s->generic_omens
    banish s->generic_aliases
    banish s->generic_concepts
    banish s->generic_functions
    banish s->generic_methods
    banish s->container_methods
    banish s->generic_owner
    banish s->bind_owner
    banish s->primitive_owner
    banish s->shard_bounds
    banish s->templates
    banish s->instances
    banish s->instance_keys
    banish s->instance_by_type
    banish s->instance_args
    banish s->const_values
    banish s->symbol_bounds
    banish s->module_type_keys
    banish s->module_types
    calling free_strings with s->includes
    calling free_strings with s->links
    banish s->link_modules
    calling free_strings with s->ldflags
    calling free_strings with s->imports
    banish s->import_order
    banish s->import_graph
    banish s->module_of_scope
    banish s->scope_of_module
    banish s->import_first
    banish s->import_count
    banish s->import_edges
    banish s->import_by_name

## Libera una lista de strings owned.
##
## ## Memoria
## Libera cada elemento y la lista.
weave free_strings with xs as vector of string into void:
    var i as int is 0
    while i < xs.len:
        banish xs at (i)
        set i is i + 1
    banish xs

# ---------------------------------------------------------------------------
# Scopes
# ---------------------------------------------------------------------------

## Crea el scope global y lo activa.
##
## ## Memoria
## Añade un scope a la lista.
weave new_global_scope with s as ref to SemaSymbols into void:
    var g as scope.SemaScope is calling scope.new_scope with scope.SemaScopeKind.SgGlobal, -1, 0, 9999999
    calling s->scopes.push with g
    set s->current is 0

## Entra en un scope hijo.
##
## Hereda `in_loop`, `in_or_block`, `return_type`, `enchanting_type` y
## `is_ritual` del padre si no se especifican.
##
## ## Memoria
## Añade un scope; liberar con `pop_scope`.
weave push_scope with s as ref to SemaSymbols, kind as scope.SemaScopeKind, start_line as int, end_line as int into int:
    var parent as int is s->current
    var p as scope.SemaScope is (s->scopes at parent)
    var child as scope.SemaScope is calling scope.new_scope with kind, parent, start_line, end_line
    set child.return_type is p.return_type
    set child.enchanting_type is p.enchanting_type
    set child.in_loop is p.in_loop
    set child.in_or_block is p.in_or_block
    set child.is_ritual is p.is_ritual
    set child.bounds_first is p.bounds_first
    set child.bounds_count is p.bounds_count
    if kind == scope.SemaScopeKind.SgLambda:
        set child.in_loop is false
        set child.return_type is -1
        set child.enchanting_type is -1
    if kind == scope.SemaScopeKind.SgEnchanting:
        set child.in_loop is p.in_loop
    var idx as int is s->scopes.len
    calling s->scopes.push with child
    set s->current is idx
    return idx

## Sale del scope actual.
##
## ## Memoria
## Ajusta `end_line`; no libera nada.
weave pop_scope with s as ref to SemaSymbols, end_line as int into void:
    var cur as int is s->current
    if cur <= 0:
        return
    var sc as scope.SemaScope is (s->scopes at cur)
    if end_line > 0:
        set sc.end_line is end_line
    set s->scopes at (cur) is sc
    set s->current is sc.parent

## Marca un scope como cuerpo de `or:`.
##
## `in_or_block` hereda a los scopes hijos para que `error` siga siendo
## visible dentro de `if`/`when`/`for` anidados en el bloque.
##
## ## Memoria
## O(1); escribe el scope indicado.
weave mark_or_block with s as ref to SemaSymbols, scope_id as int into void:
    if scope_id < 0 or scope_id >= s->scopes.len:
        return
    var sc as scope.SemaScope is (s->scopes at scope_id)
    set sc.in_or_block is true
    set s->scopes at (scope_id) is sc

## Scope actual.
##
## ## Memoria
## Copia POD.
weave current_scope with s as ref to SemaSymbols into scope.SemaScope:
    return (s->scopes at s->current)

## Registra el scope de un módulo y su inverso.
##
## ## Memoria
## Añade dos entradas de mapa.
weave register_module_scope with s as ref to SemaSymbols, module_id as int, scope_id as int into void:
    calling s->scope_of_module.put with module_id, scope_id
    calling s->module_of_scope.put with scope_id, module_id

## Registra un import directo entre módulos.
##
## ## Memoria
## Añade una entrada a `import_edges` y ajusta contadores.
weave register_import with s as ref to SemaSymbols, importer as int, target as int into void:
    if not (calling s->import_first.has with importer):
        calling s->import_first.put with importer, s->import_edges.len
        calling s->import_count.put with importer, 0
    var count as int is calling s->import_count.get with importer
    calling s->import_edges.push with target
    calling s->import_count.put with importer, count + 1

## Scope de un módulo (`-1` si no se registró).
##
## ## Memoria
## O(1).
weave scope_of_module with s as ref to SemaSymbols, module_id as int into int:
    if calling s->scope_of_module.has with module_id:
        return calling s->scope_of_module.get with module_id
    return -1

## Lookup por `NameId` sólo en la cadena de scopes actual.
##
## ## Memoria
## O(profundidad de scopes).
weave lookup_scope_chain with s as ref to SemaSymbols, name as int into int:
    var cur as int is s->current
    while cur >= 0:
        var sc as scope.SemaScope is (s->scopes at cur)
        var found as int is calling scope.scope_lookup_local with (sigil of sc), name
        if found >= 0:
            return found
        set cur is sc.parent
    return -1

## Lookup en los módulos visibles desde el módulo actual.
##
## Recorre el cierre de imports directos en anchura (primero el propio módulo
## ya lo cubre la cadena de scopes). Nunca consulta módulos ajenos al grafo de
## imports del archivo.
##
## ## Memoria
## Asigna dos contenedores temporales; los libera.
weave lookup_visible with s as ref to SemaSymbols, name as int into int:
    if s->current_module < 0:
        return -1
    var queue as vector of int is vector of int
    defer banish queue
    var seen as map of int, int is map of int, int
    defer banish seen
    calling queue.push with s->current_module
    calling seen.put with s->current_module, s->current_module
    var qi as int is 0
    while qi < queue.len:
        var mid as int is (queue at qi)
        if mid != s->current_module:
            var scp as int is calling scope_of_module with s, mid
            if scp >= 0:
                var hit as int is calling lookup_in_scope with s, scp, name
                if hit >= 0:
                    return hit
        if calling s->import_first.has with mid:
            var first as int is calling s->import_first.get with mid
            var count as int is calling s->import_count.get with mid
            var k as int is 0
            while k < count:
                var target as int is (s->import_edges at (first + k))
                if target >= 0 and not (calling seen.has with target):
                    calling seen.put with target, target
                    calling queue.push with target
                set k is k + 1
        set qi is qi + 1
    return -1

## Lookup por `NameId` desde el scope actual.
##
## Orden: cadena de scopes (módulo actual incluido), módulos visibles por
## imports, y sólo como último recurso los registros globales históricos.
##
## ## Memoria
## O(profundidad de scopes + módulos visibles).
weave lookup with s as ref to SemaSymbols, name as int into int:
    var found as int is calling lookup_scope_chain with s, name
    if found >= 0:
        return found
    var visible as int is calling lookup_visible with s, name
    if visible >= 0:
        return visible
    # Fallback heredado: cuando no hay módulo activo (codegen, bootstrap) o
    # para helpers de std que se usan sin cualificar.
    if calling s->functions.has with name:
        return calling s->functions.get with name
    if calling s->consts.has with name:
        return calling s->consts.get with name
    return -1

## Lookup por string.
##
## ## Memoria
## Busca el nombre en el pool; si no existe no asigna.
weave lookup_name with s as ref to SemaSymbols, name as string into int:
    var id as int is calling npool.find with s->names, name
    if id >= 0:
        var found as int is calling lookup with s, id
        if found >= 0:
            return found
    else:
        # Ningún símbolo puede llamarse `name`: el pool es la única fuente de
        # nombres (`symbol.name` siempre sale de él). Evita recorrer todos los
        # símbolos por cada búsqueda de un nombre C/mangled que no existe.
        return -1
    # Fallback para alias de import en scopes cuyo padre no se enlazó
    # correctamente (bootstrap stage2), restringido al módulo actual.
    if calling s->import_by_name.has with id:
        var fast as int is calling s->import_by_name.get with id
        if fast >= 0 and fast < s->symbols.len:
            var fv as sym.SemaSymbol is (s->symbols at fast)
            if fv.kind == sym.SemaSymbolKind.SkImport and (s->current_module < 0 or fv.module == s->current_module):
                return fast
    # El mapa cubre todos los `SkImport`: se actualiza en `symbol_define`,
    # único camino que crea imports. No hace falta recorrer la tabla entera.
    return -1

## Lookup local por `NameId`.
##
## ## Memoria
## O(1).
weave symbol_lookup_local with s as ref to SemaSymbols, name as int into int:
    var sc as scope.SemaScope is (s->scopes at s->current)
    return calling scope.scope_lookup_local with (sigil of sc), name

## Define un símbolo en el scope actual.
##
## ## Memoria
## Añade a `symbols` y al mapa del scope.
weave symbol_define with s as ref to SemaSymbols, symbol as sym.SemaSymbol into int:
    var id as int is s->symbols.len
    if symbol.kind == sym.SemaSymbolKind.SkImport:
        calling s->import_by_name.put with symbol.name, id
    calling s->symbols.push with symbol
    var sc as scope.SemaScope is (s->scopes at s->current)
    calling scope.scope_define with (sigil of sc), symbol.name, id
    set s->scopes at (s->current) is sc
    return id

## Añade un símbolo sin ligarlo a un scope (métodos).
##
## ## Memoria
## Hace `push` en `symbols`.
weave add_symbol with s as ref to SemaSymbols, symbol as sym.SemaSymbol into int:
    var id as int is s->symbols.len
    calling s->symbols.push with symbol
    return id

## Define un símbolo en un scope concreto.
##
## ## Memoria
## Añade a `symbols`.
weave symbol_define_in with s as ref to SemaSymbols, scope_id as int, symbol as sym.SemaSymbol into int:
    var id as int is s->symbols.len
    calling s->symbols.push with symbol
    var sc as scope.SemaScope is (s->scopes at scope_id)
    calling scope.scope_define with (sigil of sc), symbol.name, id
    set s->scopes at (scope_id) is sc
    return id

## Crea un símbolo con defaults.
##
## ## Memoria
## Devuelve un POD; no asigna.
weave make_symbol with names as ref to npool.NamePool, name as string, type_id as int, kind as sym.SemaSymbolKind into sym.SemaSymbol:
    var nid as int is calling npool.intern with names, name
    return with name is nid, type is type_id, kind is kind, flags is 0, c_name is nid, alias_of is -1, module is -1, line is 0, col is 0, start is -1, end is -1, attrs_node is -1, doc is -1, const_id is -1, bounds_first is 0, bounds_count is 0, module_scope is -1

# ---------------------------------------------------------------------------
# Registros
# ---------------------------------------------------------------------------

## Registra un tipo nominal por nombre.
##
## ## Memoria
## O(1) promedio.
weave symbol_define_type with s as ref to SemaSymbols, kind as sym.SemaSymbolKind, name as int, type_id as int into int:
    var symv as sym.SemaSymbol is calling make_symbol with s->names, "", type_id, kind
    set symv.name is name
    set symv.c_name is name
    if kind == sym.SemaSymbolKind.SkRune:
        calling s->runes.put with name, type_id
    else if kind == sym.SemaSymbolKind.SkEcho:
        calling s->echos.put with name, type_id
    else if kind == sym.SemaSymbolKind.SkOmen:
        calling s->omens.put with name, type_id
    else if kind == sym.SemaSymbolKind.SkAlias:
        calling s->aliases.put with name, type_id
    else if kind == sym.SemaSymbolKind.SkSeal:
        calling s->seals.put with name, type_id
    else if kind == sym.SemaSymbolKind.SkConcept:
        calling s->concepts.put with name, type_id
    return calling symbol_define with s, symv

## Lookup de tipo por `NameId`.
##
## Prefiere la declaración del módulo actual (bug 17): un `rune Handler` local
## no debe perder contra el alias `Handler` importado. Después busca en los
## módulos visibles y sólo al final en los registros globales heredados.
##
## ## Memoria
## O(profundidad de scopes + módulos visibles).
weave lookup_type with s as ref to SemaSymbols, name as int into int:
    var sid as int is calling lookup_scope_chain with s, name
    if sid >= 0:
        var sv as sym.SemaSymbol is (s->symbols at sid)
        if sv.kind == sym.SemaSymbolKind.SkType or sv.kind == sym.SemaSymbolKind.SkRune or sv.kind == sym.SemaSymbolKind.SkEcho or sv.kind == sym.SemaSymbolKind.SkOmen or sv.kind == sym.SemaSymbolKind.SkAlias or sv.kind == sym.SemaSymbolKind.SkSeal or sv.kind == sym.SemaSymbolKind.SkConcept:
            return sv.type
    var vsid as int is calling lookup_visible with s, name
    if vsid >= 0:
        var vsv as sym.SemaSymbol is (s->symbols at vsid)
        if vsv.kind == sym.SemaSymbolKind.SkType or vsv.kind == sym.SemaSymbolKind.SkRune or vsv.kind == sym.SemaSymbolKind.SkEcho or vsv.kind == sym.SemaSymbolKind.SkOmen or vsv.kind == sym.SemaSymbolKind.SkAlias or vsv.kind == sym.SemaSymbolKind.SkSeal or vsv.kind == sym.SemaSymbolKind.SkConcept:
            return vsv.type
    if calling s->aliases.has with name:
        return calling s->aliases.get with name
    if calling s->seals.has with name:
        return calling s->seals.get with name
    if calling s->concepts.has with name:
        return calling s->concepts.get with name
    if calling s->runes.has with name:
        return calling s->runes.get with name
    if calling s->echos.has with name:
        return calling s->echos.get with name
    if calling s->omens.has with name:
        return calling s->omens.get with name
    return -1

## Lookup local en un scope concreto.
##
## ## Memoria
## O(1) promedio.
weave lookup_in_scope with s as ref to SemaSymbols, scope_id as int, name as int into int:
    if scope_id < 0 or scope_id >= s->scopes.len:
        return -1
    var sc as scope.SemaScope is (s->scopes at scope_id)
    return calling scope.scope_lookup_local with (sigil of sc), name

## Lookup de tipo por string.
##
## ## Memoria
## Busca en el pool.
weave lookup_type_name with s as ref to SemaSymbols, name as string into int:
    # `mod.Type`: resolver el alias y buscar en el scope del módulo.
    var last_dot as int is -1
    var i as int is 0
    var n as int is name length
    while i < n:
        var ch as string is name at i
        if ch == ".":
            set last_dot is i
        banish ch
        set i is i + 1
    if last_dot > 0:
        var alias as string is calling symbol_substring with name, 0, last_dot
        defer banish alias
        var tid as int is calling npool.find with s->names, alias
        if tid >= 0:
            var imp as int is calling lookup with s, tid
            if imp >= 0:
                var sv as sym.SemaSymbol is (s->symbols at imp)
                if sv.kind == sym.SemaSymbolKind.SkImport:
                    var last as string is calling symbol_substring with name, last_dot + 1, n
                    defer banish last
                    var lid as int is calling npool.find with s->names, last
                    if lid >= 0:
                        var local as int is calling lookup_in_scope with s, sv.module_scope, lid
                        if local >= 0:
                            var lv as sym.SemaSymbol is (s->symbols at local)
                            return lv.type
    var id as int is calling npool.find with s->names, name
    if id < 0:
        return -1
    return calling lookup_type with s, id

## Substring con copia owned.
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave symbol_substring with s as string, start as int, end as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var i as int is start
    while i < end:
        var ch as string is s at i
        calling sb.append with ch
        banish ch
        set i is i + 1
    return calling sb.finish

## Registra una función en el scope actual y en `functions`.
##
## ## Memoria
## Añade símbolo/mapa.
weave symbol_define_function with s as ref to SemaSymbols, name as int, fn_type as int into int:
    var symv as sym.SemaSymbol is calling make_symbol with s->names, "", fn_type, sym.SemaSymbolKind.SkWeave
    set symv.name is name
    set symv.c_name is name
    var prev as int is -1
    if calling s->functions.has with name:
        set prev is calling s->functions.get with name
    var id as int is calling symbol_define with s, symv
    calling s->functions.put with name, id
    return id

## Lookup de función por `NameId`.
##
## ## Memoria
## O(1).
weave lookup_function with s as ref to SemaSymbols, name as int into int:
    if calling s->functions.has with name:
        return calling s->functions.get with name
    return -1

## Registra una constante.
##
## ## Memoria
## Añade símbolo y mapa.
weave symbol_define_const with s as ref to SemaSymbols, name as int, type_id as int, value as sym.SemaConst into int:
    var cid as int is s->const_values.len
    calling s->const_values.push with value
    var symv as sym.SemaSymbol is calling make_symbol with s->names, "", type_id, sym.SemaSymbolKind.SkConst
    set symv.name is name
    set symv.c_name is name
    set symv.const_id is cid
    var id as int is calling symbol_define with s, symv
    calling s->consts.put with name, id
    return id

## Lookup de constante.
##
## ## Memoria
## O(1).
weave lookup_const with s as ref to SemaSymbols, name as int into int:
    if calling s->consts.has with name:
        return calling s->consts.get with name
    return -1

## Construye una clave `recv \x1f method` y la interna.
##
## ## Memoria
## Devuelve un `NameId`; el string temporal se libera.
weave method_key with s as ref to SemaSymbols, receiver as int, method as int into int:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append_int with receiver
    calling sb.append with "\x1f"
    calling sb.append_int with method
    var key as string is calling sb.finish
    defer banish key
    return calling npool.intern with s->names, key

## `true` si el tipo contiene un `TkTypeParam`.
##
## ## Memoria
## O(profundidad).
weave _has_param with t as ref to types.SemaTypeTable, id as int into bool:
    if id <= 0:
        return false
    var ty as tk.SemaType is calling types.at with t, id
    if ty.kind == tk.SemaTypeKind.TkTypeParam:
        return true
    if ty.kind == tk.SemaTypeKind.TkRef or ty.kind == tk.SemaTypeKind.TkFrozen or ty.kind == tk.SemaTypeKind.TkArray or ty.kind == tk.SemaTypeKind.TkList or ty.kind == tk.SemaTypeKind.TkSlice or ty.kind == tk.SemaTypeKind.TkMany or ty.kind == tk.SemaTypeKind.TkMaybe or ty.kind == tk.SemaTypeKind.TkRange:
        return calling _has_param with t, ty.a
    if ty.kind == tk.SemaTypeKind.TkMap or ty.kind == tk.SemaTypeKind.TkResult:
        return (calling _has_param with t, ty.a) or (calling _has_param with t, ty.b)
    return false

## `true` si la clase es un contenedor con métodos genéricos.
##
## ## Memoria
## O(1).
weave _is_container_kind with k as tk.SemaTypeKind into bool:
    return k == tk.SemaTypeKind.TkList or k == tk.SemaTypeKind.TkMap or k == tk.SemaTypeKind.TkMaybe or k == tk.SemaTypeKind.TkResult or k == tk.SemaTypeKind.TkSlice or k == tk.SemaTypeKind.TkMany or k == tk.SemaTypeKind.TkArray or k == tk.SemaTypeKind.TkRange

## Clave `kind \x1f method` para el fallback de métodos de contenedor.
##
## ## Memoria
## Devuelve un `NameId`; el string temporal se libera.
weave container_method_key with s as ref to SemaSymbols, kind as tk.SemaTypeKind, method as int into int:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "k"
    calling sb.append_int with (kind to int)
    calling sb.append with "\x1f"
    calling sb.append_int with method
    var key as string is calling sb.finish
    defer banish key
    return calling npool.intern with s->names, key

## Registra un método.
##
## ## Memoria
## Añade símbolo y mapa.
weave symbol_define_method with s as ref to SemaSymbols, receiver as int, method as int, fn_type as int into int:
    var symv as sym.SemaSymbol is calling make_symbol with s->names, "", fn_type, sym.SemaSymbolKind.SkWeave
    set symv.name is method
    set symv.c_name is method
    var id as int is calling add_symbol with s, symv
    var key as int is calling method_key with s, receiver, method
    calling s->methods.put with key, id
    calling s->method_receiver.put with id, receiver
    # Fallback solo para receptores que son parámetros de tipo. Los métodos de
    # un receptor concreto (Vec4, f64, ...) deben resolverse por `methods` y no
    # pisar el fallback genérico con el último `get_*` registrado.
    var rty as tk.SemaType is calling types.at with s->types, receiver
    if rty.kind == tk.SemaTypeKind.TkTypeParam:
        calling s->generic_methods.put with method, id
    else if calling _is_container_kind with rty.kind:
        if calling _has_param with s->types, receiver:
            var ckey as int is calling container_method_key with s, rty.kind, method
            calling s->container_methods.put with ckey, id
    return id

## Registra un método con nombre C explícito (codecs de `derive Json`).
##
## ## Memoria
## Añade símbolo y mapa; el `c_name` se interna.
weave symbol_define_method_cname with s as ref to SemaSymbols, receiver as int, method as int, fn_type as int, cname as string into int:
    var symv as sym.SemaSymbol is calling make_symbol with s->names, "", fn_type, sym.SemaSymbolKind.SkWeave
    set symv.name is method
    var cid as int is calling npool.intern with s->names, cname
    set symv.c_name is cid
    var id as int is calling add_symbol with s, symv
    var key as int is calling method_key with s, receiver, method
    calling s->methods.put with key, id
    calling s->method_receiver.put with id, receiver
    return id

## Lookup de método.
##
## ## Memoria
## O(1).
weave lookup_method with s as ref to SemaSymbols, receiver as int, method as int into int:
    var exact as int is calling lookup_method_exact with s, receiver, method
    if exact >= 0:
        return exact
    var rk as tk.SemaType is calling types.at with s->types, receiver
    if rk.kind == tk.SemaTypeKind.TkRef:
        var ri as tk.SemaType is calling types.at with s->types, rk.a
        if ri.kind == tk.SemaTypeKind.TkAlias or ri.kind == tk.SemaTypeKind.TkSeal:
            return calling lookup_method with s, (calling types.underlying with s->types, receiver), method
        set rk is ri
    if calling _is_container_kind with rk.kind:
        var ckey2 as int is calling container_method_key with s, rk.kind, method
        if calling s->container_methods.has with ckey2:
            return calling s->container_methods.get with ckey2
    if calling s->generic_methods.has with method:
        return calling s->generic_methods.get with method
    # Promoción por `fundere`: el método del embed se puede llamar desde el
    # host. `ritual` no se promueve. Si está en más de un embed, no se elige
    # "el primero": se devuelve -1 y la sema emite E0088.
    var cnt as int is calling count_promoted_method with s, receiver, method, 0
    if cnt > 1:
        return -1
    if cnt == 1:
        var prom as int is calling lookup_method_promoted with s, receiver, method
        if prom >= 0:
            return prom
    return -1

## Resultado de `find_promoted_method` cuando el método no está en ningún
## embed: -1. Un resultado `>= 0` es el símbolo del método.
##
## ## Memoria
## No asigna.
const METHOD_PROMOTED_NONE as int is -1

## Resuelve el tipo de un embed hasta su nominal (sigue `ref`, `frozen`,
## `alias` y `seal`), o -1 si no es un rune/echo.
##
## ## Memoria
## No asigna.
weave embed_nominal_type with s as ref to SemaSymbols, ty as int into int:
    var cur as int is ty
    var guard as int is 0
    while guard < 32:
        var t as tk.SemaType is calling types.at with s->types, cur
        if t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkFrozen or t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
            set cur is t.a
            if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
                set cur is t.b
        else if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho:
            return cur
        else:
            return -1
        set guard is guard + 1
    return -1

## ¿El símbolo `sid` es un método promovible desde un embed?
##
## `ritual` no se promueve: construye el embed, no el host (§4.5 del diseño).
##
## ## Memoria
## No asigna.
weave method_promotable with s as ref to SemaSymbols, sid as int into bool:
    if sid < 0:
        return false
    var sy as sym.SemaSymbol is (s->symbols at sid)
    if (sy.flags & sym.SYM_RITUAL) != 0:
        return false
    return true

## Cuenta cuántos embeds (recursivamente) exponen el método `mid`.
##
## Devuelve 0, 1 o 2 (saturado). El 2 es la ambigüedad E0088.
##
## ## Memoria
## No asigna.
weave count_promoted_method with s as ref to SemaSymbols, ty as int, mid as int, depth as int into int:
    if depth > 32:
        return 0
    var nom as int is calling embed_nominal_type with s, ty
    if nom < 0:
        return 0
    var nt as tk.SemaType is calling types.at with s->types, nom
    var info as types.SemaNominalInfo is (s->types->nominal_infos at nt.a)
    var total as int is 0
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (s->types->fields at (info.fields_first + i))
        if (f.flags & types.FIELD_EMBED) != 0:
            var here as int is 0
            if calling method_promotable with s, (calling lookup_method_exact with s, f.type, mid):
                set here is 1
            else:
                set here is calling count_promoted_method with s, f.type, mid, depth + 1
            set total is total + here
            if total > 1:
                return 2
        set i is i + 1
    return total

## Busca el método `mid` en los embeds de `ty` y rellena `path` con los índices
## de campo del camino (de dentro hacia fuera; el llamador lo invierte).
##
## Devuelve el símbolo del método o -1.
##
## ## Memoria
## Añade índices a `path`.
weave find_promoted_method with s as ref to SemaSymbols, ty as int, mid as int, path as ref to vector of int, depth as int into int:
    if depth > 32:
        return -1
    var nom as int is calling embed_nominal_type with s, ty
    if nom < 0:
        return -1
    var nt as tk.SemaType is calling types.at with s->types, nom
    var info as types.SemaNominalInfo is (s->types->nominal_infos at nt.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (s->types->fields at (info.fields_first + i))
        if (f.flags & types.FIELD_EMBED) != 0:
            var sid as int is calling lookup_method_exact with s, f.type, mid
            if calling method_promotable with s, sid:
                calling path->push with i
                return sid
            var deeper as int is calling find_promoted_method with s, f.type, mid, path, depth + 1
            if deeper >= 0:
                calling path->push with i
                return deeper
        set i is i + 1
    return -1

## Método promovido por `fundere`: el del host gana (lo resuelve
## `lookup_method_exact` antes); si es único en un embed, se promueve; si está
## en más de uno, el llamador emite E0088.
##
## ## Memoria
## Asigna la lista temporal del camino; la libera.
weave lookup_method_promoted with s as ref to SemaSymbols, receiver as int, method as int into int:
    var path as vector of int is vector of int
    var sid as int is calling find_promoted_method with s, receiver, method, (sigil of path), 0
    banish path
    return sid

## Busca sólo el método exacto del receptor (sin fallback genérico).
##
## ## Memoria
## O(1) promedio.
weave lookup_method_exact with s as ref to SemaSymbols, receiver as int, method as int into int:
    var key as int is calling method_key with s, receiver, method
    if calling s->methods.has with key:
        return calling s->methods.get with key
    # Una instancia `Box of int` no tiene métodos propios en `methods`; usa la
    # plantilla `Box` para resolver el símbolo y deja que F4 lo especialice.
    if calling s->instance_by_type.has with receiver:
        var ii as int is calling s->instance_by_type.get with receiver
        var inst as sym.SemaInstance is (s->instances at ii)
        if inst.template_type > 0 and inst.template_type != receiver:
            var tkey as int is calling method_key with s, inst.template_type, method
            if calling s->methods.has with tkey:
                return calling s->methods.get with tkey
    return -1

## Devuelve la instancia nominal de un `TypeId` (`-1` si no lo es).
##
## ## Memoria
## O(1).
weave instance_for_type with s as ref to SemaSymbols, type_id as int into int:
    if calling s->instance_by_type.has with type_id:
        return calling s->instance_by_type.get with type_id
    return -1

## `true` si el nombre está en el pool.
##
## ## Memoria
## O(1).
weave has_name with s as ref to SemaSymbols, name as int into bool:
    return calling npool.has_id with s->names, name

## Texto de un `NameId`.
##
## ## Memoria
## Préstamo.
weave name_text with s as ref to SemaSymbols, name as int into string:
    return calling npool.text with s->names, name

## `NameId` de un símbolo.
##
## ## Memoria
## Copia POD.
weave symbol_at with s as ref to SemaSymbols, id as int into sym.SemaSymbol:
    if id < 0 or id >= s->symbols.len:
        return calling make_symbol with s->names, "", 0, sym.SemaSymbolKind.SkVar
    return (s->symbols at id)

## Actualiza un símbolo tras crearlo.
##
## ## Memoria
## O(1).
weave symbol_set with s as ref to SemaSymbols, id as int, v as sym.SemaSymbol into void:
    set s->symbols at (id) is v

# ---------------------------------------------------------------------------
# Builtins
# ---------------------------------------------------------------------------

## Registra primitivos, `print` y conceptos builtin.
##
## ## Memoria
## Añade símbolos y tipos a la tabla prestada.
weave init_builtins with s as ref to SemaSymbols into void:
    calling builtin_type with s, "int", "int"
    calling builtin_type with s, "i32", "i32"
    calling builtin_type with s, "i64", "i64"
    calling builtin_type with s, "u32", "u32"
    calling builtin_type with s, "u64", "u64"
    calling builtin_type with s, "i16", "i16"
    calling builtin_type with s, "u16", "u16"
    calling builtin_type with s, "i8", "i8"
    calling builtin_type with s, "u8", "u8"
    calling builtin_type with s, "byte", "u8"
    calling builtin_type with s, "usize", "usize"
    calling builtin_type with s, "isize", "isize"
    calling builtin_type with s, "float", "float"
    calling builtin_type with s, "f32", "float"
    calling builtin_type with s, "f64", "f64"
    calling builtin_type with s, "double", "f64"
    calling builtin_type with s, "bool", "bool"
    calling builtin_type with s, "string", "string"
    calling builtin_type with s, "char", "char"
    calling builtin_type with s, "void", "void"
    calling builtin_type with s, "opaque", "opaque"
    # Conceptos integrados de stage0. Se registran como tipos nominales para
    # que `where T: Real` y `bind` puedan resolverlos.
    calling builtin_concept with s, "Num"
    calling builtin_concept with s, "Integrum"
    calling builtin_concept with s, "Real"
    calling builtin_concept with s, "Par"
    calling builtin_concept with s, "Ordo"
    calling builtin_concept with s, "Vinculum"
    calling builtin_concept with s, "Imago"
    calling builtin_concept with s, "Nexus"
    # `derive Drop` = `Nexus` + destrucción al salir del scope + no copiable
    # de forma implícita (ver `docs/LANGUAGE.md` §13.8).
    calling builtin_concept with s, "Drop"
    calling builtin_concept with s, "Forma"
    calling builtin_concept with s, "Iterabilis"
    calling builtin_concept with s, "Donum"
    # `derive Json` genera codecs C para una runa (ver `check/json.pengu`).
    calling builtin_concept with s, "Json"
    # `print` recibe un `string` (usar `to string` para otros valores) y
    # se baja a `pengu_builtin_print`, un helper del bundle.
    var string_t as int is calling types.base with s->types, "string"
    var void_t as int is 3
    var pname as int is calling npool.intern with s->names, "val"
    var p0 as types.SemaFnParam is with name is pname, type is string_t, flags is 0, default_node is -1
    var pi as int is calling types.add_fn_param with s->types, p0
    var info as types.SemaFnInfo is with params_first is pi, params_count is 1, return_type is void_t, tparams_first is 0, tparams_count is 0, flags is 0, attrs_node is -1
    var ft as int is calling types.fn_type with s->types, info
    var pid as int is calling npool.intern with s->names, "print"
    var fnid as int is calling symbol_define_function with s, pid, ft
    var cid as int is calling npool.intern with s->names, "pengu_builtin_print"
    var psym as sym.SemaSymbol is calling symbol_at with s, fnid
    set psym.c_name is cid
    calling symbol_set with s, fnid, psym

## Registra un concepto integrado.
##
## ## Memoria
## Añade info nominal y símbolo global.
weave builtin_concept with s as ref to SemaSymbols, name as string into void:
    var nid as int is calling npool.intern with s->names, name
    var info as types.SemaNominalInfo is with kind is tk.SemaNominalKind.NkConcept, base_name is nid, c_name is nid, module is -1, flags is types.NIF_PUBLIC, fields_first is 0, fields_count is 0, variants_first is 0, variants_count is 0, tparams_first is 0, tparams_count is 0, derived_first is 0, derived_count is 0, template_info is -1, attrs_node is -1
    var ty as int is calling types.named_type with s->types, info
    var symv as sym.SemaSymbol is calling make_symbol with s->names, "", ty, sym.SemaSymbolKind.SkConcept
    set symv.name is nid
    set symv.c_name is nid
    set symv.module is -1
    calling symbol_define with s, symv

## Registra un tipo primitivo y su símbolo.
##
## ## Memoria
## Añade un símbolo por alias; el `TypeId` se comparte.
weave builtin_type with s as ref to SemaSymbols, spelled as string, canonical as string into void:
    var t as int is calling types.base with s->types, canonical
    var nid as int is calling npool.intern with s->names, spelled
    var symv as sym.SemaSymbol is calling make_symbol with s->names, "", t, sym.SemaSymbolKind.SkType
    set symv.name is nid
    set symv.c_name is nid
    calling symbol_define with s, symv
