## psc/cmd/fmt.pengu — `psc fmt` (formato conservador F6).
##
## Normaliza indentación, espacios finales, saltos y líneas en blanco. No
## reinterpreta strings, triples ni bloques `antiquus`; las líneas dentro de un
## triple se dejan intactas.

import std.archivum
import std.compass
import std.builder
import std.io
import std.spark

import psc.cli.args as cliargs
import psc.sema.names as npool

insignia psc_cmd_fmt_

## Ayuda.
##
## ## Memoria
## No asigna.
weave print_help into void:
    calling spark.println with "Usage: psc fmt [PATHS...] [options]"
    calling spark.println with "  --check       no escribir; exit 1 si cambiaría"
    calling spark.println with "  --diff        mostrar diferencias"
    calling spark.println with "  --stdin       leer stdin y escribir stdout"
    calling spark.println with "  --indent=N    espacios por nivel (default 4)"
    calling spark.println with "  --tabs        indentar con tabs"
    calling spark.println with "  --verbose"
    calling spark.println with "  --help"

## Copia owned.
##
## ## Memoria
## Devuelve string owned.
weave copy with s as string into string:
    return calling npool.copy_string with s

## `true` si `s` termina en `suffix`.
##
## ## Memoria
## O(suffix).
weave ends_with with s as string, suffix as string into bool:
    var n as int is s length
    var m as int is suffix length
    if m > n:
        return false
    return (s at (n - m) to n) == suffix

## `true` si la línea abre/cierra un triple string.
##
## ## Memoria
## O(1).
weave triple_count with line as string into int:
    var b as ref to frozen byte is bytes of line
    var i as int is 0
    var n as int is 0
    while i + 2 < line length:
        if ((b at i) to int) == 34 and ((b at (i + 1)) to int) == 34 and ((b at (i + 2)) to int) == 34:
            set n is n + 1
            set i is i + 3
        else:
            set i is i + 1
    return n

## Configuración de formato.
##
## ## Memoria
## POD.
rune FmtConfig:
    width as int
    tabs as bool
    blank as int

## Carga `.pengufmt.toml` (claves planas `indent`, `tabs`, `blank_lines_max`).
##
## ## Memoria
## Devuelve POD; no retiene.
weave load_config with path as string into FmtConfig:
    var c as FmtConfig is with width is 4, tabs is false, blank is 2
    var dir as string is calling copy with path
    if dir length == 0:
        var cw as maybe string is calling archivum.getcwd
        if cw.is_present:
            banish dir
            set dir is calling copy with cw.value
        banish cw
    if dir length == 0:
        set dir is "."
    if calling archivum.is_file with dir:
        var dn as string is calling compass.cp_dirname with dir
        banish dir
        set dir is dn
    var p as string is "{dir}/.pengufmt.toml"
    var steps as int is 0
    while steps < 8:
        if calling archivum.is_file with p:
            break
        var par as string is calling compass.cp_dirname with dir
        if par == dir:
            banish par
            break
        banish par
        banish dir
        set dir is par
        banish p
        set p is "{dir}/.pengufmt.toml"
        set steps is steps + 1
    var t as maybe string is calling archivum.read_text with p
    if t.is_present:
        var ttext as string is t.value
        var lines as list of string is calling ttext.split with "\n"
        for line in lines:
            var tline as string is line at 0 to (line length)
            var eq as int is 0
            while eq < tline length and (tline at eq to (eq + 1)) != "=":
                set eq is eq + 1
            if eq < tline length:
                var k as string is tline at 0 to eq
                var v as string is tline at (eq + 1) to (tline length)
                var kb as ref to frozen byte is bytes of k
                var ke as int is k length
                while ke > 0 and (((kb at (ke - 1)) to int) == 32 or ((kb at (ke - 1)) to int) == 9):
                    set ke is ke - 1
                set k is k at 0 to ke
                var vb as ref to frozen byte is bytes of v
                var vs as int is 0
                while vs < v length and (((vb at vs) to int) == 32 or ((vb at vs) to int) == 9):
                    set vs is vs + 1
                set v is v at vs to (v length)
                if k == "indent" or k == "tab_size" or k == "indent_size" or k == "indent_width":
                    var pm as maybe int is calling spark.parse_int with v
                    if pm.is_present and pm.value > 0:
                        set c.width is pm.value
                    banish pm
                else if k == "tabs":
                    if v == "true":
                        set c.tabs is true
                    else if v == "false":
                        set c.tabs is false
                else if k == "insert_spaces":
                    if v == "false":
                        set c.tabs is true
                    else if v == "true":
                        set c.tabs is false
                else if k == "blank_lines_max":
                    var pn as maybe int is calling spark.parse_int with v
                    if pn.is_present and pn.value >= 0:
                        set c.blank is pn.value
                    banish pn
                banish k
                banish v
            banish tline
        banish lines
    banish t
    banish p
    banish dir
    return c

## Detecta la unidad de indentación del fuente.
##
## ## Memoria
## O(n).
weave detect_unit with lines as list of string, fallback as int into int:
    var unit as int is 0
    var in_tri as bool is false
    for line in lines:
        if in_tri:
            if (calling triple_count with line) % 2 == 1:
                set in_tri is false
            continue
        if line length == 0:
            continue
        var b as ref to frozen byte is bytes of line
        var lead as int is 0
        var i as int is 0
        while i < line length:
            var c as int is ((b at i) to int)
            if c == 32:
                set lead is lead + 1
                set i is i + 1
            else if c == 9:
                return 1
            else:
                break
        if lead > 0 and (unit == 0 or lead < unit):
            set unit is lead
        var stripped as string is line at i to (line length)
        if (calling triple_count with stripped) % 2 == 1:
            set in_tri is true
        banish stripped
    if unit == 0:
        return fallback
    return unit

## Normaliza espacios en código (nunca dentro de strings).
##
## ## Memoria
## Devuelve string owned.
weave normalize_code with s as string into string:
    var chars as list of char is list of char
    var b as ref to frozen byte is bytes of s
    var i as int is 0
    var in_str as bool is false
    var quote as int is 0
    var raw as bool is false
    while i < s length:
        var c as int is ((b at i) to int)
        if in_str:
            calling chars.push with (c to char)
            if c == 92 and not raw and i + 1 < s length:
                set i is i + 1
                calling chars.push with (((b at i) to int) to char)
            else if c == quote:
                set in_str is false
            set i is i + 1
            continue
        if c == 34 or c == 39:
            set in_str is true
            set quote is c
            set raw is i > 0 and (((b at (i - 1)) to int) == 114)
            calling chars.push with (c to char)
            set i is i + 1
            continue
        if c == 35:
            while i < s length:
                calling chars.push with (((b at i) to int) to char)
                set i is i + 1
            continue
        if c == 44:
            calling chars.push with (44 to char)
            set i is i + 1
            while i < s length:
                var nc as int is ((b at i) to int)
                if nc == 32 or nc == 9:
                    set i is i + 1
                else:
                    break
            calling chars.push with (32 to char)
            continue
        # is/as/into rodeados de whitespace
        var word_len as int is 0
        if c == 105 and i + 1 < s length and ((b at (i + 1)) to int) == 115:
            set word_len is 2
        else if c == 97 and i + 1 < s length and ((b at (i + 1)) to int) == 115:
            set word_len is 2
        else if c == 105 and i + 3 < s length and ((b at (i + 1)) to int) == 110 and ((b at (i + 2)) to int) == 116 and ((b at (i + 3)) to int) == 111:
            set word_len is 4
        if word_len > 0:
            var before_ws as bool is i > 0 and (((b at (i - 1)) to int) == 32 or ((b at (i - 1)) to int) == 9)
            var after_ws as bool is i + word_len < s length and (((b at (i + word_len)) to int) == 32 or ((b at (i + word_len)) to int) == 9)
            if before_ws and after_ws:
                while chars.len > 0:
                    var lastc as char is (chars at (chars.len - 1))
                    if (lastc to int) == 32 or (lastc to int) == 9:
                        var ignored as char is calling chars.pop
                    else:
                        break
                calling chars.push with (32 to char)
                var wi as int is 0
                while wi < word_len:
                    calling chars.push with (((b at (i + wi)) to int) to char)
                    set wi is wi + 1
                calling chars.push with (32 to char)
                set i is i + word_len
                while i < s length:
                    var nc2 as int is ((b at i) to int)
                    if nc2 == 32 or nc2 == 9:
                        set i is i + 1
                    else:
                        break
                continue
        calling chars.push with (c to char)
        set i is i + 1
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    for ch in chars:
        calling sb.append_char with ch
    banish chars
    return calling sb.finish

## Convierte la indentación de una línea.
##
## ## Memoria
## Devuelve string owned.
weave indent_line with line as string, source_unit as int, width as int, tabs as bool into string:
    var b as ref to frozen byte is bytes of line
    var i as int is 0
    var spaces as int is 0
    var tabsn as int is 0
    while i < line length:
        var c as int is ((b at i) to int)
        if c == 32:
            set spaces is spaces + 1
            set i is i + 1
        else if c == 9:
            set tabsn is tabsn + 1
            set i is i + 1
        else:
            break
    var level as int is 0
    if tabsn > 0:
        set level is tabsn
    else:
        set level is spaces / source_unit
    if level < 0:
        set level is 0
    var rest as string is line at i to (line length)
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    if tabs:
        var ti as int is 0
        while ti < level:
            calling sb.append_char with '\t'
            set ti is ti + 1
    else:
        var si as int is 0
        while si < level * width:
            calling sb.append_char with ' '
            set si is si + 1
    if rest length > 0 and (rest at 0 to 1) != "#":
        var norm as string is calling normalize_code with rest
        calling sb.append with norm
        banish norm
    else:
        calling sb.append with rest
    banish rest
    return calling sb.finish

## Formatea texto.
##
## ## Memoria
## Devuelve string owned.
weave format_text with text as string, width as int, tabs as bool, blank_max as int into string:
    var lines as list of string is calling text.split with "\n"
    if calling ends_with with text, "\n":
        if lines.len > 0 and (lines at (lines.len - 1)) length == 0:
            var dropped as string is calling lines.pop
    var out as StringBuilder is calling StringBuilder.new
    defer banish out
    var in_triple as bool is false
    var source_unit as int is calling detect_unit with lines, width
    var blanks as int is 0
    var i as int is 0
    while i < lines.len:
        var line as string is (lines at i)
        if in_triple:
            calling out.append with line
            calling out.append with "\n"
            if (calling triple_count with line) % 2 == 1:
                set in_triple is false
            set i is i + 1
            continue
        # Quitar espacios/tabs finales.
        var end as int is line length
        var lb as ref to frozen byte is bytes of line
        while end > 0:
            var c as int is ((lb at (end - 1)) to int)
            if c == 32 or c == 9:
                set end is end - 1
            else:
                break
        var trimmed as string is line at 0 to end
        var is_blank as bool is trimmed length == 0
        if is_blank:
            if blanks < blank_max:
                calling out.append with "\n"
                set blanks is blanks + 1
        else:
            set blanks is 0
            var ind as string is calling indent_line with trimmed, source_unit, width, tabs
            calling out.append with ind
            calling out.append with "\n"
            banish ind
        if (calling triple_count with trimmed) % 2 == 1:
            set in_triple is true
        banish trimmed
        set i is i + 1
    var res as string is calling out.finish
    if not (calling ends_with with text, "\n"):
        if res length > 0 and calling ends_with with res, "\n":
            var cut as int is res length - 1
            var r2 as string is res at 0 to cut
            banish res
            set res is r2
    return res

## Formatea stdin.
##
## ## Memoria
## Libera texto.
weave run_stdin with width as int, tabs as bool, blank_max as int, check_only as bool into int:
    var text as string is calling io.read_stdin_all
    var fmt as string is calling format_text with text, width, tabs, blank_max
    if check_only:
        var same as bool is fmt == text
        banish fmt
        banish text
        if same:
            return 0
        return 1
    calling spark.print with fmt
    banish fmt
    banish text
    return 0

## Escritura atómica (tmp + rename).
##
## ## Memoria
## Libera temporales.
weave write_atomic with path as string, text as string into bool:
    var tmp as string is "{path}.psc-tmp"
    if not calling archivum.write_text with tmp, text:
        banish tmp
        return false
    var ok as bool is calling archivum.move_file with tmp, path, true
    if not ok:
        var ign as bool is calling archivum.delete_file with tmp
    banish tmp
    return ok

## Implementa `psc fmt`.
##
## ## Memoria
## Libera ParseResult.
weave run_fmt with args as list of string into int:
    var vf as list of string is list of string
    calling vf.push with "--indent"
    calling vf.push with "--config"
    var sf as list of string is list of string
    calling sf.push with "--check"
    calling sf.push with "--diff"
    calling sf.push with "--stdin"
    calling sf.push with "--tabs"
    calling sf.push with "--verbose"
    calling sf.push with "--help"
    var pr as cliargs.ParseResult is calling cliargs.parse with args, 2, vf, sf, list of string
    if not pr.ok:
        var e as string is pr.error
        calling spark.eprintln with e
        calling cliargs.free_parse_result with (sigil of pr)
        return 2
    if calling cliargs.enabled with (sigil of pr.args), "--help":
        calling print_help
        calling cliargs.free_parse_result with (sigil of pr)
        return 0
    var check_only as bool is calling cliargs.enabled with (sigil of pr.args), "--check"
    var diff as bool is calling cliargs.enabled with (sigil of pr.args), "--diff"
    var tabs as bool is calling cliargs.enabled with (sigil of pr.args), "--tabs"
    var verbose as bool is calling cliargs.enabled with (sigil of pr.args), "--verbose"
    var width as int is 4
    var cfgp as string is calling cliargs.value with (sigil of pr.args), "--config"
    var cfg as FmtConfig is calling load_config with cfgp
    set width is cfg.width
    if cfg.tabs:
        set tabs is true
    var ins as string is calling cliargs.value with (sigil of pr.args), "--indent"
    if ins length > 0:
        var pm as maybe int is calling spark.parse_int with ins
        if pm.is_present and pm.value > 0:
            set width is pm.value
        banish pm
    if calling cliargs.enabled with (sigil of pr.args), "--stdin":
        var rc as int is calling run_stdin with width, tabs, cfg.blank, check_only
        calling cliargs.free_parse_result with (sigil of pr)
        return rc
    var changed as int is 0
    var pi as int is 0
    while pi < pr.args.positionals.len:
        var p as string is (pr.args.positionals at pi)
        var files as list of string is list of string
        if calling archivum.is_dir with p:
            var found as list of string is calling archivum.find_files with p, true
            for f in found:
                if calling ends_with with f, ".pengu":
                    calling files.push with (calling copy with f)
                banish f
            banish found
        else:
            calling files.push with (calling copy with p)
        var fi as int is 0
        while fi < files.len:
            var f as string is (files at fi)
            var txtm as maybe string is calling archivum.read_text with f
            if txtm.is_present:
                var original as string is txtm.value
                var fmt as string is calling format_text with original, width, tabs, cfg.blank
                if fmt != original:
                    set changed is changed + 1
                    if verbose or check_only:
                        var m as string is "would format {f}"
                        calling spark.println with m
                        banish m
                    if diff:
                        var d1 as string is "--- {f}"
                        calling spark.println with d1
                        banish d1
                        var oldl as list of string is calling original.split with "\n"
                        var newl as list of string is calling fmt.split with "\n"
                        var di as int is 0
                        var dn as int is oldl.len
                        if newl.len > dn:
                            set dn is newl.len
                        while di < dn:
                            var ov as string is ""
                            var nv as string is ""
                            if di < oldl.len:
                                set ov is (oldl at di)
                            if di < newl.len:
                                set nv is (newl at di)
                            if ov != nv:
                                var lm as string is "- {ov}"
                                calling spark.println with lm
                                banish lm
                                var pm as string is "+ {nv}"
                                calling spark.println with pm
                                banish pm
                            set di is di + 1
                        banish newl
                        banish oldl
                    if not check_only and not diff:
                        var ok as bool is calling write_atomic with f, fmt
                        if verbose:
                            var m2 as string is "formatted {f}"
                            calling spark.println with m2
                            banish m2
                banish fmt
            banish txtm
            banish f
            set fi is fi + 1
        banish files
        set pi is pi + 1
    if check_only:
        var m as string is "{changed} file(s) would be reformatted."
        calling spark.println with m
        banish m
    else:
        var m as string is "{changed} file(s) formatted."
        calling spark.println with m
        banish m
    calling cliargs.free_parse_result with (sigil of pr)
    if check_only and changed > 0:
        return 1
    return 0
