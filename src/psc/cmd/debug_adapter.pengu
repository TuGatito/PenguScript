## psc/cmd/debug_adapter.pengu — entrada de `psc debug-adapter`.
##
## El adapter habla DAP por stdio; no interpreta los argumentos de la línea de
## comandos (el editor manda la configuración en `launch`). Se aceptan `--help`
## y `--stdio` por compatibilidad, pero el protocolo siempre usa stdio.

import std.spark

import psc.dap.adapter as adapter

insignia psc_cmd_debug_adapter_

weave print_help into void:
    calling spark.println with "Usage: psc debug-adapter"
    calling spark.println with "  Servidor Debug Adapter Protocol por stdio para editores."
    calling spark.println with "  Configuración: launch.json / nvim-dap (ver docs/DEBUGGER.md)."

weave run_debug_adapter with args as vector of string into int:
    var i as int is 2
    while i < args.len:
        var a as string is args at i
        if a == "--help" or a == "-h":
            calling print_help
            return 0
        set i is i + 1
    return calling adapter.run_debug_adapter with args
