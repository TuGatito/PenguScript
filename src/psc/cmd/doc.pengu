## psc/cmd/doc.pengu — `psc doc` (Markdown básico F6).

import std.archivum
import std.builder
import std.compass
import std.scrolls
import std.rites
import std.spark

import psc.cli.args as cliargs
import psc.driver.manifest as manifest
import psc.sema.modules.program as semprog
import psc.sema.options as sopts
import psc.sema.api as sema_api
import psc.docgen.sig as dfsig
import psc.sema.names as npool
import psc.sema.symbols.symbol as sym
import psc.sema.types.kind as tk
import psc.sema.types.table as types

insignia psc_cmd_doc_

## Ayuda.
##
## ## Memoria
## No asigna.
weave print_help into void:
    calling spark.println with "Usage: psc doc [--output=DIR] [--entry=PATH] [--include-std]"
    calling spark.println with "  --output=DIR    output directory (default: docs/api)"
    calling spark.println with "  --entry=PATH    override entry"
    calling spark.println with "  --include-std   also document the stdlib (std/*.pengu)"
    calling spark.println with "  --html          write an index.html with a filter box"
    calling spark.println with "  --help"

## Copia owned.
##
## ## Memoria
## Devuelve string owned.
weave copy with s as string into string:
    return calling npool.copy_string with s

## Busca el manifiesto.
##
## ## Memoria
## Devuelve string owned o `""`.
weave find_root with start as string into string:
    var d as string is calling compass.cp_absolute with start
    var i as int is 0
    while i < 8:
        var f as string is "{d}/pengu.toml"
        if calling archivum.is_file with f:
            banish f
            return calling copy with d
        banish f
        var parent as string is calling compass.cp_dirname with d
        if parent == d:
            banish parent
            banish d
            return ""
        banish d
        set d is parent
        set i is i + 1
    banish d
    return ""

## `true` si `s` empieza por `p`.
##
## ## Memoria
## O(p).
weave starts_with with s as string, p as string into bool:
    var n as int is s length
    var m as int is p length
    if m > n:
        return false
    return (s at 0 to m) == p

## `true` si `s` termina en `p`.
##
## ## Memoria
## O(p).
weave ends_with with s as string, p as string into bool:
    var n as int is s length
    var m as int is p length
    if m > n:
        return false
    return (s at (n - m) to n) == p

## `true` si `line` declara un símbolo documentable.
weave is_decl with line as string into bool:
    return (calling starts_with with line, "weave ") or (calling starts_with with line, "rune ") or (calling starts_with with line, "echo ") or (calling starts_with with line, "omen ") or (calling starts_with with line, "alias ") or (calling starts_with with line, "seal ") or (calling starts_with with line, "concept ") or (calling starts_with with line, "const ")

## Firma legible de una declaración.
##
## ## Memoria
## Devuelve string owned.
weave signature_of with line as string into string:
    var t as string is line
    # quitar ':' final
    if calling ends_with with t, ":":
        var cut as int is t length - 1
        var t2 as string is t at 0 to cut
        banish t
        set t is t2
    if calling starts_with with t, "weave ":
        var body as string is t at 6 to (t length)
        var wi as int is 0
        var wname as string is body
        var with_i as int is -1
        var into_i as int is -1
        while wi < body length:
            if with_i < 0 and wi + 6 <= body length and (body at wi to (wi + 6)) == " with ":
                set with_i is wi
                set wi is wi + 5
            else if wi + 6 <= body length and (body at wi to (wi + 6)) == " into ":
                set into_i is wi
                set wi is wi + 5
            set wi is wi + 1
        if with_i >= 0:
            set wname is body at 0 to with_i
        else if into_i >= 0:
            set wname is body at 0 to into_i
        var ret as string is "void"
        if into_i >= 0:
            set ret is body at (into_i + 6) to (body length)
        var params as string is ""
        if with_i >= 0:
            if into_i >= 0:
                set params is body at (with_i + 6) to into_i
            else:
                set params is body at (with_i + 6) to (body length)
        var params2 as string is calling scrolls.replace_all with params, " as ", ": "
        var sig as string is "**{wname}**({params2}) -> {ret}"
        banish ret
        banish params
        banish params2
        banish wname
        banish body
        banish t
        return sig
    var sp as int is 0
    while sp < t length and (t at sp to (sp + 1)) != " ":
        set sp is sp + 1
    if sp < t length:
        var rest as string is t at (sp + 1) to (t length)
        var nm as string is rest
        var q as int is 0
        while q < rest length:
            var ch as string is rest at q to (q + 1)
            if ch == " " or ch == ":" or ch == "(" or ch == "=":
                set nm is rest at 0 to q
                break
            set q is q + 1
        var sig2 as string is "**{nm}**"
        banish nm
        banish rest
        banish t
        return sig2
    banish t
    return "**?**"

## `true` si el símbolo se documenta.
##
## ## Memoria
## No asigna.
weave is_documentable with kind as sym.SemaSymbolKind into bool:
    return kind == sym.SemaSymbolKind.SkWeave or kind == sym.SemaSymbolKind.SkDeclare or kind == sym.SemaSymbolKind.SkConst or kind == sym.SemaSymbolKind.SkRune or kind == sym.SemaSymbolKind.SkEcho or kind == sym.SemaSymbolKind.SkOmen or kind == sym.SemaSymbolKind.SkAlias or kind == sym.SemaSymbolKind.SkSeal or kind == sym.SemaSymbolKind.SkConcept or kind == sym.SemaSymbolKind.SkTest

## Añade campos de una runa/echo o variantes de un omen.
##
## ## Memoria
## No retiene; los strings auxiliares se liberan.
weave append_type_details with sb as ref to StringBuilder, p as ref to semprog.SemaProgram, ty as tk.SemaType into void:
    if ty.a < 0 or ty.a >= p->types.nominal_infos.len:
        return
    var info as types.SemaNominalInfo is (p->types.nominal_infos at ty.a)
    if ty.kind == tk.SemaTypeKind.TkRune or ty.kind == tk.SemaTypeKind.TkEcho:
        if info.fields_count > 0:
            calling sb.append with "```pengu\n"
            var fi as int is 0
            while fi < info.fields_count:
                var f as types.SemaField is (p->types.fields at (info.fields_first + fi))
                var fn as string is calling npool.text with (sigil of p->names), f.name
                var ft as string is calling dfsig.type_text with p, f.type
                calling sb.append with "    {fn} as {ft}\n"
                banish ft
                set fi is fi + 1
            calling sb.append with "```\n\n"
    else if ty.kind == tk.SemaTypeKind.TkOmen:
        if info.variants_count > 0:
            calling sb.append with "```pengu\n"
            var vi as int is 0
            while vi < info.variants_count:
                var v as types.SemaVariant is (p->types.variants at (info.variants_first + vi))
                var vn as string is calling npool.text with (sigil of p->names), v.name
                calling sb.append with "    {vn}"
                if v.payload_count > 0:
                    calling sb.append with " with "
                    var pi2 as int is 0
                    while pi2 < v.payload_count:
                        if pi2 > 0:
                            calling sb.append with ", "
                        var pf as types.SemaField is (p->types.fields at (v.payload_first + pi2))
                        var pfn as string is calling npool.text with (sigil of p->names), pf.name
                        var pft as string is calling dfsig.type_text with p, pf.type
                        calling sb.append with "{pfn} as {pft}"
                        banish pft
                        set pi2 is pi2 + 1
                calling sb.append with "\n"
                set vi is vi + 1
            calling sb.append with "```\n\n"

## Recorta espacios y tabuladores en los extremos.
##
## ## Memoria
## Devuelve una vista de `s`.
weave trim_text with s as string into string:
    var b as ref to frozen byte is bytes of s
    var a as int is 0
    var e as int is s length
    while a < e and (((b at a) to int) == 32 or ((b at a) to int) == 9):
        set a is a + 1
    while e > a and (((b at (e - 1)) to int) == 32 or ((b at (e - 1)) to int) == 9):
        set e is e - 1
    return s at a to e

## Docstring de módulo: bloque `##` inicial del archivo.
##
## Es el comentario `##` que abre el archivo, antes de imports y directivas.
## Si el archivo empieza por `#` (doc antigua) o por código, no hay docstring.
##
## ## Memoria
## Devuelve string owned o `""`.
weave module_doc with path as string into string:
    var t as maybe string is calling archivum.read_text with path
    if not t.is_present:
        banish t
        return ""
    var text as string is t.value
    var lines as list of string is calling text.split with "\n"
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var any as bool is false
    var i as int is 0
    while i < lines.len:
        var line as string is (lines at i)
        var k as int is 0
        while k < line.len and (line at k) == " ":
            set k is k + 1
        var rest as string is line at k to (line length)
        if not calling starts_with with rest, "##":
            banish rest
            break
        var d as string is rest at 2 to (rest length)
        if d.len > 0 and (d at 0) == " ":
            var d0 as string is d at 1 to (d length)
            banish d
            set d is d0
        if any:
            calling sb.append with "\n"
        calling sb.append with d
        set any is true
        banish d
        banish rest
        set i is i + 1
    banish lines
    banish t
    if not any:
        return ""
    return calling sb.finish

## Renderiza un archivo a Markdown desde los símbolos del checker.
##
## ## Memoria
## Devuelve string owned.
weave render_file with path as string, rel as string, title as string, p as ref to semprog.SemaProgram into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "# "
    calling sb.append with title
    calling sb.append with "\n\n> Source: `"
    calling sb.append with rel
    calling sb.append with "`\n\n"
    var mdoc as string is calling module_doc with path
    if mdoc length > 0:
        calling sb.append with mdoc
        calling sb.append with "\n\n"
    banish mdoc
    calling sb.append with "---\n\n"
    var mid as int is calling semprog.module_id with p, path
    if mid < 0:
        return calling sb.finish
    var ids as list of int is list of int
    var i as int is 0
    while i < p->symbols.symbols.len:
        var si as sym.SemaSymbol is (p->symbols.symbols at i)
        if si.module == mid and si.name >= 0 and si.start >= 0 and calling is_documentable with si.kind:
            calling ids.push with i
        set i is i + 1
    # Orden por offset de declaración (burbuja; la lista es pequeña).
    var a as int is 0
    while a < ids.len:
        var b as int is 0
        while b + 1 < ids.len - a:
            var s1 as int is (p->symbols.symbols at (ids at b)).start
            var s2 as int is (p->symbols.symbols at (ids at (b + 1))).start
            if s1 > s2:
                var tmp as int is (ids at b)
                set ids at b is (ids at (b + 1))
                set ids at (b + 1) is tmp
            set b is b + 1
        set a is a + 1
    var seen_names as map of string to bool is map of string to bool
    var k as int is 0
    while k < ids.len:
        var sid as int is (ids at k)
        var si as sym.SemaSymbol is (p->symbols.symbols at sid)
        var nm as string is calling npool.text with (sigil of p->names), si.name
        if calling seen_names.has with nm:
            set k is k + 1
            continue
        calling seen_names.put with (calling copy with nm), true
        calling sb.append with "### `"
        calling sb.append with nm
        calling sb.append with "`\n\n> "
        var sig as string is calling dfsig.signature_for_symbol with p, sid
        if sig length > 0:
            calling sb.append with sig
            banish sig
        else:
            banish sig
            var kn as string is calling sym.symbol_kind_name with si.kind
            calling sb.append with "{kn} "
            calling sb.append with nm
        calling sb.append with "\n\n"
        var ty as tk.SemaType is calling types.at with (sigil of p->types), si.type
        calling append_type_details with (sigil of sb), p, ty
        var doc as string is calling dfsig.doc_for_symbol with p, sid
        if doc length > 0:
            calling sb.append with doc
            calling sb.append with "\n\n"
        else:
            calling sb.append with "_Undocumented._\n\n"
        set k is k + 1
    banish seen_names
    banish ids
    return calling sb.finish

## Nombre documental a partir del path relativo.
##
## Sustituye los separadores de directorio por `sep` y quita `.pengu`.
## Se usa con `_` para el nombre de página y con `.` para el título.
##
## ## Memoria
## Devuelve string owned.
weave doc_name with rel as string, sep as char into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var b as ref to frozen byte is bytes of rel
    var i as int is 0
    while i < rel length:
        var c as int is ((b at i) to int)
        if c == 47 or c == 92:
            calling sb.append_char with sep
        else:
            calling sb.append_char with (c to char)
        set i is i + 1
    var full as string is calling sb.finish
    if calling ends_with with full, ".pengu":
        var cut as int is full length - 6
        var o2 as string is full at 0 to cut
        banish full
        return o2
    return full

## Implementa `psc doc`.
##
## ## Memoria
## Libera ParseResult.
weave run_doc with args as list of string into int:
    var vf as list of string is list of string
    calling vf.push with "--output"
    calling vf.push with "--entry"
    calling vf.push with "--config"
    var sf as list of string is list of string
    calling sf.push with "--html"
    calling sf.push with "--include-std"
    calling sf.push with "--help"
    var pr as cliargs.ParseResult is calling cliargs.parse with args, 2, vf, sf, list of string
    if not pr.ok:
        var e as string is pr.error
        calling spark.eprintln with e
        calling cliargs.free_parse_result with (sigil of pr)
        return 2
    if calling cliargs.enabled with (sigil of pr.args), "--help":
        calling print_help
        calling cliargs.free_parse_result with (sigil of pr)
        return 0
    var cwd as maybe string is calling rites.getcwd
    if not cwd.is_present:
        banish cwd
        calling cliargs.free_parse_result with (sigil of pr)
        return 2
    var start as string is cwd.value
    var cfg as string is calling cliargs.value with (sigil of pr.args), "--config"
    if cfg length > 0:
        set start is cfg
    var root as string is calling find_root with start
    if root length == 0:
        calling spark.eprintln with "psc doc: no pengu.toml found"
        banish root
        banish cwd
        calling cliargs.free_parse_result with (sigil of pr)
        return 1
    var man as manifest.Manifest is calling manifest.load_manifest with root, "debug"
    if not man.ok:
        var e2 as string is man.error
        calling spark.eprintln with e2
        calling manifest.free_manifest with (sigil of man)
        banish root
        banish cwd
        calling cliargs.free_parse_result with (sigil of pr)
        return 1
    var out as string is calling copy with (calling cliargs.value with (sigil of pr.args), "--output")
    if out length == 0:
        set out is "{root}/docs/api"
    if not calling archivum.create_dir with out, true:
        calling spark.eprintln with "psc doc: cannot create output directory"
        calling manifest.free_manifest with (sigil of man)
        banish root
        banish cwd
        calling cliargs.free_parse_result with (sigil of pr)
        return 1
    var entry as string is calling cliargs.value with (sigil of pr.args), "--entry"
    if entry length == 0:
        banish entry
        set entry is calling copy with man.entry
    var entry_path as string is "{root}/{entry}"
    var probe as sopts.SemaOptions is calling sopts.default_options with (calling copy with root)
    calling sema_api.configure_options with entry_path, (sigil of probe)
    var std_dir as string is ""
    var local_std as string is "{root}/std"
    if calling archivum.is_dir with local_std:
        set std_dir is local_std
    else:
        banish local_std
        if probe.std_dirs.len > 0:
            set std_dir is calling copy with (probe.std_dirs at 0)
    calling sopts.free_options with (sigil of probe)
    var want_std as bool is calling cliargs.enabled with (sigil of pr.args), "--include-std"
    if want_std and std_dir length == 0:
        calling spark.eprintln with "psc doc: --include-std: no stdlib directory found"
        banish std_dir
        banish entry_path
        calling manifest.free_manifest with (sigil of man)
        banish root
        banish cwd
        calling cliargs.free_parse_result with (sigil of pr)
        return 1
    var sopt0 as sopts.SemaOptions is calling sopts.default_options with (calling copy with root)
    var sr0 as sema_api.SemaResult is calling sema_api.check_file with entry_path, sopt0
    var src as string is "{root}/{man.src_dir}"
    var found as list of string is calling archivum.find_files with src, true
    if want_std:
        var sfound as list of string is calling archivum.find_files with std_dir, true
        for sf in sfound:
            if calling ends_with with sf, ".pengu" and not calling ends_with with sf, ".d.pengu":
                calling found.push with (calling copy with sf)
            banish sf
        banish sfound
    var std_prefix as string is ""
    var std_base as string is ""
    if std_dir length > 0:
        set std_prefix is "{std_dir}/"
        set std_base is calling compass.cp_dirname with std_dir
    var count as int is 0
    var empty as int is 0
    var want_html as bool is calling cliargs.enabled with (sigil of pr.args), "--html"
    var ib as StringBuilder is calling StringBuilder.new
    defer banish ib
    calling ib.append with "# API — "
    calling ib.append with man.name
    calling ib.append with "\n\nGenerated by `psc doc`.\n\n"
    var hb as StringBuilder is calling StringBuilder.new
    defer banish hb
    if want_html:
        calling hb.append with "<!doctype html><meta charset=\"utf-8\"><title>API "
        calling hb.append with man.name
        calling hb.append with "</title><h1>API "
        calling hb.append with man.name
        calling hb.append with "</h1><input id=q placeholder=\"filtrar…\"><ul id=l>"
    for f in found:
        if calling ends_with with f, ".pengu" and not calling ends_with with f, ".d.pengu":
            var rbase as string is root
            if std_base length > 0 and calling starts_with with f, std_prefix:
                set rbase is std_base
            var relm as maybe string is calling compass.cp_relative_to with f, rbase
            var rel as string is calling copy with f
            if relm.is_present:
                banish rel
                set rel is calling copy with relm.value
            banish relm
            var t0 as string is rel
            var sp as string is "{man.src_dir}/"
            if calling starts_with with t0, sp:
                set t0 is t0 at (sp length) to (t0 length)
            var title as string is calling doc_name with t0, '.'
            banish sp
            var md as string is ""
            var mid as int is calling semprog.module_id with sr0.program, f
            if mid >= 0:
                set md is calling render_file with f, rel, title, sr0.program
            else:
                # Fuera del programa del entry (stdlib u huérfano): se comprueba
                # aislado para poder documentarlo.
                var soptf as sopts.SemaOptions is calling sopts.default_options with (calling copy with root)
                var srf as sema_api.SemaResult is calling sema_api.check_file with f, soptf
                set md is calling render_file with f, rel, title, srf.program
                calling sema_api.free_result with (sigil of srf)
            banish title
            if not calling scrolls.contains with md, "### `":
                set empty is empty + 1
            var nm as string is calling doc_name with t0, '_'
            banish rel
            var target as string is "{out}/{nm}.md"
            calling archivum.write_text with target, md
            calling ib.append with "- ["
            calling ib.append with nm
            calling ib.append with "]("
            calling ib.append with nm
            calling ib.append with ".md)\n"
            if want_html:
                calling hb.append with "<li><a href=\""
                calling hb.append with nm
                calling hb.append with ".md\">"
                calling hb.append with nm
                calling hb.append with "</a></li>"
            banish target
            banish nm
            banish md
            set count is count + 1
        banish f
    banish found
    calling sema_api.free_result with (sigil of sr0)
    var idx as string is calling ib.finish
    var ipath as string is "{out}/README.md"
    calling archivum.write_text with ipath, idx
    banish ipath
    banish idx
    if want_html:
        calling hb.append with "</ul>"
        calling hb.append with r"<script>q.oninput=()=>{for(const li of l.children)li.style.display=li.textContent.includes(q.value)?'':'none'}</script>"
        var htext as string is calling hb.finish
        var hpath as string is "{out}/index.html"
        calling archivum.write_text with hpath, htext
        banish hpath
        banish htext
    var msg as string is "Generated {count} module(s) in {out}"
    calling spark.println with msg
    banish msg
    if empty > 0:
        var wmsg as string is "psc doc: warning: {empty} module(s) without symbols"
        calling spark.eprintln with wmsg
        banish wmsg
    calling manifest.free_manifest with (sigil of man)
    banish std_prefix
    banish std_base
    banish std_dir
    banish entry_path
    banish src
    banish out
    banish root
    banish cwd
    calling cliargs.free_parse_result with (sigil of pr)
    return 0
