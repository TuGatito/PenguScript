## Implementa `psc build`.
##
## ## Memoria
## Libera opciones y resultado.
weave run_build with args as vector of string into int:
    var vf as vector of string is vector of string
    calling vf.push with "--profile"
    calling vf.push with "-p"
    calling vf.push with "--cc"
    calling vf.push with "--out"
    calling vf.push with "-o"
    calling vf.push with "--entry"
    calling vf.push with "-e"
    calling vf.push with "--config"
    calling vf.push with "-c"
    calling vf.push with "--dce-scope"
    calling vf.push with "--target"
    calling vf.push with "--sanitize"
    calling vf.push with "--jobs"
    calling vf.push with "--backend"
    var lf as vector of string is vector of string
    calling lf.push with "--define"
    calling lf.push with "-D"
    var sf as vector of string is vector of string
    calling sf.push with "--split-codegen"
    calling sf.push with "--verbose"
    calling sf.push with "--strict-c99"
    calling sf.push with "--release-unsafe"
    calling sf.push with "--test"
    calling sf.push with "--exe"
    calling sf.push with "--json"
    calling sf.push with "--no-dce"
    calling sf.push with "--prune-types"
    calling sf.push with "--no-prune-types"
    calling sf.push with "--no-line-markers"
    calling sf.push with "--prune-native"
    calling sf.push with "--tree-shake-user"
    calling sf.push with "--pch"
    calling sf.push with "--no-pch"
    calling sf.push with "--locked"
    calling sf.push with "--frozen"
    calling sf.push with "--no-cache"
    calling sf.push with "--clear-cache"
    calling sf.push with "--ephemeral"
    calling sf.push with "--keep"
    calling sf.push with "--help"
    calling sf.push with "-h"
    var pr as cliargs.ParseResult is calling cliargs.parse with args, 2, vf, sf, lf
    if not pr.ok:
        var e as string is pr.error
        calling spark.eprintln with e
        calling cliargs.free_parse_result with (sigil of pr)
        return 2
    if (calling cliargs.enabled with (sigil of pr.args), "--help") or (calling cliargs.enabled with (sigil of pr.args), "-h"):
        calling print_build_help
        calling cliargs.free_parse_result with (sigil of pr)
        return 0
    var o as driver.BuildOptions is calling driver.default_options
    var tval as string is calling cliargs.value with (sigil of pr.args), "--target"
    if tval length > 0:
        var nt as targetmod.Target is calling targetmod.parse with tval
        if not nt.ok:
            var terr as string is nt.error
            var tmsg as string is "psc build: {terr}"
            calling spark.eprintln with tmsg
            banish tmsg
            calling targetmod.free with (sigil of nt)
            calling driver.free_options with (sigil of o)
            calling cliargs.free_parse_result with (sigil of pr)
            return 2
        calling targetmod.free with (sigil of o.platform)
        set o.platform is nt
        set o.target_explicit is true
    var prog as string is args at 0
    set o.compiler_path is calling copy_path with prog
    set o.no_cache is calling cliargs.enabled with (sigil of pr.args), "--no-cache"
    set o.clear_cache is calling cliargs.enabled with (sigil of pr.args), "--clear-cache"
    set o.ephemeral is calling cliargs.enabled with (sigil of pr.args), "--ephemeral"
    set o.locked is calling cliargs.enabled with (sigil of pr.args), "--locked"
    set o.frozen is calling cliargs.enabled with (sigil of pr.args), "--frozen"
    var prof as string is calling cliargs.value with (sigil of pr.args), "--profile"
    if prof length == 0:
        set prof is calling cliargs.value with (sigil of pr.args), "-p"
    if prof length > 0:
        banish o.profile
        set o.profile is calling copy_path with prof
    var cc as string is calling cliargs.value with (sigil of pr.args), "--cc"
    if cc length > 0:
        banish o.cc
        set o.cc is calling copy_path with cc
    var out as string is calling cliargs.value with (sigil of pr.args), "--out"
    if out length == 0:
        set out is calling cliargs.value with (sigil of pr.args), "-o"
    if out length > 0:
        banish o.out_path
        set o.out_path is calling copy_path with out
    var ent as string is calling cliargs.value with (sigil of pr.args), "--entry"
    if ent length == 0:
        set ent is calling cliargs.value with (sigil of pr.args), "-e"
    var target as string is calling cliargs.first_positional with (sigil of pr.args)
    if ent length > 0:
        set target is ent
    var cfg as string is calling cliargs.value with (sigil of pr.args), "--config"
    if cfg length > 0:
        set target is cfg
    banish o.target
    set o.target is calling copy_path with target
    set o.verbose is calling cliargs.enabled with (sigil of pr.args), "--verbose"
    set o.strict_c99 is calling cliargs.enabled with (sigil of pr.args), "--strict-c99"
    set o.legacy_copy is calling cliargs.enabled with (sigil of pr.args), "--legacy-copy"
    set o.release_unsafe is calling cliargs.enabled with (sigil of pr.args), "--release-unsafe"
    set o.is_test is calling cliargs.enabled with (sigil of pr.args), "--test"
    set o.force_exe is calling cliargs.enabled with (sigil of pr.args), "--exe"
    set o.no_dce is calling cliargs.enabled with (sigil of pr.args), "--no-dce"
    set o.prune_types is not (calling cliargs.enabled with (sigil of pr.args), "--no-prune-types")
    set o.no_line_markers is calling cliargs.enabled with (sigil of pr.args), "--no-line-markers"
    # D12: release prunes satellite links by default; `--prune-native` keeps
    # the explicit opt-in for debug builds.
    set o.prune_native is (calling cliargs.enabled with (sigil of pr.args), "--prune-native") or prof == "release"
    set o.dce_scope_user is calling cliargs.enabled with (sigil of pr.args), "--tree-shake-user"
    set o.pch is calling cliargs.enabled with (sigil of pr.args), "--pch"
    set o.split is calling cliargs.enabled with (sigil of pr.args), "--split-codegen"
    var jval as string is calling cliargs.value with (sigil of pr.args), "--jobs"
    if jval length > 0:
        var jn as maybe int is calling spark.parse_int with jval
        if jn.is_present and jn.value > 0:
            set o.jobs is jn.value
        banish jn
    var san as string is calling cliargs.value with (sigil of pr.args), "--sanitize"
    if san length > 0:
        if san != "address" and san != "undefined" and san != "thread":
            calling spark.eprintln with "psc build: --sanitize must be address, undefined or thread"
            calling driver.free_options with (sigil of o)
            calling cliargs.free_parse_result with (sigil of pr)
            return 2
        if san == "address":
            set o.sanitize_kind is 1
        else if san == "undefined":
            set o.sanitize_kind is 2
        else:
            set o.sanitize_kind is 3
    var be as string is calling cliargs.value with (sigil of pr.args), "--backend"
    if be length > 0:
        var fam as string is calling driver.backend_family with be
        if fam length == 0:
            var bmsg as string is calling driver.backend_error with "psc build", be
            calling spark.eprintln with bmsg
            banish bmsg
            calling driver.free_options with (sigil of o)
            calling cliargs.free_parse_result with (sigil of pr)
            return 2
        banish o.family
        set o.family is calling copy_path with fam
    var dscope as string is calling cliargs.value with (sigil of pr.args), "--dce-scope"
    if dscope == "user":
        set o.dce_scope_user is true
    var defs as vector of string is calling cliargs.list with (sigil of pr.args), "--define"
    if defs.len == 0:
        set defs is calling cliargs.list with (sigil of pr.args), "-D"
    var di as int is 0
    while di < defs.len:
        calling o.defines.push with (calling copy_path with (defs at di))
        set di is di + 1
    var want_json as bool is calling cliargs.enabled with (sigil of pr.args), "--json"
    var r as driver.BuildResult is calling driver.build with o
    if not r.ok:
        var err as string is r.error
        var emsg as string is "psc build: {err}"
        calling spark.eprintln with emsg
        banish emsg
        calling driver.free_result with (sigil of r)
        calling driver.free_options with (sigil of o)
        calling cliargs.free_parse_result with (sigil of pr)
        return 1
    if want_json:
        var jsb as StringBuilder is calling StringBuilder.new
        defer banish jsb
        calling jsb.append with "{"
        calling jsb.append_char with '"'
        calling jsb.append with "schema_version"
        calling jsb.append_char with '"'
        calling jsb.append with ":1,"
        calling jsb.append_char with '"'
        calling jsb.append with "event"
        calling jsb.append_char with '"'
        calling jsb.append with ":"
        calling jsb.append_char with '"'
        calling jsb.append with "done"
        calling jsb.append_char with '"'
        calling jsb.append with ","
        calling jsb.append_char with '"'
        calling jsb.append with "status"
        calling jsb.append_char with '"'
        calling jsb.append with ":"
        calling jsb.append_char with '"'
        calling jsb.append with "ok"
        calling jsb.append_char with '"'
        calling jsb.append with ","
        calling jsb.append_char with '"'
        calling jsb.append with "artifact"
        calling jsb.append_char with '"'
        calling jsb.append with ":"
        calling jsb.append_char with '"'
        calling jsb.append with r.artifact
        calling jsb.append_char with '"'
        calling jsb.append with "}"
        var js as string is calling jsb.finish
        calling spark.println with js
        banish js
    else:
        var msg as string is "Finished -> {r.artifact}"
        calling spark.println with msg
        banish msg
    calling driver.free_result with (sigil of r)
    calling driver.free_options with (sigil of o)
    calling cliargs.free_parse_result with (sigil of pr)
    return 0

## Implementa `psc check` sobre un proyecto.
##
## ## Memoria
## Libera opciones y resultado.
weave run_check_project with path as string, t as targetmod.Target, explicit as bool into int:
    var o as driver.BuildOptions is calling driver.default_options
    set o.check_only is true
    calling targetmod.free with (sigil of o.platform)
    set o.platform is calling targetmod.clone with t
    set o.target_explicit is explicit
    banish o.target
    set o.target is calling copy_path with path
    var r as driver.BuildResult is calling driver.build with o
    if not r.ok:
        var err as string is r.error
        var emsg as string is "psc check: {err}"
        calling spark.eprintln with emsg
        banish emsg
        calling driver.free_result with (sigil of r)
        calling driver.free_options with (sigil of o)
        return 1
    calling driver.free_result with (sigil of r)
    calling driver.free_options with (sigil of o)
    return 0

## Implementa `psc run`.
##
## ## Memoria
## Libera opciones, resultado y args del hijo.
weave run_run with args as vector of string into int:
    var o as driver.BuildOptions is calling driver.default_options
    # `run` siempre necesita un ejecutable, aunque el proyecto sea una
    # librería (`output = "c"`/`"static"`); si no, intentaría ejecutar el
    # bundle C y fallaría con "not found".
    set o.force_exe is true
    var prog as string is args at 0
    set o.compiler_path is calling copy_path with prog
    var path as string is ""
    var child as vector of string is vector of string
    var after as bool is false
    var no_cache as bool is false
    var clear_cache as bool is false
    var ephemeral as bool is false
    var browser as bool is false
    var tval as string is ""
    var i as int is 2
    while i < args.len:
        var a as string is args at i
        if after:
            calling child.push with (calling copy_path with a)
        else if a == "--":
            set after is true
        else if a == "--verbose":
            set o.verbose is true
        else if a == "--strict-c99":
            set o.strict_c99 is true
        else if a == "--backend":
            if i + 1 >= args.len:
                calling spark.eprintln with "psc run: missing value for '--backend'"
                calling driver.free_options with (sigil of o)
                return 2
            var bval as string is args at (i + 1)
            var bfam as string is calling driver.backend_family with bval
            if bfam length == 0:
                var bmsg as string is calling driver.backend_error with "psc run", bval
                calling spark.eprintln with bmsg
                banish bmsg
                calling driver.free_options with (sigil of o)
                return 2
            banish o.family
            set o.family is calling copy_path with bfam
            set i is i + 1
        else if calling starts_with with a, "--backend=":
            var bval2 as string is a at 10 to (a length)
            var bfam2 as string is calling driver.backend_family with bval2
            if bfam2 length == 0:
                var bmsg2 as string is calling driver.backend_error with "psc run", bval2
                calling spark.eprintln with bmsg2
                banish bmsg2
                calling driver.free_options with (sigil of o)
                return 2
            banish o.family
            set o.family is calling copy_path with bfam2
        else if a == "--legacy-copy":
            set o.legacy_copy is true
        else if a == "--release-unsafe":
            set o.release_unsafe is true
        else if a == "--no-cache":
            set no_cache is true
        else if a == "--clear-cache":
            set clear_cache is true
        else if a == "--ephemeral":
            set ephemeral is true
        else if a == "--browser":
            set browser is true
        else if a == "--help" or a == "-h":
            calling print_run_help
            calling driver.free_options with (sigil of o)
            return 0
        else if a == "--target":
            if i + 1 >= args.len:
                calling spark.eprintln with "psc run: missing value for '--target'"
                calling driver.free_options with (sigil of o)
                return 2
            banish tval
            set tval is calling copy_path with (args at (i + 1))
            set i is i + 1
        else if calling starts_with with a, "--target=":
            banish tval
            set tval is a at 9 to (a length)
        else if a == "--profile":
            if i + 1 >= args.len:
                calling spark.eprintln with "psc run: missing value for '--profile'"
                calling driver.free_options with (sigil of o)
                return 2
            banish o.profile
            set o.profile is calling copy_path with (args at (i + 1))
            set i is i + 1
        else if calling starts_with with a, "--profile=":
            var v as string is a at 10 to (a length)
            banish o.profile
            set o.profile is v
        else if calling starts_with with a, "--cc=":
            var vc as string is a at 5 to (a length)
            banish o.cc
            set o.cc is vc
        else if calling starts_dash with a:
            var u as string is "psc run: unknown option '{a}'"
            calling spark.eprintln with u
            banish u
            calling print_run_help
            calling driver.free_options with (sigil of o)
            return 2
        else:
            if path length > 0:
                calling spark.eprintln with "psc run: only one target is supported before --"
                calling driver.free_options with (sigil of o)
                return 2
            set path is a
        set i is i + 1
    banish o.target
    set o.target is calling copy_path with path
    ## `run` acepta estos flags para el driver, no solo para el atajo de
    ## "artefacto al día": sin esto `--no-cache` seguía usando la caché.
    set o.no_cache is no_cache
    set o.ephemeral is ephemeral
    if tval length > 0:
        var nt as targetmod.Target is calling targetmod.parse with tval
        if not nt.ok:
            var terr as string is nt.error
            var tmsg as string is "psc run: {terr}"
            calling spark.eprintln with tmsg
            banish tmsg
            calling targetmod.free with (sigil of nt)
            banish tval
            calling driver.free_options with (sigil of o)
            return 2
        calling targetmod.free with (sigil of o.platform)
        set o.platform is nt
        set o.target_explicit is true
    banish tval
    if clear_cache:
        var ignored as int is calling cache.clear
    # Sin atajo propio de `run`: la clave de `driver.build` ya incluye el
    # fuente, los headers (`include/`), los glue de `c/` y las flags, y su
    # caché evita recompilar cuando nada cambió. El atajo antiguo hasheaba
    # solo el archivo de entrada y servía binarios obsoletos tras editar un
    # header (regress_c_header_cache).
    var r as driver.BuildResult is calling driver.build with o
    if not r.ok:
        var err as string is r.error
        var emsg as string is "psc run: {err}"
        calling spark.eprintln with emsg
        banish emsg
        calling driver.free_result with (sigil of r)
        calling driver.free_options with (sigil of o)
        var ci as int is 0
        while ci < child.len:
            banish child at ci
            set ci is ci + 1
        banish child
        return 1
    var art as string is r.artifact
    # El build resolvió el target (posible `[build] target = wasm`):
    # ejecutar con el target resuelto evita intentar exec de un .html.
    set o.platform.is_wasm is r.is_wasm
    var code as int is calling runner.run with o.platform, art, child, browser
    calling driver.free_result with (sigil of r)
    calling driver.free_options with (sigil of o)
    var ci2 as int is 0
    while ci2 < child.len:
        banish child at ci2
        set ci2 is ci2 + 1
    banish child
    return code

## Implementa `psc expand`.
##
## ## Memoria
## Libera opciones, resultado y bundle.
weave run_expand with args as vector of string into int:
    var o as driver.BuildOptions is calling driver.default_options
    set o.bundle_only is true
    var path as string is ""
    var out as string is ""
    var i as int is 2
    while i < args.len:
        var a as string is args at i
        if a == "--library":
            set o.is_library is true
        else if a == "--strict-c99":
            set o.strict_c99 is true
        else if a == "--legacy-copy":
            set o.legacy_copy is true
        else if a == "--release-unsafe":
            set o.release_unsafe is true
        else if a == "--help" or a == "-h":
            calling print_expand_help
            calling driver.free_options with (sigil of o)
            return 0
        else if a == "--target":
            if i + 1 >= args.len:
                calling spark.eprintln with "psc expand: missing value for '--target'"
                calling driver.free_options with (sigil of o)
                return 2
            var nt as targetmod.Target is calling targetmod.parse with (args at (i + 1))
            if not nt.ok:
                var terr as string is nt.error
                var tmsg as string is "psc expand: {terr}"
                calling spark.eprintln with tmsg
                banish tmsg
                calling targetmod.free with (sigil of nt)
                calling driver.free_options with (sigil of o)
                return 2
            calling targetmod.free with (sigil of o.platform)
            set o.platform is nt
            set o.target_explicit is true
            set i is i + 1
        else if calling starts_with with a, "--target=":
            var nt2 as targetmod.Target is calling targetmod.parse with (a at 9 to (a length))
            if not nt2.ok:
                var terr2 as string is nt2.error
                var tmsg2 as string is "psc expand: {terr2}"
                calling spark.eprintln with tmsg2
                banish tmsg2
                calling targetmod.free with (sigil of nt2)
                calling driver.free_options with (sigil of o)
                return 2
            calling targetmod.free with (sigil of o.platform)
            set o.platform is nt2
            set o.target_explicit is true
        else if a == "--out":
            if i + 1 >= args.len:
                calling spark.eprintln with "psc expand: missing value for '--out'"
                calling driver.free_options with (sigil of o)
                return 2
            banish out
            set out is calling copy_path with (args at (i + 1))
            set i is i + 1
        else if calling starts_with with a, "--out=":
            var ov as string is a at 6 to (a length)
            banish out
            set out is ov
        else if calling starts_with with a, "--cc=":
            var vc as string is a at 5 to (a length)
            banish o.cc
            set o.cc is vc
        else if calling starts_dash with a:
            var u as string is "psc expand: unknown option '{a}'"
            calling spark.eprintln with u
            banish u
            calling print_expand_help
            calling driver.free_options with (sigil of o)
            return 2
        else:
            if path length > 0:
                calling spark.eprintln with "psc expand: only one target is supported"
                calling driver.free_options with (sigil of o)
                return 2
            set path is a
        set i is i + 1
    banish o.target
    set o.target is calling copy_path with path
    var r as driver.BuildResult is calling driver.build with o
    if not r.ok:
        var err as string is r.error
        var emsg as string is "psc expand: {err}"
        calling spark.eprintln with emsg
        banish emsg
        calling driver.free_result with (sigil of r)
        calling driver.free_options with (sigil of o)
        return 1
    var text as maybe string is calling archivum.read_text with r.artifact
    if not text.is_present:
        calling spark.eprintln with "psc expand: cannot read bundle"
        banish text
        calling driver.free_result with (sigil of r)
        calling driver.free_options with (sigil of o)
        return 2
    if out length > 0:
        if not calling archivum.write_text with out, text.value:
            calling spark.eprintln with "psc expand: cannot write output"
            banish text
            banish out
            calling driver.free_result with (sigil of r)
            calling driver.free_options with (sigil of o)
            return 2
        var msg as string is "wrote {out}"
        calling spark.eprintln with msg
        banish msg
    else:
        calling spark.print with text.value
    banish text
    banish out
    calling driver.free_result with (sigil of r)
    calling driver.free_options with (sigil of o)
    return 0

## Copia owned de un path.
##
## ## Memoria
## Devuelve string owned.
weave copy_path with s as string into string:
    return calling npool.copy_string with s
