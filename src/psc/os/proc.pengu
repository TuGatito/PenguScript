## psc/os/proc.pengu — ejecución de argv sin shell.
##
## POSIX: fork + execvp + waitpid. El hijo hereda stdin/stdout/stderr, así que
## `psc run` conserva la interactividad y los argumentos nunca pasan por `sh`.

insignia psc_os_proc_

## Ejecuta un argv y devuelve el exit code (o 128+señal).
##
## ## Memoria
## Los strings de `argv` son prestados.
## Reemplaza el proceso actual por `argv[0]` (execvp). No vuelve si tiene
## éxito; si falla, devuelve 127.
##
## ## Memoria
## Los strings de `argv` son prestados y deben sobrevivir a la llamada.
antiquus exec_replace with argv as list of string into int:
    r"""
#if defined(_WIN32)
if (argv.len <= 0)
return -1;
char **v = (char **)malloc(((size_t)argv.len + 1) * sizeof(char *));
if (!v)
return -1;
for (int i = 0; i < argv.len; i++)
{
PenguString *s = (PenguString *)pengu_list_at(&argv, i);
v[i] = (s && s->data) ? s->data : (char *)"";
}
v[argv.len] = NULL;
int rc = _spawnvp(_P_WAIT, v[0], (const char *const *)v);
free(v);
return rc;
#else
extern int execvp(const char *, char *const[]);
if (argv.len <= 0)
return 127;
char **v = (char **)malloc(((size_t)argv.len + 1) * sizeof(char *));
if (!v)
return 127;
for (int i = 0; i < argv.len; i++)
{
PenguString *s = (PenguString *)pengu_list_at(&argv, i);
v[i] = (s && s->data) ? s->data : (char *)"";
}
v[argv.len] = NULL;
execvp(v[0], v);
free(v);
return 127;
#endif
"""

antiquus run_argv with argv as list of string into int:
    r"""
#if defined(_WIN32)
if (argv.len <= 0)
return -1;
char **v = (char **)malloc(((size_t)argv.len + 1) * sizeof(char *));
if (!v)
return -1;
for (int i = 0; i < argv.len; i++)
{
PenguString *s = (PenguString *)pengu_list_at(&argv, i);
v[i] = (s && s->data) ? s->data : (char *)"";
}
v[argv.len] = NULL;
int rc = _spawnvp(_P_WAIT, v[0], (const char *const *)v);
free(v);
return rc;
#else
extern int fork(void);
extern int waitpid(int, int *, int);
extern int execvp(const char *, char *const[]);
extern void _exit(int);
#define PSC_WIFEXITED(st) (((st) & 0x7f) == 0)
#define PSC_WEXITSTATUS(st) (((st) & 0xff00) >> 8)
#define PSC_WIFSIGNALED(st) ((((st) & 0x7f) != 0) && (((st) & 0x7f) != 0x7f))
#define PSC_WTERMSIG(st) ((st) & 0x7f)
if (argv.len <= 0)
return -1;
char **v = (char **)malloc(((size_t)argv.len + 1) * sizeof(char *));
if (!v)
return -1;
for (int i = 0; i < argv.len; i++)
{
PenguString *s = (PenguString *)pengu_list_at(&argv, i);
v[i] = (s && s->data) ? s->data : (char *)"";
}
v[argv.len] = NULL;
int pid = fork();
if (pid < 0)
{
free(v);
return -1;
}
if (pid == 0)
{
execvp(v[0], v);
_exit(127);
}
int st = 0;
while (waitpid(pid, &st, 0) < 0)
{
if (errno != EINTR)
{
free(v);
return -1;
}
}
free(v);
if (PSC_WIFEXITED(st))
return PSC_WEXITSTATUS(st);
if (PSC_WIFSIGNALED(st))
return 128 + PSC_WTERMSIG(st);
return -1;
#endif
"""

## Lanza un argv sin esperar y devuelve el PID (0 si falla).
##
## ## Memoria
## Los strings de `argv` son prestados.
antiquus spawn_argv with argv as list of string into int:
    r"""
#if defined(_WIN32)
(void)argv;
return 0;
#else
extern int fork(void);
extern int execvp(const char *, char *const[]);
extern void _exit(int);
if (argv.len <= 0) return 0;
char **v = (char **)malloc(((size_t)argv.len + 1) * sizeof(char *));
if (!v) return 0;
for (int i = 0; i < argv.len; i++) {
    PenguString *s = (PenguString *)pengu_list_at(&argv, i);
    v[i] = (s && s->data) ? s->data : (char *)"";
}
v[argv.len] = NULL;
int pid = fork();
if (pid < 0) { free(v); return 0; }
if (pid == 0) { execvp(v[0], v); _exit(127); }
free(v);
return pid;
#endif
"""

## Espera bloqueante por un PID; devuelve el exit code.
antiquus wait_pid with pid as int into int:
    r"""
#if defined(_WIN32)
(void)pid;
return -1;
#else
extern int waitpid(int, int *, int);
#define PSC_WIFEXITED2(st) (((st) & 0x7f) == 0)
#define PSC_WEXITSTATUS2(st) (((st) & 0xff00) >> 8)
int st = 0;
while (waitpid(pid, &st, 0) < 0) return -1;
if (PSC_WIFEXITED2(st)) return PSC_WEXITSTATUS2(st);
return -1;
#endif
"""

## `true` si el PID sigue vivo (reap no bloqueante).
antiquus pid_alive with pid as int into bool:
    r"""
#if defined(_WIN32)
(void)pid;
return false;
#else
extern int waitpid(int, int *, int);
int st = 0;
int r = waitpid(pid, &st, 1);
return r == 0;
#endif
"""

## Termina un PID (SIGTERM), sin esperar.
antiquus terminate with pid as int into bool:
    r"""
#if defined(_WIN32)
(void)pid;
return false;
#else
extern int kill(int, int);
return kill(pid, 15) == 0;
#endif
"""

## Ejecuta un argv descartando stdout/stderr (benchmarks).
antiquus run_argv_quiet with argv as list of string into int:
    r"""
#if defined(_WIN32)
if (argv.len <= 0)
return -1;
char **v = (char **)malloc(((size_t)argv.len + 1) * sizeof(char *));
if (!v)
return -1;
for (int i = 0; i < argv.len; i++)
{
PenguString *s = (PenguString *)pengu_list_at(&argv, i);
v[i] = (s && s->data) ? s->data : (char *)"";
}
v[argv.len] = NULL;
int rc = _spawnvp(_P_WAIT, v[0], (const char *const *)v);
free(v);
return rc;
#else
extern int fork(void);
extern int waitpid(int, int *, int);
extern int execvp(const char *, char *const[]);
extern void _exit(int);
extern FILE *freopen(const char *, const char *, FILE *);
if (argv.len <= 0) return -1;
char **v = (char **)malloc(((size_t)argv.len + 1) * sizeof(char *));
if (!v) return -1;
for (int i = 0; i < argv.len; i++) {
    PenguString *s = (PenguString *)pengu_list_at(&argv, i);
    v[i] = (s && s->data) ? s->data : (char *)"";
}
v[argv.len] = NULL;
int pid = fork();
if (pid < 0) { free(v); return -1; }
if (pid == 0) {
    FILE *ignored_out = freopen("/dev/null", "w", stdout);
    FILE *ignored_err = freopen("/dev/null", "w", stderr);
    (void)ignored_out;
    (void)ignored_err;
    execvp(v[0], v);
    _exit(127);
}
free(v);
int st = 0;
while (waitpid(pid, &st, 0) < 0) return -1;
return (((st) & 0x7f) == 0) ? (((st) & 0xff00) >> 8) : -1;
#endif
"""

## Lanza `argv` con stdin/stdout/stderr conectados a pipes.
##
## Devuelve el PID y escribe en `in_fd` el extremo de escritura hacia el hijo,
## y en `out_fd`/`err_fd` los extremos de lectura. El llamador debe cerrar los
## tres descriptores con `fd_close` y recolectar el hijo con `wait_pid`.
##
## ## Memoria
## Los strings de `argv` son prestados.
antiquus spawn_piped with argv as list of string, in_fd as ref to int, out_fd as ref to int, err_fd as ref to int into int:
    r"""
#if defined(_WIN32)
(void)argv; (void)in_fd; (void)out_fd; (void)err_fd;
return 0;
#else
extern int pipe(int[2]);
extern int fork(void);
extern int dup2(int, int);
extern int close(int);
extern int execvp(const char *, char *const[]);
extern void _exit(int);

if (argv.len <= 0)
return 0;

char **v = (char **)malloc(((size_t)argv.len + 1) * sizeof(char *));
if (!v)
return 0;
for (int i = 0; i < argv.len; i++)
{
PenguString *s = (PenguString *)pengu_list_at(&argv, i);
v[i] = (s && s->data) ? s->data : (char *)"";
}
v[argv.len] = NULL;

int pin[2], pout[2], perr[2];
if (pipe(pin) != 0)
{
free(v);
return 0;
}
if (pipe(pout) != 0)
{
close(pin[0]); close(pin[1]);
free(v);
return 0;
}
if (pipe(perr) != 0)
{
close(pin[0]); close(pin[1]);
close(pout[0]); close(pout[1]);
free(v);
return 0;
}

int pid = fork();
if (pid < 0)
{
close(pin[0]); close(pin[1]);
close(pout[0]); close(pout[1]);
close(perr[0]); close(perr[1]);
free(v);
return 0;
}
if (pid == 0)
{
close(pin[1]);
close(pout[0]);
close(perr[0]);
if (dup2(pin[0], 0) < 0 || dup2(pout[1], 1) < 0 || dup2(perr[1], 2) < 0)
_exit(127);
close(pin[0]); close(pout[1]); close(perr[1]);
execvp(v[0], v);
_exit(127);
}

close(pin[0]);
close(pout[1]);
close(perr[1]);
free(v);

*in_fd = pin[1];
*out_fd = pout[0];
*err_fd = perr[0];
return pid;
#endif
"""

## Escribe todos los bytes de `data` en `fd`.
##
## Devuelve los bytes escritos, o -1 si el descriptor falla.
antiquus fd_write with fd as int, data as string into int:
    r"""
#if defined(_WIN32)
(void)fd; (void)data;
return -1;
#else
extern long write(int, const void *, unsigned long);
extern int errno;
int total = 0;
while (total < data.len)
{
long n = write(fd, data.data + total, (unsigned long)(data.len - total));
if (n < 0)
{
if (errno == 4)
continue;
return -1;
}
if (n == 0)
return total;
total += (int)n;
}
return total;
#endif
"""

## Lee una línea completa de `fd` (sin el `\n` final).
##
## Devuelve `""` en EOF o error. Es bloqueante.
antiquus fd_read_line with fd as int into string:
    r"""
#if defined(_WIN32)
(void)fd;
return pengu_string_from_cstr_len("", 0);
#else
extern long read(int, void *, unsigned long);
extern int errno;
int cap = 256;
int len = 0;
char *buf = (char *)malloc((size_t)cap);
if (!buf)
return pengu_string_from_cstr_len("", 0);
for (;;)
{
char ch = 0;
long n = read(fd, &ch, 1);
if (n < 0)
{
if (errno == 4)
continue;
free(buf);
return pengu_string_from_cstr_len("", 0);
}
if (n == 0)
break;
if (ch == '\n')
break;
if (len + 1 >= cap)
{
int next = cap * 2;
char *grown = (char *)realloc(buf, (size_t)next);
if (!grown)
{
free(buf);
return pengu_string_from_cstr_len("", 0);
}
buf = grown;
cap = next;
}
buf[len++] = ch;
}
PenguString out = pengu_string_owned(buf, len);
free(buf);
return out;
#endif
"""

## Cierra un descriptor.
antiquus fd_close with fd as int into void:
    r"""
#if defined(_WIN32)
(void)fd;
#else
extern int close(int);
if (fd >= 0)
close(fd);
#endif
"""
