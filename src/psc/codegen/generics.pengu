## psc/codegen/generics.pengu — especialización de funciones genéricas.
##
## F3 reconoce los `shard` pero no materializa instancias. F4 crea una función
## C por cada combinación de argumentos de tipo que aparece en una llamada
## explícita (`f of T`). La sustitución se guarda en `CgNames.subst`.

import psc.ast.kind as pskind
import psc.ast.node as psast
import psc.sema.ast as astutil
import psc.sema.annotate as ann
import psc.sema.modules.loader as loader
import psc.sema.names as npool
import psc.sema.symbols.symbol as sym
import psc.sema.symbols.table as symbols
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.types.compat as scompat
import psc.sema.annotate as ann
import psc.sema.generics.instantiate as ginst

import psc.codegen.context as context
import psc.codegen.catalog as catalog
import psc.codegen.type_ast as tast
import psc.codegen.emit as emit

insignia psc_codegen_generics_

## Busca una especialización existente.
##
## ## Memoria
## O(funciones).
weave find_spec with c as ref to context.CgContext, sid as int, args as list of int into int:
    var i as int is 0
    while i < c->catalog.functions.len:
        var f as catalog.CgFunction is (c->catalog.functions at i)
        if f.is_spec and f.symbol == sid and f.spec_args.len == args.len:
            var same as bool is true
            var j as int is 0
            while j < args.len:
                if (f.spec_args at j) != (args at j):
                    set same is false
                set j is j + 1
            if same:
                return i
        set i is i + 1
    return -1

## `true` si una especialización de método debe recibir `self` por valor.
##
## La plantilla de `enchanting shard T` guarda `self_value = false` porque su
## receptor es `TkTypeParam`; la decisión real sólo se conoce al monomorfizar.
## Los primitivos van por valor y `string`, los nominales y los contenedores
## por puntero, exactamente igual que sus métodos no genéricos.
##
## ## Memoria
## O(1).
weave spec_self_value with c as ref to context.CgContext, base as catalog.CgFunction, recv_type as int into bool:
    if base.self_value:
        return true
    if recv_type <= 0:
        return false
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), recv_type
    var guard as int is 0
    while guard < 16 and (t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal):
        set t is calling types.at with (sigil of c->program->types), t.b
        set guard is guard + 1
    if t.kind != tk.SemaTypeKind.TkBase:
        return false
    var name as string is calling npool.text with (sigil of c->program->names), t.name
    return name != "string"

## Añade una especialización de una función genérica.
##
## ## Memoria
## Añade al catálogo; no posee strings.
weave add_spec with c as ref to context.CgContext, base_idx as int, args as list of int into int:
    var base as catalog.CgFunction is (c->catalog.functions at base_idx)
    var ex as int is calling find_spec with c, base.symbol, args
    if ex >= 0:
        return ex
    var bname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), base.c_name)
    var cname as string is "{bname}_inst{c->catalog.functions.len}"
    banish bname
    var cid as int is calling npool.intern with (sigil of c->program->names), cname
    banish cname
    var tps as list of int is list of int
    var i as int is 0
    while i < base.tparams.len:
        calling tps.push with (base.tparams at i)
        set i is i + 1
    var sargs as list of int is list of int
    set i is 0
    while i < args.len:
        calling sargs.push with (args at i)
        set i is i + 1
    # Si la plantilla es un método de shard, su receptor es el parámetro `T`:
    # hay que materializarlo con los argumentos para que la firma C sea
    # `int32_t self` y no `T* self`.
    var rtv as int is base.recv_type
    var sval as bool is base.self_value
    if base.is_method and base.recv_type > 0 and base.tparams.len == args.len and args.len > 0:
        var rtty as tk.SemaType is calling types.at with (sigil of c->program->types), rtv
        if rtty.kind == tk.SemaTypeKind.TkTypeParam:
            var tsub as map of int to int is map of int to int
            defer banish tsub
            var ti as int is 0
            while ti < base.tparams.len:
                calling tsub.put with (base.tparams at ti), (args at ti)
                set ti is ti + 1
            var mat as int is calling ginst.subst_deep with (sigil of c->program->symbols), rtv, tsub
            if mat > 0:
                set rtv is mat
                set sval is calling spec_self_value with c, base, rtv
    var f as catalog.CgFunction is with name is base.name, symbol is base.symbol, node is base.node, module is base.module, is_declare is false, is_antiquus is false, is_method is base.is_method, recv_type is rtv, self_value is sval, is_ritual is base.is_ritual, tparams is tps, spec_args is sargs, is_generic is true, is_spec is true, is_main is false, c_name is cid
    calling c->catalog.functions.push with f
    return c->catalog.functions.len - 1

## Unifica un tipo formal con uno actual y anota los parámetros.
##
## ## Memoria
## No asigna; usa el mapa prestado.
weave unify with c as ref to context.CgContext, formal as int, actual as int, subst as ref to map of int to int into void:
    if formal <= 0 or actual <= 0:
        return
    var ft as tk.SemaType is calling types.at with (sigil of c->program->types), formal
    var at as tk.SemaType is calling types.at with (sigil of c->program->types), actual
    if ft.kind == tk.SemaTypeKind.TkTypeParam:
        calling subst.put with ft.name, actual
        return
    if ft.kind == tk.SemaTypeKind.TkRef or ft.kind == tk.SemaTypeKind.TkFrozen or ft.kind == tk.SemaTypeKind.TkArray or ft.kind == tk.SemaTypeKind.TkList or ft.kind == tk.SemaTypeKind.TkSlice or ft.kind == tk.SemaTypeKind.TkRange or ft.kind == tk.SemaTypeKind.TkMaybe:
        if at.kind == ft.kind or at.kind == tk.SemaTypeKind.TkRef:
            calling unify with c, ft.a, at.a, subst
        return
    if ft.kind == tk.SemaTypeKind.TkResult:
        if at.kind == tk.SemaTypeKind.TkResult:
            calling unify with c, ft.a, at.a, subst
            calling unify with c, ft.b, at.b, subst
        return
    if ft.kind == tk.SemaTypeKind.TkMap:
        if at.kind == tk.SemaTypeKind.TkMap:
            calling unify with c, ft.a, at.a, subst
            calling unify with c, ft.b, at.b, subst
        return
    if ft.kind == tk.SemaTypeKind.TkRune or ft.kind == tk.SemaTypeKind.TkEcho or ft.kind == tk.SemaTypeKind.TkOmen or ft.kind == tk.SemaTypeKind.TkAlias or ft.kind == tk.SemaTypeKind.TkSeal or ft.kind == tk.SemaTypeKind.TkConcept:
        var fii as int is calling symbols.instance_for_type with (sigil of c->program->symbols), formal
        var aii as int is calling symbols.instance_for_type with (sigil of c->program->symbols), actual
        if fii >= 0 and aii >= 0:
            var finst as sym.SemaInstance is (c->program->symbols.instances at fii)
            var ainst as sym.SemaInstance is (c->program->symbols.instances at aii)
            if finst.template_type == ainst.template_type and finst.args_count == ainst.args_count:
                var qi as int is 0
                while qi < finst.args_count:
                    calling unify with c, (c->program->symbols.instance_args at (finst.args_first + qi)), (c->program->symbols.instance_args at (ainst.args_first + qi)), subst
                    set qi is qi + 1
        return
    if ft.kind == tk.SemaTypeKind.TkTuple:
        if at.kind == tk.SemaTypeKind.TkTuple and ft.count == at.count:
            var ti as int is 0
            while ti < ft.count:
                calling unify with c, (c->program->types.type_children at (ft.first + ti)), (c->program->types.type_children at (at.first + ti)), subst
                set ti is ti + 1
        return
    if ft.kind == tk.SemaTypeKind.TkFn:
        if at.kind == tk.SemaTypeKind.TkFn:
            var fi as types.SemaFnInfo is (c->program->types.fn_infos at ft.a)
            var ai as types.SemaFnInfo is (c->program->types.fn_infos at at.a)
            var pi as int is 0
            while pi < fi.params_count and pi < ai.params_count:
                var fp as types.SemaFnParam is (c->program->types.fn_params at (fi.params_first + pi))
                var ap as types.SemaFnParam is (c->program->types.fn_params at (ai.params_first + pi))
                calling unify with c, fp.type, ap.type, subst
                set pi is pi + 1
            calling unify with c, fi.return_type, ai.return_type, subst
        return

## Infiere los argumentos de tipo de una llamada genérica.
##
## ## Memoria
## Devuelve una lista owned; vacía si no se puede inferir.
weave infer_from_actual with c as ref to context.CgContext, base_idx as int, actuals as list of int into list of int:
    var out as list of int is list of int
    var bf as catalog.CgFunction is (c->catalog.functions at base_idx)
    if not bf.is_generic or bf.tparams.len == 0:
        return out
    var subst as map of int to int is map of int to int
    var sv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), bf.symbol
    var ft as tk.SemaType is calling types.at with (sigil of c->program->types), sv.type
    if ft.kind != tk.SemaTypeKind.TkFn:
        banish subst
        return out
    var info as types.SemaFnInfo is (c->program->types.fn_infos at ft.a)
    var pi as int is 0
    while pi < info.params_count and pi < actuals.len:
        var p as types.SemaFnParam is (c->program->types.fn_params at (info.params_first + pi))
        calling unify with c, p.type, (actuals at pi), (sigil of subst)
        set pi is pi + 1
    var ti as int is 0
    while ti < bf.tparams.len:
        var tp as int is (bf.tparams at ti)
        if (calling subst.has with tp):
            calling out.push with (calling subst.get with tp)
        set ti is ti + 1
    banish subst
    return out

## Recorre un nodo buscando llamadas genéricas explícitas.
##
## ## Memoria
## Recursión sobre el AST.
weave scan with c as ref to context.CgContext, m as loader.SemaModule, node as int into void:
    if node < 0:
        return
    var ast as ref to psast.PsAst is (sigil of m.parse.ast)
    if (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdCallingExpr:
        # Preespecializa métodos de contenedor (`m.keys`, `s.is_empty`) antes
        # de emitir prototipos: si se crean durante el cuerpo, C no ve la firma.
        var mt0 as int is calling astutil.node_child with ast, node, 0
        if mt0 >= 0:
            var mtl as int is calling expr_last_token with ast, mt0
            if mtl >= 0:
                var mtxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), mtl
                var mnid0 as int is calling npool.intern with (sigil of c->program->names), mtxt
                var rn0 as int is mt0
                if rn0 >= 0:
                    var rt0 as int is calling ann.type_of with (sigil of m.annotations), mt0
                    if rt0 <= 0:
                        var rsid0 as int is calling ann.symbol_of with (sigil of m.annotations), rn0
                        if rsid0 >= 0:
                            var rsv0 as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), rsid0
                            set rt0 is rsv0.type
                    if rt0 > 0:
                        var gmi0 as int is calling find_generic_method with c, mnid0, rt0
                        if gmi0 >= 0:
                            var ignored_gmi as int is calling ensure_method_spec with c, gmi0, rt0, node
                banish mtxt
        var gargs as int is calling astutil.node_child with ast, node, 1
        var target as int is calling astutil.node_child with ast, node, 0
        if target >= 0:
            var last as int is calling expr_last_token with ast, target
            if last >= 0:
                var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), last
                var nid as int is calling npool.intern with (sigil of c->program->names), txt
                # `mod.fn`: preespecializa la función de módulo por su nombre C
                # (`tally_sum`), antes de DCE.
                var qb as int is calling astutil.token_child with ast, target, 0
                if qb >= 0 and qb != last:
                    var qbt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), qb
                    var qexp as string is "{qbt}_{txt}"
                    var qfi as int is 0
                    while qfi < c->catalog.functions.len:
                        var qf as catalog.CgFunction is (c->catalog.functions at qfi)
                        var qfn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), qf.c_name)
                        if qfn == qexp and not qf.is_method and qf.is_generic:
                            var qact as list of int is list of int
                            var qargs as int is calling astutil.node_child with ast, node, 2
                            if qargs >= 0:
                                var qan as int is calling astutil.child_count with ast, qargs
                                var qai as int is 0
                                while qai < qan:
                                    var qarg as int is calling astutil.node_child with ast, qargs, qai
                                    if qarg >= 0:
                                        var qav as int is qarg
                                        if (calling astutil.kind_of with ast, qarg) == pskind.NodeKind.NdPosArg:
                                            set qav is calling astutil.node_child with ast, qarg, 0
                                        if qav >= 0:
                                            var qaty as int is calling ann.type_of with (sigil of m.annotations), qav
                                            if qaty > 0:
                                                calling qact.push with qaty
                                    set qai is qai + 1
                            var qinf as list of int is calling infer_from_actual with c, qfi, qact
                            if qinf.len == qf.tparams.len and qinf.len > 0:
                                var qsi as int is calling add_spec with c, qfi, qinf
                            banish qinf
                            banish qact
                        banish qfn
                        set qfi is qfi + 1
                    banish qexp
                    banish qbt
                # Alias puro `get_*` de un método `@mutates` genérico: la
                # llamada no pasa por `by_name`, así que especializamos aquí
                # antes de emitir prototipos.
                var asid0 as int is calling ann.symbol_of with (sigil of m.annotations), node
                if asid0 >= 0:
                    var asv0 as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), asid0
                    if (asv0.flags & sym.SYM_GET_ALIAS) != 0 and asv0.alias_of >= 0 and (calling c->catalog.by_symbol.has with asv0.alias_of):
                        var abi as int is calling c->catalog.by_symbol.get with asv0.alias_of
                        var abf as catalog.CgFunction is (c->catalog.functions at abi)
                        if abf.is_generic and abf.tparams.len > 0:
                            var rtg as int is -1
                            var tgn as int is calling astutil.node_child with ast, node, 0
                            if tgn >= 0:
                                var rgn as int is tgn
                                if (calling astutil.kind_of with ast, tgn) == pskind.NodeKind.NdNormalTarget:
                                    set rgn is calling astutil.node_child with ast, tgn, 0
                                if rgn >= 0:
                                    set rtg is calling ann.type_of with (sigil of m.annotations), rgn
                            if rtg > 0:
                                var gty0 as tk.SemaType is calling types.at with (sigil of c->program->types), rtg
                                var gguard as int is 0
                                while gguard < 16 and (gty0.kind == tk.SemaTypeKind.TkRef or gty0.kind == tk.SemaTypeKind.TkFrozen or gty0.kind == tk.SemaTypeKind.TkAlias or gty0.kind == tk.SemaTypeKind.TkSeal):
                                    if gty0.kind == tk.SemaTypeKind.TkAlias or gty0.kind == tk.SemaTypeKind.TkSeal:
                                        if gty0.b <= 0:
                                            break
                                        set rtg is gty0.b
                                    else:
                                        if gty0.a <= 0:
                                            break
                                        set rtg is gty0.a
                                    set gty0 is calling types.at with (sigil of c->program->types), rtg
                                    set gguard is gguard + 1
                                var gargs0 as list of int is list of int
                                calling gargs0.push with rtg
                                var gspec0 as int is calling add_spec with c, abi, gargs0
                                banish gargs0
                banish nid
                if calling c->catalog.by_name.has with nid:
                    var bi as int is calling c->catalog.by_name.get with nid
                    var bf as catalog.CgFunction is (c->catalog.functions at bi)
                    if bf.is_generic:
                        var is_explicit as bool is gargs >= 0 and (calling astutil.kind_of with ast, gargs) == pskind.NodeKind.NdGenericArgs
                        if is_explicit:
                            var args as list of int is list of int
                            var ai as int is 0
                            var an as int is calling astutil.child_count with ast, gargs
                            while ai < an:
                                var atn as int is calling astutil.node_child with ast, gargs, ai
                                if atn >= 0:
                                    var tid as int is calling tast.from_ast with c, m, atn
                                    if tid > 0:
                                        calling args.push with tid
                                set ai is ai + 1
                            if args.len == bf.tparams.len:
                                var ig1 as int is calling add_spec with c, bi, args
                            banish args
                        else:
                            var bmod as loader.SemaModule is (c->program->modules at bf.module)
                            if not (bmod.is_std or ((bmod.path length) >= 4 and (bmod.path at 0 to 4) == "std/")):
                                var actuals as list of int is list of int
                                var argn as int is calling astutil.node_child with ast, node, 2
                                if argn >= 0:
                                    var ac as int is calling astutil.child_count with ast, argn
                                    var a2 as int is 0
                                    while a2 < ac:
                                        var an2 as int is calling astutil.node_child with ast, argn, a2
                                        if an2 >= 0:
                                            var av2 as int is an2
                                            if (calling astutil.kind_of with ast, an2) == pskind.NodeKind.NdPosArg:
                                                set av2 is calling astutil.node_child with ast, an2, 0
                                            if av2 >= 0:
                                                var aty2 as int is calling ann.type_of with (sigil of m.annotations), av2
                                                if aty2 > 0:
                                                    calling actuals.push with aty2
                                        set a2 is a2 + 1
                                var inf as list of int is calling infer_from_actual with c, bi, actuals
                                if inf.len == bf.tparams.len and inf.len > 0:
                                    var ig2 as int is calling add_spec with c, bi, inf
                                banish inf
                                banish actuals
    var i as int is 0
    var n as int is calling astutil.child_count with ast, node
    while i < n:
        var ch as int is calling astutil.node_child with ast, node, i
        if ch >= 0:
            calling scan with c, m, ch
        set i is i + 1

## Último token de un target (sin depender de expr para evitar ciclos).
##
## ## Memoria
## O(nodos).
weave expr_last_token with ast as ref to psast.PsAst, node as int into int:
    if node < 0:
        return -1
    var n as int is calling astutil.child_count with ast, node
    var i as int is n - 1
    while i >= 0:
        var t as int is calling astutil.token_child with ast, node, i
        if t >= 0:
            return t
        var ch as int is calling astutil.node_child with ast, node, i
        if ch >= 0:
            var got as int is calling expr_last_token with ast, ch
            if got >= 0:
                return got
        set i is i - 1
    return -1

## Añade al catálogo las `CgType` de las instancias nominales.
##
## La plantilla ya está en `catalog.by_type` (se registró aunque sea genérica).
## Cada instancia usa el nodo/módulo de la plantilla, pero su `type_id` y sus
## campos son los de la `SemaNominalInfo` instanciada.
##
## ## Memoria
## Añade tipos al catálogo; no posee strings.
weave collect_type_instances with c as ref to context.CgContext into void:
    var i as int is 0
    while i < c->program->symbols.instances.len:
        var inst as sym.SemaInstance is (c->program->symbols.instances at i)
        if inst.type > 0 and not (calling c->catalog.by_type.has with inst.type):
            var ity as tk.SemaType is calling types.at with (sigil of c->program->types), inst.type
            var iinfo as types.SemaNominalInfo is (c->program->types.nominal_infos at ity.a)
            var check as types.SemaNominalInfo is iinfo
            if iinfo.template_info >= 0 and iinfo.template_info < c->program->types.nominal_infos.len:
                set check is (c->program->types.nominal_infos at iinfo.template_info)
            var erased as bool is true
            var efi as int is 0
            while efi < check.fields_count:
                var ef as types.SemaField is (c->program->types.fields at (check.fields_first + efi))
                if calling catalog.has_type_param with c->program, ef.type:
                    set erased is false
                set efi is efi + 1
            if erased:
                set i is i + 1
                continue
            var template_idx as int is -1
            if calling c->catalog.by_type.has with inst.template_type:
                set template_idx is calling c->catalog.by_type.get with inst.template_type
            if template_idx >= 0 and template_idx < c->catalog.types.len:
                var base as catalog.CgType is (c->catalog.types at template_idx)
                var ct as catalog.CgType is with type_id is inst.type, node is base.node, module is base.module, is_struct is base.is_struct, is_omen is base.is_omen
                var idx as int is c->catalog.types.len
                calling c->catalog.types.push with ct
                calling c->catalog.by_type.put with inst.type, idx
        set i is i + 1

## Argumentos de tipo visibles en un receptor (`list of int`, `map of K to V`).
##
## ## Memoria
## Devuelve una lista owned.
weave type_args_of with c as ref to context.CgContext, id as int into list of int:
    var out as list of int is list of int
    if id <= 0:
        return out
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), id
    while t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkFrozen:
        if t.a <= 0:
            return out
        set id is t.a
        set t is calling types.at with (sigil of c->program->types), id
    if t.kind == tk.SemaTypeKind.TkList or t.kind == tk.SemaTypeKind.TkMaybe or t.kind == tk.SemaTypeKind.TkSlice or t.kind == tk.SemaTypeKind.TkMany or t.kind == tk.SemaTypeKind.TkRange or t.kind == tk.SemaTypeKind.TkArray:
        calling out.push with t.a
    else if t.kind == tk.SemaTypeKind.TkMap or t.kind == tk.SemaTypeKind.TkResult:
        calling out.push with t.a
        calling out.push with t.b
    else if t.kind == tk.SemaTypeKind.TkTuple:
        var i as int is 0
        while i < t.count:
            calling out.push with (c->program->types.type_children at (t.first + i))
            set i is i + 1
    return out

## Kind estructural de un receptor de contenedor (para emparejar métodos genéricos).
weave container_kind with c as ref to context.CgContext, id as int into int:
    if id <= 0:
        return -1
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), id
    var guard as int is 0
    while guard < 12 and (t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkFrozen or t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal):
        if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
            if t.b <= 0:
                return -1
            set t is calling types.at with (sigil of c->program->types), t.b
        else:
            if t.a <= 0:
                return -1
            set t is calling types.at with (sigil of c->program->types), t.a
        set guard is guard + 1
    if t.kind == tk.SemaTypeKind.TkList:
        return 1
    if t.kind == tk.SemaTypeKind.TkMap:
        return 2
    if t.kind == tk.SemaTypeKind.TkMaybe:
        return 3
    if t.kind == tk.SemaTypeKind.TkResult:
        return 4
    if t.kind == tk.SemaTypeKind.TkSlice or t.kind == tk.SemaTypeKind.TkMany:
        return 5
    if t.kind == tk.SemaTypeKind.TkBase:
        if calling scompat.is_string with (sigil of c->program->types), id:
            return 100
        return 101
    return -1

## Busca la plantilla genérica de un método por nombre y forma del receptor.
## Deriva los argumentos de tipo de una especialización unificando el receptor
## plantilla con el receptor concreto. Devuelve vacío si algún parámetro queda
## sin ligar.
##
## ## Memoria
## Devuelve una lista owned.
weave spec_args_for with c as ref to context.CgContext, base_idx as int, recv_id as int into list of int:
    var out as list of int is list of int
    var bf as catalog.CgFunction is (c->catalog.functions at base_idx)
    if not bf.is_generic or bf.tparams.len == 0:
        return out
    var subst as map of int to int is map of int to int
    calling unify with c, bf.recv_type, recv_id, (sigil of subst)
    var ti as int is 0
    while ti < bf.tparams.len:
        var tp as int is (bf.tparams at ti)
        if calling subst.has with tp:
            calling out.push with (calling subst.get with tp)
        else:
            banish subst
            banish out
            return list of int
        set ti is ti + 1
    banish subst
    return out

## Tipo anotado de un nodo de la llamada (sin depender de `expr`).
weave call_arg_type with c as ref to context.CgContext, node as int into int:
    if c->current_module < 0 or node < 0:
        return -1
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var t as int is calling ann.type_of with (sigil of m.annotations), node
    if c->names.subst.len > 0:
        return calling subst_codegen with c, t
    return t

## Argumentos de una especialización de método: parámetros del receptor más
## los `shard` propios del método, inferidos de los argumentos de la llamada.
weave spec_args_for_call with c as ref to context.CgContext, base_idx as int, recv_id as int, node as int into list of int:
    var out as list of int is list of int
    var bf as catalog.CgFunction is (c->catalog.functions at base_idx)
    if not bf.is_generic or bf.tparams.len == 0:
        return out
    var subst as map of int to int is map of int to int
    defer banish subst
    calling unify with c, bf.recv_type, recv_id, (sigil of subst)
    var missing as int is 0
    var ti as int is 0
    while ti < bf.tparams.len:
        if not (calling subst.has with (bf.tparams at ti)):
            set missing is missing + 1
        set ti is ti + 1
    if missing > 0 and node >= 0 and bf.symbol >= 0 and c->current_module >= 0:
        var cm as loader.SemaModule is (c->program->modules at c->current_module)
        var cma as ref to psast.PsAst is (sigil of cm.parse.ast)
        var sv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), bf.symbol
        var fty as tk.SemaType is calling types.at with (sigil of c->program->types), sv.type
        if fty.kind == tk.SemaTypeKind.TkFn:
            var info as types.SemaFnInfo is (c->program->types.fn_infos at fty.a)
            # Los argumentos viven en `arg_list`: hijo 2 si hay `of T` explícito,
            # hijo 1 si no.
            var argm as int is calling astutil.node_child with cma, node, 2
            if argm < 0 or (calling astutil.kind_of with cma, argm) != pskind.NodeKind.NdArgList:
                set argm is calling astutil.node_child with cma, node, 1
            if argm >= 0 and (calling astutil.kind_of with cma, argm) == pskind.NodeKind.NdArgList:
                var ac as int is calling astutil.child_count with cma, argm
                var ai as int is 0
                var pi as int is 0
                while ai < ac and pi < info.params_count:
                    var an2 as int is calling astutil.node_child with cma, argm, ai
                    if an2 >= 0:
                        var av2 as int is an2
                        if (calling astutil.kind_of with cma, an2) == pskind.NodeKind.NdPosArg:
                            set av2 is calling astutil.node_child with cma, an2, 0
                        if av2 >= 0:
                            var aty as int is calling call_arg_type with c, av2
                            if aty > 0:
                                var fp as types.SemaFnParam is (c->program->types.fn_params at (info.params_first + pi))
                                calling unify with c, fp.type, aty, (sigil of subst)
                    set ai is ai + 1
                    set pi is pi + 1
    var ti2 as int is 0
    while ti2 < bf.tparams.len:
        var tp as int is (bf.tparams at ti2)
        if calling subst.has with tp:
            calling out.push with (calling subst.get with tp)
        else:
            banish out
            return list of int
        set ti2 is ti2 + 1
    return out

weave find_generic_method with c as ref to context.CgContext, name as int, recv_id as int into int:
    var rk as int is calling container_kind with c, recv_id
    if rk < 0:
        return -1
    var i as int is 0
    while i < c->catalog.functions.len:
        var f as catalog.CgFunction is (c->catalog.functions at i)
        if f.is_method and f.is_generic and not f.is_spec and f.name == name:
            var fk as int is calling container_kind with c, f.recv_type
            if fk == rk:
                var cand as list of int is calling spec_args_for with c, i, recv_id
                if cand.len == f.tparams.len and cand.len > 0:
                    banish cand
                    return i
                banish cand
        set i is i + 1
    return -1

## Especializa un método genérico para un receptor concreto.
##
## ## Memoria
## Puede añadir una `CgFunction`; devuelve el índice.
weave ensure_method_spec with c as ref to context.CgContext, base_idx as int, recv_id as int, node as int into int:
    if base_idx < 0:
        return base_idx
    var bf as catalog.CgFunction is (c->catalog.functions at base_idx)
    if not bf.is_generic or bf.tparams.len == 0:
        return base_idx
    var args as list of int is calling spec_args_for_call with c, base_idx, recv_id, node
    if args.len != bf.tparams.len or args.len == 0:
        banish args
        return base_idx
    var si as int is calling add_method_spec with c, base_idx, recv_id, args
    banish args
    if si < 0:
        return base_idx
    return si

## Añade la especialización de un método genérico para un receptor concreto.
##
## ## Memoria
## Añade una `CgFunction`; no posee strings.
weave add_method_spec with c as ref to context.CgContext, base_idx as int, recv_type as int, args as list of int into int:
    var base as catalog.CgFunction is (c->catalog.functions at base_idx)
    var ex as int is calling find_spec with c, base.symbol, args
    if ex >= 0:
        return ex
    # Nunca especializar con type params sin resolver: produciría firmas y
    # cuerpos con `T` sustituido por sí mismo.
    if not calling all_concrete with c, args:
        return -1
    # Respeta los bounds (`where T: Num`): no se genera `list_sum` para string
    # o para un rune que no implemente el concepto.
    if base.symbol >= 0:
        var bsv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), base.symbol
        var bi as int is 0
        while bi < bsv.bounds_count:
            var concept as int is (c->program->types.bounds at (bsv.bounds_first + bi))
            var ai as int is bi
            if ai >= args.len:
                set ai is args.len - 1
            var ctxt as string is calling npool.text with (sigil of c->program->names), (calling types.at with (sigil of c->program->types), concept).name
            var argt as tk.SemaType is calling types.at with (sigil of c->program->types), (args at ai)
            if ctxt == "Num" or ctxt == "Integrum" or ctxt == "Real":
                if argt.kind != tk.SemaTypeKind.TkBase:
                    return -1
            if ai < 0 or not (calling scompat.concept_satisfied with (sigil of c->program->types), (args at ai), concept):
                return -1
            set bi is bi + 1
    var bname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), base.c_name)
    var cname as string is "{bname}_inst{c->catalog.functions.len}"
    banish bname
    var cid as int is calling npool.intern with (sigil of c->program->names), cname
    banish cname
    var tps as list of int is list of int
    var i as int is 0
    while i < base.tparams.len:
        calling tps.push with (base.tparams at i)
        set i is i + 1
    var sargs as list of int is list of int
    set i is 0
    while i < args.len:
        calling sargs.push with (args at i)
        set i is i + 1
    # Si el receptor es la plantilla nominal (`Box` de `enchanting Box shard T`),
    # materializa la instancia con los args del receptor para que la firma C use
    # `Box__int*` y no `Box*`.
    var rtv as int is recv_type
    if rtv > 0 and (calling symbols.instance_for_type with (sigil of c->program->symbols), rtv) < 0:
        var rtty as tk.SemaType is calling types.at with (sigil of c->program->types), rtv
        var is_nom as bool is rtty.kind == tk.SemaTypeKind.TkRune or rtty.kind == tk.SemaTypeKind.TkEcho or rtty.kind == tk.SemaTypeKind.TkOmen or rtty.kind == tk.SemaTypeKind.TkAlias or rtty.kind == tk.SemaTypeKind.TkSeal or rtty.kind == tk.SemaTypeKind.TkConcept
        if is_nom and rtty.a >= 0 and rtty.a < c->program->types.nominal_infos.len:
            var rinfo as types.SemaNominalInfo is (c->program->types.nominal_infos at rtty.a)
            if rinfo.tparams_count > 0 and args.len >= rinfo.tparams_count:
                var racc as list of int is list of int
                defer banish racc
                var ri as int is 0
                while ri < rinfo.tparams_count:
                    calling racc.push with (args at ri)
                    set ri is ri + 1
                var rinst as int is calling ginst.instantiate_nominal with (sigil of c->program->symbols), rtv, racc
                if rinst > 0:
                    set rtv is rinst
    var sval as bool is calling spec_self_value with c, base, rtv
    var f as catalog.CgFunction is with name is base.name, symbol is base.symbol, node is base.node, module is base.module, is_declare is false, is_antiquus is false, is_method is true, recv_type is rtv, self_value is sval, is_ritual is base.is_ritual, tparams is tps, spec_args is sargs, is_generic is true, is_spec is true, is_main is false, c_name is cid
    calling c->catalog.functions.push with f
    return c->catalog.functions.len - 1

## Tipo del receptor de una especialización de método.
##
## El catálogo puede guardar la plantilla nominal (`Box`) en lugar de
## `Box of int`; aquí se materializa con los primeros `spec_args`, que son los
## parámetros del receptor (los del método van después).
##
## ## Memoria
## Puede crear una instancia nominal; no posee strings.
weave receiver_type_of with c as ref to context.CgContext, f as catalog.CgFunction into int:
    var rtv as int is f.recv_type
    if rtv <= 0:
        return rtv
    var syms as ref to symbols.SemaSymbols is (sigil of c->program->symbols)
    if (calling symbols.instance_for_type with syms, rtv) >= 0:
        return rtv
    var rtty as tk.SemaType is calling types.at with (sigil of c->program->types), rtv
    var is_nom as bool is rtty.kind == tk.SemaTypeKind.TkRune or rtty.kind == tk.SemaTypeKind.TkEcho or rtty.kind == tk.SemaTypeKind.TkOmen or rtty.kind == tk.SemaTypeKind.TkAlias or rtty.kind == tk.SemaTypeKind.TkSeal or rtty.kind == tk.SemaTypeKind.TkConcept
    if not is_nom or rtty.a < 0 or rtty.a >= c->program->types.nominal_infos.len:
        return rtv
    var rinfo as types.SemaNominalInfo is (c->program->types.nominal_infos at rtty.a)
    if rinfo.tparams_count <= 0 or f.spec_args.len < rinfo.tparams_count:
        return rtv
    var acc as list of int is list of int
    defer banish acc
    var i as int is 0
    while i < rinfo.tparams_count:
        calling acc.push with (f.spec_args at i)
        set i is i + 1
    var nid as int is calling ginst.instantiate_nominal with syms, rtv, acc
    if nid > 0:
        return nid
    return rtv

## `true` si todos los args de una lista son concretos.
##
## ## Memoria
## O(args).
weave all_concrete with c as ref to context.CgContext, args as list of int into bool:
    var i as int is 0
    while i < args.len:
        var t as tk.SemaType is calling types.at with (sigil of c->program->types), (args at i)
        if t.kind == tk.SemaTypeKind.TkTypeParam:
            return false
        if t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkFrozen or t.kind == tk.SemaTypeKind.TkList or t.kind == tk.SemaTypeKind.TkMaybe or t.kind == tk.SemaTypeKind.TkMap or t.kind == tk.SemaTypeKind.TkResult:
            # Los args anidados con T no se especializan en esta pasada.
            var nested as list of int is calling type_args_of with c, (args at i)
            var ok as bool is calling all_concrete with c, nested
            banish nested
            if not ok:
                return false
        set i is i + 1
    return true

## Especializa los métodos de todas las instancias nominales.
##
## ## Memoria
## Añade funciones al catálogo.
weave collect_method_instances with c as ref to context.CgContext into void:
    var base_count as int is c->catalog.functions.len
    var inst_count as int is c->program->symbols.instances.len
    var ii as int is 0
    while ii < inst_count:
        var inst as sym.SemaInstance is (c->program->symbols.instances at ii)
        var args as list of int is list of int
        var ai as int is 0
        while ai < inst.args_count:
            calling args.push with (c->program->symbols.instance_args at (inst.args_first + ai))
            set ai is ai + 1
        var fi as int is 0
        while fi < base_count:
            var bf as catalog.CgFunction is (c->catalog.functions at fi)
            if bf.is_method and bf.is_generic and not bf.is_spec and bf.recv_type == inst.template_type and bf.tparams.len == args.len and calling all_concrete with c, args:
                var ignored as int is calling add_method_spec with c, fi, inst.type, args
            set fi is fi + 1
        banish args
        set ii is ii + 1
    # Preespecializa métodos sencillos de list/map usados por la stdlib. Los
    # métodos con callbacks se crean en `ensure_method_spec` cuando se usan.
    var ti as int is 0
    var type_count as int is c->program->types.types.len
    while ti < type_count:
        var args2 as list of int is calling type_args_of with c, ti
        var orig2 as tk.SemaType is calling types.at with (sigil of c->program->types), ti
        if (orig2.kind == tk.SemaTypeKind.TkRef or orig2.kind == tk.SemaTypeKind.TkFrozen):
            banish args2
            set ti is ti + 1
            continue
        if args2.len > 0 and calling all_concrete with c, args2:
            var rt2 as tk.SemaType is calling types.at with (sigil of c->program->types), ti
            while rt2.kind == tk.SemaTypeKind.TkRef or rt2.kind == tk.SemaTypeKind.TkFrozen:
                if rt2.a <= 0:
                    break
                set rt2 is calling types.at with (sigil of c->program->types), rt2.a
            if rt2.kind == tk.SemaTypeKind.TkList or rt2.kind == tk.SemaTypeKind.TkMap:
                var fi2 as int is 0
                while fi2 < base_count:
                    var bf2 as catalog.CgFunction is (c->catalog.functions at fi2)
                    var bn2 as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), bf2.name)
                    if bf2.is_method and bf2.is_generic and not bf2.is_spec and bf2.recv_type > 0 and (bn2 == "sum" or bn2 == "at_or" or bn2 == "size"):
                        var bt2 as tk.SemaType is calling types.at with (sigil of c->program->types), bf2.recv_type
                        if bt2.kind == rt2.kind and bf2.tparams.len == args2.len:
                            var ignored2 as int is calling add_method_spec with c, fi2, ti, args2
                    banish bn2
                    set fi2 is fi2 + 1
        banish args2
        set ti is ti + 1
## Especializa todas las llamadas genéricas del catálogo.
##
## ## Memoria
## Añade funciones al catálogo.
weave specialize_all with c as ref to context.CgContext into void:
    var i as int is 0
    while i < c->catalog.functions.len:
        var f as catalog.CgFunction is (c->catalog.functions at i)
        if not f.is_declare:
            var m as loader.SemaModule is (c->program->modules at f.module)
            calling scan with c, m, f.node
        set i is i + 1

## Sustituye los parámetros de tipo del contexto actual.
##
## ## Memoria
## O(tipo).
weave subst_codegen with c as ref to context.CgContext, id as int into int:
    if id <= 0 or c->names.subst.len == 0:
        return id
    return calling ginst.subst_deep with (sigil of c->program->symbols), id, c->names.subst

## Sustituye `id` con la tabla `tparams -> spec_args` de una especialización.
##
## Sirve para tipar los argumentos de una llamada a `f<T>` aunque el cuerpo que
## se está emitiendo no sea el de la especialización.
##
## ## Memoria
## Puede crear tipos internados; el mapa temporal se libera.
weave subst_spec_type_of with c as ref to context.CgContext, f as catalog.CgFunction, id as int into int:
    if id <= 0 or f.spec_args.len == 0 or f.tparams.len == 0:
        return id
    var m as map of int to int is map of int to int
    defer banish m
    var i as int is 0
    while i < f.tparams.len and i < f.spec_args.len:
        calling m.put with (f.tparams at i), (f.spec_args at i)
        set i is i + 1
    return calling ginst.subst_deep with (sigil of c->program->symbols), id, m
