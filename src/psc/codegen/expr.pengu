## psc/codegen/expr.pengu — expresiones C (núcleo inicial).
##
## La primera entrega cubre literales, variables locales, aritmética, unarios,
## comparaciones y llamadas directas. Las subfases posteriores añaden el resto
## sin cambiar la interfaz `emit_expr`.

import std.builder
import std.scrolls
import std.spark

import psc.ast.kind as pskind
import psc.ast.node as psast
import psc.lexer_decode as psdecode
import psc.lexer_state as psstate
import psc.source as psource
import psc.sema.ast as astutil
import psc.sema.modules.loader as loader
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.types.compat as compat
import psc.sema.types.canonical as canon
import psc.sema.types.embeds as embeds
import psc.sema.symbols.symbol as sym
import psc.sema.symbols.table as symbols
import psc.sema.annotate as ann
import psc.sema.names as npool

import psc.codegen.context as context
import psc.codegen.ctype as ctype
import psc.codegen.names as names
import psc.codegen.emit as emit
import psc.codegen.origin as origin
import psc.parse.state as pstate
import psc.sema.modules.program as program
import psc.codegen.catalog as catalog
import psc.codegen.type_ast as tast
import psc.codegen.generics as generics
import psc.codegen.drop as drop

insignia psc_codegen_expr_

## Tipo anotado de un nodo.
##
## ## Memoria
## O(1).
weave node_type with c as ref to context.CgContext, node as int into int:
    if c->current_module < 0 or node < 0:
        return -1
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var t as int is calling ann.type_of with (sigil of m.annotations), node
    if c->names.subst.len > 0:
        return calling generics.subst_codegen with c, t
    return t

## Emite una expresión como string C owned.
##
## ## Memoria
## Devuelve un string owned; el llamador lo libera con `banish`.
weave emit_expr with c as ref to context.CgContext, node as int into string:
    if node < 0:
        return "0"
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    if (calling astutil.kind_of with (sigil of m.parse.ast), node) == pskind.NodeKind.NdWithTarget:
        # `.campo` en expresión: el receptor es el `with` activo. El sema ya
        # comprobó que existe un `with` y que el campo pertenece al tipo.
        var wtarget as CgTarget is calling resolve_with_target with c, node, (sigil of m.parse.ast), false
        return wtarget.text
    var ast as ref to psast.PsAst is (sigil of m.parse.ast)
    var k as pskind.NodeKind is calling astutil.kind_of with ast, node
    if k == pskind.NodeKind.NdIntLit or k == pskind.NodeKind.NdFloatLit or k == pskind.NodeKind.NdCharLit:
        return calling astutil.child_token_text with (sigil of m.source), (sigil of m.lex), ast, node, 0
    if k == pskind.NodeKind.NdTrueLit:
        return "true"
    if k == pskind.NodeKind.NdFalseLit:
        return "false"
    if k == pskind.NodeKind.NdNullLit:
        return "NULL"
    if k == pskind.NodeKind.NdRangeDotdot:
        # `a .. b` es un rango semiabierto [a, b), igual que `from a to b`.
        var rlo as int is calling astutil.node_child with (sigil of m.parse.ast), node, 0
        var rhi as int is calling astutil.node_child with (sigil of m.parse.ast), node, 2
        if rhi < 0:
            set rhi is calling astutil.node_child with (sigil of m.parse.ast), node, 1
        var rlo_c as string is calling emit_expr with c, rlo
        defer banish rlo_c
        var rhi_c as string is calling emit_expr with c, rhi
        defer banish rhi_c
        return "pengu_range_new((int64_t)({rlo_c}), (int64_t)({rhi_c}))"
    if k == pskind.NodeKind.NdMaybeNone:
        return "pengu_maybe_none()"
    if k == pskind.NodeKind.NdErrorLit:
        # `infer_or` declara este local en la rama de fallo de `or:`.
        return "error"
    if k == pskind.NodeKind.NdStringLit:
        var raw as string is calling astutil.child_token_text with (sigil of m.source), (sigil of m.lex), ast, node, 0
        defer banish raw
        var lt as int is calling node_type with c, node
        if lt > 0 and (calling compat.is_cstr with (sigil of c->program->types), lt):
            return calling c_string_expr with c, node, raw, true
        return calling c_string_expr with c, node, raw, false
    if k == pskind.NodeKind.NdVarRef or k == pskind.NodeKind.NdSelfRef:
        var txt as string is calling astutil.first_token_text with (sigil of m.source), (sigil of m.lex), ast, node
        defer banish txt
        if k == pskind.NodeKind.NdSelfRef:
            return "self"
        var nid as int is calling npool.intern with (sigil of c->program->names), txt
        var lc as int is calling context.local_c_name with c, nid
        if lc >= 0:
            return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), lc)
        var sid as int is calling symbols.lookup_in_scope with (sigil of c->program->symbols), m.scope, nid
        if sid < 0:
            set sid is calling symbols.lookup_name with (sigil of c->program->symbols), txt
        if sid >= 0:
            var sv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), sid
            if sv.kind == sym.SemaSymbolKind.SkConst and sv.type >= 0:
                var st0 as tk.SemaType is calling types.at with (sigil of c->program->types), sv.type
                if st0.kind == tk.SemaTypeKind.TkOmen:
                    var on as string is calling ctype.c_type with (sigil of c->names), sv.type
                    defer banish on
                    var vn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), sv.name)
                    defer banish vn
                    if calling omen_has_layout with c, sv.type:
                        var osb as StringBuilder is calling StringBuilder.new
                        defer banish osb
                        calling osb.append with "("
                        calling osb.append with on
                        calling osb.append with "){.tag = "
                        calling osb.append with on
                        calling osb.append with "_"
                        calling osb.append with vn
                        calling osb.append with "}"
                        return calling osb.finish
                    return "{on}_{vn}"
            if sv.kind == sym.SemaSymbolKind.SkConst:
                var kci as int is 0
                while kci < c->catalog.consts.len:
                    var kcc as catalog.CgConst is (c->catalog.consts at kci)
                    if kcc.module == sv.module and kcc.name == sv.name:
                        return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), kcc.c_name)
                    set kci is kci + 1
                var kci2 as int is 0
                while kci2 < c->catalog.consts.len:
                    var kcc2 as catalog.CgConst is (c->catalog.consts at kci2)
                    if kcc2.name == sv.name:
                        return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), kcc2.c_name)
                    set kci2 is kci2 + 1
            var fcat as int is -1
            if calling c->catalog.by_symbol.has with sid:
                set fcat is calling c->catalog.by_symbol.get with sid
            if fcat >= 0:
                var cf as catalog.CgFunction is (c->catalog.functions at fcat)
                return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), cf.c_name)
            return calling names.function_name with (sigil of c->names), sv
        return calling npool.copy_string with txt
    if k == pskind.NodeKind.NdParenExpr:
        var inner as string is calling emit_expr with c, (calling astutil.node_child with ast, node, 0)
        defer banish inner
        return "({inner})"
    if k == pskind.NodeKind.NdNeg:
        var v as string is calling emit_expr with c, (calling astutil.node_child with ast, node, 0)
        defer banish v
        return "(-{v})"
    if k == pskind.NodeKind.NdLogNot:
        var v2 as string is calling emit_expr with c, (calling astutil.node_child with ast, node, 0)
        defer banish v2
        return "(!{v2})"
    if k == pskind.NodeKind.NdBitNot:
        var v3 as string is calling emit_expr with c, (calling astutil.node_child with ast, node, 0)
        defer banish v3
        return "(~{v3})"
    if k == pskind.NodeKind.NdAdd or k == pskind.NodeKind.NdSub or k == pskind.NodeKind.NdMul or k == pskind.NodeKind.NdDiv or k == pskind.NodeKind.NdMod or k == pskind.NodeKind.NdBitwiseAnd or k == pskind.NodeKind.NdBitwiseOr or k == pskind.NodeKind.NdBitwiseXor or k == pskind.NodeKind.NdShl or k == pskind.NodeKind.NdShr:
        return calling binary_expr with c, node, ast
    if k == pskind.NodeKind.NdEq or k == pskind.NodeKind.NdNe or k == pskind.NodeKind.NdLt or k == pskind.NodeKind.NdLe or k == pskind.NodeKind.NdGt or k == pskind.NodeKind.NdGe:
        return calling binary_expr with c, node, ast
    if k == pskind.NodeKind.NdBoolAnd or k == pskind.NodeKind.NdBoolOr:
        return calling binary_expr with c, node, ast
    if k == pskind.NodeKind.NdCallingExpr:
        return calling call_expr with c, node, ast
    if k == pskind.NodeKind.NdGenericRef:
        return calling generic_ref with c, node, ast
    if k == pskind.NodeKind.NdChainExpr:
        return calling chain_expr with c, node, ast
    if k == pskind.NodeKind.NdEssenceOf:
        var eo as int is calling astutil.node_child with ast, node, 0
        var eov as string is calling emit_expr with c, eo
        defer banish eov
        if c->self_value:
            return eov
        return "(*( {eov}))"
    if k == pskind.NodeKind.NdBytesExpr:
        var bb as int is calling astutil.node_child with ast, node, 0
        var bv as string is calling emit_expr with c, bb
        defer banish bv
        return "((const uint8_t*)(({bv}).data))"
    if k == pskind.NodeKind.NdSigilOf:
        var sb2 as int is calling astutil.node_child with ast, node, 0
        var special as string is calling sigil_at_expr with c, sb2, ast
        if special != "":
            return special
        var sv2 as string is calling emit_expr with c, sb2
        defer banish sv2
        return "(&({sv2}))"
    if k == pskind.NodeKind.NdIfExpr:
        var ic as int is calling astutil.node_child with ast, node, 0
        var it as int is calling astutil.node_child with ast, node, 1
        var ie as int is calling astutil.node_child with ast, node, 2
        var ity as int is calling node_type with c, node
        if ity <= 0:
            set ity is calling node_type with c, it
        if ity <= 0:
            set ity is calling types.base with (sigil of c->program->types), "int"
        var ict as string is calling ctype.c_type with (sigil of c->names), ity
        defer banish ict
        var icv as string is calling emit_expr with c, ic
        defer banish icv
        var itv as string is calling emit_expr_as with c, it, ity
        defer banish itv
        var iev as string is ""
        if ie >= 0:
            set iev is calling emit_expr_as with c, ie, ity
        defer banish iev
        var isb as StringBuilder is calling StringBuilder.new
        defer banish isb
        calling isb.append with "__extension__(({ "
        calling isb.append with ict
        var ifcond as string is "if ({icv})"
        if calling emit.wrapped_parens with icv:
            set ifcond is "if {icv}"
        calling isb.append with " _pif; {ifcond} { _pif = "
        calling isb.append with itv
        calling isb.append with "; } else { _pif = "
        calling isb.append with iev
        calling isb.append with "; } _pif; }))"
        return calling isb.finish
    if k == pskind.NodeKind.NdToExpr:
        var tv as int is calling astutil.node_child with ast, node, 0
        var tvx as string is calling emit_expr with c, tv
        var tnode as int is calling astutil.node_child with ast, node, 1
        var tct as string is ""
        if tnode >= 0 and (calling astutil.kind_of with ast, tnode) == pskind.NodeKind.NdVarRef:
            var ttok as int is calling astutil.token_child with ast, tnode, 0
            if ttok >= 0:
                var ttxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ttok
                var tnid as int is calling npool.intern with (sigil of c->program->names), ttxt
                banish ttxt
                set tct is calling ctype.base_c_type with (sigil of c->names), tnid
        else:
            var tt2 as int is calling tast.from_ast with c, m, tnode
            if tt2 >= 0:
                set tct is calling ctype.c_type with (sigil of c->names), tt2
        if tct == "":
            return tvx
        if tct == "PenguString":
            var stv as int is calling node_type with c, tv
            if stv > 0:
                var stt as tk.SemaType is calling types.at with (sigil of c->program->types), stv
                if stt.kind == tk.SemaTypeKind.TkBase:
                    var stn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), stt.name)
                    if stn == "string":
                        return tvx
                    if stn == "float" or stn == "f32":
                        return "pengu_string_from_float32({tvx})"
                    if stn == "f64" or stn == "double":
                        return "pengu_string_from_float({tvx})"
                    if stn == "bool":
                        return "pengu_string_from_bool({tvx})"
            return "pengu_string_from_int((int64_t)({tvx}))"
        return "(({tct})({tvx}))"
    if k == pskind.NodeKind.NdTransmute:
        var tmv as int is calling astutil.node_child with ast, node, 0
        var tmvn as string is calling emit_expr with c, tmv
        defer banish tmvn
        var tmty as int is calling node_type with c, node
        if tmty <= 0:
            var tmtn as int is calling astutil.node_child with ast, node, 1
            set tmty is calling tast.type_from_ast_subst with c, m, tmtn
        if tmty <= 0:
            return tmvn
        var tmct as string is calling ctype.c_type with (sigil of c->names), tmty
        defer banish tmct
        # `transmute` reinterpreta bits (no convierte): temp + memcpy del tamaño
        # menor, para no leer fuera del origen cuando los tamaños difieren.
        var tmst as int is calling node_type with c, tmv
        var tmsc as string is ""
        if tmst > 0:
            set tmsc is calling ctype.c_type with (sigil of c->names), tmst
        defer banish tmsc
        if tmsc == "" or tmsc == tmct:
            return "(({tmct})({tmvn}))"
        var tsb as StringBuilder is calling StringBuilder.new
        defer banish tsb
        var tmdecl as string is calling ctype.declare with tmsc, "_tm"
        defer banish tmdecl
        var tddecl as string is calling ctype.declare with tmct, "_td"
        defer banish tddecl
        calling tsb.append with "__extension__(({ "
        calling tsb.append with tmdecl
        calling tsb.append with " = "
        calling tsb.append with tmvn
        calling tsb.append with "; "
        calling tsb.append with tddecl
        calling tsb.append with "; pengu_transmute_copy(&_td, &_tm, sizeof(_td), sizeof(_tm)); _td; }))"
        return calling tsb.finish
    if k == pskind.NodeKind.NdSizeOf:
        var stn as int is calling astutil.node_child with ast, node, 0
        var sty as int is calling tast.type_from_ast_subst with c, m, stn
        if sty >= 0:
            var sct as string is calling ctype.c_type with (sigil of c->names), sty
            defer banish sct
            return "((size_t)sizeof({sct}))"
        return "((size_t)sizeof(void*))"
    if k == pskind.NodeKind.NdAlignOf:
        var atn as int is calling astutil.node_child with ast, node, 0
        var aty as int is calling tast.type_from_ast_subst with c, m, atn
        if aty >= 0:
            var act as string is calling ctype.c_type with (sigil of c->names), aty
            defer banish act
            return "((size_t)PENGU_ALIGNOF({act}))"
        return "((size_t)PENGU_ALIGNOF(void*))"
    if k == pskind.NodeKind.NdSliceAtExpr:
        var sb0 as int is calling astutil.node_child with ast, node, 0
        var rg as int is calling astutil.node_child with ast, node, 1
        var bs0 as string is calling emit_expr with c, sb0
        defer banish bs0
        if rg >= 0:
            var lo0 as int is calling astutil.node_child with ast, rg, 0
            var hi0 as int is calling astutil.node_child with ast, rg, 1
            var lot as string is calling emit_expr with c, lo0
            defer banish lot
            var hit as string is calling emit_expr with c, hi0
            defer banish hit
            var bt0x as int is calling node_type with c, sb0
            if bt0x >= 0:
                var btx as tk.SemaType is calling types.at with (sigil of c->program->types), bt0x
                if btx.kind == tk.SemaTypeKind.TkArray:
                    var asb0 as StringBuilder is calling StringBuilder.new
                    defer banish asb0
                    if c->options.family == "cpp":
                        # C++ exige los designadores en orden de declaracion:
                        # PenguSlice es { data, len, elem_size }.
                        calling asb0.append with "PenguSlice{.data = (void*)(&("
                        calling asb0.append with bs0
                        calling asb0.append with ")[0]), .len = (int)(("
                        calling asb0.append with hit
                        calling asb0.append with ") - ("
                        calling asb0.append with lot
                        calling asb0.append with ")), .elem_size = sizeof("
                        calling asb0.append with bs0
                        calling asb0.append with "[0])}"
                        return calling asb0.finish
                    calling asb0.append with "(PenguSlice){.data = (void*)(&("
                    calling asb0.append with bs0
                    calling asb0.append with ")[0]), .elem_size = sizeof("
                    calling asb0.append with bs0
                    calling asb0.append with "[0]), .len = (int)(("
                    calling asb0.append with hit
                    calling asb0.append with ") - ("
                    calling asb0.append with lot
                    calling asb0.append with "))}"
                    return calling asb0.finish
                if btx.kind == tk.SemaTypeKind.TkSlice:
                    return "pengu_slice_sub(&({bs0}), (int)({lot}), (int)({hit}))"
                if btx.kind == tk.SemaTypeKind.TkList:
                    var let0 as string is calling ctype.c_type with (sigil of c->names), btx.a
                    var lret as string is "pengu_slice_new(pengu_list_at(&({bs0}), (int)({lot})), sizeof({let0}), (int)(({hit}) - ({lot})))"
                    banish let0
                    return lret
            return "pengu_string_substring({bs0}, (int)({lot}), (int)({hit}))"
        return bs0
    if k == pskind.NodeKind.NdLambdaExpr or k == pskind.NodeKind.NdLambdaNoParams:
        return "_pengu_lambda_{c->current_module}_{node}"
    if k == pskind.NodeKind.NdIsPresent or k == pskind.NodeKind.NdIsNotPresent:
        var ip as int is calling astutil.node_child with ast, node, 0
        var ipv as string is calling emit_expr with c, ip
        defer banish ipv
        var ipty as int is calling node_type with c, ip
        var ipfield as string is "is_present"
        if ipty >= 0:
            var ipt as tk.SemaType is calling types.at with (sigil of c->program->types), ipty
            if ipt.kind == tk.SemaTypeKind.TkResult:
                set ipfield is "is_ok"
        if k == pskind.NodeKind.NdIsNotPresent:
            return "(!({ipv}).{ipfield})"
        return "(({ipv}).{ipfield})"
    if k == pskind.NodeKind.NdIsTrue or k == pskind.NodeKind.NdIsFalse:
        var it as int is calling astutil.node_child with ast, node, 0
        var itv as string is calling emit_expr with c, it
        defer banish itv
        if k == pskind.NodeKind.NdIsFalse:
            return "(!({itv}))"
        return "({itv})"
    if k == pskind.NodeKind.NdChrExpr:
        var cv as int is calling astutil.node_child with ast, node, 0
        var cvv as string is calling emit_expr with c, cv
        defer banish cvv
        return "pengu_string_from_char((char)({cvv}))"
    if k == pskind.NodeKind.NdOrdExpr:
        var ov as int is calling astutil.node_child with ast, node, 0
        var ovv as string is calling emit_expr with c, ov
        defer banish ovv
        var ot as int is calling node_type with c, ov
        if ot >= 0:
            var oty as tk.SemaType is calling types.at with (sigil of c->program->types), ot
            if oty.kind == tk.SemaTypeKind.TkBase:
                var obn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), oty.name)
                if obn != "string":
                    banish obn
                    return "((int32_t)({ovv}))"
                banish obn
        return "((int32_t)(({ovv}).data ? (unsigned char)({ovv}).data[0] : 0))"
    if k == pskind.NodeKind.NdOrElse:
        var ol as int is calling astutil.node_child with ast, node, 0
        var orr as int is calling astutil.node_child with ast, node, 1
        var olt as int is calling node_type with c, ol
        if olt < 0 and ol >= 0 and (calling astutil.kind_of with ast, ol) == pskind.NodeKind.NdVarRef:
            var otok as int is calling astutil.token_child with ast, ol, 0
            if otok >= 0:
                var otxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), otok
                var onid as int is calling npool.intern with (sigil of c->program->names), otxt
                banish otxt
                set olt is calling context.local_type with c, onid
        var olv as string is calling emit_expr with c, ol
        defer banish olv
        var orv as string is calling emit_expr_as with c, orr, olt
        defer banish orv
        if olt >= 0:
            var ott as tk.SemaType is calling types.at with (sigil of c->program->types), olt
            if ott.kind == tk.SemaTypeKind.TkMaybe or ott.kind == tk.SemaTypeKind.TkResult:
                var payx as int is ott.a
                var pctx as string is calling ctype.c_type with (sigil of c->names), payx
                var tmp as string is calling emit.temp with (sigil of c->emitter), "_or"
                var osb as StringBuilder is calling StringBuilder.new
                defer banish osb
                calling osb.append with "__extension__(({ "
                calling osb.append with (calling ctype.c_type with (sigil of c->names), olt)
                calling osb.append with " "
                calling osb.append with tmp
                calling osb.append with " = "
                calling osb.append with olv
                calling osb.append with "; "
                if ott.kind == tk.SemaTypeKind.TkMaybe:
                    calling osb.append with "{tmp}.is_present ? (*( "
                else:
                    calling osb.append with "{tmp}.is_ok ? (*( "
                calling osb.append with pctx
                calling osb.append with "*)"
                if ott.kind == tk.SemaTypeKind.TkMaybe:
                    calling osb.append with "{tmp}.value) : ("
                else:
                    calling osb.append with "{tmp}.ok_val) : ("
                calling osb.append with orv
                calling osb.append with "); }))"
                banish pctx
                return calling osb.finish
        return "({olv} ? {olv} : {orv})"
    if k == pskind.NodeKind.NdDoExpr:
        # Un bloque en posición de valor captura sus sentencias en una
        # statement expression (`__extension__(({ … }))`, bug 9). El emisor
        # vive en `stmt` para no crear el ciclo expr→stmt.
        var hook as weave with hc as ref to context.CgContext, hnode as int, hexp as int into string is c->block_value
        return calling hook with c, node, 0
    if k == pskind.NodeKind.NdJudgeExpr:
        return calling judge_expr_c with c, node, ast, -1
    if k == pskind.NodeKind.NdAtExpr:
        return calling at_expr with c, node, ast
    if k == pskind.NodeKind.NdLengthExpr:
        var lb as int is calling astutil.node_child with ast, node, 0
        var lv as string is calling emit_expr with c, lb
        defer banish lv
        # `err length` donde `err` es `ref to string` debe bajar a
        # `(*err).len`, no a `err.len`. Sin este deref, el C generado no
        # compila (bug detectado en std.rites.run_capture).
        var lt as int is calling node_type with c, lb
        if lt < 0:
            set lt is calling guess_type with c, lb, ast
        if lt > 0:
            var lty as tk.SemaType is calling types.at with (sigil of c->program->types), lt
            if lty.kind == tk.SemaTypeKind.TkRef:
                return "((int32_t)(*({lv})).len)"
        return "((int32_t)({lv}).len)"
    if k == pskind.NodeKind.NdFieldAccess:
        return calling field_access_expr with c, node, ast, false
    if k == pskind.NodeKind.NdArrowAccess:
        return calling field_access_expr with c, node, ast, true
    if k == pskind.NodeKind.NdArrayLit:
        return calling array_lit_expr with c, node, ast, calling node_type with c, node
    if k == pskind.NodeKind.NdForComp:
        return calling for_comp_expr with c, node, ast
    if k == pskind.NodeKind.NdDonumExpr:
        var dt as int is calling node_type with c, node
        if dt <= 0:
            var dtn as int is calling astutil.node_child with ast, node, 0
            if dtn >= 0:
                set dt is calling tast.from_ast with c, m, dtn
        if dt <= 0:
            return "0"
        return calling zero_value_expr with c, dt
    if k == pskind.NodeKind.NdTypeOf:
        var ton as int is calling astutil.node_child with ast, node, 0
        var toy as int is calling node_type with c, ton
        if toy <= 0:
            set toy is calling guess_type with c, ton, ast
        if toy <= 0:
            return "pengu_string_from_cstr(\"any\")"
        var tnid as int is calling canon.canonical_name with (sigil of c->program->types), toy
        var ttxt as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), tnid)
        defer banish ttxt
        var tesc as string is calling emit.escape_c with ttxt
        defer banish tesc
        return "pengu_string_from_cstr(\"{tesc}\")"
    if k == pskind.NodeKind.NdInExpr or k == pskind.NodeKind.NdNotInExpr:
        return calling in_expr with c, node, ast, k == pskind.NodeKind.NdNotInExpr
    if k == pskind.NodeKind.NdOrReturn:
        return calling unwrap_expr with c, node, ast, true
    if k == pskind.NodeKind.NdTryExpr:
        return calling unwrap_expr with c, node, ast, false
    if k == pskind.NodeKind.NdListInitExpr:
        return calling list_init_expr with c, node, ast, -1
    if k == pskind.NodeKind.NdStructInit:
        return calling struct_init_expr with c, node, ast, calling node_type with c, node
    if k == pskind.NodeKind.NdSomeExpr:
        return calling some_expr_c with c, node, ast, -1
    return "0"

## Tipo aproximado de una expresión cuando F3 no lo anotó.
##
## Para acceso a campo/local resuelve por la tabla nominal; `-1` si no sabe.
##
## ## Memoria
## O(profundidad); sin asignaciones.
weave guess_type with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into int:
    if node < 0:
        return -1
    var t as int is calling node_type with c, node
    if t >= 0:
        return t
    var k as pskind.NodeKind is calling astutil.kind_of with ast, node
    if k == pskind.NodeKind.NdVarRef:
        var m as loader.SemaModule is (c->program->modules at c->current_module)
        var tok as int is calling astutil.token_child with ast, node, 0
        if tok >= 0:
            var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), tok
            var nid as int is calling npool.intern with (sigil of c->program->names), txt
            banish txt
            return calling context.local_type with c, nid
    if k == pskind.NodeKind.NdParenExpr:
        return calling guess_type with c, (calling astutil.node_child with ast, node, 0), ast
    if k == pskind.NodeKind.NdFieldAccess or k == pskind.NodeKind.NdArrowAccess:
        var base as int is calling astutil.node_child with ast, node, 0
        var ft as int is calling astutil.token_child with ast, node, 1
        if base >= 0 and ft >= 0:
            var bt as int is calling guess_type with c, base, ast
            if bt >= 0:
                var m2 as loader.SemaModule is (c->program->modules at c->current_module)
                var fn as string is calling astutil.token_text with (sigil of m2.source), (sigil of m2.lex), ft
                var fnid as int is calling npool.intern with (sigil of c->program->names), fn
                banish fn
                return calling cg_field_type with c, bt, fnid
    if k == pskind.NodeKind.NdAtExpr:
        return calling infer_at_type with c, node, ast
    return -1

## Emite una expresión con un tipo esperado (para struct init sin anotación).
##
## ## Memoria
## Devuelve string owned.
## Emite `or return` y `try` sobre `maybe`/`result`.
##
## ## Memoria
## Devuelve un string owned.
weave unwrap_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, is_or_return as bool into string:
    var operand as int is calling astutil.node_child with ast, node, 0
    if operand < 0:
        return "0"
    var ot as int is calling node_type with c, operand
    if ot <= 0:
        return calling emit_expr with c, operand
    var ott as tk.SemaType is calling types.at with (sigil of c->program->types), ot
    if ott.kind != tk.SemaTypeKind.TkMaybe and ott.kind != tk.SemaTypeKind.TkResult:
        return calling emit_expr with c, operand
    var payload as int is ott.a
    var pt as string is calling ctype.c_type with (sigil of c->names), payload
    defer banish pt
    var tmp as string is calling emit.temp with (sigil of c->emitter), "_u"
    defer banish tmp
    var ov as string is calling emit_expr with c, operand
    defer banish ov
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "__extension__(({ Pengu"
    if ott.kind == tk.SemaTypeKind.TkMaybe:
        calling sb.append with "Maybe "
    else:
        calling sb.append with "Result "
    calling sb.append with tmp
    calling sb.append with " = "
    calling sb.append with ov
    calling sb.append with "; "
    if ott.kind == tk.SemaTypeKind.TkMaybe:
        calling sb.append with "if (!"
        calling sb.append with tmp
        calling sb.append with ".is_present) { "
    else:
        calling sb.append with "if (!"
        calling sb.append with tmp
        calling sb.append with ".is_ok) { "
    if is_or_return:
        var fallback as int is calling astutil.node_child with ast, node, 1
        var fb as string is ""
        if fallback >= 0:
            set fb is calling emit_expr with c, fallback
        defer banish fb
        if fb == "":
            set fb is "0"
        calling sb.append with "return "
        calling sb.append with fb
        calling sb.append with "; "
    else:
        if ott.kind == tk.SemaTypeKind.TkMaybe:
            calling sb.append with "return pengu_maybe_none(); "
        else:
            calling sb.append with "return "
            calling sb.append with tmp
            calling sb.append with "; "
    calling sb.append with "} (*( "
    calling sb.append with pt
    calling sb.append with "*)"
    if ott.kind == tk.SemaTypeKind.TkMaybe:
        calling sb.append with tmp
        calling sb.append with ".value); }))"
    else:
        calling sb.append with tmp
        calling sb.append with ".ok_val); }))"
    return calling sb.finish

## Emite el valor cero de un tipo (`donum T`).
##
## ## Memoria
## Devuelve un string owned.
weave zero_value_expr with c as ref to context.CgContext, ty as int into string:
    if ty <= 0:
        return "0"
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkOpaque or t.kind == tk.SemaTypeKind.TkFn:
        return "NULL"
    if t.kind == tk.SemaTypeKind.TkBase:
        var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), t.name)
        defer banish bn
        if bn == "string":
            return "pengu_string_from_cstr(\"\")"
        if bn == "bool":
            return "false"
        if bn == "float" or bn == "f32" or bn == "f64" or bn == "double":
            return "0.0"
        return "0"
    if t.kind == tk.SemaTypeKind.TkMaybe:
        return "pengu_maybe_none()"
    var ct as string is calling ctype.c_type with (sigil of c->names), ty
    defer banish ct
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "("
    calling sb.append with ct
    calling sb.append with r"){0}"
    return calling sb.finish

## Emite `valor in coleccion` / `valor not in coleccion`.
##
## ## Memoria
## Devuelve un string owned.
weave in_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, negated as bool into string:
    var valn as int is calling astutil.node_child with ast, node, 0
    var coln as int is calling astutil.node_child with ast, node, 1
    if valn < 0 or coln < 0:
        return "false"
    var val_c as string is calling emit_expr with c, valn
    defer banish val_c
    var col_c as string is calling emit_expr with c, coln
    defer banish col_c
    var val_ty as int is calling node_type with c, valn
    if val_ty <= 0:
        set val_ty is calling guess_type with c, valn, ast
    var col_ty as int is calling node_type with c, coln
    if col_ty <= 0:
        set col_ty is calling guess_type with c, coln, ast
    if (calling astutil.kind_of with ast, coln) == pskind.NodeKind.NdToExpr or (calling astutil.kind_of with ast, coln) == pskind.NodeKind.NdRangeDotdot:
        var lo as int is calling astutil.node_child with ast, coln, 0
        var hi as int is calling astutil.node_child with ast, coln, 1
        if (calling astutil.kind_of with ast, coln) == pskind.NodeKind.NdRangeDotdot:
            var hi2 as int is calling astutil.node_child with ast, coln, 2
            if hi2 >= 0:
                set hi is hi2
        var lo_c as string is calling emit_expr with c, lo
        var hi_c as string is calling emit_expr with c, hi
        defer banish lo_c
        defer banish hi_c
        var inner as string is "(({val_c}) >= ({lo_c}) && ({val_c}) < ({hi_c}))"
        if negated:
            return "!({inner})"
        return inner
    if col_ty <= 0:
        return "false"
    var ct as tk.SemaType is calling types.at with (sigil of c->program->types), col_ty
    var is_ref as bool is ct.kind == tk.SemaTypeKind.TkRef
    var actual as tk.SemaType is ct
    if is_ref and ct.a > 0:
        set actual is calling types.at with (sigil of c->program->types), ct.a
    var amp as string is "&"
    if is_ref:
        set amp is ""
    var inner as string is "false"
    if actual.kind == tk.SemaTypeKind.TkMap:
        var kt as string is calling ctype.c_type with (sigil of c->names), actual.a
        defer banish kt
        var sb as StringBuilder is calling StringBuilder.new
        defer banish sb
        var ktmp as string is calling emit.temp with (sigil of c->emitter), "_k"
        defer banish ktmp
        calling sb.append with "__extension__(({ "
        calling sb.append with kt
        calling sb.append with " "
        calling sb.append with ktmp
        calling sb.append with " = "
        calling sb.append with val_c
        calling sb.append with "; pengu_map_contains("
        calling sb.append with amp
        calling sb.append with "("
        calling sb.append with col_c
        calling sb.append with "), &"
        calling sb.append with ktmp
        calling sb.append with "); }))"
        set inner is calling sb.finish
    else if actual.kind == tk.SemaTypeKind.TkList:
        var el as string is calling ctype.c_type with (sigil of c->names), actual.a
        defer banish el
        var sb2 as StringBuilder is calling StringBuilder.new
        defer banish sb2
        var etmp as string is calling emit.temp with (sigil of c->emitter), "_e"
        defer banish etmp
        calling sb2.append with "__extension__(({ "
        calling sb2.append with el
        calling sb2.append with " "
        calling sb2.append with etmp
        calling sb2.append with " = "
        calling sb2.append with val_c
        calling sb2.append with "; pengu_list_contains("
        calling sb2.append with amp
        calling sb2.append with "("
        calling sb2.append with col_c
        calling sb2.append with "), &"
        calling sb2.append with etmp
        calling sb2.append with "); }))"
        set inner is calling sb2.finish
    else if actual.kind == tk.SemaTypeKind.TkBase:
        var bn as string is calling npool.text with (sigil of c->program->names), actual.name
        if bn == "string":
            var vst as tk.SemaType is calling types.at with (sigil of c->program->types), val_ty
            if vst.kind == tk.SemaTypeKind.TkBase and (calling npool.text with (sigil of c->program->names), vst.name) == "string":
                set inner is "(pengu__find_sub({col_c}, {val_c}, 0) >= 0)"
            else:
                set inner is "(memchr(({col_c}).data, (int)({val_c}), (size_t)({col_c}).len) != NULL)"
    if inner == "false" and (actual.kind == tk.SemaTypeKind.TkArray or actual.kind == tk.SemaTypeKind.TkSlice or actual.kind == tk.SemaTypeKind.TkMany):
        var el2 as string is calling ctype.c_type with (sigil of c->names), actual.a
        defer banish el2
        var sb3 as StringBuilder is calling StringBuilder.new
        defer banish sb3
        var vtmp2 as string is calling emit.temp with (sigil of c->emitter), "_v"
        var itmp2 as string is calling emit.temp with (sigil of c->emitter), "_i"
        var ftmp2 as string is calling emit.temp with (sigil of c->emitter), "_found"
        defer banish vtmp2
        defer banish itmp2
        defer banish ftmp2
        var len2 as string is "0"
        var sep2 as string is "."
        if is_ref:
            set sep2 is "->"
        if actual.kind == tk.SemaTypeKind.TkArray:
            set len2 is "{actual.b}"
        else:
            set len2 is "({col_c}){sep2}len"
        calling sb3.append with "__extension__(({ "
        calling sb3.append with el2
        calling sb3.append with " "
        calling sb3.append with vtmp2
        calling sb3.append with " = "
        calling sb3.append with val_c
        calling sb3.append with "; bool "
        calling sb3.append with ftmp2
        calling sb3.append with " = false; for (int "
        calling sb3.append with itmp2
        calling sb3.append with " = 0; "
        calling sb3.append with itmp2
        calling sb3.append with " < "
        calling sb3.append with len2
        calling sb3.append with "; "
        calling sb3.append with itmp2
        calling sb3.append with "++) { if (memcmp(&({col_c})["
        calling sb3.append with itmp2
        calling sb3.append with "], &"
        calling sb3.append with vtmp2
        calling sb3.append with ", sizeof("
        calling sb3.append with el2
        calling sb3.append with ")) == 0) { "
        calling sb3.append with ftmp2
        calling sb3.append with " = true; break; } } "
        calling sb3.append with ftmp2
        calling sb3.append with "; }))"
        set inner is calling sb3.finish
    if negated:
        var nres as string is "!({inner})"
        banish inner
        return nres
    return inner

## Devuelve el token que nombra la variante `idx` de un patrón `when`.
##
## `when Color.Red` guarda el nombre cualificado en un nodo `when_variant`, así
## que sus tokens no cuelgan del patrón sino del hijo; `when A | B` los cuelga
## del patrón separados por `|`. Esta rutina aplana ambos casos.
##
## ## Memoria
## Solo lee el AST; no reserva y devuelve un índice de token (-1 si no hay).
weave pattern_variant_token with m as loader.SemaModule, ast as ref to psast.PsAst, pat as int, idx as int into int:
    var seen as int is 0
    var i as int is 0
    var n as int is calling astutil.child_count with ast, pat
    while i < n:
        var cand as int is -1
        var t as int is calling astutil.token_child with ast, pat, i
        if t >= 0:
            var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), t
            if txt != "|":
                set cand is t
            banish txt
        else:
            var ch as int is calling astutil.node_child with ast, pat, i
            if ch >= 0:
                set cand is calling last_token_deep with ast, ch
        if cand >= 0:
            if seen == idx:
                return cand
            set seen is seen + 1
        set i is i + 1
    return -1
## Condición C que casa un patrón de `judge` contra el temporal del sujeto.
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave judge_cond_c with c as ref to context.CgContext, st as int, pat as int, ast as ref to psast.PsAst, stmp as string into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var stt as tk.SemaType is calling types.at with (sigil of c->program->types), st
    var layout as bool is stt.kind == tk.SemaTypeKind.TkOmen and (calling expr.omen_has_layout with c, st)
    var is_str as bool is false
    if stt.kind == tk.SemaTypeKind.TkBase:
        var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), stt.name)
        if bn == "string":
            set is_str is true
        banish bn
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var pn as int is pat
    if (calling astutil.kind_of with ast, pat) == pskind.NodeKind.NdWhenPattern:
        var pchild as int is calling astutil.node_child with ast, pat, 0
        var pk as pskind.NodeKind is pskind.NodeKind.NdVarRef
        if pchild >= 0:
            set pk is calling astutil.kind_of with ast, pchild
        if pk == pskind.NodeKind.NdTrueLit or pk == pskind.NodeKind.NdFalseLit:
            if pk == pskind.NodeKind.NdFalseLit:
                calling sb.append with "!("
            calling sb.append with "("
            calling sb.append with stmp
            calling sb.append with ")"
            if pk == pskind.NodeKind.NdFalseLit:
                calling sb.append with ")"
            return calling sb.finish
        var first as bool is true
        var ci as int is 0
        var more as bool is true
        while more:
            var ptk as int is calling pattern_variant_token with m, ast, pat, ci
            if ptk < 0:
                set more is false
            else:
                var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ptk
                if txt != "|":
                    if not first:
                        calling sb.append with " || "
                    set first is false
                    var p0 as string is calling npool.copy_string with (txt at 0 to 1)
                    var is_num as bool is p0 == "0" or p0 == "1" or p0 == "2" or p0 == "3" or p0 == "4" or p0 == "5" or p0 == "6" or p0 == "7" or p0 == "8" or p0 == "9" or p0 == "-"
                    banish p0
                    if layout:
                        var vid as int is calling npool.intern with (sigil of c->program->names), txt
                        var vc as string is calling expr.omen_variant_c_name with c, st, vid
                        calling sb.append with "({stmp}).tag == "
                        calling sb.append with vc
                        banish vc
                    else if is_num:
                        calling sb.append with "({stmp}) == "
                        calling sb.append with txt
                    else if is_str:
                        calling sb.append with "pengu_string_equal(({stmp}), pengu_string_from_cstr("
                        calling sb.append with txt
                        calling sb.append with "))"
                    else:
                        var vid2 as int is calling npool.intern with (sigil of c->program->names), txt
                        var vc2 as string is calling expr.omen_variant_c_name with c, st, vid2
                        calling sb.append with "({stmp}) == "
                        calling sb.append with vc2
                        banish vc2
                banish txt
                set ci is ci + 1
        if first:
            calling sb.append with "0"
        return calling sb.finish
    return "0"

## Emite una lista por comprensión (`for x in xs [when cond] then expr`).
##
## ## Memoria
## Strings owned; el resultado es una statement-expression con un `PenguList`
## recién reservado.
weave for_comp_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var name_tok as int is calling astutil.token_child with ast, node, 0
    var col as int is calling astutil.node_child with ast, node, 1
    var cond as int is calling astutil.node_child with ast, node, 2
    var body as int is calling astutil.node_child with ast, node, 3
    if body < 0:
        set body is cond
        set cond is -1
    if name_tok < 0 or col < 0 or body < 0:
        return "0"
    var rt as int is calling node_type with c, node
    if rt <= 0:
        return "0"
    var rtt as tk.SemaType is calling types.at with (sigil of c->program->types), rt
    if rtt.kind != tk.SemaTypeKind.TkList:
        return "0"
    var et as int is rtt.a
    var ect as string is calling ctype.c_type with (sigil of c->names), et
    defer banish ect
    var ntxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), name_tok
    defer banish ntxt
    var cname as string is ""
    if ntxt == "_":
        set cname is calling emit.temp with (sigil of c->emitter), "_comp_x"
    else:
        set cname is calling context.safe_ident with c, ntxt
    defer banish cname
    var nid as int is calling npool.intern with (sigil of c->program->names), ntxt
    var col_type as int is calling node_type with c, col
    if col_type <= 0:
        set col_type is calling guess_type with c, col, ast
    var ct as tk.SemaType is calling types.at with (sigil of c->program->types), col_type
    var is_ref as bool is ct.kind == tk.SemaTypeKind.TkRef
    var actual as tk.SemaType is ct
    if is_ref and ct.a > 0:
        set actual is calling types.at with (sigil of c->program->types), ct.a
    var col_c as string is calling emit_expr with c, col
    defer banish col_c
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var ltmp as string is calling emit.temp with (sigil of c->emitter), "_comp"
    var itmp as string is calling emit.temp with (sigil of c->emitter), "_ci"
    var vtmp as string is calling emit.temp with (sigil of c->emitter), "_cv"
    defer banish ltmp
    defer banish itmp
    defer banish vtmp
    calling sb.append with "__extension__(({ PenguList "
    calling sb.append with ltmp
    calling sb.append with " = pengu_list_new(sizeof("
    calling sb.append with ect
    calling sb.append with "), 0); "
    # Tipo del binding del bucle (no el tipo del resultado).
    var loop_ty as int is et
    var ck as pskind.NodeKind is calling astutil.kind_of with ast, col
    if ck == pskind.NodeKind.NdToExpr:
        set loop_ty is calling types.base with (sigil of c->program->types), "int"
    else if ct.kind == tk.SemaTypeKind.TkMap:
        set loop_ty is actual.a
    else if actual.kind == tk.SemaTypeKind.TkList or actual.kind == tk.SemaTypeKind.TkSlice or actual.kind == tk.SemaTypeKind.TkArray:
        set loop_ty is actual.a
    else if actual.kind == tk.SemaTypeKind.TkBase:
        var lbn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), actual.name)
        defer banish lbn
        if lbn == "string":
            set loop_ty is calling types.base with (sigil of c->program->types), "string"
    var lct as string is calling ctype.c_type with (sigil of c->names), loop_ty
    defer banish lct
    # Locales: el binding del bucle solo vive dentro de la comprensión.
    var mark as int is c->locals.len
    calling context.add_local with c, nid, loop_ty, nid
    var cond_c as string is "1"
    if cond >= 0:
        set cond_c is calling emit_expr with c, cond
    defer banish cond_c
    var body_c as string is calling emit_expr_as with c, body, et
    defer banish body_c
    if ck == pskind.NodeKind.NdToExpr:
        var lo as int is calling astutil.node_child with ast, col, 0
        var hi as int is calling astutil.node_child with ast, col, 1
        var lo_c as string is calling emit_expr with c, lo
        var hi_c as string is calling emit_expr with c, hi
        defer banish lo_c
        defer banish hi_c
        calling sb.append with "for (int32_t "
        calling sb.append with cname
        calling sb.append with " = "
        calling sb.append with lo_c
        calling sb.append with "; "
        calling sb.append with cname
        calling sb.append with " < "
        calling sb.append with hi_c
        calling sb.append with "; "
        calling sb.append with cname
        calling sb.append with "++) { (void)"
        calling sb.append with cname
        calling sb.append with "; if ("
        calling sb.append with cond_c
        calling sb.append with ") { "
        calling sb.append with ect
        calling sb.append with " "
        calling sb.append with vtmp
        calling sb.append with " = "
        calling sb.append with body_c
        calling sb.append with "; pengu_list_push(&"
        calling sb.append with ltmp
        calling sb.append with ", &"
        calling sb.append with vtmp
        calling sb.append with "); } } "
    else if ct.kind == tk.SemaTypeKind.TkMap:
        var ktmp as string is calling emit.temp with (sigil of c->emitter), "_mk"
        var ptmp as string is calling emit.temp with (sigil of c->emitter), "_mp"
        defer banish ktmp
        defer banish ptmp
        calling sb.append with "PenguMap "
        calling sb.append with ktmp
        calling sb.append with " = "
        calling sb.append with col_c
        calling sb.append with "; PenguMapIter "
        calling sb.append with ptmp
        calling sb.append with " = pengu_map_iter_begin(&"
        calling sb.append with ktmp
        calling sb.append with "); for (; pengu_map_iter_valid(&"
        calling sb.append with ptmp
        calling sb.append with "); pengu_map_iter_advance(&"
        calling sb.append with ptmp
        calling sb.append with ")) { "
        calling sb.append with lct
        calling sb.append with " "
        calling sb.append with cname
        calling sb.append with " = (*(const "
        calling sb.append with lct
        calling sb.append with "*)pengu_map_iter_key(&"
        calling sb.append with ptmp
        calling sb.append with ")); (void)"
        calling sb.append with cname
        calling sb.append with "; if ("
        calling sb.append with cond_c
        calling sb.append with ") { "
        calling sb.append with ect
        calling sb.append with " "
        calling sb.append with vtmp
        calling sb.append with " = "
        calling sb.append with body_c
        calling sb.append with "; pengu_list_push(&"
        calling sb.append with ltmp
        calling sb.append with ", &"
        calling sb.append with vtmp
        calling sb.append with "); } } "
    else if actual.kind == tk.SemaTypeKind.TkList:
        var sep as string is "."
        var amp as string is "&"
        if is_ref:
            set sep is "->"
            set amp is ""
        calling sb.append with "PenguList "
        calling sb.append with ltmp
        calling sb.append with "_l = "
        calling sb.append with col_c
        calling sb.append with "; for (int "
        calling sb.append with itmp
        calling sb.append with " = 0; "
        calling sb.append with itmp
        calling sb.append with " < "
        calling sb.append with ltmp
        calling sb.append with "_l"
        calling sb.append with ".len; "
        calling sb.append with itmp
        calling sb.append with "++) { "
        calling sb.append with lct
        calling sb.append with " "
        calling sb.append with cname
        calling sb.append with " = (*( "
        calling sb.append with lct
        calling sb.append with "*)pengu_list_at(&"
        calling sb.append with ltmp
        calling sb.append with "_l, "
        calling sb.append with itmp
        calling sb.append with ")); if ("
        calling sb.append with cond_c
        calling sb.append with ") { "
        calling sb.append with ect
        calling sb.append with " "
        calling sb.append with vtmp
        calling sb.append with " = "
        calling sb.append with body_c
        calling sb.append with "; pengu_list_push(&"
        calling sb.append with ltmp
        calling sb.append with ", &"
        calling sb.append with vtmp
        calling sb.append with "); } } "
    else if actual.kind == tk.SemaTypeKind.TkRange:
        var rtmp as string is calling emit.temp with (sigil of c->emitter), "_cr"
        defer banish rtmp
        var ict as string is calling ctype.c_type with (sigil of c->names), (calling types.base with (sigil of c->program->types), "int")
        defer banish ict
        calling sb.append with "PenguRange "
        calling sb.append with rtmp
        calling sb.append with " = "
        calling sb.append with col_c
        calling sb.append with "; for (int32_t "
        calling sb.append with cname
        calling sb.append with " = (int32_t)("
        calling sb.append with rtmp
        calling sb.append with ").start; "
        calling sb.append with cname
        calling sb.append with " < (int32_t)("
        calling sb.append with rtmp
        calling sb.append with ").end; "
        calling sb.append with cname
        calling sb.append with "++) { (void)"
        calling sb.append with cname
        calling sb.append with "; if ("
        calling sb.append with cond_c
        calling sb.append with ") { "
        calling sb.append with ect
        calling sb.append with " "
        calling sb.append with vtmp
        calling sb.append with " = "
        calling sb.append with body_c
        calling sb.append with "; pengu_list_push(&"
        calling sb.append with ltmp
        calling sb.append with ", &"
        calling sb.append with vtmp
        calling sb.append with "); } } "
    else:
        var len_expr as string is "0"
        var sep2 as string is "."
        if is_ref:
            set sep2 is "->"
        if actual.kind == tk.SemaTypeKind.TkArray:
            set len_expr is "{actual.b}"
        else:
            set len_expr is "({col_c}){sep2}len"
        calling sb.append with "for (int "
        calling sb.append with itmp
        calling sb.append with " = 0; "
        calling sb.append with itmp
        calling sb.append with " < "
        calling sb.append with len_expr
        calling sb.append with "; "
        calling sb.append with itmp
        calling sb.append with "++) { "
        calling sb.append with lct
        calling sb.append with " "
        calling sb.append with cname
        if actual.kind == tk.SemaTypeKind.TkBase:
            var sbn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), actual.name)
            defer banish sbn
            if sbn == "string":
                calling sb.append with " = pengu_string_char_at("
                calling sb.append with col_c
                calling sb.append with ", "
                calling sb.append with itmp
                calling sb.append with "); "
            else:
                calling sb.append with " = ("
                calling sb.append with col_c
                calling sb.append with ")["
                calling sb.append with itmp
                calling sb.append with "]; "
        else if actual.kind == tk.SemaTypeKind.TkSlice:
            calling sb.append with " = (*( "
            calling sb.append with lct
            calling sb.append with "*)pengu_slice_at(&("
            calling sb.append with col_c
            calling sb.append with "), "
            calling sb.append with itmp
            calling sb.append with ")); "
        else:
            calling sb.append with " = ("
            calling sb.append with col_c
            calling sb.append with ")["
            calling sb.append with itmp
            calling sb.append with "]; "
        calling sb.append with "(void)"
        calling sb.append with cname
        calling sb.append with "; if ("
        calling sb.append with cond_c
        calling sb.append with ") { "
        calling sb.append with ect
        calling sb.append with " "
        calling sb.append with vtmp
        calling sb.append with " = "
        calling sb.append with body_c
        calling sb.append with "; pengu_list_push(&"
        calling sb.append with ltmp
        calling sb.append with ", &"
        calling sb.append with vtmp
        calling sb.append with "); } } "
    while c->locals.len > mark:
        var ignored as context.CgLocal is calling c->locals.pop
    calling sb.append with ltmp
    calling sb.append with "; }))"
    return calling sb.finish

## Emite un literal de lista `[a, b, ...]` como `PenguList`.
##
## ## Memoria
## Strings owned.
weave list_literal_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, ty as int into string:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var et as string is calling ctype.c_type with (sigil of c->names), t.a
    defer banish et
    var n as int is calling astutil.child_count with ast, node
    var lt as string is calling emit.temp with (sigil of c->emitter), "_list"
    var vt as string is calling emit.temp with (sigil of c->emitter), "_lv"
    defer banish lt
    defer banish vt
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "__extension__(({ PenguList "
    calling sb.append with lt
    calling sb.append with " = pengu_list_new(sizeof("
    calling sb.append with et
    calling sb.append with "), "
    calling sb.append with "{n}"
    calling sb.append with "); "
    if n > 0:
        calling sb.append with et
        calling sb.append with " "
        calling sb.append with vt
        calling sb.append with "; "
    var i as int is 0
    while i < n:
        var el as int is calling astutil.node_child with ast, node, i
        if el >= 0:
            var ev as string is calling emit_expr_as with c, el, t.a
            calling sb.append with vt
            calling sb.append with " = "
            calling sb.append with ev
            calling sb.append with "; pengu_list_push(&"
            calling sb.append with lt
            calling sb.append with ", &"
            calling sb.append with vt
            calling sb.append with "); "
            banish ev
        set i is i + 1
    calling sb.append with lt
    calling sb.append with "; }))"
    return calling sb.finish

## Emite un literal de mapa como statement expression C99.
##
## Cada entrada se copia a un temporal del tipo de la clave/valor y se inserta
## con `pengu_map_put`, así el literal funciona con claves y valores de
## cualquier tipo (incluidas runas) y el mapa queda listo antes de devolverlo.
##
## ## Memoria
## Strings del texto emitido.
weave map_lit_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, ty as int into string:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var kt as string is calling ctype.c_type with (sigil of c->names), t.a
    defer banish kt
    var vt as string is calling ctype.c_type with (sigil of c->names), t.b
    defer banish vt
    var mt as string is calling emit.temp with (sigil of c->emitter), "_map"
    defer banish mt
    var kvt as string is calling emit.temp with (sigil of c->emitter), "_mk"
    defer banish kvt
    var vvt as string is calling emit.temp with (sigil of c->emitter), "_mv"
    defer banish vvt
    var mm as loader.SemaModule is (c->program->modules at c->current_module)
    var n as int is calling astutil.child_count with ast, node
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "__extension__(({ PenguMap "
    calling sb.append with mt
    calling sb.append with " = pengu_map_new(sizeof("
    calling sb.append with kt
    calling sb.append with "), sizeof("
    calling sb.append with vt
    calling sb.append with ")); "
    if n > 0:
        calling sb.append with kt
        calling sb.append with " "
        calling sb.append with kvt
        calling sb.append with "; "
        calling sb.append with vt
        calling sb.append with " "
        calling sb.append with vvt
        calling sb.append with "; "
    var i as int is 0
    while i < n:
        var entry as int is calling astutil.node_child with ast, node, i
        if entry >= 0:
            var kn as int is calling astutil.node_child with ast, entry, 0
            var vn as int is calling astutil.node_child with ast, entry, 1
            if vn >= 0:
                # Una clave de cadena se guarda como token hijo, no como nodo.
                var kv as string is ""
                if kn >= 0:
                    set kv is calling emit_expr_as with c, kn, t.a
                else:
                    var ktok as int is calling astutil.token_child with ast, entry, 0
                    if ktok >= 0:
                        var kraw as string is calling astutil.token_text with (sigil of mm.source), (sigil of mm.lex), ktok
                        set kv is calling c_string_expr with c, entry, kraw, false
                        banish kraw
                var vv as string is calling emit_expr_as with c, vn, t.b
                calling sb.append with kvt
                calling sb.append with " = "
                calling sb.append with kv
                calling sb.append with "; "
                calling sb.append with vvt
                calling sb.append with " = "
                calling sb.append with vv
                calling sb.append with "; pengu_map_put(&"
                calling sb.append with mt
                calling sb.append with ", &"
                calling sb.append with kvt
                calling sb.append with ", &"
                calling sb.append with vvt
                calling sb.append with "); "
                banish kv
                banish vv
        set i is i + 1
    calling sb.append with mt
    calling sb.append with "; }))"
    return calling sb.finish

weave emit_expr_as with c as ref to context.CgContext, node as int, expected as int into string:
    if node < 0:
        return "0"
    var m0 as loader.SemaModule is (c->program->modules at c->current_module)
    var mt0 as ref to psast.PsAst is (sigil of m0.parse.ast)
    var ek0 as pskind.NodeKind is calling astutil.kind_of with mt0, node
    if expected >= 0 and ek0 == pskind.NodeKind.NdDoExpr:
        var dhook as weave with hc as ref to context.CgContext, hnode as int, hexp as int into string is c->block_value
        return calling dhook with c, node, expected
    if expected >= 0 and ek0 == pskind.NodeKind.NdBlock:
        var bhook as weave with hc as ref to context.CgContext, hnode as int, hexp as int into string is c->block_value
        return calling bhook with c, node, expected
    if expected >= 0 and ek0 == pskind.NodeKind.NdIfStmt:
        return calling if_stmt_value with c, node, mt0, expected
    if expected >= 0 and ek0 == pskind.NodeKind.NdIfExpr:
        return calling if_expr_expected with c, node, mt0, expected
    if expected >= 0 and (calling astutil.kind_of with mt0, node) == pskind.NodeKind.NdCallingExpr:
        var tgt0 as int is calling astutil.node_child with mt0, node, 0
        var lt0 as int is calling last_token_deep with mt0, tgt0
        if lt0 >= 0:
            var cn0 as string is calling astutil.token_text with (sigil of m0.source), (sigil of m0.lex), lt0
            if cn0 == "ok_of" or cn0 == "err_of" or cn0 == "some":
                var iok as bool is cn0 == "ok_of"
                var imay as bool is cn0 == "some"
                banish cn0
                return calling result_ctor with c, node, mt0, iok, imay, expected
            banish cn0
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var ast as ref to psast.PsAst is (sigil of m.parse.ast)
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdCallingExpr:
        var ct0 as int is calling astutil.node_child with ast, node, 0
        var cl as int is calling last_token_deep with ast, ct0
        if cl >= 0:
            var cnm as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), cl
            if cnm == "ok_of" or cnm == "err_of" or cnm == "some":
                var iok as bool is cnm == "ok_of"
                var imay as bool is cnm == "some"
                banish cnm
                return calling result_ctor with c, node, ast, iok, imay, expected
            banish cnm
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdJudgeExpr:
        return calling judge_expr_c with c, node, ast, expected
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdParenExpr:
        var pin as int is calling astutil.node_child with ast, node, 0
        return calling emit_expr_as with c, pin, expected
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdVarRef:
        var et1 as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if et1.kind == tk.SemaTypeKind.TkOmen:
            var vt as int is calling astutil.token_child with ast, node, 0
            if vt >= 0:
                var vtxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), vt
                var vid as int is calling npool.intern with (sigil of c->program->names), vtxt
                banish vtxt
                if (calling context.local_c_name with c, vid) >= 0:
                    return calling emit_expr with c, node
                var pfirst as int is calling omen_first_payload with c, expected, vid
                var on2 as string is calling ctype.c_type with (sigil of c->names), expected
                defer banish on2
                var vtx2 as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), vid)
                defer banish vtx2
                if calling omen_has_layout with c, expected:
                    var obsb as StringBuilder is calling StringBuilder.new
                    defer banish obsb
                    calling obsb.append with "("
                    calling obsb.append with on2
                    calling obsb.append with "){.tag = "
                    calling obsb.append with on2
                    calling obsb.append with "_"
                    calling obsb.append with vtx2
                    calling obsb.append with "}"
                    return calling obsb.finish
                return "{on2}_{vtx2}"
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdFieldAccess:
        var eti as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if eti.kind == tk.SemaTypeKind.TkOmen and eti.a >= 0 and eti.a < c->program->types.nominal_infos.len:
            var etinfo as types.SemaNominalInfo is (c->program->types.nominal_infos at eti.a)
            var bnode as int is calling astutil.node_child with ast, node, 0
            var btext as string is calling astutil.first_token_text with (sigil of m.source), (sigil of m.lex), ast, bnode
            var fbid as int is calling npool.intern with (sigil of c->program->names), btext
            banish btext
            if fbid == etinfo.base_name and (calling context.local_c_name with c, fbid) < 0:
                var lvt as int is calling last_token_deep with ast, node
                if lvt >= 0:
                    var lvtext as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), lvt
                    var lvid as int is calling npool.intern with (sigil of c->program->names), lvtext
                    banish lvtext
                    return calling omen_variant_literal with c, expected, lvid
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdSomeExpr:
        return calling some_expr_c with c, node, ast, expected
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdStructInit:
        var et0 as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if et0.kind == tk.SemaTypeKind.TkOmen:
            return calling omen_init_expr with c, node, ast, expected
        return calling struct_init_expr with c, node, ast, expected
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdListType:
        var lt0 as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if lt0.kind == tk.SemaTypeKind.TkList:
            var et0 as string is calling ctype.c_type with (sigil of c->names), lt0.a
            var ln0 as string is "pengu_list_new(sizeof({et0}), 0)"
            banish et0
            return ln0
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdMapType:
        var mt0 as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if mt0.kind == tk.SemaTypeKind.TkMap:
            var kt0 as string is calling ctype.c_type with (sigil of c->names), mt0.a
            var vt0 as string is calling ctype.c_type with (sigil of c->names), mt0.b
            var mnew as string is "pengu_map_new(sizeof({kt0}), sizeof({vt0}))"
            banish kt0
            banish vt0
            return mnew
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdMapLit:
        var mt1 as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if mt1.kind == tk.SemaTypeKind.TkMap:
            return calling map_lit_expr with c, node, ast, expected
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdMapInitExpr:
        var mt2 as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if mt2.kind == tk.SemaTypeKind.TkMap:
            var kt2 as string is calling ctype.c_type with (sigil of c->names), mt2.a
            var vt2 as string is calling ctype.c_type with (sigil of c->names), mt2.b
            var mnew3 as string is "pengu_map_new(sizeof({kt2}), sizeof({vt2}))"
            banish kt2
            banish vt2
            return mnew3
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdIndentLiteral:
        return calling indent_init_expr with c, node, ast, expected
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdWithInitExpr:
        return calling with_init_expr with c, node, ast, expected
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdListInitExpr:
        return calling list_init_expr with c, node, ast, expected
    if expected >= 0 and ((calling astutil.kind_of with ast, node) == pskind.NodeKind.NdArrayLit):
        var elt0 as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if elt0.kind == tk.SemaTypeKind.TkList:
            return calling list_literal_expr with c, node, ast, expected
    if expected >= 0 and (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdArrayLit:
        return calling array_lit_expr with c, node, ast, expected
    if expected >= 0 and ((calling astutil.kind_of with ast, node) == pskind.NodeKind.NdArrayInitExpr or (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdArrayType or (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdSliceType or (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdListType or (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdTypeOrParam):
        # `array of T with size N` como valor es un buffer vacío del tamaño
        # pedido: `(T[N]){0}`, no un puntero nulo.
        var zt as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if zt.kind == tk.SemaTypeKind.TkArray and zt.a > 0 and zt.b > 0:
            var zel as string is calling ctype.c_type with (sigil of c->names), zt.a
            var zsb2 as StringBuilder is calling StringBuilder.new
            defer banish zsb2
            calling zsb2.append with "("
            calling zsb2.append with zel
            calling zsb2.append with "["
            calling zsb2.append with "{zt.b}"
            calling zsb2.append with "]){"
            calling zsb2.append with "0"
            calling zsb2.append with "}"
            banish zel
            return calling zsb2.finish
    var vfin as string is calling emit_expr with c, node
    # C++ no convierte `void*` a `T*` implicitamente: `return
    # pengu_memoria_alloc(...)` en un `ref to T` necesita el cast.
    if c->options.family == "cpp" and expected >= 0:
        var et0 as tk.SemaType is calling types.at with (sigil of c->program->types), expected
        if et0.kind == tk.SemaTypeKind.TkRef:
            var ctsb as StringBuilder is calling StringBuilder.new
            defer banish ctsb
            var ects as string is calling ctype.c_type with (sigil of c->names), expected
            defer banish ects
            calling ctsb.append with "("
            calling ctsb.append with ects
            calling ctsb.append with ")("
            calling ctsb.append with vfin
            calling ctsb.append with ")"
            banish vfin
            return calling ctsb.finish
    return vfin

## Emite una operación binaria.
##
## ## Memoria
## Strings owned.
weave binary_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var l as string is calling emit_expr with c, (calling astutil.node_child with ast, node, 0)
    defer banish l
    var r as string is calling emit_expr with c, (calling astutil.node_child with ast, node, 1)
    defer banish r
    var k as pskind.NodeKind is calling astutil.kind_of with ast, node
    var op as string is "?"
    if k == pskind.NodeKind.NdAdd:
        set op is "+"
    else if k == pskind.NodeKind.NdSub:
        set op is "-"
    else if k == pskind.NodeKind.NdMul:
        set op is "*"
    else if k == pskind.NodeKind.NdDiv:
        set op is "/"
    else if k == pskind.NodeKind.NdMod:
        set op is "%"
    else if k == pskind.NodeKind.NdBitwiseAnd:
        set op is "&"
    else if k == pskind.NodeKind.NdBitwiseOr:
        set op is "|"
    else if k == pskind.NodeKind.NdBitwiseXor:
        set op is "^"
    else if k == pskind.NodeKind.NdShl:
        set op is "<<"
    else if k == pskind.NodeKind.NdShr:
        set op is ">>"
    else if k == pskind.NodeKind.NdEq:
        set op is "=="
    else if k == pskind.NodeKind.NdNe:
        set op is "!="
    else if k == pskind.NodeKind.NdLt:
        set op is "<"
    else if k == pskind.NodeKind.NdLe:
        set op is "<="
    else if k == pskind.NodeKind.NdGt:
        set op is ">"
    else if k == pskind.NodeKind.NdGe:
        set op is ">="
    else if k == pskind.NodeKind.NdBoolAnd:
        set op is "&&"
    else if k == pskind.NodeKind.NdBoolOr:
        set op is "||"
    if op == "==" or op == "!=":
        var lnode0 as int is calling astutil.node_child with ast, node, 0
        var rnode0 as int is calling astutil.node_child with ast, node, 1
        var salt as bool is false
        if lnode0 >= 0 and (calling astutil.kind_of with ast, lnode0) == pskind.NodeKind.NdStringLit:
            set salt is true
        if rnode0 >= 0 and (calling astutil.kind_of with ast, rnode0) == pskind.NodeKind.NdStringLit:
            set salt is true
        if salt:
            if op == "==":
                return "pengu_string_equal({l}, {r})"
            return "(!pengu_string_equal({l}, {r}))"
        var ln0 as int is calling astutil.node_child with ast, node, 0
        var rn0 as int is calling astutil.node_child with ast, node, 1
        var lt0 as int is calling guess_type with c, ln0, ast
        var rt0 as int is calling guess_type with c, rn0, ast
        var is_str as bool is false
        if lt0 >= 0:
            var lt1 as tk.SemaType is calling types.at with (sigil of c->program->types), lt0
            if lt1.kind == tk.SemaTypeKind.TkBase:
                var lbn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), lt1.name)
                defer banish lbn
                if lbn == "string":
                    set is_str is true
        if not is_str and rt0 >= 0:
            var rt1 as tk.SemaType is calling types.at with (sigil of c->program->types), rt0
            if rt1.kind == tk.SemaTypeKind.TkBase:
                var rbn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), rt1.name)
                defer banish rbn
                if rbn == "string":
                    set is_str is true
        if is_str:
            if op == "==":
                return "pengu_string_equal({l}, {r})"
            return "(!pengu_string_equal({l}, {r}))"
        if lt0 >= 0:
            var lt1x as tk.SemaType is calling types.at with (sigil of c->program->types), lt0
            if lt1x.kind == tk.SemaTypeKind.TkRune or lt1x.kind == tk.SemaTypeKind.TkEcho or (lt1x.kind == tk.SemaTypeKind.TkOmen and calling omen_has_layout with c, lt0):
                if op == "==":
                    return "(memcmp(&({l}), &({r}), sizeof({l})) == 0)"
                return "(memcmp(&({l}), &({r}), sizeof({l})) != 0)"
    if op == "+":
        var ln1 as int is calling astutil.node_child with ast, node, 0
        var rn1 as int is calling astutil.node_child with ast, node, 1
        var lt1 as int is calling guess_type with c, ln1, ast
        var rt1 as int is calling guess_type with c, rn1, ast
        var str_add as bool is false
        if lt1 >= 0:
            var ltt as tk.SemaType is calling types.at with (sigil of c->program->types), lt1
            if ltt.kind == tk.SemaTypeKind.TkBase:
                var lnn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), ltt.name)
                if lnn == "string":
                    set str_add is true
                banish lnn
        if not str_add and rt1 >= 0:
            var rtt as tk.SemaType is calling types.at with (sigil of c->program->types), rt1
            if rtt.kind == tk.SemaTypeKind.TkBase:
                var rnn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), rtt.name)
                if rnn == "string":
                    set str_add is true
                banish rnn
        if str_add:
            # Los operandos que son temporales (interpolación, vista `at a to
            # b`) se liberan tras concatenar; los que son variables prestadas
            # se pasan tal cual.
            var lowns as bool is calling expr_owns_temp with c, ln1
            var rowns as bool is calling expr_owns_temp with c, rn1
            if not lowns and not rowns:
                return "pengu_string_concat({l}, {r})"
            var lname as string is calling emit.temp with (sigil of c->emitter), "_scl"
            defer banish lname
            var rname as string is calling emit.temp with (sigil of c->emitter), "_scr"
            defer banish rname
            var oname as string is calling emit.temp with (sigil of c->emitter), "_sco"
            defer banish oname
            var ac as StringBuilder is calling StringBuilder.new
            defer banish ac
            calling ac.append with "({ "
            if lowns:
                calling ac.append with "PenguString "
                calling ac.append with lname
                calling ac.append with " = "
                calling ac.append with l
                calling ac.append with "; "
            if rowns:
                calling ac.append with "PenguString "
                calling ac.append with rname
                calling ac.append with " = "
                calling ac.append with r
                calling ac.append with "; "
            calling ac.append with "PenguString "
            calling ac.append with oname
            calling ac.append with " = pengu_string_concat("
            if lowns:
                calling ac.append with lname
            else:
                calling ac.append with l
            calling ac.append with ", "
            if rowns:
                calling ac.append with rname
            else:
                calling ac.append with r
            calling ac.append with "); "
            if lowns:
                calling ac.append with "pengu_banish_string(&"
                calling ac.append with lname
                calling ac.append with "); "
            if rowns:
                calling ac.append with "pengu_banish_string(&"
                calling ac.append with rname
                calling ac.append with "); "
            calling ac.append with oname
            calling ac.append with "; })"
            return calling ac.finish
    return "({l} {op} {r})"

## Último token de un subárbol (el nombre del método en un target).
##
## ## Memoria
## O(nodos).
weave last_token_deep with ast as ref to psast.PsAst, node as int into int:
    if node < 0:
        return -1
    var n as int is calling astutil.child_count with ast, node
    var i as int is n - 1
    while i >= 0:
        var t as int is calling astutil.token_child with ast, node, i
        if t >= 0:
            return t
        var ch as int is calling astutil.node_child with ast, node, i
        if ch >= 0:
            var got as int is calling last_token_deep with ast, ch
            if got >= 0:
                return got
        set i is i - 1
    return -1

## Emite `some expr` con boxing en heap.
##
## ## Memoria
## Strings owned.
weave some_expr_c with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, wanted as int into string:
    var rt as int is calling node_type with c, node
    if wanted > 0:
        var wt0 as tk.SemaType is calling types.at with (sigil of c->program->types), wanted
        if wt0.kind == tk.SemaTypeKind.TkResult or wt0.kind == tk.SemaTypeKind.TkMaybe:
            set rt is wanted
    if rt < 0:
        set rt is wanted
    if rt < 0:
        return "0"
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), rt
    if t.kind != tk.SemaTypeKind.TkMaybe and wanted > 0:
        set rt is wanted
        set t is calling types.at with (sigil of c->program->types), rt
    var payx as int is t.a
    if t.kind != tk.SemaTypeKind.TkMaybe:
        set payx is -1
    if payx <= 0:
        var an0 as int is calling astutil.node_child with ast, node, 0
        set payx is calling node_type with c, an0
    if payx <= 0:
        set payx is calling types.base with (sigil of c->program->types), "int"
    if c->names.subst.len > 0:
        set payx is calling subst_codegen with c, payx
    var pt as string is calling ctype.c_type with (sigil of c->names), payx
    defer banish pt
    var an as int is calling astutil.node_child with ast, node, 0
    var av as string is calling emit_expr with c, an
    defer banish av
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "__extension__(({ "
    if calling scrolls.contains with pt, "(*)":
        calling sb.append with "void* _h = malloc(sizeof("
        calling sb.append with pt
        calling sb.append with ")); if (!_h) abort(); memcpy(_h, &("
        calling sb.append with pt
        calling sb.append with "){ "
        calling sb.append with av
        calling sb.append with " }, sizeof("
        calling sb.append with pt
        calling sb.append with ")); PenguMaybe _r = pengu_maybe_some(_h); _r; }))"
    else:
        calling sb.append with pt
        calling sb.append with " _p = "
        calling sb.append with av
        calling sb.append with "; "
        calling sb.append with pt
        calling sb.append with "* _h = ("
        calling sb.append with pt
        calling sb.append with "*)malloc(sizeof("
        calling sb.append with pt
        calling sb.append with ")); if (!_h) abort(); *_h = _p; PenguMaybe _r = pengu_maybe_some(_h); _r; }))"
    return calling sb.finish

## Constructores intrínsecos `ok_of`, `err_of` y `some`.
##
## ## Memoria
## Devuelve una statement-expression owned.
weave result_ctor with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, is_ok as bool, is_maybe as bool, wanted as int into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var rt as int is calling node_type with c, node
    if wanted > 0:
        var wt0 as tk.SemaType is calling types.at with (sigil of c->program->types), wanted
        if wt0.kind == tk.SemaTypeKind.TkResult or wt0.kind == tk.SemaTypeKind.TkMaybe:
            set rt is wanted
    if rt < 0:
        set rt is wanted
    if rt < 0:
        return "0"
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), rt
    if not is_maybe and t.kind == tk.SemaTypeKind.TkResult:
        var vpay as int is t.a
        if is_ok and vpay > 0:
            var vpt as tk.SemaType is calling types.at with (sigil of c->program->types), vpay
            if vpt.kind == tk.SemaTypeKind.TkVoid:
                return "pengu_result_ok(NULL)"
    var pay as int is -1
    if is_maybe and t.kind == tk.SemaTypeKind.TkMaybe:
        set pay is t.a
    else if not is_maybe and t.kind == tk.SemaTypeKind.TkResult:
        if is_ok:
            set pay is t.a
        else:
            set pay is t.b
    var args as int is calling astutil.node_child with ast, node, 2
    if args < 0:
        return "0"
    var avn as int is calling astutil.node_child with ast, args, 0
    if avn < 0:
        return "0"
    if (calling astutil.kind_of with ast, avn) == pskind.NodeKind.NdPosArg:
        set avn is calling astutil.node_child with ast, avn, 0
    if (calling astutil.kind_of with ast, avn) == pskind.NodeKind.NdParenExpr:
        set avn is calling astutil.node_child with ast, avn, 0
    if pay < 0 or (pay >= 0 and ((calling types.at with (sigil of c->program->types), pay).kind == tk.SemaTypeKind.TkError or (calling types.at with (sigil of c->program->types), pay).kind == tk.SemaTypeKind.TkAny or (calling types.at with (sigil of c->program->types), pay).kind == tk.SemaTypeKind.TkOpaque)):
        var aty as int is calling node_type with c, avn
        if aty >= 0:
            set pay is aty
            var atk as tk.SemaTypeKind is (calling types.at with (sigil of c->program->types), aty).kind
            if atk == tk.SemaTypeKind.TkAny or atk == tk.SemaTypeKind.TkError:
                set pay is -1
    if (calling astutil.kind_of with ast, avn) == pskind.NodeKind.NdStructInit:
        var vf as int is calling astutil.node_child with ast, avn, 0
        if vf >= 0:
            var vt0 as int is calling astutil.token_child with ast, vf, 0
            if vt0 >= 0:
                var vtxt0 as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), vt0
                var vnid0 as int is calling npool.intern with (sigil of c->program->names), vtxt0
                var vsid as int is calling symbols.lookup_name with (sigil of c->program->symbols), vtxt0
                if vsid < 0:
                    set vsid is calling symbols.lookup_in_scope with (sigil of c->program->symbols), 0, vnid0
                if vsid < 0:
                    var ssi as int is 0
                    while ssi < c->program->symbols.symbols.len:
                        var ssym as sym.SemaSymbol is (c->program->symbols.symbols at ssi)
                        if ssym.name == vnid0 and ssym.type >= 0:
                            var sst as tk.SemaType is calling types.at with (sigil of c->program->types), ssym.type
                            if sst.kind == tk.SemaTypeKind.TkOmen:
                                set vsid is ssi
                        set ssi is ssi + 1
                if vsid >= 0:
                    var vsym as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), vsid
                    set pay is vsym.type
                banish vtxt0
    if pay < 0:
        return "0"
    if c->names.subst.len > 0:
        set pay is calling subst_codegen with c, pay
    var pt as string is calling ctype.c_type with (sigil of c->names), pay
    defer banish pt
    var av as string is calling emit_expr_as with c, avn, pay
    defer banish av
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "__extension__(({ "
    if calling scrolls.contains with pt, "(*)":
        calling sb.append with "void* _h = malloc(sizeof("
        calling sb.append with pt
        calling sb.append with ")); if (!_h) abort(); memcpy(_h, &("
        calling sb.append with pt
        calling sb.append with "){ "
        calling sb.append with av
        calling sb.append with " }, sizeof("
        calling sb.append with pt
        calling sb.append with ")); "
    else:
        calling sb.append with pt
        calling sb.append with " _p = "
        calling sb.append with av
        calling sb.append with "; "
        calling sb.append with pt
        calling sb.append with "* _h = ("
        calling sb.append with pt
        calling sb.append with "*)malloc(sizeof("
        calling sb.append with pt
        calling sb.append with ")); if (!_h) abort(); *_h = _p; "
    if is_maybe:
        calling sb.append with "PenguMaybe _r = pengu_maybe_some(_h); _r; }))"
    else if is_ok:
        calling sb.append with "PenguResult _r = pengu_result_ok(_h); _r; }))"
    else:
        calling sb.append with "PenguResult _r = pengu_result_err(_h); _r; }))"
    return calling sb.finish

## Baja métodos builtin de `maybe`/`result` (`unwrap`, `is_some`, ...).
##
## Devuelve `""` si la llamada no es uno de esos métodos. El receptor se
## resuelve sin el último acceso (el nombre del método).
##
## ## Memoria
## Devuelve string owned cuando hay coincidencia.
weave maybe_result_method with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var tgt as int is calling astutil.node_child with ast, node, 0
    if tgt < 0 or (calling astutil.kind_of with ast, tgt) != pskind.NodeKind.NdNormalTarget:
        return ""
    var last as int is calling last_token_deep with ast, tgt
    if last < 0:
        return ""
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var mname as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), last
    defer banish mname
    var rt as CgTarget is calling resolve_target with c, tgt, ast, true
    defer banish rt.text
    if rt.type_id <= 0:
        return ""
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), rt.type_id
    if t.kind == tk.SemaTypeKind.TkMaybe:
        if mname == "is_some" or mname == "is_present":
            return "(({rt.text}).is_present)"
        if mname == "is_none" or mname == "is_not_present":
            return "(!({rt.text}).is_present)"
        var ct as string is calling ctype.c_type with (sigil of c->names), t.a
        defer banish ct
        var cpt as string is calling ctype.pointer_type_name with ct
        defer banish cpt
        if mname == "unwrap" or mname == "expect":
            return "(*( {cpt})(({rt.text}).value))"
        if mname == "unwrap_or" or mname == "value_or":
            var args as int is calling astutil.node_child with ast, node, 2
            if args >= 0:
                var a0 as int is calling astutil.node_child with ast, args, 0
                if a0 >= 0 and (calling astutil.kind_of with ast, a0) == pskind.NodeKind.NdPosArg:
                    set a0 is calling astutil.node_child with ast, a0, 0
                if a0 >= 0:
                    var dv as string is calling emit_expr_as with c, a0, t.a
                    defer banish dv
                    return "(({rt.text}).is_present ? (*( {cpt})(({rt.text}).value)) : ({dv}))"
        return ""
    if t.kind == tk.SemaTypeKind.TkResult:
        if mname == "is_ok":
            return "(({rt.text}).is_ok)"
        if mname == "is_err":
            return "(!({rt.text}).is_ok)"
        var okt as string is calling ctype.c_type with (sigil of c->names), t.a
        defer banish okt
        var okp as string is calling ctype.pointer_type_name with okt
        defer banish okp
        if mname == "unwrap" or mname == "expect":
            return "(*( {okp})(({rt.text}).ok_val))"
        if mname == "unwrap_err" or mname == "expect_err":
            var ert as string is calling ctype.c_type with (sigil of c->names), t.b
            defer banish ert
            var erp as string is calling ctype.pointer_type_name with ert
            defer banish erp
            return "(*( {erp})(({rt.text}).err_val))"
        if mname == "unwrap_or" or mname == "value_or":
            var args2 as int is calling astutil.node_child with ast, node, 2
            if args2 >= 0:
                var a02 as int is calling astutil.node_child with ast, args2, 0
                if a02 >= 0 and (calling astutil.kind_of with ast, a02) == pskind.NodeKind.NdPosArg:
                    set a02 is calling astutil.node_child with ast, a02, 0
                if a02 >= 0:
                    var dv2 as string is calling emit_expr_as with c, a02, t.a
                    defer banish dv2
                    return "(({rt.text}).is_ok ? (*( {okp})(({rt.text}).ok_val)) : ({dv2}))"
        return ""
    return ""

## Emite una llamada.
##
## Usa la anotación de símbolo de F3 (resuelve `mod.fn` y métodos); si falta,
## cae al último token del target y al catálogo por nombre.
##
## ## Memoria
## Strings owned; no posee args.
## Emite un valor de función genérico (`f of T`).
##
## ## Memoria
## Puede crear especializaciones y tipos.
weave generic_ref with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var target as int is calling astutil.node_child with ast, node, 0
    var gargs as int is calling astutil.node_child with ast, node, 1
    if target < 0 or gargs < 0:
        return "NULL"
    var sid as int is calling ann.symbol_of with (sigil of m.annotations), target
    if sid < 0:
        return "NULL"
    if not (calling c->catalog.by_symbol.has with sid):
        return "NULL"
    var base_idx as int is calling c->catalog.by_symbol.get with sid
    var args as list of int is list of int
    defer banish args
    var n as int is calling astutil.child_count with ast, gargs
    var i as int is 0
    while i < n:
        var tn as int is calling astutil.node_child with ast, gargs, i
        var at as int is calling tast.type_from_ast with c, m, tn
        if at > 0:
            set at is calling generics.subst_codegen with c, at
        calling args.push with at
        set i is i + 1
    var spec as int is calling generics.add_spec with c, base_idx, args
    if spec < 0 or spec >= c->catalog.functions.len:
        return "NULL"
    var f as catalog.CgFunction is (c->catalog.functions at spec)
    return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.c_name)

## `true` si `node` produce un `string` con dueño que hay que liberar.
##
## Hoy cubre las tres fuentes de temporales de cadena: interpolación,
## concatenación (`+`) y vista `at a to b`. El resto de expresiones devuelven
## vistas prestadas o valores que no asignan.
##
## ## Memoria
## O(1) salvo la búsqueda de `StringInfo` (O(literales)).
weave expr_owns_temp with c as ref to context.CgContext, node as int into bool:
    if node < 0:
        return false
    var mm as loader.SemaModule is (c->program->modules at c->current_module)
    var kk as pskind.NodeKind is calling astutil.kind_of with (sigil of mm.parse.ast), node
    if kk == pskind.NodeKind.NdStringLit:
        return (calling find_string_info with c, node) >= 0
    if kk == pskind.NodeKind.NdAdd or kk == pskind.NodeKind.NdAtExpr:
        var ty as int is calling node_type with c, node
        if ty > 0:
            var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
            if t.kind == tk.SemaTypeKind.TkBase:
                var nm as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), t.name)
                defer banish nm
                if nm == "string":
                    return true
    return false

## `true` si el texto C `t` produce un `string` con dueño.
##
## Se usa cuando el nodo no tiene tipo anotado (fallback del sema). Sólo los
## productores de temporales emiten estos nombres, así que no hay falsos
## positivos sobre variables prestadas.
##
## ## Memoria
## O(n).
weave text_owns_temp with c as ref to context.CgContext, t as string into bool:
    # Sólo el productor en la raíz de la expresión: un `==` que compara dos
    # concatenaciones contiene el nombre pero produce un `bool`.
    if calling scrolls.starts_with with t, "pengu_string_format_ex(":
        return true
    if calling scrolls.starts_with with t, "pengu_string_substring(":
        return true
    if calling scrolls.starts_with with t, "pengu_string_concat(":
        return true
    # Concatenación con operandos temporales: el codegen la envuelve en un
    # statement expression `({ PenguString _sclN = ...; ... })` (sin el
    # `__extension__` de los índices de mapa, que devuelven valores prestados).
    if calling scrolls.starts_with with t, "({ PenguString _sc":
        return true
    return false

## `true` cuando el id de tipo `ty` es exactamente el `string` base.
##
## Los temporales con dueño sólo existen para `string`; sin esta guarda un
## `maybe` o un `int` con texto de statement expression se envolvería como si
## fuera una cadena y el C no compilaría.
##
## ## Memoria
## O(1).
weave is_string_type with c as ref to context.CgContext, ty as int into bool:
    if ty <= 0:
        return false
    return ty == (calling types.base with (sigil of c->program->types), "string")

## Emite un argumento y, si es un temporal de cadena, lo cambia por una
## variable local que el envoltorio de la llamada libera después.
##
## ## Memoria
## `inits` toma el dueño del texto emitido; `names` recibe una copia.
weave push_arg with c as ref to context.CgContext, sb as ref to StringBuilder, names as ref to list of string, inits as ref to list of string, anode as int, expected as int into void:
    var sv as string is ""
    if expected > 0 and expected != types.TYPE_ID_CVARARGS:
        set sv is calling emit_expr_as with c, anode, expected
    else:
        set sv is calling emit_expr with c, anode
    var sty as int is expected
    if sty <= 0 or sty == types.TYPE_ID_CVARARGS:
        set sty is calling node_type with c, anode
    var own as bool is false
    if calling is_string_type with c, sty:
        set own is calling text_owns_temp with c, sv
    if own:
        var nm as string is "p_t{names->len}"
        calling names->push with (calling npool.copy_string with nm)
        calling inits->push with sv
        calling sb.append with nm
        banish nm
    else:
        calling sb.append with sv
        banish sv

weave call_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var get_alias as string is calling get_alias_call with c, node, ast
    if get_alias length > 0:
        return get_alias
    var builtin_mr as string is calling maybe_result_method with c, node, ast
    if builtin_mr length > 0:
        return builtin_mr
    # Intrínseco `cc_type_kind of T`: constante de compilación para los
    # descriptores de claves de std.ordinal. Se resuelve antes de cualquier
    # búsqueda en el catálogo; `cc_type_kind` no se emite como función.
    var ik_target as int is calling astutil.node_child with ast, node, 0
    if ik_target >= 0:
        var ik_last as int is calling last_token_deep with ast, ik_target
        if ik_last >= 0:
            var ik_txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ik_last
            if ik_txt == "cc_type_kind":
                var ik_args as int is calling astutil.node_child with ast, node, 1
                if ik_args >= 0:
                    var ik_first as int is calling astutil.node_child with ast, ik_args, 0
                    if ik_first >= 0:
                        var ik_tid as int is calling tast.from_ast with c, m, ik_first
                        banish ik_txt
                        if ik_tid > 0:
                            var ik_code as int is calling ctype.type_kind_code with (sigil of c->names), ik_tid
                            return "{ik_code}"
                banish ik_txt
    var ctor_t as int is calling astutil.node_child with ast, node, 0
    var ctor_last as int is calling last_token_deep with ast, ctor_t
    if ctor_last >= 0:
        var ctor_name as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ctor_last
        if ctor_name == "ok_of" or ctor_name == "err_of" or ctor_name == "some":
            var isok as bool is ctor_name == "ok_of"
            var ismay as bool is ctor_name == "some"
            banish ctor_name
            return calling result_ctor with c, node, ast, isok, ismay, -1
        banish ctor_name
    # `calling x.len`/`calling x.length` es acceso a propiedad, no método.
    var tgt_prop as int is calling astutil.node_child with ast, node, 0
    if tgt_prop >= 0 and (calling astutil.kind_of with ast, tgt_prop) == pskind.NodeKind.NdNormalTarget:
        var pl as int is calling last_token_deep with ast, tgt_prop
        if pl >= 0:
            var plname as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), pl
            if plname == "len" or plname == "length":
                # Resolve the whole receiver, not only its first token:
                # `self->items.len` must lower to `(self->items).len`, not
                # `(self).len`.  The old single-token path broke every method
                # that read the length of a nested container.
                #
                # Only built-in containers expose `len` as a C field.  A rune
                # such as `SetString` also has a `len` method; that must fall
                # through to normal method dispatch instead of becoming
                # `s.len` in C.
                var prt as CgTarget is calling resolve_target with c, tgt_prop, ast, true
                defer banish prt.text
                var is_prop as bool is false
                var pcheck as int is prt.type_id
                var pguard as int is 0
                while pcheck > 0 and pguard < 8:
                    var pty1 as tk.SemaType is calling types.at with (sigil of c->program->types), pcheck
                    if pty1.kind == tk.SemaTypeKind.TkList or pty1.kind == tk.SemaTypeKind.TkMap or pty1.kind == tk.SemaTypeKind.TkSlice or pty1.kind == tk.SemaTypeKind.TkMany:
                        set is_prop is true
                        set pcheck is -1
                    else if pty1.kind == tk.SemaTypeKind.TkRef:
                        set pcheck is pty1.a
                        set pguard is pguard + 1
                    else if pty1.kind == tk.SemaTypeKind.TkBase:
                        var pbn as string is calling npool.text with (sigil of c->program->names), pty1.name
                        if pbn == "string":
                            set is_prop is true
                        set pcheck is -1
                    else:
                        set pcheck is -1
                if is_prop:
                    var pop as string is "."
                    if prt.text == "self" and not c->self_value:
                        set pop is "->"
                    else if prt.type_id > 0:
                        var pty2 as tk.SemaType is calling types.at with (sigil of c->program->types), prt.type_id
                        if pty2.kind == tk.SemaTypeKind.TkRef:
                            set pop is "->"
                    if plname == "length":
                        banish plname
                        set plname is calling npool.copy_string with "len"
                    var pvn as string is "({prt.text}){pop}{plname}"
                    banish plname
                    return pvn
            banish plname
    var cname as string is ""
    var method_name as string is ""
    var fslot as int is -1
    # Llamada a un campo que guarda un puntero a función:
    # `calling route.handler with context` se emite `(route.handler)(context)`.
    var fctgt as int is calling astutil.node_child with ast, node, 0
    if fctgt >= 0 and (calling astutil.child_count with ast, fctgt) > 1:
        var fcrt as CgTarget is calling resolve_target with c, fctgt, ast, false
        if fcrt.type_id > 0:
            var fcu as int is calling types.underlying with (sigil of c->program->types), fcrt.type_id
            var fcty as tk.SemaType is calling types.at with (sigil of c->program->types), fcu
            var fcguard as int is 0
            while fcguard < 8 and (fcty.kind == tk.SemaTypeKind.TkRef or fcty.kind == tk.SemaTypeKind.TkFrozen):
                set fcu is fcty.a
                set fcty is calling types.at with (sigil of c->program->types), fcu
                set fcguard is fcguard + 1
            if fcty.kind == tk.SemaTypeKind.TkFn:
                banish cname
                set cname is "({fcrt.text})"
        banish fcrt.text
    # Llamada cualificada `mod.fn`: resolver el alias de import y el catálogo
    # antes de que F3 anote un nombre poco preciso (p. ej. una variable local
    # homónima como `var lex ... is calling pslexer.lex`).
    var qslot as int is -1
    var qname as string is ""
    if tgt_prop >= 0 and (calling astutil.kind_of with ast, tgt_prop) == pskind.NodeKind.NdNormalTarget and (calling astutil.child_count with ast, tgt_prop) >= 2:
        var qbt as int is calling astutil.token_child with ast, tgt_prop, 0
        var qlt as int is calling last_token_deep with ast, tgt_prop
        if qbt >= 0 and qlt >= 0:
            var qatx as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), qbt
            var qlnx as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), qlt
            var qanid as int is calling npool.intern with (sigil of c->program->names), qatx
            var qasid as int is calling symbols.lookup_in_scope with (sigil of c->program->symbols), m.scope, qanid
            if qasid < 0:
                set qasid is calling symbols.lookup_name with (sigil of c->program->symbols), qatx
            if qasid >= 0:
                var qasv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), qasid
                if qasv.kind == sym.SemaSymbolKind.SkImport:
                    var qmid as int is -1
                    var qmi as int is 0
                    while qmi < c->program->modules.len:
                        var qmm as loader.SemaModule is (c->program->modules at qmi)
                        if qmm.scope == qasv.module_scope:
                            set qmid is qmi
                        set qmi is qmi + 1
                    var qlnid as int is calling npool.intern with (sigil of c->program->names), qlnx
                    var qfi as int is 0
                    while qfi < c->catalog.functions.len:
                        var qf as catalog.CgFunction is (c->catalog.functions at qfi)
                        if qf.name == qlnid and not qf.is_method and (qmid < 0 or qf.module == qmid):
                            set qslot is qfi
                            banish qname
                            set qname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), qf.c_name)
                        set qfi is qfi + 1
            banish qatx
            banish qlnx
    # Una función del módulo actual gana a un método primitivo homónimo
    # (`starts_with` local vs `enchanting string.starts_with`).
    var early_slot as int is -1
    var early_name as string is ""
    if tgt_prop >= 0 and (calling astutil.kind_of with ast, tgt_prop) == pskind.NodeKind.NdNormalTarget and (calling astutil.child_count with ast, tgt_prop) == 1:
        var etok as int is calling astutil.token_child with ast, tgt_prop, 0
        if etok >= 0:
            var etxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), etok
            var enid as int is calling npool.intern with (sigil of c->program->names), etxt
            banish etxt
            var efi as int is 0
            while efi < c->catalog.functions.len:
                var ef as catalog.CgFunction is (c->catalog.functions at efi)
                if ef.module == c->current_module and ef.name == enid and not ef.is_method and not ef.is_generic:
                    set early_slot is efi
                    banish early_name
                    set early_name is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), ef.c_name)
                set efi is efi + 1
    var sid as int is calling ann.symbol_of with (sigil of m.annotations), node
    # Si F3 ya anotó una función del catálogo, su nombre C es la verdad y las
    # heurísticas de abajo no deben pisarlo (bugs 8/14).
    var sid_direct as bool is false
    if sid >= 0:
        if calling c->catalog.by_symbol.has with sid:
            var fi as int is calling c->catalog.by_symbol.get with sid
            set fslot is fi
            var ff as catalog.CgFunction is (c->catalog.functions at fi)
            set cname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), ff.c_name)
            if not ff.is_method:
                set sid_direct is true
        else:
            var sv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), sid
            # Un local puede tener un nombre C distinto del fuente (`double` ->
            # `double_`): la llamada debe usar el nombre registrado en el scope
            # C, igual que una referencia en `emit_expr`.
            var lcn as int is calling context.local_c_name with c, sv.name
            if lcn >= 0:
                banish cname
                set cname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), lcn)
            else:
                set cname is calling names.function_name with (sigil of c->names), sv
    if cname == "":
        var target as int is calling astutil.node_child with ast, node, 0
        var last as int is -1
        if target >= 0:
            set last is calling last_token_deep with ast, target
        if last >= 0:
            var lname as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), last
            defer banish lname
            banish cname
            set cname is calling npool.copy_string with lname
            set method_name is calling npool.copy_string with lname
            var nid as int is calling npool.intern with (sigil of c->program->names), lname
            # Llamada cualificada `mod.fn`: resolver por módulo, no por método.
            var qbase_tok as int is calling astutil.token_child with ast, target, 0
            if qbase_tok >= 0:
                var qtxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), qbase_tok
                var qnid as int is calling npool.intern with (sigil of c->program->names), qtxt
                var qsid as int is calling symbols.lookup_in_scope with (sigil of c->program->symbols), m.scope, qnid
                if qsid < 0:
                    set qsid is calling symbols.lookup_name with (sigil of c->program->symbols), qtxt
                # `mod.fn` directo por nombre C (`tally_sum`) aunque `by_name`
                # apunte a un método homónimo (`list_sum`).
                var qexpected as string is "{qtxt}_{lname}"
                var qei as int is 0
                while qei < c->catalog.functions.len:
                    var qef as catalog.CgFunction is (c->catalog.functions at qei)
                    var qec as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), qef.c_name)
                    if qec == qexpected and not qef.is_method and qef.name == nid:
                        set fslot is qei
                        banish cname
                        set cname is qec
                        set qec is ""
                    banish qec
                    set qei is qei + 1
                banish qexpected
                banish qtxt
                if qsid >= 0:
                    var qsv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), qsid
                    if qsv.kind == sym.SemaSymbolKind.SkImport:
                        var qmid as int is -1
                        var qmi as int is 0
                        while qmi < c->program->modules.len:
                            var qmm as loader.SemaModule is (c->program->modules at qmi)
                            if qmm.scope == qsv.module_scope:
                                set qmid is qmi
                            set qmi is qmi + 1
                        if qmid >= 0:
                            var qfi as int is 0
                            while qfi < c->catalog.functions.len:
                                var qf as catalog.CgFunction is (c->catalog.functions at qfi)
                                if qf.module == qmid and qf.name == nid:
                                    set fslot is qfi
                                    banish cname
                                    set cname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), qf.c_name)
                                set qfi is qfi + 1
                            if fslot >= 0:
                                set last is -2
            # Método sobre un receptor: buscar `Tipo_metodo` en el catálogo.
            var rtarget as int is calling astutil.node_child with ast, node, 0
            var rtt0 is calling resolve_target with c, rtarget, ast, true
            if rtt0.type_id >= 0:
                var rct_id as int is rtt0.type_id
                var rct_ty as tk.SemaType is calling types.at with (sigil of c->program->types), rct_id
                var rct_guard as int is 0
                while rct_guard < 16 and (rct_ty.kind == tk.SemaTypeKind.TkRef or rct_ty.kind == tk.SemaTypeKind.TkFrozen or rct_ty.kind == tk.SemaTypeKind.TkAlias or rct_ty.kind == tk.SemaTypeKind.TkSeal):
                    if rct_ty.kind == tk.SemaTypeKind.TkAlias or rct_ty.kind == tk.SemaTypeKind.TkSeal:
                        if rct_ty.b <= 0:
                            break
                        set rct_id is rct_ty.b
                    else:
                        if rct_ty.a <= 0:
                            break
                        set rct_id is rct_ty.a
                    set rct_ty is calling types.at with (sigil of c->program->types), rct_id
                    set rct_guard is rct_guard + 1
                # Un método promovido por `fundere` se declara en el embed: la
                # instancia que hay que buscar es la del campo, no la del host.
                var rct_eff as int is rct_id
                var rct_prom as int is calling cg_promoted_embed_nominal with c, rct_id, nid, 0
                if rct_prom > 0:
                    set rct_eff is rct_prom
                var rctype as string is calling ctype.c_type with (sigil of c->names), rct_id
                # Una instancia tiene prioridad sobre la plantilla `Box_get`.
                var psi as int is 0
                while psi < c->catalog.functions.len:
                    var psf as catalog.CgFunction is (c->catalog.functions at psi)
                    if psf.is_method and psf.is_spec and psf.recv_type == rct_eff and psf.name == nid:
                        set fslot is psi
                        banish cname
                        set cname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), psf.c_name)
                        set psi is c->catalog.functions.len
                    else:
                        set psi is psi + 1
                var mfull as string is "{rctype}_{lname}"
                if fslot < 0:
                    var sfi as int is 0
                    while sfi < c->catalog.functions.len:
                        var sff as catalog.CgFunction is (c->catalog.functions at sfi)
                        var sfn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), sff.c_name)
                        if sfn == mfull:
                            set fslot is sfi
                            banish cname
                            set cname is sfn
                            set sfn is ""
                        banish sfn
                        set sfi is sfi + 1
                banish rctype
                banish mfull
                # Fallback for methods whose C name is not `<CType>_<method>`
                # (`list_sum`, `map_keys_sorted`, bound concept methods...).
                # Prefer a catalog method whose declared receiver type matches
                # the receiver context before falling back to a module function
                # with the same name.
                if fslot < 0:
                    var msi as int is 0
                    while msi < c->catalog.functions.len:
                        var mf as catalog.CgFunction is (c->catalog.functions at msi)
                        if mf.is_method and mf.name == nid:
                            var mfr as bool is mf.recv_type == rct_id
                            if not mfr and mf.recv_type > 0:
                                var mfrt as string is calling ctype.c_type with (sigil of c->names), mf.recv_type
                                if mfrt == rctype:
                                    set mfr is true
                                banish mfrt
                            if mfr:
                                set fslot is msi
                                banish cname
                                set cname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), mf.c_name)
                                set msi is c->catalog.functions.len
                            else:
                                set msi is msi + 1
                        else:
                            set msi is msi + 1
            banish rtt0.text
            if fslot >= 0:
                set last is -2
            if last >= 0 and fslot < 0 and calling c->catalog.by_name.has with nid:
                var fslot0 as int is calling c->catalog.by_name.get with nid
                set fslot is fslot0
                var f0 as catalog.CgFunction is (c->catalog.functions at fslot0)
                banish cname
                set cname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f0.c_name)
            else if fslot < 0:
                var lcopy as string is calling npool.copy_string with lname
                banish cname
                set cname is lcopy
    # Elige la plantilla genérica cuya forma de receptor coincide. `by_name`
    # es global por nombre y puede apuntar a otro tipo (`StringBuilder.is_empty`
    # para un `map`); la firma C sería incompatible.
    var ov_t as int is calling astutil.node_child with ast, node, 0
    if ov_t >= 0:
        var ov_last as int is calling last_token_deep with ast, ov_t
        if ov_last >= 0:
            var ov_txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ov_last
            var ov_nid as int is calling npool.intern with (sigil of c->program->names), ov_txt
            banish ov_txt
            var ov_tgt as CgTarget is calling resolve_target with c, ov_t, ast, true
            defer banish ov_tgt.text
            if ov_tgt.type_id > 0:
                var ov_mi as int is calling generics.find_generic_method with c, ov_nid, ov_tgt.type_id
                if ov_mi >= 0:
                    var ov_si as int is calling generics.ensure_method_spec with c, ov_mi, ov_tgt.type_id, node
                    if ov_si >= 0 and ov_si != fslot:
                        set fslot is ov_si
                        var ov_sf as catalog.CgFunction is (c->catalog.functions at ov_si)
                        banish cname
                        set cname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), ov_sf.c_name)
    # Si `ann.symbol_of` resolvió el símbolo plantilla, `cname` ya es
    # `Box_get`; una instancia debe usar su especialización `Box_get_instN`.
    if cname != "":
        var ot as int is calling astutil.node_child with ast, node, 0
        if ot >= 0:
            var ol as int is calling last_token_deep with ast, ot
            if ol >= 0:
                var otxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ol
                var onid as int is calling npool.intern with (sigil of c->program->names), otxt
                banish otxt
                var ort as CgTarget is calling resolve_target with c, ot, ast, true
                defer banish ort.text
                var orid as int is ort.type_id
                if orid > 0:
                    var orty as tk.SemaType is calling types.at with (sigil of c->program->types), orid
                    while orty.kind == tk.SemaTypeKind.TkRef or orty.kind == tk.SemaTypeKind.TkFrozen:
                        if orty.a <= 0:
                            break
                        set orid is orty.a
                        set orty is calling types.at with (sigil of c->program->types), orid
                    var oi2 as int is 0
                    while oi2 < c->catalog.functions.len:
                        var of2 as catalog.CgFunction is (c->catalog.functions at oi2)
                        if of2.is_method and of2.is_spec and of2.recv_type == orid and of2.name == onid:
                            banish cname
                            set cname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), of2.c_name)
                            set fslot is oi2
                            set oi2 is c->catalog.functions.len
                        else:
                            set oi2 is oi2 + 1
    # Override final para `mod.fn` genéricas: `ann.symbol_of` puede haber
    # resuelto un método homónimo (`sum` → `list_sum`) antes de llegar aquí.
    var qo_t as int is calling astutil.node_child with ast, node, 0
    if qo_t >= 0 and not sid_direct:
        var qo_b as int is calling astutil.token_child with ast, qo_t, 0
        var qo_l as int is calling last_token_deep with ast, qo_t
        if qo_b >= 0 and qo_l >= 0:
            var qo_bt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), qo_b
            var qo_lt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), qo_l
            var qo_exp as string is "{qo_bt}_{qo_lt}"
            var qo_i as int is 0
            while qo_i < c->catalog.functions.len:
                var qo_f as catalog.CgFunction is (c->catalog.functions at qo_i)
                var qo_c as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), qo_f.c_name)
                if qo_c == qo_exp and not qo_f.is_method:
                    set fslot is qo_i
                    banish cname
                    set cname is qo_c
                    set qo_c is ""
                banish qo_c
                set qo_i is qo_i + 1
            banish qo_exp
            banish qo_bt
            banish qo_lt
            if fslot >= 0:
                var qf0 as catalog.CgFunction is (c->catalog.functions at fslot)
                if qf0.is_generic or qf0.tparams.len > 0:
                    var qa0 as list of int is list of int
                    var qargs as int is calling astutil.node_child with ast, node, 2
                    if qargs >= 0:
                        var qan as int is calling astutil.child_count with ast, qargs
                        var qai as int is 0
                        while qai < qan:
                            var qarg as int is calling astutil.node_child with ast, qargs, qai
                            if qarg >= 0:
