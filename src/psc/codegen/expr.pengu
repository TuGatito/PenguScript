                    calling vsb.append with cn3
                    calling vsb.append with "_ensure_unique("
                    calling vsb.append with adt
                    calling vsb.append with "); }))"
                    return calling vsb.finish
                calling vsb.append with "pengu_cow_"
                calling vsb.append with cn3
                if ck3 == 1:
                    if method_name == "is_shared":
                        calling vsb.append with "_is_shared("
                    else:
                        calling vsb.append with "_ref_count("
                    if isref3:
                        calling vsb.append with "*("
                        calling vsb.append with tgt.text
                        calling vsb.append with ")"
                    else:
                        calling vsb.append with tgt.text
                else:
                    if method_name == "is_shared":
                        calling vsb.append with "_is_shared("
                    else:
                        calling vsb.append with "_ref_count("
                    calling vsb.append with adt
                calling vsb.append with ")"
                return calling vsb.finish
        if (is_map_recv or ref_map) and (method_name == "put" or method_name == "get" or method_name == "has" or method_name == "remove" or method_name == "contains" or method_name == "clear"):
            var mt as tk.SemaType is tt
            if ref_map:
                set mt is calling types.at with (sigil of c->program->types), tt.a
            var mrecv as string is "&({tgt.text})"
            if ref_map or (tgt.text == "self" and not c->self_value):
                set mrecv is tgt.text
            if method_name == "clear":
                var csb as StringBuilder is calling StringBuilder.new
                defer banish csb
                calling csb.append with "__extension__(({ "
                if (calling drop.cow_kind_of with c, tgt.type_id) == 3:
                    calling csb.append with "pengu_cow_map_clear("
                else:
                    calling csb.append with "pengu_map_clear("
                calling csb.append with mrecv
                calling csb.append with "); }))"
                return calling csb.finish
            var argm as int is calling astutil.node_child with ast, node, 2
            if argm >= 0:
                var karg as int is calling astutil.node_child with ast, argm, 0
                if karg >= 0 and (calling astutil.kind_of with ast, karg) == pskind.NodeKind.NdPosArg:
                    set karg is calling astutil.node_child with ast, karg, 0
                var kt as string is calling ctype.c_type with (sigil of c->names), mt.a
                var vts as string is calling ctype.c_type with (sigil of c->names), mt.b
                var kz as string is calling emit_expr_as with c, karg, mt.a
                var msb as StringBuilder is calling StringBuilder.new
                defer banish msb
                if method_name == "put":
                    var varg as int is calling astutil.node_child with ast, argm, 1
                    if varg >= 0 and (calling astutil.kind_of with ast, varg) == pskind.NodeKind.NdPosArg:
                        set varg is calling astutil.node_child with ast, varg, 0
                    var vz as string is calling emit_expr_as with c, varg, mt.b
                    calling msb.append with "__extension__(({ "
                    calling msb.append with kt
                    calling msb.append with " _k = "
                    calling msb.append with kz
                    calling msb.append with "; "
                    calling msb.append with vts
                    calling msb.append with " _v = "
                    calling msb.append with vz
                    if (calling drop.cow_kind_of with c, tgt.type_id) == 3:
                        calling msb.append with "; pengu_cow_map_put({mrecv}, &_k, &_v); }))"
                    else:
                        calling msb.append with "; pengu_map_put({mrecv}, &_k, &_v); }))"
                else:
                    calling msb.append with "__extension__(({ "
                    calling msb.append with kt
                    calling msb.append with " _k = "
                    calling msb.append with kz
                    calling msb.append with "; "
                    if method_name == "has" or method_name == "contains":
                        calling msb.append with "pengu_map_contains({mrecv}, &_k); }))"
                    else if method_name == "remove":
                        if (calling drop.cow_kind_of with c, tgt.type_id) == 3:
                            calling msb.append with "pengu_cow_map_remove({mrecv}, &_k); }))"
                        else:
                            calling msb.append with "pengu_map_remove({mrecv}, &_k); }))"
                    else:
                        # `get` es la lectura sin comprobar: si la clave no
                        # está, devuelve el cero del tipo de valor (como `at`).
                        var vtt as tk.SemaType is calling types.at with (sigil of c->program->types), mt.b
                        var vzero as string is "NULL"
                        if vtt.kind != tk.SemaTypeKind.TkRef and vtt.kind != tk.SemaTypeKind.TkFn and vtt.kind != tk.SemaTypeKind.TkOpaque:
                            var zsb as StringBuilder is calling StringBuilder.new
                            defer banish zsb
                            calling zsb.append with "("
                            calling zsb.append with vts
                            calling zsb.append with r"){0}"
                            set vzero is calling zsb.finish
                        var ptmp as string is calling emit.temp with (sigil of c->emitter), "_p"
                        defer banish ptmp
                        defer banish vzero
                        var vpt as string is calling ctype.pointer_type_name with vts
                        defer banish vpt
                        calling msb.append with "void* {ptmp} = pengu_map_get({mrecv}, &_k); {ptmp} ? (*( "
                        calling msb.append with vpt
                        calling msb.append with "){ptmp}) : "
                        calling msb.append with vzero
                        calling msb.append with "; }))"
                banish kt
                banish vts
                banish kz
                return calling msb.finish
        var lt_recv as tk.SemaType is tt
        var list_ref as bool is false
        if tt.kind == tk.SemaTypeKind.TkRef:
            var linner as tk.SemaType is calling types.at with (sigil of c->program->types), tt.a
            if linner.kind == tk.SemaTypeKind.TkList:
                set lt_recv is linner
                set list_ref is true
        if lt_recv.kind == tk.SemaTypeKind.TkList and (method_name == "push" or method_name == "append"):
            var argn as int is calling astutil.node_child with ast, node, 2
            if argn >= 0:
                var farg as int is calling astutil.node_child with ast, argn, 0
                if farg >= 0 and (calling astutil.kind_of with ast, farg) == pskind.NodeKind.NdPosArg:
                    set farg is calling astutil.node_child with ast, farg, 0
                if farg >= 0:
                    var et as string is calling ctype.c_type with (sigil of c->names), lt_recv.a
                    var av as string is calling emit_expr_as with c, farg, lt_recv.a
                    defer banish av
                    defer banish et
                    var psb2 as StringBuilder is calling StringBuilder.new
                    defer banish psb2
                    # Copia propia cuando se inserta un *lugar* cuyo elemento
                    # posee memoria: el contenedor guarda su copia y el dueño
                    # original sigue siendo de quien lo declaró.
                    var pk as pskind.NodeKind is calling astutil.kind_of with ast, farg
                    var isplace as bool is pk == pskind.NodeKind.NdVarRef or pk == pskind.NodeKind.NdFieldAccess or pk == pskind.NodeKind.NdArrowAccess or pk == pskind.NodeKind.NdAtAccess
                    var wrap as string is ""
                    if isplace:
                        var ecwk as int is calling drop.cow_kind_of with c, lt_recv.a
                        if ecwk == 1:
                            set wrap is "pengu_string_share_value"
                        else if ecwk == 2:
                            set wrap is "pengu_list_clone_value"
                    defer banish wrap
                    calling psb2.append with "__extension__(({ "
                    calling psb2.append with et
                    calling psb2.append with " _push_tmp = "
                    if wrap != "":
                        calling psb2.append with wrap
                        calling psb2.append with "("
                        calling psb2.append with av
                        calling psb2.append with ")"
                    else:
                        calling psb2.append with av
                    calling psb2.append with "; "
                    if (calling drop.cow_kind_of with c, tgt.type_id) == 2:
                        calling psb2.append with "pengu_cow_list_push("
                    else:
                        calling psb2.append with "pengu_list_push("
                    if not list_ref:
                        calling psb2.append with "&("
                    calling psb2.append with tgt.text
                    if not list_ref:
                        calling psb2.append with ")"
                    calling psb2.append with ", &_push_tmp); }))"
                    return calling psb2.finish
        if lt_recv.kind == tk.SemaTypeKind.TkList and (method_name == "pop" or method_name == "clear"):
            if method_name == "pop":
                var et as string is calling ctype.c_type with (sigil of c->names), lt_recv.a
                defer banish et
                var psb as StringBuilder is calling StringBuilder.new
                defer banish psb
                calling psb.append with "(*( "
                calling psb.append with et
                if (calling drop.cow_kind_of with c, tgt.type_id) == 2:
                    calling psb.append with "*)pengu_cow_list_pop_val("
                else:
                    calling psb.append with "*)pengu_list_pop_val("
                if not list_ref:
                    calling psb.append with "&("
                calling psb.append with tgt.text
                if not list_ref:
                    calling psb.append with ")"
                calling psb.append with "))"
                return calling psb.finish
            var clr as string is ""
            var clrf as string is "pengu_list_clear"
            if (calling drop.cow_kind_of with c, tgt.type_id) == 2:
                set clrf is "pengu_cow_list_clear"
            if list_ref:
                set clr is "{clrf}({tgt.text})"
            else:
                set clr is "{clrf}(&({tgt.text}))"
            return clr
    # Método promovido sobre un embed genérico: el receptor real es la
    # instancia (`Box__int`), así que la llamada usa su especialización y no el
    # nombre del template.
    var fixnode as int is calling astutil.node_child with ast, node, 0
    if fslot >= 0 and fixnode >= 0:
        var ffx as catalog.CgFunction is (c->catalog.functions at fslot)
        if ffx.is_method and ffx.recv_type > 0:
            var ety as int is calling cg_promoted_embed_type with c, fixnode, ast, ffx.recv_type
            if ety > 0:
                var six as int is -1
                var sci as int is 0
                while sci < c->catalog.functions.len:
                    var scf as catalog.CgFunction is (c->catalog.functions at sci)
                    if scf.is_method and scf.is_spec and scf.recv_type == ety and scf.name == ffx.name:
                        set six is sci
                        set sci is c->catalog.functions.len
                    else:
                        set sci is sci + 1
                if six < 0:
                    set six is calling ensure_instance_method_spec with c, fslot, ety, node
                if six >= 0 and six != fslot:
                    set fslot is six
                    var sfx as catalog.CgFunction is (c->catalog.functions at six)
                    banish cname
                    set cname is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), sfx.c_name)
    var tgtc as int is calling astutil.node_child with ast, node, 0
    if (calling astutil.child_count with ast, tgtc) > 2:
        var chain_call as string is calling chain_call_expr with c, node, ast, cname
        if chain_call != "":
            banish cname
            return chain_call
        banish chain_call
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var tmp_names as list of string is list of string
    var tmp_inits as list of string is list of string
    calling sb.append with cname
    banish cname
    calling sb.append with "("
    var wrote_recv as bool is false
    var fn_params_first as int is -1
    var fn_params_count as int is 0
    if fslot >= 0:
        var fm as catalog.CgFunction is (c->catalog.functions at fslot)
        if fm.symbol >= 0:
            var fsv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), fm.symbol
            if fsv.type > 0:
                var fty as tk.SemaType is calling types.at with (sigil of c->program->types), fsv.type
                if fty.kind == tk.SemaTypeKind.TkFn:
                    var finfo as types.SemaFnInfo is (c->program->types.fn_infos at fty.a)
                    set fn_params_first is finfo.params_first
                    set fn_params_count is finfo.params_count
        if fm.is_method:
            if not fm.is_ritual:
                var target0 as int is calling astutil.node_child with ast, node, 0
                var recv as string is calling method_receiver with c, target0, ast, fm.self_value, fm.recv_type
                calling sb.append with recv
                banish recv
                set wrote_recv is true
    var args as int is calling astutil.node_child with ast, node, 2
    var nfixed as int is fn_params_count
    var has_va as bool is false
    var has_many as bool is false
    var many_elem as int is 0
    var many_slot as int is -1
    if fn_params_count > 0:
        var lp as types.SemaFnParam is (c->program->types.fn_params at (fn_params_first + fn_params_count - 1))
        if lp.type == types.TYPE_ID_CVARARGS:
            set has_va is true
            set nfixed is fn_params_count - 1
        else if lp.type > 0:
            var lpt as tk.SemaType is calling types.at with (sigil of c->program->types), lp.type
            if lpt.kind == tk.SemaTypeKind.TkMany:
                set has_many is true
                set many_elem is lpt.a
                set many_slot is fn_params_count - 1
                set nfixed is fn_params_count - 1
    # `pos_nodes[i]` es el argumento posicional de la ranura i. Los nombrados
    # van en listas paralelas (ranura, nodo): son pocos y sólo se leen.
    var pos_nodes as list of int is list of int
    defer banish pos_nodes
    var named_slots as list of int is list of int
    defer banish named_slots
    var named_nodes as list of int is list of int
    defer banish named_nodes
    var extras as list of int is list of int
    defer banish extras
    var n as int is 0
    if args >= 0:
        set n is calling astutil.child_count with ast, args
    var cm as loader.SemaModule is (c->program->modules at c->current_module)
    var ai as int is 0
    while ai < n:
        var arg as int is calling astutil.node_child with ast, args, ai
        if arg >= 0:
            if (calling astutil.kind_of with ast, arg) == pskind.NodeKind.NdNamedArg:
                var ntxt as string is calling astutil.child_token_text with (sigil of cm.source), (sigil of cm.lex), ast, arg, 0
                var nid as int is calling npool.intern with (sigil of c->program->names), ntxt
                banish ntxt
                var nv as int is calling astutil.node_child with ast, arg, 1
                var sj as int is 0
                while sj < nfixed:
                    var np as types.SemaFnParam is (c->program->types.fn_params at (fn_params_first + sj))
                    if np.name == nid:
                        calling named_slots.push with sj
                        calling named_nodes.push with nv
                    set sj is sj + 1
            else:
                var pv as int is arg
                if (calling astutil.kind_of with ast, arg) == pskind.NodeKind.NdPosArg:
                    set pv is calling astutil.node_child with ast, arg, 0
                if pos_nodes.len < nfixed:
                    calling pos_nodes.push with pv
                else:
                    calling extras.push with pv
        set ai is ai + 1
    # Se emite en orden de declaración: cada ranura recibe su argumento (por
    # posición o por nombre) o su valor por defecto.
    var wrote as bool is wrote_recv
    var si as int is 0
    while si < nfixed:
        var anode as int is -1
        if si < pos_nodes.len:
            set anode is (pos_nodes at si)
        else:
            var sj2 as int is 0
            while sj2 < named_slots.len:
                if (named_slots at sj2) == si:
                    set anode is (named_nodes at sj2)
                set sj2 is sj2 + 1
        var sp as types.SemaFnParam is (c->program->types.fn_params at (fn_params_first + si))
        if anode >= 0:
            if wrote:
                calling sb.append with ", "
            var spty as int is sp.type
            if spty > 0 and fslot >= 0:
                var scfm as catalog.CgFunction is (c->catalog.functions at fslot)
                if scfm.is_spec and scfm.spec_args.len > 0:
                    var spsub as int is calling generics.subst_spec_type_of with c, scfm, spty
                    if spsub > 0:
                        set spty is spsub
            calling push_arg with c, (sigil of sb), (sigil of tmp_names), (sigil of tmp_inits), anode, spty
            set wrote is true
        else:
            if sp.default_node >= 0 and sp.type > 0:
                if wrote:
                    calling sb.append with ", "
                var dvd as string is calling param_default_text with c, fn_params_first + si
                calling sb.append with dvd
                banish dvd
                set wrote is true
        set si is si + 1
    if has_many:
        # El parámetro `many` viaja como `PenguSlice`. Un reenvío (slice, many
        # o array) se adapta; N elementos sueltos se empaquetan en un
        # compound literal C99, sin temporales ni expresiones de sentencia.
        var ety_id as int is many_elem
        if fslot >= 0 and ety_id > 0:
            var ecfm as catalog.CgFunction is (c->catalog.functions at fslot)
            if ecfm.is_spec and ecfm.spec_args.len > 0:
                var esub as int is calling generics.subst_spec_type_of with c, ecfm, ety_id
                if esub > 0:
                    set ety_id is esub
        var ety as string is calling ctype.c_type with (sigil of c->names), ety_id
        if wrote:
            calling sb.append with ", "
        var fwd as bool is false
        var fwd_array as bool is false
        if extras.len == 1:
            var xnode as int is (extras at 0)
            var xty as int is calling node_type with c, xnode
            if xty > 0:
                var xt as tk.SemaType is calling types.at with (sigil of c->program->types), xty
                if xt.kind == tk.SemaTypeKind.TkSlice or xt.kind == tk.SemaTypeKind.TkMany:
                    set fwd is true
                else if xt.kind == tk.SemaTypeKind.TkArray:
                    set fwd is true
                    set fwd_array is true
        if fwd:
            var xv as string is calling emit_expr with c, (extras at 0)
            if fwd_array:
                # La longitud sale del tipo sema: `sizeof(arr)` dentro de una
                # llamada ya es un puntero, no el array.
                var xarr_len as int is 0
                var xty2 as int is calling node_type with c, (extras at 0)
                if xty2 > 0:
                    var xt2 as tk.SemaType is calling types.at with (sigil of c->program->types), xty2
                    set xarr_len is xt2.b
                calling sb.append with "(PenguSlice){ "
                calling sb.append with xv
                calling sb.append with ", "
                if xarr_len > 0:
                    calling sb.append with "{xarr_len}"
                else:
                    calling sb.append with "0"
                calling sb.append with ", sizeof("
                calling sb.append with ety
                calling sb.append with ") }"
            else:
                calling sb.append with xv
            banish xv
        else if extras.len == 0:
            calling sb.append with "(PenguSlice){ 0, 0, sizeof("
            calling sb.append with ety
            calling sb.append with ") }"
        else:
            calling sb.append with "(PenguSlice){ ("
            calling sb.append with ety
            calling sb.append with "[]){ "
            var xi as int is 0
            while xi < extras.len:
                if xi > 0:
                    calling sb.append with ", "
                calling push_arg with c, (sigil of sb), (sigil of tmp_names), (sigil of tmp_inits), (extras at xi), ety_id
                set xi is xi + 1
            calling sb.append with " }, "
            calling sb.append with "{extras.len}"
            calling sb.append with ", sizeof("
            calling sb.append with ety
            calling sb.append with ") }"
        banish ety
    else:
        var xi2 as int is 0
        while xi2 < extras.len:
            if wrote:
                calling sb.append with ", "
            calling push_arg with c, (sigil of sb), (sigil of tmp_names), (sigil of tmp_inits), (extras at xi2), 0
            set wrote is true
            set xi2 is xi2 + 1
    calling sb.append with ")"
    var final as string is calling sb.finish
    if tmp_names->len == 0:
        banish tmp_names
        banish tmp_inits
        return final
    # Envoltorio con expresión de sentencia: los temporales viven lo que la
    # llamada y se liberan justo después, sin cambiar la semántica del lenguaje.
    var ret_void as bool is true
    var ret_c as string is "void"
    if fslot >= 0:
        var wfm as catalog.CgFunction is (c->catalog.functions at fslot)
        if wfm.symbol >= 0:
            var wsv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), wfm.symbol
            if wsv.type > 0:
                var wfty as tk.SemaType is calling types.at with (sigil of c->program->types), wsv.type
                if wfty.kind == tk.SemaTypeKind.TkFn:
                    var wfinfo as types.SemaFnInfo is (c->program->types.fn_infos at wfty.a)
                    var wrty as int is wfinfo.return_type
                    if wfm.is_spec and wfm.spec_args.len > 0:
                        var wsub as int is calling generics.subst_spec_type_of with c, wfm, wrty
                        if wsub > 0:
                            set wrty is wsub
                    if wrty > 0 and wrty != calling types.base with (sigil of c->program->types), "void":
                        set ret_void is false
                        set ret_c is calling ctype.c_type with (sigil of c->names), wrty
    var ws as StringBuilder is calling StringBuilder.new
    defer banish ws
    calling ws.append with "__extension__(({ "
    var wi as int is 0
    while wi < tmp_names->len:
        calling ws.append with "PenguString "
        calling ws.append with (tmp_names at wi)
        calling ws.append with " = "
        calling ws.append with (tmp_inits at wi)
        calling ws.append with "; "
        set wi is wi + 1
    if ret_void:
        calling ws.append with final
        calling ws.append with "; "
    else:
        calling ws.append with ret_c
        calling ws.append with " _p_ret = "
        calling ws.append with final
        calling ws.append with "; "
    set wi is 0
    while wi < tmp_names->len:
        calling ws.append with "pengu_banish_string(&"
        calling ws.append with (tmp_names at wi)
        calling ws.append with "); "
        set wi is wi + 1
    if ret_void:
        calling ws.append with "0; }))"
    else:
        calling ws.append with " _p_ret; }))"
    banish ret_c
    banish final
    var wj as int is 0
    while wj < tmp_names->len:
        var tns as string is (tmp_names at wj)
        banish tns
        var tis as string is (tmp_inits at wj)
        banish tis
        set wj is wj + 1
    banish tmp_names
    banish tmp_inits
    return calling ws.finish

## Texto C del valor por defecto del parámetro global `gidx`.
##
## Los defaults plegados a texto no dependen del AST de la llamada; los demás
## se emiten en el módulo que los declaró.
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave param_default_text with c as ref to context.CgContext, gidx as int into string:
    var p as types.SemaFnParam is (c->program->types.fn_params at gidx)
    # El sema pliega el default a un valor: el codegen no vuelve a tocar el AST
    # del módulo que lo declaró (eso rompía la interpolación y reevaluaba).
    if p.default_kind == types.DEF_INT or p.default_kind == types.DEF_CHAR:
        return "{p.default_i}"
    if p.default_kind == types.DEF_FLOAT:
        if p.default_text >= 0:
            return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), p.default_text)
        return "{p.default_f}"
    if p.default_kind == types.DEF_BOOL:
        if p.default_b:
            return calling npool.copy_string with "true"
        return calling npool.copy_string with "false"
    if p.default_kind == types.DEF_STRING and p.default_name >= 0:
        var sv as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), p.default_name)
        defer banish sv
        var esc as string is calling emit.escape_c with sv
        defer banish esc
        return "pengu_string_from_cstr(\"{esc}\")"
    if p.default_text >= 0:
        return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), p.default_text)
    var saved as int is c->current_module
    set c->current_module is p.default_module
    var txt as string is calling emit_expr_as with c, p.default_node, p.type
    set c->current_module is saved
    return txt

## Tipo de un campo de payload de una variante de omen.
##
## ## Memoria
## O(variantes/campos).
weave omen_payload_field_type with c as ref to context.CgContext, oty as int, vname as int, fname as int into int:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), oty
    if t.kind != tk.SemaTypeKind.TkOmen:
        return -1
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    var i as int is 0
    while i < info.variants_count:
        var v as types.SemaVariant is (c->program->types.variants at (info.variants_first + i))
        if v.name == vname:
            var j as int is 0
            while j < v.payload_count:
                var f as types.SemaField is (c->program->types.fields at (v.payload_first + j))
                if f.name == fname:
                    return f.type
                set j is j + 1
        set i is i + 1
    return -1

## Añade un `#line` al `StringBuilder` de un `judge` en modo valor.
##
## El `judge` en posición de expresión se construye como texto inline (no pasa
## por `emit_judge_core`), así que los marcadores deben insertarse aquí.
##
## ## Memoria
## Strings temporales liberados.
weave judge_append_marker with sb as ref to StringBuilder, m as loader.SemaModule, node as int into void:
    var line as int is calling origin.line_of with m, node
    var path as string is calling emit.escape_c with m.source.path
    defer banish path
    var txt as string is "\n#line {line} \"{path}\"\n"
    calling sb.append with txt
    banish txt

## Emite un `judge` sobre un omen.
##
## ## Memoria
## Strings owned; los payloads se añaden al scope C.
## Emite un `if` usado como expresión con un tipo esperado.
##
## ## Memoria
## Devuelve string owned.
weave if_expr_expected with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, expected as int into string:
    var ic as int is calling astutil.node_child with ast, node, 0
    var it as int is calling astutil.node_child with ast, node, 1
    var ie as int is calling astutil.node_child with ast, node, 2
    var ct as string is calling ctype.c_type with (sigil of c->names), expected
    defer banish ct
    var cn0 as int is ic
    if ic >= 0 and (calling astutil.kind_of with ast, ic) == pskind.NodeKind.NdIfCond:
        set cn0 is calling astutil.node_child with ast, ic, 0
    var cv as string is calling emit_expr with c, cn0
    defer banish cv
    var tv as string is calling emit_expr_as with c, it, expected
    defer banish tv
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "__extension__(({ "
    calling sb.append with ct
    if c->options.family == "cpp":
        calling sb.append with " _pif = {{}}; if ("
    else:
        calling sb.append with r" _pif = {0}; if ("
    calling sb.append with cv
    calling sb.append with ") { _pif = "
    calling sb.append with tv
    calling sb.append with "; }"
    if ie >= 0:
        var ev as string is "0"
        # En `if c then a else b` el else es el valor directo; en el statement
        # viene envuelto y hay que bajar un nivel.
        if (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdIfExpr:
            set ev is calling emit_expr_as with c, ie, expected
        else:
            var eb0 as int is calling astutil.node_child with ast, ie, 0
            if eb0 >= 0:
                if (calling astutil.kind_of with ast, eb0) == pskind.NodeKind.NdIfStmt:
                    set ev is calling if_stmt_value with c, eb0, ast, expected
                else:
                    set ev is calling emit_expr_as with c, eb0, expected
            else:
                set ev is calling emit_expr_as with c, ie, expected
        defer banish ev
        calling sb.append with " else { _pif = "
        calling sb.append with ev
        calling sb.append with "; }"
    calling sb.append with " _pif; }))"
    return calling sb.finish

## Emite un `if` de sentencia usado como valor.
##
## ## Memoria
## Devuelve string owned.
weave if_stmt_value with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, expected as int into string:
    var ic as int is calling astutil.node_child with ast, node, 0
    var it as int is calling astutil.node_child with ast, node, 1
    var ie as int is calling astutil.node_child with ast, node, 2
    var ct as string is calling ctype.c_type with (sigil of c->names), expected
    defer banish ct
    var cn0 as int is ic
    if ic >= 0 and (calling astutil.kind_of with ast, ic) == pskind.NodeKind.NdIfCond:
        set cn0 is calling astutil.node_child with ast, ic, 0
    var cv as string is calling emit_expr with c, cn0
    defer banish cv
    var tv as string is calling emit_expr_as with c, it, expected
    defer banish tv
    var tmp as string is calling emit.temp with (sigil of c->emitter), "_pif"
    defer banish tmp
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "__extension__(({ "
    calling sb.append with ct
    calling sb.append with " "
    calling sb.append with tmp
    if c->options.family == "cpp":
        calling sb.append with " = {{}}; if ("
    else:
        calling sb.append with r" = {0}; if ("
    calling sb.append with cv
    calling sb.append with ") { "
    calling sb.append with tmp
    calling sb.append with " = "
    calling sb.append with tv
    calling sb.append with "; }"
    if ie >= 0:
        var eb0 as int is calling astutil.node_child with ast, ie, 0
        var ev as string is "0"
        if eb0 >= 0:
            if (calling astutil.kind_of with ast, eb0) == pskind.NodeKind.NdIfStmt:
                set ev is calling if_stmt_value with c, eb0, ast, expected
            else:
                set ev is calling emit_expr_as with c, eb0, expected
        else:
            set ev is calling emit_expr_as with c, ie, expected
        defer banish ev
        calling sb.append with " else { "
        calling sb.append with tmp
        calling sb.append with " = "
        calling sb.append with ev
        calling sb.append with "; }"
    calling sb.append with " "
    calling sb.append with tmp
    calling sb.append with "; }))"
    return calling sb.finish

weave judge_expr_c with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, wanted as int into string:
    var subj as int is calling astutil.node_child with ast, node, 0
    var st as int is calling node_type with c, subj
    var rt as int is calling node_type with c, node
    if rt <= 0:
        set rt is wanted
    if rt <= 0:
        set rt is 1
    var stt0 as tk.SemaType is calling types.at with (sigil of c->program->types), st
    # Sujeto `string`: se despacha con la cadena de `if` (no hay `switch`
    # sobre cadenas); `judge_cond_c` emite `pengu_string_equal`.
    var subj_str as bool is false
    if stt0.kind == tk.SemaTypeKind.TkBase:
        var sbnm as string is calling npool.text with (sigil of c->program->names), stt0.name
        if sbnm == "string":
            set subj_str is true
        banish sbnm
    if stt0.kind != tk.SemaTypeKind.TkOmen or not (calling omen_has_layout with c, st):
        var m0 as loader.SemaModule is (c->program->modules at c->current_module)
        var ci0 as int is 0
        var cn0 as int is calling astutil.child_count with ast, node
        while ci0 < cn0:
            var ccl as int is calling astutil.node_child with ast, node, ci0
            if ccl >= 0 and (calling astutil.kind_of with ast, ccl) == pskind.NodeKind.NdWhenClause:
                var cbd as int is calling astutil.node_child with ast, ccl, 3
                if cbd < 0:
                    set cbd is calling astutil.node_child with ast, ccl, 2
                if cbd >= 0:
                    var cbt as int is calling node_type with c, cbd
                    if cbt > 0:
                        set rt is cbt
            set ci0 is ci0 + 1
        var scalar_pref as string is ""
        defer banish scalar_pref
        if stt0.kind == tk.SemaTypeKind.TkOmen:
            var soct as string is calling ctype.c_type with (sigil of c->names), st
            var soap as string is "{soct}_"
            banish soct
            set scalar_pref is soap
        var sub0 as string is calling emit_expr with c, subj
        defer banish sub0
        var rct0 as string is calling ctype.c_type with (sigil of c->names), rt
        defer banish rct0
        var sbn as StringBuilder is calling StringBuilder.new
        defer banish sbn
        var jt0 as string is calling emit.temp with (sigil of c->emitter), "_ji"
        var jr0 as string is calling emit.temp with (sigil of c->emitter), "_jx"
        defer banish jt0
        defer banish jr0
        # Con guardas, un `switch` duplicaría `case`; se emite una cadena de `if`.
        var has_g as bool is subj_str
        var qi as int is 0
        var qn as int is calling astutil.child_count with ast, node
        while qi < qn:
            var qcl as int is calling astutil.node_child with ast, node, qi
            if qcl >= 0 and (calling astutil.kind_of with ast, qcl) == pskind.NodeKind.NdWhenClause:
                var qg as int is calling astutil.node_child with ast, qcl, 2
                if subj_str or (qg >= 0 and (calling astutil.kind_of with ast, qg) == pskind.NodeKind.NdWhenGuard):
                    set has_g is true
            set qi is qi + 1
        if has_g:
            var jm0 as string is calling emit.temp with (sigil of c->emitter), "_jm"
            defer banish jm0
            calling sbn.append with "__extension__(({ "
            calling sbn.append with rct0
            calling sbn.append with " "
            calling sbn.append with jr0
            if c->options.family == "cpp":
                calling sbn.append with " = {{}}; bool "
            else:
                calling sbn.append with r" = {0}; bool "
            calling sbn.append with jm0
            calling sbn.append with " = false; "
            var gi0 as int is 0
            var gn0 as int is calling astutil.child_count with ast, node
            var elseb as int is -1
            while gi0 < gn0:
                var gcl0 as int is calling astutil.node_child with ast, node, gi0
                if gcl0 >= 0:
                    var gk0 as pskind.NodeKind is calling astutil.kind_of with ast, gcl0
                    if gk0 == pskind.NodeKind.NdWhenClause:
                        var gp0 as int is calling astutil.node_child with ast, gcl0, 0
                        var gb0 as int is calling astutil.node_child with ast, gcl0, 3
                        var gg0 as int is calling astutil.node_child with ast, gcl0, 2
                        if gg0 >= 0 and (calling astutil.kind_of with ast, gg0) != pskind.NodeKind.NdWhenGuard:
                            set gg0 is -1
                        if gb0 < 0:
                            set gb0 is calling astutil.node_child with ast, gcl0, 2
                        if gp0 >= 0 and gb0 >= 0:
                            var gc0 as string is calling judge_cond_c with c, st, gp0, ast, sub0
                            var gv0 as string is calling emit_expr_as with c, gb0, rt
                            calling judge_append_marker with (sigil of sbn), m0, gcl0
                            calling sbn.append with "if (!"
                            calling sbn.append with jm0
                            calling sbn.append with " && ("
                            calling sbn.append with gc0
                            calling sbn.append with ")) { if ("
                            if gg0 >= 0:
                                var gnq as int is gg0
                                if (calling astutil.kind_of with ast, gg0) == pskind.NodeKind.NdWhenGuard:
                                    set gnq is calling astutil.node_child with ast, gg0, 0
                                var gq0 as string is calling emit_expr with c, gnq
                                calling sbn.append with gq0
                                banish gq0
                            else:
                                calling sbn.append with "1"
                            calling sbn.append with ") { "
                            calling sbn.append with jr0
                            calling sbn.append with " = "
                            calling sbn.append with gv0
                            calling sbn.append with "; "
                            calling sbn.append with jm0
                            calling sbn.append with " = true; } }"
                            banish gc0
                            banish gv0
                    else if gk0 == pskind.NodeKind.NdElseClause:
                        var eb0 as int is calling astutil.node_child with ast, gcl0, 0
                        if eb0 < 0:
                            set eb0 is gcl0
                        set elseb is eb0
                set gi0 is gi0 + 1
            if elseb >= 0:
                var ev0 as string is calling emit_expr_as with c, elseb, rt
                calling judge_append_marker with (sigil of sbn), m0, elseb
                calling sbn.append with "if (!"
                calling sbn.append with jm0
                calling sbn.append with ") { "
                calling sbn.append with jr0
                calling sbn.append with " = "
                calling sbn.append with ev0
                calling sbn.append with "; } "
                banish ev0
            calling sbn.append with jr0
            calling sbn.append with "; }))"
            return calling sbn.finish
        calling sbn.append with "__extension__(({ int64_t "
        calling sbn.append with jt0
        calling sbn.append with " = (int64_t)("
        calling sbn.append with sub0
        calling sbn.append with "); "
        calling sbn.append with rct0
        calling sbn.append with " "
        calling sbn.append with jr0
        if c->options.family == "cpp":
            calling sbn.append with " = {{}}; switch ("
        else:
            calling sbn.append with r" = {0}; switch ("
        calling sbn.append with jt0
        calling sbn.append with ") "
        calling sbn.append with r"{"
        var ii0 as int is 0
        var has_else0 as bool is false
        var nn0 as int is calling astutil.child_count with ast, node
        while ii0 < nn0:
            var cl0 as int is calling astutil.node_child with ast, node, ii0
            if cl0 >= 0:
                var ck0 as pskind.NodeKind is calling astutil.kind_of with ast, cl0
                if ck0 == pskind.NodeKind.NdWhenClause:
                    var pn0 as int is calling astutil.node_child with ast, cl0, 0
                    var bd0 as int is calling astutil.node_child with ast, cl0, 3
                    if bd0 < 0:
                        set bd0 is calling astutil.node_child with ast, cl0, 2
                    if pn0 >= 0 and bd0 >= 0:
                        var ptok as int is calling last_token_deep with ast, pn0
                        if ptok >= 0:
                            # `when A | B` cae a varios `case` con el mismo cuerpo.
                            calling judge_append_marker with (sigil of sbn), m0, cl0
                            var bv0 as string is calling emit_expr_as with c, bd0, rt
                            var ptn as int is pn0
                            var pcases as bool is false
                            calling sbn.append with ""
                            var pci as int is 0
                            var pmore as bool is true
                            while pmore:
                                var ptk2 as int is calling pattern_variant_token with m0, ast, ptn, pci
                                if ptk2 < 0:
                                    set pmore is false
                                else:
                                    var ptx as string is calling astutil.token_text with (sigil of m0.source), (sigil of m0.lex), ptk2
                                    if ptx != "|":
                                        var pcase as string is calling npool.copy_string with ptx
                                        if stt0.kind == tk.SemaTypeKind.TkOmen:
                                            banish pcase
                                            var ptid as int is calling npool.intern with (sigil of c->program->names), ptx
                                            set pcase is calling omen_variant_c_name with c, st, ptid
                                        calling sbn.append with "case {pcase}: "
                                        set pcases is true
                                        banish pcase
                                    banish ptx
                                    set pci is pci + 1
                            if pcases:
                                calling sbn.append with "{jr0} = {bv0}; break;"
                            banish bv0
                        else:
                            # `true`/`false` no llevan token propio; el patrón es
                            # `when_pattern > true_lit|false_lit`.
                            var pk0 as pskind.NodeKind is calling astutil.kind_of with ast, pn0
                            var pc0 as int is pn0
                            if pk0 == pskind.NodeKind.NdWhenPattern:
                                set pc0 is calling astutil.node_child with ast, pn0, 0
                            if pc0 >= 0:
                                var pk1 as pskind.NodeKind is calling astutil.kind_of with ast, pc0
                                var lit as string is ""
                                if pk1 == pskind.NodeKind.NdTrueLit:
                                    set lit is "true"
                                else if pk1 == pskind.NodeKind.NdFalseLit:
                                    set lit is "false"
                                if lit length > 0:
                                    var bv1 as string is calling emit_expr_as with c, bd0, rt
                                    calling judge_append_marker with (sigil of sbn), m0, cl0
                                    calling sbn.append with "case {lit}: {jr0} = {bv1}; break;"
                                    banish bv1
                else if ck0 == pskind.NodeKind.NdElseClause:
                    var bd1 as int is calling astutil.node_child with ast, cl0, 0
                    if bd1 < 0:
                        set bd1 is cl0
                    var bv1 as string is calling emit_expr_as with c, bd1, rt
                    calling judge_append_marker with (sigil of sbn), m0, cl0
                    calling sbn.append with "default: {jr0} = {bv1}; break;"
                    set has_else0 is true
                    banish bv1
            set ii0 is ii0 + 1
        if not has_else0:
            calling sbn.append with "default: break;"
        calling sbn.append with r"}"
        calling sbn.append with " "
        calling sbn.append with jr0
        calling sbn.append with r"; }))"
        return calling sbn.finish
    var sct as string is calling ctype.c_type with (sigil of c->names), st
    var rct as string is calling ctype.c_type with (sigil of c->names), rt
    defer banish sct
    defer banish rct
    var sub as string is calling emit_expr with c, subj
    defer banish sub
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var stmp as string is calling emit.temp with (sigil of c->emitter), "_j"
    var rtmp as string is calling emit.temp with (sigil of c->emitter), "_jr"
    defer banish stmp
    defer banish rtmp
    calling sb.append with "__extension__(({ "
    calling sb.append with sct
    calling sb.append with " {stmp} = "
    calling sb.append with sub
    calling sb.append with "; "
    calling sb.append with rct
    calling sb.append with " {rtmp} = "
    calling sb.append with r"{0}"
    var has_layout as bool is calling omen_has_layout with c, st
    if has_layout:
        calling sb.append with "; switch ({stmp}.tag) {"
    else:
        calling sb.append with "; switch ({stmp}) {"
    var i as int is 0
    var n as int is calling astutil.child_count with ast, node
    while i < n:
        var cl as int is calling astutil.node_child with ast, node, i
        if cl >= 0 and (calling astutil.kind_of with ast, cl) == pskind.NodeKind.NdWhenClause:
            var pat as int is calling astutil.node_child with ast, cl, 0
            var payload as int is calling astutil.node_child with ast, cl, 1
            var body as int is calling astutil.node_child with ast, cl, 3
            if body < 0:
                set body is calling astutil.node_child with ast, cl, 2
            if pat >= 0 and body >= 0:
                var pv as int is calling last_token_deep with ast, pat
                if pv >= 0:
                    var m as loader.SemaModule is (c->program->modules at c->current_module)
                    var pvt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), pv
                    var pvid2 as int is calling npool.intern with (sigil of c->program->names), pvt
                    var pcase2 as string is calling omen_variant_c_name with c, st, pvid2
                    calling judge_append_marker with (sigil of sb), m, cl
                    calling sb.append with "case {pcase2}: {"
                    if payload >= 0:
                        var pn as int is calling astutil.child_count with ast, payload
                        var pi as int is 0
                        while pi < pn:
                            var pf as int is calling astutil.node_child with ast, payload, pi
                            if pf >= 0:
                                var pft as int is calling astutil.token_child with ast, pf, 0
                                if pft >= 0:
                                    var pfn as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), pft
                                    var pfnid0 as int is calling npool.intern with (sigil of c->program->names), pfn
                                    var pvnt as int is calling npool.intern with (sigil of c->program->names), pvt
                                    var pty as int is calling omen_payload_field_type with c, st, pvnt, pfnid0
                                    if pty < 0:
                                        set pty is 1
                                    var pct as string is calling ctype.c_type with (sigil of c->names), pty
                                    calling sb.append with "{pct} {pfn} = {stmp}.data.{pvt}.{pfn}; (void){pfn}; "
                                    var pnid as int is calling npool.intern with (sigil of c->program->names), pfn
                                    calling context.add_local with c, pnid, pty, pnid
                                    banish pct
                                    banish pfn
                            set pi is pi + 1
                    var bv as string is calling emit_expr_as with c, body, rt
                    calling sb.append with "{rtmp} = "
                    calling sb.append with bv
                    calling sb.append with "; break; }"
                    banish bv
                    banish pvt
                    banish pcase2
        set i is i + 1
    calling sb.append with "default: break; } {rtmp}; }))"
    return calling sb.finish

## Infiere el tipo de un `base at index` sin anotación F3.
##
## ## Memoria
## O(1).
weave infer_at_type with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into int:
    var base as int is calling astutil.node_child with ast, node, 0
    var bt as int is calling guess_type with c, base, ast
    if bt < 0:
        return -1
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), bt
    if t.kind == tk.SemaTypeKind.TkList or t.kind == tk.SemaTypeKind.TkSlice or t.kind == tk.SemaTypeKind.TkArray or t.kind == tk.SemaTypeKind.TkRef:
        return t.a
    return -1

## Envuelve un índice con `pengu_assert_bounds` si los checks están activos.
##
## ## Parámetros
## - `idx`: expresión C del índice.
## - `base`: expresión C del contenedor.
## - `base_type`: `TypeId` del contenedor (puede ser `ref to`).
## - `node`: nodo del acceso, para la ubicación del diagnóstico.
## - `is_ref`: `true` si `base` ya es un puntero al contenedor.
##
## ## Retorno
## La expresión del índice, envuelta o no. String owned.
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave checked_index with c as ref to context.CgContext, idx as string, base as string, base_type as int, node as int, is_ref as bool into string:
    if c->unsafe_depth > 0 or c->options.release_unsafe:
        return calling npool.copy_string with idx
    if base_type <= 0:
        return calling npool.copy_string with idx
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), base_type
    var actual as tk.SemaType is t
    var sep as string is "."
    if t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkFrozen:
        set sep is "->"
        if t.a > 0:
            set actual is calling types.at with (sigil of c->program->types), t.a
    var len_expr as string is ""
    if actual.kind == tk.SemaTypeKind.TkArray:
        if actual.b > 0:
            set len_expr is "{actual.b}"
    else if actual.kind == tk.SemaTypeKind.TkList or actual.kind == tk.SemaTypeKind.TkSlice or actual.kind == tk.SemaTypeKind.TkMany:
        set len_expr is "({base}){sep}len"
    else if actual.kind == tk.SemaTypeKind.TkBase:
        var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), actual.name)
        defer banish bn
        if bn == "string":
            set len_expr is "({base}){sep}len"
    if len_expr == "":
        return calling npool.copy_string with idx
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var line as int is calling origin.line_of with m, node
    var path as string is calling emit.escape_c with m.source.path
    defer banish path
    var tmp as string is calling emit.temp with (sigil of c->emitter), "_p_idx"
    defer banish tmp
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "(__extension__(({ int64_t "
    calling sb.append with tmp
    calling sb.append with " = (int64_t)("
    calling sb.append with idx
    calling sb.append with "); pengu_assert_bounds("
    calling sb.append with tmp
    calling sb.append with ", (int64_t)("
    calling sb.append with len_expr
    calling sb.append with "), \""
    calling sb.append with path
    calling sb.append with ":"
    calling sb.append with (line to string)
    calling sb.append with "\"); "
    calling sb.append with tmp
    calling sb.append with "; })))"
    return calling sb.finish

## Emite una indexación `base at index`.
##
## ## Memoria
## Strings owned.
## Dirección de un elemento de lista/slice (`sigil of (xs at i)`).
##
## Devuelve "" cuando el nodo no es un `at` sobre lista/slice; en ese caso el
## llamador usa `&(expr)` para arrays y punteros.
##
## ## Memoria
## Devuelve string owned.
weave sigil_at_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var atn as int is node
    while atn >= 0 and (calling astutil.kind_of with ast, atn) == pskind.NodeKind.NdParenExpr:
        set atn is calling astutil.node_child with ast, atn, 0
    if atn < 0 or (calling astutil.kind_of with ast, atn) != pskind.NodeKind.NdAtExpr:
        return ""
    var base as int is calling astutil.node_child with ast, atn, 0
    var idx as int is calling astutil.node_child with ast, atn, 1
    if base < 0 or idx < 0:
        return ""
    var bt as int is calling node_type with c, base
    if bt <= 0:
        set bt is calling guess_type with c, base, ast
    if bt <= 0:
        return ""
    var buid as int is calling types.underlying with (sigil of c->program->types), bt
    var bty as tk.SemaType is calling types.at with (sigil of c->program->types), buid
    var sep as string is "."
    var coll as tk.SemaType is bty
    if bty.kind == tk.SemaTypeKind.TkRef:
        set sep is "->"
        if bty.a > 0:
            set coll is calling types.at with (sigil of c->program->types), (calling types.underlying with (sigil of c->program->types), bty.a)
    if coll.kind != tk.SemaTypeKind.TkList and coll.kind != tk.SemaTypeKind.TkSlice:
        return ""
    if coll.a <= 0:
        return ""
    var et as string is calling ctype.c_type with (sigil of c->names), coll.a
    defer banish et
    var bs as string is calling emit_expr with c, base
    defer banish bs
    var ix as string is calling emit_expr with c, idx
    defer banish ix
    var cix as string is calling checked_index with c, ix, bs, bt, node, false
    defer banish cix
    return "((({et}*)(({bs}){sep}data)) + ({cix}))"

weave at_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var base as int is calling astutil.node_child with ast, node, 0
    var idx as int is calling astutil.node_child with ast, node, 1
    var bt as int is calling node_type with c, base
    if bt <= 0:
        set bt is calling guess_type with c, base, ast
    var bs as string is calling emit_expr with c, base
    defer banish bs
    var ix as string is calling emit_expr with c, idx
    defer banish ix
    var is_ref as bool is false
    if bt >= 0:
        var t as tk.SemaType is calling types.at with (sigil of c->program->types), bt
        if t.kind == tk.SemaTypeKind.TkRef:
            set is_ref is true
            if t.a > 0:
                set t is calling types.at with (sigil of c->program->types), t.a
        if c->options.dump_index_types:
            calling dump_index_type with c, m, node, bt, t
        var cix as string is calling checked_index with c, ix, bs, bt, node, is_ref
        defer banish cix
        var amp as string is "&"
        if is_ref:
            set amp is ""
        if t.kind == tk.SemaTypeKind.TkSlice or t.kind == tk.SemaTypeKind.TkMany:
            var set as string is calling ctype.c_type with (sigil of c->names), t.a
            var ssb as StringBuilder is calling StringBuilder.new
            defer banish ssb
            calling ssb.append with "(*( "
            calling ssb.append with set
            calling ssb.append with "*)pengu_slice_at({amp}("
            calling ssb.append with bs
            calling ssb.append with "), (int)("
            calling ssb.append with cix
            calling ssb.append with ")))"
            banish set
            return calling ssb.finish
        if t.kind == tk.SemaTypeKind.TkList:
            var et as string is calling ctype.c_type with (sigil of c->names), t.a
            defer banish et
            var asb as StringBuilder is calling StringBuilder.new
            defer banish asb
            calling asb.append with "(*( "
            calling asb.append with et
            calling asb.append with "*)pengu_list_at({amp}("
            calling asb.append with bs
            calling asb.append with "), (int)("
            calling asb.append with cix
            calling asb.append with ")))"
            return calling asb.finish
        if t.kind == tk.SemaTypeKind.TkMap:
            var kt as string is calling ctype.c_type with (sigil of c->names), t.a
            var vt as string is calling ctype.c_type with (sigil of c->names), t.b
            var vtt as tk.SemaType is calling types.at with (sigil of c->program->types), t.b
            var vzero as string is "NULL"
            if vtt.kind != tk.SemaTypeKind.TkRef and vtt.kind != tk.SemaTypeKind.TkFn and vtt.kind != tk.SemaTypeKind.TkOpaque:
                var zsb as StringBuilder is calling StringBuilder.new
                defer banish zsb
                calling zsb.append with "("
                calling zsb.append with vt
                calling zsb.append with r"){0}"
                set vzero is calling zsb.finish
            var ktmp as string is calling emit.temp with (sigil of c->emitter), "_k"
            var ptmp as string is calling emit.temp with (sigil of c->emitter), "_p"
            defer banish ktmp
            defer banish ptmp
            var vpt2 as string is calling ctype.pointer_type_name with vt
            defer banish vpt2
            var msb as StringBuilder is calling StringBuilder.new
            defer banish msb
            calling msb.append with "__extension__(({ "
            calling msb.append with kt
            calling msb.append with " {ktmp} = "
            calling msb.append with ix
            calling msb.append with "; void* {ptmp} = pengu_map_get({amp}({bs}), &{ktmp}); {ptmp} ? (*( {vpt2}){ptmp}) : {vzero}; }))"
            banish kt
            banish vt
            banish vzero
            return calling msb.finish
        if t.kind == tk.SemaTypeKind.TkBase:
            var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), t.name)
            defer banish bn
            if bn == "string":
                return "pengu_string_char_at({bs}, (int)({cix}))"
    return "({bs})[{ix}]"

## Imprime una línea de `--dump-index-types` para el `at` de `node`.
##
## Formato: `archivo:línea<TAB>tipo receptor<TAB>tipo resultado`.  Lo consume
## el script de migración de F2 para saber qué indexaciones cambian de `string`
## a `char`; no forma parte de la salida del compilador.
##
## ## Memoria
## Strings temporales liberados.
weave dump_index_type with c as ref to context.CgContext, m as loader.SemaModule, node as int, bt as int, t as tk.SemaType into void:
    var recv as string is calling ctype.c_type with (sigil of c->names), bt
    defer banish recv
    var res_id as int is bt
    if t.kind == tk.SemaTypeKind.TkList or t.kind == tk.SemaTypeKind.TkSlice or t.kind == tk.SemaTypeKind.TkMany:
        set res_id is t.a
    else if t.kind == tk.SemaTypeKind.TkMap:
        set res_id is t.b
    if res_id <= 0:
        set res_id is bt
    var res as string is calling ctype.c_type with (sigil of c->names), res_id
    defer banish res
    var line as int is calling origin.line_of with m, node
    var txt as string is "{m.source.path}:{line}\t{recv}\t{res}"
    calling spark.eprintln with txt
    banish txt

## Target resuelto de una llamada: texto C y tipo.
rune CgTarget:
    ## Texto C owned.
    text as string
    ## `TypeId` del receptor.
    type_id as int

## Tipo de un campo nominal.
##
## ## Memoria
## O(campos).
weave cg_field_type with c as ref to context.CgContext, ty as int, fname as int into int:
    if ty < 0:
        return -1
    var cur as int is ty
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), cur
    while t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkFrozen:
        set cur is t.a
        set t is calling types.at with (sigil of c->program->types), cur
    if t.kind != tk.SemaTypeKind.TkRune and t.kind != tk.SemaTypeKind.TkEcho:
        return -1
    var own as int is calling embeds.own_field_type with (sigil of c->program->types), cur, fname
    if own > 0:
        return own
    var prom as int is calling embeds.field_type_at with (sigil of c->program->types), cur, fname
    if prom > 0:
        return prom
    return -1

## Ruta de embeds para `ty.fname`: lista owned de `NameId` (vacía si el campo
## es propio o si no se promociona). El llamador la libera con `banish`.
##
## ## Memoria
## Asigna la lista; liberar con `banish`.
weave cg_field_route with c as ref to context.CgContext, ty as int, fname as int into list of int:
    var out as list of int is list of int
    if ty <= 0:
        return out
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    while t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkFrozen:
        set t is calling types.at with (sigil of c->program->types), t.a
    var ignored as int is calling embeds.route_into with (sigil of c->program->types), ty, fname, (sigil of out), 0
    return out

## Añade a `sb` el camino `.embed`/`->embed` que promociona `fname` en `ty`.
##
## ## Memoria
## Asigna la ruta temporal; no retiene `sb`.
weave append_embed_path with c as ref to context.CgContext, sb as ref to StringBuilder, ty as int, fname as int, sep as string into void:
    var path as list of int is calling cg_field_route with c, ty, fname
    defer banish path
    var i as int is 0
    while i < path.len:
        var seg as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), (path at i))
        calling sb.append with sep
        calling sb.append with seg
        banish seg
        set i is i + 1

## Resuelve un target de llamada y devuelve el receptor (sin el método).
##
## ## Memoria
## Devuelve un `CgTarget` owned; liberar `text` con `banish`.
## Aplica un acceso `at` a un target ya resuelto.
##
## ## Memoria
## Devuelve un `CgTarget` owned; liberar `text`.
weave at_access_target with c as ref to context.CgContext, ch as int, base as string, ty as int, ast as ref to psast.PsAst into CgTarget:
    var ixnode as int is calling astutil.node_child with ast, ch, 0
    if ixnode < 0:
        return with text is (calling npool.copy_string with base), type_id is ty
    var ixt as string is calling emit_expr with c, ixnode
    defer banish ixt
    if ty <= 0:
        return with text is "{base}[{ixt}]", type_id is -1
    var it0 as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var is_ref as bool is it0.kind == tk.SemaTypeKind.TkRef
    var actual as tk.SemaType is it0
    var actual_id as int is ty
    if is_ref and it0.a > 0:
        set actual_id is it0.a
        set actual is calling types.at with (sigil of c->program->types), actual_id
    var cix as string is calling checked_index with c, ixt, base, ty, ch, is_ref
    defer banish cix
    var amp as string is "&"
    if is_ref:
        set amp is ""
    if actual.kind == tk.SemaTypeKind.TkList:
        var el as string is calling ctype.c_type with (sigil of c->names), actual.a
        defer banish el
        var elp as string is calling ctype.pointer_type_name with el
        defer banish elp
        # Escribir un elemento necesita un buffer propio: `at_mut` hace
        # `make_unique` cuando la lista esta compartida (COW).
        if c->writing_target:
            return with text is "(*( {elp})pengu_cow_list_at_mut({amp}({base}), (int)({cix})))", type_id is actual.a
        return with text is "(*( {elp})pengu_list_at({amp}({base}), (int)({cix})))", type_id is actual.a
    if actual.kind == tk.SemaTypeKind.TkSlice or actual.kind == tk.SemaTypeKind.TkMany:
        var sel as string is calling ctype.c_type with (sigil of c->names), actual.a
        defer banish sel
        var selp as string is calling ctype.pointer_type_name with sel
        defer banish selp
        return with text is "(*( {selp})pengu_slice_at({amp}({base}), (int)({cix})))", type_id is actual.a
    if actual.kind == tk.SemaTypeKind.TkArray or actual.kind == tk.SemaTypeKind.TkRef:
        return with text is "{base}[{cix}]", type_id is actual.a
    return with text is "{base}[{cix}]", type_id is actual_id

## Resuelve un target relativo al `with target:` más interno.
##
## El AST de un `with_target` empieza con el nombre del primer campo (o del
## método, si `skip_method`) y sigue con accesos `.campo` / `->campo` / `at`.
##
## ## Memoria
## Devuelve un `CgTarget` owned; liberar `text`.
weave resolve_with_target with c as ref to context.CgContext, target as int, ast as ref to psast.PsAst, skip_method as bool into CgTarget:
    if c->with_targets.len == 0 or c->with_types.len == 0:
        return with text is "NULL", type_id is -1
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var n as int is calling astutil.child_count with ast, target
    var tok as int is calling astutil.token_child with ast, target, 0
    var base as string is calling npool.copy_string with (c->with_targets at (c->with_targets.len - 1))
    var ty as int is (c->with_types at (c->with_types.len - 1))
    if tok < 0:
        return with text is base, type_id is ty
    # `calling .metodo`: el único token es el método; el receptor es el target.
    if skip_method and n == 1:
        return with text is base, type_id is ty
    var ftxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), tok
    var fid as int is calling npool.intern with (sigil of c->program->names), ftxt
    var oldty as int is ty
    set ty is calling cg_field_type with c, oldty, fid
    var sb0 as StringBuilder is calling StringBuilder.new
    defer banish sb0
    calling sb0.append with base
    calling append_embed_path with c, (sigil of sb0), oldty, fid, "."
    calling sb0.append with "."
    calling sb0.append with ftxt
    banish base
    banish ftxt
    set base is calling sb0.finish
    var i as int is 1
    while i < n:
        var ch as int is calling astutil.node_child with ast, target, i
        if ch >= 0:
            var ck as pskind.NodeKind is calling astutil.kind_of with ast, ch
            var is_method as bool is skip_method and (i == n - 1) and (ck == pskind.NodeKind.NdDotAccess or ck == pskind.NodeKind.NdArrowAccess)
            if not is_method:
                if ck == pskind.NodeKind.NdAtAccess:
                    var atr as CgTarget is calling at_access_target with c, ch, base, ty, ast
                    banish base
                    set base is atr.text
                    set ty is atr.type_id
                else:
                    var ft as int is calling astutil.token_child with ast, ch, 0
                    if ft >= 0:
                        var fld as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ft
                        var fid2 as int is calling npool.intern with (sigil of c->program->names), fld
                        set ty is calling cg_field_type with c, ty, fid2
                        var sep as string is "."
                        if ck == pskind.NodeKind.NdArrowAccess:
                            set sep is "->"
                        var nxt3 as string is "{base}{sep}{fld}"
                        banish base
                        banish fld
                        set base is nxt3
        set i is i + 1
    return with text is base, type_id is ty

## Resuelve el target de un `set` (nombre, campo, índice o `with`).
##
## ## Memoria
## Devuelve un `CgTarget` owned; liberar `text`.
weave resolve_target with c as ref to context.CgContext, target as int, ast as ref to psast.PsAst, skip_method as bool into CgTarget:
    if target < 0:
        return with text is "NULL", type_id is -1
    if (calling astutil.kind_of with ast, target) == pskind.NodeKind.NdEssenceTarget:
        var echild as int is calling astutil.node_child with ast, target, 0
        var einner as CgTarget is calling resolve_target with c, echild, ast, false
        if einner.type_id > 0:
            var euid as int is calling types.underlying with (sigil of c->program->types), einner.type_id
            var ety as tk.SemaType is calling types.at with (sigil of c->program->types), euid
            if ety.kind == tk.SemaTypeKind.TkRef:
                var etext as string is "(*( {einner.text}))"
                var ept as int is calling types.strip_frozen with (sigil of c->program->types), ety.a
                banish einner.text
                return with text is etext, type_id is ept
        return einner
    if (calling astutil.kind_of with ast, target) == pskind.NodeKind.NdWithTarget:
        return calling resolve_with_target with c, target, ast, skip_method
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var n as int is calling astutil.child_count with ast, target
    if n <= 0:
        return with text is "NULL", type_id is -1
    var tok as int is calling astutil.token_child with ast, target, 0
    if tok < 0:
        return with text is "NULL", type_id is -1
    var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), tok
    var ty as int is -1
    var base as string is ""
    if txt == "self":
        set base is "self"
        # En una función libre con parámetro `self`, el tipo está en los
        # locales; `c->self_type` solo existe para métodos con receptor.
        var snid as int is calling npool.intern with (sigil of c->program->names), "self"
        var sty as int is calling context.local_type with c, snid
        if sty > 0:
            set ty is sty
        else:
            set ty is c->self_type
    else:
        var nid as int is calling npool.intern with (sigil of c->program->names), txt
        set ty is calling context.local_type with c, nid
        var lc as int is calling context.local_c_name with c, nid
        if lc >= 0:
            set base is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), lc)
        else:
            set base is calling npool.copy_string with txt
    banish txt
    var i as int is 1
    while i < n:
        var ch as int is calling astutil.node_child with ast, target, i
        if ch >= 0:
            var ck as pskind.NodeKind is calling astutil.kind_of with ast, ch
            var is_method as bool is skip_method and (i == n - 1) and (ck == pskind.NodeKind.NdDotAccess or ck == pskind.NodeKind.NdArrowAccess)
            if not is_method:
                if ck == pskind.NodeKind.NdAtAccess:
                    var atr as CgTarget is calling at_access_target with c, ch, base, ty, ast
                    banish base
                    set base is atr.text
                    set ty is atr.type_id
                else:
                    var ft as int is calling astutil.token_child with ast, ch, 0
                    if ft >= 0:
                        var fld as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ft
                        var fid as int is calling npool.intern with (sigil of c->program->names), fld
                        var pt as tk.SemaType is calling types.at with (sigil of c->program->types), ty
                        var handled as bool is false
                        if pt.kind == tk.SemaTypeKind.TkResult and (fld == "value" or fld == "error"):
                            var pid as int is pt.a
                            var sel as string is "ok_val"
                            if fld == "error":
                                set pid is pt.b
                                set sel is "err_val"
                            var pct as string is calling ctype.c_type with (sigil of c->names), pid
                            var pctp as string is calling ctype.pointer_type_name with pct
                            var acc as string is "(*( {pctp})(({base}).{sel}))"
                            banish base
                            banish fld
                            set base is acc
                            set ty is pid
                            set handled is true
                        var mfn as int is -1
                        if not handled and skip_method and i < n - 1 and (ck == pskind.NodeKind.NdDotAccess or ck == pskind.NodeKind.NdArrowAccess):
                            set mfn is calling chain_method_fn with c, ty, fid
                        if mfn >= 0:
                            var mf as catalog.CgFunction is (c->catalog.functions at mfn)
                            var mfs as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), mf.symbol
                            var mft as tk.SemaType is calling types.at with (sigil of c->program->types), mfs.type
                            if mft.kind == tk.SemaTypeKind.TkRef:
                                var mfi as tk.SemaType is calling types.at with (sigil of c->program->types), mft.a
                                if mfi.kind == tk.SemaTypeKind.TkFn:
                                    set mft is mfi
                            var mret as int is ty
                            if mft.kind == tk.SemaTypeKind.TkFn:
                                var mfinfo as types.SemaFnInfo is (c->program->types.fn_infos at mft.a)
                                set mret is mfinfo.return_type
                            var mcname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), mf.c_name)
                            defer banish mcname
                            var mrecv as string is ""
                            if mf.self_value:
                                set mrecv is "{mcname}({base})"
                            else:
                                set mrecv is "{mcname}(&({base}))"
                            banish base
                            banish fld
                            set base is mrecv
                            set ty is mret
                        else if not handled:
                            var oldty as int is ty
                            set ty is calling cg_field_type with c, oldty, fid
                            var sep as string is "."
                            if ck == pskind.NodeKind.NdArrowAccess:
                                set sep is "->"
                            var sb as StringBuilder is calling StringBuilder.new
                            defer banish sb
                            calling sb.append with base
                            # Campo promovido: inserta el camino de embeds.
                            calling append_embed_path with c, (sigil of sb), oldty, fid, sep
                            calling sb.append with sep
                            calling sb.append with fld
                            banish base
                            banish fld
                            set base is calling sb.finish
        set i is i + 1
    return with text is base, type_id is ty

## Tipo nominal (rune/echo) al que apunta `ty` tras quitar `ref`, `frozen`,
## `alias` y `seal`. Devuelve -1 si no es un nominal.
##
## ## Memoria
## No asigna.
weave cg_nominal_of with c as ref to context.CgContext, ty as int into int:
    var cur as int is ty
    var guard as int is 0
    while guard < 32:
        var t as tk.SemaType is calling types.at with (sigil of c->program->types), cur
        if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
            if t.b <= 0:
                return -1
            set cur is t.b
        else if t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkFrozen:
            if t.a <= 0:
                return -1
            set cur is t.a
        else if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho:
            return cur
        else:
            return -1
        set guard is guard + 1
    return -1

## Camino de campos de embed desde `ty` hasta el embed de tipo nominal
## `target`. La lista queda vacía si `target` no es un embed de `ty`.
##
## ## Memoria
## Devuelve una lista owned.
weave cg_embed_path_to with c as ref to context.CgContext, ty as int, target as int, depth as int into list of int:
    var out as list of int is list of int
    if depth > 32:
        return out
    var nom as int is calling cg_nominal_of with c, ty
    if nom < 0:
        return out
    if nom == target:
        return out
    var nt as tk.SemaType is calling types.at with (sigil of c->program->types), nom
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at nt.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + i))
        if (f.flags & types.FIELD_EMBED) != 0:
            var inner as list of int is calling cg_embed_path_to with c, f.type, target, depth + 1
            var found as bool is false
            if (calling cg_nominal_of with c, f.type) == target:
                set found is true
            else if inner.len > 0:
                set found is true
            if found:
                banish out
                calling inner.push with i
                return inner
            banish inner
        set i is i + 1
    return out

## Índice de la info nominal del template de un tipo, o `-1`.
##
## Una instancia genérica (`Box__int`) guarda en `template_info` el índice de la
## info del template (`Box`); un nominal no genérico devuelve su propio índice.
##
## ## Memoria
## No asigna.
weave cg_template_of with c as ref to context.CgContext, ty as int into int:
    var nom as int is calling cg_nominal_of with c, ty
    if nom < 0:
        return -1
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), nom
    if t.a < 0 or t.a >= c->program->types.nominal_infos.len:
        return -1
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    if info.template_info >= 0:
        return info.template_info
    return t.a

## Como `cg_embed_path_to`, pero acepta una instancia genérica por su template.
##
## El sema resuelve un método promovido sobre el tipo **instanciado** del embed
## (`Box__int`), mientras que el catálogo guarda el receptor del **template**
## (`Box of T`). Comparar los índices de template reconoce ambos casos.
##
## ## Memoria
## Devuelve una lista owned de índices de campo.
weave cg_embed_path_soft with c as ref to context.CgContext, ty as int, target as int, depth as int into list of int:
    var out as list of int is list of int
    if depth > 32:
        return out
    var exact as list of int is calling cg_embed_path_to with c, ty, target, 0
    if exact.len > 0:
        banish out
        return exact
    banish exact
    var nom as int is calling cg_nominal_of with c, ty
    if nom < 0:
        return out
    var want as int is calling cg_template_of with c, target
    var nt as tk.SemaType is calling types.at with (sigil of c->program->types), nom
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at nt.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + i))
        if (f.flags & types.FIELD_EMBED) != 0:
            var fhom as int is calling cg_nominal_of with c, f.type
            if fhom >= 0 and want >= 0 and (calling cg_template_of with c, f.type) == want:
                banish out
                var one as list of int is list of int
                calling one.push with i
                return one
            var inner as list of int is calling cg_embed_path_soft with c, f.type, target, depth + 1
            if inner.len > 0:
                banish out
                calling inner.push with i
                return inner
            banish inner
        set i is i + 1
    return out

## Nominal del embed que declara el método `nid`, buscando en profundidad.
##
## Devuelve el tipo **instanciado** del campo embed (por ejemplo `Box__int`),
## que es el receptor real de un método promovido.
##
## ## Memoria
## No asigna.
weave cg_promoted_embed_nominal with c as ref to context.CgContext, host as int, nid as int, depth as int into int:
    if host <= 0 or nid < 0 or depth > 32:
        return -1
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), host
    if t.a < 0 or t.a >= c->program->types.nominal_infos.len:
        return -1
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + i))
        if (f.flags & types.FIELD_EMBED) != 0:
            var e as int is calling cg_nominal_of with c, f.type
            if e > 0:
                if (calling symbols.lookup_method with (sigil of c->program->symbols), e, nid) >= 0:
                    return e
                var deeper as int is calling cg_promoted_embed_nominal with c, e, nid, depth + 1
                if deeper > 0:
                    return deeper
        set i is i + 1
    return -1

## Especializa un método cuyo receptor es una instancia genérica.
##
## `ensure_method_spec` infiere los argumentos del call site; cuando el
## receptor ya es una instancia (`Box__int`), los argumentos del tipo son la
## fuente correcta (`spec_args_for_call` no siempre los deduce).
##
## ## Memoria
## Puede añadir una `CgFunction`; devuelve su índice.
weave ensure_instance_method_spec with c as ref to context.CgContext, base_idx as int, recv_id as int, node as int into int:
    if base_idx < 0:
        return base_idx
    var bf as catalog.CgFunction is (c->catalog.functions at base_idx)
    if bf.is_method and bf.is_generic and not bf.is_spec and bf.tparams.len > 0:
        var iargs as list of int is calling generics.type_args_of with c, recv_id
        if iargs.len == bf.tparams.len:
            var sii as int is calling generics.add_method_spec with c, base_idx, recv_id, iargs
            banish iargs
            if sii >= 0:
                return sii
            return base_idx
        banish iargs
    return calling generics.ensure_method_spec with c, base_idx, recv_id, node

## Tipo del embed que declara el método `want`, visto desde el receptor.
##
## Devuelve el `TypeId` del campo embed al final del camino (una instancia
## genérica, si el embed lo es), o `-1` si el método no se promueve.
##
## ## Memoria
## Libera el `CgTarget` y la lista del camino.
weave cg_promoted_embed_type with c as ref to context.CgContext, recv_node as int, ast as ref to psast.PsAst, want as int into int:
    if recv_node < 0 or want <= 0:
        return -1
    var rt as CgTarget is calling resolve_target with c, recv_node, ast, true
    defer banish rt.text
    var host as int is calling cg_nominal_of with c, rt.type_id
    if host <= 0:
        return -1
    var path as list of int is calling cg_embed_path_soft with c, host, want, 0
    defer banish path
    if path.len == 0:
        return -1
    var cur as int is host
    var pi as int is 0
    var last as int is -1
    while pi < path.len:
        var ct as tk.SemaType is calling types.at with (sigil of c->program->types), cur
        var cinfo as types.SemaNominalInfo is (c->program->types.nominal_infos at ct.a)
        var fld as types.SemaField is (c->program->types.fields at (cinfo.fields_first + (path at pi)))
        set last is fld.type
        var nxt as int is calling cg_nominal_of with c, fld.type
        if nxt > 0:
            set cur is nxt
        set pi is pi + 1
    return last

## `true` si el receptor `rt` es un puntero en C.
##
## ## Memoria
## No asigna.
weave receiver_is_pointer with c as ref to context.CgContext, rt as CgTarget, self_value as bool into bool:
    if rt.text == "self" and not self_value:
        return true
    if rt.type_id > 0:
        var t as tk.SemaType is calling types.at with (sigil of c->program->types), rt.type_id
        if t.kind == tk.SemaTypeKind.TkRef:
            return true
    return false

## Texto C del receptor de una llamada a método.
##
## El target de una llamada es un `normal_target` con un token base y una
## secuencia de accesos (`arrow_access`, `dot_access`). El último acceso es el
## nombre del método; el resto forma el receptor (`self->_blocks`).
##
## ## Memoria
## Devuelve string owned.
weave method_receiver with c as ref to context.CgContext, target as int, ast as ref to psast.PsAst, self_value as bool, recv_type as int into string:
    var rt as CgTarget is calling resolve_target with c, target, ast, true
    defer banish rt.text
    # Método promovido por `fundere`: el receptor es el campo del embed.
    var isptr as bool is calling receiver_is_pointer with c, rt, self_value
    if rt.type_id > 0:
        var host as int is calling cg_nominal_of with c, rt.type_id
        if host > 0:
            var path as list of int is calling cg_embed_path_soft with c, host, recv_type, 0
            if path.len > 0:
                var sb as StringBuilder is calling StringBuilder.new
                defer banish sb
                calling sb.append with "&("
                calling sb.append with rt.text
                var sep as string is "."
                if isptr:
                    set sep is "->"
                var cur as int is host
                var pi as int is 0
                while pi < path.len:
                    var ct as tk.SemaType is calling types.at with (sigil of c->program->types), cur
                    var cinfo as types.SemaNominalInfo is (c->program->types.nominal_infos at ct.a)
                    var fld as types.SemaField is (c->program->types.fields at (cinfo.fields_first + (path at pi)))
                    var fname as string is calling npool.text with (sigil of c->program->names), fld.name
                    calling sb.append with sep
                    calling sb.append with fname
                    set sep is "."
                    var nxt as int is calling cg_nominal_of with c, fld.type
                    if nxt > 0:
                        set cur is nxt
                    set pi is pi + 1
                calling sb.append with ")"
                banish path
                return calling sb.finish
            banish path
    if self_value or rt.text == "self":
        return calling npool.copy_string with rt.text
    if rt.type_id >= 0:
        var t as tk.SemaType is calling types.at with (sigil of c->program->types), rt.type_id
        if t.kind == tk.SemaTypeKind.TkRef:
            # El receptor ya es un puntero; no hay que tomar su dirección.
            # Su destino puede ser un alias del tipo del método (`ref to
            # portus.Response` con el método definido en `Response`), así que
            # se resuelve el alias antes de comparar.
            var inner as int is t.a
            var g as int is 0
            while g < 16:
                var it as tk.SemaType is calling types.at with (sigil of c->program->types), inner
                if it.kind == tk.SemaTypeKind.TkAlias or it.kind == tk.SemaTypeKind.TkSeal:
                    if it.b <= 0:
                        break
                    set inner is it.b
                else if it.kind == tk.SemaTypeKind.TkFrozen:
                    if it.a <= 0:
                        break
                    set inner is it.a
                else:
                    break
                set g is g + 1
            if inner == recv_type:
                return calling npool.copy_string with rt.text
    return "&({rt.text})"

## Añade al texto de un receptor el camino del embed que declara el método.
##
## Devuelve `base` tal cual cuando el método es propio del receptor; cuando el
## método viene de un embed promovido por `fundere`, devuelve
## `base.embed...` (`base->embed...` si `base` es un puntero). Es el punto que
## comparten el `get_<metodo>` de `@mutates` y la asignación de vuelta.
##
## ## Memoria
## Devuelve string owned.
weave with_embed_path with c as ref to context.CgContext, base as string, base_ty as int, want as int, isptr as bool into string:
    var host as int is calling cg_nominal_of with c, base_ty
    var wty as int is calling cg_nominal_of with c, want
    if host <= 0 or wty <= 0:
        return calling npool.copy_string with base
    var path as list of int is calling cg_embed_path_soft with c, host, wty, 0
    if path.len == 0:
        banish path
        return calling npool.copy_string with base
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with base
    var sep as string is "."
    if isptr:
        set sep is "->"
    var cur as int is host
    var pi as int is 0
    while pi < path.len:
        var ct as tk.SemaType is calling types.at with (sigil of c->program->types), cur
        var cinfo as types.SemaNominalInfo is (c->program->types.nominal_infos at ct.a)
        var fld as types.SemaField is (c->program->types.fields at (cinfo.fields_first + (path at pi)))
        var fname as string is calling npool.text with (sigil of c->program->names), fld.name
        calling sb.append with sep
        calling sb.append with fname
        set sep is "."
        var nxt as int is calling cg_nominal_of with c, fld.type
        if nxt > 0:
            set cur is nxt
        set pi is pi + 1
    banish path
    return calling sb.finish

## Expande la forma pura `get_<metodo>` de un método `@mutates`.
##
## El alias semántico lleva `SYM_GET_ALIAS` + `alias_of`; no existe en el
## catálogo como función C. Se emite una copia del receptor, la llamada mutante
## sobre la copia y el valor copiado.
##
## ## Memoria
## Devuelve string owned o `""` si no es un alias.
weave get_alias_call with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var sid as int is calling ann.symbol_of with (sigil of m.annotations), node
    if sid <= 0:
        # En contextos sin anotación (p. ej. inicializadores `with`), resolver
        # el método por el último token del target y el tipo del receptor.
        var gtgt as int is calling astutil.node_child with ast, node, 0
        if gtgt >= 0:
            var glast as int is calling last_token_deep with ast, gtgt
            if glast >= 0:
                var gtxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), glast
                var gnid as int is calling npool.intern with (sigil of c->program->names), gtxt
                banish gtxt
                var grt as CgTarget is calling resolve_target with c, gtgt, ast, true
                defer banish grt.text
                var grty as int is grt.type_id
                var gguard2 as int is 0
                while gguard2 < 16 and grty > 0:
                    var gtt as tk.SemaType is calling types.at with (sigil of c->program->types), grty
                    if gtt.kind == tk.SemaTypeKind.TkRef or gtt.kind == tk.SemaTypeKind.TkFrozen:
                        if gtt.a <= 0:
                            break
                        set grty is gtt.a
                    else if gtt.kind == tk.SemaTypeKind.TkAlias or gtt.kind == tk.SemaTypeKind.TkSeal:
                        if gtt.b <= 0:
                            break
                        set grty is gtt.b
                    else:
                        break
                    set gguard2 is gguard2 + 1
                if grty > 0:
                    set sid is calling symbols.lookup_method with (sigil of c->program->symbols), grty, gnid
    if sid <= 0:
        return ""
    var sv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), sid
    if (sv.flags & sym.SYM_GET_ALIAS) == 0 or sv.alias_of < 0:
        return ""
    if not (calling c->catalog.by_symbol.has with sv.alias_of):
        return ""
    var fi as int is calling c->catalog.by_symbol.get with sv.alias_of
    var fm as catalog.CgFunction is (c->catalog.functions at fi)
    var tgt as int is calling astutil.node_child with ast, node, 0
    if tgt < 0:
        return ""
    var rt as CgTarget is calling resolve_target with c, tgt, ast, true
    defer banish rt.text
    var recv_ty as int is rt.type_id
    if recv_ty <= 0:
        var rb0 as int is calling astutil.node_child with ast, tgt, 0
        if rb0 >= 0:
            set recv_ty is calling node_type with c, rb0
    if recv_ty <= 0:
        return ""
    var guard as int is 0
    while guard < 16:
        var rty as tk.SemaType is calling types.at with (sigil of c->program->types), recv_ty
        if rty.kind == tk.SemaTypeKind.TkRef:
            set recv_ty is rty.a
        else if rty.kind == tk.SemaTypeKind.TkAlias or rty.kind == tk.SemaTypeKind.TkSeal:
            set recv_ty is rty.b
        else:
            break
        set guard is guard + 1
    # El método base puede ser una plantilla genérica; usar su especialización
    # para el receptor concreto (`int_min_with`, no `Forma_min_with`). Si el
    # método se promueve por `fundere`, el receptor de la especialización es el
    # tipo del embed, no el del host.
    var eff_ty as int is recv_ty
    var gnode0 as int is calling astutil.node_child with ast, node, 0
    if gnode0 >= 0 and fm.recv_type > 0:
        var gembed as int is calling cg_promoted_embed_type with c, gnode0, ast, fm.recv_type
        if gembed > 0:
            set eff_ty is gembed
    if fm.is_generic and fm.tparams.len > 0:
        var gspec as int is calling ensure_instance_method_spec with c, fi, eff_ty, node
        if gspec >= 0:
            set fm is (c->catalog.functions at gspec)
    var gsi as int is 0
    while gsi < c->catalog.functions.len:
        var gsf as catalog.CgFunction is (c->catalog.functions at gsi)
        if gsf.is_method and gsf.name == fm.name and gsf.recv_type == eff_ty:
            set fm is gsf
            set gsi is c->catalog.functions.len
        else:
            set gsi is gsi + 1
    # La copia temporal es del tipo del receptor del método: cuando el método
    # viene de un embed promovido, es el embed (no el host).
    var holder_ty as int is recv_ty
    if fm.recv_type > 0:
        set holder_ty is fm.recv_type
    if fm.is_spec:
        var hmat as int is calling generics.receiver_type_of with c, fm
        if hmat > 0:
            set holder_ty is hmat
    var ct as string is calling ctype.c_type with (sigil of c->names), holder_ty
    defer banish ct
    var cname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), fm.c_name)
    defer banish cname
    var pf_first as int is -1
    var pf_count as int is 0
    var ret_void as bool is false
    var fsv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), fm.symbol
    if fsv.type > 0:
        var fty as tk.SemaType is calling types.at with (sigil of c->program->types), fsv.type
        if fty.kind == tk.SemaTypeKind.TkFn:
            var finfo as types.SemaFnInfo is (c->program->types.fn_infos at fty.a)
            set pf_first is finfo.params_first
            set pf_count is finfo.params_count
            var rty0 as tk.SemaType is calling types.at with (sigil of c->program->types), finfo.return_type
            if rty0.kind == tk.SemaTypeKind.TkVoid:
                set ret_void is true
    var tmp as string is calling emit.temp with (sigil of c->emitter), "_get"
    defer banish tmp
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "__extension__(({ "
    calling sb.append with ct
    calling sb.append with " "
    calling sb.append with tmp
    calling sb.append with " = "
    var fixed as string is calling with_embed_path with c, rt.text, recv_ty, fm.recv_type, (calling receiver_is_pointer with c, rt, fm.self_value)
    defer banish fixed
    calling sb.append with fixed
    calling sb.append with "; "
    if not ret_void:
        calling sb.append with tmp
        calling sb.append with " = "
    calling sb.append with cname
    calling sb.append with "("
    if fm.is_method and not fm.is_ritual:
        if not fm.self_value:
            calling sb.append with "&"
        calling sb.append with tmp
    var args as int is calling astutil.node_child with ast, node, 2
    if args >= 0:
        var i as int is 0
        var n as int is calling astutil.child_count with ast, args
        while i < n:
            if i > 0 or (fm.is_method and not fm.is_ritual):
                calling sb.append with ", "
            var arg as int is calling astutil.node_child with ast, args, i
            if arg >= 0:
                var v as int is arg
                if (calling astutil.kind_of with ast, arg) == pskind.NodeKind.NdPosArg:
                    set v is calling astutil.node_child with ast, arg, 0
                var av as string is ""
                if i < pf_count:
                    var p as types.SemaFnParam is (c->program->types.fn_params at (pf_first + i))
                    if p.type > 0 and p.type != types.TYPE_ID_CVARARGS:
                        set av is calling emit_expr_as with c, v, p.type
                    else:
                        set av is calling emit_expr with c, v
                else:
                    set av is calling emit_expr with c, v
                calling sb.append with av
                banish av
            set i is i + 1
    calling sb.append with "); "
    calling sb.append with tmp
    calling sb.append with "; }))"
    return calling sb.finish

## Texto de una ruta cualificada (`mod.Type`) en un target de acceso.
##
## ## Memoria
## Devuelve string owned.
weave dotted_path_text with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    if node < 0:
        return ""
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var k as pskind.NodeKind is calling astutil.kind_of with ast, node
    if k == pskind.NodeKind.NdVarRef:
        var t as int is calling astutil.token_child with ast, node, 0
        if t >= 0:
            return calling astutil.token_text with (sigil of m.source), (sigil of m.lex), t
        return ""
    if k == pskind.NodeKind.NdFieldAccess:
        var b as int is calling astutil.node_child with ast, node, 0
        var ft as int is calling astutil.token_child with ast, node, 1
        var bp as string is calling dotted_path_text with c, b, ast
        defer banish bp
        if ft >= 0:
            var fn as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ft
            defer banish fn
            return "{bp}.{fn}"
        return bp
    return ""

## Busca la función de catálogo de un método para un receptor y nombre.
##
## ## Memoria
## O(n) sobre el catálogo; no asigna salvo strings temporales.
weave chain_method_fn with c as ref to context.CgContext, recv as int, name as int into int:
    var rct as int is recv
    var ty as tk.SemaType is calling types.at with (sigil of c->program->types), rct
    var guard as int is 0
    while guard < 16 and (ty.kind == tk.SemaTypeKind.TkRef or ty.kind == tk.SemaTypeKind.TkFrozen or ty.kind == tk.SemaTypeKind.TkAlias or ty.kind == tk.SemaTypeKind.TkSeal):
        if ty.kind == tk.SemaTypeKind.TkAlias or ty.kind == tk.SemaTypeKind.TkSeal:
            if ty.b <= 0:
                break
            set rct is ty.b
        else:
            if ty.a <= 0:
                break
            set rct is ty.a
        set ty is calling types.at with (sigil of c->program->types), rct
        set guard is guard + 1
    var i as int is 0
    while i < c->catalog.functions.len:
        var fm as catalog.CgFunction is (c->catalog.functions at i)
        if fm.is_method and fm.is_spec and fm.recv_type == rct and fm.name == name:
            return i
        set i is i + 1
    set i is 0
    while i < c->catalog.functions.len:
        var fm2 as catalog.CgFunction is (c->catalog.functions at i)
        if fm2.is_method and fm2.recv_type == rct and fm2.name == name:
            return i
        set i is i + 1
    var cty as string is calling ctype.c_type with (sigil of c->names), rct
    defer banish cty
    var ntxt as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), name)
    defer banish ntxt
    var full as string is "{cty}_{ntxt}"
    defer banish full
    set i is 0
    while i < c->catalog.functions.len:
        var fm3 as catalog.CgFunction is (c->catalog.functions at i)
        var fname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), fm3.c_name)
        if fm3.is_method and fname == full:
            banish fname
            return i
        banish fname
        set i is i + 1
    return -1

## Busca la función de catálogo de un pipe por nombre.
##
## ## Memoria
## O(n) sobre el catálogo.
weave chain_pipe_fn with c as ref to context.CgContext, name as int into int:
    var i as int is 0
    while i < c->catalog.functions.len:
        var fm as catalog.CgFunction is (c->catalog.functions at i)
        if (not fm.is_method) and fm.name == name:
            return i
        set i is i + 1
    return -1

## Emite una cadena de métodos o pipes con temporales.
##
## ## Memoria
## Devuelve string owned; libera temporales de strings.
## Emite una cadena de métodos de un `calling` con target multi-acceso.
##
## El target conserva la forma `base.a.b`; los accesos intermedios ya están
## anotados por sema. Cada uno se evalúa en un temporal para no devolver
## punteros a temporales de statement-expressions anidadas.
##
## ## Memoria
## Devuelve string owned o `""` si no se puede bajar.
## Tipo de receptor declarado por el primer método con nombre `nm`.
##
## ## Memoria
## O(funciones), no asigna.
weave chain_method_recv with c as ref to context.CgContext, nm as int into int:
    var i as int is 0
    while i < c->catalog.functions.len:
        var f as catalog.CgFunction is (c->catalog.functions at i)
        if f.is_method and f.name == nm:
            return f.recv_type
        set i is i + 1
    return -1

weave chain_call_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, cname as string into string:
    var target as int is calling astutil.node_child with ast, node, 0
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var btok as int is calling astutil.token_child with ast, target, 0
    if btok < 0:
        return ""
    var bval as string is calling astutil.child_token_text with (sigil of m.source), (sigil of m.lex), ast, target, 0
    defer banish bval
    var first_op as int is calling astutil.node_child with ast, target, 1
    var first_nt as int is calling astutil.token_child with ast, first_op, 0
    var first_txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), first_nt
    var first_nm as int is calling npool.intern with (sigil of c->program->names), first_txt
    banish first_txt
    var bty as int is calling chain_method_recv with c, first_nm
    if bty <= 0:
        return ""
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var bcty as string is calling ctype.c_type with (sigil of c->names), bty
    defer banish bcty
    calling sb.append with "__extension__(({ "
    calling sb.append with bcty
    calling sb.append with " _ch0 = "
    calling sb.append with bval
    calling sb.append with "; "
    var cur_type as int is bty
    var cur_name as string is "_ch0"
    var n as int is calling astutil.child_count with ast, target
    var i as int is 1
    while i < n - 1:
        var op as int is calling astutil.node_child with ast, target, i
        if op < 0:
            return ""
        var ntok as int is calling astutil.token_child with ast, op, 0
        var ntxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ntok
        var nm as int is calling npool.intern with (sigil of c->program->names), ntxt
        banish ntxt
        var fn as int is calling chain_method_fn with c, cur_type, nm
        if fn < 0:
            return ""
        var fm as catalog.CgFunction is (c->catalog.functions at fn)
        var cn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), fm.c_name)
        defer banish cn
        var nty as int is calling guess_type with c, op, ast
        if nty <= 0:
            set nty is bty
        var ncty as string is calling ctype.c_type with (sigil of c->names), nty
        defer banish ncty
        var nmn as string is "_ch{i}"
        calling sb.append with ncty
        calling sb.append with " "
        calling sb.append with nmn
        calling sb.append with " = "
        calling sb.append with cn
        calling sb.append with "("
        if fm.self_value:
            calling sb.append with cur_name
        else:
            calling sb.append with "&("
            calling sb.append with cur_name
            calling sb.append with ")"
        calling sb.append with "); "
        set cur_type is nty
        set cur_name is nmn
        set i is i + 1
    var fop as int is calling astutil.node_child with ast, target, n - 1
    var fnt as int is calling astutil.token_child with ast, fop, 0
    var ftxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), fnt
    var fnm as int is calling npool.intern with (sigil of c->program->names), ftxt
    banish ftxt
    var fnf as int is calling chain_method_fn with c, cur_type, fnm
    if fnf < 0:
        return ""
    var fmf as catalog.CgFunction is (c->catalog.functions at fnf)
    calling sb.append with cname
    calling sb.append with "("
    if fmf.self_value:
        calling sb.append with cur_name
    else:
        calling sb.append with "&("
        calling sb.append with cur_name
        calling sb.append with ")"
    var args as int is calling astutil.node_child with ast, node, 2
    if args >= 0:
        var ac as int is calling astutil.child_count with ast, args
        var ai as int is 0
        while ai < ac:
            var an as int is calling astutil.node_child with ast, args, ai
            if an >= 0:
                var avn as int is an
                if (calling astutil.kind_of with ast, an) == pskind.NodeKind.NdPosArg:
                    set avn is calling astutil.node_child with ast, an, 0
                var av as string is calling emit_expr with c, avn
                defer banish av
                calling sb.append with ", "
                calling sb.append with av
            set ai is ai + 1
    var frets as tk.SemaType is calling types.at with (sigil of c->program->types), (calling symbols.symbol_at with (sigil of c->program->symbols), fmf.symbol).type
    if frets.kind == tk.SemaTypeKind.TkRef:
        var finner as tk.SemaType is calling types.at with (sigil of c->program->types), frets.a
        if finner.kind == tk.SemaTypeKind.TkFn:
            set frets is finner
    var fvoid as bool is false
    if frets.kind == tk.SemaTypeKind.TkFn:
        var finfo as types.SemaFnInfo is (c->program->types.fn_infos at frets.a)
        if finfo.return_type == calling types.base with (sigil of c->program->types), "void":
            set fvoid is true
    if fvoid:
        calling sb.append with "); "
        calling sb.append with cur_name
        calling sb.append with "; }))"
    else:
        calling sb.append with "); }))"
    return calling sb.finish

weave chain_fn_void with c as ref to context.CgContext, fidx as int into bool:
    var fm as catalog.CgFunction is (c->catalog.functions at fidx)
    var fs as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), fm.symbol
    var ft as tk.SemaType is calling types.at with (sigil of c->program->types), fs.type
    if ft.kind == tk.SemaTypeKind.TkRef:
        var fi as tk.SemaType is calling types.at with (sigil of c->program->types), ft.a
        if fi.kind == tk.SemaTypeKind.TkFn:
            set ft is fi
    if ft.kind == tk.SemaTypeKind.TkFn:
        var info as types.SemaFnInfo is (c->program->types.fn_infos at ft.a)
        return info.return_type == calling types.base with (sigil of c->program->types), "void"
    return false

weave chain_fn_by_symbol with c as ref to context.CgContext, sid as int into int:
    var i as int is 0
    while i < c->catalog.functions.len:
        var fm as catalog.CgFunction is (c->catalog.functions at i)
        if fm.symbol == sid and not fm.is_method:
            return i
        set i is i + 1
    return -1

weave chain_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var base as int is calling astutil.node_child with ast, node, 0
    var base_type as int is calling node_type with c, base
    var base_val as string is calling emit_expr with c, base
    defer banish base_val
    var mode as int is (ast->nodes at node).aux
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var cur_type as int is base_type
    var cur_name as string is "_ch0"
    var cty0 as string is calling ctype.c_type with (sigil of c->names), cur_type
    defer banish cty0
    calling sb.append with "__extension__(({ "
    calling sb.append with cty0
    calling sb.append with " _ch0 = "
    calling sb.append with base_val
    calling sb.append with "; "
    var n as int is calling astutil.child_count with ast, node
    var i as int is 1
    while i < n:
        var step as int is calling astutil.node_child with ast, node, i
        if step >= 0:
            var stype as int is calling node_type with c, step
            var is_last as bool is i == n - 1
            var step_name as string is "_ch{i}"
            if mode == 1:
                var tar as int is calling astutil.node_child with ast, step, 0
                var ntk as int is calling astutil.token_child with ast, tar, 0
                var ntx as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ntk
                var nm as int is calling npool.intern with (sigil of c->program->names), ntx
                banish ntx
                var fn as int is -1
                var psid as int is calling ann.symbol_of with (sigil of m.annotations), step
                if psid >= 0:
                    set fn is calling chain_fn_by_symbol with c, psid
                if fn < 0:
                    set fn is calling chain_pipe_fn with c, nm
                if fn >= 0:
                    var fm as catalog.CgFunction is (c->catalog.functions at fn)
                    var cname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), fm.c_name)
                    defer banish cname
                    var call as StringBuilder is calling StringBuilder.new
                    defer banish call
                    calling call.append with cname
                    calling call.append with "("
                    calling call.append with cur_name
                    var args as int is calling astutil.node_child with ast, step, 1
                    if args >= 0:
                        var ac as int is calling astutil.child_count with ast, args
                        var ai as int is 0
                        while ai < ac:
                            var an as int is calling astutil.node_child with ast, args, ai
                            if an >= 0:
                                var avn as int is an
                                if (calling astutil.kind_of with ast, an) == pskind.NodeKind.NdPosArg:
                                    set avn is calling astutil.node_child with ast, an, 0
                                var av as string is calling emit_expr with c, avn
                                defer banish av
                                calling call.append with ", "
                                calling call.append with av
                            set ai is ai + 1
                    calling call.append with ")"
                    var ctext as string is calling call.finish
                    defer banish ctext
                    var pvoid as bool is is_last and (calling chain_fn_void with c, fn)
                    if (stype <= 0 or pvoid) and is_last:
                        calling sb.append with ctext
                        calling sb.append with "; "
                    else:
                        var scty as string is calling ctype.c_type with (sigil of c->names), stype
                        defer banish scty
                        calling sb.append with scty
                        calling sb.append with " "
                        calling sb.append with step_name
                        calling sb.append with " = "
                        calling sb.append with ctext
                        calling sb.append with "; "
                        set cur_name is step_name
                        set cur_type is stype
            else:
                var ntk2 as int is calling astutil.token_child with ast, step, 0
                var ntx2 as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ntk2
                var nm2 as int is calling npool.intern with (sigil of c->program->names), ntx2
                banish ntx2
                var fn2 as int is calling chain_method_fn with c, cur_type, nm2
                if fn2 >= 0:
                    var fm2 as catalog.CgFunction is (c->catalog.functions at fn2)
                    var cname2 as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), fm2.c_name)
                    defer banish cname2
                    var call2 as StringBuilder is calling StringBuilder.new
                    defer banish call2
                    calling call2.append with cname2
                    calling call2.append with "("
                    if fm2.self_value:
                        calling call2.append with cur_name
                    else:
                        calling call2.append with "&("
                        calling call2.append with cur_name
                        calling call2.append with ")"
                    var args2 as int is calling astutil.node_child with ast, step, 1
                    if args2 >= 0:
                        var ac2 as int is calling astutil.child_count with ast, args2
                        var ai2 as int is 0
                        while ai2 < ac2:
                            var an2 as int is calling astutil.node_child with ast, args2, ai2
                            if an2 >= 0:
                                var avn2 as int is an2
                                if (calling astutil.kind_of with ast, an2) == pskind.NodeKind.NdPosArg:
                                    set avn2 is calling astutil.node_child with ast, an2, 0
                                var av2 as string is calling emit_expr with c, avn2
                                defer banish av2
                                calling call2.append with ", "
                                calling call2.append with av2
                            set ai2 is ai2 + 1
                    calling call2.append with ")"
                    var ctext2 as string is calling call2.finish
                    defer banish ctext2
                    if stype <= 0 and is_last:
                        calling sb.append with ctext2
                        calling sb.append with "; "
                    else:
                        var scty2 as string is calling ctype.c_type with (sigil of c->names), stype
                        defer banish scty2
                        calling sb.append with scty2
                        calling sb.append with " "
                        calling sb.append with step_name
                        calling sb.append with " = "
                        calling sb.append with ctext2
                        calling sb.append with "; "
                        set cur_name is step_name
                        set cur_type is stype
        set i is i + 1
    calling sb.append with cur_name
    calling sb.append with "; }))"
    return calling sb.finish

## Nombre C de una variante de omen.
##
## Los omens propios emiten `Type_Variant`; los declarados en un `.d.pengu`
## usan el nombre crudo del enum de la cabecera (`BLEND_ALPHA`, no
## `BlendMode_BLEND_ALPHA`), porque su `typedef` no se regenera.
##
## ## Memoria
## Devuelve string owned.
weave omen_variant_c_name with c as ref to context.CgContext, oty as int, vname as int into string:
    var vn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), vname)
    var ty as tk.SemaType is calling types.at with (sigil of c->program->types), oty
    if ty.kind == tk.SemaTypeKind.TkOmen and ty.a >= 0 and ty.a < c->program->types.nominal_infos.len:
        var info as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
        if info.module >= 0 and info.module < c->program->modules.len:
            var om as loader.SemaModule is (c->program->modules at info.module)
            if calling catalog.is_decl_path with om.canonical_path:
                return vn
    # El `module` del nominal puede faltar; la variante sí lo lleva.
    var vmi as int is 0
    while vmi < c->program->symbols.symbols.len:
        var vms as sym.SemaSymbol is (c->program->symbols.symbols at vmi)
        if vms.name == vname and vms.type == oty and vms.module >= 0 and vms.module < c->program->modules.len:
            var vmm as loader.SemaModule is (c->program->modules at vms.module)
            if calling catalog.is_decl_path with vmm.canonical_path:
                return vn
        set vmi is vmi + 1
    var aon as string is calling ctype.c_type with (sigil of c->names), oty
    var full as string is "{aon}_{vn}"
    banish aon
    banish vn
    return full

## Busca una variante de omen exportada por `module_id` (global scope).
##
## Las variantes se registran en el scope 0, no en el scope del módulo, así que
## `lookup_in_scope(module_scope, ...)` no las encuentra para `mod.Variant`.
##
## ## Memoria
## O(símbolos); no asigna.
weave find_module_variant with c as ref to context.CgContext, module_id as int, name as int into int:
    var i as int is 0
    while i < c->program->symbols.symbols.len:
        var sv as sym.SemaSymbol is (c->program->symbols.symbols at i)
        if sv.kind == sym.SemaSymbolKind.SkConst and sv.name == name and sv.type > 0:
            var ty as tk.SemaType is calling types.at with (sigil of c->program->types), sv.type
            if ty.kind == tk.SemaTypeKind.TkOmen and ty.a >= 0 and ty.a < c->program->types.nominal_infos.len:
                var info as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
                if info.module == module_id:
                    return sv.type
        set i is i + 1
    return -1

## Emite un acceso a campo o una variante de omen.
##
## ## Memoria
## Strings owned.
weave field_access_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, arrow as bool into string:
    var base as int is calling astutil.node_child with ast, node, 0
    var ft as int is calling astutil.token_child with ast, node, 1
    if ft < 0:
        return "0"
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var fname as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ft
    defer banish fname
    var asid as int is calling ann.symbol_of with (sigil of m.annotations), node
    if asid >= 0:
        var asv as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), asid
        if asv.type > 0:
            var astv as tk.SemaType is calling types.at with (sigil of c->program->types), asv.type
            if astv.kind == tk.SemaTypeKind.TkOmen:
                return calling omen_variant_c_name with c, asv.type, asv.name
        if asv.kind == sym.SemaSymbolKind.SkConst:
            var cci0 as int is 0
            while cci0 < c->catalog.consts.len:
                var ccx as catalog.CgConst is (c->catalog.consts at cci0)
                if ccx.module == asv.module and ccx.name == asv.name:
                    return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), ccx.c_name)
                set cci0 is cci0 + 1
            var cci1 as int is 0
            while cci1 < c->catalog.consts.len:
                var ccy as catalog.CgConst is (c->catalog.consts at cci1)
                if ccy.name == asv.name:
                    return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), ccy.c_name)
                set cci1 is cci1 + 1
        if asv.type >= 0:
            var ast0 as tk.SemaType is calling types.at with (sigil of c->program->types), asv.type
            if ast0.kind == tk.SemaTypeKind.TkOmen:
                return calling omen_variant_c_name with c, asv.type, asv.name
    # `mod.CONST`: el base es un alias de import, no un valor.
    var import_alias as bool is false
    if base >= 0 and (((calling astutil.kind_of with ast, base) == pskind.NodeKind.NdVarRef) or ((calling astutil.kind_of with ast, base) == pskind.NodeKind.NdNormalTarget)):
        var btokc as int is calling astutil.token_child with ast, base, 0
        if btokc >= 0:
            var btxtc as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), btokc
            var btidc as int is calling npool.intern with (sigil of c->program->names), btxtc
            var bsidc as int is calling symbols.lookup_in_scope with (sigil of c->program->symbols), m.scope, btidc
            if bsidc < 0:
                set bsidc is calling symbols.lookup_name with (sigil of c->program->symbols), btxtc
            banish btxtc
            if bsidc >= 0:
                var bsvc as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), bsidc
                if bsvc.kind == sym.SemaSymbolKind.SkImport:
                    set import_alias is true
                    var bmid as int is -1
                    var bmi as int is 0
                    while bmi < c->program->modules.len:
                        var bmm as loader.SemaModule is (c->program->modules at bmi)
                        if bmm.scope == bsvc.module_scope:
                            set bmid is bmi
                        set bmi is bmi + 1
                    if bmid >= 0:
                        var bfnid as int is calling npool.intern with (sigil of c->program->names), fname
                        var bci as int is 0
                        while bci < c->catalog.consts.len:
                            var bcc as catalog.CgConst is (c->catalog.consts at bci)
                            if bcc.module == bmid and bcc.name == bfnid:
                                return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), bcc.c_name)
                            set bci is bci + 1
                        var bfi as int is 0
                        while bfi < c->catalog.functions.len:
                            var bff as catalog.CgFunction is (c->catalog.functions at bfi)
                            if bff.module == bmid and bff.name == bfnid and not bff.is_method:
                                return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), bff.c_name)
                            set bfi is bfi + 1
                        # `mod.Variant` de un omen del módulo.
                        var bmsid as int is calling symbols.lookup_in_scope with (sigil of c->program->symbols), bsvc.module_scope, bfnid
                        if bmsid >= 0:
                            var bms as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), bmsid
                            if bms.kind == sym.SemaSymbolKind.SkConst and bms.type > 0:
                                var bmty as tk.SemaType is calling types.at with (sigil of c->program->types), bms.type
                                if bmty.kind == tk.SemaTypeKind.TkOmen:
                                    return calling omen_variant_c_name with c, bms.type, bms.name
                        var gvty as int is calling find_module_variant with c, bmid, bfnid
                        if gvty >= 0:
                            return calling omen_variant_c_name with c, gvty, bfnid
    # Fallback global: `colors.BLUE`/`raymathx.PI` reexportan un const del
    # módulo que lo define; `lookup_in_scope` ya lo resuelve en sema.
    if import_alias:
        var global_fid as int is calling npool.intern with (sigil of c->program->names), fname
        var gci as int is 0
        while gci < c->catalog.consts.len:
            var gcc as catalog.CgConst is (c->catalog.consts at gci)
            if gcc.name == global_fid:
                return calling npool.copy_string with (calling npool.text with (sigil of c->program->names), gcc.c_name)
            set gci is gci + 1
    var bt0 as int is calling node_type with c, base
    if bt0 < 0 and base >= 0 and (calling astutil.kind_of with ast, base) == pskind.NodeKind.NdVarRef:
        var btok as int is calling astutil.token_child with ast, base, 0
        if btok >= 0:
            var btxt0 as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), btok
            var bnid0 as int is calling npool.intern with (sigil of c->program->names), btxt0
            banish btxt0
            set bt0 is calling context.local_type with c, bnid0
    if bt0 >= 0:
        var bt1 as tk.SemaType is calling types.at with (sigil of c->program->types), bt0
        if (fname == "length" or fname == "len") and (bt1.kind == tk.SemaTypeKind.TkSlice or bt1.kind == tk.SemaTypeKind.TkArray or bt1.kind == tk.SemaTypeKind.TkList or (bt1.kind == tk.SemaTypeKind.TkBase and (calling types.at with (sigil of c->program->types), bt0).kind == tk.SemaTypeKind.TkBase)):
            var bl as string is calling emit_expr with c, base
            defer banish bl
            if bt1.kind == tk.SemaTypeKind.TkSlice:
                return "pengu_slice_len(&({bl}))"
            return "({bl}).len"
        if bt1.kind == tk.SemaTypeKind.TkTuple and (fname == "0" or fname == "1" or fname == "2" or fname == "3"):
            var bt0s as string is calling emit_expr with c, base
            defer banish bt0s
            var lab as string is "first"
            if fname == "1":
                set lab is "second"
            else if fname == "2":
                set lab is "third"
            else if fname == "3":
                set lab is "fourth"
            return "{bt0s}.{lab}"
        if bt1.kind == tk.SemaTypeKind.TkMaybe and fname == "value":
            var bm as string is calling emit_expr with c, base
            defer banish bm
            var pm as string is calling ctype.c_type with (sigil of c->names), bt1.a
            defer banish pm
            var pmp as string is calling ctype.pointer_type_name with pm
            defer banish pmp
            return "(*( {pmp})(({bm}).value))"
        if bt1.kind == tk.SemaTypeKind.TkResult and (fname == "value" or fname == "error"):
            var b0 as string is calling emit_expr with c, base
            defer banish b0
            var pay0 as int is bt1.a
            if fname == "error":
                set pay0 is bt1.b
            var pct0 as string is calling ctype.c_type with (sigil of c->names), pay0
            defer banish pct0
            var pct0p as string is calling ctype.pointer_type_name with pct0
            defer banish pct0p
            if fname == "value":
                return "(*( {pct0p})(({b0}).ok_val))"
            return "(*( {pct0p})(({b0}).err_val))"
    var bty0 as int is calling node_type with c, base
    if bty0 >= 0:
        var bty1 as tk.SemaType is calling types.at with (sigil of c->program->types), bty0
        if bty1.kind == tk.SemaTypeKind.TkOmen:
            var fvid as int is calling npool.intern with (sigil of c->program->names), fname
            return calling omen_variant_c_name with c, bty0, fvid
    var qpath as string is calling dotted_path_text with c, base, ast
    defer banish qpath
    if qpath != "":
        var csuf as string is "/{qpath}.pengu"
        var cmid as int is -1
        var cmi as int is 0
        while cmi < c->program->modules.len:
            var cmm as loader.SemaModule is (c->program->modules at cmi)
            if (cmm.path length) >= (csuf length):
                if (cmm.path at ((cmm.path length) - (csuf length)) to (cmm.path length)) == csuf:
                    set cmid is cmi
            set cmi is cmi + 1
        banish csuf
        if cmid >= 0:
            var cfnid as int is calling npool.intern with (sigil of c->program->names), fname
            var cci as int is 0
            while cci < c->catalog.consts.len:
                var cc0 as catalog.CgConst is (c->catalog.consts at cci)
                if cc0.module == cmid and cc0.name == cfnid:
                    var ccn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), cc0.c_name)
                    return ccn
                set cci is cci + 1
    if qpath != "":
        var qfull as string is "{qpath}.{fname}"
        var qtid as int is calling symbols.lookup_type_name with (sigil of c->program->symbols), qfull
        var qtest as string is calling npool.copy_string with qfull
        while qtid < 0:
            var dlast as int is -1
            var qi as int is 0
            while qi < qtest length:
                if (qtest at qi) == ".":
                    set dlast is qi
                set qi is qi + 1
            if dlast < 0:
                break
            var nxtq as string is qtest at 0 to dlast
            banish qtest
            set qtest is nxtq
            set qtid is calling symbols.lookup_type_name with (sigil of c->program->symbols), qtest
        banish qtest
        if qtid < 0:
            var cstart as int is 0
            var cend as int is 0
            while cend <= qfull length:
                if cend == qfull length or (qfull at cend) == ".":
                    if cend > cstart:
                        var comp as string is qfull at cstart to cend
                        var cid0 as int is calling symbols.lookup_type_name with (sigil of c->program->symbols), comp
                        if cid0 >= 0:
                            var ct0 as tk.SemaType is calling types.at with (sigil of c->program->types), cid0
                            if ct0.kind == tk.SemaTypeKind.TkOmen:
                                set qtid is cid0
                        banish comp
                    set cstart is cend + 1
                set cend is cend + 1
        banish qfull
        if qtid >= 0:
            var qt as tk.SemaType is calling types.at with (sigil of c->program->types), qtid
            if qt.kind == tk.SemaTypeKind.TkOmen:
                var tn0 as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), qt.name)
                defer banish tn0
                if tn0 == fname:
                    return "0"
                var qon as string is calling ctype.c_type with (sigil of c->names), qtid
                defer banish qon
                return "{qon}_{fname}"
    var nt as int is calling node_type with c, node
    var nty as tk.SemaType is calling types.at with (sigil of c->program->types), nt
    # `Color.Green`: el base es el nombre de un omen.
    if base >= 0 and (calling astutil.kind_of with ast, base) == pskind.NodeKind.NdVarRef:
        var btxt as string is calling astutil.first_token_text with (sigil of m.source), (sigil of m.lex), ast, base
        defer banish btxt
        var tid as int is calling symbols.lookup_type_name with (sigil of c->program->symbols), btxt
        if tid >= 0 and (nty.kind == tk.SemaTypeKind.TkOmen or (calling types.at with (sigil of c->program->types), tid).kind == tk.SemaTypeKind.TkOmen):
            var tname as string is calling ctype.c_type with (sigil of c->names), tid
            defer banish tname
            return "{tname}_{fname}"
    var b as string is calling emit_expr with c, base
    defer banish b
    var is_arrow as bool is arrow
    if (calling astutil.kind_of with ast, base) == pskind.NodeKind.NdSelfRef and not c->self_value:
        set is_arrow is true
    var sep as string is "."
    if is_arrow:
        set sep is "->"
    var bty as int is 0
    if base >= 0:
        set bty is calling node_type with c, base
    var fid as int is calling npool.intern with (sigil of c->program->names), fname
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with b
    # Campo promovido: `e.position` se emite como `e.gameObj.position`.
    calling append_embed_path with c, (sigil of sb), bty, fid, sep
    calling sb.append with sep
    calling sb.append with fname
    return calling sb.finish

## Emite un literal de array `(Tipo[N]){...}`.
##
## ## Memoria
## Strings owned.
weave array_lit_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, wanted as int into string:
    var ty as int is wanted
    if ty < 0:
        set ty is calling node_type with c, node
    var elem as string is "void*"
    var n as int is 0
    var is_list as bool is false
    var list_elem as int is -1
    if ty >= 0:
        var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
        if t.kind == tk.SemaTypeKind.TkArray:
            var et as string is calling ctype.c_type with (sigil of c->names), t.a
            banish elem
            set elem is et
            set n is t.b
        else if t.kind == tk.SemaTypeKind.TkList:
            set is_list is true
            set list_elem is t.a
    if n <= 0:
        set n is calling astutil.child_count with ast, node
    if is_list:
        var et2 as string is calling ctype.c_type with (sigil of c->names), list_elem
        defer banish et2
        var lst as string is calling emit.temp with (sigil of c->emitter), "_ll"
        defer banish lst
        var lv as string is calling emit.temp with (sigil of c->emitter), "_le"
        defer banish lv
        var lsb as StringBuilder is calling StringBuilder.new
        defer banish lsb
        calling lsb.append with "__extension__(({ PenguList "
        calling lsb.append with lst
        calling lsb.append with " = pengu_list_new(sizeof("
        calling lsb.append with et2
        calling lsb.append with "), "
        calling lsb.append with "{n}"
        calling lsb.append with "); "
        # La variable de elemento solo se usa al empujar: con la lista vacía
        # sería un `-Wunused-variable` en el consumidor.
        if n > 0:
            calling lsb.append with et2
            calling lsb.append with " "
            calling lsb.append with lv
            calling lsb.append with "; "
        var li as int is 0
        while li < n:
            var lch as int is calling astutil.node_child with ast, node, li
            if lch >= 0:
                var lvx as string is calling emit_expr_as with c, lch, list_elem
                calling lsb.append with lv
                calling lsb.append with " = "
                calling lsb.append with lvx
                calling lsb.append with "; pengu_list_push(&"
                calling lsb.append with lst
                calling lsb.append with ", &"
                calling lsb.append with lv
                calling lsb.append with "); "
                banish lvx
            set li is li + 1
        calling lsb.append with lst
        calling lsb.append with "; }))"
        return calling lsb.finish
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "({elem}[{n}]){"
    var i as int is 0
    while i < n:
        var ch as int is calling astutil.node_child with ast, node, i
        if ch >= 0:
            if i > 0:
                calling sb.append with ", "
            var av as string is calling emit_expr with c, ch
            calling sb.append with av
            banish av
        set i is i + 1
    calling sb.append with "}"
    banish elem
    return calling sb.finish

## Emite una lista vacía o con elementos.
##
## ## Memoria
## Strings owned.
weave list_init_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, wanted as int into string:
    var ty as int is wanted
    if ty <= 1:
        set ty is calling node_type with c, node
    if ty <= 1:
        var m0 as loader.SemaModule is (c->program->modules at c->current_module)
        var c0 as int is calling astutil.node_child with ast, node, 0
        if c0 >= 0:
            var et0 as int is calling tast.from_ast with c, m0, c0
            if et0 > 0:
                set ty is calling types.list_of with (sigil of c->program->types), et0
            else:
                var ect0 as string is calling tast.c_type_ast with c, m0, c0
                var lret0 as string is "pengu_list_new(sizeof({ect0}), 0)"
                banish ect0
                return lret0
    if ty <= 1:
        return "pengu_list_new(1, 0)"
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind != tk.SemaTypeKind.TkList:
        var m1 as loader.SemaModule is (c->program->modules at c->current_module)
        var cc0 as int is calling astutil.node_child with ast, node, 0
        if cc0 >= 0:
            var ect1 as string is calling tast.c_type_ast with c, m1, cc0
            var lr1 as string is "pengu_list_new(sizeof({ect1}), 0)"
            banish ect1
            return lr1
        return "pengu_list_new(1, 0)"
    var elem as string is calling ctype.c_type with (sigil of c->names), t.a
    defer banish elem
    return "pengu_list_new(sizeof({elem}), 0)"

## `true` si el omen usa representación tag+union.
##
## ## Memoria
## O(variantes).
weave omen_has_layout with c as ref to context.CgContext, ty as int into bool:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind != tk.SemaTypeKind.TkOmen:
        return false
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    var i as int is 0
    while i < info.variants_count:
        var v as types.SemaVariant is (c->program->types.variants at (info.variants_first + i))
        if v.payload_count > 0:
            return true
        set i is i + 1
    return false

## `true` si una variante de omen tiene payload.
##
## ## Memoria
## O(variantes).
weave omen_variant_has_payload with c as ref to context.CgContext, ty as int, vname as int into bool:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind != tk.SemaTypeKind.TkOmen:
        return false
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    var i as int is 0
    while i < info.variants_count:
        var v as types.SemaVariant is (c->program->types.variants at (info.variants_first + i))
        if v.name == vname:
            return v.payload_count > 0
        set i is i + 1
    return false

## Inicializador C de una variante de omen usada como valor.
##
## `E.Empty` no es un identificador C válido: se emite `(E){.tag = E_Empty}`.
##
## ## Memoria
## Devuelve string owned.
weave omen_variant_literal with c as ref to context.CgContext, ty as int, vname as int into string:
    var vn as string is calling omen_variant_c_name with c, ty, vname
    if not (calling omen_has_layout with c, ty):
        return vn
    defer banish vn
    var ct as string is calling ctype.c_type with (sigil of c->names), ty
    defer banish ct
    var vtext as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), vname)
    defer banish vtext
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    # C: literal compuesto `(E){...}`. C++ no tiene literales compuestos y no
    # admite `.data.V = ...` (designador a traves de union), asi que usa
    # `E{...}` y `.data = {.V = ...}`.
    var cpp as bool is c->options.family == "cpp"
    if not cpp:
        calling sb.append with "("
    calling sb.append with ct
    if not cpp:
        calling sb.append with ")"
    calling sb.append with "{.tag = "
    calling sb.append with vn
    if calling omen_variant_has_payload with c, ty, vname:
        if cpp:
            calling sb.append with ", .data = {."
            calling sb.append with vtext
            calling sb.append with " = {0}}"
        else:
            calling sb.append with ", .data."
            calling sb.append with vtext
            calling sb.append with " = {0}"
    calling sb.append with "}"
    return calling sb.finish

## Primer campo de payload de una variante.
##
## ## Memoria
## O(variantes).
weave omen_first_payload with c as ref to context.CgContext, ty as int, vname as int into int:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind != tk.SemaTypeKind.TkOmen:
        return -1
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    var i as int is 0
    while i < info.variants_count:
        var v as types.SemaVariant is (c->program->types.variants at (info.variants_first + i))
        if v.name == vname and v.payload_count > 0:
            var f as types.SemaField is (c->program->types.fields at v.payload_first)
            return f.name
        set i is i + 1
    return -1

## Tipo del primer campo de payload de una variante.
##
## ## Memoria
## O(variantes).
weave omen_first_payload_type with c as ref to context.CgContext, ty as int, vname as int into int:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind != tk.SemaTypeKind.TkOmen:
        return -1
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    var i as int is 0
    while i < info.variants_count:
        var v as types.SemaVariant is (c->program->types.variants at (info.variants_first + i))
        if v.name == vname and v.payload_count > 0:
            var f as types.SemaField is (c->program->types.fields at v.payload_first)
            return f.type
        set i is i + 1
    return -1

## Inicializador de un payload de omen con varios campos.
##
## ## Memoria
## Strings owned.
weave payload_struct with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "{"
    var i as int is 0
    var n as int is calling astutil.child_count with ast, node
    var first as bool is true
    while i < n:
        var fi as int is calling astutil.node_child with ast, node, i
        if fi >= 0:
            var ft as int is calling astutil.token_child with ast, fi, 0
            var fv as int is calling astutil.node_child with ast, fi, 1
            if ft >= 0 and fv >= 0:
                var fn as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ft
                defer banish fn
                var av as string is calling emit_expr with c, fv
                defer banish av
                if not first:
                    calling sb.append with ", "
                calling sb.append with ".{fn} = {av}"
                set first is false
        set i is i + 1
    calling sb.append with "}"
    return calling sb.finish

## Emite los campos de un payload anidado, ignorando el nombre de la variante.
##
## ## Memoria
## Devuelve string owned.
weave payload_fields with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, skip as string into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "{"
    var first as bool is true
    var i as int is 0
    var n as int is calling astutil.child_count with ast, node
    while i < n:
        var ch as int is calling astutil.node_child with ast, node, i
        if ch >= 0:
            if (calling astutil.kind_of with ast, ch) == pskind.NodeKind.NdFieldInit:
                var ft as int is calling astutil.token_child with ast, ch, 0
                var fv as int is calling astutil.node_child with ast, ch, 1
                if ft >= 0 and fv >= 0:
                    var fn as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ft
                    if fn != skip:
                        var av as string is calling emit_expr with c, fv
                        if not first:
                            calling sb.append with ", "
                        calling sb.append with ".{fn} = {av}"
                        set first is false
                        banish av
                    banish fn
            var sub as string is calling payload_fields with c, ch, ast, skip
            if sub != r"{}":
                var body as string is sub at 1 to (sub length - 1)
                if not first:
                    calling sb.append with ", "
                calling sb.append with body
                set first is false
                banish body
            banish sub
        set i is i + 1
    calling sb.append with "}"
    return calling sb.finish

## Emite una variante de omen con payload.
##
## ## Memoria
## Strings owned.
weave omen_init_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, ty as int into string:
    var ct as string is calling ctype.c_type with (sigil of c->names), ty
    defer banish ct
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var cpp as bool is c->options.family == "cpp"
    if cpp:
        calling sb.append with "{ct}{.tag = "
    else:
        calling sb.append with "({ct}){.tag = "
    var fi as int is calling astutil.node_child with ast, node, 0
    if fi < 0:
        calling sb.append with "0}"
        return calling sb.finish
    var nt as int is calling astutil.token_child with ast, fi, 0
    if nt < 0:
        calling sb.append with "0}"
        return calling sb.finish
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var vn as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), nt
    defer banish vn
    var vnid2 as int is calling npool.intern with (sigil of c->program->names), vn
    if (calling omen_first_payload with c, ty, vnid2) < 0:
        calling sb.append with "{ct}_{vn}}"
        return calling sb.finish
    if cpp:
        calling sb.append with "{ct}_{vn}, .data = {.{vn} = {"
    else:
        calling sb.append with "{ct}_{vn}, .data.{vn} = {"
    var i as int is 0
    var n as int is calling astutil.child_count with ast, node
    while i < n:
        var fnode as int is calling astutil.node_child with ast, node, i
        if fnode >= 0:
            var ft as int is calling astutil.token_child with ast, fnode, 0
            var fv as int is calling astutil.node_child with ast, fnode, 1
            if ft >= 0 and fv >= 0:
                var fn as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), ft
                defer banish fn
                var fnid as int is calling npool.intern with (sigil of c->program->names), fn
                var is_nested as bool is (calling astutil.kind_of with ast, fv) == pskind.NodeKind.NdStructInit
                var pfield as int is calling omen_first_payload with c, ty, fnid
                var pftype as int is calling omen_first_payload_type with c, ty, fnid
                if not is_nested and pfield >= 0:
                    banish fn
                    set fn is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), pfield)
                var av as string is ""
                if is_nested:
                    set av is calling payload_fields with c, fv, ast, fn
                else:
                    var fvty as int is pftype
                    if fvty < 0:
                        var fk0 as pskind.NodeKind is calling astutil.kind_of with ast, fv
                        if fk0 == pskind.NodeKind.NdListType or fk0 == pskind.NodeKind.NdMapType:
                            set fvty is calling tast.from_ast with c, m, fv
                    if fvty >= 0:
                        set av is calling emit_expr_as with c, fv, fvty
                    else:
                        set av is calling emit_expr with c, fv
                defer banish av
                if i > 0:
                    calling sb.append with ", "
                if is_nested:
                    var inner_av as string is av at 1 to (av length - 1)
                    calling sb.append with inner_av
                    banish inner_av
                else:
                    calling sb.append with ".{fn} = {av}"
        set i is i + 1
    # Dos appends: en una interpolacion `}}` es una llave literal, asi que
    # `"}}"` emitia una sola y el literal compuesto quedaba sin cerrar.
    calling sb.append with "}"
    if cpp:
        calling sb.append with "}"
    calling sb.append with "}"
    return calling sb.finish

## Emite `Tipo with: set .campo is valor ...`.
##
## ## Memoria
## Strings owned.
## Añade una entrada (`campo`, valor) al inicializador agrupado de un rune.
##
## `path` son los índices de los campos `fundere` que hay que atravesar para
## llegar al campo; vacío para un campo propio. La resolución la comparte con la
## sema, así que el codegen no puede discrepar de la validación.
##
## ## Memoria
## `path`, `txt` y las listas pasan a ser owned por el llamador.
weave push_init_entry with c as ref to context.CgContext, ty as int, name_tok as int, val as int, paths as ref to list of list of int, values as ref to list of int, tys as ref to list of int, leafs as ref to list of string into void:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), name_tok
    var nid as int is calling npool.intern with (sigil of c->program->names), txt
    var path as list of int is list of int
    var route as int is calling embeds.route_into with (sigil of c->program->types), ty, nid, (sigil of path), 0
    if route != embeds.ROUTE_FOUND:
        # La sema ya emitió el diagnóstico; se emite plano para no romper el C.
        banish path
        set path is list of int
    # Tipo del campo final: se recorre el camino hasta el embed que lo declara y
    # allí se busca el campo por nombre.
    var parent as int is ty
    var ok as bool is true
    var pi as int is 0
    while pi < path.len:
        var cur as int is calling embeds.unwrap with (sigil of c->program->types), parent
        var cur_t as tk.SemaType is calling types.at with (sigil of c->program->types), cur
        if cur_t.kind != tk.SemaTypeKind.TkRune and cur_t.kind != tk.SemaTypeKind.TkEcho:
            set ok is false
        else:
            var step as int is (path at pi)
            var nxt as int is calling embeds.own_field_type with (sigil of c->program->types), parent, step
            if nxt <= 0:
                set ok is false
            else:
                set parent is nxt
        set pi is pi + 1
    var leaf_ty as int is -1
    if ok:
        var own as int is calling embeds.own_field_type with (sigil of c->program->types), parent, nid
        if own > 0:
            set leaf_ty is own
    calling tys->push with leaf_ty
    calling values->push with val
    calling leafs->push with txt
    calling paths->push with path

## Cuerpo de un inicializador de rune con los campos promovidos agrupados.
##
## Emite `.embed = (Embed){ ... }` para cada embed que recibe algún campo
## promovido y deja los campos propios al mismo nivel. C no admite dos
## designadores del mismo miembro, así que un embed solo puede aparecer una vez.
##
## ## Memoria
## Devuelve string owned; no consume las listas.
weave grouped_init_body with c as ref to context.CgContext, ty_in as int, paths as list of list of int, values as list of int, tys as list of int, leafs as list of string into string:
    # C++ no admite designadores desordenados: recorre la runa en orden de
    # declaracion. C conserva el orden del fuente (embeds primero) para que el
    # bundle emitido siga siendo byte-identico al de la release anterior.
    if c->options.family == "cpp":
        return calling grouped_init_decl_order with c, ty_in, paths, values, tys, leafs
    return calling grouped_init_c with c, ty_in, paths, values, tys, leafs

## Cuerpo de un inicializador con el orden del fuente (backend C).
##
## ## Memoria
## Devuelve string owned; no consume las listas.
weave grouped_init_c with c as ref to context.CgContext, ty_in as int, paths as list of list of int, values as list of int, tys as list of int, leafs as list of string into string:
    # Un cuerpo genérico (`Box_grown_inst2`) construye `Box of T`: el tipo hay
    # que sustituirlo antes de nombrarlo en C.
    var ty as int is calling generics.subst_codegen with c, ty_in
    var ct as string is calling ctype.c_type with (sigil of c->names), ty
    defer banish ct
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "({ct}){"
    var first as bool is true
    var ut as int is calling embeds.unwrap with (sigil of c->program->types), ty
    var tt as tk.SemaType is calling types.at with (sigil of c->program->types), ut
    if tt.kind == tk.SemaTypeKind.TkRune or tt.kind == tk.SemaTypeKind.TkEcho:
        var info as types.SemaNominalInfo is (c->program->types.nominal_infos at tt.a)
        var fi as int is 0
        while fi < info.fields_count:
            var f as types.SemaField is (c->program->types.fields at (info.fields_first + fi))
            if (f.flags & types.FIELD_EMBED) != 0:
                var any as bool is false
                var i as int is 0
                while i < paths.len:
                    var p as list of int is (paths at i)
                    if p.len > 0 and (p at 0) == f.name:
                        set any is true
                    set i is i + 1
                if any:
                    var sub as list of list of int is list of list of int
                    var sv as list of int is list of int
                    var st as list of int is list of int
                    var sl as list of string is list of string
                    set i is 0
                    while i < paths.len:
                        var p2 as list of int is (paths at i)
                        if p2.len > 0 and (p2 at 0) == f.name:
                            var np as list of int is list of int
                            var j as int is 1
                            while j < p2.len:
                                calling np.push with (p2 at j)
                                set j is j + 1
                            calling sub.push with np
                            calling sv.push with (values at i)
                            calling st.push with (tys at i)
                            calling sl.push with (leafs at i)
                        set i is i + 1
                    var fn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.name)
                    var inner as string is calling grouped_init_body with c, f.type, sub, sv, st, sl
                    if not first:
                        calling sb.append with ", "
                    calling sb.append with ".{fn} = {inner}"
                    set first is false
                    banish fn
                    banish inner
                    banish sub
                    banish sv
                    banish st
                    banish sl
            set fi is fi + 1
    var i2 as int is 0
    while i2 < paths.len:
        var p3 as list of int is (paths at i2)
        if p3.len == 0:
            var fn2 as string is (leafs at i2)
            var vty as int is (tys at i2)
            var av as string is ""
            if vty > 0:
                set av is calling emit_expr_as with c, (values at i2), vty
            else:
                set av is calling emit_expr with c, (values at i2)
            if not first:
                calling sb.append with ", "
            calling sb.append with ".{fn2} = {av}"
            set first is false
            banish av
        set i2 is i2 + 1
    calling sb.append with "}"
    return calling sb.finish


weave grouped_init_decl_order with c as ref to context.CgContext, ty_in as int, paths as list of list of int, values as list of int, tys as list of int, leafs as list of string into string:
    # Un cuerpo genérico (`Box_grown_inst2`) construye `Box of T`: el tipo hay
    # que sustituirlo antes de nombrarlo en C.
    var ty as int is calling generics.subst_codegen with c, ty_in
    var ct as string is calling ctype.c_type with (sigil of c->names), ty
    defer banish ct
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    # C++ exige los designadores en orden de declaracion y no tiene literales
    # compuestos: `T{...}` en vez de `(T){...}`, y los campos se emiten
    # recorriendo la runa en orden, no en el orden del fuente.
    var cpp as bool is c->options.family == "cpp"
    if cpp:
        calling sb.append with "{ct}{"
    else:
        calling sb.append with "({ct}){"
    var first as bool is true
    var used as list of bool is list of bool
    var iu as int is 0
    while iu < paths.len:
        calling used.push with false
        set iu is iu + 1
    var ut as int is calling embeds.unwrap with (sigil of c->program->types), ty
    var tt as tk.SemaType is calling types.at with (sigil of c->program->types), ut
    if tt.kind == tk.SemaTypeKind.TkRune or tt.kind == tk.SemaTypeKind.TkEcho:
        var info as types.SemaNominalInfo is (c->program->types.nominal_infos at tt.a)
        var fi as int is 0
        while fi < info.fields_count:
            var f as types.SemaField is (c->program->types.fields at (info.fields_first + fi))
            var fnm as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.name)
            if (f.flags & types.FIELD_EMBED) != 0:
                var any as bool is false
                var i as int is 0
                while i < paths.len:
                    var p as list of int is (paths at i)
                    if p.len > 0 and (p at 0) == f.name:
                        set any is true
                    set i is i + 1
                if any:
                    var sub as list of list of int is list of list of int
                    var sv as list of int is list of int
                    var st as list of int is list of int
                    var sl as list of string is list of string
                    set i is 0
                    while i < paths.len:
                        var p2 as list of int is (paths at i)
                        if p2.len > 0 and (p2 at 0) == f.name:
                            var np as list of int is list of int
                            var j as int is 1
                            while j < p2.len:
                                calling np.push with (p2 at j)
                                set j is j + 1
                            calling sub.push with np
                            calling sv.push with (values at i)
                            calling st.push with (tys at i)
                            calling sl.push with (leafs at i)
                            set used at i is true
                        set i is i + 1
                    var inner as string is calling grouped_init_decl_order with c, f.type, sub, sv, st, sl
                    if not first:
                        calling sb.append with ", "
                    calling sb.append with ".{fnm} = {inner}"
                    set first is false
                    banish inner
                    banish sub
                    banish sv
                    banish st
                    banish sl
            else:
                var i3 as int is 0
                while i3 < paths.len:
                    var p4 as list of int is (paths at i3)
                    if p4.len == 0 and (leafs at i3) == fnm:
                        var av as string is ""
                        var vty as int is (tys at i3)
                        if vty > 0:
                            set av is calling emit_expr_as with c, (values at i3), vty
                        else:
                            set av is calling emit_expr with c, (values at i3)
                        if not first:
                            calling sb.append with ", "
                        calling sb.append with ".{fnm} = {av}"
                        set first is false
                        banish av
                        set used at i3 is true
                    set i3 is i3 + 1
            banish fnm
            set fi is fi + 1
    # Entradas cuyo campo no se reconocio por nombre: al final, para no perder
    # el valor (la sema ya emitio el diagnostico).
    var i2 as int is 0
    while i2 < paths.len:
        if not (used at i2):
            var p3 as list of int is (paths at i2)
            if p3.len == 0:
                var fn2 as string is (leafs at i2)
                var vty2 as int is (tys at i2)
                var av2 as string is ""
                if vty2 > 0:
                    set av2 is calling emit_expr_as with c, (values at i2), vty2
                else:
                    set av2 is calling emit_expr with c, (values at i2)
                if not first:
                    calling sb.append with ", "
                calling sb.append with ".{fn2} = {av2}"
                set first is false
                banish av2
        set i2 is i2 + 1
    calling sb.append with "}"
    return calling sb.finish

## Emite `Tipo with: set .campo is v` como inicializador agrupado.
##
## ## Memoria
## Strings owned.
weave with_init_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, ty as int into string:
    var paths as list of list of int is list of list of int
    defer banish paths
    var values as list of int is list of int
    defer banish values
    var tys as list of int is list of int
    defer banish tys
    var leafs as list of string is list of string
    defer banish leafs
    var i as int is 0
    var n as int is calling astutil.child_count with ast, node
    while i < n:
        var st as int is calling astutil.node_child with ast, node, i
        if st >= 0:
            var inner as int is st
            if (calling astutil.kind_of with ast, st) == pskind.NodeKind.NdStmt:
                set inner is calling astutil.node_child with ast, st, 0
            if inner >= 0 and (calling astutil.kind_of with ast, inner) == pskind.NodeKind.NdSetStmt:
                var tgt as int is calling astutil.node_child with ast, inner, 0
                var val as int is calling astutil.node_child with ast, inner, 1
                if tgt >= 0 and val >= 0:
                    var wt as int is calling astutil.node_child with ast, tgt, 0
                    var ft as int is calling astutil.token_child with ast, wt, 0
                    if ft >= 0:
                        calling push_init_entry with c, ty, ft, val, (sigil of paths), (sigil of values), (sigil of tys), (sigil of leafs)
        set i is i + 1
    return calling grouped_init_body with c, ty, paths, values, tys, leafs

## Emite `Tipo is:` con `campo is valor` (bloque indentado).
##
## ## Memoria
## Strings owned.
weave indent_init_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, ty as int into string:
    var paths as list of list of int is list of list of int
    defer banish paths
    var values as list of int is list of int
    defer banish values
    var tys as list of int is list of int
    defer banish tys
    var leafs as list of string is list of string
    defer banish leafs
    var entries as int is node
    var i as int is 0
    var n as int is calling astutil.child_count with ast, node
    if n > 0:
        var c0 as int is calling astutil.node_child with ast, node, 0
        if c0 >= 0 and (calling astutil.kind_of with ast, c0) == pskind.NodeKind.NdIndentEntries:
            set entries is c0
            set n is calling astutil.child_count with ast, c0
    while i < n:
        var fe as int is calling astutil.node_child with ast, entries, i
        if fe >= 0 and (calling astutil.kind_of with ast, fe) == pskind.NodeKind.NdFieldEntry:
            var ft as int is calling astutil.token_child with ast, fe, 0
            var fv as int is calling astutil.node_child with ast, fe, 1
            if ft >= 0 and fv >= 0:
                calling push_init_entry with c, ty, ft, fv, (sigil of paths), (sigil of values), (sigil of tys), (sigil of leafs)
        set i is i + 1
    return calling grouped_init_body with c, ty, paths, values, tys, leafs

## Emite una inicialización de rune/echo.
##
## ## Memoria
## Strings owned.
weave struct_init_expr with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, wanted as int into string:
    var ty as int is wanted
    if ty < 0:
        set ty is calling node_type with c, node
    var paths as list of list of int is list of list of int
    defer banish paths
    var values as list of int is list of int
    defer banish values
    var tys as list of int is list of int
    defer banish tys
    var leafs as list of string is list of string
    defer banish leafs
    var i as int is 0
    var n as int is calling astutil.child_count with ast, node
    while i < n:
        var fi as int is calling astutil.node_child with ast, node, i
        if fi >= 0:
            var nt as int is calling astutil.token_child with ast, fi, 0
            var vn as int is calling astutil.node_child with ast, fi, 1
            if nt >= 0 and vn >= 0 and ty > 0:
                calling push_init_entry with c, ty, nt, vn, (sigil of paths), (sigil of values), (sigil of tys), (sigil of leafs)
        set i is i + 1
    return calling grouped_init_body with c, ty, paths, values, tys, leafs

## Escapa un literal preservando los escapes que C ya entiende.
##
## ## Memoria
## Devuelve string owned.
weave escape_c_lit with s as string into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    var b as ref to frozen byte is bytes of s
    var i as int is 0
    while i < s length:
        var code as int is ((b at i) to int)
        if code == 92 and i + 1 < s length:
            # Preserva `\xNN`, `\n`, `\\`, `\"`, etc. como escape C.
            calling sb.append with "\\"
            set i is i + 1
            var nx as string is s at i
            calling sb.append with nx
            banish nx
        else if code == 34:
            calling sb.append with "\\\""
        else if code == 10:
            calling sb.append with "\\n"
        else if code == 9:
            calling sb.append with "\\t"
        else if code < 32 or code >= 127:
            var hi as int is code / 16
            var lo as int is code % 16
            calling sb.append with "\\x"
            calling emit.append_hex_digit with (sigil of sb), hi
            calling emit.append_hex_digit with (sigil of sb), lo
            if i + 1 < s length:
                var nb as int is ((b at (i + 1)) to int)
                if (nb >= 48 and nb <= 57) or (nb >= 65 and nb <= 70) or (nb >= 97 and nb <= 102):
                    calling sb.append with "\"\""
        else:
            var one as string is s at i
            calling sb.append with one
            banish one
        set i is i + 1
    return calling sb.finish

## Convierte un literal PenguScript completo (con comillas) en C.
##
## Con `as_cstr = true` emite un literal `const char*` puro (`"..."`) para
## contextos `ref to char`/`ref to frozen char`; si no, un `PenguString`.
## Los literales con `{expr}` simples (identificadores locales) se emiten con
## `pengu_string_format_ex`; el resto se conserva como texto. La subfase de
## interpolación completa añadirá expresiones arbitrarias y `(chr N)`.
##
## ## Memoria
## Devuelve string owned.
weave c_string_expr with c as ref to context.CgContext, node as int, raw as string, as_cstr as bool into string:
    var n as int is raw length
    if n < 2:
        if as_cstr:
            return "\"\""
        return "pengu_string_from_cstr(\"\")"
    var is_raw as bool is false
    var start as int is 1
    var finish as int is n - 1
    var bb as ref to frozen byte is bytes of raw
    if ((bb at 0) to int) == 114:
        set is_raw is true
        if n >= 8 and ((bb at 1) to int) == 34 and ((bb at 2) to int) == 34 and ((bb at 3) to int) == 34:
            set start is 4
            set finish is n - 3
        else:
            set start is 2
            set finish is n - 1
    var content as string is raw at start to finish
    defer banish content
    if is_raw:
        var resc as string is calling emit.escape_c with content
        defer banish resc
        if as_cstr:
            return "\"{resc}\""
        return "pengu_string_from_cstr(\"{resc}\")"
    var decoded as string is calling psdecode.decode_text with content, false
    defer banish decoded
    # Un literal con NUL no cabe en `pengu_string_from_cstr`: el runtime
    # copia `len` bytes explícitos para que el valor conserve su longitud.
    var dnul as bool is false
    var db as ref to frozen byte is bytes of decoded
    var dk as int is 0
    while dk < decoded length:
        if ((db at dk) to int) == 0:
            set dnul is true
        set dk is dk + 1
    if calling has_interp with decoded:
        if as_cstr:
            var resc2 as string is calling emit.escape_c with decoded
            defer banish resc2
            return "\"{resc2}\""
        return calling interp_expr with c, node, decoded
    var esc as string is calling emit.escape_c with decoded
    defer banish esc
    if as_cstr:
        return "\"{esc}\""
    if dnul:
        return "pengu_string_owned(\"{esc}\", {decoded length})"
    # La longitud la conoce el compilador: sin `strlen` en cada literal.
    return "pengu_string_from_cstr_len(\"{esc}\", {decoded length})"

## `true` si el contenido tiene una interpolación simple.
##
## ## Memoria
## O(n).
weave has_interp with s as string into bool:
    var b as ref to frozen byte is bytes of s
    var i as int is 0
    while i < s length:
        if ((b at i) to int) == 123:
            if i + 1 < s length and ((b at (i + 1)) to int) == 123:
                set i is i + 2
                continue
            return true
        set i is i + 1
    return false

## Emite una interpolación simple.
##
## ## Memoria
## Strings owned; args se construyen en un builder.
## Añade un valor a `fmt`/`args` de interpolación según su tipo.
##
## ## Memoria
## O(1) strings owned.
weave append_interp_value with c as ref to context.CgContext, fmt as ref to StringBuilder, args as ref to StringBuilder, expr as string, ty as int, spec as string into void:
    if ty >= 0:
        var st as tk.SemaType is calling types.at with (sigil of c->program->types), ty
        if st.kind == tk.SemaTypeKind.TkBase and spec != "":
            var sn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), st.name)
            defer banish sn
            if sn == "string":
                calling fmt.append with "%{spec}"
                calling args.append with "(char*)({expr}).data"
                return
            if sn == "bool":
                # El sema ya lo rechaza; degradar a `true`/`false` sin formato.
                calling fmt.append with "%s"
                calling args.append with "(({expr}) ? \"true\" : \"false\")"
                return
            var conv as int is 0
            var sb2 as ref to frozen byte is bytes of spec
            set conv is ((sb2 at ((spec length) - 1)) to int)
            if conv == 111 or conv == 117 or conv == 120 or conv == 88:
                calling fmt.append with "%{spec}"
                calling args.append with "((unsigned int)({expr}))"
                return
            if conv == 101 or conv == 69 or conv == 102 or conv == 70 or conv == 103 or conv == 71:
                calling fmt.append with "%{spec}"
                calling args.append with "((double)({expr}))"
                return
            calling fmt.append with "%{spec}"
            calling args.append with "((int32_t)({expr}))"
            return
        var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
        if t.kind == tk.SemaTypeKind.TkBase:
            var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), t.name)
            defer banish bn
            if bn == "string":
                calling fmt.append with "%.*s"
                calling args.append with "(int){expr}.len"
                calling args.append with ", "
                calling args.append with "{expr}.data"
                return
            if bn == "float" or bn == "f32" or bn == "f64" or bn == "double":
                # El runtime reconoce `%f` y lo renderiza como `%g`; `%g` literal
                # no es una especificación soportada.
                calling fmt.append with "%f"
                calling args.append with "((double)({expr}))"
                return
            if bn == "bool":
                calling fmt.append with "%s"
                calling args.append with "(({expr}) ? \"true\" : \"false\")"
                return
            if bn == "u64" or bn == "usize" or bn == "uint64" or bn == "uintptr":
                calling fmt.append with "%llu"
                calling args.append with "((unsigned long long)({expr}))"
                return
            if bn == "i64" or bn == "isize" or bn == "int64" or bn == "intptr":
                calling fmt.append with "%lld"
                calling args.append with "((long long)({expr}))"
                return
            calling fmt.append with "%d"
            calling args.append with "((int32_t)({expr}))"
            return
    if ty >= 0:
        var ot as tk.SemaType is calling types.at with (sigil of c->program->types), ty
        if ot.kind == tk.SemaTypeKind.TkOmen:
            # Nombre de la variante: `%s` con un switch inline.
            var oi as types.SemaNominalInfo is (c->program->types.nominal_infos at ot.a)
            var lay as bool is calling omen_has_layout with c, ty
            var sb3 as StringBuilder is calling StringBuilder.new
            defer banish sb3
            calling sb3.append with "__extension__(({ const char* _on; switch (("
            calling sb3.append with expr
            calling sb3.append with ")"
            if lay:
                calling sb3.append with ".tag"
            calling sb3.append with ") { "
            var vi as int is 0
            while vi < oi.variants_count:
                var vv as types.SemaVariant is (c->program->types.variants at (oi.variants_first + vi))
                var vn3 as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), vv.name)
                var vc3 as string is calling omen_variant_c_name with c, ty, vv.name
                calling sb3.append with "case "
                calling sb3.append with vc3
                calling sb3.append with ": _on = \""
                calling sb3.append with vn3
                calling sb3.append with "\"; break; "
                banish vc3
                banish vn3
                set vi is vi + 1
            calling sb3.append with "default: _on = \"?\"; } _on; }))"
            calling fmt.append with "%s"
            calling args.append with (calling sb3.finish)
            return
    # `%s` de `pengu_string_format_ex` lee un `const char*`, no un
    # `PenguString` (que es una struct): pasar la struct por varargs desalinea
    # el argumento siguiente y las interpolaciones posteriores del mismo
    # literal imprimen valores falsos.
    calling fmt.append with "%s"
    calling args.append with "\"\""

## Campo nominal de un tipo por nombre.
##
## ## Memoria
## O(campos).
weave nominal_field_type with c as ref to context.CgContext, ty as int, fname as int into int:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind != tk.SemaTypeKind.TkRune and t.kind != tk.SemaTypeKind.TkEcho:
        return -1
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + i))
        if f.name == fname:
            return f.type
        set i is i + 1
    return -1

## Devuelve el índice del `StringInfo` del literal `node`, o `-1`.
##
## ## Memoria
## O(literales).
weave find_string_info with c as ref to context.CgContext, node as int into int:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var ns as int is calling astutil.start_of with (sigil of m.parse.ast), node
    var ne as int is calling astutil.end_of with (sigil of m.parse.ast), node
    var i as int is 0
    while i < m.lex.strings.len:
        var si as psstate.StringInfo is (m.lex.strings at i)
        if si.has_interp and si.content_start >= ns and si.content_end <= ne:
            return i
        set i is i + 1
    return -1

## Devuelve el índice del `SemaInterp` de un segmento, o `-1`.
##
## ## Memoria
## O(interpolaciones del módulo).
weave find_interp with m as ref to loader.SemaModule, node as int, pstart as int, pend as int into int:
    var i as int is 0
    while i < m->interps.len:
        var it as loader.SemaInterp is (m->interps at i)
        if it.node == node and it.part_start == pstart and it.part_end == pend:
            return i
        set i is i + 1
    # Los offsets del `StringInfo` son únicos dentro del módulo; el sema puede
    # haber guardado el nodo padre (p. ej. un `pos_arg`) en vez del `string_lit`.
    set i is 0
    while i < m->interps.len:
        var it2 as loader.SemaInterp is (m->interps at i)
        if it2.part_start == pstart and it2.part_end == pend:
            return i
        set i is i + 1
    return -1

## Tipo de retorno de una llamada a método dentro de una interpolación.
##
## El sema de interpolaciones no anota el nodo raíz de `calling obj.method`,
## así que `node_type` devuelve `-1`. La especialización ya existe cuando se
## llama a esta función: se busca por nombre y tipo receptor y se lee el tipo
## de retorno de su símbolo. Es el único caso en el que el codegen necesita
## recuperar un tipo que el sema ya conocía.
##
## ## Memoria
## CgTarget.text es owned; se libera aquí.
weave interp_call_type with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into int:
    var tgt as int is calling astutil.node_child with ast, node, 0
    if tgt < 0:
        return -1
    var rt as CgTarget is calling resolve_target with c, tgt, ast, true
    defer banish rt.text
    if rt.type_id <= 0:
        return -1
    var last as int is calling last_token_deep with ast, tgt
    if last < 0:
        return -1
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var mname as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), last
    var mid as int is calling npool.intern with (sigil of c->program->names), mname
    banish mname
    var i as int is c->catalog.functions.len - 1
    while i >= 0:
        var f as catalog.CgFunction is (c->catalog.functions at i)
        if f.is_method and f.name == mid and f.recv_type == rt.type_id:
            var sy as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), f.symbol
            var st as tk.SemaType is calling types.at with (sigil of c->program->types), sy.type
            var guard as int is 0
            while guard < 8 and (st.kind == tk.SemaTypeKind.TkRef or st.kind == tk.SemaTypeKind.TkFrozen):
                set st is calling types.at with (sigil of c->program->types), st.a
                set guard is guard + 1
            if st.kind == tk.SemaTypeKind.TkFn:
                var fi as types.SemaFnInfo is (c->program->types.fn_infos at st.a)
                # No materializar tipos nominales durante el codegen de una
                # interpolación: la lista de structs ya se ordenó antes. Si el
                # retorno ya es concreto, se usa tal cual.
                if not (calling ctype.type_has_param with (sigil of c->program->types), fi.return_type):
                    return fi.return_type
                return calling generics.subst_spec_type_of with c, f, fi.return_type
            return -1
        set i is i - 1
    return -1

## Añade un texto literal al formato, escapando C y `%`.
##
## ## Memoria
## Strings owned.
weave append_format_text with fmt as ref to StringBuilder, text as string into void:
    # El texto se añade sin escapar: `interp_expr` escapa el formato completo
    # una sola vez al construir el literal C. Escapar aquí también convertía
    # `"` en `\\"` y rompía `#line`, consts y firmas del autocontenido.
    var b as ref to frozen byte is bytes of text
    var i as int is 0
    var n as int is text length
    while i < n:
        var code as int is ((b at i) to int)
        if code == 37:
            calling fmt.append with "%%"
        else:
            var one as string is text at i to (i + 1)
            calling fmt.append with one
            banish one
        set i is i + 1

## Resuelve un camino simple `a.b.c` / `self->x` para una interpolación cuyo
## AST no quedó asociado al literal. Devuelve texto/type o text vacío.
##
## ## Memoria
## Devuelve `text` owned; liberar con `banish`.
weave interp_path_c with c as ref to context.CgContext, txt as string into CgTarget:
    var n as int is txt length
    var b as ref to frozen byte is bytes of txt
    var i as int is 0
    var base as string is ""
    var ty as int is -1
    # Primer identificador.
    var st as int is i
    while i < n:
        var ch as int is ((b at i) to int)
        var ok as bool is (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or (ch >= 48 and ch <= 57) or ch == 95
        if not ok:
            break
        set i is i + 1
    if i == st:
        return with text is (calling npool.copy_string with ""), type_id is -1
    var first as string is txt at st to i
    if first == "self":
        var snid as int is calling npool.intern with (sigil of c->program->names), "self"
        var sty as int is calling context.local_type with c, snid
        if sty > 0:
            set ty is sty
        else:
            set ty is c->self_type
        set base is "self"
    else:
        var pid as int is calling npool.intern with (sigil of c->program->names), first
        var lc as int is calling context.local_c_name with c, pid
        if lc < 0:
            banish first
            return with text is (calling npool.copy_string with ""), type_id is -1
        set ty is calling context.local_type with c, pid
        set base is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), lc)
    banish first
    while i < n:
        var sep as string is "."
        if ((b at i) to int) == 46:
            set i is i + 1
        else if ((b at i) to int) == 45 and i + 1 < n and ((b at (i + 1)) to int) == 62:
            set sep is "->"
            set i is i + 2
        else:
            banish base
            return with text is (calling npool.copy_string with ""), type_id is -1
        var fs as int is i
        while i < n:
            var ch2 as int is ((b at i) to int)
            var ok2 as bool is (ch2 >= 65 and ch2 <= 90) or (ch2 >= 97 and ch2 <= 122) or (ch2 >= 48 and ch2 <= 57) or ch2 == 95
            if not ok2:
                break
            set i is i + 1
        if i == fs:
            banish base
            return with text is (calling npool.copy_string with ""), type_id is -1
        var fld as string is txt at fs to i
        var fid as int is calling npool.intern with (sigil of c->program->names), fld
        var fty as int is calling cg_field_type with c, ty, fid
        if fty <= 0:
            banish fld
            banish base
            return with text is (calling npool.copy_string with ""), type_id is -1
        var nxt as string is "{base}{sep}{fld}"
        banish base
        banish fld
        set base is nxt
        set ty is fty
    return with text is base, type_id is ty

## Emite una interpolación usando los AST/anotaciones que guardó el sema.
##
## ## Memoria
## Strings owned.
weave interp_expr with c as ref to context.CgContext, node as int, content as string into string:
    var fmt as StringBuilder is calling StringBuilder.new
    defer banish fmt
    var args as StringBuilder is calling StringBuilder.new
    defer banish args
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var si_idx as int is calling find_string_info with c, node
    if si_idx < 0:
        var esc0 as string is calling emit.escape_c with content
        defer banish esc0
        return "pengu_string_from_cstr(\"{esc0}\")"
    var si as psstate.StringInfo is (m.lex.strings at si_idx)
    var midx as int is c->current_module
    var pi as int is 0
    var nargs as int is 0
    while pi < si.part_count:
        var part as psstate.StringPart is (m.lex.parts at (si.part_start + pi))
        if part.kind == SegText:
            var txt as string is ""
            if not si.is_raw and not si.is_triple:
                var rsp as psource.ByteSpan is with start is part.start, end is part.end
                var rawtxt as string is calling m.source.slice with rsp
                set txt is calling psdecode.decode_text with rawtxt, false
                banish rawtxt
            else:
                set txt is calling psdecode.decode_part with (sigil of m.source), part, si.is_raw, si.is_triple, si.dedent, si.content_start
            calling append_format_text with (sigil of fmt), txt
            banish txt
        else:
            if nargs > 0:
                calling args.append with ", "
            var ii as int is calling find_interp with (sigil of m), node, part.start, part.end
            if ii < 0:
                # Fallback para interpolaciones cuyo AST no quedó asociado al
                # literal (p. ej. literales dentro de bloques anidados de un
                # módulo con insignia). Si el segmento es un identificador
                # local, su tipo y nombre C están en el contexto.
                var ptxt as string is calling m.source.slice with (with start is part.start, end is part.end)
                var simple as bool is (ptxt length) > 0
                var pk as int is 0
                var pb as ref to frozen byte is bytes of ptxt
                while pk < ptxt length:
                    var pc as int is ((pb at pk) to int)
                    var is_alpha as bool is (pc >= 65 and pc <= 90) or (pc >= 97 and pc <= 122) or pc == 95
                    var is_digit as bool is pc >= 48 and pc <= 57
                    if pk == 0:
                        if not is_alpha:
                            set simple is false
                    else:
                        if not (is_alpha or is_digit):
                            set simple is false
                    set pk is pk + 1
                var used as bool is false
                if simple:
                    var pid as int is calling npool.intern with (sigil of c->program->names), ptxt
                    var lty as int is calling context.local_type with c, pid
                    if lty > 0:
                        var lcn as int is calling context.local_c_name with c, pid
                        if lcn >= 0:
                            var ltxt as string is calling npool.text with (sigil of c->program->names), lcn
                            calling append_interp_value with c, (sigil of fmt), (sigil of args), ltxt, lty, ""
                            set used is true
                if not used:
                    var path as CgTarget is calling interp_path_c with c, ptxt
                    if path.type_id > 0 and path.text length > 0:
                        calling append_interp_value with c, (sigil of fmt), (sigil of args), path.text, path.type_id, ""
                        set used is true
                    banish path.text
                banish ptxt
                if not used:
                    calling fmt.append with "%s"
                    calling args.append with "\"\""
            else:
                var it as loader.SemaInterp is (m.interps at ii)
                # Emite con una copia del programa cuyo módulo actual es el
                # AST de la interpolación. No muta el SemaProgram original: el
                # codegen sigue usando el AST principal al terminar.
                # Emite con el AST de la interpolación instalado temporalmente
                # en el módulo actual. Se restaura al terminar para que el
                # codegen siga usando el AST principal. No se copia el
                # programa: una copia dejaría fuera las specs y los tipos
                # descubiertos durante la interpolación.
                var oldmod as loader.SemaModule is (c->program->modules at midx)
                var tmpmod as loader.SemaModule is oldmod
                set tmpmod.source is it.parse.source
                set tmpmod.lex is it.parse.lex
                set tmpmod.parse is with ok is true, root is it.parse.root, ast is it.parse.ast, error_count is 0
                set tmpmod.annotations is it.annotations
                set c->program->modules at midx is tmpmod
                var expr_c as string is calling emit_expr with c, it.parse.root
                var ty as int is calling node_type with c, it.parse.root
                var is_tp as bool is false
                if ty > 0:
                    var ity as tk.SemaType is calling types.at with (sigil of c->program->types), ty
                    set is_tp is ity.kind == tk.SemaTypeKind.TkTypeParam
                if ty < 0 or is_tp:
                    set ty is calling interp_call_type with c, it.parse.root, (sigil of tmpmod.parse.ast)
                set c->program->modules at midx is oldmod
                if expr_c == "":
                    calling fmt.append with "%s"
                    calling args.append with "\"\""
                else:
                    calling append_interp_value with c, (sigil of fmt), (sigil of args), expr_c, ty, it.spec
                banish expr_c
            set nargs is nargs + 1
        set pi is pi + 1
    var fmt_text as string is calling fmt.finish
    defer banish fmt_text
    var escfmt as string is calling emit.escape_c with fmt_text
    defer banish escfmt
    var argtext as string is calling args.finish
    defer banish argtext
    if argtext == "":
        return "pengu_string_from_cstr(\"{escfmt}\")"
    return "pengu_string_format_ex(\"{escfmt}\", {argtext})"
