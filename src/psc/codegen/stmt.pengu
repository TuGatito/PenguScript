## psc/codegen/stmt.pengu — statements C.
##
## CP0 cubre returns, declaraciones locales, bloques y expresiones-statement.
## El resto de statements se añade por subfases manteniendo `emit_stmt`.

import psc.ast.kind as pskind
import psc.ast.node as psast
import psc.sema.ast as astutil
import psc.sema.annotate as ann
import psc.sema.types.convert as convert
import psc.sema.types.kind as tk
import psc.sema.names as npool
import psc.sema.symbols.symbol as sym
import psc.sema.symbols.table as symbols
import psc.sema.modules.loader as loader
import psc.codegen.generics as generics
import psc.sema.types.table as types
import psc.sema.types.compat as compat

import psc.codegen.context as context
import psc.codegen.ctype as ctype
import psc.codegen.drop as drop
import psc.codegen.emit as emit
import psc.codegen.expr as expr
import psc.codegen.origin as origin
import psc.codegen.type_ast as tast
import psc.codegen.comptime as ctime

insignia psc_codegen_stmt_

## Convierte un nodo de tipo AST a `TypeId`.
##
## ## Memoria
## Puede añadir diagnósticos F3; no posee strings.
weave type_from_ast with c as ref to context.CgContext, m as loader.SemaModule, node as int into int:
    return calling tast.from_ast with c, m, node

## Abre un scope C para `defer` y `break`/`continue`.
##
## ## Memoria
## Añade marcas POD al contexto.
weave begin_scope with c as ref to context.CgContext, is_loop as bool into void:
    calling context.cg_scope_push with c, is_loop

## Emite los `defer` pendientes del scope actual y lo cierra.
##
## ## Memoria
## Vacía el tramo de defers; los nodos son del AST.
weave end_scope with c as ref to context.CgContext into void:
    calling emit_pending_defers with c
    calling emit_pending_drops with c
    calling context.cg_scope_pop with c

## Emite el cuerpo de un bloque sin abrir/cerrar scope C.
##
## ## Memoria
## Strings owned en cada línea.
weave emit_block_body with c as ref to context.CgContext, block as int into void:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var ast as ref to psast.PsAst is (sigil of m.parse.ast)
    var i as int is 0
    var n as int is calling astutil.child_count with ast, block
    while i < n:
        var s as int is calling astutil.node_child with ast, block, i
        if s >= 0:
            calling emit_stmt with c, s
        set i is i + 1

## Emite un bloque de statements con su propio scope C.
##
## ## Memoria
## Strings owned en cada línea.
weave emit_block with c as ref to context.CgContext, block as int into void:
    calling begin_scope with c, false
    calling emit_block_body with c, block
    calling end_scope with c

## Emite el cuerpo de un loop con scope marcado como loop.
##
## ## Memoria
## Strings owned en cada línea.
weave emit_loop_block with c as ref to context.CgContext, block as int into void:
    calling begin_scope with c, true
    calling emit_block_body with c, block
    calling end_scope with c

## Reduce un bloque (`block`/`do_expr`) en posición de valor a una expresión C.
##
## Emite las sentencias del bloque dentro de una statement expression GNU
## (`__extension__(({ … }))`) y devuelve el valor de la última expresión.
## Lo instala `bundle` en `c->block_value` para evitar el ciclo expr→stmt.
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave block_value with c as ref to context.CgContext, node as int, expected as int into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var ast as ref to psast.PsAst is (sigil of m.parse.ast)
    var rt as int is expected
    if rt <= 0:
        set rt is calling expr.node_type with c, node
    if rt <= 0:
        set rt is 1
    var ct as string is calling ctype.c_type with (sigil of c->names), rt
    defer banish ct
    var is_void as bool is ct == "void"
    var n as int is calling astutil.child_count with ast, node
    var valix as int is -1
    if n > 0:
        var last as int is calling astutil.node_child with ast, node, n - 1
        if last >= 0 and (calling astutil.kind_of with ast, last) == pskind.NodeKind.NdStmt:
            set last is calling astutil.node_child with ast, last, 0
        if last >= 0 and (calling astutil.kind_of with ast, last) == pskind.NodeKind.NdExprStmt:
            set valix is calling astutil.node_child with ast, last, 0
    var saved as emit.CgEmitter is c->emitter
    set c->emitter is calling emit.new_emitter
    calling begin_scope with c, false
    var i as int is 0
    while i < n:
        var s as int is calling astutil.node_child with ast, node, i
        if s >= 0 and (is_void or i != n - 1 or valix < 0):
            calling emit_stmt with c, s
        set i is i + 1
    if is_void:
        calling end_scope with c
        var vbody as string is calling emit.finish with (sigil of c->emitter)
        defer banish vbody
        set c->emitter is saved
        var vsb as StringBuilder is calling StringBuilder.new
        defer banish vsb
        calling vsb.append with "__extension__(({"
        calling vsb.append with "\n"
        calling vsb.append with vbody
        calling vsb.append with "}))"
        return calling vsb.finish
    var val as string is "0"
    if valix >= 0:
        # La expresión final del bloque es una línea PenguScript propia; sin
        # este marcador hereda la línea del último statement y los breakpoints
        # sobre ella caen en la línea equivocada.
        calling origin.marker with c, m, valix
        set val is calling expr.emit_expr_as with c, valix, rt
    defer banish val
    calling end_scope with c
    var body as string is calling emit.finish with (sigil of c->emitter)
    defer banish body
    set c->emitter is saved
    var tmp as string is calling emit.temp with (sigil of c->emitter), "_pb"
    defer banish tmp
    var nl as string is "\n"
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "__extension__(({"
    calling sb.append with nl
    calling sb.append with body
    calling sb.append with ct
    calling sb.append with " {tmp} = {val};"
    calling sb.append with nl
    calling sb.append with "{tmp}; }))"
    return calling sb.finish

## Emite un statement.
##
## ## Memoria
## No posee el AST; libera strings temporales.
weave emit_stmt with c as ref to context.CgContext, node as int into void:
    if node < 0:
        return
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var ast as ref to psast.PsAst is (sigil of m.parse.ast)
    var k as pskind.NodeKind is calling astutil.kind_of with ast, node
    if k == pskind.NodeKind.NdStmt:
        var inner as int is calling astutil.node_child with ast, node, 0
        calling emit_stmt with c, inner
        return
    if k == pskind.NodeKind.NdDoExpr:
        var dn as int is calling astutil.child_count with ast, node
        var di as int is 0
        while di < dn:
            var dc as int is calling astutil.node_child with ast, node, di
            if dc >= 0:
                calling emit_stmt with c, dc
            set di is di + 1
        return
    calling origin.marker with c, m, node
    if k == pskind.NodeKind.NdBlock:
        calling emit.line with (sigil of c->emitter), "{"
        calling emit.indent_more with (sigil of c->emitter)
        calling emit_block with c, node
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "}"
        return
    if k == pskind.NodeKind.NdReturnStmt or k == pskind.NodeKind.NdReturnSimple:
        var e as int is calling astutil.node_child with ast, node, 0
        if e >= 0:
            # Un `return err_of ...` es una salida de error: ejecuta los
            # `errdefer` registrados antes de devolver.
            if (calling astutil.kind_of with ast, e) == pskind.NodeKind.NdCallingExpr:
                var ertgt as int is calling astutil.node_child with ast, e, 0
                var errtok as int is calling expr.last_token_deep with ast, ertgt
                if errtok >= 0:
                    var erm as loader.SemaModule is (c->program->modules at c->current_module)
                    var ertxt as string is calling astutil.token_text with (sigil of erm.source), (sigil of erm.lex), errtok
                    defer banish ertxt
                    if ertxt == "err_of" or ertxt == "err":
                        calling emit_errdefers with c
            var rcnt as int is calling astutil.child_count with ast, node
            if rcnt > 1 and c->return_type >= 0:
                var rtt as tk.SemaType is calling types.at with (sigil of c->program->types), c->return_type
                if rtt.kind == tk.SemaTypeKind.TkTuple:
                    var tsb as StringBuilder is calling StringBuilder.new
                    defer banish tsb
                    var tct0 as string is calling ctype.c_type with (sigil of c->names), c->return_type
                    defer banish tct0
                    if c->options.family == "cpp":
                        calling tsb.append with "{tct0}{"
                    else:
                        calling tsb.append with "({tct0}){"
                    var ti0 as int is 0
                    while ti0 < rcnt:
                        var te as int is calling astutil.node_child with ast, node, ti0
                        if te >= 0:
                            var tv as string is calling expr.emit_expr with c, te
                            var lbl0 as string is "first"
                            if ti0 == 1:
                                set lbl0 is "second"
                            else if ti0 == 2:
                                set lbl0 is "third"
                            else if ti0 > 2:
                                set lbl0 is "field{ti0}"
                            if ti0 > 0:
                                calling tsb.append with ", "
                            calling tsb.append with ".{lbl0} = {tv}"
                            banish tv
                        set ti0 is ti0 + 1
                    calling tsb.append with "}"
                    var tval as string is calling tsb.finish
                    defer banish tval
                    calling emit_all_defers with c
                    calling emit_all_drops with c
                    calling emit.line with (sigil of c->emitter), "return {tval};"
                    return
            # Devolver un local `Drop` lo mueve: su destructor automático no
            # debe ejecutarse al salir (el valor sale de la función).
            if (calling astutil.kind_of with ast, e) == pskind.NodeKind.NdVarRef:
                var mv as int is calling astutil.token_child with ast, e, 0
                if mv >= 0:
                    var mvtxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), mv
                    var mvid as int is calling npool.intern with (sigil of c->program->names), mvtxt
                    banish mvtxt
                    var mv_c as int is calling context.local_c_name with c, mvid
                    if mv_c >= 0:
                        calling context.remove_drop with c, mv_c
            var v as string is ""
            if c->return_type >= 0 and (calling astutil.kind_of with ast, e) == pskind.NodeKind.NdVarRef:
                var rt as tk.SemaType is calling types.at with (sigil of c->program->types), c->return_type
                if rt.kind == tk.SemaTypeKind.TkOmen:
                    var vtok as int is calling astutil.token_child with ast, e, 0
                    if vtok >= 0:
                        var vtxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), vtok
                        var vid2 as int is calling npool.intern with (sigil of c->program->names), vtxt
                        if (calling context.local_c_name with c, vid2) >= 0:
                            set vid2 is -1
                        if vid2 >= 0:
                            var pf as int is calling expr.omen_first_payload with c, c->return_type, vid2
                            var otyp as string is calling ctype.c_type with (sigil of c->names), c->return_type
                            var ov as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), vid2)
                            var obsb as StringBuilder is calling StringBuilder.new
                            defer banish obsb
                            if calling expr.omen_has_layout with c, c->return_type:
                                calling obsb.append with "("
                                calling obsb.append with otyp
                                calling obsb.append with "){.tag = "
                                calling obsb.append with otyp
                                calling obsb.append with "_"
                                calling obsb.append with ov
                                calling obsb.append with "}"
                            else:
                                calling obsb.append with otyp
                                calling obsb.append with "_"
                                calling obsb.append with ov
                            set v is calling obsb.finish
                            banish otyp
                            banish ov
                            banish vtxt
            if v == "":
                set v is calling expr.emit_expr_as with c, e, c->return_type
            defer banish v
            if (c->defers.len > 0 or c->drop_names.len > 0) and c->return_type >= 0:
                var rct as string is calling ctype.c_type with (sigil of c->names), c->return_type
                defer banish rct
                var rtmp as string is calling emit.temp with (sigil of c->emitter), "_ret"
                defer banish rtmp
                calling emit.line with (sigil of c->emitter), "{rct} {rtmp} = {v};"
                calling emit_all_defers with c
                calling emit_all_drops with c
                calling emit.line with (sigil of c->emitter), "return {rtmp};"
                return
            calling emit_all_defers with c
            calling emit_all_drops with c
            calling emit.line with (sigil of c->emitter), "return {v};"
        else:
            calling emit_all_defers with c
            calling emit_all_drops with c
            calling emit.line with (sigil of c->emitter), "return;"
        return
    if k == pskind.NodeKind.NdVarDecl or k == pskind.NodeKind.NdLetDecl or k == pskind.NodeKind.NdStaticVarDecl:
        calling emit_local with c, node, ast
        return
    if k == pskind.NodeKind.NdBanishExpr or k == pskind.NodeKind.NdBanishStmt:
        calling emit_defer with c, node
        return
    if k == pskind.NodeKind.NdDeferStmt:
        var d as int is calling astutil.node_child with ast, node, 0
        if d >= 0:
            calling context.add_defer with c, d
        return
    if k == pskind.NodeKind.NdSetStmt or k == pskind.NodeKind.NdSetSimple:
        var tgt as int is calling astutil.node_child with ast, node, 0
        var valn as int is calling astutil.node_child with ast, node, 1
        if tgt >= 0 and valn >= 0:
            set c->writing_target is true
            var ttxt as string is calling target_text with c, tgt, ast
            set c->writing_target is false
            defer banish ttxt
            var ti_node as int is tgt
            if (calling astutil.kind_of with ast, tgt) == pskind.NodeKind.NdSetTarget:
                set ti_node is calling astutil.node_child with ast, tgt, 0
            var ti0 as expr.CgTarget is calling expr.resolve_target with c, ti_node, ast, false
            defer banish ti0.text
            var write_ty as int is ti0.type_id
            var deref_target as string is ""
            var vty as int is -1
            if write_ty > 0:
                set vty is calling expr.node_type with c, valn
                var vkind_node as int is valn
                var vguard as int is 0
                while vkind_node >= 0 and vguard < 8:
                    var vk as pskind.NodeKind is calling astutil.kind_of with (sigil of m.parse.ast), vkind_node
                    if vk != pskind.NodeKind.NdParenExpr and vk != pskind.NodeKind.NdStmt:
                        break
                    set vkind_node is calling astutil.node_child with (sigil of m.parse.ast), vkind_node, 0
                    set vguard is vguard + 1
                var force_value as bool is false
                if vkind_node >= 0:
                    var fvk as pskind.NodeKind is calling astutil.kind_of with (sigil of m.parse.ast), vkind_node
                    set force_value is fvk == pskind.NodeKind.NdWithInitExpr or fvk == pskind.NodeKind.NdStructInit
                if (vty <= 0 and force_value) or (vty > 0 and not (calling compat.compatible with (sigil of c->program->types), vty, write_ty)):
                    var wuid as int is calling types.underlying with (sigil of c->program->types), write_ty
                    var wty as tk.SemaType is calling types.at with (sigil of c->program->types), wuid
                    if wty.kind == tk.SemaTypeKind.TkRef:
                        var wpoi as int is calling types.strip_frozen with (sigil of c->program->types), wty.a
                        if vty <= 0 or calling compat.compatible with (sigil of c->program->types), vty, wpoi:
                            set write_ty is wpoi
                            set deref_target is "(*( {ttxt}))"
            var vtxt as string is ""
            if write_ty >= 0:
                set vtxt is calling expr.emit_expr_as with c, valn, write_ty
            else:
                set vtxt is calling expr.emit_expr with c, valn
            defer banish vtxt
            if deref_target != "":
                calling emit.line with (sigil of c->emitter), "{deref_target} = {vtxt};"
                banish deref_target
            else:
                if write_ty > 0 and (calling is_drop_type with c, write_ty):
                    # Asignar a un `Drop` libera el valor anterior (idempotente).
                    var same as bool is false
                    if (calling astutil.kind_of with ast, valn) == pskind.NodeKind.NdVarRef:
                        var stok as int is calling astutil.token_child with ast, valn, 0
                        if stok >= 0:
                            var stxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), stok
                            defer banish stxt
                            if stxt == ttxt:
                                set same is true
                    if not same:
                        calling drop.emit_drop_value with c, write_ty, ttxt
                        calling drop.note_move_source with c, valn, ast
                if not (write_ty > 0 and (calling is_drop_type with c, write_ty)):
                    if calling value_is_place with c, valn, ast:
                        calling drop.emit_cow_promote_source with c, (calling drop.cow_kind_of with c, write_ty), valn, ast
                calling emit.line with (sigil of c->emitter), "{ttxt} = {vtxt};"
                calling share_assigned with c, write_ty, valn, ast, ttxt
        return
    if k == pskind.NodeKind.NdCompoundSetStmt or k == pskind.NodeKind.NdCompoundSetSimple:
        var ctgt as int is calling astutil.node_child with ast, node, 0
        var cval as int is calling astutil.node_child with ast, node, 2
        var cop as string is calling astutil.child_token_text with (sigil of m.source), (sigil of m.lex), ast, node, 1
        defer banish cop
        if ctgt >= 0 and cval >= 0 and cop != "":
            var cttxt as string is calling target_text with c, ctgt, ast
            defer banish cttxt
            var ci_node as int is ctgt
            if (calling astutil.kind_of with ast, ctgt) == pskind.NodeKind.NdSetTarget:
                set ci_node is calling astutil.node_child with ast, ctgt, 0
            var ci0 as expr.CgTarget is calling expr.resolve_target with c, ci_node, ast, false
            defer banish ci0.text
            var cvtxt as string is ""
            if ci0.type_id >= 0:
                set cvtxt is calling expr.emit_expr_as with c, cval, ci0.type_id
            else:
                set cvtxt is calling expr.emit_expr with c, cval
            defer banish cvtxt
            # `set s += v` sobre `string` no es una suma de punteros: concatena
            # y libera el buffer anterior si era del valor.
            var c_is_str as bool is false
            if ci0.type_id > 0:
                var cty as tk.SemaType is calling types.at with (sigil of c->program->types), ci0.type_id
                if cty.kind == tk.SemaTypeKind.TkBase:
                    var cnm as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), cty.name)
                    if cnm == "string":
                        set c_is_str is true
                    banish cnm
            # `set xs += v` sobre `list` empuja un elemento (v se copia).
            var c_is_list as bool is false
            if ci0.type_id > 0:
                var lty0 as tk.SemaType is calling types.at with (sigil of c->program->types), ci0.type_id
                if lty0.kind == tk.SemaTypeKind.TkList:
                    set c_is_list is true
            if c_is_list and cop == "+=":
                var let as string is calling ctype.c_type with (sigil of c->names), (calling types.at with (sigil of c->program->types), ci0.type_id).a
                defer banish let
                var lv as string is calling emit.temp with (sigil of c->emitter), "_lv"
                calling emit.line with (sigil of c->emitter), "{let} {lv} = {cvtxt};"
                calling emit.line with (sigil of c->emitter), "pengu_list_push(&({cttxt}), &{lv});"
            else if c_is_str and cop == "+=" and (calling expr.text_owns_temp with c, cvtxt):
                calling emit.line with (sigil of c->emitter), "pengu_string_append_owned(&({cttxt}), {cvtxt});"
            else if c_is_str and cop == "+=":
                calling emit.line with (sigil of c->emitter), "pengu_string_append(&({cttxt}), {cvtxt});"
            else:
                calling emit.line with (sigil of c->emitter), "{cttxt} {cop} {cvtxt};"
        return
    if k == pskind.NodeKind.NdBreakStmt or k == pskind.NodeKind.NdBreakSimple:
        var blbl as int is calling astutil.token_child with ast, node, 0
        calling emit_loop_exit_defers with c
        calling emit_loop_exit_drops with c
        if blbl >= 0:
            var btxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), blbl
            defer banish btxt
            var bc as string is calling context.safe_ident with c, btxt
            defer banish bc
            calling emit.line with (sigil of c->emitter), "goto _pengu_label_{bc}_break;"
        else:
            calling emit.line with (sigil of c->emitter), "break;"
        return
    if k == pskind.NodeKind.NdContinueStmt or k == pskind.NodeKind.NdContinueSimple:
        var clbl as int is calling astutil.token_child with ast, node, 0
        calling emit_loop_exit_defers with c
        calling emit_loop_exit_drops with c
        if clbl >= 0:
            var ctxt2 as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), clbl
            defer banish ctxt2
            var cc as string is calling context.safe_ident with c, ctxt2
            defer banish cc
            calling emit.line with (sigil of c->emitter), "goto _pengu_label_{cc}_continue;"
        else:
            calling emit.line with (sigil of c->emitter), "continue;"
        return
    if k == pskind.NodeKind.NdIfStmt or k == pskind.NodeKind.NdUnlessStmt:
        calling emit_if with c, node, ast, k == pskind.NodeKind.NdUnlessStmt
        return
    if k == pskind.NodeKind.NdWhenStmt:
        calling emit_when_stmt with c, node, ast
        return
    if k == pskind.NodeKind.NdForRangeStmt:
        var frname as int is calling astutil.token_child with ast, node, 0
        var frstart as int is calling astutil.node_child with ast, node, 1
        var frend as int is calling astutil.node_child with ast, node, 2
        var frstep as int is calling astutil.node_child with ast, node, 3
        var frbody as int is calling astutil.node_child with ast, node, 4
        if frname >= 0 and frstart >= 0 and frend >= 0 and frbody >= 0:
            var frtxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), frname
            var frnid as int is calling npool.intern with (sigil of c->program->names), frtxt
            banish frtxt
            var ity as int is calling types.base with (sigil of c->program->types), "int"
            var sv as string is calling expr.emit_expr with c, frstart
            defer banish sv
            var ev as string is calling expr.emit_expr with c, frend
            defer banish ev
            var stv as string is ""
            if frstep >= 0:
                set stv is calling expr.emit_expr with c, frstep
            else:
                set stv is calling npool.copy_string with "1"
            defer banish stv
            var cn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), frnid)
            var lbl as string is calling loop_label_c with c, ast, node
            defer banish lbl
            calling context.push_loop with c, (calling npool.copy_string with lbl)
            calling emit_loop_mark with c, lbl
            calling emit.line with (sigil of c->emitter), "for (int32_t {cn} = {sv}; ((({stv}) > 0) ? ({cn} < {ev}) : ({cn} > {ev})); {cn} += {stv})"
            calling emit.line with (sigil of c->emitter), "{"
            calling emit.indent_more with (sigil of c->emitter)
            calling begin_scope with c, true
            calling context.add_local with c, frnid, ity, frnid
            calling emit_block_body with c, frbody
            calling emit_continue_label with c, lbl
            calling end_scope with c
            calling emit.indent_less with (sigil of c->emitter)
            calling emit_loop_close with c, lbl
            calling context.pop_loop with c
            banish cn
        return
    if k == pskind.NodeKind.NdForInStmt:
        calling emit_for_in with c, node, ast
        return
    if k == pskind.NodeKind.NdWhileStmt:
        var cond as int is calling astutil.node_child with ast, node, 0
        var body as int is calling astutil.node_child with ast, node, 1
        if cond >= 0 and body >= 0:
            var cv as string is calling expr.emit_expr with c, cond
            defer banish cv
            var wlbl as string is calling loop_label_c with c, ast, node
            defer banish wlbl
            calling context.push_loop with c, (calling npool.copy_string with wlbl)
            calling emit_loop_mark with c, wlbl
            calling emit.line with (sigil of c->emitter), "while ({cv}) {"
            calling emit.indent_more with (sigil of c->emitter)
            calling emit_loop_block with c, body
            calling emit_continue_label with c, wlbl
            calling emit.indent_less with (sigil of c->emitter)
            calling emit_loop_close with c, wlbl
            calling context.pop_loop with c
        return
    if k == pskind.NodeKind.NdExprStmt or k == pskind.NodeKind.NdSimpleStmt:
        var e2 as int is calling astutil.node_child with ast, node, 0
        if e2 >= 0:
            calling emit_expr_statement with c, e2, ast
        return
    if k == pskind.NodeKind.NdWithStmt:
        var wtgt as int is calling astutil.node_child with ast, node, 0
        if wtgt >= 0:
            var wtv as string is calling expr.emit_expr with c, wtgt
            var wtt as int is calling expr.node_type with c, wtgt
            if wtt <= 0:
                set wtt is calling expr.guess_type with c, wtgt, ast
            # El receptor se evalúa UNA vez: `T* _wN = &(expr)` y el cuerpo ve
            # `(*_wN).campo`. Un `with` sobre algo no direccionable ya lo
            # rechazó el sema (E0077).
            var wptr as bool is false
            var wct as string is ""
            if wtt > 0:
                var wu as int is calling types.underlying with (sigil of c->program->types), wtt
                var wut as tk.SemaType is calling types.at with (sigil of c->program->types), wu
                if wut.kind == tk.SemaTypeKind.TkRune or wut.kind == tk.SemaTypeKind.TkEcho:
                    set wptr is true
                    set wct is calling ctype.c_type with (sigil of c->names), wu
            calling emit.line with (sigil of c->emitter), "{"
            calling emit.indent_more with (sigil of c->emitter)
            calling begin_scope with c, false
            if wptr:
                var wt as string is calling emit.temp with (sigil of c->emitter), "_w"
                calling emit.line with (sigil of c->emitter), "{wct}* {wt} = &({wtv});"
                # `push_with` toma el texto: no liberarlo aquí (doble free).
                var wref as string is "(*{wt})"
                calling context.push_with with c, wref, wtt
                banish wt
                banish wct
                banish wtv
            else:
                # `push_with` se queda con el texto: no liberarlo aquí.
                calling context.push_with with c, wtv, wtt
            var wi as int is 1
            var wn as int is calling astutil.child_count with ast, node
            while wi < wn:
                var wch as int is calling astutil.node_child with ast, node, wi
                if wch >= 0:
                    calling emit_stmt with c, wch
                set wi is wi + 1
            calling context.pop_with with c
            calling end_scope with c
            calling emit.indent_less with (sigil of c->emitter)
            calling emit.line with (sigil of c->emitter), "}"
        return
    if k == pskind.NodeKind.NdUnsafeStmt:
        var ub as int is calling astutil.node_child with ast, node, 0
        if ub >= 0:
            calling emit.line with (sigil of c->emitter), "{"
            calling emit.indent_more with (sigil of c->emitter)
            set c->unsafe_depth is c->unsafe_depth + 1
            calling begin_scope with c, false
            if (calling astutil.kind_of with ast, ub) == pskind.NodeKind.NdBlock:
                calling emit_block_body with c, ub
            else:
                calling emit_stmt with c, ub
            calling end_scope with c
            set c->unsafe_depth is c->unsafe_depth - 1
            calling emit.indent_less with (sigil of c->emitter)
            calling emit.line with (sigil of c->emitter), "}"
        return
    if k == pskind.NodeKind.NdErrdeferStmt:
        var ed as int is calling astutil.node_child with ast, node, 0
        if ed >= 0:
            calling context.add_errdefer with c, ed
        return
    # Fallback: una expresión-statement sin tipo.
    var v3 as string is calling expr.emit_expr with c, node
    defer banish v3
    calling emit.line with (sigil of c->emitter), "(void)({v3});"

## Emite una expresión como statement, incluyendo las llamadas a métodos
## `@mutates` (que se asignan de vuelta al receptor).
##
## ## Memoria
## Strings owned.
weave emit_expr_statement with c as ref to context.CgContext, e2 as int, ast as ref to psast.PsAst into void:
    if e2 < 0:
        return
    if (calling astutil.kind_of with ast, e2) == pskind.NodeKind.NdBanishExpr:
        calling emit_defer with c, e2
        return
    if (calling astutil.kind_of with ast, e2) == pskind.NodeKind.NdJudgeExpr:
        calling emit_judge_stmt with c, e2, ast
        return
    var v2 as string is calling expr.emit_expr with c, e2
    defer banish v2
    var m2 as loader.SemaModule is (c->program->modules at c->current_module)
    var asid2 as int is calling ann.symbol_of with (sigil of m2.annotations), e2
    var mutating2 as bool is false
    var mut_recv as int is -1
    if asid2 >= 0:
        var asv2 as sym.SemaSymbol is calling symbols.symbol_at with (sigil of c->program->symbols), asid2
        if (asv2.flags & sym.SYM_MUTATING) != 0 and (asv2.flags & sym.SYM_GET_ALIAS) == 0:
            set mutating2 is true
            set mut_recv is (calling expr.node_type with c, e2)
    if mutating2:
        var tgt2 as int is calling astutil.node_child with ast, e2, 0
        var rtv as expr.CgTarget is calling expr.resolve_target with c, tgt2, ast, true
        defer banish rtv.text
        # Método promovido: la asignación de vuelta va al campo del embed, no al
        # host (el embed no sabe que es un embed).
        var host_ty as int is rtv.type_id
        if host_ty <= 0:
            var tbase as int is calling astutil.node_child with ast, tgt2, 0
            if tbase >= 0:
                set host_ty is calling expr.node_type with c, tbase
        var fixed as string is calling expr.with_embed_path with c, rtv.text, host_ty, mut_recv, (calling expr.receiver_is_pointer with c, rtv, false)
        defer banish fixed
        calling emit.line with (sigil of c->emitter), "{fixed} = {v2};"
    else:
        calling emit.line with (sigil of c->emitter), "(void)({v2});"

## Emite un `for var in start to end`.
##
## ## Memoria
## Strings owned.
weave emit_for_in with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into void:
    var name_tok as int is calling astutil.token_child with ast, node, 0
    var name_tok2 as int is calling astutil.token_child with ast, node, 1
    var indexed as bool is name_tok2 >= 0
    var range_slot as int is 1
    var body_slot as int is 2
    if indexed:
        set range_slot is 2
        set body_slot is 3
    var range as int is calling astutil.node_child with ast, node, range_slot
    var body as int is calling astutil.node_child with ast, node, body_slot
    if name_tok < 0 or range < 0 or body < 0:
        return
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var ntxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), name_tok
    defer banish ntxt
    var nid as int is calling npool.intern with (sigil of c->program->names), ntxt
    var cn as string is ""
    if ntxt == "_":
        set cn is calling emit.temp with (sigil of c->emitter), "_discard"
    else:
        set cn is calling context.safe_ident with c, ntxt
    defer banish cn
    # Segundo binding del `for i, item in ...`.
    var nid2 as int is -1
    var ntxt2 as string is calling npool.copy_string with ""
    defer banish ntxt2
    var cn2 as string is calling npool.copy_string with ""
    defer banish cn2
    if indexed:
        banish ntxt2
        set ntxt2 is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), name_tok2
        set nid2 is calling npool.intern with (sigil of c->program->names), ntxt2
        banish cn2
        if ntxt2 == "_":
            set cn2 is calling emit.temp with (sigil of c->emitter), "_discard"
        else:
            set cn2 is calling context.safe_ident with c, ntxt2
    var rk as pskind.NodeKind is calling astutil.kind_of with ast, range
    if rk == pskind.NodeKind.NdToExpr:
        var lo as int is calling astutil.node_child with ast, range, 0
        var hi as int is calling astutil.node_child with ast, range, 1
        var lo_t as string is calling expr.emit_expr with c, lo
        defer banish lo_t
        var hi_t as string is calling expr.emit_expr with c, hi
        defer banish hi_t
        calling emit.line with (sigil of c->emitter), "for (int32_t {cn} = {lo_t}; {cn} < {hi_t}; {cn}++) {"
        calling emit.indent_more with (sigil of c->emitter)
        if ntxt != "_":
            calling context.add_local with c, nid, 1, nid
        calling emit_loop_block with c, body
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "}"
        return
    # Iteración sobre lista.
    var lt as int is calling expr.node_type with c, range
    if lt < 0:
        return
    var lty as tk.SemaType is calling types.at with (sigil of c->program->types), lt
    # Iteración sobre mapa (`for k in map` / `for i, k in map`). El iterador del
    # runtime recorre la tabla CC sin asignar una lista temporal, así que
    # `break`, `continue` y `return` dentro del cuerpo son seguros.
    if lty.kind == tk.SemaTypeKind.TkMap:
        var kt as string is calling ctype.c_type with (sigil of c->names), lty.a
        defer banish kt
        var mexpr as string is calling expr.emit_expr with c, range
        defer banish mexpr
        var mtmp as string is calling emit.temp with (sigil of c->emitter), "_map"
        defer banish mtmp
        var itmp as string is calling emit.temp with (sigil of c->emitter), "_mi"
        defer banish itmp
        var mlbl as string is calling loop_label_c with c, ast, node
        defer banish mlbl
        calling context.push_loop with c, (calling npool.copy_string with mlbl)
        calling emit_loop_mark with c, mlbl
        calling emit.line with (sigil of c->emitter), "PenguMap {mtmp} = {mexpr};"
        calling emit.line with (sigil of c->emitter), "PenguMapIter {itmp} = pengu_map_iter_begin(&{mtmp});"
        var vt as string is calling ctype.c_type with (sigil of c->names), lty.b
        defer banish vt
        if indexed:
            # Dos bindings sobre un mapa son CLAVE y VALOR (no índice y clave):
            # el orden de un mapa es de hash, así que un índice no significa nada.
            calling emit.line with (sigil of c->emitter), "for (; pengu_map_iter_valid(&{itmp}); pengu_map_iter_advance(&{itmp})) {"
            calling emit.indent_more with (sigil of c->emitter)
            calling emit.line with (sigil of c->emitter), "{kt} {cn} = (*(const {kt}*)pengu_map_iter_key(&{itmp}));"
            calling emit.line with (sigil of c->emitter), "(void){cn};"
            calling emit.line with (sigil of c->emitter), "{vt} {cn2} = (*(const {vt}*)pengu_map_iter_value(&{itmp}));"
            calling emit.line with (sigil of c->emitter), "(void){cn2};"
            if ntxt != "_":
                calling context.add_local with c, nid, lty.a, nid
                calling context.mark_borrowed with c, nid
            if ntxt2 != "_":
                calling context.add_local with c, nid2, lty.b, nid2
                calling context.mark_borrowed with c, nid2
        else:
            calling emit.line with (sigil of c->emitter), "for (; pengu_map_iter_valid(&{itmp}); pengu_map_iter_advance(&{itmp})) {"
            calling emit.indent_more with (sigil of c->emitter)
            calling emit.line with (sigil of c->emitter), "{kt} {cn} = (*(const {kt}*)pengu_map_iter_key(&{itmp}));"
            calling emit.line with (sigil of c->emitter), "(void){cn};"
            if ntxt != "_":
                calling context.add_local with c, nid, lty.a, nid
                calling context.mark_borrowed with c, nid
        calling emit_loop_block with c, body
        calling emit_continue_label with c, mlbl
        calling emit.indent_less with (sigil of c->emitter)
        calling emit_loop_close with c, mlbl
        calling context.pop_loop with c
        # Sólo un valor propio: una llamada o un literal. `essence of x` es una
        # vista prestada del mapa original y liberarla corrompería el dueño.
        if rk == pskind.NodeKind.NdCallingExpr or rk == pskind.NodeKind.NdMapLit:
            calling emit.line with (sigil of c->emitter), "pengu_banish_map(&{mtmp});"
        return
    if lty.kind == tk.SemaTypeKind.TkArray or lty.kind == tk.SemaTypeKind.TkSlice or lty.kind == tk.SemaTypeKind.TkRange or (lty.kind == tk.SemaTypeKind.TkBase and (calling compat.is_string with (sigil of c->program->types), lt)):
        var aet as string is calling ctype.c_type with (sigil of c->names), lty.a
        defer banish aet
        var aexpr as string is calling expr.emit_expr with c, range
        defer banish aexpr
        var atmp as string is calling emit.temp with (sigil of c->emitter), "_it"
        var aidx as string is calling emit.temp with (sigil of c->emitter), "_ix"
        defer banish atmp
        defer banish aidx
        var albl as string is calling loop_label_c with c, ast, node
        defer banish albl
        calling context.push_loop with c, (calling npool.copy_string with albl)
        calling emit_loop_mark with c, albl
        if lty.kind == tk.SemaTypeKind.TkRange:
            calling emit.line with (sigil of c->emitter), "PenguRange {atmp} = {aexpr};"
            if indexed:
                calling emit.line with (sigil of c->emitter), "for (int32_t {cn} = (int32_t)({atmp}).start; {cn} < (int32_t)({atmp}).end; {cn}++) {"
                calling emit.indent_more with (sigil of c->emitter)
                calling emit.line with (sigil of c->emitter), "int32_t {cn2} = {cn};"
                if ntxt != "_":
                    calling context.add_local with c, nid, 1, nid
                if ntxt2 != "_":
                    calling context.add_local with c, nid2, lty.a, nid2
            else:
                calling emit.line with (sigil of c->emitter), "for (int32_t {cn} = (int32_t)({atmp}).start; {cn} < (int32_t)({atmp}).end; {cn}++) {"
                calling emit.indent_more with (sigil of c->emitter)
                if ntxt != "_":
                    calling context.add_local with c, nid, lty.a, nid
        else:
            if lty.kind == tk.SemaTypeKind.TkArray:
                calling emit.line with (sigil of c->emitter), "{aet}* {atmp} = {aexpr};"
            else if lty.kind == tk.SemaTypeKind.TkSlice:
                calling emit.line with (sigil of c->emitter), "PenguSlice {atmp} = {aexpr};"
            else:
                calling emit.line with (sigil of c->emitter), "PenguString {atmp} = {aexpr};"
            # Un array es un puntero sin `.len`: su longitud es la del tipo.
            var alen as string is "0"
            if lty.kind == tk.SemaTypeKind.TkArray:
                set alen is "{lty.b}"
            else:
                set alen is "{atmp}.len"
            if indexed:
                calling emit.line with (sigil of c->emitter), "for (int {aidx} = 0; {aidx} < {alen}; {aidx}++) {"
                calling emit.indent_more with (sigil of c->emitter)
                calling emit.line with (sigil of c->emitter), "int32_t {cn} = {aidx};"
            else:
                calling emit.line with (sigil of c->emitter), "for (int {aidx} = 0; {aidx} < {alen}; {aidx}++) {"
                calling emit.indent_more with (sigil of c->emitter)
            if lty.kind == tk.SemaTypeKind.TkArray:
                if indexed:
                    calling emit.line with (sigil of c->emitter), "{aet} {cn2} = ({atmp})[{aidx}];"
                    calling emit.line with (sigil of c->emitter), "(void){cn2};"
                    calling emit.line with (sigil of c->emitter), "(void){cn};"
                else:
                    calling emit.line with (sigil of c->emitter), "{aet} {cn} = ({atmp})[{aidx}];"
                    calling emit.line with (sigil of c->emitter), "(void){cn};"
            else if lty.kind == tk.SemaTypeKind.TkSlice:
                if indexed:
                    calling emit.line with (sigil of c->emitter), "{aet} {cn2} = (*( {aet}*)pengu_slice_at(&{atmp}, {aidx}));"
                    calling emit.line with (sigil of c->emitter), "(void){cn2};"
                    calling emit.line with (sigil of c->emitter), "(void){cn};"
                else:
                    calling emit.line with (sigil of c->emitter), "{aet} {cn} = (*( {aet}*)pengu_slice_at(&{atmp}, {aidx}));"
                    calling emit.line with (sigil of c->emitter), "(void){cn};"
            else:
                # Vista prestada de un byte: iterar no reserva memoria.
                if indexed:
                    calling emit.line with (sigil of c->emitter), "PenguString {cn2} = (PenguString){{ (char*)({atmp}).data + {aidx}, 1, 0 }};"
                    calling emit.line with (sigil of c->emitter), "(void){cn2};"
                    calling emit.line with (sigil of c->emitter), "(void){cn};"
                else:
                    calling emit.line with (sigil of c->emitter), "PenguString {cn} = (PenguString){{ (char*)({atmp}).data + {aidx}, 1, 0 }};"
                    calling emit.line with (sigil of c->emitter), "(void){cn};"
            if indexed:
                if ntxt != "_":
                    calling context.add_local with c, nid, 1, nid
                if ntxt2 != "_":
                    calling context.add_local with c, nid2, lty.a, nid2
                    calling context.mark_borrowed with c, nid2
            else:
                if ntxt != "_":
                    calling context.add_local with c, nid, lty.a, nid
                    calling context.mark_borrowed with c, nid
        calling emit_loop_block with c, body
        calling emit_continue_label with c, albl
        calling emit.indent_less with (sigil of c->emitter)
        calling emit_loop_close with c, albl
        calling context.pop_loop with c
        return
    if lty.kind != tk.SemaTypeKind.TkList:
        return
    var et as string is calling ctype.c_type with (sigil of c->names), lty.a
    defer banish et
    var lexpr as string is calling expr.emit_expr with c, range
    defer banish lexpr
    var tmp as string is calling emit.temp with (sigil of c->emitter), "_lst"
    defer banish tmp
    var idxt as string is calling emit.temp with (sigil of c->emitter), "_li"
    defer banish idxt
    var llbl as string is calling loop_label_c with c, ast, node
    defer banish llbl
    calling context.push_loop with c, (calling npool.copy_string with llbl)
    calling emit_loop_mark with c, llbl
    calling emit.line with (sigil of c->emitter), "PenguList {tmp} = {lexpr};"
    if indexed:
        calling emit.line with (sigil of c->emitter), "for (int32_t {cn} = 0; {cn} < {tmp}.len; {cn}++) {"
        calling emit.indent_more with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "{et} {cn2} = (*( {et}*)pengu_list_at(&{tmp}, {cn}));"
        calling emit.line with (sigil of c->emitter), "(void){cn2};"
        calling emit.line with (sigil of c->emitter), "(void){cn};"

        if ntxt != "_":
            calling context.add_local with c, nid, 1, nid
        if ntxt2 != "_":
            calling context.add_local with c, nid2, lty.a, nid2
            calling context.mark_borrowed with c, nid2
    else:
        calling emit.line with (sigil of c->emitter), "for (int {idxt} = 0; {idxt} < {tmp}.len; {idxt}++) {"
        calling emit.indent_more with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "{et} {cn} = (*( {et}*)pengu_list_at(&{tmp}, {idxt}));"
        calling emit.line with (sigil of c->emitter), "(void){cn};"

        if ntxt != "_":
            calling context.add_local with c, nid, lty.a, nid
            calling context.mark_borrowed with c, nid
    calling emit_loop_block with c, body
    calling emit_continue_label with c, llbl
    calling emit.indent_less with (sigil of c->emitter)
    calling emit_loop_close with c, llbl
    calling context.pop_loop with c
    # Una lista temporal (`[1, 2]` o el retorno de una llamada) es dueña de su
    # buffer: se libera al terminar el bucle para no filtrarla. Un `at` o un
    # campo son vistas prestadas y no se tocan.
    if rk == pskind.NodeKind.NdCallingExpr or rk == pskind.NodeKind.NdListInitExpr or rk == pskind.NodeKind.NdArrayLit:
        calling emit.line with (sigil of c->emitter), "pengu_banish_list(&{tmp});"

## Emite una rama de `when` (bloque o statement).
##
## ## Memoria
## Strings owned.
weave emit_when_branch with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into void:
    if node < 0:
        return
    if (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdBlock:
        calling emit_block with c, node
        return
    # Sin scope propio: el llamante abre uno para toda la rama, de modo que
    # los `defer` de sus sentencias se ejecuten al cerrar la rama, no cada una.
    calling emit_stmt with c, node

## Emite un `when` comptime como statement.
##
## El AST tiene `cond` + N statements + `else` opcional; no asumir que el
## segundo hijo es el cuerpo y el tercero el `else` (ese supuesto perdía todas
## las sentencias intermedias).
##
## ## Memoria
## Strings owned; los nodos son del AST.
weave emit_when_stmt with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into void:
    var cond as int is calling astutil.node_child with ast, node, 0
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var v as int is calling ctime.evaluate with c->options, m, cond
    if v < 0:
        set c->errors is c->errors + 1
        return
    var n as int is calling astutil.child_count with ast, node
    var i as int is 1
    if v == 1:
        # Un solo scope para toda la rama activa: si cada sentencia abriera el
        # suyo, los `defer` se ejecutarían al cerrar su propia sentencia.
        calling begin_scope with c, false
        while i < n:
            var ch as int is calling astutil.node_child with ast, node, i
            if ch >= 0:
                var ck as pskind.NodeKind is calling astutil.kind_of with ast, ch
                if ck == pskind.NodeKind.NdWhenElsePlain or ck == pskind.NodeKind.NdWhenElseWhen:
                    break
                calling emit_when_branch with c, ch, ast
            set i is i + 1
        calling end_scope with c
        return
    # Rama inactiva: saltar el cuerpo hasta el `else`.
    while i < n:
        var ch2 as int is calling astutil.node_child with ast, node, i
        if ch2 >= 0:
            var ck2 as pskind.NodeKind is calling astutil.kind_of with ast, ch2
            if ck2 == pskind.NodeKind.NdWhenElsePlain or ck2 == pskind.NodeKind.NdWhenElseWhen:
                break
        set i is i + 1
    if i >= n:
        return
    var els as int is calling astutil.node_child with ast, node, i
    var ek as pskind.NodeKind is calling astutil.kind_of with ast, els
    if ek == pskind.NodeKind.NdWhenElseWhen:
        var nested as int is calling astutil.node_child with ast, els, 0
        if nested >= 0:
            calling emit_when_stmt with c, nested, ast
        return
    var j as int is 0
    var en as int is calling astutil.child_count with ast, els
    calling begin_scope with c, false
    while j < en:
        var e as int is calling astutil.node_child with ast, els, j
        if e >= 0:
            calling emit_when_branch with c, e, ast
        set j is j + 1
    calling end_scope with c

## Emite `if NAME as T is maybe:` / `unless ...`.
##
## El `maybe` se materializa una sola vez en un temporal para no evaluar dos
## veces la expresión, y el binding se declara dentro del bloque del `if`.
##
## ## Memoria
## Strings owned.
weave emit_if_binding with c as ref to context.CgContext, node as int, cond_node as int, ast as ref to psast.PsAst, negate as bool into void:
    var name_tok as int is calling astutil.token_child with ast, cond_node, 0
    var type_node as int is calling astutil.node_child with ast, cond_node, 1
    var value_node as int is calling astutil.node_child with ast, cond_node, 2
    var body as int is calling astutil.node_child with ast, node, 1
    if name_tok < 0 or type_node < 0 or value_node < 0 or body < 0:
        return
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var ntxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), name_tok
    defer banish ntxt
    var nid as int is calling npool.intern with (sigil of c->program->names), ntxt
    var cn as string is calling context.safe_ident with c, ntxt
    defer banish cn
    var ty as int is calling type_from_ast with c, m, type_node
    var ct as string is calling ctype.c_type with (sigil of c->names), ty
    defer banish ct
    var ve as string is calling expr.emit_expr with c, value_node
    defer banish ve
    var tmp as string is calling emit.temp with (sigil of c->emitter), "_maybe"
    defer banish tmp
    calling emit.line with (sigil of c->emitter), "{"
    calling emit.indent_more with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "PenguMaybe {tmp} = {ve};"
    if negate:
        calling emit.line with (sigil of c->emitter), "if (!{tmp}.is_present) {"
    else:
        calling emit.line with (sigil of c->emitter), "if ({tmp}.is_present) {"
    calling emit.indent_more with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "{ct} {cn} = (*( {ct}*)({tmp}).value);"
    calling context.add_local with c, nid, ty, nid
    calling emit_block with c, body
    calling emit.indent_less with (sigil of c->emitter)
    var els as int is calling astutil.node_child with ast, node, 2
    if els >= 0:
        var eb as int is calling astutil.node_child with ast, els, 0
        if eb >= 0 and (calling astutil.kind_of with ast, eb) == pskind.NodeKind.NdIfStmt:
            calling emit.line with (sigil of c->emitter), "} else"
            calling emit_if with c, eb, ast, false
            calling emit.indent_less with (sigil of c->emitter)
            calling emit.line with (sigil of c->emitter), "}"
            return
        if eb >= 0:
            calling emit.line with (sigil of c->emitter), "} else {"
            calling emit.indent_more with (sigil of c->emitter)
            calling begin_scope with c, false
            var ej as int is 0
            var ecount as int is calling astutil.child_count with ast, els
            while ej < ecount:
                var ech as int is calling astutil.node_child with ast, els, ej
                if ech >= 0:
                    if (calling astutil.kind_of with ast, ech) == pskind.NodeKind.NdBlock:
                        calling emit_block with c, ech
                    else:
                        calling emit_stmt with c, ech
                set ej is ej + 1
            calling end_scope with c
            calling emit.indent_less with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "}"
    calling emit.indent_less with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "}"

## Emite un `if`/`unless`.
##
## ## Memoria
## Strings owned.
weave emit_if with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, negate as bool into void:
    var cond_node as int is calling astutil.node_child with ast, node, 0
    var body as int is calling astutil.node_child with ast, node, 1
    if cond_node < 0 or body < 0:
        return
    if (calling astutil.kind_of with ast, cond_node) == pskind.NodeKind.NdIfCondBinding:
        calling emit_if_binding with c, node, cond_node, ast, negate
        return
    var cond as int is cond_node
    if (calling astutil.kind_of with ast, cond_node) == pskind.NodeKind.NdIfCond:
        set cond is calling astutil.node_child with ast, cond_node, 0
    var cv as string is calling expr.emit_expr with c, cond
    defer banish cv
    var wrapped as bool is false
    if (cv length) >= 2 and (cv at 0 to 1) == "(" and (cv at ((cv length) - 1) to (cv length)) == ")":
        set wrapped is true
    if negate:
        if wrapped:
            calling emit.line with (sigil of c->emitter), "if (!{cv}) {"
        else:
            calling emit.line with (sigil of c->emitter), "if (!({cv})) {"
    else:
        if wrapped:
            calling emit.line with (sigil of c->emitter), "if {cv} {"
        else:
            var ifcond as string is "if ({cv})"
            if calling emit.wrapped_parens with cv:
                set ifcond is "if {cv}"
            calling emit.line with (sigil of c->emitter), "{ifcond} {"
    calling emit.indent_more with (sigil of c->emitter)
    calling emit_block with c, body
    calling emit.indent_less with (sigil of c->emitter)
    var els as int is calling astutil.node_child with ast, node, 2
    if els >= 0:
        var eb as int is calling astutil.node_child with ast, els, 0
        if eb >= 0 and (calling astutil.kind_of with ast, eb) == pskind.NodeKind.NdIfStmt:
            calling emit.line with (sigil of c->emitter), "} else"
            calling emit_if with c, eb, ast, false
            return
        if eb >= 0:
            calling emit.line with (sigil of c->emitter), "} else {"
            calling emit.indent_more with (sigil of c->emitter)
            calling begin_scope with c, false
            var ej as int is 0
            var ecount as int is calling astutil.child_count with ast, els
            while ej < ecount:
                var ech as int is calling astutil.node_child with ast, els, ej
                if ech >= 0:
                    if (calling astutil.kind_of with ast, ech) == pskind.NodeKind.NdBlock:
                        calling emit_block with c, ech
                    else:
                        calling emit_stmt with c, ech
                set ej is ej + 1
            calling end_scope with c
            calling emit.indent_less with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "}"

## Texto C de un target de asignación simple.
##
## ## Memoria
## Devuelve string owned.
## `true` si `txt` es un nombre simple de variable local (sin `.`, `->`, `[`,
## `(` ni espacios). Se usa para decidir si un `set` puede liberar el valor
## anterior: un campo o un elemento pueden ser memoria sin inicializar.
weave simple_place_text with txt as string into bool:
    if calling txt.len == 0:
        return false
    var bp as ref to frozen byte is bytes of txt
    var i as int is 0
    while i < calling txt.len:
        var b as int is ((bp at i) to int)
        if b == 46 or b == 62 or b == 91 or b == 40 or b == 32 or b == 42 or b == 45:
            return false
        set i is i + 1
    return true

weave target_text with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into string:
    var k as pskind.NodeKind is calling astutil.kind_of with ast, node
    if k == pskind.NodeKind.NdSetTarget:
        return calling target_text with c, (calling astutil.node_child with ast, node, 0), ast
    if k == pskind.NodeKind.NdNormalTarget or k == pskind.NodeKind.NdWithTarget:
        var rt is calling expr.resolve_target with c, node, ast, false
        return rt.text
    if k == pskind.NodeKind.NdEssenceTarget:
        var en as int is calling astutil.node_child with ast, node, 0
        var et as string is calling expr.emit_expr with c, en
        defer banish et
        return "(*( {et}))"
    return "0"

## Emite y vacía los `defer` del scope C actual, en orden LIFO.
##
## ## Memoria
## Vacía el tramo de defers; los nodos son del AST.
weave emit_pending_defers with c as ref to context.CgContext into void:
    var mark as int is calling context.current_scope_mark with c
    var i as int is c->defers.len - 1
    while i >= mark:
        calling emit_defer with c, (c->defers at i)
        set i is i - 1
    var n as int is c->defers.len
    while n > mark:
        var ignored as int is calling c->defers.pop
        set n is n - 1

## Emite todos los `defer` pendientes (salida de función).
##
## ## Memoria
## Vacía la lista; los nodos son del AST.
weave emit_all_defers with c as ref to context.CgContext into void:
    var i as int is c->defers.len - 1
    while i >= 0:
        calling emit_defer with c, (c->defers at i)
        set i is i - 1

## Emite los `defer` de los scopes que abandona un `break`/`continue`.
##
## Recorre de dentro hacia fuera hasta el loop más interno (incluido).
##
## ## Memoria
## Vacía el tramo de defers; los nodos son del AST.
weave emit_loop_exit_defers with c as ref to context.CgContext into void:
    var mark as int is 0
    var i as int is c->scope_loops.len - 1
    var found as bool is false
    while i >= 0 and not found:
        if (c->scope_loops at i):
            set mark is (c->scope_marks at i)
            set found is true
        set i is i - 1
    if not found:
        return
    var d as int is c->defers.len - 1
    while d >= mark:
        calling emit_defer with c, (c->defers at d)
        set d is d - 1

## Emite los destructores automáticos pendientes del scope actual.
##
## Va después de los `defer` del mismo scope: lo escrito a mano corre primero
## y el destructor automático cierra lo que quedó vivo.
##
## ## Memoria
## Vacía el tramo de drops.
weave emit_pending_drops with c as ref to context.CgContext into void:
    var mark as int is calling context.current_drop_mark with c
    var i as int is c->drop_names.len - 1
    while i >= mark:
        calling emit_one_drop with c, i
        set i is i - 1
    var n as int is c->drop_names.len
    while n > mark:
        var ignored as int is calling c->drop_names.pop
        var ignored_t as int is calling c->drop_types.pop
        set n is n - 1

## Emite todos los destructores automáticos pendientes (salida de función).
##
## ## Memoria
## O(n); no vacía la lista (el `return` termina el cuerpo).
weave emit_all_drops with c as ref to context.CgContext into void:
    var i as int is c->drop_names.len - 1
    while i >= 0:
        calling emit_one_drop with c, i
        set i is i - 1

## Emite los destructores de los scopes que abandona un `break`/`continue`.
##
## ## Memoria
## O(n); no vacía la lista (los scopes lo harán al cerrarse).
weave emit_loop_exit_drops with c as ref to context.CgContext into void:
    var mark as int is 0
    var i as int is c->scope_loops.len - 1
    var found as bool is false
    while i >= 0 and not found:
        if (c->scope_loops at i):
            set mark is (c->drop_marks at i)
            set found is true
        set i is i - 1
    if not found:
        return
    var d as int is c->drop_names.len - 1
    while d >= mark:
        calling emit_one_drop with c, d
        set d is d - 1

## Emite el destructor de una entrada de `drop_names` (`type = -1` = movida).
##
## ## Memoria
## C owned; el nombre se copia para el emisor.
weave emit_one_drop with c as ref to context.CgContext, idx as int into void:
    var ty as int is (c->drop_types at idx)
    if ty < 0:
        return
    var nid as int is (c->drop_names at idx)
    var nm as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), nid)
    defer banish nm
    calling drop.emit_drop_value with c, ty, nm

## Nombre C de la etiqueta del loop (`""` si no tiene).
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave loop_label_c with c as ref to context.CgContext, ast as ref to psast.PsAst, node as int into string:
    var lt as int is calling astutil.loop_label_token with ast, node
    if lt < 0:
        return ""
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), lt
    defer banish txt
    return calling context.safe_ident with c, txt

## Declara usadas las etiquetas `break`/`continue` de un loop etiquetado.
##
## Un `goto` muerto bajo `if (0)` evita `-Wunused-label` sin cambiar la
## semántica; sólo se emite para loops que declaran etiqueta.
##
## ## Memoria
## Strings owned.
weave emit_loop_mark with c as ref to context.CgContext, lbl as string into void:
    if lbl != "":
        calling emit.line with (sigil of c->emitter), "if (0) goto _pengu_label_{lbl}_break;"
        calling emit.line with (sigil of c->emitter), "if (0) goto _pengu_label_{lbl}_continue;"

## Emite la etiqueta `continue` al final del cuerpo de un loop con etiqueta.
##
## ## Memoria
## Strings owned.
weave emit_continue_label with c as ref to context.CgContext, lbl as string into void:
    if lbl != "":
        calling emit.line with (sigil of c->emitter), "_pengu_label_{lbl}_continue: ;"

## Cierra el `}` del loop y emite su etiqueta `break` si se usa.
##
## Sólo se emite la etiqueta si el cuerpo tiene un `break label`/`continue
## label` que la nombre: una etiqueta sin usar dispara `-Wunused-label` y los
## goldens compilan con `-Werror`.
##
## ## Memoria
## Strings owned.
weave emit_loop_close with c as ref to context.CgContext, lbl as string into void:
    calling emit.line with (sigil of c->emitter), "}"
    if lbl != "":
        calling emit.line with (sigil of c->emitter), "_pengu_label_{lbl}_break: ;"

## Emite los `errdefer` pendientes (ruta de error), en orden LIFO.
##
## ## Memoria
## Strings owned; los nodos son del AST.
weave emit_errdefers with c as ref to context.CgContext into void:
    var i as int is c->errdefers.len - 1
    while i >= 0:
        calling emit_defer with c, (c->errdefers at i)
        set i is i - 1

## Emite un `defer` pendiente.
##
## ## Memoria
## Strings owned.
weave emit_defer with c as ref to context.CgContext, node as int into void:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var ast as ref to psast.PsAst is (sigil of m.parse.ast)
    var k as pskind.NodeKind is calling astutil.kind_of with ast, node
    if k == pskind.NodeKind.NdBanishExpr or k == pskind.NodeKind.NdBanishStmt:
        var v as int is calling astutil.node_child with ast, node, 0
        var vn as string is calling expr.emit_expr with c, v
        defer banish vn
        var ty as int is calling expr.node_type with c, v
        if ty < 0 and v >= 0 and (calling astutil.kind_of with ast, v) == pskind.NodeKind.NdVarRef:
            var vt as int is calling astutil.token_child with ast, v, 0
            if vt >= 0:
                var vtxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), vt
                var vnid as int is calling npool.intern with (sigil of c->program->names), vtxt
                set ty is calling context.local_type with c, vnid
                banish vtxt
        calling drop.emit_drop_value with c, ty, vn
        return
    var call as string is calling expr.emit_expr with c, node
    defer banish call
    calling emit.line with (sigil of c->emitter), "{call};"

## Emite `let (a, b) is expr` para una tupla.
##
## ## Memoria
## Strings owned.
weave emit_destructure with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, vlist as int into void:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var vn as int is -1
    var ci as int is 1
    var cn as int is calling astutil.child_count with ast, node
    while ci < cn:
        var ch as int is calling astutil.node_child with ast, node, ci
        if ch >= 0 and not (calling is_type_node with ast, ch):
            set vn is ch
        set ci is ci + 1
    if vn < 0:
        return
    var vt as int is calling expr.node_type with c, vlist
    if vt < 0:
        set vt is calling expr.node_type with c, vn
    # Un `var`/`let` con nombre simple de origen: el símbolo local manda,
    # porque la anotación del nodo puede ser el tipo de un elemento.
    if (calling astutil.kind_of with ast, vn) == pskind.NodeKind.NdVarRef:
        var rtk as int is calling astutil.token_child with ast, vn, 0
        if rtk >= 0:
            var rtx as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), rtk
            var rnid2 as int is calling npool.intern with (sigil of c->program->names), rtx
            var lvt as int is calling context.local_type with c, rnid2
            if lvt > 0:
                var ltk as tk.SemaType is calling types.at with (sigil of c->program->types), lvt
                if ltk.kind == tk.SemaTypeKind.TkRune or ltk.kind == tk.SemaTypeKind.TkTuple:
                    set vt is lvt
            banish rtx
    if vt < 0:
        return
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), vt
    if t.kind == tk.SemaTypeKind.TkRune:
        # Desestructuración de rune: campos en orden de declaración.
        var ninfo as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
        var valr as string is calling expr.emit_expr with c, vn
        defer banish valr
        var rct as string is calling ctype.c_type with (sigil of c->names), vt
        defer banish rct
        var rtmp as string is "_pengu_run{c->tmp_seq}"
        set c->tmp_seq is c->tmp_seq + 1
        calling emit.line with (sigil of c->emitter), "{rct} {rtmp} = {valr};"
        var ri as int is 0
        var rn as int is calling astutil.child_count with ast, vlist
        while ri < rn and ri < ninfo.fields_count:
            var rtok as int is calling astutil.token_child with ast, vlist, ri
            if rtok >= 0:
                var rnm as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), rtok
                var fld2 as types.SemaField is (c->program->types.fields at (ninfo.fields_first + ri))
                var fct as string is calling ctype.c_type with (sigil of c->names), fld2.type
                if rnm == "_":
                    banish fct
                else:
                    var fcd as string is calling ctype.declare with fct, rnm
                    var fnn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), fld2.name)
                    calling emit.line with (sigil of c->emitter), "{fcd} = {rtmp}.{fnn};"
                    calling emit.line with (sigil of c->emitter), "(void){rnm};"
                    var rnid as int is calling npool.intern with (sigil of c->program->names), rnm
                    calling context.add_local with c, rnid, fld2.type, rnid
                    calling context.mark_borrowed with c, rnid
                    banish fnn
                    banish fcd
                    banish fct
                banish rnm
            set ri is ri + 1
        banish rtmp
        return
    if t.kind != tk.SemaTypeKind.TkTuple:
        return
    var val as string is calling expr.emit_expr with c, vn
    defer banish val
    # La expresión se evalúa una sola vez: un temporal guarda la tupla y los
    # elementos se leen de él. Si no, `let a, b is calling f` llamaría a `f`
    # dos veces y duplicaría sus efectos.
    var tct as string is calling ctype.c_type with (sigil of c->names), vt
    var tmp as string is "_pengu_tup{c->tmp_seq}"
    set c->tmp_seq is c->tmp_seq + 1
    calling emit.line with (sigil of c->emitter), "{tct} {tmp} = {val};"
    banish tct
    var i as int is 0
    var n as int is calling astutil.child_count with ast, vlist
    while i < n and i < t.count:
        var tok as int is calling astutil.token_child with ast, vlist, i
        if tok >= 0:
            var nm as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), tok
            var cid as int is (c->program->types.type_children at (t.first + i))
            var ct as string is calling ctype.c_type with (sigil of c->names), cid
            var lab as string is "first"
            if i == 1:
                set lab is "second"
            else if i == 2:
                set lab is "third"
            var nid as int is calling npool.intern with (sigil of c->program->names), nm
            calling emit.line with (sigil of c->emitter), "{ct} {nm} = {tmp}.{lab};"
            calling context.add_local with c, nid, cid, nid
            banish ct
            banish nm
        set i is i + 1
    banish tmp

## Token del nombre de una declaración (`var` directo o `let` con lista).
##
## ## Memoria
## O(nodos).
weave decl_token with ast as ref to psast.PsAst, node as int into int:
    var t as int is calling astutil.token_child with ast, node, 0
    if t >= 0:
        return t
    var vn as int is calling astutil.node_child with ast, node, 0
    if vn >= 0:
        var t2 as int is calling astutil.token_child with ast, vn, 0
        if t2 >= 0:
            return t2
    return -1

## ¿Un nodo es un nodo de tipo?
##
## ## Memoria
## O(1).
weave is_type_node with ast as ref to psast.PsAst, node as int into bool:
    var k as pskind.NodeKind is calling astutil.kind_of with ast, node
    return k == pskind.NodeKind.NdBaseType or k == pskind.NodeKind.NdCustomType or k == pskind.NodeKind.NdRefType or k == pskind.NodeKind.NdFrozenType or k == pskind.NodeKind.NdArrayType or k == pskind.NodeKind.NdListType or k == pskind.NodeKind.NdMaybeType or k == pskind.NodeKind.NdResultType or k == pskind.NodeKind.NdMapType or k == pskind.NodeKind.NdSliceType or k == pskind.NodeKind.NdFrozenType or k == pskind.NodeKind.NdFnType or k == pskind.NodeKind.NdTupleType or k == pskind.NodeKind.NdOpaqueType

## Emite el cuerpo de un brazo de `judge` (bloque, retorno o sentencia).
##
## ## Memoria
## Strings owned; el cuerpo es del AST.
weave emit_judge_body with c as ref to context.CgContext, body as int, ast as ref to psast.PsAst into void:
    if (calling astutil.kind_of with ast, body) == pskind.NodeKind.NdBlock:
        calling emit_block with c, body
    else if c->return_type > 0:
        var rty2 as tk.SemaType is calling types.at with (sigil of c->program->types), c->return_type
        var bty2 as int is calling expr.node_type with c, body
        var btk2 as bool is false
        if bty2 > 0:
            var btt2 as tk.SemaType is calling types.at with (sigil of c->program->types), bty2
            if btt2.kind != tk.SemaTypeKind.TkVoid:
                set btk2 is true
        if rty2.kind != tk.SemaTypeKind.TkVoid and btk2 and (calling astutil.kind_of with ast, body) != pskind.NodeKind.NdCallingExpr and (calling astutil.kind_of with ast, body) != pskind.NodeKind.NdDoExpr:
            var rev as string is calling expr.emit_expr_as with c, body, c->return_type
            calling emit.line with (sigil of c->emitter), "return {rev};"
            banish rev
        else:
            calling emit_stmt with c, body
    else:
        var bcnt as int is calling astutil.child_count with ast, body
        if bcnt > 0:
            var bi as int is 0
            while bi < bcnt:
                var bc2 as int is calling astutil.node_child with ast, body, bi
                if bc2 >= 0:
                    calling emit_stmt with c, bc2
                set bi is bi + 1
        else:
            calling emit_stmt with c, body


## Enlaza los campos del payload de un brazo en el scope actual.
##
## ## Memoria
## Strings owned; los nombres son del pool.
weave judge_bind_payload with c as ref to context.CgContext, st as int, payload as int, ast as ref to psast.PsAst, stmp as string, variant as string into void:
    if payload < 0:
        return
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var pn as int is calling astutil.child_count with ast, payload
    var pi as int is 0
    while pi < pn:
        var pf as int is calling astutil.node_child with ast, payload, pi
        if pf >= 0:
            var pft as int is calling astutil.token_child with ast, pf, 0
            if pft >= 0:
                var pfn as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), pft
                var pfnid as int is calling npool.intern with (sigil of c->program->names), pfn
                var pvnt as int is calling npool.intern with (sigil of c->program->names), variant
                var pty as int is calling expr.omen_payload_field_type with c, st, pvnt, pfnid
                if pty < 0:
                    set pty is 1
                var pct as string is calling ctype.c_type with (sigil of c->names), pty
                calling emit.line with (sigil of c->emitter), "{pct} {pfn} = {stmp}.data.{variant}.{pfn};"
                calling emit.line with (sigil of c->emitter), "(void){pfn};"
                calling context.add_local with c, pfnid, pty, pfnid
                banish pct
                banish pfn
        set pi is pi + 1

## Emite el cuerpo de un brazo de `judge`.
##
## Con `vty > 0` deja el valor de la rama en `vtmp` (modo valor). Con
## `vty <= 0` ejecuta el brazo como sentencia; si la función devuelve algo,
## la última expresión del brazo se convierte en `return`.
##
## ## Memoria
## Strings owned; el AST es del programa.
weave emit_judge_arm_body with c as ref to context.CgContext, body as int, ast as ref to psast.PsAst, vty as int, vtmp as string into void:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    calling origin.marker with c, m, body
    if vty > 0:
        var bk as pskind.NodeKind is calling astutil.kind_of with ast, body
        if bk == pskind.NodeKind.NdBlock or bk == pskind.NodeKind.NdDoExpr:
            var bn as int is calling astutil.child_count with ast, body
            var bj as int is 0
            while bj < bn:
                var bs as int is calling astutil.node_child with ast, body, bj
                if bs >= 0:
                    if bj == (bn - 1):
                        var inner as int is bs
                        if (calling astutil.kind_of with ast, bs) == pskind.NodeKind.NdStmt:
                            set inner is calling astutil.node_child with ast, bs, 0
                        if inner >= 0 and (calling astutil.kind_of with ast, inner) == pskind.NodeKind.NdExprStmt:
                            var ev as int is calling astutil.node_child with ast, inner, 0
                            var evs as string is calling expr.emit_expr with c, ev
                            calling emit.line with (sigil of c->emitter), "{vtmp} = {evs};"
                            banish evs
                        else:
                            calling emit_stmt with c, bs
                    else:
                        calling emit_stmt with c, bs
                set bj is bj + 1
        else:
            var evs2 as string is calling expr.emit_expr with c, body
            calling emit.line with (sigil of c->emitter), "{vtmp} = {evs2};"
            banish evs2
    else:
        calling emit_judge_body with c, body, ast

## Etiqueta C de `case` para un token de patrón.
##
## Los números se emiten tal cual; las variantes se traducen al nombre C
## del omen. Debe llamarse sólo con sujetos conmutables (`switch`).
##
## ## Memoria
## Strings owned.
weave judge_case_label with c as ref to context.CgContext, st as int, tk as int, ast as ref to psast.PsAst into string:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), tk
    var out as string is ""
    if (txt length) > 0:
        var p0 as string is calling npool.copy_string with (txt at 0 to 1)
        if p0 == "-" or p0 == "0" or p0 == "1" or p0 == "2" or p0 == "3" or p0 == "4" or p0 == "5" or p0 == "6" or p0 == "7" or p0 == "8" or p0 == "9":
            set out is calling npool.copy_string with txt
        else:
            var vid as int is calling npool.intern with (sigil of c->program->names), txt
            set out is calling expr.omen_variant_c_name with c, st, vid
        banish p0
    banish txt
    return out

## Emite el despacho de un `judge` (sentencia o valor).
##
## Sujetos `string` y brazos con guarda se emiten como cadena de `if` con
## `expr.judge_cond_c` (no hay `switch` sobre cadenas). El resto usa
## `switch` con una etiqueta por variante de la alternancia.
##
## ## Memoria
## Strings owned; el AST es del programa.
weave emit_judge_core with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, vty as int, vtmp as string into void:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var subj as int is calling astutil.node_child with ast, node, 0
    var st as int is calling expr.node_type with c, subj
    var stt as tk.SemaType is calling types.at with (sigil of c->program->types), st
    var sct as string is calling ctype.c_type with (sigil of c->names), st
    defer banish sct
    var sub as string is calling expr.emit_expr with c, subj
    defer banish sub
    var stmp as string is calling emit.temp with (sigil of c->emitter), "_jd"
    defer banish stmp
    calling emit.line with (sigil of c->emitter), "{sct} {stmp} = {sub};"
    calling emit.line with (sigil of c->emitter), "(void){stmp};"
    if vty > 0:
        var vct as string is calling ctype.c_type with (sigil of c->names), vty
        calling emit.line with (sigil of c->emitter), "{vct} {vtmp};"
        calling emit.line with (sigil of c->emitter), "memset(&{vtmp}, 0, sizeof({vtmp}));"
        banish vct
    var is_str as bool is false
    if stt.kind == tk.SemaTypeKind.TkBase:
        var bnm as string is calling npool.text with (sigil of c->program->names), stt.name
        if bnm == "string":
            set is_str is true
        banish bnm
    var has_g as bool is false
    var cn as int is calling astutil.child_count with ast, node
    var ci as int is 0
    while ci < cn:
        var ccl as int is calling astutil.node_child with ast, node, ci
        if ccl >= 0 and (calling astutil.kind_of with ast, ccl) == pskind.NodeKind.NdWhenClause:
            var cg as int is calling astutil.node_child with ast, ccl, 2
            if cg >= 0 and (calling astutil.kind_of with ast, cg) == pskind.NodeKind.NdWhenGuard:
                set has_g is true
        set ci is ci + 1
    var has_else as bool is false
    if is_str or has_g:
        # Cadena de `if`: cadenas y guardas no caben en un `switch`.
        var endl as string is calling emit.temp with (sigil of c->emitter), "_jend"
        defer banish endl
        var armc as int is 0
        var i as int is 0
        while i < cn:
            var cl as int is calling astutil.node_child with ast, node, i
            if cl >= 0:
                var ck as pskind.NodeKind is calling astutil.kind_of with ast, cl
                if ck == pskind.NodeKind.NdWhenClause:
                    var pat as int is calling astutil.node_child with ast, cl, 0
                    var payload as int is calling astutil.node_child with ast, cl, 1
                    var body as int is calling astutil.node_child with ast, cl, 3
                    var guard as int is calling astutil.node_child with ast, cl, 2
                    if guard >= 0 and (calling astutil.kind_of with ast, guard) != pskind.NodeKind.NdWhenGuard:
                        set guard is -1
                    if body < 0:
                        set body is calling astutil.node_child with ast, cl, 2
                    if pat >= 0 and body >= 0:
                        calling origin.marker with c, m, cl
                        var cond as string is calling expr.judge_cond_c with c, st, pat, ast, stmp
                        calling emit.line with (sigil of c->emitter), "if ({cond}) {"
                        banish cond
                        calling emit.indent_more with (sigil of c->emitter)
                        if payload >= 0:
                            var vtk as int is calling pattern_variant_token with m, ast, pat, 0
                            if vtk >= 0:
                                var vtxt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), vtk
                                if (vtxt length) > 0:
                                    calling judge_bind_payload with c, st, payload, ast, stmp, vtxt
                                banish vtxt
                        if guard >= 0:
                            var gnode as int is guard
                            if (calling astutil.kind_of with ast, guard) == pskind.NodeKind.NdWhenGuard:
                                set gnode is calling astutil.node_child with ast, guard, 0
                            var gv as string is calling expr.emit_expr with c, gnode
                            calling emit.line with (sigil of c->emitter), "if ({gv}) {"
                            banish gv
                            calling emit.indent_more with (sigil of c->emitter)
                            calling emit_judge_arm_body with c, body, ast, vty, vtmp
                            calling emit.line with (sigil of c->emitter), "goto {endl};"
                            calling emit.indent_less with (sigil of c->emitter)
                            calling emit.line with (sigil of c->emitter), "}"
                        else:
                            calling emit_judge_arm_body with c, body, ast, vty, vtmp
                            calling emit.line with (sigil of c->emitter), "goto {endl};"
                        calling emit.indent_less with (sigil of c->emitter)
                        calling emit.line with (sigil of c->emitter), "}"
                        set armc is armc + 1
                else if ck == pskind.NodeKind.NdElseClause:
                    set has_else is true
                    var eb as int is calling astutil.node_child with ast, cl, 0
                    if eb < 0:
                        set eb is cl
                    calling emit_judge_arm_body with c, eb, ast, vty, vtmp
            set i is i + 1
        if armc > 0:
            calling emit.line with (sigil of c->emitter), "{endl}: ;"
    else:
        var lyt as bool is false
        if stt.kind == tk.SemaTypeKind.TkOmen and (calling expr.omen_has_layout with c, st):
            set lyt is true
        if lyt:
            calling emit.line with (sigil of c->emitter), "switch ({stmp}.tag) {"
        else:
            # El cast evita `-Wswitch-bool` con sujetos `bool`.
            calling emit.line with (sigil of c->emitter), "switch ((int64_t)({stmp})) {"
        calling emit.indent_more with (sigil of c->emitter)
        var i2 as int is 0
        while i2 < cn:
            var cl2 as int is calling astutil.node_child with ast, node, i2
            if cl2 >= 0:
                var ck2 as pskind.NodeKind is calling astutil.kind_of with ast, cl2
                if ck2 == pskind.NodeKind.NdWhenClause:
                    var pat2 as int is calling astutil.node_child with ast, cl2, 0
                    var payload2 as int is calling astutil.node_child with ast, cl2, 1
                    var body2 as int is calling astutil.node_child with ast, cl2, 3
                    var guard2 as int is calling astutil.node_child with ast, cl2, 2
                    if guard2 >= 0 and (calling astutil.kind_of with ast, guard2) != pskind.NodeKind.NdWhenGuard:
                        set guard2 is -1
                    if body2 < 0:
                        set body2 is calling astutil.node_child with ast, cl2, 2
                    if pat2 >= 0 and body2 >= 0:
                        calling origin.marker with c, m, cl2
                        var lab as list of int is list of int
                        defer banish lab
                        var scan as bool is true
                        while scan:
                            var probe as int is calling pattern_variant_token with m, ast, pat2, lab.len
                            if probe < 0:
                                set scan is false
                            else:
                                calling lab.push with probe
                        if lab.len == 0:
                            # `true`/`false` no llevan token de variante.
                            var pk0 as pskind.NodeKind is calling astutil.kind_of with ast, pat2
                            var pc0 as int is pat2
                            if pk0 == pskind.NodeKind.NdWhenPattern:
                                set pc0 is calling astutil.node_child with ast, pat2, 0
                            var blit as string is ""
                            if pc0 >= 0:
                                var pk1 as pskind.NodeKind is calling astutil.kind_of with ast, pc0
                                if pk1 == pskind.NodeKind.NdTrueLit:
                                    set blit is "true"
                                else if pk1 == pskind.NodeKind.NdFalseLit:
                                    set blit is "false"
                            if (blit length) > 0:
                                calling emit.line with (sigil of c->emitter), "case {blit}: {"
                                calling emit.indent_more with (sigil of c->emitter)
                                calling emit_judge_arm_body with c, body2, ast, vty, vtmp
                                calling emit.line with (sigil of c->emitter), "break;"
                                calling emit.indent_less with (sigil of c->emitter)
                                calling emit.line with (sigil of c->emitter), "}"
                            banish blit
                        else:
                            var pvt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), (lab at 0)
                            var li as int is 0
                            while li < lab.len:
                                var ltk as int is (lab at li)
                                var lpn as string is calling judge_case_label with c, st, ltk, ast
                                if li == (lab.len - 1):
                                    calling emit.line with (sigil of c->emitter), "case {lpn}: {"
                                else:
                                    calling emit.line with (sigil of c->emitter), "case {lpn}:"
                                banish lpn
                                set li is li + 1
                            calling emit.indent_more with (sigil of c->emitter)
                            if payload2 >= 0:
                                calling judge_bind_payload with c, st, payload2, ast, stmp, pvt
                            if guard2 >= 0:
                                var gnode2 as int is guard2
                                if (calling astutil.kind_of with ast, guard2) == pskind.NodeKind.NdWhenGuard:
                                    set gnode2 is calling astutil.node_child with ast, guard2, 0
                                var gv2 as string is calling expr.emit_expr with c, gnode2
                                calling emit.line with (sigil of c->emitter), "if (!({gv2})) break;"
                                banish gv2
                            calling emit_judge_arm_body with c, body2, ast, vty, vtmp
                            calling emit.line with (sigil of c->emitter), "break;"
                            calling emit.indent_less with (sigil of c->emitter)
                            calling emit.line with (sigil of c->emitter), "}"
                            banish pvt
                else if ck2 == pskind.NodeKind.NdElseClause:
                    set has_else is true
                    var eb2 as int is calling astutil.node_child with ast, cl2, 0
                    if eb2 < 0:
                        set eb2 is cl2
                    calling origin.marker with c, m, cl2
                    calling emit.line with (sigil of c->emitter), "default: {"
                    calling emit.indent_more with (sigil of c->emitter)
                    calling emit_judge_arm_body with c, eb2, ast, vty, vtmp
                    calling emit.line with (sigil of c->emitter), "break;"
                    calling emit.indent_less with (sigil of c->emitter)
                    calling emit.line with (sigil of c->emitter), "}"
            set i2 is i2 + 1
        if not has_else:
            calling emit.line with (sigil of c->emitter), "default: break;"
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "}"

## Emite un `judge` usado como statement: ejecuta las ramas y efectos.
##
## ## Memoria
## Strings owned.
weave emit_judge_stmt with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into void:
    calling emit_judge_core with c, node, ast, 0, ""

## Emite un `judge` cuyo cuerpo es un bloque, dejando el valor en un temporal.
##
## Se usa desde `emit_local` para no crear un ciclo `expr` -> `stmt`.
##
## ## Memoria
## Strings owned.
weave emit_judge_block_value with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst, rt as int into string:
    var rtmp as string is calling emit.temp with (sigil of c->emitter), "_jv"
    calling emit_judge_core with c, node, ast, rt, rtmp
    return rtmp

## `true` si el tipo es una runa con `derive Drop` (siguiendo alias y seals).
##
## ## Memoria
## O(profundidad del alias).
## `true` si `ty` es un handle que se copia compartiendo (`Rc`/`Weak*`).
##
## ## Memoria
## No asigna.
weave is_share_type with c as ref to context.CgContext, ty as int into bool:
    var k as int is calling drop.consortium_kind_of with c, ty
    return k == 1 or k == 2 or k == 4

## `true` si la expresión es una referencia a una variable/parámetro (un
## préstamo que hay que retener al copiarlo a un `Rc`/`Weak`).
##
## ## Memoria
## No asigna.
weave value_is_place with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into bool:
    if node < 0:
        return false
    var k as pskind.NodeKind is calling astutil.kind_of with ast, node
    return k == pskind.NodeKind.NdVarRef


## Emite el `share` de COW cuando el valor asignado viene de un lugar (otra
## variable).  Un temporal (`f(...)`, `a + b`, un literal) ya es dueño único y
## no necesita contador.
##
## ## Memoria
## O(1) si ya es COW; O(n) al promocionar un valor legacy.
weave share_assigned with c as ref to context.CgContext, ty as int, vnode as int, ast as ref to psast.PsAst, target as string into void:
    if ty <= 0:
        return
    if not (calling value_is_place with c, vnode, ast):
        return
    var cwk as int is calling drop.cow_kind_of with c, ty
    if cwk > 0:
        calling drop.emit_cow_share with c, cwk, target
        return
    # Struct con handles dentro: retener sus `string`/`list`/`map`.
    calling drop.emit_share_value with c, ty, target, 0

weave is_drop_type with c as ref to context.CgContext, ty as int into bool:
    var cur as int is ty
    var guard as int is 0
    while cur >= 0 and guard < 32:
        var t as tk.SemaType is calling types.at with (sigil of c->program->types), cur
        if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho:
            var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
            return (info.flags & types.NIF_DROP) != 0
        if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
            set cur is t.b
        else:
            return false
        set guard is guard + 1
    return false

## Registra un local y, si su tipo es `Drop`, su destructor automático.
##
## ## Memoria
## Añade a `locals` y a las pilas de drops.
weave register_local with c as ref to context.CgContext, nid as int, ty as int, cnode as int into void:
    calling context.add_local with c, nid, ty, cnode
    if calling is_drop_type with c, ty:
        var cid as int is calling context.local_c_name with c, nid
        if cid >= 0:
            calling context.add_drop with c, cid, ty

## Emite una declaración local.
##
## ## Memoria
## Añade el local al contexto.
weave emit_local with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into void:
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var vlist as int is calling astutil.node_child with ast, node, 0
    if vlist >= 0 and (calling astutil.kind_of with ast, vlist) == pskind.NodeKind.NdVarNameList and (calling astutil.child_count with ast, vlist) > 1:
        calling emit_destructure with c, node, ast, vlist
        return
    var name_tok as int is calling decl_token with ast, node
    if name_tok < 0:
        return
    var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), name_tok
    defer banish txt
    var nid as int is calling npool.intern with (sigil of c->program->names), txt
    var ty as int is -1
    var vn as int is -1
    var ci as int is 1
    var child_n as int is calling astutil.child_count with ast, node
    while ci < child_n:
        var ch as int is calling astutil.node_child with ast, node, ci
        if ch >= 0:
            if ty < 0 and (calling is_type_node with ast, ch):
                set ty is calling type_from_ast with c, m, ch
            else if vn < 0 and not (calling is_type_node with ast, ch):
                set vn is ch
        set ci is ci + 1
    if ty < 0 and vn >= 0:
        set ty is calling expr.node_type with c, vn
    if ty < 0 and vn >= 0 and (calling astutil.kind_of with ast, vn) == pskind.NodeKind.NdAtExpr:
        set ty is calling expr.infer_at_type with c, vn, ast
    if ty < 0:
        set ty is 1
    # Dentro de una especialización, `Pair of T and U` debe materializarse
    # como `Pair of int and string` (instancia concreta).
    if ty > 0 and c->names.subst.len > 0:
        set ty is calling generics.subst_codegen with c, ty
    var ct as string is calling ctype.c_type with (sigil of c->names), ty
    defer banish ct
    var cn as string is calling context.safe_ident with c, txt
    defer banish cn
    var cdecl as string is calling ctype.declare with ct, cn
    defer banish cdecl
    var jvn as int is vn
    while jvn >= 0 and (calling astutil.kind_of with ast, jvn) == pskind.NodeKind.NdParenExpr:
        set jvn is calling astutil.node_child with ast, jvn, 0

    if jvn >= 0 and ((calling astutil.kind_of with ast, jvn) == pskind.NodeKind.NdOrReturn or (calling astutil.kind_of with ast, jvn) == pskind.NodeKind.NdTryExpr):
        var ur_op as int is calling astutil.node_child with ast, jvn, 0
        if ur_op < 0:
            calling emit.line with (sigil of c->emitter), "{cdecl};"
            calling register_local with c, nid, ty, nid
            return
        var ur_op2 as int is ur_op
        while ur_op2 >= 0 and (calling astutil.kind_of with ast, ur_op2) == pskind.NodeKind.NdParenExpr:
            set ur_op2 is calling astutil.node_child with ast, ur_op2, 0
        var ur_ot as int is calling expr.node_type with c, ur_op2
        var ur_ott as tk.SemaType is calling types.at with (sigil of c->program->types), ur_ot
        var ur_pay as int is ur_ot
        if ur_ott.kind == tk.SemaTypeKind.TkMaybe or ur_ott.kind == tk.SemaTypeKind.TkResult:
            set ur_pay is ur_ott.a
        var ur_pt as string is calling ctype.c_type with (sigil of c->names), ur_pay
        defer banish ur_pt
        var ur_zero as string is calling expr.zero_value_expr with c, ty
        defer banish ur_zero
        calling emit.line with (sigil of c->emitter), "{cdecl} = {ur_zero};"
        var ur_ov as string is calling expr.emit_expr with c, ur_op
        defer banish ur_ov
        var ur_tmp as string is calling emit.temp with (sigil of c->emitter), "_u"
        defer banish ur_tmp
        if ur_ott.kind == tk.SemaTypeKind.TkMaybe:
            calling emit.line with (sigil of c->emitter), "PenguMaybe {ur_tmp} = {ur_ov};"
            calling emit.line with (sigil of c->emitter), "if ({ur_tmp}.is_present) {"
        else if ur_ott.kind == tk.SemaTypeKind.TkResult:
            calling emit.line with (sigil of c->emitter), "PenguResult {ur_tmp} = {ur_ov};"
            calling emit.line with (sigil of c->emitter), "if ({ur_tmp}.is_ok) {"
        else:
            calling emit.line with (sigil of c->emitter), "{cn} = {ur_ov};"
        if ur_ott.kind == tk.SemaTypeKind.TkMaybe:
            calling emit.line with (sigil of c->emitter), "{cn} = (*( {ur_pt}*){ur_tmp}.value);"
        else if ur_ott.kind == tk.SemaTypeKind.TkResult:
            calling emit.line with (sigil of c->emitter), "{cn} = (*( {ur_pt}*){ur_tmp}.ok_val);"
        if ur_ott.kind == tk.SemaTypeKind.TkMaybe or ur_ott.kind == tk.SemaTypeKind.TkResult:
            calling emit.line with (sigil of c->emitter), "} else {"
            calling emit.indent_more with (sigil of c->emitter)
            calling emit_errdefers with c
            # La ruta de fallo también sale de la función: los destructores
            # automáticos del cuerpo corren antes del `return`.
            calling emit_all_drops with c
            if (calling astutil.kind_of with ast, jvn) == pskind.NodeKind.NdOrReturn:
                var ur_fb as int is calling astutil.node_child with ast, jvn, 1
                if ur_fb >= 0:
                    var ur_fbv as string is calling expr.emit_expr with c, ur_fb
                    defer banish ur_fbv
                    calling emit.line with (sigil of c->emitter), "return {ur_fbv};"
                else:
                    calling emit.line with (sigil of c->emitter), "return 0;"
            else:
                if ur_ott.kind == tk.SemaTypeKind.TkMaybe:
                    calling emit.line with (sigil of c->emitter), "return pengu_maybe_none();"
                else:
                    calling emit.line with (sigil of c->emitter), "return {ur_tmp};"
            calling emit.indent_less with (sigil of c->emitter)
            calling emit.line with (sigil of c->emitter), "}"
        calling register_local with c, nid, ty, nid
        return
    if jvn >= 0 and (calling astutil.kind_of with ast, jvn) == pskind.NodeKind.NdOrBlock:
        var ob_op as int is calling astutil.node_child with ast, jvn, 0
        if ob_op < 0:
            calling emit.line with (sigil of c->emitter), "{cdecl};"
            calling register_local with c, nid, ty, nid
            return
        var ob_op2 as int is ob_op
        while ob_op2 >= 0 and (calling astutil.kind_of with ast, ob_op2) == pskind.NodeKind.NdParenExpr:
            set ob_op2 is calling astutil.node_child with ast, ob_op2, 0
        var ob_ot as int is calling expr.node_type with c, ob_op2

        var ob_ott as tk.SemaType is calling types.at with (sigil of c->program->types), ob_ot
        var ob_pay as int is ob_ot
        if ob_ott.kind == tk.SemaTypeKind.TkMaybe or ob_ott.kind == tk.SemaTypeKind.TkResult:
            set ob_pay is ob_ott.a
        var ob_pt as string is calling ctype.c_type with (sigil of c->names), ob_pay
        defer banish ob_pt
        var ob_zero as string is calling expr.zero_value_expr with c, ty
        defer banish ob_zero
        calling emit.line with (sigil of c->emitter), "{cdecl} = {ob_zero};"
        var ob_ov as string is calling expr.emit_expr with c, ob_op
        defer banish ob_ov
        var ob_tmp as string is calling emit.temp with (sigil of c->emitter), "_or"
        defer banish ob_tmp
        if ob_ott.kind == tk.SemaTypeKind.TkMaybe:
            calling emit.line with (sigil of c->emitter), "PenguMaybe {ob_tmp} = {ob_ov};"
            calling emit.line with (sigil of c->emitter), "if ({ob_tmp}.is_present) {"
        else if ob_ott.kind == tk.SemaTypeKind.TkResult:
            calling emit.line with (sigil of c->emitter), "PenguResult {ob_tmp} = {ob_ov};"
            calling emit.line with (sigil of c->emitter), "if ({ob_tmp}.is_ok) {"
        else:
            calling emit.line with (sigil of c->emitter), "{cn} = {ob_ov};"
        if ob_ott.kind == tk.SemaTypeKind.TkMaybe:
            calling emit.line with (sigil of c->emitter), "{cn} = (*( {ob_pt}*){ob_tmp}.value);"
        else if ob_ott.kind == tk.SemaTypeKind.TkResult:
            calling emit.line with (sigil of c->emitter), "{cn} = (*( {ob_pt}*){ob_tmp}.ok_val);"
        if ob_ott.kind == tk.SemaTypeKind.TkMaybe or ob_ott.kind == tk.SemaTypeKind.TkResult:
            calling emit.line with (sigil of c->emitter), "} else {"
            calling emit.indent_more with (sigil of c->emitter)
            # `error` es el payload de fallo; para `maybe` no hay payload y se
            # documenta como un mensaje fijo.
            var ob_is_res as bool is ob_ott.kind == tk.SemaTypeKind.TkResult
            var ob_err_id as int is 0
            if ob_is_res and ob_ott.b > 0:
                set ob_err_id is ob_ott.b
            if ob_err_id <= 0:
                set ob_err_id is calling types.base with (sigil of c->program->types), "string"
            var ob_err_t as string is calling ctype.c_type with (sigil of c->names), ob_err_id
            defer banish ob_err_t
            if ob_is_res:
                calling emit.line with (sigil of c->emitter), "{ob_err_t} error = (*( {ob_err_t}*){ob_tmp}.err_val);"
            else:
                calling emit.line with (sigil of c->emitter), "PenguString error = pengu_string_from_cstr(\"maybe is absent\");"
            calling emit.line with (sigil of c->emitter), "(void)error;"
            var ob_n as int is calling astutil.child_count with ast, jvn
            var ob_i as int is 1
            while ob_i < ob_n:
                var ob_c as int is calling astutil.node_child with ast, jvn, ob_i
                if ob_c >= 0:
                    calling emit_stmt with c, ob_c
                set ob_i is ob_i + 1
            calling emit.indent_less with (sigil of c->emitter)
            calling emit.line with (sigil of c->emitter), "}"
        calling register_local with c, nid, ty, nid
        return
    if jvn >= 0 and (calling astutil.kind_of with ast, jvn) == pskind.NodeKind.NdJudgeExpr:
        calling emit.line with (sigil of c->emitter), "{cdecl};"
        calling emit.line with (sigil of c->emitter), "(void){cn};"
        var jtmp as string is calling emit_judge_block_value with c, jvn, ast, ty
        calling emit.line with (sigil of c->emitter), "{cn} = {jtmp};"
        banish jtmp
        calling register_local with c, nid, ty, nid
        return
    var is_static as bool is (calling astutil.kind_of with ast, node) == pskind.NodeKind.NdStaticVarDecl
    # `array of T with size N` en C es un puntero a un literal compuesto
    # `(T[N]){...}`; C++ no tiene literales compuestos, asi que el local se
    # declara como array real (decae a `T*` en los usos) y se inicializa con
    # la lista si la hay.
    if c->options.family == "cpp":
        var aty as tk.SemaType is calling types.at with (sigil of c->program->types), ty
        if aty.kind == tk.SemaTypeKind.TkArray and aty.a > 0 and aty.b > 0:
            var ect as string is calling ctype.c_type with (sigil of c->names), aty.a
            defer banish ect
            var inits as string is r"{}"
            defer banish inits
            if vn >= 0 and (calling astutil.kind_of with ast, vn) == pskind.NodeKind.NdArrayLit:
                var isb as StringBuilder is calling StringBuilder.new
                defer banish isb
                calling isb.append with r"{"
                var ec as int is calling astutil.child_count with ast, vn
                var ei as int is 0
                while ei < ec:
                    var en as int is calling astutil.node_child with ast, vn, ei
                    if en >= 0:
                        if ei > 0:
                            calling isb.append with ", "
                        var et as string is calling expr.emit_expr_as with c, en, aty.a
                        defer banish et
                        calling isb.append with et
                    set ei is ei + 1
                calling isb.append with r"}"
                banish inits
                set inits is calling isb.finish
            var spfx as string is ""
            if is_static:
                set spfx is "static "
            calling emit.line with (sigil of c->emitter), "{spfx}{ect} {cn}[{aty.b}] = {inits};"
            calling emit.line with (sigil of c->emitter), "(void){cn};"
            calling register_local with c, nid, ty, nid
            return
    if is_static:
        calling emit.line with (sigil of c->emitter), "static {cdecl};"
        if vn >= 0:
            var val as string is calling expr.emit_expr_as with c, vn, ty
            defer banish val
            var guard as string is "{cn}_pengu_initialized"
            calling emit.line with (sigil of c->emitter), "static bool {guard} = false;"
            calling emit.line with (sigil of c->emitter), "if (!{guard}) {"
            calling emit.line with (sigil of c->emitter), "{cn} = {val};"
            calling emit.line with (sigil of c->emitter), "{guard} = true;"
            calling emit.line with (sigil of c->emitter), "}"
        calling emit.line with (sigil of c->emitter), "(void){cn};"
        # Un `static` vive todo el programa: no lleva destructor automático.
        calling context.add_local with c, nid, ty, nid
        return
    var is_drop as bool is calling is_drop_type with c, ty
    if vn >= 0:
        var val2 as string is calling expr.emit_expr_as with c, vn, ty
        defer banish val2
        if not is_drop and (calling value_is_place with c, vn, ast):
            calling drop.emit_cow_promote_source with c, (calling drop.cow_kind_of with c, ty), vn, ast
        if not is_drop and (calling drop.cow_kind_of with c, ty) == 1 and (calling value_is_place with c, vn, ast):
            # Copiar un `string` local: el destino recibe su propio buffer SDS.
            calling emit.line with (sigil of c->emitter), "{cdecl} = pengu_string_share_value({val2});"
        else if not is_drop and (calling drop.cow_kind_of with c, ty) == 2 and (calling value_is_place with c, vn, ast):
            # Compartir una `list` local: el origen se promociona a COW (si era
            # legacy y es su unico dueno) y el destino incrementa la cuenta.
            calling emit.line with (sigil of c->emitter), "{cdecl} = {val2};"
            calling emit.line with (sigil of c->emitter), "pengu_cow_list_share(&({cn}));"
            calling emit.line with (sigil of c->emitter), "(void){cn};"
            calling register_local with c, nid, ty, nid
            return
        else if not is_drop and (calling drop.cow_kind_of with c, ty) == 3 and (calling value_is_place with c, vn, ast):
            calling emit.line with (sigil of c->emitter), "{cdecl} = {val2};"
            calling emit.line with (sigil of c->emitter), "pengu_cow_map_share(&({cn}));"
            calling emit.line with (sigil of c->emitter), "(void){cn};"
            calling register_local with c, nid, ty, nid
            return
        else:
            calling emit.line with (sigil of c->emitter), "{cdecl} = {val2};"
        if not is_drop:
            calling share_assigned with c, ty, vn, ast, cn
        if is_drop:
            if calling is_share_type with c, ty:
                # `Rc`/`Weak`: copiar el handle retiene, no mueve.
                if calling value_is_place with c, vn, ast:
                    calling emit.line with (sigil of c->emitter), "if (({cn}).ptr) {{ ({cn}).ptr = pengu_rc_retain(({cn}).ptr); }}"
            else:
                calling drop.note_move_source with c, vn, ast
    else if is_drop:
        # Un `Drop` sin inicializador arranca en cero: el destructor automático
        # es idempotente y una asignación posterior puede liberar el valor
        # anterior sin leer basura.
        calling emit.line with (sigil of c->emitter), "{cdecl} = {{0}};"
    else:
        calling emit.line with (sigil of c->emitter), "{cdecl};"
    calling emit.line with (sigil of c->emitter), "(void){cn};"
    calling register_local with c, nid, ty, nid

## Primer slot de token de un nodo.
##
## ## Memoria
## O(nodos).
weave token_slot with ast as ref to psast.PsAst, node as int into int:
    var i as int is 0
    var n as int is calling astutil.child_count with ast, node
    while i < n:
        if (calling astutil.token_child with ast, node, i) >= 0:
            return i
        set i is i + 1
    return -1
