## psc/codegen/bundle.pengu — ensamblado de `bundle.c`.
##
## CP0: cabecera, prototipos, definiciones y wrapper de entry. Las secciones de
## tipos, tests, line markers y DCE se añaden por subfases.

import std.builder
import std.compass
import std.spark

import psc.codegen.context as context
import psc.codegen.stmt as stmt
import psc.codegen.catalog as catalog
import psc.codegen.emit as emit
import psc.codegen.function as funcgen
import psc.codegen.decl_types as ctypes
import psc.sema.names as npool
import psc.codegen.dce as dce
import psc.codegen.jsongen as jsongen
import psc.codegen.generics as gen
import psc.sema.modules.loader as loader
import psc.sema.types.kind as tk
import psc.codegen.antiquus as antiquus
import psc.codegen.lambda as lambdagen
import psc.codegen.testgen as testgen

insignia psc_codegen_bundle_

## ¿El `declare` corresponde a una función de la libc ya declarada por el runtime?
##
## ## Memoria
## O(1) por nombre.
weave is_libc_name with c as ref to context.CgContext, f as catalog.CgFunction into bool:
    var n as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.c_name)
    defer banish n
    # The JS bridge declares these itself; the runtime header does not.
    if (n length) >= 9 and (n at 0 to 9) == "pengu_js_":
        return false
    if (n length) >= 6 and (n at 0 to 6) == "pengu_":
        return true
    if (n length) >= 3 and (n at 0 to 3) == "mz_":
        return true
    if (n length) >= 5 and (n at 0 to 5) == "stbi_":
        return true
    if (n length) >= 6 and (n at 0 to 6) == "rites_":
        return true
    if (n length) >= 11 and (n at 0 to 11) == "emscripten_":
        return true
    if n == "memmove" or n == "memcpy" or n == "memset" or n == "memcmp":
        return true
    if n == "malloc" or n == "calloc" or n == "realloc" or n == "free":
        return true
    if n == "strlen" or n == "strcmp" or n == "strncmp" or n == "strcpy" or n == "strncpy":
        return true
    if n == "snprintf" or n == "printf" or n == "fprintf" or n == "vprintf" or n == "puts" or n == "fputs":
        return true
    if n == "time" or n == "clock" or n == "localtime" or n == "asctime" or n == "strftime" or n == "getenv" or n == "abort" or n == "exit":
        return true
    if n == "fopen" or n == "fclose" or n == "fread" or n == "fwrite" or n == "fflush":
        return true
    return false

## Verifica que el C generado no contenga bytes NUL (corrupción de heap).
##
## ## Memoria
## Consume el emisor; devuelve el string owned del llamador.
weave finish_checked with e as ref to CgEmitter into string:
    var text as string is calling emit.finish with e
    var b as ref to frozen byte is bytes of text
    var i as int is 0
    while i < (text length):
        if ((b at i) to int) == 0:
            var sb as StringBuilder is calling StringBuilder.new
            var j as int is i - 60
            if j < 0:
                set j is 0
            var lim as int is i + 60
            if lim > (text length):
                set lim is text length
            while j < lim:
                var code as int is ((b at j) to int)
                if code >= 32 and code < 127:
                    calling sb.append with (text at j to (j + 1))
                else:
                    calling sb.append with "?"
                set j is j + 1
            var ctx as string is calling sb.finish
            banish sb
            calling spark.panic with "internal error: NUL in generated C at {i}: {ctx}"
        set i is i + 1
    return text

## Emite el bundle completo.
##
## ## Memoria
## Devuelve string owned; el contexto conserva sus tablas.
weave generate_bundle_c with c as ref to context.CgContext, live_out as ref to list of int into string:
    # Hook para reducir bloques en posición de valor sin crear un ciclo
    # de imports entre `expr` y `stmt`.
    set c->block_value is stmt.block_value
    calling emit.line with (sigil of c->emitter), "/* Auto-generated by PSC (F4) */"
    calling emit.line with (sigil of c->emitter), "#include <pengu_runtime.h>"
    calling emit.line with (sigil of c->emitter), "static inline void pengu_builtin_print(PenguString s) {"
    calling emit.line with (sigil of c->emitter), "    if (s.data != 0 && s.len > 0) {"
    calling emit.line with (sigil of c->emitter), "        fwrite(s.data, 1, (size_t)s.len, stdout);"
    calling emit.line with (sigil of c->emitter), "    }"
    calling emit.line with (sigil of c->emitter), "}"
    calling gen.specialize_all with c
    calling gen.scan_generic_refs_all with c
    # Los cuerpos (especializados y normales) pueden mencionar `Box of A` con
    # A ya concreto. Esas instancias deben existir antes de emitir typedefs;
    # de lo contrario el C generado referencia un tipo sin definir.
    calling gen.preinstantiate_all with c
    calling gen.collect_type_instances with c
    calling gen.collect_method_instances with c
    # Los codecs de `derive Json` se registran antes del DCE para que las
    # llamadas resuelvan `self`; sus tipos se marcan después.
    calling jsongen.register_methods with c
    var reach as CgReach is calling dce.compute with c
    defer calling dce.reach_free with (sigil of reach)
    calling jsongen.mark_json_types with c, (sigil of reach)
    # Includes de módulos con código vivo.
    var live_mod as map of int to int is map of int to int
    var li as int is 0
    while li < c->catalog.functions.len:
        if calling dce.live with (sigil of reach), li:
            var lf as catalog.CgFunction is (c->catalog.functions at li)
            calling live_mod.put with lf.module, lf.module
        set li is li + 1
    var mi as int is 0
    while mi < c->program->modules.len:
        if calling live_mod.has with mi:
            calling live_out.push with mi
        set mi is mi + 1
    var inc_mod as map of string to int is map of string to int
    var ii as int is 0
    while ii < c->catalog.includes.len:
        var inc as catalog.CgInclude is (c->catalog.includes at ii)
        var inc_live as bool is calling live_mod.has with inc.module
        if not inc_live:
            var im as loader.SemaModule is (c->program->modules at inc.module)
            var pid as int is calling dce.parent_module with c, im
            if pid >= 0:
                set inc_live is calling live_mod.has with pid
        if inc_live and not (calling inc_mod.has with inc.text):
            calling inc_mod.put with inc.text, inc.module
            var iline as string is ""
            if inc.text length > 0 and ((inc.text at 0) == "<" or (inc.text at 0) == "\""):
                set iline is "#include {inc.text}"
            else:
                set iline is "#include \"{inc.text}\""
            calling emit.line with (sigil of c->emitter), iline
        set ii is ii + 1
    calling emit.line with (sigil of c->emitter), "#if defined(__GNUC__) || defined(__clang__)"
    calling emit.line with (sigil of c->emitter), "#define PENGU_MAYBE_UNUSED __attribute__((unused))"
    calling emit.line with (sigil of c->emitter), "#else"
    calling emit.line with (sigil of c->emitter), "#define PENGU_MAYBE_UNUSED"
    calling emit.line with (sigil of c->emitter), "#endif"
    calling emit.line with (sigil of c->emitter), "#if defined(__GNUC__) || defined(__clang__)"
    calling emit.line with (sigil of c->emitter), "#pragma GCC diagnostic ignored \"-Wunused-function\""
    calling emit.line with (sigil of c->emitter), "#endif"
    calling emit.line with (sigil of c->emitter), "#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L"
    if c->options.strict_c99:
        calling emit.line with (sigil of c->emitter), "typedef char pengu_abi_static_assert[(PENGU_ABI_VERSION == 3) ? 1 : -1];"
    else:
        calling emit.line with (sigil of c->emitter), "_Static_assert(PENGU_ABI_VERSION == 3, \"pengu_runtime.h ABI mismatch: bundle expects v3\");"
    calling emit.line with (sigil of c->emitter), "#endif"
    calling emit.line with (sigil of c->emitter), "extern int pengu_abi_version(void);"
    calling emit.line with (sigil of c->emitter), "#if defined(__GNUC__) || defined(__clang__)"
    calling emit.line with (sigil of c->emitter), "__attribute__((used))"
    calling emit.line with (sigil of c->emitter), "#endif"
    calling emit.line with (sigil of c->emitter), "static int (*const _pengu_abi_pin)(void) = pengu_abi_version;"
    calling emit.blank with (sigil of c->emitter)
    # Tipos: forward declarations primero, definiciones después.
    var i as int is 0
    while i < c->catalog.types.len:
        var t as catalog.CgType is (c->catalog.types at i)
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), t.type_id:
            calling ctypes.emit_forward with c, t
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    # Alias/sellos (`seal Codepoint as u32`) que aparecen en firmas C.
    var ai as int is 0
    while ai < c->program->types.types.len:
        var at0 as tk.SemaType is (c->program->types.types at ai)
        var skip_decl as bool is false
        if (at0.kind == tk.SemaTypeKind.TkAlias or at0.kind == tk.SemaTypeKind.TkSeal) and at0.a >= 0 and at0.a < c->program->types.nominal_infos.len:
            var amod as int is (c->program->types.nominal_infos at at0.a).module
            if amod >= 0 and amod < c->program->modules.len:
                var am as loader.SemaModule is (c->program->modules at amod)
                set skip_decl is calling catalog.is_decl_path with am.path
        if skip_decl:
            set ai is ai + 1
            continue
        if (at0.kind == tk.SemaTypeKind.TkAlias or at0.kind == tk.SemaTypeKind.TkSeal) and (not c->options.prune_types or calling dce.type_live with (sigil of reach), ai):
            var an0 as string is calling ctype.c_type with (sigil of c->names), ai
            var atgt as string is calling ctype.c_type with (sigil of c->names), at0.b
            var skip_alias as bool is (an0 length) >= 5 and (an0 at 0 to 5) == "utf8_"
            if (an0 length) >= 3 and (an0 at 0 to 3) == "mz_":
                set skip_alias is true
            if (an0 length) >= 5 and (an0 at 0 to 5) == "stbi_":
                set skip_alias is true
            if at0.b > 0:
                var atk0 as tk.SemaType is calling types.at with (sigil of c->program->types), at0.b
                if atk0.kind == tk.SemaTypeKind.TkFn or atk0.kind == tk.SemaTypeKind.TkOpaque or atk0.kind == tk.SemaTypeKind.TkAny or atk0.kind == tk.SemaTypeKind.TkError or atk0.kind == tk.SemaTypeKind.TkConcept:
                    set skip_alias is true
            var ap as int is 0
            while ap < atgt length:
                if (atgt at ap) == "(":
                    set skip_alias is true
                set ap is ap + 1
            if at0.b > 0 and an0 != atgt and not skip_alias:
                calling emit.line with (sigil of c->emitter), "typedef {atgt} {an0};"
            banish an0
            banish atgt
        set ai is ai + 1
    calling emit.blank with (sigil of c->emitter)
    var order as list of int is calling ctypes.order_types with c
    set i is 0
    while i < order.len:
        var t2 as catalog.CgType is (c->catalog.types at (order at i))
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), t2.type_id:
            calling ctypes.emit_definition with c, t2
        set i is i + 1
    banish order
    # Tuplas sintéticas. Dos tuplas con la misma forma C pueden tener
    # `TypeId` distinto (cada módulo instancia la suya), así que se emite una
    # sola definición por nombre para no redefinir el struct en el bundle.
    var tnames as list of string is list of string
    var ti as int is 0
    while ti < c->program->types.types.len:
        var tt0 as tk.SemaType is (c->program->types.types at ti)
        if tt0.kind == tk.SemaTypeKind.TkTuple and (not c->options.prune_types or calling dce.type_live with (sigil of reach), ti):
            var tname as string is calling ctypes.tuple_c_name with (sigil of c->names), ti
            var dup as bool is false
            var sj as int is 0
            while sj < tnames.len:
                if (tnames at sj) == tname:
                    set dup is true
                set sj is sj + 1
            if dup:
                banish tname
            else:
                calling tnames.push with tname
                calling ctypes.emit_tuple with c, ti
        set ti is ti + 1
    var sk as int is 0
    while sk < tnames.len:
        var sn as string is (tnames at sk)
        banish sn
        set sk is sk + 1
    banish tnames
    calling emit.blank with (sigil of c->emitter)
    # Constantes.
    set i is 0
    while i < c->catalog.consts.len:
        var kc as catalog.CgConst is (c->catalog.consts at i)
        calling ctypes.emit_const with c, kc
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    # Clones derivados que usan los antiquus (`Nexus`/`Imago`).
    set i is 0
    while i < c->catalog.types.len:
        var tcl as catalog.CgType is (c->catalog.types at i)
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), tcl.type_id:
            calling ctypes.emit_clone with c, tcl
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    # Copias profundas de los runes `derive Drop` (las usa `.clone()`).
    set i is 0
    while i < c->catalog.types.len:
        var td as catalog.CgType is (c->catalog.types at i)
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), td.type_id:
            calling ctypes.emit_deepclone with c, td
        set i is i + 1
    # Prototipos de los cleanups: los tipos con ciclos (A dentro de B y
    # `list of A` dentro de A) no pueden ordenarse por dependencia de cleanup.
    set i is 0
    while i < c->catalog.types.len:
        var tf as catalog.CgType is (c->catalog.types at i)
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), tf.type_id:
            calling ctypes.emit_cleanup_forward with c, tf
        set i is i + 1
    # Cleanup derivado de runes/ecos (lo usa `banish`).
    set i is 0
    while i < c->catalog.types.len:
        var tc as catalog.CgType is (c->catalog.types at i)
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), tc.type_id:
            calling ctypes.emit_cleanup with c, tc
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    # Codecs JSON (`derive Json`).
    calling jsongen.emit_all with c, (sigil of reach)
    calling emit.blank with (sigil of c->emitter)
    # Bloques C crudos (`antiquus`).
    set i is 0
    while i < c->catalog.functions.len:
        if calling dce.live with (sigil of reach), i:
            var af as catalog.CgFunction is (c->catalog.functions at i)
            if af.is_antiquus:
                calling antiquus.emit_body with c, af
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    # Lambdas (prototipos antes de las funciones que las usan).
    calling lambdagen.collect_lambdas with c
    var lmi as int is 0
    while lmi < c->lambdas.len:
        calling lambdagen.emit_prototype with c, (c->lambdas at lmi)
        set lmi is lmi + 1
    calling emit.blank with (sigil of c->emitter)
    # Los cuerpos se emiten primero a un buffer aparte: sólo al emitirlos se
    # conocen los locales y, con ellos, el receptor concreto de un método de
    # contenedor, que puede crear una especialización nueva. Cuando terminan,
    # todas las funciones están en el catálogo y los prototipos pueden cubrir
    # también las creadas tarde. Luego se concatenan los cuerpos ya emitidos.
    var saved_em as emit.CgEmitter is c->emitter
    set c->emitter is calling emit.new_emitter
    set i is 0
    while i < c->catalog.functions.len:
        var pf as catalog.CgFunction is (c->catalog.functions at i)
        if calling dce.live with (sigil of reach), i or pf.is_spec:
            if (not pf.is_generic or pf.is_spec) and not pf.is_declare and not pf.is_antiquus and not pf.is_generated:
                calling funcgen.emit_function with c, pf
        set i is i + 1
    var nt as int is 0
    if c->options.is_test:
        set nt is calling testgen.emit_all with c
        while i < c->catalog.functions.len:
            var tf as catalog.CgFunction is (c->catalog.functions at i)
            if (not tf.is_generic or tf.is_spec) and not tf.is_declare and not tf.is_antiquus and not tf.is_generated:
                calling funcgen.emit_function with c, tf
            set i is i + 1
    var body_text as string is calling c->emitter.sb.finish
    calling emit.emit_free with (sigil of c->emitter)
    set c->emitter is saved_em
    calling emit.blank with (sigil of c->emitter)
    # Prototipos.
    set i is 0
    while i < c->catalog.functions.len:
        var f as catalog.CgFunction is (c->catalog.functions at i)
        if calling dce.live with (sigil of reach), i or f.is_spec:
            var fmod as loader.SemaModule is (c->program->modules at f.module)
            var skip_decl_proto as bool is f.is_declare and (calling catalog.is_decl_path with fmod.canonical_path)
            if (not f.is_generic or f.is_spec) and not f.is_antiquus and not f.is_generated and not skip_decl_proto and (not f.is_declare or not calling is_libc_name with c, f):
                var sig as string is calling funcgen.signature with c, f
                defer banish sig
                calling emit.line with (sigil of c->emitter), "{sig};"
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    # Cuerpos de lambdas.
    banish c->lambdas
    set c->lambdas is list of context.CgLambda
    calling lambdagen.collect_lambdas with c
    var lmb as int is 0
    while lmb < c->lambdas.len:
        calling lambdagen.emit_body with c, (c->lambdas at lmb)
        set lmb is lmb + 1
    calling emit.blank with (sigil of c->emitter)
    # Definiciones (las declare ya se emitieron como prototipo).
    calling emit.raw with (sigil of c->emitter), body_text
    banish body_text
    # Modo --test: runner propio, sin main normal.
    if c->options.is_test:
        calling testgen.emit_main with c, nt, c->options.test_json
        return calling finish_checked with (sigil of c->emitter)
    # Entry wrapper.
    var has_main as bool is false
    set i is 0
    while i < c->catalog.functions.len:
        var f3 as catalog.CgFunction is (c->catalog.functions at i)
        if f3.is_main:
            set has_main is true
        set i is i + 1
    if has_main and not c->options.is_library:
        # `weave main:` puede no devolver nada; en ese caso la llamada no se castea.
        var main_void as bool is false
        set i is 0
        while i < c->catalog.functions.len:
            var f4 as catalog.CgFunction is (c->catalog.functions at i)
            if f4.is_main and f4.ret_void:
                set main_void is true
            set i is i + 1
        calling emit.line with (sigil of c->emitter), "int main(int argc, char** argv) {"
        calling emit.indent_more with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "pengu_init(argc, argv);"
        calling emit.line with (sigil of c->emitter), "pengu_install_crash_handler();"
        if main_void:
            calling emit.line with (sigil of c->emitter), "pengu_main();"
            calling emit.line with (sigil of c->emitter), "int pengu_status = 0;"
        else:
            calling emit.line with (sigil of c->emitter), "int pengu_status = (int)pengu_main();"
        calling emit.line with (sigil of c->emitter), "fflush(stdout);"
        calling emit.line with (sigil of c->emitter), "fflush(stderr);"
        calling emit.line with (sigil of c->emitter), "return pengu_status;"
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "}"
    return calling finish_checked with (sigil of c->emitter)

# ---------------------------------------------------------------------------
# F7: emisión en unidades (cabecera + core + una unidad por módulo)
# ---------------------------------------------------------------------------

## Una unidad C generada.
##
## ## Memoria
## `name` y `text` son owned.
rune CgUnit:
    ## Nombre lógico (sin `.c`).
    name as string
    ## Texto C de la unidad, con `#include "bundle.h"` al principio.
    text as string

## Resultado de la emisión multi-unidad.
##
## ## Memoria
## `header` y `core` son owned; `units` también.
rune CgParts:
    ## Cabecera compartida (`bundle.h`).
    header as string
    ## Unidad con codecs JSON, antiquus y `main`.
    core as string
    ## Una unidad por módulo con funciones vivas.
    units as list of CgUnit

## Buffers de unidades por módulo.
rune CgUnitBuffers:
    ids as list of int
    bufs as list of StringBuilder

## Índice de la unidad de un módulo, creándola si no existe.
##
## ## Memoria
## Añade a `u`.
weave unit_slot with u as ref to CgUnitBuffers, mid as int into int:
    var i as int is 0
    while i < u->ids.len:
        if (u->ids at i) == mid:
            return i
        set i is i + 1
    calling u->ids.push with mid
    calling u->bufs.push with (calling StringBuilder.new)
    return u->ids.len - 1

## Añade texto al buffer de un módulo.
##
## ## Memoria
## Presta `text`.
weave append_unit with u as ref to CgUnitBuffers, mid as int, text as string into void:
    var k as int is calling unit_slot with u, mid
    var b as StringBuilder is (u->bufs at k)
    calling b.append with text
    set u->bufs at k is b

## Nombre de archivo de una unidad a partir del módulo.
##
## ## Memoria
## Devuelve string owned.
weave unit_name with c as ref to context.CgContext, mid as int into string:
    var m as loader.SemaModule is (c->program->modules at mid)
    var base as string is calling compass.cp_basename with m.path
    defer banish base
    var stem as string is calling compass.cp_stem with base
    defer banish stem
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "u{mid}_"
    var b as ref to frozen byte is bytes of stem
    var i as int is 0
    while i < stem length:
        var code as int is ((b at i) to int)
        if (code >= 97 and code <= 122) or (code >= 65 and code <= 90) or (code >= 48 and code <= 57) or code == 95:
            calling sb.append with (stem at i to (i + 1))
        else:
            calling sb.append with "_"
        set i is i + 1
    return calling sb.finish

## Emite una cabecera compartida y unidades por módulo (F7).
##
## Es la variante opt-in del bundle único. El llamador escribe los archivos y
## compila cada unidad por separado; `generate_bundle_c` sigue siendo el camino
## por defecto.
##
## ## Memoria
## Devuelve textos owned; el contexto conserva sus tablas.
weave generate_units_c with c as ref to context.CgContext, live_out as ref to list of int into CgParts:
    set c->block_value is stmt.block_value
    var saved_em as emit.CgEmitter is c->emitter
    var hdr as emit.CgEmitter is calling emit.new_emitter
    var core as emit.CgEmitter is calling emit.new_emitter
    var ub as CgUnitBuffers is with ids is list of int, bufs is list of StringBuilder
    set c->emitter is hdr
    calling emit.line with (sigil of c->emitter), "/* Auto-generated by PSC (F7 units) */"
    calling emit.line with (sigil of c->emitter), "#ifndef PENGU_BUNDLE_H"
    calling emit.line with (sigil of c->emitter), "#define PENGU_BUNDLE_H"
    calling emit.line with (sigil of c->emitter), "#include <pengu_runtime.h>"
    calling emit.line with (sigil of c->emitter), "static inline void pengu_builtin_print(PenguString s) {"
    calling emit.line with (sigil of c->emitter), "    if (s.data != 0 && s.len > 0) {"
    calling emit.line with (sigil of c->emitter), "        fwrite(s.data, 1, (size_t)s.len, stdout);"
    calling emit.line with (sigil of c->emitter), "    }"
    calling emit.line with (sigil of c->emitter), "}"
    calling gen.specialize_all with c
    calling gen.scan_generic_refs_all with c
    calling gen.preinstantiate_all with c
    calling gen.collect_type_instances with c
    calling gen.collect_method_instances with c
    calling jsongen.register_methods with c
    var reach as CgReach is calling dce.compute with c
    defer calling dce.reach_free with (sigil of reach)
    calling jsongen.mark_json_types with c, (sigil of reach)
    var live_mod as map of int to int is map of int to int
    var li as int is 0
    while li < c->catalog.functions.len:
        if calling dce.live with (sigil of reach), li:
            var lf as catalog.CgFunction is (c->catalog.functions at li)
            calling live_mod.put with lf.module, lf.module
        set li is li + 1
    var mi as int is 0
    while mi < c->program->modules.len:
        if calling live_mod.has with mi:
            calling live_out.push with mi
        set mi is mi + 1
    var inc_mod as map of string to int is map of string to int
    var ii as int is 0
    while ii < c->catalog.includes.len:
        var inc as catalog.CgInclude is (c->catalog.includes at ii)
        var inc_live as bool is calling live_mod.has with inc.module
        if not inc_live:
            var im as loader.SemaModule is (c->program->modules at inc.module)
            var pid as int is calling dce.parent_module with c, im
            if pid >= 0:
                set inc_live is calling live_mod.has with pid
        if inc_live and not (calling inc_mod.has with inc.text):
            calling inc_mod.put with inc.text, inc.module
            var iline as string is ""
            if inc.text length > 0 and ((inc.text at 0) == "<" or (inc.text at 0) == "\""):
                set iline is "#include {inc.text}"
            else:
                set iline is "#include \"{inc.text}\""
            calling emit.line with (sigil of c->emitter), iline
        set ii is ii + 1
    calling emit.line with (sigil of c->emitter), "#if defined(__GNUC__) || defined(__clang__)"
    calling emit.line with (sigil of c->emitter), "#define PENGU_MAYBE_UNUSED __attribute__((unused))"
    calling emit.line with (sigil of c->emitter), "#else"
    calling emit.line with (sigil of c->emitter), "#define PENGU_MAYBE_UNUSED"
    calling emit.line with (sigil of c->emitter), "#endif"
    calling emit.line with (sigil of c->emitter), "#if defined(__GNUC__) || defined(__clang__)"
    calling emit.line with (sigil of c->emitter), "#pragma GCC diagnostic ignored \"-Wunused-function\""
    calling emit.line with (sigil of c->emitter), "#endif"
    calling emit.line with (sigil of c->emitter), "#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L"
    if c->options.strict_c99:
        calling emit.line with (sigil of c->emitter), "typedef char pengu_abi_static_assert[(PENGU_ABI_VERSION == 3) ? 1 : -1];"
    else:
        calling emit.line with (sigil of c->emitter), "_Static_assert(PENGU_ABI_VERSION == 3, \"pengu_runtime.h ABI mismatch: bundle expects v3\");"
    calling emit.line with (sigil of c->emitter), "#endif"
    calling emit.line with (sigil of c->emitter), "extern int pengu_abi_version(void);"
    calling emit.line with (sigil of c->emitter), "#if defined(__GNUC__) || defined(__clang__)"
    calling emit.line with (sigil of c->emitter), "__attribute__((used))"
    calling emit.line with (sigil of c->emitter), "#endif"
    calling emit.line with (sigil of c->emitter), "static int (*const _pengu_abi_pin)(void) = pengu_abi_version;"
    calling emit.blank with (sigil of c->emitter)
    var i as int is 0
    while i < c->catalog.types.len:
        var t as catalog.CgType is (c->catalog.types at i)
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), t.type_id:
            calling ctypes.emit_forward with c, t
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    var ai as int is 0
    while ai < c->program->types.types.len:
        var at0 as tk.SemaType is (c->program->types.types at ai)
        var skip_decl as bool is false
        if (at0.kind == tk.SemaTypeKind.TkAlias or at0.kind == tk.SemaTypeKind.TkSeal) and at0.a >= 0 and at0.a < c->program->types.nominal_infos.len:
            var amod as int is (c->program->types.nominal_infos at at0.a).module
            if amod >= 0 and amod < c->program->modules.len:
                var am as loader.SemaModule is (c->program->modules at amod)
                set skip_decl is calling catalog.is_decl_path with am.path
        if skip_decl:
            set ai is ai + 1
            continue
        if (at0.kind == tk.SemaTypeKind.TkAlias or at0.kind == tk.SemaTypeKind.TkSeal) and (not c->options.prune_types or calling dce.type_live with (sigil of reach), ai):
            var an0 as string is calling ctype.c_type with (sigil of c->names), ai
            var atgt as string is calling ctype.c_type with (sigil of c->names), at0.b
            var skip_alias as bool is (an0 length) >= 5 and (an0 at 0 to 5) == "utf8_"
            if (an0 length) >= 3 and (an0 at 0 to 3) == "mz_":
                set skip_alias is true
            if (an0 length) >= 5 and (an0 at 0 to 5) == "stbi_":
                set skip_alias is true
            if at0.b > 0:
                var atk0 as tk.SemaType is calling types.at with (sigil of c->program->types), at0.b
                if atk0.kind == tk.SemaTypeKind.TkFn or atk0.kind == tk.SemaTypeKind.TkOpaque or atk0.kind == tk.SemaTypeKind.TkAny or atk0.kind == tk.SemaTypeKind.TkError or atk0.kind == tk.SemaTypeKind.TkConcept:
                    set skip_alias is true
            var ap as int is 0
            while ap < atgt length:
                if (atgt at ap) == "(":
                    set skip_alias is true
                set ap is ap + 1
            if at0.b > 0 and an0 != atgt and not skip_alias:
                calling emit.line with (sigil of c->emitter), "typedef {atgt} {an0};"
            banish an0
            banish atgt
        set ai is ai + 1
    calling emit.blank with (sigil of c->emitter)
    var order as list of int is calling ctypes.order_types with c
    set i is 0
    while i < order.len:
        var t2 as catalog.CgType is (c->catalog.types at (order at i))
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), t2.type_id:
            calling ctypes.emit_definition with c, t2
        set i is i + 1
    banish order
    var tnames as list of string is list of string
    var ti as int is 0
    while ti < c->program->types.types.len:
        var tt0 as tk.SemaType is (c->program->types.types at ti)
        if tt0.kind == tk.SemaTypeKind.TkTuple and (not c->options.prune_types or calling dce.type_live with (sigil of reach), ti):
            var tname as string is calling ctypes.tuple_c_name with (sigil of c->names), ti
            var dup as bool is false
            var sj as int is 0
            while sj < tnames.len:
                if (tnames at sj) == tname:
                    set dup is true
                set sj is sj + 1
            if dup:
                banish tname
            else:
                calling tnames.push with tname
                calling ctypes.emit_tuple with c, ti
        set ti is ti + 1
    var sk as int is 0
    while sk < tnames.len:
        var sn as string is (tnames at sk)
        banish sn
        set sk is sk + 1
    banish tnames
    calling emit.blank with (sigil of c->emitter)
    set i is 0
    while i < c->catalog.consts.len:
        var kc as catalog.CgConst is (c->catalog.consts at i)
        calling ctypes.emit_const with c, kc
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    set i is 0
    while i < c->catalog.types.len:
        var tcl as catalog.CgType is (c->catalog.types at i)
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), tcl.type_id:
            calling ctypes.emit_clone with c, tcl
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    set i is 0
    while i < c->catalog.types.len:
        var tc as catalog.CgType is (c->catalog.types at i)
        if not c->options.prune_types or calling dce.type_live with (sigil of reach), tc.type_id:
            calling ctypes.emit_cleanup with c, tc
        set i is i + 1
    calling emit.blank with (sigil of c->emitter)
    # La cabecera se cierra antes de emitir cuerpos: guardarla como valor y
    # seguir escribiendo en ella dejaría el `StringBuilder` apuntando a un
    # buffer liberado si crece. Los prototipos se concatenan al final.
    var header_main as string is calling finish_checked with (sigil of c->emitter)
    calling emit.emit_free with (sigil of c->emitter)
    # Cuerpos: cada función va a la unidad de su módulo.
    set i is 0
    while i < c->catalog.functions.len:
        var pf as catalog.CgFunction is (c->catalog.functions at i)
        if calling dce.live with (sigil of reach), i or pf.is_spec:
            if (not pf.is_generic or pf.is_spec) and not pf.is_declare and not pf.is_antiquus and not pf.is_generated:
                var ue as emit.CgEmitter is calling emit.new_emitter
                set c->emitter is ue
                calling funcgen.emit_function with c, pf
                var txt as string is calling finish_checked with (sigil of c->emitter)
                calling emit.emit_free with (sigil of c->emitter)
                calling append_unit with (sigil of ub), pf.module, txt
                banish txt
        set i is i + 1
    # antiquus en la unidad de su módulo.
    set i is 0
    while i < c->catalog.functions.len:
        if calling dce.live with (sigil of reach), i:
            var af as catalog.CgFunction is (c->catalog.functions at i)
            if af.is_antiquus:
                var ue2 as emit.CgEmitter is calling emit.new_emitter
                set c->emitter is ue2
                calling antiquus.emit_body with c, af
                var txt2 as string is calling finish_checked with (sigil of c->emitter)
                calling emit.emit_free with (sigil of c->emitter)
                calling append_unit with (sigil of ub), af.module, txt2
                banish txt2
        set i is i + 1
    # Prototipos en la cabecera (emisor nuevo).
    var proto as emit.CgEmitter is calling emit.new_emitter
    set c->emitter is proto
    calling jsongen.emit_prototypes with c, (sigil of reach)
    set i is 0
    while i < c->catalog.functions.len:
        var f as catalog.CgFunction is (c->catalog.functions at i)
        if (calling dce.live with (sigil of reach), i or f.is_spec) and f.is_antiquus:
            var asig as string is calling funcgen.signature with c, f
            defer banish asig
            calling emit.line with (sigil of c->emitter), "{asig};"
        set i is i + 1
    calling lambdagen.collect_lambdas with c
    var lmi as int is 0
    while lmi < c->lambdas.len:
        calling lambdagen.emit_prototype with c, (c->lambdas at lmi)
        set lmi is lmi + 1
    set i is 0
    while i < c->catalog.functions.len:
        var f2 as catalog.CgFunction is (c->catalog.functions at i)
        if calling dce.live with (sigil of reach), i or f2.is_spec:
            var fmod as loader.SemaModule is (c->program->modules at f2.module)
            var skip_decl_proto as bool is f2.is_declare and (calling catalog.is_decl_path with fmod.canonical_path)
            if (not f2.is_generic or f2.is_spec) and not f2.is_antiquus and not f2.is_generated and not skip_decl_proto and (not f2.is_declare or not calling is_libc_name with c, f2):
                var sig as string is calling funcgen.signature with c, f2
                defer banish sig
                calling emit.line with (sigil of c->emitter), "{sig};"
        set i is i + 1
    # Cuerpos de lambdas: a la unidad de su módulo.
    var lmb as int is 0
    while lmb < c->lambdas.len:
        var lam as context.CgLambda is (c->lambdas at lmb)
        var ue3 as emit.CgEmitter is calling emit.new_emitter
        set c->emitter is ue3
        calling lambdagen.emit_body with c, lam
        var txt3 as string is calling finish_checked with (sigil of c->emitter)
        calling emit.emit_free with (sigil of c->emitter)
        calling append_unit with (sigil of ub), lam.module, txt3
        banish txt3
        set lmb is lmb + 1
    calling emit.line with (sigil of c->emitter), "#endif"
    var proto_text as string is calling finish_checked with (sigil of c->emitter)
    calling emit.emit_free with (sigil of c->emitter)
    var header_text as string is "{header_main}{proto_text}"
    banish header_main
    banish proto_text
    # Core: codecs JSON, runner y main.
    set c->emitter is core
    calling emit.line with (sigil of c->emitter), "#include \"bundle.h\""
    calling jsongen.emit_bodies with c, (sigil of reach)
    var nt as int is 0
    if c->options.is_test:
        set nt is calling testgen.emit_all with c
    var core_text as string is ""
    if c->options.is_test:
        calling testgen.emit_main with c, nt, c->options.test_json
        set core_text is calling finish_checked with (sigil of c->emitter)
    else:
        var has_main as bool is false
        set i is 0
        while i < c->catalog.functions.len:
            var f3 as catalog.CgFunction is (c->catalog.functions at i)
            if f3.is_main:
                set has_main is true
            set i is i + 1
        if has_main and not c->options.is_library:
            calling emit.line with (sigil of c->emitter), "int main(int argc, char** argv) {"
            calling emit.indent_more with (sigil of c->emitter)
            calling emit.line with (sigil of c->emitter), "pengu_init(argc, argv);"
            calling emit.line with (sigil of c->emitter), "pengu_install_crash_handler();"
            calling emit.line with (sigil of c->emitter), "int pengu_status = (int)pengu_main();"
            calling emit.line with (sigil of c->emitter), "fflush(stdout);"
            calling emit.line with (sigil of c->emitter), "fflush(stderr);"
            calling emit.line with (sigil of c->emitter), "return pengu_status;"
            calling emit.indent_less with (sigil of c->emitter)
            calling emit.line with (sigil of c->emitter), "}"
        set core_text is calling finish_checked with (sigil of c->emitter)
    calling emit.emit_free with (sigil of c->emitter)
    # Construye las unidades con su include.
    var units as list of CgUnit is list of CgUnit
    var ui as int is 0
    while ui < ub.ids.len:
        var mid as int is (ub.ids at ui)
        var b as StringBuilder is (ub.bufs at ui)
        var ut as string is calling b.finish
        banish b
        var nm as string is calling unit_name with c, mid
        var full as string is "#include \"bundle.h\"\n{ut}"
        banish ut
        calling units.push with with name is nm, text is full
        set ui is ui + 1
    set c->emitter is saved_em
    return with header is header_text, core is core_text, units is units
