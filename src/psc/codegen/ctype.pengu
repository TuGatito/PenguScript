## psc/codegen/ctype.pengu — traducción `SemaType` → C.
##
## Es la única puerta de tipos C. Ningún emisor debe escribir un tipo C a mano.

import std.builder
import std.scrolls
import std.spark
import psc.sema.names as npool
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.codegen.names as names

insignia psc_codegen_ctype_

## `true` si un tipo contiene un `TkTypeParam`.
##
## ## Memoria
## O(profundidad).
weave type_has_param with t as ref to types.SemaTypeTable, id as int into bool:
    return calling type_has_param_depth with t, id, 0

## Implementación con cota de profundidad: una runa recursiva
## (`Node of T { next as Node of T }`) no debe colgar la compilación.
##
## ## Memoria
## O(profundidad).
weave type_has_param_depth with t as ref to types.SemaTypeTable, id as int, depth as int into bool:
    if id <= 0 or depth > 24:
        return false
    var ty as tk.SemaType is calling types.at with t, id
    if ty.kind == tk.SemaTypeKind.TkTypeParam:
        return true
    if ty.kind == tk.SemaTypeKind.TkRef or ty.kind == tk.SemaTypeKind.TkFrozen or ty.kind == tk.SemaTypeKind.TkArray or ty.kind == tk.SemaTypeKind.TkList or ty.kind == tk.SemaTypeKind.TkSlice or ty.kind == tk.SemaTypeKind.TkMany or ty.kind == tk.SemaTypeKind.TkMaybe or ty.kind == tk.SemaTypeKind.TkRange:
        return calling type_has_param_depth with t, ty.a, depth + 1
    if ty.kind == tk.SemaTypeKind.TkMap or ty.kind == tk.SemaTypeKind.TkResult:
        return (calling type_has_param_depth with t, ty.a, depth + 1) or (calling type_has_param_depth with t, ty.b, depth + 1)
    if ty.kind == tk.SemaTypeKind.TkFn:
        var fi as types.SemaFnInfo is (t->fn_infos at ty.a)
        var pi as int is 0
        while pi < fi.params_count:
            var fp as types.SemaFnParam is (t->fn_params at (fi.params_first + pi))
            if calling type_has_param_depth with t, fp.type, depth + 1:
                return true
            set pi is pi + 1
        return calling type_has_param_depth with t, fi.return_type, depth + 1
    if ty.kind == tk.SemaTypeKind.TkTuple:
        var i as int is 0
        while i < ty.count:
            if calling type_has_param_depth with t, (t->type_children at (ty.first + i)), depth + 1:
                return true
            set i is i + 1
        return false
    if ty.kind == tk.SemaTypeKind.TkRune or ty.kind == tk.SemaTypeKind.TkEcho or ty.kind == tk.SemaTypeKind.TkOmen or ty.kind == tk.SemaTypeKind.TkAlias or ty.kind == tk.SemaTypeKind.TkSeal:
        # Un nominal anidado (`Inner of A`) guarda el type param en SUS
        # campos; hay que mirar dentro para no borrar el layout a `Outer`.
        var info as types.SemaNominalInfo is (t->nominal_infos at ty.a)
        var fi as int is 0
        while fi < info.fields_count:
            var f as types.SemaField is (t->fields at (info.fields_first + fi))
            if calling type_has_param_depth with t, f.type, depth + 1:
                return true
            set fi is fi + 1
        var vi as int is 0
        while vi < info.variants_count:
            var v as types.SemaVariant is (t->variants at (info.variants_first + vi))
            var pi as int is 0
            while pi < v.payload_count:
                var pf as types.SemaField is (t->fields at (v.payload_first + pi))
                if calling type_has_param_depth with t, pf.type, depth + 1:
                    return true
                set pi is pi + 1
            set vi is vi + 1
    return false

## `true` si la instancia no tiene campos dependientes de T.
##
## Los contenedores `LinkedList of T`, `UnorderedSet of T`, etc. solo guardan
## un handle; pueden compartir el struct C de la plantilla aunque el `TypeId`
## semántico sea distinto. Esto evita generar un struct por `T` sin perder la
## comprobación de tipos.
##
## ## Memoria
## O(campos).
weave nominal_erased with t as ref to types.SemaTypeTable, info as types.SemaNominalInfo into bool:
    var check as types.SemaNominalInfo is info
    if info.template_info >= 0 and info.template_info < t->nominal_infos.len:
        set check is (t->nominal_infos at info.template_info)
    var i as int is 0
    while i < check.fields_count:
        var f as types.SemaField is (t->fields at (check.fields_first + i))
        if calling type_has_param with t, f.type:
            return false
        set i is i + 1
    return true

## `TypeId` de la plantilla de una instancia.
##
## ## Memoria
## O(tipos); solo se usa para nombres C de instancias borradas.
weave template_type_of with t as ref to types.SemaTypeTable, info as types.SemaNominalInfo into int:
    var i as int is 0
    while i < t->types.len:
        var ty as tk.SemaType is (t->types at i)
        if ty.a == info.template_info and ty.count == 0:
            if ty.kind == tk.SemaTypeKind.TkRune or ty.kind == tk.SemaTypeKind.TkEcho or ty.kind == tk.SemaTypeKind.TkOmen or ty.kind == tk.SemaTypeKind.TkAlias or ty.kind == tk.SemaTypeKind.TkSeal or ty.kind == tk.SemaTypeKind.TkConcept:
                return i
        set i is i + 1
    return -1

## Código de `kind` para los descriptores de contenedores CC.
##
## 0 = entero/POD numérico, 1 = string, 2 = float, 9 = bytes.
##
## ## Memoria
## O(1).
weave type_kind_code with ns as ref to names.CgNames, id as int into int:
    var t as tk.SemaType is calling types.at with ns->types, id
    if t.kind == tk.SemaTypeKind.TkTypeParam and calling ns->subst.has with t.name:
        return calling type_kind_code with ns, (calling ns->subst.get with t.name)
    if t.kind == tk.SemaTypeKind.TkBase:
        var n as string is calling base_c_type with ns, t.name
        defer banish n
        if n == "PenguString":
            return 1
        if n == "float" or n == "double":
            return 2
        return 0
    if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
        return calling type_kind_code with ns, t.a
    return 9

## Tipo C de un `TypeId`.
##
## Devuelve un string owned; el llamador lo libera con `banish`.
weave c_type with ns as ref to names.CgNames, id as int into string:
    if id <= 0:
        return calling npool.copy_string with "void*"
    var t as tk.SemaType is calling types.at with ns->types, id
    var tn0 as string is calling names.type_name with ns, id
    if tn0 == "va_list":
        banish tn0
        return calling npool.copy_string with "va_list"
    banish tn0
    if t.kind == tk.SemaTypeKind.TkVoid:
        return calling npool.copy_string with "void"
    if t.kind == tk.SemaTypeKind.TkOpaque:
        return calling npool.copy_string with "void*"
    if t.kind == tk.SemaTypeKind.TkNull:
        return calling npool.copy_string with "void*"
    if t.kind == tk.SemaTypeKind.TkAny or t.kind == tk.SemaTypeKind.TkError:
        return calling npool.copy_string with "void*"
    if t.kind == tk.SemaTypeKind.TkCVarArgs:
        return calling npool.copy_string with "..."
    if t.kind == tk.SemaTypeKind.TkBase:
        return calling base_c_type with ns, t.name
    if t.kind == tk.SemaTypeKind.TkRef:
        if t.a > 0:
            var inner_ty as tk.SemaType is calling types.at with ns->types, t.a
            if inner_ty.kind == tk.SemaTypeKind.TkFn:
                return calling fn_c_type with ns, inner_ty.a
        var inner as string is calling c_type with ns, t.a
        defer banish inner
        if inner == "void":
            return calling npool.copy_string with "void*"
        return "{inner}*"
    if t.kind == tk.SemaTypeKind.TkFrozen:
        var inner2 as string is calling c_type with ns, t.a
        defer banish inner2
        return "const {inner2}"
    if t.kind == tk.SemaTypeKind.TkArray:
        var elem as string is calling c_type with ns, t.a
        return "{elem}*"
    if t.kind == tk.SemaTypeKind.TkSlice or t.kind == tk.SemaTypeKind.TkMany:
        return calling npool.copy_string with "PenguSlice"
    if t.kind == tk.SemaTypeKind.TkList:
        return calling npool.copy_string with "PenguList"
    if t.kind == tk.SemaTypeKind.TkMap:
        return calling npool.copy_string with "PenguMap"
    if t.kind == tk.SemaTypeKind.TkMaybe:
        return calling npool.copy_string with "PenguMaybe"
    if t.kind == tk.SemaTypeKind.TkResult:
        return calling npool.copy_string with "PenguResult"
    if t.kind == tk.SemaTypeKind.TkRange:
        return calling npool.copy_string with "PenguRange"
    if t.kind == tk.SemaTypeKind.TkTuple:
        return calling tuple_c_name with ns, id
    if t.kind == tk.SemaTypeKind.TkFn:
        return calling fn_c_type with ns, t.a
    if t.kind == tk.SemaTypeKind.TkOmen:
        var info as types.SemaNominalInfo is (ns->types->nominal_infos at t.a)
        if (info.flags & types.NIF_STRING_VALUED) != 0:
            return calling npool.copy_string with "PenguString"
        return calling names.type_name with ns, id
    if t.kind == tk.SemaTypeKind.TkAlias:
        # Un alias es transparente en C. Si el destino es un puntero a función
        # no existe `typedef` válido con ese nombre (`typedef int (*Handler)(int)`
        # necesita el nombre dentro del declarador), así que se emite el tipo
        # subyacente tal cual.
        if t.b > 0:
            var bcur as int is t.b
            var bty as tk.SemaType is calling types.at with ns->types, bcur
            var bguard as int is 0
            while bguard < 16 and bty.kind == tk.SemaTypeKind.TkAlias:
                set bcur is bty.b
                set bty is calling types.at with ns->types, bcur
                set bguard is bguard + 1
            if bty.kind == tk.SemaTypeKind.TkFn:
                return calling c_type with ns, bcur
    if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho or t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
        var info as types.SemaNominalInfo is (ns->types->nominal_infos at t.a)
        if info.template_info >= 0 and calling nominal_erased with ns->types, info:
            var tt as int is calling template_type_of with ns->types, info
            if tt > 0:
                return calling names.type_name with ns, tt
        return calling names.type_name with ns, id
    if t.kind == tk.SemaTypeKind.TkConcept:
        return calling npool.copy_string with "void*"
    if t.kind == tk.SemaTypeKind.TkTypeParam:
        if calling ns->subst.has with t.name:
            var sid as int is calling ns->subst.get with t.name
            # Un mapeo identidad (`T -> T`) no resuelve nada: sin este guard la
            # recursión no termina.
            if sid != id and sid > 0:
                return calling c_type with ns, sid
        return calling npool.copy_string with "void*"
    return calling npool.copy_string with "void*"

## Declarador C de un nombre con el tipo `ct`.
##
## Si `ct` contiene el hueco `(*)` de un puntero a función, el nombre se inserta
## ahí (`int32_t (*value)(PsParser*)`); en otro caso se usa `tipo nombre`.
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave declare with ct as string, name as string into string:
    var n as int is ct length
    var i as int is 0
    var done as bool is false
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    while i < n:
        if i + 2 < n:
            var three as string is ct at i to (i + 3)
            if three == "(*)" and not done:
                banish three
                calling sb.append with "(*"
                calling sb.append with name
                calling sb.append with ")"
                set done is true
                set i is i + 3
            else:
                banish three
                var one as string is ct at i to (i + 1)
                calling sb.append with one
                banish one
                set i is i + 1
        else:
            var one2 as string is ct at i to (i + 1)
            calling sb.append with one2
            banish one2
            set i is i + 1
    var body as string is calling sb.finish
    if body == ct:
        var out as string is "{ct} {name}"
        banish body
        return out
    return body

## Tipo C de un primitivo canónico.
##
## Devuelve un string owned (literal o pool).
weave base_c_type with ns as ref to names.CgNames, nid as int into string:
    var n as string is calling std_text with ns, nid
    defer banish n
    var nb as ref to frozen byte is bytes of n
    var ni as int is 0
    while ni < (n length):
        if ((nb at ni) to int) == 0:
            calling spark.panic with "NUL base name nid {nid} len {n length}: {n}"
        set ni is ni + 1
    if n == "int" or n == "i32":
        return calling npool.copy_string with "int32_t"
    if n == "i64":
        return calling npool.copy_string with "int64_t"
    if n == "u32":
        return calling npool.copy_string with "uint32_t"
    if n == "u64":
        return calling npool.copy_string with "uint64_t"
    if n == "i16":
        return calling npool.copy_string with "int16_t"
    if n == "u16":
        return calling npool.copy_string with "uint16_t"
    if n == "i8":
        return calling npool.copy_string with "int8_t"
    if n == "u8" or n == "byte":
        return calling npool.copy_string with "uint8_t"
    if n == "char":
        return calling npool.copy_string with "char"
    if n == "usize":
        return calling npool.copy_string with "size_t"
    if n == "isize":
        return calling npool.copy_string with "intptr_t"
    if n == "float" or n == "f32":
        return calling npool.copy_string with "float"
    if n == "f64" or n == "double":
        return calling npool.copy_string with "double"
    if n == "bool":
        return calling npool.copy_string with "bool"
    if n == "va_list":
        return calling npool.copy_string with "va_list"
    if n == "string":
        return calling npool.copy_string with "PenguString"
    if n == "void":
        return calling npool.copy_string with "void"
    if n == "opaque":
        return calling npool.copy_string with "void*"
    if n == "error":
        return calling npool.copy_string with "const char*"
    return "{n}"

## Texto de un NameId (owned).
weave std_text with ns as ref to names.CgNames, nid as int into string:
    return calling npool.copy_string with (calling npool.text with ns->names, nid)

## Nombre de una tupla sintética.
weave tuple_c_name with ns as ref to names.CgNames, id as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "PenguTuple"
    var t as tk.SemaType is calling types.at with ns->types, id
    var i as int is 0
    while i < t.count:
        calling sb.append with "_"
        var cid as int is (ns->types->type_children at (t.first + i))
        var cn as string is calling c_type with ns, cid
        var ci as int is 0
        var cnb as ref to frozen byte is bytes of cn
        while ci < cn length:
            var cc as int is ((cnb at ci) to int)
            if (cc >= 48 and cc <= 57) or (cc >= 65 and cc <= 90) or (cc >= 97 and cc <= 122) or cc == 95:
                var ch as string is cn at ci to (ci + 1)
                calling sb.append with ch
                banish ch
            else:
                calling sb.append with "_"
            set ci is ci + 1
        banish cn
        set i is i + 1
    return calling sb.finish

## Tipo C de una función, como declarador sin nombre.
weave fn_c_type with ns as ref to names.CgNames, info_idx as int into string:
    var info as types.SemaFnInfo is (ns->types->fn_infos at info_idx)
    var ret as string is calling c_type with ns, info.return_type
    defer banish ret
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with ret
    calling sb.append with " (*)("
    var fixed as int is info.params_count
    var has_varargs as bool is false
    if fixed > 0:
        var lastp as types.SemaFnParam is (ns->types->fn_params at (info.params_first + fixed - 1))
        var lty as tk.SemaType is calling types.at with ns->types, lastp.type
        if lty.kind == tk.SemaTypeKind.TkCVarArgs:
            set has_varargs is true
            set fixed is fixed - 1
    if fixed == 0 and not has_varargs:
        calling sb.append with "void"
    else:
        var i as int is 0
        while i < fixed:
            if i > 0:
                calling sb.append with ", "
            var p as types.SemaFnParam is (ns->types->fn_params at (info.params_first + i))
            var pc as string is calling c_type with ns, p.type
            calling sb.append with pc
            banish pc
            set i is i + 1
        if has_varargs:
            if fixed > 0:
                calling sb.append with ", "
            calling sb.append with "..."
    calling sb.append with ")"
    return calling sb.finish

## Nombre C de un puntero a `pt`, válido también si `pt` es un puntero a función.
##
## `c_type` imprime los punteros a función como `R (*)(A)`, donde el `*` va
## dentro del paréntesis; añadir otro `*` al final produce un tipo C inválido.
## El puntero a `R (*)(A)` es `R (**)(A)`.
##
## ## Memoria
## Devuelve un string owned.
weave pointer_type_name with pt as string into string:
    if calling scrolls.contains with pt, "(*)":
        return calling scrolls.replace with pt, "(*)", "(**)"
    return "{pt}*"
