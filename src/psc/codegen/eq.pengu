## psc/codegen/eq.pengu — igualdad estructural (`==`, `!=`) por tipo.
##
## Una sola tabla para comparar valores: `a == b` sobre runas, ecos y omens
## compara **campo a campo** (como el `operator ==` con `= default` del
## dialecto C++), y los contenedores delegan en los ayudantes de
## `<pengu_runtime.h>` (`pengu_list_equal`, `pengu_map_equal`, ...).
##
## El backend emite, por cada tipo alcanzable:
##
##   static inline bool _pengu_eq_T(const T *a, const T *b);   // nominales
##   static inline bool _pengu_eqv_<id>(const void *a, const void *b);
##
## `_pengu_eqv_<id>` es el comparador de *elemento* que esperan los
## contenedores: recibe direcciones y compara los valores apuntados. Se emite
## para todo tipo que pueda aparecer dentro de una lista, un mapa o un payload,
## así que no hace falta un comparador escrito a mano en ningún sitio.
##
## ## Memoria
## Emite C; los strings C que construye son owned.

import std.scrolls as scrolls

import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.names as npool

import psc.codegen.context as context
import psc.codegen.ctype as ctype
import psc.codegen.catalog as catalog
import psc.codegen.emit as emit

insignia psc_codegen_eq_

## Expresión C de igualdad entre los valores `a` y `b`, ambos de tipo `ty`.
##
## `a`/`b` son expresiones direccionables del tipo ya bajado a C. Los tipos
## sin comparación estructural posible (tuplas internas, parámetros de tipo)
## caen en una comparación de bytes, que es la identidad del valor.
##
## ## Memoria
## El string devuelto es owned.
weave eq_expr with c as ref to context.CgContext, ty as int, a as string, b as string into string:
    if ty < 0 or ty >= c->program->types.types.len:
        return "true"
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
        return calling eq_expr with c, t.b, a, b
    if t.kind == tk.SemaTypeKind.TkBase:
        var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), t.name)
        defer banish bn
        if bn == "string":
            return "pengu_string_equal({a}, {b})"
        return "(({a}) == ({b}))"
    if t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkOpaque or t.kind == tk.SemaTypeKind.TkFn or t.kind == tk.SemaTypeKind.TkNull:
        return "(({a}) == ({b}))"
    if t.kind == tk.SemaTypeKind.TkArray:
        var ect as string is calling ctype.c_type with (sigil of c->names), t.a
        defer banish ect
        var an as int is t.b
        if an < 0:
            set an is 0
        return "pengu_array_equal(&({a}), &({b}), {an}, sizeof({ect}), _pengu_eqv_{t.a})"
    if t.kind == tk.SemaTypeKind.TkList:
        return "pengu_list_equal(&({a}), &({b}), _pengu_eqv_{t.a})"
    if t.kind == tk.SemaTypeKind.TkSlice:
        return "pengu_slice_equal(&({a}), &({b}), _pengu_eqv_{t.a})"
    if t.kind == tk.SemaTypeKind.TkMap:
        return "pengu_map_equal(&({a}), &({b}), _pengu_eqv_{t.a}, _pengu_eqv_{t.b})"
    if t.kind == tk.SemaTypeKind.TkMaybe:
        return "pengu_maybe_equal(&({a}), &({b}), _pengu_eqv_{t.a})"
    if t.kind == tk.SemaTypeKind.TkResult:
        return "pengu_result_equal(&({a}), &({b}), _pengu_eqv_{t.a}, _pengu_eqv_{t.b})"
    if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho or t.kind == tk.SemaTypeKind.TkOmen:
        var ct as string is calling ctype.c_type with (sigil of c->names), ty
        defer banish ct
        return "_pengu_eq_{ct}(&({a}), &({b}))"
    return "(memcmp(&({a}), &({b}), sizeof({a})) == 0)"

## Registra `ty` y todo lo que cuelga de él para emitir sus comparadores.
##
## Idempotente: la segunda visita de un tipo no hace nada. Se llama antes de
## emitir ningún prototipo, porque un `list of B` dentro de `A` necesita el
## `_pengu_eqv_B` de un tipo que puede declararse después.
##
## ## Memoria
## Añade a `c->eq_ids`; no retiene strings.
weave collect_eq with c as ref to context.CgContext, ty as int into void:
    if ty < 0 or ty >= c->program->types.types.len:
        return
    var i as int is 0
    while i < c->eq_ids.len:
        if (c->eq_ids at i) == ty:
            return
        set i is i + 1
    calling eq_ids_push with c, ty
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
        calling collect_eq with c, t.b
        return
    if t.kind == tk.SemaTypeKind.TkList or t.kind == tk.SemaTypeKind.TkSlice or t.kind == tk.SemaTypeKind.TkMaybe or t.kind == tk.SemaTypeKind.TkArray:
        calling collect_eq with c, t.a
        return
    if t.kind == tk.SemaTypeKind.TkMap or t.kind == tk.SemaTypeKind.TkResult:
        calling collect_eq with c, t.a
        calling collect_eq with c, t.b
        return
    if t.kind == tk.SemaTypeKind.TkTuple:
        var fi as int is 0
        while fi < t.count:
            calling collect_eq with c, (c->program->types.type_children at (t.first + fi))
            set fi is fi + 1
        return
    if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho or t.kind == tk.SemaTypeKind.TkOmen:
        if t.a < 0 or t.a >= c->program->types.nominal_infos.len:
            return
        var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
        var j as int is 0
        while j < info.fields_count:
            var f as types.SemaField is (c->program->types.fields at (info.fields_first + j))
            calling collect_eq with c, f.type
            set j is j + 1
        if t.kind == tk.SemaTypeKind.TkOmen:
            var v as int is 0
            while v < info.variants_count:
                var vr as types.SemaVariant is (c->program->types.variants at (info.variants_first + v))
                var k as int is 0
                while k < vr.payload_count:
                    var pf as types.SemaField is (c->program->types.fields at (vr.payload_first + k))
                    calling collect_eq with c, pf.type
                    set k is k + 1
                set v is v + 1
        return

## Añade `ty` a `c->eq_ids`.
##
## ## Memoria
## Reserva en el vector del contexto.
weave eq_ids_push with c as ref to context.CgContext, ty as int into void:
    calling c->eq_ids.push with ty

## Emite los prototipos de todos los comparadores registrados.
##
## ## Memoria
## Emite C.
weave emit_decls with c as ref to context.CgContext into void:
    var i as int is 0
    while i < c->eq_ids.len:
        var ty as int is (c->eq_ids at i)
        calling emit.line with (sigil of c->emitter), "static inline bool _pengu_eqv_{ty}(const void* a, const void* b);"
        set i is i + 1
    var j as int is 0
    while j < c->eq_ids.len:
        var ny as int is (c->eq_ids at j)
        if calling is_nominal with c, ny:
            var nct as string is calling ctype.c_type with (sigil of c->names), ny
            defer banish nct
            calling emit.line with (sigil of c->emitter), "static inline bool _pengu_eq_{nct}(const {nct}* a, const {nct}* b);"
        set j is j + 1

## Emite los cuerpos `_pengu_eqv_<id>` (comparadores de elemento).
##
## ## Memoria
## Emite C.
weave emit_elem_bodies with c as ref to context.CgContext into void:
    var i as int is 0
    while i < c->eq_ids.len:
        var ty as int is (c->eq_ids at i)
        var ct as string is calling ctype.c_type with (sigil of c->names), ty
        defer banish ct
        var body as string is calling eq_expr with c, ty, "(*((const {ct}*)a))", "(*((const {ct}*)b))"
        defer banish body
        var tv as tk.SemaType is calling types.at with (sigil of c->program->types), ty
        if tv.kind == tk.SemaTypeKind.TkFn or calling scrolls.contains with ct, "(*)":
            # Un puntero a función no admite `const T*` (el `*` se come el
            # paréntesis): se compara la representación, que es su identidad.
            var fbody as string is "memcmp(a, b, sizeof({ct})) == 0"
            banish body
            set body is fbody
        calling emit.line with (sigil of c->emitter), "static inline bool _pengu_eqv_{ty}(const void* a, const void* b) {{"
        calling emit.indent_more with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "(void)a; (void)b;"
        calling emit.line with (sigil of c->emitter), "return {body};"
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "}"
        set i is i + 1

## Emite el cuerpo `_pengu_eq_T` de un tipo nominal (runa, eco u omen).
##
## ## Memoria
## Emite C.
weave emit_body with c as ref to context.CgContext, ty as int into void:
    if not (calling is_nominal with c, ty):
        return
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var cname as string is calling ctype.c_type with (sigil of c->names), ty
    var seen as bool is false
    var si as int is 0
    while si < c->eq_names.len:
        if (c->eq_names at si) == cname:
            set seen is true
            break
        set si is si + 1
    if seen:
        banish cname
        return
    calling c->eq_names.push with cname
    calling emit.line with (sigil of c->emitter), "static inline bool _pengu_eq_{cname}(const {cname}* a, const {cname}* b) {{"
    calling emit.indent_more with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "if (a == b) return true;"
    calling emit.line with (sigil of c->emitter), "(void)a; (void)b;"
    if t.a < 0 or t.a >= c->program->types.nominal_infos.len:
        calling emit.line with (sigil of c->emitter), "return true;"
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "}"
        return
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    if t.kind == tk.SemaTypeKind.TkOmen:
        calling emit_omen_body with c, t, info, cname
    else:
        calling emit_fields_body with c, info, "a", "b"
    calling emit.indent_less with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "}"

## Cuerpo de igualdad de una runa/eco: conjunción de campos.
##
## ## Memoria
## Emite C.
weave emit_fields_body with c as ref to context.CgContext, info as types.SemaNominalInfo, an as string, bn as string into void:
    if info.fields_count == 0:
        calling emit.line with (sigil of c->emitter), "return true;"
        return
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling sb.append with "return "
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + i))
        var fname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.name)
        defer banish fname
        if i > 0:
            calling sb.append with " && "
        var fe as string is calling eq_expr with c, f.type, "{an}->{fname}", "{bn}->{fname}"
        calling sb.append with fe
        banish fe
        set i is i + 1
    calling sb.append with ";"
    var text as string is calling sb.finish
    defer banish text
    calling emit.line with (sigil of c->emitter), text

## Cuerpo de igualdad de un omen: misma etiqueta y mismo payload.
##
## Un omen sin payload compara solo la etiqueta; con payload, el `switch` fija
## la variante y compara sus campos (el payload activo es el único legible).
##
## ## Memoria
## Emite C.
weave emit_omen_body with c as ref to context.CgContext, t as tk.SemaType, info as types.SemaNominalInfo, cname as string into void:
    var hasp as bool is false
    var i as int is 0
    while i < info.variants_count:
        var v as types.SemaVariant is (c->program->types.variants at (info.variants_first + i))
        if v.payload_count > 0:
            set hasp is true
        set i is i + 1
    if not hasp:
        # Un omen sin payload se baja a un `enum` de C: no hay `tag`, se
        # compara el valor entero.
        calling emit.line with (sigil of c->emitter), "return (*a) == (*b);"
        return
    calling emit.line with (sigil of c->emitter), "if (a->tag != b->tag) return false;"
    calling emit.line with (sigil of c->emitter), "switch (a->tag) {"
    var j as int is 0
    while j < info.variants_count:
        var vr as types.SemaVariant is (c->program->types.variants at (info.variants_first + j))
        var vn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), vr.name)
        defer banish vn
        if vr.payload_count == 0:
            calling emit.line with (sigil of c->emitter), "case {cname}_{vn}: return true;"
            set j is j + 1
            continue
        calling emit.line with (sigil of c->emitter), "case {cname}_{vn}: {{"
        calling emit.indent_more with (sigil of c->emitter)
        calling emit_payload_conj with c, vr, vn
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "}}"
        set j is j + 1
    calling emit.line with (sigil of c->emitter), "default: return true;"
    calling emit.line with (sigil of c->emitter), "}"

## Conjunción de los campos del payload de una variante.
##
## ## Memoria
## Emite C.
weave emit_payload_conj with c as ref to context.CgContext, vr as types.SemaVariant, vn as string into void:
    var i as int is 0
    while i < vr.payload_count:
        var pf as types.SemaField is (c->program->types.fields at (vr.payload_first + i))
        var pn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), pf.name)
        defer banish pn
        var pe as string is calling eq_expr with c, pf.type, "a->data.{vn}.{pn}", "b->data.{vn}.{pn}"
        defer banish pe
        calling emit.line with (sigil of c->emitter), "if (!({pe})) return false;"
        set i is i + 1
    calling emit.line with (sigil of c->emitter), "return true;"

## `true` si `ty` es una runa, eco u omen (tiene `_pengu_eq_T` propio).
##
## ## Memoria
## No asigna.
weave is_nominal with c as ref to context.CgContext, ty as int into bool:
    if ty < 0 or ty >= c->program->types.types.len:
        return false
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    return t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho or t.kind == tk.SemaTypeKind.TkOmen
