## psc/codegen/context.pengu — estado de una emisión C.
##
## El contexto presta el `SemaProgram`; es dueño del nombre table, catálogo,
## emisor y scopes C. No muta F3.

import std.builder

import psc.sema.names as npool
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.symbols.symbol as sym
import psc.sema.symbols.table as symbols
import psc.sema.modules.program as program
import psc.ast.kind as pskind
import psc.sema.ast as astutil

import psc.codegen.options as opts
import psc.codegen.keywords as keywords
import psc.codegen.names as names
import psc.codegen.catalog as catalog
import psc.codegen.emit as emit
import psc.sema.generics.instantiate as ginst

insignia psc_codegen_context_

## Binding local C.
rune CgLocal:
    ## `NameId` lógico.
    name as int
    ## `TypeId`.
    type as int
    ## Nombre C (`NameId` en el pool).
    c_name as int

## Lambda descubierta en el AST.
rune CgLambda:
    ## Módulo dueño.
    module as int
    ## Nodo `lambda_expr`.
    node as int

## Contexto de emisión.
##
## ## Memoria
## Dueño de names/catalog/emitter/locales; liberar con `free`.
rune CgContext:
    ## Programa F3 prestado.
    program as ref to program.SemaProgram
    ## Opciones prestadas.
    options as opts.CgOptions
    ## Nombres C.
    names as names.CgNames
    ## Catálogo de funciones.
    catalog as catalog.CgCatalog
    ## Emisor.
    emitter as emit.CgEmitter
    ## Locales del cuerpo actual.
    locals as vector of CgLocal
    ## `defer` pendientes (nodos AST), en orden de declaración.
    defers as vector of int
    ## `errdefer` pendientes (nodos AST), en orden de declaración.
    errdefers as vector of int
    ## `NameId` de los parámetros de la función en curso.
    param_names as vector of int
    ## `NameId` de los locales que son vistas prestadas de otro dueño
    ## (elementos de `for`, payloads de `judge`): no se promocionan ni se
    ## liberan aquí.
    borrowed_names as vector of int
    ## `true` mientras se resuelve el destino de un `set`: un acceso `at` sobre
    ## una lista pasa por `pengu_cow_list_at_mut` para no escribir en un buffer
    ## compartido. El `at` de lectura no lo toca.
    writing_target as bool
    ## Destructores automáticos pendientes (`derive Drop`): nombre C (`NameId`).
    drop_names as vector of int
    ## `TypeId` de cada destructor automático (paralelo a `drop_names`).
    drop_types as vector of int
    ## Índice de `drop_names` donde empieza cada scope C abierto.
    drop_marks as vector of int
    ## Índice de `defers` donde empieza cada scope C abierto.
    scope_marks as vector of int
    ## Índice de `errdefers` donde empieza cada scope C abierto.
    err_marks as vector of int
    ## `true` si el scope correspondiente es un loop (break/continue).
    scope_loops as vector of bool
    ## Expresiones C de los `with target:` abiertos (owned, LIFO).
    with_targets as vector of string
    ## `TypeId` de cada `with target:` abierto (paralelo a `with_targets`).
    with_types as vector of int
    ## Nombre C de la etiqueta de cada loop abierto ("" = sin etiqueta).
    loop_names as vector of string
    ## Profundidad de bloques `unsafe:` (0 = checks activos).
    unsafe_depth as int
    ## `TypeId` de retorno actual (`-1` fuera).
    return_type as int
    ## Módulo actual (`-1` fuera).
    current_module as int
    ## Nombre C de la función actual (owned).
    current_fn as string
    ## Tipo `self` actual (`-1` si no).
    self_type as int
    ## `true` si `self` es valor.
    self_value as bool
    ## Lambdas descubiertas (para emitir funciones C).
    lambdas as vector of CgLambda
    ## Errores internos de codegen.
    errors as int
    ## Secuencia para nombres temporales únicos (`_pengu_tup0`, …).
    tmp_seq as int
    ## Hook de F4 para reducir un bloque en posición de valor.
    #
    # `stmt` lo instala al empezar el bundle (evita el ciclo de imports
    # expr↔stmt). El valor por defecto no debería alcanzarse.
    block_value as weave with c as ref to CgContext, node as int, expected as int into string

## Hook por defecto: un bloque en posición de valor sin instalador.
##
## ## Memoria
## Devuelve un literal owned.
weave block_value_unset with c as ref to CgContext, node as int, expected as int into string:
    return "0"

## Crea un contexto para un programa.
##
## ## Memoria
## Asigna tablas/emisor; liberar con `free`.
weave new_context with p as ref to program.SemaProgram, o as opts.CgOptions into CgContext:
    var ns as names.CgNames is calling names.new_names with (sigil of p->names), (sigil of p->types), o.family
    var cat as catalog.CgCatalog is calling catalog.catalog_collect with p, o
    return with block_value is block_value_unset, program is p, options is o, names is ns, catalog is cat, emitter is calling emit.new_emitter, locals is vector of CgLocal, defers is vector of int, errdefers is vector of int, param_names is vector of int, borrowed_names is vector of int, writing_target is false, drop_names is vector of int, drop_types is vector of int, drop_marks is vector of int, scope_marks is vector of int, err_marks is vector of int, scope_loops is vector of bool, with_targets is vector of string, with_types is vector of int, loop_names is vector of string, unsafe_depth is 0, return_type is -1, current_module is -1, current_fn is "", self_type is -1, self_value is false, lambdas is vector of CgLambda, errors is 0, tmp_seq is 0

## Libera el contexto.
##
## ## Memoria
## Libera nombres, catálogo, emisor y locals.
weave context_free with c as ref to CgContext into void:
    calling names.names_free with (sigil of c->names)
    calling catalog.catalog_free with (sigil of c->catalog)
    calling emit.emit_free with (sigil of c->emitter)
    banish c->locals
    banish c->lambdas
    banish c->defers
    banish c->errdefers
    banish c->param_names
    banish c->borrowed_names
    banish c->drop_names
    banish c->drop_types
    banish c->drop_marks

    banish c->scope_marks
    banish c->err_marks
    banish c->scope_loops
    for target in c->with_targets:
        banish target
    banish c->with_targets
    banish c->with_types
    for ln in c->loop_names:
        banish ln
    banish c->loop_names
    banish c->current_fn

## Fija la sustitución de type params de una función.
##
## ## Memoria
## Vacía el mapa anterior.
weave set_subst with c as ref to CgContext, f as catalog.CgFunction into void:
    banish c->names.subst
    set c->names.subst is map of int, int
    var i as int is 0
    while i < f.tparams.len and i < f.spec_args.len:
        calling c->names.subst.put with (f.tparams at i), (f.spec_args at i)
        set i is i + 1

## Abre un scope C para `defer`/`break`/`continue`.
##
## ## Memoria
## Añade dos marcas POD.
weave cg_scope_push with c as ref to CgContext, is_loop as bool into void:
    calling c->scope_marks.push with c->defers.len
    calling c->err_marks.push with c->errdefers.len
    calling c->drop_marks.push with c->drop_names.len
    calling c->scope_loops.push with is_loop

## Cierra el scope C actual (el llamador ya emitió sus defers).
##
## ## Memoria
## Quita dos marcas POD.
weave cg_scope_pop with c as ref to CgContext into void:
    if c->scope_marks.len > 0:
        var m as int is calling c->scope_marks.pop
        var l as bool is calling c->scope_loops.pop
    if c->err_marks.len > 0:
        var em as int is calling c->err_marks.pop
    if c->drop_marks.len > 0:
        var dm as int is calling c->drop_marks.pop

## Índice de `defers` donde empieza el scope actual (0 si no hay).
##
## ## Memoria
## O(1).
weave current_scope_mark with c as ref to CgContext into int:
    if c->scope_marks.len == 0:
        return 0
    return (c->scope_marks at (c->scope_marks.len - 1))

## Índice de `drop_names` donde empieza el scope actual (0 si no hay).
##
## ## Memoria
## O(1).
weave current_drop_mark with c as ref to CgContext into int:
    if c->drop_marks.len == 0:
        return 0
    return (c->drop_marks at (c->drop_marks.len - 1))

## Registra un destructor automático en el scope actual.
##
## `c_name` es el `NameId` del nombre C del local (lo que devuelve
## `add_local`) y `type_id` su tipo. Se emiten en orden inverso al salir.
##
## ## Memoria
## Añade dos enteros POD.
weave add_drop with c as ref to CgContext, c_name as int, type_id as int into void:
    calling c->drop_names.push with c_name
    calling c->drop_types.push with type_id

## Anula el destructor automático de un local que se mueve (`return x`).
##
## Marca la entrada como movida (`type = -1`) en vez de compactar la lista:
## el `return` ocurre al final del cuerpo y la entrada no vuelve a usarse.
##
## ## Memoria
## O(n); scopes pequeños.
weave remove_drop with c as ref to CgContext, c_name as int into void:
    var i as int is c->drop_names.len - 1
    while i >= 0:
        if (c->drop_names at i) == c_name:
                set c->drop_types at i is -1
                return
        set i is i - 1

## Registra un `defer` en el scope actual.
##
## ## Memoria
## Añade un nodo AST (POD).
weave add_defer with c as ref to CgContext, node as int into void:
    calling c->defers.push with node

## Registra un `errdefer` en el scope actual.
##
## ## Memoria
## Añade un nodo AST (POD).
weave add_errdefer with c as ref to CgContext, node as int into void:
    calling c->errdefers.push with node

## Abre un `with target:` con su expresión C y su tipo.
##
## ## Memoria
## `text` se transfiere a la pila; se libera al hacer `pop_with`.
weave push_with with c as ref to CgContext, text as string, type_id as int into void:
    calling c->with_targets.push with text
    calling c->with_types.push with type_id

## Cierra el `with target:` más interno y libera su texto.
##
## ## Memoria
## Libera la expresión C transferida por `push_with`.
weave pop_with with c as ref to CgContext into void:
    if c->with_targets.len > 0:
        var t as string is calling c->with_targets.pop
        banish t
    if c->with_types.len > 0:
        var ignored as int is calling c->with_types.pop

## Limpia todos los defers y scopes (nueva función/cuerpo).
##
## ## Memoria
## Vacía listas; los nodos son del AST.
weave clear_scopes with c as ref to CgContext into void:
    var n as int is c->defers.len
    while n > 0:
        var ignored as int is calling c->defers.pop
        set n is n - 1
    var m as int is c->scope_marks.len
    while m > 0:
        var ignored_m as int is calling c->scope_marks.pop
        set m is m - 1
    var l as int is c->scope_loops.len
    while l > 0:
        var ignored_l as bool is calling c->scope_loops.pop
        set l is l - 1
    var ed as int is c->errdefers.len
    while ed > 0:
        var ignored_ed as int is calling c->errdefers.pop
        set ed is ed - 1
    var em as int is c->err_marks.len
    while em > 0:
        var ignored_em as int is calling c->err_marks.pop
        set em is em - 1
    var dn as int is c->drop_names.len
    while dn > 0:
        var ignored_dn as int is calling c->drop_names.pop
        set dn is dn - 1
    var dt as int is c->drop_types.len
    while dt > 0:
        var ignored_dt as int is calling c->drop_types.pop
        set dt is dt - 1
    var dmk as int is c->drop_marks.len
    while dmk > 0:
        var ignored_dmk as int is calling c->drop_marks.pop
        set dmk is dmk - 1

## Registra un parámetro de la función en curso.
##
## ## Memoria
## O(1) amortizado.
weave add_param with c as ref to CgContext, name as int into void:
    calling c->param_names.push with name

## Marca un local como vista prestada de otro dueño.
##
## Los elementos de `for` y los payloads de `judge` se copian del contenedor
## con `memcpy`: el handle apunta a un buffer que liberará su dueño. Promover
## o banishar ese local liberaría memoria ajena.
##
## ## Memoria
## O(1) amortizado.
weave mark_borrowed with c as ref to CgContext, name as int into void:
    calling c->borrowed_names.push with name

## ¿El `NameId` es una vista prestada?
##
## ## Memoria
## O(n) sobre los préstamos del cuerpo.
weave is_borrowed_name with c as ref to CgContext, name as int into bool:
    var i as int is 0
    while i < c->borrowed_names.len:
        if (c->borrowed_names at i) == name:
            return true
        set i is i + 1
    return false

## ¿El `NameId` es un parámetro de la función en curso?
##
## ## Memoria
## O(n) sobre los parámetros.
weave is_param_name with c as ref to CgContext, name as int into bool:
    var i as int is 0
    while i < c->param_names.len:
        if (c->param_names at i) == name:
            return true
        set i is i + 1
    return false

## ¿El nombre C `txt` corresponde a un parámetro de la función en curso?
##
## Compara por el nombre C, que es lo único que el emisor tiene a mano al
## asignar (`set x is ...`).
##
## ## Memoria
## O(locales · parámetros); no asigna.
weave is_param_c_name with c as ref to CgContext, txt as string into bool:
    var i as int is c->locals.len - 1
    while i >= 0:
        var l as CgLocal is (c->locals at i)
        var lt as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), l.c_name)
        if lt == txt:
            banish lt
            return calling is_param_name with c, l.name
        banish lt
        set i is i - 1
    return false

## Añade un local al scope C actual.
##
## ## Memoria
## Añade a `locals`; el nombre C es un `NameId`.
weave add_local with c as ref to CgContext, name as int, type_id as int, c_name as int into void:
    var cid as int is c_name
    if c_name >= 0:
        var raw as string is calling npool.text with c->names.names, c_name
        var safe as string is calling safe_ident with c, raw
        if safe != raw:
                set cid is calling npool.intern with c->names.names, safe
        banish safe
    var l as CgLocal is with name is name, type is type_id, c_name is cid
    calling c->locals.push with l

## Busca el tipo de un local.
##
## ## Memoria
## O(n); scopes pequeños.
weave local_type with c as ref to CgContext, name as int into int:
    var i as int is c->locals.len - 1
    while i >= 0:
        var l as CgLocal is (c->locals at i)
        if l.name == name:
                if c->names.subst.len > 0:
                    return calling ginst.subst_deep with (sigil of c->program->symbols), l.type, c->names.subst
                return l.type
        set i is i - 1
    return -1

## Busca el nombre C de un local.
##
## ## Memoria
## O(n).
weave local_c_name with c as ref to CgContext, name as int into int:
    var i as int is c->locals.len - 1
    while i >= 0:
        var l as CgLocal is (c->locals at i)
        if l.name == name:
                return l.c_name
        set i is i - 1
    return -1

## Vacía los locales (fin de función).
##
## ## Memoria
## O(1).
weave clear_locals with c as ref to CgContext into void:
    var n as int is c->locals.len
    while n > 0:
        var ignored as CgLocal is calling c->locals.pop
        set n is n - 1

## `true` para identificadores que son palabras reservadas de C.
##
## PenguScript permite parámetros como `default` o `case`; emitirlos tal cual
## produce C inválido. La capa C les añade un sufijo `_` de forma consistente.
## La tabla vive en `keywords.pengu` (sin dependencias) para poder testearla
## sola.
##
## ## Memoria
## No asigna.
weave is_c_keyword with s as string into bool:
    return calling keywords.is_c_keyword with s

## Nombre seguro para un identificador de PenguScript en la familia `family`
## (`"c"` o `"cpp"`).
##
## Ver `keywords.mangle_ident`: sanea bytes no identificables y resuelve la
## colisión con palabras reservadas (`_` en C, `_p` en C++).
##
## ## Memoria
## Devuelve string owned.
weave safe_name with s as string, family as string into string:
    return calling keywords.mangle_ident with s, family

## Nombre seguro para un identificador en el dialecto de `c`.
##
## Es el punto de entrada que debe usar el emisor: parámetros, locales, campos,
## constantes y etiquetas pasan por aquí, así que la familia (`"c"`/`"cpp"`)
## decide el mangling de palabras reservadas.
##
## ## Memoria
## Devuelve string owned.
weave safe_ident with c as ref to CgContext, s as string into string:
    return calling safe_name with s, c->options.family

## Nombre C seguro para un identificador de PenguScript.
##
## ## Memoria
## Devuelve string owned.
weave safe_c_name with s as string into string:
    return calling safe_name with s, "c"

## Abre un nivel de loop con su etiqueta ("" si no tiene).
##
## ## Memoria
## Transfiere `label`.
weave push_loop with c as ref to CgContext, label as string into void:
    calling c->loop_names.push with label

## Cierra el loop más interno y libera su etiqueta.
##
## ## Memoria
## Libera el string transferido por `push_loop`.
weave pop_loop with c as ref to CgContext into void:
    if c->loop_names.len > 0:
        var t as string is calling c->loop_names.pop
        banish t
