## psc/codegen/drop.pengu — el lowering de liberar un valor, por tipo.
##
## Una sola tabla para `banish`, `defer` y los `_pengu_cleanup_T` derivados:
## cada tipo tiene UNA forma de liberarse y se ve en `psc emit-c`.
##
## El modelo actual es de handles prestados: liberar un contenedor libera su
## búfer, no sus elementos (§13.4 de `docs/LANGUAGE.md`). El bucle que libera
## elementos entra cuando el contenedor pase a ser dueño de lo que guarda
## (fase COW), porque sólo entonces el drop recursivo es seguro.
##
## ## Memoria
## Emite C; los strings C que construye son owned.

import psc.ast.kind as pskind
import psc.sema.ast as astutil
import psc.sema.modules.loader as loader
import psc.ast.node as psast
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.names as npool

import psc.codegen.context as context
import psc.codegen.ctype as ctype
import psc.codegen.emit as emit

insignia psc_codegen_drop_

## Emite la liberación del valor que vive en `target`.
##
## `target` es una expresión C direccionable (`x`, `p->campo`,
## `xs.data[i]`). Un `TypeId` inválido o `-1` no emite nada: los tipos
## escalares no tienen nada que liberar.
##
## ## Memoria
## Emite C; los strings C que construye son owned.
## Clasifica un tipo de contenedor para el COW: 0 ninguno, 1 string, 2 list,
## 3 map.  Con `--legacy-copy` (o `[build] legacy_copy`) devuelve 0: el
## compilador emite entonces la copia de handle de 0.51 y ninguna llamada
## `ensure_unique`, que es lo que necesita el autohospedaje durante la
## transicion.
##
## ## Memoria
## O(1).
weave cow_kind_of with c as ref to context.CgContext, ty as int into int:
    if ty <= 0:
        return 0
    if c->options.legacy_copy:
        return 0
    if ty >= c->program->types.types.len:
        return 0
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var guard as int is 0
    while guard < 8 and (t.kind == tk.SemaTypeKind.TkRef or t.kind == tk.SemaTypeKind.TkFrozen or t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal):
        set ty is t.a
        set t is calling types.at with (sigil of c->program->types), ty
        set guard is guard + 1
    if t.kind == tk.SemaTypeKind.TkList:
        return 2
    if t.kind == tk.SemaTypeKind.TkMap:
        return 3
    if t.kind == tk.SemaTypeKind.TkBase:
        var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), t.name)
        defer banish bn
        if bn == "string":
            return 1
    return 0

## Emite el `share` de COW del handle `target` (incrementa el contador o copia
## un alias legacy a un buffer propio).
##
## ## Memoria
## O(1) si ya es COW; O(n) al promocionar un valor legacy.
weave emit_cow_share with c as ref to context.CgContext, kind as int, target as string into void:
    var fn as string is "pengu_cow_string_share"
    if kind == 2:
        set fn is "pengu_cow_list_share"
    if kind == 3:
        set fn is "pengu_cow_map_share"
    calling emit.line with (sigil of c->emitter), "{fn}(&({target}));"

## Emite el `ensure_unique` de COW: separa el buffer si el handle lo comparte.
##
## ## Memoria
## O(1) si es unico; O(n) si esta compartido.
weave emit_cow_unique with c as ref to context.CgContext, kind as int, target as string into void:
    var fn as string is "pengu_cow_string_ensure_unique"
    if kind == 2:
        set fn is "pengu_cow_list_ensure_unique"
    if kind == 3:
        set fn is "pengu_cow_map_ensure_unique"
    calling emit.line with (sigil of c->emitter), "{fn}(&({target}));"

## Emite los `share` de COW de un valor compuesto ya copiado.
##
## Copiar una struct copia sus handles tal cual: el contador de COW del `string`
## o de la `list` interior no sube, y los dos destructores liberarían el mismo
## buffer. Aquí se retienen, campo a campo y recursivamente.
##
## ## Memoria
## O(campos alcanzables); no asigna estructuras propias.
weave emit_share_value with c as ref to context.CgContext, ty as int, target as string, depth as int into void:
    if ty <= 0 or depth > 16 or ty >= c->program->types.types.len:
        return
    var cwk as int is calling cow_kind_of with c, ty
    if cwk > 0:
        calling emit_cow_share with c, cwk, target
        return
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var cur as int is ty
    var guard as int is 0
    while (t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal) and guard < 16:
        set cur is t.b
        set t is calling types.at with (sigil of c->program->types), cur
        set guard is guard + 1
    if t.kind != tk.SemaTypeKind.TkRune and t.kind != tk.SemaTypeKind.TkEcho:
        return
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    if (info.flags & types.NIF_DROP) != 0:
        # Un `Drop` es move-only: nunca se copia.
        return
    if (info.flags & types.NIF_OPAQUE) != 0:
        return
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + i))
        var fname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.name)
        var path as string is "({target}).{fname}"
        calling emit_share_value with c, f.type, path, depth + 1
        banish path
        banish fname
        set i is i + 1

## Copia profunda de un valor para `_pengu_clone_T`: el destino queda con sus
## propios búferes, sin compartir contadores ni punteros con el origen.
##
## ## Memoria
## O(campos alcanzables); cada `string` SDS se copia y cada contenedor retiene.
weave emit_clone_into with c as ref to context.CgContext, ty as int, dst as string, src as string, depth as int, top as bool into void:
    if ty <= 0 or depth > 16 or ty >= c->program->types.types.len:
        calling emit.line with (sigil of c->emitter), "{dst} = {src};"
        return
    var cwk as int is calling cow_kind_of with c, ty
    if cwk > 0:
        if cwk == 1:
            calling emit.line with (sigil of c->emitter), "{dst} = pengu_string_share_value({src});"
        else:
            if cwk == 2:
                calling emit.line with (sigil of c->emitter), "{dst} = pengu_list_clone_value({src});"
            else:
                calling emit.line with (sigil of c->emitter), "{dst} = {src};"
                calling emit_cow_share with c, cwk, dst
        return
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var cur as int is ty
    var guard as int is 0
    while (t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal) and guard < 16:
        set cur is t.b
        set t is calling types.at with (sigil of c->program->types), cur
        set guard is guard + 1
    if t.kind != tk.SemaTypeKind.TkRune and t.kind != tk.SemaTypeKind.TkEcho:
        calling emit.line with (sigil of c->emitter), "{dst} = {src};"
        return
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    if (info.flags & types.NIF_OPAQUE) != 0:
        calling emit.line with (sigil of c->emitter), "{dst} = {src};"
        return
    # Un campo `Drop` se copia campo a campo (la recursion ya deja cada búfer
    # propio); llamar a `_pengu_deepclone_T` exigiria una declaracion previa y
    # este helper se emite antes que el deepclone del tipo.
    calling emit.line with (sigil of c->emitter), "{dst} = {src};"
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + i))
        var fname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.name)
        var dpath as string is "({dst}).{fname}"
        var spath as string is "({src}).{fname}"
        calling emit_clone_into with c, f.type, dpath, spath, depth + 1, false
        banish dpath
        banish spath
        banish fname
        set i is i + 1

weave emit_drop_value with c as ref to context.CgContext, ty as int, target as string into void:
    if ty < 0 or ty >= c->program->types.types.len:
        return
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
        if t.b > 0:
            calling emit_drop_value with c, t.b, target
        return
    var ck as int is calling consortium_kind_of with c, ty
    if ck > 0:
        calling emit_consortium_drop with c, ck, ty, target, t
        return
    if t.kind == tk.SemaTypeKind.TkBase:
        var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), t.name)
        defer banish bn
        if bn == "string":
            calling emit.line with (sigil of c->emitter), "pengu_banish_string(&({target}));"
        return
    if t.kind == tk.SemaTypeKind.TkList:
        calling emit.line with (sigil of c->emitter), "pengu_banish_list(&({target}));"
        return
    if t.kind == tk.SemaTypeKind.TkMap:
        calling emit.line with (sigil of c->emitter), "pengu_banish_map(&({target}));"
        return
    if t.kind == tk.SemaTypeKind.TkMaybe:
        calling emit.line with (sigil of c->emitter), "pengu_banish_maybe(&({target}));"
        return
    if t.kind == tk.SemaTypeKind.TkResult:
        calling emit.line with (sigil of c->emitter), "pengu_banish_result(&({target}));"
        return
    if t.kind == tk.SemaTypeKind.TkOmen:
        # Un omen numérico no tiene `_pengu_cleanup_T`: sólo se emite para
        # omens algebraicos con payload (`emit_omen_cleanup`).
        if not calling omen_has_payload with c, t.a:
            return
    if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho or t.kind == tk.SemaTypeKind.TkOmen:
        var ct as string is calling ctype.c_type with (sigil of c->names), ty
        defer banish ct
        calling emit.line with (sigil of c->emitter), "_pengu_cleanup_{ct}(&({target}));"

## `true` si alguna variante del omen `nominal` lleva payload.
##
## ## Memoria
## No asigna.
weave omen_has_payload with c as ref to context.CgContext, nominal as int into bool:
    if nominal <= 0 or nominal >= c->program->types.nominal_infos.len:
        return false
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at nominal)
    var i as int is 0
    while i < info.variants_count:
        var v as types.SemaVariant is (c->program->types.variants at (info.variants_first + i))
        if v.payload_count > 0:
            return true
        set i is i + 1
    return false

## Anota que el valor de `node` sale del binding que lo contiene.
##
## Un `Drop` se mueve al enlazarlo, asignarlo o devolverlo: el destructor del
## binding de origen no debe ejecutarse (el destino pasa a ser el dueño).
##
## ## Memoria
## Sin asignaciones.
weave note_move_source with c as ref to context.CgContext, node as int, ast as ref to psast.PsAst into void:
    if node < 0:
        return
    var v as int is node
    var guard as int is 0
    while (calling astutil.kind_of with ast, v) == pskind.NodeKind.NdParenExpr and guard < 8:
        var inner as int is calling astutil.node_child with ast, v, 0
        if inner < 0:
            return
        set v is inner
        set guard is guard + 1
    if (calling astutil.kind_of with ast, v) != pskind.NodeKind.NdVarRef:
        return
    var tok as int is calling astutil.token_child with ast, v, 0
    if tok < 0:
        return
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), tok
    defer banish txt
    var nid as int is calling npool.intern with (sigil of c->program->names), txt
    var cc as int is calling context.local_c_name with c, nid
    if cc >= 0:
        calling context.remove_drop with c, cc

## Promueve el búfer del binding origen de una copia COW.
##
## ## Memoria
## Si el binding es un `NdVarRef` de tipo lista/mapa, emite la promoción en
## sitio (`pengu_cow_*_promote`): el origen pasa a tener cabecera COW con
## `rc = 1` y la copia siguiente solo incrementa el contador (O(1)).
## Un parámetro o una vista prestada (elemento de `for`, payload de `judge`)
## no es dueño del búfer: no se adopta. Los strings nunca se promocionan: un
## binding legacy puede estar compartido sin contador con un campo o un
## elemento de lista, así que el `share` copia.
weave emit_cow_promote_source with c as ref to context.CgContext, kind as int, node as int, ast as ref to psast.PsAst into void:
    if kind < 2 or kind > 3 or node < 0:
        return
    var v as int is node
    var guard as int is 0
    while (calling astutil.kind_of with ast, v) == pskind.NodeKind.NdParenExpr and guard < 8:
        var inner as int is calling astutil.node_child with ast, v, 0
        if inner < 0:
            return
        set v is inner
        set guard is guard + 1
    if (calling astutil.kind_of with ast, v) != pskind.NodeKind.NdVarRef:
        return
    var tok as int is calling astutil.token_child with ast, v, 0
    if tok < 0:
        return
    var m as loader.SemaModule is (c->program->modules at c->current_module)
    var txt as string is calling astutil.token_text with (sigil of m.source), (sigil of m.lex), tok
    defer banish txt
    var nid as int is calling npool.intern with (sigil of c->program->names), txt
    var cc as int is calling context.local_c_name with c, nid
    if cc >= 0 and not (calling context.is_param_name with c, nid):
        if calling context.is_borrowed_name with c, nid:
            return
        var nm as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), cc)
        defer banish nm
        if kind == 2:
            calling emit.line with (sigil of c->emitter), "pengu_cow_list_promote(&({nm}));"
        if kind == 3:
            calling emit.line with (sigil of c->emitter), "pengu_cow_map_promote(&({nm}));"

## Emite la copia profunda de un valor de `src` a `dst`.
##
## Es la pieza que hace de `.clone()` una copia de verdad: los búferes owned
## (strings, listas, mapas) se duplican y los runes con `derive Drop` se clonan
## recursivamente. Los tipos sin propiedad (`ref`, punteros, escalares) se
## copian tal cual.
##
## ## Memoria
## Emite C; los strings C que construye son owned.
weave clone_value with c as ref to context.CgContext, ty as int, dst as string, src as string into void:
    if ty <= 0 or ty >= c->program->types.types.len:
        calling emit.line with (sigil of c->emitter), "{dst} = {src};"
        return
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
        calling clone_value with c, t.b, dst, src
        return
    if t.kind == tk.SemaTypeKind.TkBase:
        var nm as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), t.name)
        defer banish nm
        if nm == "string":
            calling emit.line with (sigil of c->emitter), "{dst} = pengu_string_copy({src});"
            return
    if t.kind == tk.SemaTypeKind.TkRune:
        if t.a >= 0 and t.a < c->program->types.nominal_infos.len:
            var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
            if (info.flags & types.NIF_DROP) != 0:
                var cname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), info.c_name)
                defer banish cname
                calling emit.line with (sigil of c->emitter), "{dst} = _pengu_deepclone_{cname}(&({src}));"
                return
    if t.kind == tk.SemaTypeKind.TkList:
        var et as string is calling ctype.c_type with (sigil of c->names), t.a
        defer banish et
        var idx as string is calling emit.temp with (sigil of c->emitter), "_ci"
        defer banish idx
        var el as string is calling emit.temp with (sigil of c->emitter), "_ce"
        defer banish el
        calling emit.line with (sigil of c->emitter), "{dst} = pengu_list_new(sizeof({et}), 0);"
        calling emit.line with (sigil of c->emitter), "for (int {idx} = 0; {idx} < ({src}).len; {idx}++) {{"
        calling emit.indent_more with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "{et} {el};"
        calling clone_value with c, t.a, el, "(({et}*)(({src}).data))[{idx}]"
        calling emit.line with (sigil of c->emitter), "pengu_list_push(&({dst}), &{el});"
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "}"
        return
    if t.kind == tk.SemaTypeKind.TkMap:
        var kt as string is calling ctype.c_type with (sigil of c->names), t.a
        defer banish kt
        var vt as string is calling ctype.c_type with (sigil of c->names), t.b
        defer banish vt
        var it as string is calling emit.temp with (sigil of c->emitter), "_mi"
        defer banish it
        var kn as string is calling emit.temp with (sigil of c->emitter), "_mk"
        defer banish kn
        var vn as string is calling emit.temp with (sigil of c->emitter), "_mv"
        defer banish vn
        calling emit.line with (sigil of c->emitter), "{dst} = pengu_map_new(sizeof({kt}), sizeof({vt}));"
        calling emit.line with (sigil of c->emitter), "PenguMapIter {it} = pengu_map_iter_begin(&({src}));"
        calling emit.line with (sigil of c->emitter), "while (pengu_map_iter_valid(&{it})) {{"
        calling emit.indent_more with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "{kt} {kn};"
        calling clone_value with c, t.a, kn, "(*(const {kt}*)pengu_map_iter_key(&{it}))"
        calling emit.line with (sigil of c->emitter), "{vt} {vn};"
        calling clone_value with c, t.b, vn, "(*(const {vt}*)pengu_map_iter_value(&{it}))"
        calling emit.line with (sigil of c->emitter), "pengu_map_put(&({dst}), &{kn}, &{vn});"
        calling emit.line with (sigil of c->emitter), "pengu_map_iter_advance(&{it});"
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "}"
        return
    calling emit.line with (sigil of c->emitter), "{dst} = {src};"

## Qué envoltorio de `std.consortium` es `ty`: 0 ninguno, 1 `Rc`, 2 `WeakRc`,
## 3 `Arc`, 4 `WeakArc`.
##
## El compilador conoce estos cuatro nombres a propósito: son los únicos tipos
## con política de copia `share` (D11). Un `Rc of int` es un nominal
## instanciado (`Rc__int`) que comparte struct C con la plantilla, así que la
## comparación se hace sobre el nominal de la plantilla (`template_info`).
##
## ## Memoria
## No asigna; copia el nombre base al pool del contexto.
weave consortium_kind_of with c as ref to context.CgContext, ty as int into int:
    if ty < 0 or ty >= c->program->types.types.len:
        return 0
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var steps as int is 0
    while steps < 32 and (t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal):
        if t.b <= 0:
            return 0
        set t is calling types.at with (sigil of c->program->types), t.b
        set steps is steps + 1
    if t.kind != tk.SemaTypeKind.TkRune:
        return 0
    if t.a <= 0 or t.a >= c->program->types.nominal_infos.len:
        return 0
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
    if info.template_info >= 0 and info.template_info < c->program->types.nominal_infos.len:
        set info is (c->program->types.nominal_infos at info.template_info)
    var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), info.base_name)
    defer banish bn
    if bn == "Rc":
        return 1
    if bn == "WeakRc":
        return 2
    if bn == "Arc":
        return 3
    if bn == "WeakArc":
        return 4
    return 0

## Emite la liberación de un `Rc`/`Arc`/`Weak`.
##
## El payload lo destruye `pengu_rc_release`/`pengu_arc_release` con el thunk
## que guardó `new` (el compilador emite `_pengu_rc_drop_<T>` por instancia),
## así que aquí no hace falta conocer `T`.
##
## ## Memoria
## Emite C; los strings C que construye son owned.
weave emit_consortium_drop with c as ref to context.CgContext, kind as int, ty as int, target as string, t as tk.SemaType into void:
    var rel as string is "pengu_arc_release"
    if kind == 1:
        set rel is "pengu_rc_release"
    if kind == 2:
        set rel is "pengu_rc_weak_release"
    if kind == 4:
        set rel is "pengu_arc_weak_release"
    calling emit.line with (sigil of c->emitter), "if (({target}).ptr) {{ {rel}(({target}).ptr); ({target}).ptr = NULL; }}"

## Expresión C con el destructor de `ty` con firma `void (void*)`, o
## `NULL` si el tipo no tiene nada que liberar.
##
## `Rc`/`Arc` guardan ese puntero en su cabecera, así que liberarlos no
## necesita conocer `T`.
##
## ## Memoria
## El string devuelto es owned.
weave emit_drop_thunk_ptr with c as ref to context.CgContext, ty as int into string:
    if ty <= 0 or ty >= c->program->types.types.len:
        return "NULL"
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var steps as int is 0
    while steps < 32 and (t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal):
        if t.b <= 0:
            return "NULL"
        set t is calling types.at with (sigil of c->program->types), t.b
        set steps is steps + 1
    if t.kind == tk.SemaTypeKind.TkBase:
        var bn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), t.name)
        defer banish bn
        if bn == "string":
            return "pengu_drop_string"
        return "NULL"
    if t.kind == tk.SemaTypeKind.TkList:
        return "pengu_drop_list"
    if t.kind == tk.SemaTypeKind.TkMap:
        return "pengu_drop_map"
    if t.kind == tk.SemaTypeKind.TkMaybe:
        return "pengu_drop_maybe"
    if t.kind == tk.SemaTypeKind.TkResult:
        return "pengu_drop_result"
    if (t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho) and t.a >= 0 and t.a < c->program->types.nominal_infos.len:
        var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
        if (info.flags & types.NIF_DROP) != 0:
            var cn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), info.c_name)
            defer banish cn
            var sb as StringBuilder is calling StringBuilder.new
            defer banish sb
            calling sb.append with "_pengu_rc_drop_"
            calling sb.append with cn
            return calling sb.finish
    return "NULL"

## Expresión C con la copia profunda de `ty` con firma
## `void (const void*, void*)`, o `NULL` si basta con `memcpy`.
##
## ## Memoria
## El string devuelto es owned.
weave emit_clone_thunk_ptr with c as ref to context.CgContext, ty as int into string:
    if ty <= 0 or ty >= c->program->types.types.len:
        return "NULL"
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var steps as int is 0
    while steps < 32 and (t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal):
        if t.b <= 0:
            return "NULL"
        set t is calling types.at with (sigil of c->program->types), t.b
        set steps is steps + 1
    if (t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho) and t.a >= 0 and t.a < c->program->types.nominal_infos.len:
        var info as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
        if (info.flags & types.NIF_DROP) != 0:
            var cn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), info.c_name)
            defer banish cn
            var sb as StringBuilder is calling StringBuilder.new
            defer banish sb
            calling sb.append with "_pengu_rc_clone_"
            calling sb.append with cn
            return calling sb.finish
    return "NULL"
