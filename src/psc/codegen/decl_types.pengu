## psc/codegen/types.pengu — definiciones C de runas, ecos, omens y alias.
##
## La tabla de tipos de F3 ya contiene campos/variantes; este módulo sólo
## decide el orden y el texto C.

import std.builder

import psc.ast.kind as pskind
import psc.sema.ast as astutil
import psc.sema.modules.loader as loader
import psc.sema.types.kind as tk
import psc.sema.types.table as types
import psc.sema.names as npool
import psc.sema.symbols.symbol as sym

import psc.codegen.context as context
import psc.codegen.catalog as catalog
import psc.codegen.ctype as ctype
import psc.codegen.drop as drop
import psc.codegen.emit as emit
import psc.codegen.expr as expr

insignia psc_codegen_types_

## Nombre C owned de un tipo del catálogo.
##
## ## Memoria
## Devuelve string owned.
weave type_name with c as ref to context.CgContext, t as catalog.CgType into string:
    return calling ctype.c_type with (sigil of c->names), t.type_id

## Emite la definición de un tipo tupla usado en el programa.
##
## ## Memoria
## Strings temporales liberados.
weave emit_tuple with c as ref to context.CgContext, id as int into void:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), id
    var name as string is calling ctype.tuple_c_name with (sigil of c->names), id
    defer banish name
    calling emit.line with (sigil of c->emitter), "typedef struct {name} {name};"
    calling emit.line with (sigil of c->emitter), "struct {name} {"
    calling emit.indent_more with (sigil of c->emitter)
    var labels as list of string is list of string
    calling labels.push with "first"
    calling labels.push with "second"
    calling labels.push with "third"
    calling labels.push with "fourth"
    calling labels.push with "fifth"
    var i as int is 0
    while i < t.count:
        var cid as int is (c->program->types.type_children at (t.first + i))
        var ct as string is calling ctype.c_type with (sigil of c->names), cid
        defer banish ct
        var lbl as string is "field{i}"
        if i < labels.len:
            set lbl is (labels at i)
        calling emit.line with (sigil of c->emitter), "{ct} {lbl};"
        set i is i + 1
    calling emit.indent_less with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "};"
    banish labels

## Emite una constante de módulo.
##
## Los valores escalares simples conservan el `#define` compacto; los
## inicializadores de rune/echo (`const RAYWHITE as Color is with ...`), floats
## y cualquier expresión no plegada se emiten desde el AST con el tipo
## declarado (compound literal incluido).
##
## ## Memoria
## Strings temporales liberados.
weave emit_const with c as ref to context.CgContext, k as catalog.CgConst into void:
    var raw as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), k.c_name)
    var cname as string is calling context.safe_c_name with raw
    banish raw
    defer banish cname
    var text as string is ""
    var vnode as int is -1
    if k.node >= 0 and k.module >= 0 and k.module < c->program->modules.len:
        var m as loader.SemaModule is (c->program->modules at k.module)
        set vnode is calling astutil.node_child with (sigil of m.parse.ast), k.node, 2
    if vnode >= 0:
        var saved as int is c->current_module
        set c->current_module is k.module
        set text is calling expr.emit_expr_as with c, vnode, k.type_id
        set c->current_module is saved
    if vnode < 0 or text length == 0:
        if text length == 0:
            set text is calling npool.copy_string with "0"
        if k.value.kind == sym.SemaConstKind.CkString:
            banish text
            var sv as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), k.value.name)
            defer banish sv
            var esc as string is calling emit.escape_c with sv
            defer banish esc
            set text is "pengu_string_from_cstr(\"{esc}\")"
        else if k.value.kind == sym.SemaConstKind.CkBool:
            banish text
            if k.value.b:
                set text is calling npool.copy_string with "true"
            else:
                set text is calling npool.copy_string with "false"
        else if k.value.kind == sym.SemaConstKind.CkFloat:
            banish text
            set text is "{k.value.f}"
        else if k.value.kind == sym.SemaConstKind.CkInt or k.value.kind == sym.SemaConstKind.CkChar:
            banish text
            set text is "{k.value.i}"
    calling emit.line with (sigil of c->emitter), "#define {cname} {text}"
    banish text

## Emite la declaración adelantada de un tipo.
##
## ## Memoria
## Strings temporales liberados.
weave emit_forward with c as ref to context.CgContext, t as catalog.CgType into void:
    var ty as tk.SemaType is calling types.at with (sigil of c->program->types), t.type_id
    var cname as string is calling type_name with c, t
    defer banish cname
    if t.is_struct:
        var is_echo as bool is false
        if ty.kind == tk.SemaTypeKind.TkEcho:
            var ei as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
            if ei.kind == tk.SemaNominalKind.NkEcho:
                set is_echo is true
        if is_echo:
            calling emit.line with (sigil of c->emitter), "union {cname};"
            calling emit.line with (sigil of c->emitter), "typedef union {cname} {cname};"
        else:
            calling emit.line with (sigil of c->emitter), "struct {cname};"
            calling emit.line with (sigil of c->emitter), "typedef struct {cname} {cname};"
        return
    if t.is_omen:
        var info as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
        var has_payload as bool is false
        var pi as int is 0
        while pi < info.variants_count:
            var pv as types.SemaVariant is (c->program->types.variants at (info.variants_first + pi))
            if pv.payload_count > 0:
                set has_payload is true
            set pi is pi + 1
        var sb as StringBuilder is calling StringBuilder.new
        defer banish sb
        if has_payload:
            calling sb.append with "typedef enum {cname}_Tag {"
            var i as int is 0
            while i < info.variants_count:
                var v as types.SemaVariant is (c->program->types.variants at (info.variants_first + i))
                var vn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), v.name)
                defer banish vn
                if i > 0:
                    calling sb.append with ","
                calling sb.append with " {cname}_{vn}"
                set i is i + 1
            calling sb.append with "} {cname}_Tag;"
            var line1 as string is calling sb.finish
            calling emit.line with (sigil of c->emitter), line1
            banish line1
            calling emit.line with (sigil of c->emitter), "struct {cname};"
            calling emit.line with (sigil of c->emitter), "typedef struct {cname} {cname};"
        else:
            calling sb.append with "typedef enum {cname} {"
            var i2 as int is 0
            while i2 < info.variants_count:
                var v2 as types.SemaVariant is (c->program->types.variants at (info.variants_first + i2))
                var vn2 as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), v2.name)
                defer banish vn2
                if i2 > 0:
                    calling sb.append with ","
                calling sb.append with " {cname}_{vn2} = {v2.value_i}"
                set i2 is i2 + 1
            calling sb.append with "} {cname};"
            var line2 as string is calling sb.finish
            calling emit.line with (sigil of c->emitter), line2
            banish line2
        return
    # Aliases/seals: declaración de typedef sobre el target.
    var target as string is calling ctype.c_type with (sigil of c->names), ty.b
    defer banish target
    calling emit.line with (sigil of c->emitter), "typedef {target} {cname};"

## Emite el clon superficial de un tipo.
##
## Los helpers derivados (`Nexus`/`Imago`) llaman `_pengu_clone_T` desde
## antiquus; el codegen debe declararlo antes de esos bloques.
##
## ## Memoria
## Strings temporales liberados.
weave emit_clone with c as ref to context.CgContext, t as catalog.CgType into void:
    var cname as string is calling type_name with c, t
    defer banish cname
    calling emit.line with (sigil of c->emitter), "static inline void _pengu_clone_{cname}({cname}* out, const {cname}* v) {"
    calling emit.indent_more with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "*out = *v;"
    calling emit.indent_less with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "}"

## Emite el cleanup de un omen con payload (libera el payload de la variante
## activa). Se emite desde `emit_cleanup`, que corre después de `emit_definition`.
##
## ## Memoria
## Strings temporales liberados.
weave emit_omen_cleanup with c as ref to context.CgContext, ty as tk.SemaType, cname as string into void:
    var oi2 as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
    var hasp as bool is false
    var pj2 as int is 0
    while pj2 < oi2.variants_count:
        var pv3 as types.SemaVariant is (c->program->types.variants at (oi2.variants_first + pj2))
        if pv3.payload_count > 0:
            set hasp is true
        set pj2 is pj2 + 1
    if not hasp:
        return
    calling emit.line with (sigil of c->emitter), "static inline void _pengu_cleanup_{cname}({cname}* p) {"
    calling emit.indent_more with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "(void)p;"
    calling emit.line with (sigil of c->emitter), "switch (p->tag) {"
    var vi2 as int is 0
    while vi2 < oi2.variants_count:
        var vv2 as types.SemaVariant is (c->program->types.variants at (oi2.variants_first + vi2))
        if vv2.payload_count > 0:
            var vnn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), vv2.name)
            defer banish vnn
            calling emit.line with (sigil of c->emitter), "case {cname}_{vnn}: {"
            calling emit.indent_more with (sigil of c->emitter)
            var fi3 as int is 0
            while fi3 < vv2.payload_count:
                var ff as types.SemaField is (c->program->types.fields at (vv2.payload_first + fi3))
                var ffn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), ff.name)
                defer banish ffn
                calling drop.emit_drop_value with c, ff.type, "p->data.{vnn}.{ffn}"
                set fi3 is fi3 + 1
            calling emit.line with (sigil of c->emitter), "} break;"
            calling emit.indent_less with (sigil of c->emitter)
        set vi2 is vi2 + 1
    calling emit.line with (sigil of c->emitter), "default: break;"
    calling emit.line with (sigil of c->emitter), "}"
    calling emit.indent_less with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "}"

## Emite la declaración adelantada del cleanup derivado.
##
## Hace falta porque dos runas pueden tener un ciclo de tipos (A contiene B y
## B contiene `list of A`): el orden topológico rompe el ciclo poniendo A
## antes que B, pero el cleanup de A llama al de B por valor. Se declaran
## todos los cleanups antes de definirlos, igual que los tipos.
##
## ## Memoria
## Strings temporales liberados.
weave emit_cleanup_forward with c as ref to context.CgContext, t as catalog.CgType into void:
    if not t.is_struct and not t.is_omen:
        return
    var ty as tk.SemaType is calling types.at with (sigil of c->program->types), t.type_id
    if t.is_omen:
        var info2 as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
        var hp as bool is false
        var pi as int is 0
        while pi < info2.variants_count:
            var pv as types.SemaVariant is (c->program->types.variants at (info2.variants_first + pi))
            if pv.payload_count > 0:
                set hp is true
            set pi is pi + 1
        if not hp:
            return
    var cname as string is calling type_name with c, t
    defer banish cname
    calling emit.line with (sigil of c->emitter), "static inline void _pengu_cleanup_{cname}({cname}* p);"

## Emite el cleanup derivado de un rune/echo.
##
## ## Memoria
## Strings temporales liberados.
weave emit_cleanup with c as ref to context.CgContext, t as catalog.CgType into void:
    if not t.is_struct and not t.is_omen:
        return
    var ty as tk.SemaType is calling types.at with (sigil of c->program->types), t.type_id
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
    var cname as string is calling type_name with c, t
    defer banish cname
    if t.is_omen:
        calling emit_omen_cleanup with c, ty, cname
        return
    calling emit.line with (sigil of c->emitter), "static inline void _pengu_cleanup_{cname}({cname}* p) {"
    calling emit.indent_more with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "(void)p;"
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + i))
        var fname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.name)
        defer banish fname
        calling drop.emit_drop_value with c, f.type, "p->{fname}"
        set i is i + 1
    if (info.flags & types.NIF_DROP) != 0:
        # Limpieza idempotente: tras liberar, el valor queda en cero, así que
        # `banish x` seguido del destructor automático no libera dos veces.
        calling emit.line with (sigil of c->emitter), "memset(p, 0, sizeof(*p));"
    calling emit.indent_less with (sigil of c->emitter)
    calling emit.line with (sigil of c->emitter), "}"

## Resuelve un `TypeId` a su tipo nominal (rune/eco/omen), siguiendo alias y seals.
##
## Devuelve `-1` cuando el tipo no es nominal o el id no es válido.
##
## ## Memoria
## No asigna.
weave nominal_type_id with c as ref to context.CgContext, tid as int into int:
    var cur as int is tid
    var guard as int is 0
    while cur >= 0 and cur < c->program->types.types.len and guard < 32:
        var t as tk.SemaType is calling types.at with (sigil of c->program->types), cur
        if t.kind == tk.SemaTypeKind.TkRune or t.kind == tk.SemaTypeKind.TkEcho or t.kind == tk.SemaTypeKind.TkOmen:
            return cur
        if t.kind == tk.SemaTypeKind.TkAlias or t.kind == tk.SemaTypeKind.TkSeal:
            set cur is t.b
            set guard is guard + 1
            continue
        return -1
    return -1

## Añade a `out` los índices de catálogo de los tipos nominales usados **por valor**
## en los campos/variantes de `i`.
##
## Los punteros no necesitan tipo completo, pero incluirlos sólo añade aristas
## conservadoras; el DFS corta ciclos, así que un ciclo de punteros no rompe nada.
##
## ## Memoria
## No retiene memoria.
weave collect_type_deps with c as ref to context.CgContext, i as int, idx as ref to list of int, out as ref to list of int into void:
    var t as catalog.CgType is (c->catalog.types at i)
    if t.type_id < 0 or t.type_id >= c->program->types.types.len:
        return
    var ty as tk.SemaType is calling types.at with (sigil of c->program->types), t.type_id
    if ty.a < 0 or ty.a >= c->program->types.nominal_infos.len:
        return
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
    var fi as int is 0
    while fi < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + fi))
        var nid as int is calling nominal_type_id with c, f.type
        if nid >= 0 and (idx at nid) >= 0:
            calling out.push with (idx at nid)
        set fi is fi + 1
    var vi as int is 0
    while vi < info.variants_count:
        var v as types.SemaVariant is (c->program->types.variants at (info.variants_first + vi))
        var pi as int is 0
        while pi < v.payload_count:
            var pf as types.SemaField is (c->program->types.fields at (v.payload_first + pi))
            var pid as int is calling nominal_type_id with c, pf.type
            if pid >= 0 and (idx at pid) >= 0:
                calling out.push with (idx at pid)
            set pi is pi + 1
        set vi is vi + 1

## DFS de ordenación topológica de definiciones.
##
## ## Memoria
## Libera la lista temporal de dependencias.
weave visit_catalog_type with c as ref to context.CgContext, i as int, idx as ref to list of int, state as ref to list of int, order as ref to list of int into void:
    if (state at i) == 1 or (state at i) == 2:
        return
    set state at i is 1
    var deps as list of int is list of int
    calling collect_type_deps with c, i, idx, (sigil of deps)
    var d as int is 0
    while d < deps.len:
        var dep as int is (deps at d)
        set d is d + 1
        if dep == i:
            continue
        calling visit_catalog_type with c, dep, idx, state, order
    banish deps
    set state at i is 2
    calling order.push with i

## Ordena las definiciones de tipos para que los campos por valor encuentren el
## tipo completo (p.ej. un omen con payload `JsonArrayNode` declarado después).
##
## Emite el orden de índices de `c->catalog.types`; los tipos no vivos se filtran
## después. Los ciclos (posibles sólo vía punteros) se cortan sin fallar.
##
## ## Memoria
## Devuelve una lista owned; `idx`/`state` se liberan aquí.
weave order_types with c as ref to context.CgContext into list of int:
    var n as int is c->catalog.types.len
    var idx as list of int is list of int
    var i as int is 0
    while i < c->program->types.types.len:
        calling idx.push with -1
        set i is i + 1
    set i is 0
    while i < n:
        var t as catalog.CgType is (c->catalog.types at i)
        if t.type_id >= 0 and t.type_id < idx.len:
            set idx at (t.type_id) is i
        set i is i + 1
    var state as list of int is list of int
    set i is 0
    while i < n:
        calling state.push with 0
        set i is i + 1
    var order as list of int is list of int
    set i is 0
    while i < n:
        calling visit_catalog_type with c, i, (sigil of idx), (sigil of state), (sigil of order)
        set i is i + 1
    banish idx
    banish state
    return order

## Emite la definición struct/enum de un tipo.
##
## ## Memoria
## Strings temporales liberados.
## Sufijo C para `@packed` / `@align(N)`.
weave layout_attr_suffix with info as types.SemaNominalInfo into string:
    if not info.is_packed and info.align_override <= 0:
        return calling npool.copy_string with ""
    var sb as StringBuilder is calling StringBuilder.new
    calling sb.append with " __attribute__(("
    var first as bool is true
    if info.is_packed:
        calling sb.append with "packed"
        set first is false
    if info.align_override > 0:
        if not first:
            calling sb.append with ", "
        calling sb.append with "aligned("
        calling sb.append_int with info.align_override
        calling sb.append with ")"
    calling sb.append with "))"
    return calling sb.finish

weave emit_definition with c as ref to context.CgContext, t as catalog.CgType into void:
    var ty as tk.SemaType is calling types.at with (sigil of c->program->types), t.type_id
    var cname as string is calling type_name with c, t
    defer banish cname
    if t.is_omen:
        var oi as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
        var payload as bool is false
        var pj as int is 0
        while pj < oi.variants_count:
            var pv2 as types.SemaVariant is (c->program->types.variants at (oi.variants_first + pj))
            if pv2.payload_count > 0:
                set payload is true
            set pj is pj + 1
        if not payload:
            return
        calling emit.line with (sigil of c->emitter), "struct {cname} {"
        calling emit.indent_more with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "{cname}_Tag tag;"
        calling emit.line with (sigil of c->emitter), "union {"
        calling emit.indent_more with (sigil of c->emitter)
        var vi as int is 0
        while vi < oi.variants_count:
            var vv as types.SemaVariant is (c->program->types.variants at (oi.variants_first + vi))
            if vv.payload_count > 0:
                var vn3 as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), vv.name)
                defer banish vn3
                calling emit.line with (sigil of c->emitter), "struct {"
                calling emit.indent_more with (sigil of c->emitter)
                var fi as int is 0
                while fi < vv.payload_count:
                    var f as types.SemaField is (c->program->types.fields at (vv.payload_first + fi))
                    var ft as string is calling ctype.c_type with (sigil of c->names), f.type
                    defer banish ft
                    var fn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.name)
                    defer banish fn
                    var fdecl as string is calling ctype.declare with ft, fn
                    defer banish fdecl
                    var fsuf2 as string is ""
                    if f.align_override > 0:
                        set fsuf2 is " __attribute__((aligned({f.align_override})))"
                    calling emit.line with (sigil of c->emitter), "{fdecl}{fsuf2};"
                    if f.align_override > 0:
                        banish fsuf2
                    set fi is fi + 1
                calling emit.indent_less with (sigil of c->emitter)
                calling emit.line with (sigil of c->emitter), "} {vn3};"
            set vi is vi + 1
        calling emit.indent_less with (sigil of c->emitter)
        calling emit.line with (sigil of c->emitter), "} data;"
        calling emit.indent_less with (sigil of c->emitter)
        var osuf as string is calling layout_attr_suffix with oi
        defer banish osuf
        calling emit.line with (sigil of c->emitter), "}{osuf};"
        return
    if not t.is_struct:
        return
    var info as types.SemaNominalInfo is (c->program->types.nominal_infos at ty.a)
    if info.kind == tk.SemaNominalKind.NkEcho:
        calling emit.line with (sigil of c->emitter), "union {cname} {"
    else:
        calling emit.line with (sigil of c->emitter), "struct {cname} {"
    calling emit.indent_more with (sigil of c->emitter)
    var i as int is 0
    while i < info.fields_count:
        var f as types.SemaField is (c->program->types.fields at (info.fields_first + i))
        var ftxt as string is calling ctype.c_type with (sigil of c->names), f.type
        defer banish ftxt
        var fname as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), f.name)
        defer banish fname
        var fdecl as string is calling ctype.declare with ftxt, fname
        defer banish fdecl
        var fsuf as string is ""
        if f.align_override > 0:
            set fsuf is " __attribute__((aligned({f.align_override})))"
        calling emit.line with (sigil of c->emitter), "{fdecl}{fsuf};"
        if f.align_override > 0:
            banish fsuf
        set i is i + 1
    calling emit.indent_less with (sigil of c->emitter)
    var rsuf as string is calling layout_attr_suffix with info
    defer banish rsuf
    calling emit.line with (sigil of c->emitter), "}{rsuf};"
