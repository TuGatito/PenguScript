    calling eline with c, "if (!_ok{sfx}) {"
    calling ein with c
    calling eline with c, "pengu_json_failf(err, in, \"unknown variant '%.*s'\", _s{sfx}.len, _s{sfx}.data ? _s{sfx}.data : \"\");"
    calling emit_fail with c, ftys, fexprs
    calling eout with c
    calling eline with c, "}"
    calling ftys.pop
