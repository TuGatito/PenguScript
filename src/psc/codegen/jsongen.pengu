## Emite la lectura del valor apuntado por `lvalue`.
##
## `ftys`/`fexprs` son los temporales en vuelo que hay que liberar si falla:
## `ftys` = -1 significa "sentencia plana en `fexprs`".
##
## ## Memoria
## Strings temporales liberados.
weave read_value with c as ref to context.CgContext, ty as int, lvalue as string, label as string, d as int, ftys as ref to list of int, fexprs as ref to list of string into void:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind == tk.SemaTypeKind.TkBase:
        calling read_base with c, ty, lvalue, label, d, ftys, fexprs
        return
    var sfx as string is calling next_sfx with c
    defer banish sfx
    if t.kind == tk.SemaTypeKind.TkRune:
        var rc as string is calling nom_ctype with c, ty
        defer banish rc
        calling eline with c, "if (!_pengu_json_read_{rc}(in, {lvalue}, err)) {"
        calling ein with c
        calling emit_fail with c, ftys, fexprs
        calling eout with c
        calling eline with c, "}"
        return
    if t.kind == tk.SemaTypeKind.TkOmen:
        calling read_omen with c, ty, lvalue, d, ftys, fexprs
        return
    if t.kind == tk.SemaTypeKind.TkList:
        calling read_list with c, ty, lvalue, label, d, ftys, fexprs
        return
    if t.kind == tk.SemaTypeKind.TkMaybe:
        calling read_maybe with c, ty, lvalue, label, d, ftys, fexprs
        return
    if t.kind == tk.SemaTypeKind.TkMap:
        calling read_map with c, ty, lvalue, label, d, ftys, fexprs
        return

## Lectura de una base escalar.
##
## ## Memoria
## Strings temporales liberados.
weave read_base with c as ref to context.CgContext, ty as int, lvalue as string, label as string, d as int, ftys as ref to list of int, fexprs as ref to list of string into void:
    var nm as string is calling base_name with c, ty
    defer banish nm
    if nm == "string":
        calling eline with c, "if (!pengu_json_in_string(in, {lvalue}, err)) {"
        calling ein with c
        calling emit_fail with c, ftys, fexprs
        calling eout with c
        calling eline with c, "}"
        return
    if nm == "bool":
        calling eline with c, "if (!pengu_json_in_bool(in, {lvalue}, err)) {"
        calling ein with c
        calling emit_fail with c, ftys, fexprs
        calling eout with c
        calling eline with c, "}"
        return
    var sfx as string is calling next_sfx with c
    defer banish sfx
    var ct as string is calling value_ctype with c, ty
    defer banish ct
    var lbl as string is calling c_escape with label
    defer banish lbl
    if nm == "float" or nm == "f32" or nm == "f64":
        calling eline with c, "{"
        calling ein with c
        calling eline with c, "double _d{sfx};"
        calling eline with c, "if (!pengu_json_in_f64(in, &_d{sfx}, err)) {"
        calling ein with c
        calling emit_fail with c, ftys, fexprs
        calling eout with c
        calling eline with c, "}"
        calling eline with c, "*({lvalue}) = ({ct})_d{sfx};"
        calling eout with c
        calling eline with c, "}"
        return
    var bits as int is calling bits_of with nm
    var sfxb as string is calling int_sfx with bits
    defer banish sfxb
    if calling is_unsigned with nm:
        calling eline with c, "{"
        calling ein with c
        calling eline with c, "uint64_t _n{sfx};"
        calling eline with c, "if (!pengu_json_in_uinteger(in, &_n{sfx}, err)) {"
        calling ein with c
        calling emit_fail with c, ftys, fexprs
        calling eout with c
        calling eline with c, "}"
        calling eline with c, "if (!pengu_json_range_u64(_n{sfx}, {sfxb}, false, err, \"{lbl}\")) {"
        calling ein with c
        calling emit_fail with c, ftys, fexprs
        calling eout with c
        calling eline with c, "}"
        calling eline with c, "*({lvalue}) = ({ct})_n{sfx};"
        calling eout with c
        calling eline with c, "}"
        return
    calling eline with c, "{"
    calling ein with c
    calling eline with c, "int64_t _n{sfx};"
    calling eline with c, "if (!pengu_json_in_integer(in, &_n{sfx}, err)) {"
    calling ein with c
    calling emit_fail with c, ftys, fexprs
    calling eout with c
    calling eline with c, "}"
    calling eline with c, "if (!pengu_json_range_i64(_n{sfx}, {sfxb}, err, \"{lbl}\")) {"
    calling ein with c
    calling emit_fail with c, ftys, fexprs
    calling eout with c
    calling eline with c, "}"
    calling eline with c, "*({lvalue}) = ({ct})_n{sfx};"
    calling eout with c
    calling eline with c, "}"

## Lectura de `list of X`.
