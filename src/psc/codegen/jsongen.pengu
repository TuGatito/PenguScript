weave read_omen with c as ref to context.CgContext, ty as int, lvalue as string, d as int, ftys as ref to list of int, fexprs as ref to list of string into void:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var sfx as string is calling next_sfx with c
    defer banish sfx
    var rc as string is calling nom_ctype with c, ty
    defer banish rc
