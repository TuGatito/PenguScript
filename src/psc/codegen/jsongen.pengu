    calling ftys.push with -1
    calling fexprs.push with sfree
    calling eline with c, "bool _ok{sfx} = false;"
    var vi as int is 0
    while vi < oinfo.variants_count:
        var v as types.SemaVariant is (c->program->types.variants at (oinfo.variants_first + vi))
        var vn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), v.name)
        defer banish vn
