## Emite la escritura del valor apuntado por `ptr`.
##
## ## Memoria
## Strings temporales liberados.
weave write_value with c as ref to context.CgContext, ty as int, ptr as string, d as int into void:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind == tk.SemaTypeKind.TkBase:
        calling write_base with c, ty, ptr
        return
    var sfx as string is calling next_sfx with c
    defer banish sfx
    if t.kind == tk.SemaTypeKind.TkList:
        var et as string is calling value_ctype with c, t.a
        defer banish et
        calling eline with c, "const PenguList* _l{sfx} = {ptr};"
        calling eline with c, "int _f{sfx} = 1;"
        calling eline with c, "pengu_json_out_char(o, '[');"
        calling eline with c, "for (int _i{sfx} = 0; _i{sfx} < _l{sfx}->len; _i{sfx}++) {"
        calling ein with c
        calling eline with c, "const {et}* _e{sfx} = (const {et}*)pengu_list_at(_l{sfx}, _i{sfx});"
        calling eline with c, "if (!_e{sfx}) continue;"
        calling eline with c, "if (!_f{sfx}) pengu_json_out_char(o, ',');"
        calling eline with c, "_f{sfx} = 0;"
        var ep as string is calling cat2 with "_e", sfx
        defer banish ep
        calling write_value with c, t.a, ep, d + 1
        calling eout with c
        calling eline with c, "}"
        calling eline with c, "pengu_json_out_char(o, ']');"
        return
    if t.kind == tk.SemaTypeKind.TkMaybe:
        var et2 as string is calling value_ctype with c, t.a
        defer banish et2
        calling eline with c, "const PenguMaybe* _m{sfx} = {ptr};"
        calling eline with c, "if (_m{sfx}->is_present && _m{sfx}->value) {"
        calling ein with c
        calling eline with c, "{et2}* _e{sfx} = ({et2}*)_m{sfx}->value;"
        var ep2 as string is calling cat2 with "_e", sfx
        defer banish ep2
        calling write_value with c, t.a, ep2, d + 1
        calling eout with c
        calling eline with c, "} else {"
        calling eline with c, "pengu_json_out_cstr(o, \"null\");"
        calling eline with c, "}"
        return
    if t.kind == tk.SemaTypeKind.TkMap:
        var et3 as string is calling value_ctype with c, t.b
        defer banish et3
        calling eline with c, "const PenguMap* _mp{sfx} = {ptr};"
        calling eline with c, "PenguList _k{sfx} = pengu_map_keys(_mp{sfx});"
        calling eline with c, "pengu_json_sort_keys(&_k{sfx});"
        calling eline with c, "int _f{sfx} = 1;"
        calling eline with c, "pengu_json_out_char(o, '{');"
        calling eline with c, "for (int _i{sfx} = 0; _i{sfx} < _k{sfx}.len; _i{sfx}++) {"
        calling ein with c
        calling eline with c, "const PenguString* _key{sfx} = (const PenguString*)pengu_list_at(&_k{sfx}, _i{sfx});"
        calling eline with c, "if (!_key{sfx}) continue;"
        calling eline with c, "if (!_f{sfx}) pengu_json_out_char(o, ',');"
        calling eline with c, "_f{sfx} = 0;"
        calling eline with c, "pengu_json_out_string(o, *_key{sfx});"
        calling eline with c, "pengu_json_out_char(o, ':');"
        calling eline with c, "const {et3}* _v{sfx} = (const {et3}*)pengu_map_get(_mp{sfx}, _key{sfx});"
        calling eline with c, "if (!_v{sfx})"
        calling eline with c, "{"
        calling ein with c
        calling eline with c, "pengu_json_out_cstr(o, \"null\");"
        calling eline with c, "continue;"
        calling eout with c
        calling eline with c, "}"
        var vp as string is calling cat2 with "_v", sfx
        defer banish vp
        calling write_value with c, t.b, vp, d + 1
        calling eout with c
        calling eline with c, "}"
        calling eline with c, "pengu_json_out_char(o, '}');"
        calling eline with c, "pengu_banish_list(&_k{sfx});"
        return
    if t.kind == tk.SemaTypeKind.TkRune:
        var rc as string is calling nom_ctype with c, ty
        defer banish rc
        calling eline with c, "_pengu_json_write_{rc}(o, {ptr});"
        return
    if t.kind == tk.SemaTypeKind.TkOmen:
        var rc2 as string is calling nom_ctype with c, ty
        defer banish rc2
        var oinfo as types.SemaNominalInfo is (c->program->types.nominal_infos at t.a)
        calling eline with c, "switch (*({ptr})) {"
        var vi as int is 0
        while vi < oinfo.variants_count:
            var v as types.SemaVariant is (c->program->types.variants at (oinfo.variants_first + vi))
            var vn as string is calling npool.copy_string with (calling npool.text with (sigil of c->program->names), v.name)
            defer banish vn
            calling eline with c, "case {rc2}_{vn}: pengu_json_out_string(o, pengu_string_from_cstr(\"{vn}\")); break;"
            set vi is vi + 1
        calling eline with c, "default: pengu_json_out_cstr(o, \"null\"); break;"
        calling eline with c, "}"

## Escritura de una base escalar.
##
## ## Memoria
## Strings temporales liberados.
weave write_base with c as ref to context.CgContext, ty as int, ptr as string into void:
    var nm as string is calling base_name with c, ty
    defer banish nm
    if nm == "string":
        calling eline with c, "pengu_json_out_string(o, *({ptr}));"
    else if nm == "bool":
        calling eline with c, "pengu_json_out_cstr(o, (*({ptr})) ? \"true\" : \"false\");"
    else if nm == "float" or nm == "f32" or nm == "f64":
        calling eline with c, "pengu_json_out_f64(o, (double)(*({ptr})));"
    else if calling is_unsigned with nm:
        calling eline with c, "pengu_json_out_u64(o, (uint64_t)(*({ptr})));"
    else:
        calling eline with c, "pengu_json_out_i64(o, (int64_t)(*({ptr})));"

