## ## Memoria
## Strings temporales liberados.
weave read_list with c as ref to context.CgContext, ty as int, lvalue as string, label as string, d as int, ftys as ref to list of int, fexprs as ref to list of string into void:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    var sfx as string is calling next_sfx with c
    defer banish sfx
    var et as string is calling value_ctype with c, t.a
    defer banish et
    calling eline with c, "PenguList* _l{sfx} = {lvalue};"
    calling eline with c, "*_l{sfx} = pengu_list_new(sizeof({et}), 0);"
    calling eline with c, "if (!pengu_json_in_array_begin(in, err)) {"
    calling ein with c
    calling emit_fail with c, ftys, fexprs
    calling eout with c
    calling eline with c, "}"
    calling eline with c, "bool _first{sfx} = true;"
    calling eline with c, "for (;;) {"
    calling ein with c
    calling eline with c, "if (_first{sfx})"
    calling eline with c, "{"
    calling ein with c
    calling eline with c, "_first{sfx} = false;"
    calling eline with c, "if (pengu_json_in_at_end(in)) break;"
    calling eout with c
    calling eline with c, "}"
    calling eline with c, "else"
    calling eline with c, "{"
    calling ein with c
    calling eline with c, "bool _m{sfx};"
    calling eline with c, "if (!pengu_json_in_more(in, &_m{sfx}, err))"
    calling eline with c, "{"
    calling ein with c
    calling emit_fail with c, ftys, fexprs
    calling eout with c
    calling eline with c, "}"
    calling eline with c, "if (!_m{sfx}) break;"
    calling eout with c
    calling eline with c, "}"
    calling eline with c, "{et} _e{sfx};"
    calling eline with c, "memset(&_e{sfx}, 0, sizeof(_e{sfx}));"
    var ep as string is calling cat2 with "&_e", sfx
    defer banish ep
    calling ftys.push with t.a
    calling fexprs.push with ep
    calling read_value with c, t.a, ep, label, d + 1, ftys, fexprs
    calling ftys.pop
    calling fexprs.pop
    calling eline with c, "pengu_list_push(_l{sfx}, &_e{sfx});"
    calling eout with c
    calling eline with c, "}"
    calling eline with c, "if (!pengu_json_in_array_end(in, err)) {"
    calling ein with c
    calling emit_fail with c, ftys, fexprs
    calling eout with c
    calling eline with c, "}"

