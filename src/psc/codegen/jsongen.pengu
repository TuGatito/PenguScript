## Libera los temporales en vuelo y retorna `false`.
##
## ## Memoria
## Emite llamadas de liberación.
weave emit_fail with c as ref to context.CgContext, ftys as ref to list of int, fexprs as ref to list of string into void:
    var i as int is (ftys->len) - 1
    while i >= 0:
        var ty as int is (ftys at i)
        var ex as string is (fexprs at i)
        if ty >= 0:
            calling free_value with c, ty, ex, 0
        else:
            calling eline with c, ex
        set i is i - 1
    calling eline with c, "return false;"

# ---------------------------------------------------------------------------
# Liberación de valores
# ---------------------------------------------------------------------------

## Emite la liberación del valor apuntado por `ptr`.
##
## ## Memoria
## Emite llamadas; libera temporales.
weave free_value with c as ref to context.CgContext, ty as int, ptr as string, d as int into void:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    if t.kind == tk.SemaTypeKind.TkBase:
        var nm as string is calling base_name with c, ty
        defer banish nm
        if nm == "string":
            calling eline with c, "pengu_banish_string({ptr});"
        return
    var sfx as string is calling next_sfx with c
    defer banish sfx
    if t.kind == tk.SemaTypeKind.TkRune:
        var rc as string is calling nom_ctype with c, ty
        defer banish rc
        calling eline with c, "_pengu_json_free_{rc}({ptr});"
        return
    if t.kind == tk.SemaTypeKind.TkList:
        var et as string is calling value_ctype with c, t.a
        defer banish et
        calling eline with c, "{"
        calling ein with c
        calling eline with c, "PenguList* _l{sfx} = {ptr};"
        calling eline with c, "for (int _i{sfx} = 0; _i{sfx} < _l{sfx}->len; _i{sfx}++) {"
        calling ein with c
        calling eline with c, "{et}* _e{sfx} = ({et}*)pengu_list_at(_l{sfx}, _i{sfx});"
        calling eline with c, "if (_e{sfx}) {"
        calling ein with c
        var ep as string is calling cat2 with "_e", sfx
        defer banish ep
        calling free_value with c, t.a, ep, d + 1
        calling eout with c
        calling eline with c, "}"
        calling eout with c
        calling eline with c, "}"
        calling eline with c, "pengu_banish_list(_l{sfx});"
        calling eout with c
        calling eline with c, "}"
        return
    if t.kind == tk.SemaTypeKind.TkMaybe:
        var et2 as string is calling value_ctype with c, t.a
        defer banish et2
        calling eline with c, "{"
        calling ein with c
        calling eline with c, "PenguMaybe* _mb{sfx} = {ptr};"
        calling eline with c, "if (_mb{sfx}->is_present && _mb{sfx}->value) {"
        calling ein with c
        calling eline with c, "{et2}* _e{sfx} = ({et2}*)_mb{sfx}->value;"
        var ep2 as string is calling cat2 with "_e", sfx
        defer banish ep2
        calling free_value with c, t.a, ep2, d + 1
        calling eline with c, "free(_e{sfx});"
        calling eout with c
        calling eline with c, "}"
        calling eline with c, "_mb{sfx}->is_present = false;"
        calling eline with c, "_mb{sfx}->value = NULL;"
        calling eout with c
        calling eline with c, "}"
        return
    if t.kind == tk.SemaTypeKind.TkMap:
        var et3 as string is calling value_ctype with c, t.b
        defer banish et3
        calling eline with c, "{"
        calling ein with c
        calling eline with c, "PenguMap* _mp{sfx} = {ptr};"
        calling eline with c, "PenguList _k{sfx} = pengu_map_keys(_mp{sfx});"
        calling eline with c, "for (int _i{sfx} = 0; _i{sfx} < _k{sfx}.len; _i{sfx}++) {"
        calling ein with c
        calling eline with c, "PenguString* _key{sfx} = (PenguString*)pengu_list_at(&_k{sfx}, _i{sfx});"
        calling eline with c, "if (!_key{sfx}) continue;"
        calling eline with c, "{et3}* _v{sfx} = ({et3}*)pengu_map_get(_mp{sfx}, _key{sfx});"
        calling eline with c, "if (_v{sfx}) {"
        calling ein with c
        var vp as string is calling cat2 with "_v", sfx
        defer banish vp
        calling free_value with c, t.b, vp, d + 1
        calling eout with c
        calling eline with c, "}"
        calling eline with c, "pengu_banish_string(_key{sfx});"
        calling eout with c
        calling eline with c, "}"
        calling eline with c, "pengu_banish_list(&_k{sfx});"
        calling eline with c, "pengu_banish_map(_mp{sfx});"
        calling eout with c
        calling eline with c, "}"

# ---------------------------------------------------------------------------
# Predicados y concatenación
# ---------------------------------------------------------------------------

## `true` si el tipo es un `maybe` (campo opcional).
##
## ## Memoria
## O(1).
weave is_optional with c as ref to context.CgContext, ty as int into bool:
    var t as tk.SemaType is calling types.at with (sigil of c->program->types), ty
    return t.kind == tk.SemaTypeKind.TkMaybe

## `true` si la base es sin signo.
##
## ## Memoria
## O(1).
weave is_unsigned with nm as string into bool:
    if nm == "u8" or nm == "u16" or nm == "u32" or nm == "u64" or nm == "usize":
        return true
    return false

## Bits de una base entera.
##
## ## Memoria
## O(1).
weave bits_of with nm as string into int:
    if nm == "i8" or nm == "u8":
        return 8
    if nm == "i16" or nm == "u16":
        return 16
    if nm == "u32":
        return 32
    return 64

## Concatenación owned de dos textos.
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave cat2 with a as string, b as string into string:
    var sb as StringBuilder is calling StringBuilder.new
    calling sb.append with a
    calling sb.append with b
    return calling sb.finish

## Concatenación owned de tres textos.
##
## ## Memoria
## Devuelve un string owned; liberar con `banish`.
weave cat3 with a as string, b as string, cc as string into string:
    var sb as StringBuilder is calling StringBuilder.new
    calling sb.append with a
    calling sb.append with b
    calling sb.append with cc
    return calling sb.finish
