## psc/parse/expr/calls.pengu — unarios, `calling`, postfix y argumentos.
##
## ## Memoria
## Construye nodos en el AST; no asigna strings salvo diagnósticos.

import psc.span as pspan
import psc.source as psource
import psc.token as pstoken

import psc.ast.kind as pskind
import psc.ast.node as psast
import psc.parse.state as psstate
import psc.parse.diagnostics as pdiag
import psc.parse.types as ptypes
import psc.parse.expr.atoms as patoms
import psc.parse.expr.util as putil

insignia psc_parse_expr_calls_

## Pide una expresión de lista de valor al hook.
##
## ## Memoria
## O(1), no asigna.
weave pexpr_nested_list_value with p as ref to PsParser into int:
    var fn as ref to weave with p as ref to PsParser into int is p->hooks.list_value_expr
    return calling fn with p

