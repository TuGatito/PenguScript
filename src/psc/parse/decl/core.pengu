## Parsea `test "nombre": ...`.
##
## ## Memoria
## Crea un nodo `test_decl` con los `stmt` hijos.
weave pdecl_parse_test with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    var ignored as Token is calling ps_expect_kw with p, KwTest, "'test'"
    calling ps_begin_children with p
    if calling ps_check with p, TokStringLit:
        calling ps_add_token with p, p->pos
        var ignored2 as Token is calling ps_advance with p
    else if calling ps_check_name_like with p:
        calling ps_add_name_like with p
    else:
        calling ps_emit_here with p, pdiag.ParseIssue.ParseExpectedName, ""
    calling pstmt.pstmt_parse_block_into with p
    return calling ps_finish_node with p, NodeKind.NdTestDecl, start, (calling ps_previous_end with p), 0

## Parsea `when cond:` con declaraciones top-level.
##
## ## Memoria
## Crea un nodo `when_top_decl`.
weave pdecl_parse_when_top with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    var ignored as Token is calling ps_expect_kw with p, KwWhen, "'when'"
    var cond as int is calling pexpr.pexpr_parse_expr with p
    var ignored2 as Token is calling ps_expect with p, TokColon, "':'"
    var ignored3 as Token is calling ps_expect with p, TokNewline, "newline"
    var ignored4 as Token is calling ps_expect with p, TokIndent, "indent"
    calling ps_begin_children with p
    calling ps_add_child with p, cond
    var more as bool is true
    while more:
        calling ps_skip_newlines with p
        if (calling ps_check with p, TokDedent) or (calling ps_check with p, TokEof):
            set more is false
        else:
            var before as int is p->pos
            var top as int is calling pdecl_parse_top_stmt with p
            calling ps_add_child with p, top
            if p->pos == before:
                var forced as Token is calling ps_advance with p
    if calling ps_check with p, TokDedent:
        var ignored5 as Token is calling ps_advance with p
    if calling ps_check_kw with p, KwElse:
        var eb as int is calling pdecl_parse_when_top_else with p
        calling ps_add_child with p, eb
    else:
        calling ps_add_absent with p
    return calling ps_finish_node with p, NodeKind.NdWhenTopDecl, start, (calling ps_previous_end with p), 0

## Parsea el `else` de un `when` top-level.
##
## ## Memoria
## Crea `when_top_else_plain` o `when_top_else_when`.
weave pdecl_parse_when_top_else with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    var ignored as Token is calling ps_expect_kw with p, KwElse, "'else'"
    if calling ps_check_kw with p, KwWhen:
        calling ps_begin_children with p
        var nested as int is calling pdecl_parse_when_top with p
        calling ps_add_child with p, nested
        return calling ps_finish_node with p, NodeKind.NdWhenTopElseWhen, start, (calling pexpr.pexpr_end_of with p, nested), 0
    var ignored2 as Token is calling ps_expect with p, TokColon, "':'"
    var ignored3 as Token is calling ps_expect with p, TokNewline, "newline"
    var ignored4 as Token is calling ps_expect with p, TokIndent, "indent"
    calling ps_begin_children with p
    var more as bool is true
    while more:
        calling ps_skip_newlines with p
        if (calling ps_check with p, TokDedent) or (calling ps_check with p, TokEof):
            set more is false
        else:
            var before as int is p->pos
            var top as int is calling pdecl_parse_top_stmt with p
            calling ps_add_child with p, top
            if p->pos == before:
                var forced as Token is calling ps_advance with p
    if calling ps_check with p, TokDedent:
        var ignored5 as Token is calling ps_advance with p
    return calling ps_finish_node with p, NodeKind.NdWhenTopElsePlain, start, (calling ps_previous_end with p), 0

# ---------------------------------------------------------------------------
# Parámetros
# ---------------------------------------------------------------------------

## Parsea `with param (, param)*`.
##
## ## Memoria
## Crea un nodo `param_list`.
weave pdecl_parse_param_list with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    var ignored as Token is calling ps_expect_kw with p, KwWith, "'with'"
    calling ps_begin_children with p
    var more as bool is true
    while more:
        var param as int is calling pdecl_parse_param with p
        calling ps_add_child with p, param
        if calling ps_check with p, TokComma:
            var ignored2 as Token is calling ps_advance with p
        else if calling ps_check_kw with p, KwAnd:
            var at_and as Token is calling ps_current_token with p
            var detail as string is "line {at_and.line}, column {at_and.col}"
            defer banish detail
            calling ps_emit_issue with p, pdiag.ParseIssue.ParseLegacyAndSeparator, at_and.start, at_and.end, detail
            var ignored3 as Token is calling ps_advance with p
        else:
            set more is false
    return calling ps_finish_node with p, NodeKind.NdParamList, start, (calling ps_previous_end with p), 0

## Parsea `NAME as type [is default]`.
##
## ## Memoria
## Crea un nodo `param`.
weave pdecl_parse_param with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    calling ps_begin_children with p
    calling pdecl_add_name_token with p
    var ignored as Token is calling ps_expect_kw with p, KwAs, "'as'"
    var ty as int is calling ptypes.ptype_parse_type with p
    calling ps_add_child with p, ty
    if calling ps_check_kw with p, KwIs:
        var ignored2 as Token is calling ps_advance with p
        var fn as ref to weave with p as ref to PsParser into int is p->hooks.list_expr
        var value as int is calling fn with p
        calling ps_add_child with p, value
    else:
        calling ps_add_absent with p
    return calling ps_finish_node with p, NodeKind.NdParam, start, (calling ps_previous_end with p), 0

## Parsea `with` + parámetros de `declare` y `...`.
##
## ## Memoria
## Crea un nodo `declare_params`.
weave pdecl_parse_declare_params with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    var ignored as Token is calling ps_expect_kw with p, KwWith, "'with'"
    calling ps_begin_children with p
    if calling ps_check with p, TokEllipsis:
        calling ps_add_token with p, p->pos
        var ignored2 as Token is calling ps_advance with p
        return calling ps_finish_node with p, NodeKind.NdDeclareParams, start, (calling ps_previous_end with p), 0
    var more as bool is true
    while more:
        var param as int is calling pdecl_parse_param with p
        calling ps_add_child with p, param
        if calling ps_check with p, TokComma:
            var ignored3 as Token is calling ps_advance with p
            # `declare F with a as int, ...` (variádico tras la coma): el
            # `...` pertenece a la firma, no es otro parámetro.
            if calling ps_check with p, TokEllipsis:
                set more is false
        else:
            set more is false
    if calling ps_check with p, TokEllipsis:
        calling ps_add_token with p, p->pos
        var ignored4 as Token is calling ps_advance with p
    else:
        calling ps_add_absent with p
    return calling ps_finish_node with p, NodeKind.NdDeclareParams, start, (calling ps_previous_end with p), 0

