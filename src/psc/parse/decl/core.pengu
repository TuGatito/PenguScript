        calling ps_add_child with p, wrapped
    if calling ps_check_kw with p, KwShard:
        calling ps_add_child with p, (calling ptypes.ptype_parse_shard_params with p)
    else if calling ps_check_kw with p, KwWhere:
        calling ps_add_child with p, (calling ptypes.ptype_parse_where_clause with p)
    var ignored2 as Token is calling ps_expect with p, TokColon, "':'"
    var ignored3 as Token is calling ps_expect with p, TokNewline, "newline"
    var ignored4 as Token is calling ps_expect with p, TokIndent, "indent"
    var more as bool is true
    while more:
        calling ps_skip_newlines with p
        if (calling ps_check with p, TokDedent) or (calling ps_check with p, TokEof):
            set more is false
        else:
            var before as int is p->pos
            var mattrs as int is calling pdecl_parse_attributes with p
            var method as int is calling pdecl_parse_weave with p, mattrs
            calling ps_add_child with p, method
            if p->pos == before:
                var forced as Token is calling ps_advance with p
    if calling ps_check with p, TokDedent:
        var ignored5 as Token is calling ps_advance with p
    else:
        calling ps_emit_here with p, pdiag.ParseIssue.ParseExpectedDedent, ""
    return calling ps_finish_node with p, NodeKind.NdEnchantingDecl, start, (calling ps_previous_end with p), 0

