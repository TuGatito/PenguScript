weave pstmt_parse_unless with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    var ignored as Token is calling ps_expect_kw with p, KwUnless, "'unless'"
    var cond as int is calling pexpr.pexpr_parse_expr with p
