    var ignored as Token is calling ps_expect_kw with p, KwBanish, "'banish'"
    var expr as int is calling pexpr.pexpr_parse_unary with p
    calling ps_begin_children with p
    calling ps_add_child with p, expr
    calling ps_finish_statement with p
    return calling ps_finish_node with p, NodeKind.NdBanishStmt, start, (calling pexpr.pexpr_end_of with p, expr), 0

## Parsea `return [v, ...]`.
##
## ## Memoria
## Crea `return_stmt`.
weave pstmt_parse_return with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    var ignored as Token is calling ps_expect_kw with p, KwReturn, "'return'"
    calling ps_begin_children with p
    if (calling ps_check with p, TokNewline) or (calling ps_check with p, TokDedent) or (calling ps_check with p, TokEof):
        calling ps_add_absent with p
    else:
        var more as bool is true
        while more:
            var value as int is calling pexpr.pexpr_parse_value_expr with p
            calling ps_add_child with p, value
            if calling ps_check with p, TokComma:
                var ignored2 as Token is calling ps_advance with p
            else:
                set more is false
    calling ps_finish_statement with p
    return calling ps_finish_node with p, NodeKind.NdReturnStmt, start, (calling ps_previous_end with p), 0

## Parsea `break [label]` / `continue [label]`.
##
## ## Memoria
## Crea `break_stmt`/`continue_stmt`.
weave pstmt_parse_break_continue with p as ref to PsParser, kind as NodeKind into int:
    var start as int is calling ps_current_start with p
    if kind == NodeKind.NdBreakStmt:
        var ignored as Token is calling ps_expect_kw with p, KwBreak, "'break'"
    else:
        var ignored2 as Token is calling ps_expect_kw with p, KwContinue, "'continue'"
    calling ps_begin_children with p
    if calling ps_check_name_like with p:
        calling ps_add_name_like with p
    else:
        calling ps_add_absent with p
    calling ps_finish_statement with p
    return calling ps_finish_node with p, kind, start, (calling ps_previous_end with p), 0

## Parsea `label: for/while`.
##
## ## Memoria
## Crea el nodo del loop y registra la etiqueta en `PsAst.labels`.
weave pstmt_parse_labeled_loop with p as ref to PsParser into int:
    var label_token as int is p->pos
    var ignored as Token is calling ps_advance with p
    var ignored2 as Token is calling ps_expect with p, TokColon, "':'"
    if calling ps_check_kw with p, KwFor:
        var loop as int is calling pstmt_parse_for with p
        calling p->ast.add_label with loop, label_token
        return loop
    var loop2 as int is calling pstmt_parse_while with p
    calling p->ast.add_label with loop2, label_token
    return loop2

## Parsea una expresión como statement.
##
## ## Memoria
## Crea `expr_stmt`.
weave pstmt_parse_expr_stmt with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    var expr as int is calling pexpr.pexpr_parse_expr with p
    calling ps_begin_children with p
    calling ps_add_child with p, expr
    calling ps_finish_statement with p
    return calling ps_finish_node with p, NodeKind.NdExprStmt, start, (calling pexpr.pexpr_end_of with p, expr), 0

# ---------------------------------------------------------------------------
# Statements de una línea
# ---------------------------------------------------------------------------

## Parsea un `simple_stmt` de un bloque de una línea.
##
## ## Memoria
## Crea `continue_simple`, `break_simple`, `return_simple`, `set_simple`,
## `compound_set_simple` o `simple_stmt`.
weave pstmt_parse_simple_stmt with p as ref to PsParser into int:
    var start as int is calling ps_current_start with p
    if calling ps_check_kw with p, KwContinue:
        var ignored as Token is calling ps_advance with p
        calling ps_begin_children with p
        calling pstmt_add_optional_label with p
        return calling ps_finish_node with p, NodeKind.NdContinueSimple, start, (calling ps_previous_end with p), 0
    if calling ps_check_kw with p, KwBreak:
        var ignored2 as Token is calling ps_advance with p
        calling ps_begin_children with p
        calling pstmt_add_optional_label with p
        return calling ps_finish_node with p, NodeKind.NdBreakSimple, start, (calling ps_previous_end with p), 0
    if calling ps_check_kw with p, KwReturn:
        var ignored3 as Token is calling ps_advance with p
        calling ps_begin_children with p
        if (calling ps_check with p, TokNewline) or (calling ps_check with p, TokDedent) or (calling ps_check with p, TokEof):
            calling ps_add_absent with p
        else:
            var value as int is calling pexpr.pexpr_parse_expr with p
            calling ps_add_child with p, value
        return calling ps_finish_node with p, NodeKind.NdReturnSimple, start, (calling ps_previous_end with p), 0
    if calling ps_check_kw with p, KwSet:
        var ignored4 as Token is calling ps_advance with p
        var raw_target2 as int is calling pstmt_parse_set_target with p
        calling ps_begin_children with p
        calling ps_add_child with p, raw_target2
        var target as int is calling ps_finish_node with p, NodeKind.NdSetTarget, (calling pexpr.pexpr_start_of with p, raw_target2), (calling pexpr.pexpr_end_of with p, raw_target2), 0
        if calling ps_check_kw with p, KwIs:
            var ignored5 as Token is calling ps_advance with p
            calling ps_begin_children with p
            calling ps_add_child with p, target
            var value2 as int is calling pexpr.pexpr_parse_expr with p
            calling ps_add_child with p, value2
            return calling ps_finish_node with p, NodeKind.NdSetSimple, start, (calling pexpr.pexpr_end_of with p, value2), 0
        var opi as int is p->pos
        var ignored6 as Token is calling ps_advance with p
        calling ps_begin_children with p
        calling ps_add_child with p, target
        calling ps_add_token with p, opi
        var value3 as int is calling pexpr.pexpr_parse_expr with p
        calling ps_add_child with p, value3
        return calling ps_finish_node with p, NodeKind.NdCompoundSetSimple, start, (calling pexpr.pexpr_end_of with p, value3), opi
    var expr as int is calling pexpr.pexpr_parse_expr with p
    calling ps_begin_children with p
    calling ps_add_child with p, expr
    return calling ps_finish_node with p, NodeKind.NdSimpleStmt, start, (calling pexpr.pexpr_end_of with p, expr), 0

## Añade un label opcional o `None`.
##
## ## Memoria
## O(1), no asigna.
weave pstmt_add_optional_label with p as ref to PsParser into void:
    if calling ps_check_name_like with p:
        calling ps_add_name_like with p
    else:
        calling ps_add_absent with p
