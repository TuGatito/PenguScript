// PenguScript grammar - Phase 4: Top-level and Modules

start: _NEWLINE* (realm_decl _NEWLINE*)? (invoke_decl _NEWLINE*)* (top_item _NEWLINE*)* -> module

// Top-Level Declarations
realm_decl: REALM IDENT -> realm_decl

invoke_decl: INVOKE STRING (AS (IDENT | TYPE_IDENT))?                         -> invoke_module
           | INVOKE LBRACE _import_list RBRACE FROM STRING                    -> invoke_selective

_import_list: import_symbol (COMMA import_symbol)* COMMA?
import_symbol: (IDENT | TYPE_IDENT) (AS (IDENT | TYPE_IDENT))?

const_decl: CONST (IDENT | TYPE_IDENT) (COLON type_expr)? ASSIGN expression -> const_decl
echo_decl: ECHO TYPE_IDENT sigil_params? ASSIGN type_expr           -> echo_decl
seal_decl: SEAL TYPE_IDENT sigil_params? ASSIGN type_expr           -> seal_decl

rune_decl: RUNE TYPE_IDENT sigil_params? (HEIR type_expr)? rune_body -> rune_decl
rune_body: _INDENT (rune_member | _NEWLINE)+ _DEDENT                          -> rune_body
?rune_member: rune_field
            | constructor_decl
            | destructor_decl
            | pass_stmt

rune_field: IDENT COLON type_expr (ASSIGN expression)?                        -> rune_field
constructor_decl: CONSTRUCTOR (LPAR _params? RPAR)? block                     -> constructor_decl
destructor_decl: DESTRUCTOR block                                             -> destructor_decl

enchanting_decl: ENCHANTING type_expr enchanting_body                         -> enchanting_decl
enchanting_body: _INDENT (enchanting_member | _NEWLINE)+ _DEDENT                 -> enchanting_body
?enchanting_member: constructor_decl
                  | destructor_decl
                  | operator_decl
                  | method_decl
                  | pass_stmt

method_decl: (UNSAFE MUT | MUT UNSAFE | MUT | UNSAFE)? IDENT ASSIGN function_expr     -> method_decl
operator_decl: (UNSAFE MUT | MUT UNSAFE | MUT | UNSAFE)? OPERATOR overloadable_op ASSIGN function_expr -> operator_decl

?overloadable_op: PLUS_EQ | MINUS_EQ | STAR_EQ | SLASH_EQ | PERCENT_EQ
               | AMP_EQ | PIPE_EQ | CARET_EQ | LSHIFT_EQ | RSHIFT_EQ
               | LSHIFT | RSHIFT | SPACESHIP | LE | GE | EQ | NEQ
               | LT | GT | PLUS | MINUS | STAR | SLASH | PERCENT
               | AMP | PIPE | CARET | TILDE
               | LBRACK RBRACK                                                -> op_index
               | LPAR RPAR                                                    -> op_call

omen_decl: FLAGS? OMEN TYPE_IDENT (COLON type_expr)? omen_body                -> omen_decl
omen_body: _INDENT (omen_member | _NEWLINE)+ _DEDENT                          -> omen_body
?omen_member: omen_variants
            | pass_stmt
omen_variants: omen_variant (COMMA omen_variant)* COMMA?                      -> omen_variants
omen_variant: (TYPE_IDENT | IDENT) (ASSIGN expression)?                       -> omen_variant

?top_item: const_decl
         | echo_decl
         | seal_decl
         | omen_decl
         | rune_decl
         | enchanting_decl
         | operator_decl
         | statement

block: _INDENT (statement | _NEWLINE)+ _DEDENT -> block

?statement: parent_stmt
          | assign_stmt
          | compound_assign_stmt
          | if_stmt
          | unless_stmt
          | while_stmt
          | until_stmt
          | repeat_stmt
          | for_numeric
          | for_iter
          | break_stmt
          | continue_stmt
          | pass_stmt
          | unsafe_block
          | expr_stmt

// Function declaration and Variable assignment
assign_stmt: (MUT | STATIC MUT | UNSAFE | UNSAFE MUT | MUT UNSAFE)? _targets (COLON type_expr)? ASSIGN (function_expr | if_block_expr | _expr_list) -> assign
_expr_list: expression (COMMA expression)*
compound_assign_stmt: target compound_op expression -> compound_assign

_targets: target (COMMA target)*
?target: STAR target -> deref_target
       | postfix_expr

?compound_op: PLUS_EQ | MINUS_EQ | STAR_EQ | SLASH_EQ | PERCENT_EQ
            | AMP_EQ | PIPE_EQ | CARET_EQ | LSHIFT_EQ | RSHIFT_EQ

// Control Flow
if_stmt: IF expression block (ELSE IF expression block)* (ELSE block)? -> if_stmt
unless_stmt: UNLESS expression block (ELSE block)? -> unless_stmt
while_stmt: WHILE expression block (ELSE block)? -> while_stmt
until_stmt: UNTIL expression block (ELSE block)? -> until_stmt
repeat_stmt: REPEAT block UNTIL expression (ELSE block)? -> repeat_stmt

for_numeric: FOR IDENT (COLON type_expr)? ASSIGN expression COMMA expression (COMMA expression)? block (ELSE block)? -> for_numeric
for_iter: FOR for_iter_bindings IN expression block (ELSE block)? -> for_iter

for_iter_bindings: IDENT COMMA MUT? IDENT -> for_iter_index_val
                 | MUT? IDENT             -> for_iter_val

break_stmt: BREAK expression? -> break_stmt
continue_stmt: CONTINUE -> continue_stmt
pass_stmt: PASS -> pass_stmt
unsafe_block: UNSAFE block -> unsafe_block
parent_stmt: PARENT LPAR _args? RPAR -> parent_stmt

// Function expressions and Sigils
sigil_params: LT sigil_param (COMMA sigil_param)* COMMA? GT -> sigil_params
sigil_param: TYPE_IDENT (NEEDS constraint (COMMA constraint)*)? -> sigil_param
constraint: TYPE_IDENT (LT _type_args GT)? -> sigil_constraint

function_expr: sigil_params? (LPAR _params? RPAR)? ARROW type_expr block   -> fn_block
             | sigil_params? (LPAR _params? RPAR)? ARROW expression        -> fn_inline

_params: param (COMMA param)* COMMA?
param: MUT? IDENT COLON type_expr (ASSIGN expression)?
     | MUT? IDENT ASSIGN expression

// Expression statements and Expressions
expr_stmt: expression -> expr_stmt

?expression: if_inline
           | or_expr

if_inline: IF expression THEN expression (ELSE IF expression THEN expression)* ELSE expression -> if_inline
if_block_expr: IF expression block (ELSE IF expression block)* ELSE block                     -> if_block_expr

?or_expr: and_expr (OR and_expr)*
?and_expr: bwor_expr (AND bwor_expr)*
?bwor_expr: bwxor_expr (PIPE bwxor_expr)*
?bwxor_expr: bwand_expr (CARET bwand_expr)*
?bwand_expr: not_expr (AMP not_expr)*
?not_expr: NOT not_expr -> unary_not
         | cmp_expr

?cmp_expr: range_expr (cmp_op range_expr)*
?cmp_op: EQ | NEQ | LT | LE | GT | GE | SPACESHIP | IN | NOT_IN
NOT_IN.2: "not" /[\t ]+/ "in"

?range_expr: shift_expr (RANGE_INC | RANGE_EXC) shift_expr -> range_op
           | shift_expr

?shift_expr: add_expr ((LSHIFT | RSHIFT) add_expr)*
?add_expr: mul_expr ((PLUS | MINUS) mul_expr)*
?mul_expr: unary_expr ((STAR | SLASH | PERCENT) unary_expr)*

?unary_expr: STAR unary_expr    -> unary_deref
           | MINUS unary_expr   -> unary_neg
           | TILDE unary_expr   -> unary_bitnot
           | HASH unary_expr    -> unary_len
           | AMP unary_expr     -> unary_ref
           | cast_expr

?cast_expr: postfix_expr AS type_expr -> cast_op
          | postfix_expr

?postfix_expr: primary postfix_op*
postfix_op: GENERIC_LT _type_args GT LPAR _args? RPAR                         -> generic_call
          | GENERIC_LT _type_args GT LBRACK expression comp_for+ RBRACK        -> generic_comp
          | GENERIC_LT _type_args GT LBRACK _args? RBRACK                       -> generic_list_lit
          | GENERIC_LT _type_args GT LBRACE _map_entries? RBRACE                -> generic_map_lit
          | LPAR _args? RPAR                          -> call
          | BANG                                      -> call_no_args
          | LBRACK _args RBRACK                       -> index
          | DOT IDENT LPAR _args? RPAR                -> method_call
          | DOT IDENT BANG                            -> method_call_no_args
          | DOT IDENT                                 -> field_access

_args: _arg (COMMA _arg)* COMMA?
_arg: MUT? expression

?primary: INT                                -> int_lit
        | HEX                                -> hex_lit
        | FLOAT                              -> float_lit
        | STRING                             -> string_lit
        | BOOL                               -> bool_lit
        | NONE                               -> none_lit
        | NULLPTR                            -> nullptr_lit
        | ELLIPSIS                           -> ellipsis_lit
        | TYPE_IDENT DOUBLE_COLON TYPE_IDENT -> enum_variant
        | TYPE_IDENT DOUBLE_COLON IDENT      -> type_static_access
        | IDENT DOUBLE_COLON (TYPE_IDENT | IDENT) -> realm_access
        | TYPE_IDENT (LT _type_args GT)? LPAR _args? RPAR -> type_call
        | IDENT                              -> ident
        | AT IDENT LPAR _args? RPAR          -> self_method_call
        | AT IDENT                           -> self_field
        | AT                                 -> self_ref
        | LPAR expression (COMMA expression)+ COMMA? RPAR -> tuple_literal
        | LPAR expression COMMA RPAR                     -> tuple_literal
        | LPAR (if_block_expr | expression) RPAR         -> paren_expr
        | list_comp
        | list_literal
        | map_literal
        | set_literal

list_comp: type_prefix? LBRACK expression comp_for+ RBRACK -> list_comp
comp_for: FOR comp_binding comp_if?                         -> comp_for
?comp_binding: for_iter_bindings IN expression              -> comp_for_iter
             | IDENT (COLON type_expr)? ASSIGN expression COMMA expression (COMMA expression)? -> comp_for_numeric
comp_if: IF expression                                      -> comp_if

list_literal: type_prefix? LBRACK _args? RBRACK
type_prefix: TYPE_IDENT (LT _type_args GT)?
map_literal: type_prefix? LBRACE _map_entries? RBRACE
_map_entries: map_entry (COMMA map_entry)* COMMA?
map_entry: expression COLON expression
set_literal: SET_LBRACE _args? RBRACE
SET_LBRACE: ("set" | "unordered_set") /[\t ]*\{/

?type_expr: named_type
          | fn_type

named_type: MUT? (TYPE_IDENT | IDENT) (LT _type_args GT)? QUESTION? -> named_type
fn_type: FUNCTION LT LPAR _fn_type_params? RPAR ARROW type_expr GT -> fn_type
_fn_type_params: type_expr (COMMA type_expr)*
_type_args: _type_arg (COMMA _type_arg)*
?type_arg: type_expr
        | INT -> literal_type
_type_arg: type_arg

// Identifiers
IDENT: /[a-z_][a-z0-9_]*/
TYPE_IDENT: /[A-Z][A-Za-z0-9_]*/
REALM_IDENT: /[a-z_][a-z0-9_]*/

// Literals
HEX.2: /0[xX][0-9a-fA-F_]+/
FLOAT.2: /[0-9][0-9_]*(\.[0-9][0-9_]*([eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)/
INT.1: /[0-9][0-9_]*/
STRING.2: /f?"([^"\\]|\\.|#\{[^}]*\}|\{[^}]*\})*"/s | /f?'([^'\\]|\\.|#\{[^}]*\}|\{[^}]*\})*'/s
BOOL.2: "true" | "false"
NONE.2: "none" | "nullopt"
NULLPTR.2: "nullptr"
PASS.2: "pass"
ELLIPSIS.2: "..."

// Keywords
MUT.2: "mut"
CONST.2: "const"
STATIC.2: "static"
REALM.2: "realm"
INVOKE.2: "invoke"
FROM.2: "from"
AS.2: "as"
RUNE.2: "rune"
ENCHANTING.2: "enchanting"
HEIR.2: "heir"
OMEN.2: "omen"
FLAGS.2: "flags"
ECHO.2: "echo"
SEAL.2: "seal"
CONSTRUCTOR.2: "constructor"
DESTRUCTOR.2: "destructor"
OPERATOR.2: "operator"
UNSAFE.2: "unsafe"
PARENT.2: "parent"
IF.2: "if"
ELSE.2: "else"
THEN.2: "then"
UNLESS.2: "unless"
WHILE.2: "while"
UNTIL.2: "until"
REPEAT.2: "repeat"
FOR.2: "for"
IN.2: "in"
BREAK.2: "break"
CONTINUE.2: "continue"
NOT.2: "not"
AND.2: "and"
OR.2: "or"
NEEDS.2: "needs"
FUNCTION.2: "function"

// Operators
RANGE_EXC.2: "..<"
RANGE_INC.1: ".."
SPACESHIP.2: "<=>"
LSHIFT_EQ.2: "<<="
RSHIFT_EQ.2: ">>="
LSHIFT.1: "<<"
RSHIFT.1: ">>"
EQ.1: "=="
NEQ.1: "!="
LE.1: "<="
GE.1: ">="
ARROW.1: "->"
DOUBLE_COLON.1: "::"
PLUS_EQ.1: "+="
MINUS_EQ.1: "-="
STAR_EQ.1: "*="
SLASH_EQ.1: "/="
PERCENT_EQ.1: "%="
AMP_EQ.1: "&="
PIPE_EQ.1: "|="
CARET_EQ.1: "^="
ANDAND.1: "&&"
OROR.1: "||"

AT: "@"
HASH: "#"
BANG: "!"
QUESTION: "?"
DOT: "."
COMMA: ","
COLON: ":"
SEMICOLON: ";"
LPAR: "("
RPAR: ")"
LBRACK: "["
RBRACK: "]"
LBRACE: "{"
RBRACE: "}"
ASSIGN: "="
PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
PERCENT: "%"
AMP: "&"
PIPE: "|"
CARET: "^"
TILDE: "~"
LT: "<"
GT: ">"

// Whitespace and indentation
_NEWLINE: ( /\r?\n[\t ]*/ | COMMENT )+
COMMENT: /--[^\n]*/

%ignore /[\t ]+/
%ignore COMMENT
%declare _INDENT _DEDENT
%declare GENERIC_LT
