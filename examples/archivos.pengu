--! Archivos: escritura, lectura y listado en un directorio temporal.

summon std::via
summon std::ambitus

grimoire
    bind base = ambitus::temp_dir() + "/pengu-ejemplo-archivos"
    match via::remove_dir_all(base.as_str())
        when ok(_) then print("limpio")
        when err(_) then print("sin restos")
    match via::create_dir_all(base.as_str())
        when ok(_) then print("creado")
        when err(e) then print(e.message)
    bind nota = via::join(base.as_str(), "nota.txt")
    match via::write_string(nota.as_str(), "hola desde PenguScript")
        when ok(_) then print("escrito")
        when err(e) then print(e.message)
    match via::read_to_string(nota.as_str())
        when ok(texto) then print(texto)
        when err(e) then print(e.message)
    print(via::is_file(nota.as_str()))
    match via::read_dir(base.as_str())
        when ok(entradas) then print(entradas.len())
        when err(e) then print(e.message)
    match via::remove_dir_all(base.as_str())
        when ok(_) then print("borrado")
        when err(e) then print(e.message)
