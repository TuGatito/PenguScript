--! Enums: variantes, construcción posicional/nombrada y sums genéricas.

enchanting Shape
    Circle(radius: Float)
    Rectangle(width: Float, height: Float)
    Point

measure = (shape: Shape) -> Float
    match shape
        when Circle(radius) then 3.141592653589793 * radius * radius
        when Rectangle(width, height) then width * height
        when Point then 0.0

enchanting Maybe[T]
    Just(value: T)
    Nothing

unwrap_or = [T](value: Maybe[T], fallback: T) -> T
    match value
        when Just(inner) then inner
        when Nothing then fallback

grimoire
    bind shapes = [Rectangle(3.0, 4.0), Circle(radius: 2.0), Point]
    for shape in shapes
        print(measure(shape))
    bind label: Maybe[String] = Just("hola")
    print(unwrap_or(label, "nada"))
