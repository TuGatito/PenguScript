--! Configuración TOML: parseo en memoria y lecturas tipadas.

summon std::libra

grimoire
    bind fuente = "titulo = \"demo\"\npuerto = 8080\ndebug = false\n\n[base]\nhost = \"localhost\"\n"
    match libra::parse(fuente)
        when ok(t) then
            print(t.get("titulo"))
            print(t.get_int("puerto"))
            print(t.get_bool("debug"))
            print(t.get("base.host"))
            print(t.has("base.puerto"))
        when err(e) then
            print(e.message)
