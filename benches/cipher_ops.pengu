# stdlib-bound: `std.cipher` Base64 codec.
# Exercises the pure-PenguScript codec (per-quantum loop, string building).
import std.cipher
import std.spark

weave main into int:
    var acc as int is 0
    var i as int is 0
    while i < 5000:
        var payload as string is "PenguScript payload number {i}"
        var enc as string is calling cipher.encode_base64 with payload
        var dec as maybe string is calling cipher.decode_base64 with enc
        if dec is present:
            set acc is acc + (dec.value length)
        else:
            return 1
        set i is i + 1
    calling spark.println with "{acc}"
    return 0
