# Phase 2 gate: a primitive method must cost exactly what the hand-written C
# call costs.  The receiver is passed by value and the body is monomorphized to
# a plain function (`int32_t int_abs(int32_t self)`), so `v.abs` emits the same C
# as `int_abs(v)` in `c/primitive_methods.c`.  Compare the two with
# `python benches/run_bench.py --only primitive_methods`: same algorithm, same
# baseline, so a regression in the method path shows up as a time delta.
enchanting int:
    weave abs into int:
        if self < 0:
            return 0 - self
        return self

weave main into int:
    var total as int is 0
    var i as int is 0
    while i < 2000000:
        var v as int is 0 - i
        set total is total + (calling v.abs % 1000)
        set i is i + 1
    calling print with total
    return 0
