  SetShaderValueV = (shader: Shader, locIndex: int, value: raw<void>, uniformType: int, count: int) -> void
  SetShaderValueMatrix = (shader: Shader, locIndex: int, mat: Matrix) -> void
  SetShaderValueTexture = (shader: Shader, locIndex: int, texture: Texture2D) -> void
  UnloadShader = (shader: Shader) -> void
