rune Vector2
  x: float
  y: float

rune Vector3
  x: float
  y: float
  z: float

rune Vector4
  x: float
  y: float
  z: float
  w: float

rune Matrix
  m0: float
  m4: float
  m8: float
  m12: float
  m1: float
  m5: float
  m9: float
  m13: float
  m2: float
  m6: float
  m10: float
  m14: float
  m3: float
  m7: float
  m11: float
  m15: float

rune Color
  r: uint8_t
  g: uint8_t
  b: uint8_t
  a: uint8_t

rune Rectangle
  x: float
  y: float
  width: float
  height: float

rune Image
  data: raw<void>
  width: int
  height: int
  mipmaps: int
  format: int

rune Texture
  id: uint32_t
  width: int
  height: int
  mipmaps: int
  format: int

rune RenderTexture
  id: uint32_t
  texture: Texture
  depth: Texture

rune NPatchInfo
  source: Rectangle
  left: int
  top: int
  right: int
  bottom: int
  layout: int

rune GlyphInfo
  value: int
  offsetX: int
  offsetY: int
  advanceX: int
  image: Image

rune Font
  baseSize: int
  glyphCount: int
  glyphPadding: int
  texture: Texture
  recs: raw<Rectangle>
  glyphs: raw<GlyphInfo>

rune Camera3D
  position: Vector3
  target: Vector3
  up: Vector3
  fovy: float
  projection: int

rune Camera2D
  offset: Vector2
  target: Vector2
  rotation: float
  zoom: float

rune Mesh
  vertexCount: int
  triangleCount: int
  vertices: raw<float>
  texcoords: raw<float>
  texcoords2: raw<float>
  normals: raw<float>
  tangents: raw<float>
  colors: raw<uint8_t>
  indices: raw<uint16_t>
  boneCount: int
  boneIndices: raw<uint8_t>
  boneWeights: raw<float>
  animVertices: raw<float>
  animNormals: raw<float>
  vaoId: uint32_t
  vboId: raw<uint32_t>

rune Shader
  id: uint32_t
  locs: raw<int>

rune MaterialMap
  texture: Texture
  color: Color
  value: float

rune Material
  shader: Shader
  maps: raw<MaterialMap>
  params: array<float, 4>

rune Transform
  translation: Vector3
  rotation: Vector4
  scale: Vector3

rune BoneInfo
  name: array<char, 32>
  parent_: int

rune ModelSkeleton
  boneCount: uint32_t
  bones: raw<BoneInfo>
  bindPose: raw<Transform>

rune Model
  transform: Matrix
  meshCount: int
  materialCount: int
  meshes: raw<Mesh>
  materials: raw<Material>
  meshMaterial: raw<int>
  skeleton: ModelSkeleton
  currentPose: raw<Transform>
  boneMatrices: raw<Matrix>

rune ModelAnimation
  name: array<char, 32>
  boneCount: uint32_t
  keyframeCount: int
  keyframePoses: raw<raw<Transform>>

rune Ray
  position: Vector3
  direction: Vector3

rune RayCollision
  hit: bool
  distance: float
  point: Vector3
  normal: Vector3

rune BoundingBox
  min: Vector3
  max: Vector3

rune Wave
  frameCount: uint32_t
  sampleRate: uint32_t
  sampleSize: uint32_t
  channels: uint32_t
  data: raw<void>

rune AudioStream
  buffer: raw<void>
  processor: raw<void>
  sampleRate: uint32_t
  sampleSize: uint32_t
  channels: uint32_t

rune Sound
  stream: AudioStream
  frameCount: uint32_t

rune Music
  stream: AudioStream
  frameCount: uint32_t
  looping: bool
  ctxType: int
  ctxData: raw<void>

rune VrDeviceInfo
  hResolution: int
  vResolution: int
  hScreenSize: float
  vScreenSize: float
  eyeToScreenDistance: float
  lensSeparationDistance: float
  interpupillaryDistance: float
  lensDistortionValues: array<float, 4>
  chromaAbCorrection: array<float, 4>

rune VrStereoConfig
  projection: array<Matrix, 2>
  viewOffset: array<Matrix, 2>
  leftLensCenter: array<float, 2>
  rightLensCenter: array<float, 2>
  leftScreenCenter: array<float, 2>
  rightScreenCenter: array<float, 2>
  scale: array<float, 2>
  scaleIn: array<float, 2>

rune FilePathList
  count: uint32_t
  paths: raw<char>

rune AutomationEvent
  frame: uint32_t
  type: uint32_t
  params: array<int, 4>

rune AutomationEventList
  capacity: uint32_t
  count: uint32_t
  events: raw<AutomationEvent>

echo Quaternion = Vector4

echo Texture2D = Texture

echo TextureCubemap = Texture

echo RenderTexture2D = RenderTexture

echo Camera = Camera3D

echo ModelAnimPose = raw<Transform>

