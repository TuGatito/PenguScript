{
  "name": "penguscript",
  "version": "0.1.0",
  "description": "PenguScript toolchain: compiler, checker, formatter, LSP and bindgen",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pengu": "./src/main.ts",
    "penguc": "./src/main.ts"
  },
  "scripts": {
    "pengu": "bun run src/main.ts",
    "check": "bun run src/main.ts check",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.ts --compile --outfile dist/pengu",
    "doctor": "bun run src/main.ts doctor",
    "install:local": "bash scripts/install.sh",
    "vsix": "bash scripts/vsix.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
