## psc/ast/dump.pengu — volcado canónico del AST.
##
## El formato es estable y determinista; es la base de los golden tests y del
## oráculo contra stage0.
##
## ```text
## # psc-ast-dump v1
## # file: <ruta>
## # sha256: <hex>
## # bytes: <n>
## # nodes: <n>
## start
##   file
##     top_stmt
##       import_stmt
##         dotted_path
##           "std"
##           "spark"
##         _
## ```
##
## - Nodo: su nombre de stage0 (`ps_node_kind_name`).
## - Token: `"texto"` con escapes C.
## - Ausente: `_`.
## - Loop etiquetado: `for_in_stmt @label "outer"`.
## - El cuerpo de un `antiquus` se imprime ya decodificado (dedent).
## - CRLF se normaliza a LF solo en el texto del dump.
## - No se imprimen posiciones: los spans se prueban aparte.
##
## ## Memoria
## `dump`/`dump_body` devuelven un `string` owned; liberar con `banish`.

import std.builder

import psc.span as pspan
import psc.source as psource
import psc.token as pstoken
import psc.lexer_state as psstate
import psc.lexer_decode as psdecode

import psc.ast.kind as pskind
import psc.ast.node as psast

insignia psc_ast_dump_

## Volcado completo con cabecera.
##
## ## Memoria
## Devuelve un `string` owned; liberar con `banish`.
weave ps_ast_dump with src as ref to psource.SourceFile, lex as ref to LexResult, ast as ref to PsAst, root as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling ps_ast_append_header with sigil of sb, src, ast
    calling ps_ast_dump_node with sigil of sb, src, lex, ast, root, 0
    return calling sb.finish

## Volcado sin cabecera (oráculo y tests).
##
## ## Memoria
## Devuelve un `string` owned; liberar con `banish`.
weave ps_ast_dump_body with src as ref to psource.SourceFile, lex as ref to LexResult, ast as ref to PsAst, root as int into string:
    var sb as StringBuilder is calling StringBuilder.new
    defer banish sb
    calling ps_ast_dump_node with sigil of sb, src, lex, ast, root, 0
    return calling sb.finish

## Cabecera del dump.
##
## ## Memoria
## Escribe en el builder; no asigna.
weave ps_ast_append_header with sb as ref to StringBuilder, src as ref to psource.SourceFile, ast as ref to PsAst into void:
    calling sb.append with "# psc-ast-dump v1"
    calling ps_ast_newline with sb
    calling sb.append with "# file: "
    calling sb.append with src->path
    calling ps_ast_newline with sb
    calling sb.append with "# sha256: "
    calling sb.append with (calling src.get_sha256)
    calling ps_ast_newline with sb
    calling sb.append with "# bytes: "
    calling sb.append_int with (calling src.byte_len)
    calling ps_ast_newline with sb
    calling sb.append with "# nodes: "
    calling sb.append_int with (calling ast.node_count)
    calling ps_ast_newline with sb

## Escribe un nodo y sus hijos.
##
## ## Memoria
## Recursión acotada por el AST (máximo de parseo 512).
weave ps_ast_dump_node with sb as ref to StringBuilder, src as ref to psource.SourceFile, lex as ref to LexResult, ast as ref to PsAst, id as int, depth as int into void:
    calling ps_ast_indent with sb, depth
    var kind as NodeKind is calling ast.kind_of with id
    calling sb.append with (calling pskind.ps_node_kind_name with kind)
    var label as int is calling ast.label_of with id
    if label >= 0:
        calling sb.append with " @label "
        var lt as string is calling ps_ast_token_text with src, lex, label
        calling ps_ast_append_quoted with sb, lt
        banish lt
    calling ps_ast_newline with sb
    var n as PsNode is calling ast.node_at with id
    var i as int is 0
    while i < n.child_count:
        var c as int is calling ast.child_of with id, i
        if c == 0:
            calling ps_ast_indent with sb, depth + 1
            calling sb.append with "_"
            calling ps_ast_newline with sb
        else if c > 0:
            calling ps_ast_dump_node with sb, src, lex, ast, (c - 1), depth + 1
        else:
            var ti as int is (0 - c) - 1
            calling ps_ast_indent with sb, depth + 1
            var text as string is calling ps_ast_token_text with src, lex, ti
            calling ps_ast_append_quoted with sb, text
            banish text
            calling ps_ast_newline with sb
        set i is i + 1

## Texto de un token del AST.
##
## Para `antiquus` devuelve el cuerpo decodificado; para el resto, el lexema
## crudo del fuente.
##
## ## Memoria
## Devuelve un `string` owned; liberar con `banish`.
weave ps_ast_token_text with src as ref to psource.SourceFile, lex as ref to LexResult, index as int into string:
    var t as Token is lex->tokens at index
    if t.kind == TokAntiquusBody:
        var info as AntiquusInfo is lex->antiquus at t.aux
        return calling psdecode.decode_antiquus with src, info
    var s as pspan.ByteSpan is calling pstoken.token_span with t
    return calling src.slice with s

## Añade `depth` niveles de indentación (dos espacios cada uno).
##
## ## Memoria
## O(depth), no asigna.
weave ps_ast_indent with sb as ref to StringBuilder, depth as int into void:
    var i as int is 0
    while i < depth * 2:
        calling sb.append_char with (32 to char)
        set i is i + 1

## Añade un newline.
##
## ## Memoria
## O(1), no asigna.
weave ps_ast_newline with sb as ref to StringBuilder into void:
    calling sb.append_char with (10 to char)

## Añade `s` entre comillas, con escapes C y CRLF normalizado.
##
## ## Memoria
## O(bytes), sin temporales owned.
weave ps_ast_append_quoted with sb as ref to StringBuilder, s as string into void:
    calling sb.append_char with (34 to char)
    var raw as ref to frozen byte is bytes of s
    var n as int is s length
    var i as int is 0
    while i < n:
        var b as int is (raw at i) to int
        if b == 13:
            if i + 1 < n and ((raw at (i + 1)) to int) == 10:
                set i is i + 1
                set b is 10
            else:
                set b is 10
        if b == 34:
            calling sb.append with "\\\""
        else if b == 92:
            calling sb.append with "\\\\"
        else if b == 10:
            calling sb.append with "\\n"
        else if b == 9:
            calling sb.append with "\\t"
        else if b == 0:
            calling sb.append with "\\0"
        else if b >= 32 and b <= 126:
            calling sb.append_char with (b to char)
        else:
            calling sb.append with "\\x"
            calling ps_ast_append_hex_byte with sb, b
        set i is i + 1
    calling sb.append_char with (34 to char)

## Añade dos dígitos hex de un byte.
##
## ## Memoria
## O(1), no asigna.
weave ps_ast_append_hex_byte with sb as ref to StringBuilder, b as int into void:
    var hi as int is (b >> 4) & 0x0F
    var lo as int is b & 0x0F
    calling sb.append_char with ((calling ps_ast_hex_char with hi) to char)
    calling sb.append_char with ((calling ps_ast_hex_char with lo) to char)

## Valor ASCII de un nibble hex.
##
## ## Memoria
## O(1), no asigna.
weave ps_ast_hex_char with n as int into int:
    if n < 10:
        return 48 + n
    return 87 + n
