## Folding por bloques con `:` e indentación.
weave handle_folding with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    var lines as list of string is calling text.split with "\n"
    var i as int is 0
    while i < lines.len:
        var line as string is (lines at i)
        var t as string is line
        var b as ref to frozen byte is bytes of t
        var e as int is t length
        while e > 0 and (((b at (e - 1)) to int) == 32 or ((b at (e - 1)) to int) == 9):
            set e is e - 1
        if e > 0:
            var base as int is calling indent_len with t
            var next_indent as int is 0
            if i + 1 < lines.len:
                var nxt as string is (lines at (i + 1))
                set next_indent is calling indent_len with nxt
                banish nxt
            if i + 1 < lines.len and next_indent > base:
                var j as int is i + 1
                var jind as int is 0
                while j < lines.len:
                    var jl as string is (lines at j)
                    set jind is calling indent_len with jl
                    banish jl
                    if jind <= base:
                        break
                    set j is j + 1
                var item as JsonValue is calling JsonValue.empty_object
                calling item.put_json with "startLine", (calling JsonValue.int_val with (i to i64))
                calling item.put_json with "endLine", (calling JsonValue.int_val with ((j - 1) to i64))
                calling arr.push_json with item
        banish t
        banish line
        set i is i + 1
    banish lines
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

