    pc as int

## Añade un token semántico.
weave push_token with arr as ref to JsonValue, ts as ref to TokState, line as int, ch as int, ln as int, ty as int into void:
    var dl as int is line - ts->pl
    var ds as int is ch
    if dl == 0:
        set ds is ch - ts->pc
    calling arr.push_json with (calling JsonValue.int_val with (dl to i64))
    calling arr.push_json with (calling JsonValue.int_val with (ds to i64))
    calling arr.push_json with (calling JsonValue.int_val with (ln to i64))
    calling arr.push_json with (calling JsonValue.int_val with (ty to i64))
    calling arr.push_json with (calling JsonValue.int_val with 0)
    set ts->pl is line
    set ts->pc is ch

## Semantic tokens (léxico simple).
weave handle_semantic with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var data as JsonValue is calling JsonValue.empty_array
    var b as ref to frozen byte is bytes of text
    var line as int is 0
    var start as int is 0
    var ts as TokState is with pl is 0, pc is 0
    while start <= text length:
        var end as int is start
        while end < text length and ((b at end) to int) != 10:
            set end is end + 1
        var ltext as string is text at start to end
        var lb as ref to frozen byte is bytes of ltext
        var i as int is 0
        while i < ltext length:
            var c as int is ((lb at i) to int)
            if c == 35:
                var comment as string is ltext at i to (ltext length)
                var clen as int is calling lpos.utf16_len with comment
                calling push_token with (sigil of data), (sigil of ts), line, i, clen, 6
                banish comment
                set i is ltext length
            else if c == 34 or c == 39:
                var q as int is i
                set i is i + 1
                while i < ltext length and ((lb at i) to int) != q:
                    if ((lb at i) to int) == 92:
                        set i is i + 1
                    set i is i + 1
                if i < ltext length:
                    set i is i + 1
                var lit as string is ltext at q to i
                var llen as int is calling lpos.utf16_len with lit
                calling push_token with (sigil of data), (sigil of ts), line, q, llen, 4
                banish lit
            else if calling is_word with c:
                var s0 as int is i
                while i < ltext length and calling is_word with ((lb at i) to int):
                    set i is i + 1
                var w as string is ltext at s0 to i
                var ty as int is 3
                if calling is_keyword with w:
                    set ty is 0
                var wlen as int is calling lpos.utf16_len with w
                calling push_token with (sigil of data), (sigil of ts), line, s0, wlen, ty
                banish w
            else if c >= 48 and c <= 57:
                var s1 as int is i
                while i < ltext length and (((lb at i) to int) >= 48 and ((lb at i) to int) <= 57):
                    set i is i + 1
                var nlen as int is i - s1
                calling push_token with (sigil of data), (sigil of ts), line, s1, nlen, 5
            else:
                set i is i + 1
        banish ltext
        if end >= text length:
            break
        set start is end + 1
        set line is line + 1
    banish text
    banish u
    var res as JsonValue is calling JsonValue.empty_object
    calling res.put_json with "data", data
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Inlay hints de tipo para `var x is <literal>`.
weave handle_inlay with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var u as string is ""
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    banish td
    var text as string is calling doc_text with st, u
    var arr as JsonValue is calling JsonValue.empty_array
    var lines as list of string is calling text.split with "\n"
    var line_no as int is 0
    for line in lines:
        var w as string is ""
        var name_col as int is 0
        var vi as int is calling scrolls.find with line, "var "
        if vi >= 0:
            set name_col is vi + 4
            set w is line at (vi + 4) to (line length)
        else:
            var li as int is calling scrolls.find with line, "let "
            if li >= 0:
                set name_col is li + 4
                set w is line at (li + 4) to (line length)
        if w length > 0:
            var nb as ref to frozen byte is bytes of w
            var ne as int is 0
            while ne < w length and calling is_word with ((nb at ne) to int):
                set ne is ne + 1
            if ne > 0:
                var after as int is calling scrolls.find with w, " is "
                if after >= 0:
                    var expr as string is w at (after + 4) to (w length)
                    var ty as string is ""
                    if expr length > 0:
                        var c0 as string is expr at 0 to 1
                        if c0 == "\"":
                            set ty is "string"
                        else if c0 == "t" or c0 == "f":
                            set ty is "bool"
                        else if calling scrolls.contains with expr, ".":
                            set ty is "float"
                        else:
                            set ty is "int"
                        banish c0
                    if ty length > 0:
                        var hint as JsonValue is calling JsonValue.empty_object
                        calling hint.put_json with "position", (calling lpos.position_json with text, (calling lpos.line_start with text, line_no) + name_col + ne)
                        var lbl as string is ": {ty}"
                        calling hint.put_json with "label", (calling JsonValue.string_val with (calling copy with lbl))
                        calling arr.push_json with hint
                        banish lbl
                    banish expr
            banish w
        banish line
        set line_no is line_no + 1
    banish lines
    banish text
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## Code actions: por ahora "Format document".
weave handle_code_action with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var arr as JsonValue is calling JsonValue.empty_array
    var action as JsonValue is calling JsonValue.empty_object
    calling action.put_json with "title", (calling JsonValue.string_val with (calling copy with "Format document"))
    calling action.put_json with "kind", (calling JsonValue.string_val with (calling copy with "source.fixAll"))
    var cmd as JsonValue is calling JsonValue.empty_object
    calling cmd.put_json with "title", (calling JsonValue.string_val with (calling copy with "Format document"))
    calling cmd.put_json with "command", (calling JsonValue.string_val with (calling copy with "editor.action.formatDocument"))
    calling action.put_json with "command", cmd
    calling arr.push_json with action
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), arr
    var ok as bool is calling send_msg with st, out
    banish out

## On-type: tras ':' inserta salto e indentación.
weave handle_on_type with st as ref to State, id as rpc.JsonRpcId, params as JsonValue into void:
    var td as maybe JsonValue is calling params.get with "textDocument"
    var po as maybe JsonValue is calling params.get with "position"
    var ch as string is calling field_string with params, "ch"
    var u as string is ""
    var line as int is 0
    var col as int is 0
    if td.is_present:
        set u is calling field_string with td.value, "uri"
    if po.is_present:
        set line is calling field_int with po.value, "line", 0
        set col is calling field_int with po.value, "character", 0
    banish po
    banish td
    var res as JsonValue is calling JsonValue.null_value
    if ch == ":":
        var text as string is calling doc_text with st, u
        var ls as int is calling lpos.line_start with text, line
        var b as ref to frozen byte is bytes of text
        var ind as int is 0
        while ls + ind < text length and (((b at (ls + ind)) to int) == 32 or ((b at (ls + ind)) to int) == 9):
            set ind is ind + 1
        var indent as string is ""
        var k as int is 0
        while k < ind + 4:
            set indent is "{indent} "
            set k is k + 1
        var edit as JsonValue is calling JsonValue.empty_object
        var off as int is calling lpos.offset_at with text, line, col
        calling edit.put_json with "range", (calling lpos.range_json with text, off, off)
        var nl as string is "\n{indent}"
        calling edit.put_json with "newText", (calling JsonValue.string_val with (calling copy with nl))
        var edits as JsonValue is calling JsonValue.empty_array
        calling edits.push_json with edit
        set res is edits
        banish nl
        banish indent
        banish text
    banish ch
    banish u
    var out as rpc.JsonRpcMessage is calling rpc.response_ok with (calling copy_id with id), res
    var ok as bool is calling send_msg with st, out
    banish out

## Dispatch de request.
weave handle_request with st as ref to State, id as rpc.JsonRpcId, method as string, params as maybe JsonValue into void:
    if method == "initialize":
        calling handle_initialize with st, id, params
    else if method == "shutdown":
        calling handle_shutdown with st, id
    else if method == "textDocument/hover":
        if params.is_present:
            calling handle_hover with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/definition":
        if params.is_present:
            calling handle_definition with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/documentSymbol":
        if params.is_present:
            calling handle_document_symbols with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/completion":
        if params.is_present:
            calling handle_completion with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/references":
        if params.is_present:
            calling handle_references with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/documentHighlight":
        if params.is_present:
            calling handle_highlight with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/foldingRange":
        if params.is_present:
            calling handle_folding with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/formatting":
        if params.is_present:
            calling handle_formatting with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/rename":
        if params.is_present:
            calling handle_rename with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/prepareRename":
        if params.is_present:
            calling handle_prepare_rename with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/implementation":
        if params.is_present:
            calling handle_implementation with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/signatureHelp":
        if params.is_present:
            calling handle_signature with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "workspace/symbol":
        if params.is_present:
            calling handle_workspace_symbols with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/codeLens":
        if params.is_present:
            calling handle_code_lens with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/semanticTokens/full":
        if params.is_present:
            calling handle_semantic with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/inlayHint":
        if params.is_present:
            calling handle_inlay with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/codeAction":
        if params.is_present:
            calling handle_code_action with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else if method == "textDocument/onTypeFormatting":
        if params.is_present:
            calling handle_on_type with st, id, params.value
        else:
            calling send_method_error with st, id, method
    else:
        calling send_method_error with st, id, method

## Dispatch de notification.
weave handle_notification with st as ref to State, method as string, params as maybe JsonValue into void:
    if method == "initialized":
        return
    if method == "exit":
        set st->shutdown is true
        return
    if params.is_present:
        if method == "textDocument/didOpen":
            calling did_open with st, params.value
        else if method == "textDocument/didChange":
            calling did_change with st, params.value
        else if method == "textDocument/didClose":
            calling did_close with st, params.value

## Bucle principal.
weave run_with with tr as transport.Transport, root as string, exe as string into int:
    var st as State is with tr is tr, docs is map of string to Document, root is root, exe is exe, ws_cache is (calling JsonValue.empty_array), ws_ready is false, initialized is false, shutdown is false
    while true:
        var body as maybe string is calling transport.read_frame with (sigil of st.tr)
        if not body.is_present:
            banish body
            break
        var fixed as string is calling scrolls.replace_all with body.value, r""""params":null""", r""""params":{}"""
        var fixed2 as string is calling scrolls.replace_all with fixed, r""""params": null""", r""""params":{}"""
        banish fixed
        var pr as result of rpc.JsonRpcMessage to rpc.JsonRpcParseError is calling rpc.parse_message with fixed2
        banish fixed2
        banish body
        if not pr.is_ok:
            var pid as rpc.JsonRpcId is with Number is 0
            var out as rpc.JsonRpcMessage is calling rpc.response_error with pid, (calling rpc.error_parse)
            var okp as bool is calling send_msg with (sigil of st), out
            banish out
            banish pr
            continue
        var msg as rpc.JsonRpcMessage is pr.value
        var ignored as int is judge msg:
            when RpcRequest with id, method, params ->
                calling handle_request with (sigil of st), id, method, params
                0
            when Notification with method, params ->
                calling handle_notification with (sigil of st), method, params
                0
            when ResponseOk with id, result ->
                0
            when ResponseError with id, err ->
                0
        banish msg
    var code as int is 1
    if st.shutdown:
        set code is 0
    calling transport.close with (sigil of st.tr)
    return code
