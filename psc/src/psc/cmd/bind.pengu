## psc/cmd/bind.pengu — `psc bind`: wrapper del helper `pengu-bind`.
##
## No reimplementa el parser de cabeceras: localiza el binario congelado y le
## pasa los flags por argv (sin shell).

import std.archivum
import std.compass
import std.rites
import std.spark

import psc.os.proc as proc
import psc.sema.names as npool

insignia psc_cmd_bind_

weave copy with s as string into string:
    return calling npool.copy_string with s

weave starts_dash with s as string into bool:
    if s length == 0:
        return false
    var b as ref to frozen byte is bytes of s
    return ((b at 0) to int) == 45

## Nombre del helper según plataforma.
weave helper_name into string:
    if calling is_windows:
        return "pengu-bind.exe"
    return "pengu-bind"

weave is_windows into bool:
    var u as string is calling rites.uname
    var b as ref to frozen byte is bytes of u
    var i as int is 0
    var win as bool is false
    while i + 3 <= u length:
        if ((b at i) to int) == 87 and ((b at (i + 1)) to int) == 105 and ((b at (i + 2)) to int) == 110:
            set win is true
        set i is i + 1
    banish u
    return win

## `true` si `p` es ejecutable/fichero.
weave usable with p as string into bool:
    return calling archivum.is_file with p

## Busca el helper.
##
## Orden: `PENGU_BIND`, sibling de `psc`, `libexec/pengu`, `bin`, `PATH`.
## Devuelve `""` si no aparece.
weave locate with exe as string into string:
    var env as maybe string is calling rites.getenv with "PENGU_BIND"
    if env.is_present:
        var ep as string is calling copy with env.value
        banish env.value
        banish env
        var ab as string is calling compass.cp_absolute with ep
        banish ep
        if calling usable with ab:
            return ab
    else:
        banish env
    var dir as string is calling compass.cp_dirname with exe
    var hn as string is calling helper_name
    var c1 as string is "{dir}/{hn}"
    if calling usable with c1:
        banish hn
        banish dir
        return c1
    banish c1
    var c2 as string is "{dir}/../libexec/pengu/{hn}"
    var c2a as string is calling compass.cp_absolute with c2
    banish c2
    if calling usable with c2a:
        banish hn
        banish dir
        return c2a
    banish c2a
    var c3 as string is "{dir}/../bin/{hn}"
    var c3a as string is calling compass.cp_absolute with c3
    banish c3
    if calling usable with c3a:
        banish hn
        banish dir
        return c3a
    banish c3a
    var home as maybe string is calling rites.getenv with "PENGU_HOME"
    if home.is_present:
        var h1 as string is "{home.value}/bin/{hn}"
        var h2 as string is "{home.value}/libexec/pengu/{hn}"
        banish home.value
        banish home
        if calling usable with h1:
            banish h2
            banish hn
            banish dir
            return h1
        if calling usable with h2:
            banish h1
            banish hn
            banish dir
            return h2
        banish h1
        banish h2
    else:
        banish home
    var pathv as maybe string is calling rites.getenv with "PATH"
    if pathv.is_present:
        var pv as string is calling copy with pathv.value
        var parts as list of string is calling pv.split with ":"
        banish pv
        banish pathv.value
        banish pathv
        for p in parts:
            var cand as string is "{p}/{hn}"
            if calling usable with cand:
                for q in parts:
                    banish q
                banish parts
                banish hn
                banish dir
                return cand
            banish cand
            banish p
        banish parts
    else:
        banish pathv
    banish hn
    banish dir
    return ""

## Imprime ayuda.
weave print_help into void:
    calling spark.println with "Usage: psc bind HEADER [flags]"
    calling spark.println with "  --prefix P, --links L..., --ignore S..., --include-paths D..."
    calling spark.println with "  --output PATH|-, --define NAME[=V], --cpp-flags FLAGS"
    calling spark.println with "  --system-includes, --preprocessed FILE.i, --no-blank-extensions"
    calling spark.println with "  --no-cpp, --auto-import[=DIR], --no-comments"
    calling spark.println with "  --helper-version, --print-helper"

## Ejecuta un helper con argv y devuelve su exit code.
weave run_helper with helper as string, args as list of string into int:
    var argv as list of string is list of string
    calling argv.push with (calling copy with helper)
    for a in args:
        calling argv.push with (calling copy with a)
    var code as int is calling proc.run_argv with argv
    for a in argv:
        banish a
    banish argv
    return code

## Implementa `psc bind`.
weave run with args as list of string into int:
    if args.len < 2:
        calling print_help
        return 2
    var helper_version as bool is false
    var print_helper as bool is false
    var forward as list of string is list of string
    var have_header as bool is false
    var i as int is 2
    while i < args.len:
        var a as string is args at i
        var eq as int is 0
        var q as int is 0
        var ab as ref to frozen byte is bytes of a
        while q < a length:
            if ((ab at q) to int) == 61:
                set eq is q
            set q is q + 1
        if eq > 2:
            var nm as string is a at 0 to eq
            var vv as string is a at (eq + 1) to (a length)
            if nm == "--prefix" or nm == "--output" or nm == "--cpp-flags" or nm == "--preprocessed" or nm == "--auto-import" or nm == "--define" or nm == "--links" or nm == "--ignore" or nm == "--include-paths":
                calling forward.push with (calling copy with nm)
                calling forward.push with (calling copy with vv)
            else:
                var mq as string is "psc bind: unknown option '{nm}'"
                calling spark.eprintln with mq
                banish mq
                for x in forward:
                    banish x
                banish forward
                return 2
            banish nm
            banish vv
            set i is i + 1
            continue
        if a == "--help" or a == "-h":
            calling print_help
            for x in forward:
                banish x
            banish forward
            return 0
        else if a == "--helper-version":
            set helper_version is true
        else if a == "--print-helper":
            set print_helper is true
        else if a == "--prefix" or a == "--output" or a == "--cpp-flags" or a == "--preprocessed" or a == "--auto-import" or a == "--define" or a == "-D":
            if i + 1 >= args.len:
                var m as string is "psc bind: missing value for {a}"
                calling spark.eprintln with m
                banish m
                for x in forward:
                    banish x
                banish forward
                return 2
            var val as string is args at (i + 1)
            calling forward.push with (calling copy with a)
            calling forward.push with (calling copy with val)
            if a == "--output" and val == "-":
                var dash as int is 0
            set i is i + 1
        else if a == "--links" or a == "--ignore" or a == "--include-paths":
            calling forward.push with (calling copy with a)
            var j as int is i + 1
            var got as bool is false
            while j < args.len and not (calling starts_dash with (args at j)):
                calling forward.push with (calling copy with (args at j))
                set got is true
                set j is j + 1
            if not got:
                var m2 as string is "psc bind: missing value for {a}"
                calling spark.eprintln with m2
                banish m2
                for x in forward:
                    banish x
                banish forward
                return 2
            set i is j - 1
        else if a == "--no-comments" or a == "--system-includes" or a == "--no-blank-extensions" or a == "--no-cpp":
            calling forward.push with (calling copy with a)
        else if calling starts_dash with a:
            var m3 as string is "psc bind: unknown option '{a}'"
            calling spark.eprintln with m3
            banish m3
            for x in forward:
                banish x
            banish forward
            return 2
        else:
            set have_header is true
            calling forward.push with (calling copy with a)
        set i is i + 1
    var helper as string is calling locate with (args at 0)
    if helper length == 0:
        calling spark.eprintln with "psc bind: cannot find 'pengu-bind'."
        calling spark.eprintln with "  Install it next to psc, in libexec/pengu, on PATH, or set PENGU_BIND=/path/to/pengu-bind."
        for x in forward:
            banish x
        banish forward
        return 1
    if print_helper:
        calling spark.println with helper
        banish helper
        for x in forward:
            banish x
        banish forward
        return 0
    if helper_version:
        var vargs as list of string is list of string
        calling vargs.push with (calling copy with "--version")
        var vcode as int is calling run_helper with helper, vargs
        banish vargs
        banish helper
        for x in forward:
            banish x
        banish forward
        return vcode
    if not have_header:
        calling spark.eprintln with "psc bind: missing HEADER"
        banish helper
        for x in forward:
            banish x
        banish forward
        return 2
    var code as int is calling run_helper with helper, forward
    banish helper
    for x in forward:
        banish x
    banish forward
    return code
