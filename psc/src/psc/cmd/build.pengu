## psc/cmd/build.pengu — comandos `build`, `run` y `expand` de F5.

import std.archivum
import std.rites
import std.spark

import psc.driver.build as driver
import psc.sema.names as npool

insignia psc_cmd_build_

## `true` si `s` empieza por `prefix`.
##
## ## Memoria
## O(prefix); no asigna.
weave starts_with with s as string, prefix as string into bool:
    var n as int is s length
    var m as int is prefix length
    if m > n:
        return false
    var sb as ref to frozen byte is bytes of s
    var pb as ref to frozen byte is bytes of prefix
    var i as int is 0
    while i < m:
        if ((sb at i) to int) != ((pb at i) to int):
            return false
        set i is i + 1
    return true

## `true` si `s` empieza por `-`.
##
## ## Memoria
## O(1).
weave starts_dash with s as string into bool:
    if s length == 0:
        return false
    var b as ref to frozen byte is bytes of s
    return ((b at 0) to int) == 45

## Ayuda de `build`.
##
## ## Memoria
## No asigna.
weave print_build_help into void:
    calling spark.println with "Usage: psc build [TARGET] [options]"
    calling spark.println with "  TARGET                  .pengu file or project directory (default: cwd)"
    calling spark.println with "  --profile=debug|release"
    calling spark.println with "  --cc=NAME               C compiler (default: gcc/cc)"
    calling spark.println with "  --out=PATH              artifact path"
    calling spark.println with "  --strict-c99            portable C99"
    calling spark.println with "  --release-unsafe        disable bounds/overflow checks"
    calling spark.println with "  --verbose               print the cc command"
    calling spark.println with "  --help"

